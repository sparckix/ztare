# ZTARE Research Company — environment template
#
# Copy this file to `.env` (DO NOT commit `.env`; it is in .gitignore and
# .dockerignore). Fill in the keys for the LLM providers you intend to use.
# Empty values are tolerated but the corresponding agents/runs will fail at
# call time with a clear "missing API key" error.
#
# Reference: docs/guides/org_runtime_quickstart.md and docker-compose.yml
# explain which services consume which keys.

# ── LLM provider keys (at least one required for live runs) ──────────────

# Anthropic — used by Claude Code CLI agent + paper 7 cold-shots
ANTHROPIC_API_KEY=

# OpenAI — used by gpt-4.1 judge + gpt-5.5 mutator + cold-shots
OPENAI_API_KEY=

# Google Gemini — used by gemini-3.1-pro-preview audit + cold-shots
# (`google-genai` Python SDK reads GOOGLE_API_KEY; some scripts read GEMINI_API_KEY).
# Set both to the same value if you have a single key.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── Org runtime knobs ────────────────────────────────────────────────────

# Which agent CLI the daemons invoke. Default `claude`. Other supported
# values: `codex`, `gemini`. The CLI must be installed AND authenticated
# inside the container running the daemon. The root Dockerfile installs
# `@anthropic-ai/claude-code` globally; if you switch to codex/gemini you
# must rebuild the image with the corresponding CLI on PATH.
ZTARE_AGENT_CLI=claude

# Member id for typed audit trails (who-did-what). Free-form string;
# default `claude`. Multi-instance deployments should set this to a stable
# per-container identifier (e.g., `claude-mgr-vps01`).
ZTARE_MEMBER_ID=claude

# Adapter selection. `auto` infers from ZTARE_AGENT_CLI; explicit values:
# `claude_print` (claude --print), `codex_exec` (codex exec), `gemini_print`.
ZTARE_AGENT_ADAPTER=auto

# Claude Code permission mode when invoked noninteractively by the daemon.
# Common values: `acceptEdits` (default), `ask`, `denyEdits`.
ZTARE_CLAUDE_PERMISSION_MODE=acceptEdits

# Set to any non-empty string to run daemons in unattended mode (no human
# approval prompts). Empty/unset = attended (the default safer mode).
ZTARE_UNATTENDED=

# Per-role daemon poll intervals, seconds. Defaults are conservative; tune
# down if you want faster reaction or up if you want lower API spend.
MANAGER_DAEMON_INTERVAL=600
RESEARCH_DIRECTOR_INTERVAL=600
CLOSURE_DAEMON_INTERVAL=30

# ── LLM-runtime knobs (substrate-side dispatch) ─────────────────────────

# Override LLMRuntime provider routing. Empty = follow principal preferences
# (org/preferences/principal.yaml). Common values: `anthropic`, `openai`,
# `google`. The router still respects per-call overrides.
LLM_DISPATCH_PREF=

# Disable LLM-based router and fall back to deterministic routing rules.
# Set to "1" for strict-determinism debugging. Empty = LLM router enabled.
ZTARE_DISABLE_LLM_ROUTER=

# Disable LLMRuntime's automatic model-fallback chain (e.g. opus → sonnet on
# rate-limit). Set to "1" only when you need to lock to one model. Note: the
# autoresearch_loop sets this to "1" mid-run for reproducibility.
ZTARE_DISABLE_MODEL_FALLBACK=

# Default model for the persona router (lightweight classification call).
# Default: gemini-2.5-flash
ZTARE_ROUTER_MODEL=

# Default model for committee-style adversarial generation.
# Default: gemini
ZTARE_COMMITTEE_MODEL=

# Default model for the reflexive-audit pass (apparatus self-check).
# Default: gemini-2.5-flash
ZTARE_REFLEXIVE_AUDIT_MODEL=

# Default model for the GP-119 champion-thesis Inverter (Popper falsification-test producer; the
# autoresearch instance of the shared common.inversion contract). Default: gpt4.1
ZTARE_INVERTER_MODEL=

# Autoresearch subscription-worker promotion. Set individual call sites to
# `agent` when you want the loop to use an authenticated subscription CLI
# instead of direct provider APIs for that worker.
ZTARE_AGENT_DISPATCH_MUTATOR=
ZTARE_AGENT_DISPATCH_JUDGE=
ZTARE_AGENT_DISPATCH_COMMITTEE=
ZTARE_AGENT_DISPATCH_INVERTER_REVIEW=
ZTARE_AUTORESEARCH_AGENT_RUNTIME=
ZTARE_AUTORESEARCH_MUTATOR_AGENT_RUNTIME=
ZTARE_AUTORESEARCH_JUDGE_AGENT_RUNTIME=
ZTARE_AUTORESEARCH_COMMITTEE_AGENT_RUNTIME=
ZTARE_AUTORESEARCH_INVERTER_REVIEW_AGENT_RUNTIME=
ZTARE_AUTORESEARCH_AGENT_TIMEOUT_SECONDS=

# Mining-LLM provider for scripts/mining/*. Default: openai
MINING_LLM_PROVIDER=

# Snapshot mutator submissions to disk for replay/debugging. Default: "1"
# (enabled). Set to "0" to skip the snapshot write per iter.
MUTATOR_SUBMISSION_SNAPSHOT=

# ── Notification rails (optional) ────────────────────────────────────────

# Public ZTARE defaults to the filesystem outbox below. Tenant overlays can set
# this to "telegram" or another provider once that adapter is installed.
ZTARE_NOTIFICATION_PROVIDER=filesystem
ZTARE_NOTIFICATION_OUTBOX=org/channels/principal/inbox/notifications.jsonl

# Legacy ntfy.sh topic. Ignored by current code; kept for older deployments
# that still grep for the variable.
ZTARE_NTFY_TOPIC=

# ── Tenant Telegram push/approval rail (optional) ─────────────────────────

# BotFather token (https://t.me/BotFather → /newbot). Requires the tenant
# Telegram adapter. Empty = Telegram disabled; filesystem gates remain the
# source of truth.
TELEGRAM_BOT_TOKEN=

# Numeric chat id of the principal's DM with the bot. Find via
# `curl https://api.telegram.org/bot${TOKEN}/getUpdates` after sending the
# bot a message. Required if TELEGRAM_BOT_TOKEN is set. Acts as the
# operator-auth filter: messages from any other chat id are silently dropped.
TELEGRAM_CHAT_ID=

# Telegram poll cadence. POLL_SECONDS controls the gate-filesystem scan
# interval; LONG_POLL_TIMEOUT is the Telegram getUpdates long-poll wait.
# Defaults are tuned for solo principal: ~0s command response, 30s gate
# push latency. Lower POLL_SECONDS only if you need sub-30s gate pushes.
TELEGRAM_POLL_SECONDS=30
TELEGRAM_LONG_POLL_TIMEOUT=25

# ── Orbit dashboard (optional) ──────────────────────────────────────────

# When ORBIT_PORT is set, `make orbit-up` (or the equivalent npm script)
# binds Orbit to this port. Default 5173.
ORBIT_PORT=5173

# Optional Bearer token for the orbit git-sync API (POST /api/gate/resolve,
# /api/directive, /api/control). When empty, the API accepts unauth POSTs —
# fine for solo-principal localhost. Set BOTH variables to the same value
# when exposing Orbit beyond localhost (VPS, reverse proxy):
#   ORBIT_API_TOKEN       — read by the git-sync server
#   VITE_ORBIT_API_TOKEN  — read by the React client at build time
# The vite-prefixed copy is required because vite only exposes env vars
# starting with `VITE_` to the browser bundle.
ORBIT_API_TOKEN=
VITE_ORBIT_API_TOKEN=

# ── LeanMill agent autonomy (permission/safety) ────────────────────────────
# The leanmill leaf/planner/formalizer agents run on the operator's subscription
# (codex/claude) and need to execute their OWN shell loop — warm-Lean check, grep
# Mathlib, sympy/z3 — to do real work. ZTARE_LEANMILL_AGENT_FULL_AUTO=1 (DEFAULT)
# grants that: codex `--dangerously-bypass-approvals-and-sandbox`, claude
# `--permission-mode bypassPermissions`. SOUND because (a) the box is externally
# sandboxed (run on the VPS, not a shared host) and (b) the leanmill kernel
# re-verifies every closure (#print-axioms audit + MNC + statement_integrity) —
# shell freedom cannot manufacture a false closure. Set to 0 ONLY to revert to the
# old approval-gated flags (the A/B baseline) or on a NON-sandboxed host where you
# do not want the agent running arbitrary commands.
# ZTARE_LEANMILL_AGENT_FULL_AUTO=1

# ── Notes ────────────────────────────────────────────────────────────────
#
# - For VPS deployment, set ZTARE_UNATTENDED=1 ONLY after a clean dogfood
#   run on the same VPS shows the audit trail looks correct unsupervised.
# - For multi-server deployment, give each member-id a distinct value so
#   inbox claims and audit rows resolve to the right host.
# - Never commit a populated `.env`. The .dockerignore + .gitignore both
#   exclude it; rely on those rather than re-checking each commit.
