theorem no_TraceZeroStrainPositiveNetBudgetJet_of_dualPriceFrameReceipt
    (hReceipt : TraceZeroPositiveNetBudgetDualPriceFrameReceipt)
    (hJet : TraceZeroStrainPositiveNetBudgetJet)
    (_hSamePacket : hReceipt.packet = hJet.packet)
    (hSameState : hReceipt.state = hJet.state)
    (hErrorBelowGap : hReceipt.errorReserve < hJet.eta * hJet.A) :
    False := by
  have hbound := signedProduction_le_viscous_plus_error_of_dualPriceFrameReceipt hReceipt
  have hboundJet :
      hJet.state.signedProduction ≤
        hJet.state.viscousDissipation + hReceipt.errorReserve := by
    simpa [hSameState] using hbound
  rw [hJet.production_eq, hJet.dissipation_eq] at hboundJet
  nlinarith [hErrorBelowGap, hJet.eta_pos, hJet.A_pos]

