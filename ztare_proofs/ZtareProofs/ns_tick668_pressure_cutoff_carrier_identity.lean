Scalar projected-moment cancellation witness.  Even at a fixed annular output
scale, a route-1 scalar projected moment can vanish by opposite lobes while the
trace-free tensor total variation remains positive.
-/
structure Route1ScalarProjectedMomentTotalVariationConfuser where
  scalarProjectedMomentPay : Nat → Real
  traceFreeTotalVariationPay : Nat → Real
  C : Real
  N : Nat
  scalarMomentPrefixZero :
    nsTick668FinitePrefixSum scalarProjectedMomentPay N = 0
  traceFreeVariationPrefixPositive :
    0 < nsTick668FinitePrefixSum traceFreeTotalVariationPay N
  fixedAnnularOutputScale : Prop
  fixedAnnularOutputScale_proof : fixedAnnularOutputScale
  oppositeLobesCancelScalarMoment : Prop
  oppositeLobesCancelScalarMoment_proof :
    oppositeLobesCancelScalarMoment
  scalarMomentNotTraceFreeTotalVariation : Prop
  scalarMomentNotTraceFreeTotalVariation_proof :
    scalarMomentNotTraceFreeTotalVariation

/--
A five-frame/route-tail exchange cannot use a cancelling scalar projected moment
as the trace-free total-variation event stream.
-/
theorem no_FiveFrameRouteTailExchangeReceipt_of_scalarMomentTotalVariationConfuser
    (hConfuser : Route1ScalarProjectedMomentTotalVariationConfuser)
    (hReceipt : FiveFrameRouteTailExchangeReceipt)
    (hSameFiveFramePay :
      hReceipt.fiveFrameAngularEventPay =
        hConfuser.traceFreeTotalVariationPay)
    (hSameRoutePay :
      hReceipt.routeTailPayment = hConfuser.scalarProjectedMomentPay)
    (hSameC : hReceipt.C = hConfuser.C) :
    False := by
  have hPrefix := hReceipt.fiveFramePrefix_le_routeTailPrefix_all hConfuser.N
  rw [hSameFiveFramePay, hSameRoutePay, hConfuser.scalarMomentPrefixZero,
    hSameC] at hPrefix
  have hNonpos :
      nsTick668FinitePrefixSum hConfuser.traceFreeTotalVariationPay
          hConfuser.N ≤ 0 := by
    simpa using hPrefix
  exact not_lt_of_ge hNonpos hConfuser.traceFreeVariationPrefixPositive


/--
The route1 annular output identity receipt cannot be discharged by identifying
