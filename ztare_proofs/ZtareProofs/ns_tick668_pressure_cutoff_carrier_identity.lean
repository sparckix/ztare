    simpa [hNoSheathSame]
      using hReceipt.noSameWindowCoreSheathCancellationForL2Frame_proof
  have hproof := hConfuser.sameWindowCoreSheathCancellationStillAdmissible_proof
  rw [hmissing] at hproof
  exact hproof

/-- Higher-jet retuning over the dwell interval blocks the receipt unless the
