    CorrelatedCoareaHighLowInterfaceSliceSource where
  thresholdSpaceMeasure : Real
  thresholdSpaceMeasure_nonneg : 0 <= thresholdSpaceMeasure
  lowBoundarySetMeasure : Real
  lowBoundarySetMeasure_nonneg : 0 <= lowBoundarySetMeasure
  highInterfaceSetMeasure : Real
  highInterfaceSetMeasure_nonneg : 0 <= highInterfaceSetMeasure
  lowBoundarySetMeasure_le_thresholdSpaceMeasure :
    lowBoundarySetMeasure <= thresholdSpaceMeasure
  highInterfaceSetMeasure_le_thresholdSpaceMeasure :
    highInterfaceSetMeasure <= thresholdSpaceMeasure
  lowPlusHighMeasure_gt_thresholdSpaceMeasure :
    thresholdSpaceMeasure < lowBoundarySetMeasure + highInterfaceSetMeasure
  disjointHighLowSetsForceMeasureUpperBound : Prop
  disjointHighLowSetsForceMeasureUpperBound_proof :
    disjointHighLowSetsForceMeasureUpperBound
  lowBoundaryMeasureFromCoareaAverage : Prop
  lowBoundaryMeasureFromCoareaAverage_proof : lowBoundaryMeasureFromCoareaAverage
  highInterfaceMeasureFromAntiConcentration : Prop
  highInterfaceMeasureFromAntiConcentration_proof :
    highInterfaceMeasureFromAntiConcentration

/-- The size-sum source supplies the correlated high-low source. -/
