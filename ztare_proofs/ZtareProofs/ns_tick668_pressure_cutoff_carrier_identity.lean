  noPostPayoffSelection : Prop
  noPostPayoffSelection_proof : noPostPayoffSelection
  actionTargetSourceNamesPrefixComparison : Prop
  actionTargetSourceNamesPrefixComparison_proof :
    actionTargetSourceNamesPrefixComparison
  sourceContractAlignmentCheckPassed : Prop
  sourceContractAlignmentCheckPassed_proof :
    sourceContractAlignmentCheckPassed

/--
The finite-prefix certificate forces at least one prefix event whose boundary
charge is not below its interface payment.
-/
theorem FinitePrefixBoundaryInterfaceSelectionSource.not_all_boundary_lt_interface
    (h : FinitePrefixBoundaryInterfaceSelectionSource) :
    ¬ (∀ n : Nat, n < h.prefixLength → h.boundary n < h.interface n) :=
