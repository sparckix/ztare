Arithmetic positive core isolated by the route1 C7 packing spine.  Once the
trace-free variation atoms are the paid same-carrier stream, the all-prefix
budget is an elementary consequence of pointwise payment plus a finite fresh
prefix budget.  The hard PDE field is the pointwise identification in the
right currency, not this summation step.
-/
structure TraceFreeVariationPointwiseSameCarrierPaymentReceipt where
  angularEventPay : Nat → Real
  freshCharge : Nat → Real
  c : Real
  rootBudget : Real
  c_pos : 0 < c
  angularEventPay_nonneg : ∀ n : Nat, 0 ≤ angularEventPay n
  freshCharge_nonneg : ∀ n : Nat, 0 ≤ freshCharge n
  rootBudget_nonneg : 0 ≤ rootBudget
  pointwiseTraceFreeVariationPayment :
    ∀ n : Nat, c * angularEventPay n ≤ freshCharge n
  finitePrefixFreshCarrierBudget :
    ∀ N : Nat, nsTick668FinitePrefixSum freshCharge N ≤ rootBudget
