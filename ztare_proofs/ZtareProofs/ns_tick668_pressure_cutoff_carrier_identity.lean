  selectedSuitableDefectSource : SuitableLocalEnergyDefectMeasureSource Ω
  selectedResidual :
    NSTick541LiteralCascadeVacuousAsymptoticOpen.AsymptoticSuperTypeISparseCascade
      selectedSuitableDefectSource
  selectedLevelsFollowLEIStream : Prop
  selectedLevelsFollowLEIStream_proof : selectedLevelsFollowLEIStream
