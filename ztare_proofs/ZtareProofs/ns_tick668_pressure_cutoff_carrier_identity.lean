/--
The multiplicity packet also kills the exchange receipt itself: the exchange
surface carries the same composed owner-budget inequality consumed by the
pre-summed carrier.
-/
theorem no_AngularSampleOwnerPreimageExchangeReceipt_of_multiplicityConfuser
    (hConfuser : PreSummedAngularOwnerBudgetMultiplicityConfuser)
    (hExchange : AngularSampleOwnerPreimageExchangeReceipt)
    (hSameSpend :
      hExchange.angularTracefreeSpend = hConfuser.angularTracefreeSpend)
    (hSameBudget :
      hExchange.ownerPacketBudget = hConfuser.ownerPacketBudget)
    (hSameC : hExchange.C = hConfuser.C) :
    False := by
  have hle :
      hConfuser.angularTracefreeSpend ≤
        hConfuser.C * hConfuser.ownerPacketBudget := by
    simpa [hSameSpend, hSameBudget, hSameC]
      using hExchange.composedAngularOwnerBudgetBound
  exact not_lt_of_ge hle hConfuser.multiplicityViolatesAngularOwnerBudget

