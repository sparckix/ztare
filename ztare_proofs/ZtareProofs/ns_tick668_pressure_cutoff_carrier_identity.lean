/--
Explicit finite numeric confuser for the simultaneous pressure self-tax estimate.
It is a local jet/defect packet, not an NS solution constructor.  The point is
that the cap side can be harmless while both required lower estimates fail.
-/
structure PressureL2SimultaneousSelfTaxExplicitCounterpacket where
  packet : BalancedCoreSheathDiniLadderConePacket
  state : NS.StealthGrowthState
  A : Real
  eta : Real
  C : Real
  E : Real
  Q : Real
  P : Real
  D : Real
  H : Real
  R : Real
  coreMoment : Real
  sheathMoment : Real
  A_pos : 0 < A
  eta_pos : 0 < eta
  C_nonneg : 0 ≤ C
  E_nonneg : 0 ≤ E
  E_below_gap : E < eta * A
  Q_eq : Q = A
  P_eq : P = state.signedProduction
  D_eq : D = state.viscousDissipation
  signedProduction_eq : state.signedProduction = (1 + eta) * A
  viscousDissipation_eq : state.viscousDissipation = A
  coreMoment_nonzero : coreMoment ≠ 0
  sheath_cancels_core : sheathMoment = -coreMoment
  H_eq_final_l2_carrier : H = |coreMoment + sheathMoment|
  R_eq_unbilled_remainder : R = 0
  sameOwnerWindow : Prop
  sameOwnerWindow_proof : sameOwnerWindow
  tangentialDivDivNullStressStillAdmissible : Prop
  tangentialDivDivNullStressStillAdmissible_proof :
    tangentialDivDivNullStressStillAdmissible
  sameWindowCoreSheathL2Cancellation : Prop
  sameWindowCoreSheathL2Cancellation_proof : sameWindowCoreSheathL2Cancellation
  higherJetRetuningStillAdmissibleOverDwell : Prop
  higherJetRetuningStillAdmissibleOverDwell_proof :
    higherJetRetuningStillAdmissibleOverDwell
  noTangentialDivDivNullStressOnProductionFrame_missing :
    ¬ (tangentialDivDivNullStressStillAdmissible = False)
  noSameWindowCoreSheathCancellationForL2Frame_missing :
    ¬ (sameWindowCoreSheathL2Cancellation = False)
  noHigherJetRetuningOfL2ResidualOverDwell_missing :
    ¬ (higherJetRetuningStillAdmissibleOverDwell = False)

/-- In the explicit confuser, the cap-side upper bound can hold trivially:
the final `l=2` carrier cancels to zero and the unbilled remainder is zero. -/
theorem pressureL2_explicitCounterpacket_cap_side_holds
    (h : PressureL2SimultaneousSelfTaxExplicitCounterpacket) :
    h.C * h.H + h.R ≤ h.D + 2 * h.E := by
  have hH : h.H = 0 := by
    rw [h.H_eq_final_l2_carrier, h.sheath_cancels_core]
    norm_num
  rw [hH, h.R_eq_unbilled_remainder, h.D_eq, h.viscousDissipation_eq]
  nlinarith [h.A_pos, h.E_nonneg]

/-- But the dual product `P^2 <= D*Q` fails for the same positive-net jet. -/
theorem pressureL2_explicitCounterpacket_dual_product_fails
    (h : PressureL2SimultaneousSelfTaxExplicitCounterpacket) :
    ¬ h.P ^ 2 ≤ h.D * h.Q := by
  intro hle
  rw [h.P_eq, h.D_eq, h.Q_eq, h.signedProduction_eq,
    h.viscousDissipation_eq] at hle
  ring_nf at hle
  have hA_sq_pos : 0 < h.A ^ 2 := sq_pos_of_pos h.A_pos
  have heta_nonneg : 0 ≤ h.eta := le_of_lt h.eta_pos
  nlinarith [hA_sq_pos, h.eta_pos, heta_nonneg, hle]

/-- The pressure self-tax cap `Q <= C*H+R` also fails: the final carrier is zero
while the self-tax price is positive. -/
theorem pressureL2_explicitCounterpacket_self_tax_cap_fails
    (h : PressureL2SimultaneousSelfTaxExplicitCounterpacket) :
    ¬ h.Q ≤ h.C * h.H + h.R := by
  intro hle
  have hH : h.H = 0 := by
    rw [h.H_eq_final_l2_carrier, h.sheath_cancels_core]
    norm_num
  rw [h.Q_eq, hH, h.R_eq_unbilled_remainder] at hle
  nlinarith [h.A_pos, h.C_nonneg]


