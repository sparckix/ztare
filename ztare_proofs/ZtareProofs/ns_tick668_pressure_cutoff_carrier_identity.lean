/-- Local finite prefix sum for the event-payment surfaces in this file. -/
def nsTick668FinitePrefixSum (x : Nat → Real) : Nat → Real
  | 0 => 0
  | Nat.succ n => nsTick668FinitePrefixSum x n + x n

theorem nsTick668FinitePrefixSum_eq_nsPrefixSum
    (x : Nat → Real) :
    ∀ N : Nat, nsTick668FinitePrefixSum x N = NS.nsPrefixSum x N := by
  intro N
  induction N with
  | zero =>
      simp [nsTick668FinitePrefixSum, NS.nsPrefixSum]
  | succ n ih =>
      rw [nsTick668FinitePrefixSum, NS.ns_prefix_sum_succ, ih]

theorem nsTick668FinitePrefixSum_le_of_pointwise
    {x y : Nat → Real}
    (hxy : ∀ n : Nat, x n ≤ y n) :
    ∀ N : Nat, nsTick668FinitePrefixSum x N ≤ nsTick668FinitePrefixSum y N := by
  intro N
  induction N with
  | zero =>
      rfl
  | succ n ih =>
      simp [nsTick668FinitePrefixSum, add_le_add ih (hxy n)]

theorem nsTick668FinitePrefixSum_const_mul_left
    (c : Real) (x : Nat → Real) :
    ∀ N : Nat,
      nsTick668FinitePrefixSum (fun n : Nat => c * x n) N =
        c * nsTick668FinitePrefixSum x N := by
  intro N
  induction N with
  | zero =>
      simp [nsTick668FinitePrefixSum]
  | succ n ih =>
      simp [nsTick668FinitePrefixSum, ih, left_distrib]


theorem nsTick668FinitePrefixSum_le_const_mul_of_pointwise
    {x y : Nat → Real} {c : Real}
    (hxy : ∀ n : Nat, x n ≤ c * y n) :
    ∀ N : Nat, nsTick668FinitePrefixSum x N ≤
      c * nsTick668FinitePrefixSum y N := by
  intro N
  have hpoint := nsTick668FinitePrefixSum_le_of_pointwise hxy N
  rw [← nsTick668FinitePrefixSum_const_mul_left c y N]
  exact hpoint

theorem nsTick668FinitePrefixSum_le_of_pointwise_on_prefix
    {x y : Nat → Real} :
    ∀ N : Nat,
      (∀ n : Nat, n < N → x n ≤ y n) →
      nsTick668FinitePrefixSum x N ≤ nsTick668FinitePrefixSum y N
  | 0, _ => by rfl
  | Nat.succ n, hxy => by
      have hprev : nsTick668FinitePrefixSum x n ≤ nsTick668FinitePrefixSum y n :=
        nsTick668FinitePrefixSum_le_of_pointwise_on_prefix n
          (fun k hk => hxy k (Nat.lt_trans hk (Nat.lt_succ_self n)))
      have hlast : x n ≤ y n := hxy n (Nat.lt_succ_self n)
      simp [nsTick668FinitePrefixSum, add_le_add hprev hlast]

theorem nsTick668FinitePrefixSum_lt_of_pointwise_lt
    {x y : Nat → Real} {N : Nat}
    (hN : 0 < N)
    (hxy : ∀ n : Nat, n < N → x n < y n) :
    nsTick668FinitePrefixSum x N < nsTick668FinitePrefixSum y N := by
  induction N with
  | zero =>
      exact False.elim (Nat.not_lt_zero 0 hN)
  | succ n ih =>
      have hle : nsTick668FinitePrefixSum x n <= nsTick668FinitePrefixSum y n :=
        nsTick668FinitePrefixSum_le_of_pointwise_on_prefix n
          (fun k hk => le_of_lt (hxy k (Nat.lt_trans hk (Nat.lt_succ_self n))))
      have hlast : x n < y n := hxy n (Nat.lt_succ_self n)
      simp [nsTick668FinitePrefixSum]
      exact add_lt_add_of_le_of_lt hle hlast

/--
Finite pigeonhole form used by payment-biased coarea selection: if the prefix
interface payment is no larger than the prefix boundary charge, then not every
threshold in the prefix can have boundary charge below interface payment.
-/
theorem nsTick668_not_all_boundary_lt_interface_of_prefix_interface_le_boundary
    {boundary interface : Nat → Real} {N : Nat}
    (hN : 0 < N)
    (hsum : nsTick668FinitePrefixSum interface N <=
      nsTick668FinitePrefixSum boundary N) :
    ¬ (∀ n : Nat, n < N → boundary n < interface n) := by
  intro hall
  have hlt : nsTick668FinitePrefixSum boundary N <
      nsTick668FinitePrefixSum interface N :=
    nsTick668FinitePrefixSum_lt_of_pointwise_lt hN hall
  linarith

/--
Finite prefix selection form of the same pigeonhole fact.  If the interface
prefix sum is no larger than the boundary prefix sum, then some prefix event has
boundary charge at least interface charge.  This is the arithmetic core behind
the conditional high-interface average-dominance constructor.
-/
theorem nsTick668_exists_boundary_ge_interface_of_prefix_interface_le_boundary
    {boundary interface : Nat → Real} {N : Nat}
    (hN : 0 < N)
    (hsum : nsTick668FinitePrefixSum interface N <=
      nsTick668FinitePrefixSum boundary N) :
    ∃ n : Nat, n < N ∧ interface n <= boundary n := by
  by_contra hnone
  have hall : ∀ n : Nat, n < N → boundary n < interface n := by
    intro n hn
    by_contra hnot
    have hge : interface n <= boundary n := le_of_not_gt hnot
    exact hnone ⟨n, hn, hge⟩
  exact nsTick668_not_all_boundary_lt_interface_of_prefix_interface_le_boundary
    hN hsum hall

/--
Finite-prefix boundary/interface selection certificate.  The arithmetic content
is just the preceding pigeonhole lemma; the extra fields are the H29/H30 source
contract needed before this can be used as a payment-biased coarea selector.
-/
