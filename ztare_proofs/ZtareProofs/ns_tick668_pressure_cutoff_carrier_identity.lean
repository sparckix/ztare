  noProxyPressureVisibilityOnlyGap : Prop
  noProxyPressureVisibilityOnlyGap_proof :
    noProxyPressureVisibilityOnlyGap
  noTargetDefinedGapInflation : Prop
  noTargetDefinedGapInflation_proof : noTargetDefinedGapInflation

/--
Level412 bridge consumer for the Level411 numeric gap field.  A bridge may be
kernel-indexed, but it must name the same lifted jet and owner-root budget as
the Level411 receipt before its Pi-lock invoice can pay that receipt's gap.
-/
theorem ownerRootBudgetControlsLiftedGap_of_kernelSelectedHHPiLockBridge
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hReceipt : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice)
    (hBridge :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        SameOwnerPiLockBudgetBridge)
    (sameEta :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        (hReceipt.liftKernelToJet hKernel).eta =
          (hBridge hKernel).liftedJet.eta)
    (sameA :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        (hReceipt.liftKernelToJet hKernel).A =
          (hBridge hKernel).liftedJet.A)
    (sameOwnerRootBudget :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        hReceipt.ownerRootBudgetForGap =
          (hBridge hKernel).ownerRootBudgetForGap) :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      (hReceipt.liftKernelToJet hKernel).eta *
          (hReceipt.liftKernelToJet hKernel).A ≤
        hReceipt.ownerRootBudgetForGap := by
  intro hKernel
  have hcontrols :=
    ownerRootBudgetControlsLiftedGap_of_sameOwnerPiLockBudgetBridge
      (hBridge hKernel)
  rw [← sameEta hKernel, ← sameA hKernel, ← sameOwnerRootBudget hKernel] at hcontrols
  exact hcontrols

/--
Level413 effective-invoice consumer for the Level411 numeric gap field.  This
keeps the scalar binding explicit between the trace-zero budget jet and the
affine effective-invoice source.
-/
theorem ownerRootBudgetControlsLiftedGap_of_kernelSelectedHHEffectiveInvoiceBridge
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hReceipt : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice)
    (hBridge :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        SameOwnerEffectiveInvoiceBudgetBridge)
    (sameEta :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        (hReceipt.liftKernelToJet hKernel).eta =
          (hBridge hKernel).liftedJet.eta)
    (sameA :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        (hReceipt.liftKernelToJet hKernel).A =
          (hBridge hKernel).liftedJet.A)
    (sameOwnerRootBudget :
      ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
        hReceipt.ownerRootBudgetForGap =
          (hBridge hKernel).ownerRootBudgetForGap) :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      (hReceipt.liftKernelToJet hKernel).eta *
          (hReceipt.liftKernelToJet hKernel).A ≤
        hReceipt.ownerRootBudgetForGap := by
  intro hKernel
  have hcontrols :=
    ownerRootBudgetControlsLiftedGap_of_sameOwnerEffectiveInvoiceBudgetBridge
      (hBridge hKernel)
  rw [← sameEta hKernel, ← sameA hKernel, ← sameOwnerRootBudget hKernel] at hcontrols
  exact hcontrols

/--
Consume the sharper Level411 receipt as the Level409 universal lift.  The
constructor only repackages paid fields; it does not infer selected-HH
production from kernel positivity by name.
-/
def TangentialKernelToTraceZeroPositiveNetJetLift.ofKernelSelectedHHPositiveNetGap
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (h : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice) :
    TangentialKernelToTraceZeroPositiveNetJetLift carrier dualPrice where
  liftKernelToJet := h.liftKernelToJet
  liftedJetSamePressurePacket := h.liftedJetSamePressurePacket
  liftedJetSameState := h.liftedJetSameState
  errorReserveBelowLiftedGap := h.errorReserveBelowFixedGap
  quotientCarrierRepresentativeFixedBeforeLift :=
    h.representativeSelectorFixedBeforeReserveComparison
  quotientCarrierRepresentativeFixedBeforeLift_proof :=
    h.representativeSelectorFixedBeforeReserveComparison_proof
  selectedHHBecomesStateSignedProduction :=
    h.selectedHHToStateProductionIdentity
  selectedHHBecomesStateSignedProduction_proof :=
    h.selectedHHToStateProductionIdentity_proof
  sameCarrierCutoffInvoicePaidForLiftedJet :=
    h.sameCarrierCutoffInvoicePaidForGap
  sameCarrierCutoffInvoicePaidForLiftedJet_proof :=
    h.sameCarrierCutoffInvoicePaidForGap_proof
  noProxyPressureVisibilityOnlyLift := h.noProxyPressureVisibilityOnlyGap
  noProxyPressureVisibilityOnlyLift_proof :=
    h.noProxyPressureVisibilityOnlyGap_proof
  noFinalCarrierCancellationInLift :=
    h.sameOwnerOrSourceBindingForGap ∧ h.ownerRootNumericBoundForGap ∧
      h.noOverlapOrDisjointnessForGap ∧ h.payoffIndependenceForGap
  noFinalCarrierCancellationInLift_proof :=
    And.intro h.sameOwnerOrSourceBindingForGap_proof
      (And.intro h.ownerRootNumericBoundForGap_proof
        (And.intro h.noOverlapOrDisjointnessForGap_proof
          h.payoffIndependenceForGap_proof))
  noTargetDefinedLiftAfterPayoff :=
    h.etaAGapScaleFixedBeforeReserveComparison ∧
      h.noTargetDefinedGapInflation
  noTargetDefinedLiftAfterPayoff_proof :=
    And.intro h.etaAGapScaleFixedBeforeReserveComparison_proof
      h.noTargetDefinedGapInflation_proof

/--
Target-defined gap inflation is the nearest Level411 confuser: selected-HH
positivity and a pressure-frame receipt are present, but the numeric gap or
owner-root budget is chosen after the reserve comparison.
-/
structure TargetDefinedSelectedHHGapInflationConfuser
    (carrier : QuotientMinimalTransactionCarrier) where
  kernel : TangentialDivDivNullPositiveHHKernelPacket carrier
  targetDefinedGapInflationStillAdmissible : Prop
  targetDefinedGapInflationStillAdmissible_proof :
    targetDefinedGapInflationStillAdmissible
  ownerRootNumericBoundMissing : Prop
  ownerRootNumericBoundMissing_proof : ownerRootNumericBoundMissing
  sameOwnerSourceBindingMissing : Prop
  sameOwnerSourceBindingMissing_proof : sameOwnerSourceBindingMissing
  noOverlapOrDisjointnessMissing : Prop
  noOverlapOrDisjointnessMissing_proof : noOverlapOrDisjointnessMissing

/-- Target-defined gap inflation blocks the Level411 receipt. -/
theorem no_KernelSelectedHHToSameStatePositiveNetGapReceipt_of_targetDefinedGap
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hConfuser : TargetDefinedSelectedHHGapInflationConfuser carrier)
    (hReceipt : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice)
    (hSameGap :
      hReceipt.noTargetDefinedGapInflation =
        (hConfuser.targetDefinedGapInflationStillAdmissible = False)) :
    False := by
  have hmissing :
      hConfuser.targetDefinedGapInflationStillAdmissible = False := by
    simpa [hSameGap] using hReceipt.noTargetDefinedGapInflation_proof
  have hproof := hConfuser.targetDefinedGapInflationStillAdmissible_proof
  rw [hmissing] at hproof
  exact hproof

/-- Missing owner-root numeric control blocks the Level411 receipt. -/
theorem no_KernelSelectedHHToSameStatePositiveNetGapReceipt_of_ownerRootMissing
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hConfuser : TargetDefinedSelectedHHGapInflationConfuser carrier)
    (hReceipt : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice)
    (hSameOwnerRoot :
      hReceipt.ownerRootNumericBoundForGap =
        (hConfuser.ownerRootNumericBoundMissing = False)) :
    False := by
  have hmissing : hConfuser.ownerRootNumericBoundMissing = False := by
    simpa [hSameOwnerRoot] using hReceipt.ownerRootNumericBoundForGap_proof
  have hproof := hConfuser.ownerRootNumericBoundMissing_proof
  rw [hmissing] at hproof
  exact hproof

/-- Same-owner/source mismatch blocks the Level411 receipt. -/
theorem no_KernelSelectedHHToSameStatePositiveNetGapReceipt_of_ownerSourceMissing
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hConfuser : TargetDefinedSelectedHHGapInflationConfuser carrier)
    (hReceipt : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice)
    (hSameOwner :
      hReceipt.sameOwnerOrSourceBindingForGap =
        (hConfuser.sameOwnerSourceBindingMissing = False)) :
    False := by
  have hmissing : hConfuser.sameOwnerSourceBindingMissing = False := by
    simpa [hSameOwner] using hReceipt.sameOwnerOrSourceBindingForGap_proof
  have hproof := hConfuser.sameOwnerSourceBindingMissing_proof
  rw [hmissing] at hproof
  exact hproof

/-- Overlap/disjointness failure blocks the Level411 receipt. -/
theorem no_KernelSelectedHHToSameStatePositiveNetGapReceipt_of_overlapMissing
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hConfuser : TargetDefinedSelectedHHGapInflationConfuser carrier)
    (hReceipt : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice)
    (hSameOverlap :
      hReceipt.noOverlapOrDisjointnessForGap =
        (hConfuser.noOverlapOrDisjointnessMissing = False)) :
    False := by
  have hmissing : hConfuser.noOverlapOrDisjointnessMissing = False := by
    simpa [hSameOverlap] using hReceipt.noOverlapOrDisjointnessForGap_proof
  have hproof := hConfuser.noOverlapOrDisjointnessMissing_proof
  rw [hmissing] at hproof
  exact hproof

/--
A universal same-state kernel-to-jet lift lets the existing dual-price theorem
exclude all selected tangential pressure-null positive-HH kernel packets on the
carrier.
-/
theorem no_TangentialDivDivNullPositiveHHKernel_of_kernelToTraceZeroPositiveNetJetLift
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hLift : TangentialKernelToTraceZeroPositiveNetJetLift carrier dualPrice) :
    ¬ Nonempty (TangentialDivDivNullPositiveHHKernelPacket carrier) := by
  intro hNonempty
  rcases hNonempty with ⟨hKernel⟩
  exact no_TraceZeroStrainPositiveNetBudgetJet_of_dualPriceFrameReceipt
    dualPrice (hLift.liftKernelToJet hKernel)
    (hLift.liftedJetSamePressurePacket hKernel)
    (hLift.liftedJetSameState hKernel)
    (hLift.errorReserveBelowLiftedGap hKernel)

/--
The sharpened Level411 source-law receipt directly excludes the selected
tangential pressure-null positive-HH packet family by first constructing the
Level409 lift and then consuming the dual-price positive-net-jet exclusion.
-/
theorem no_TangentialDivDivNullPositiveHHKernel_of_kernelSelectedHHPositiveNetGap
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (h : KernelSelectedHHToSameStatePositiveNetGapReceipt carrier dualPrice) :
    ¬ Nonempty (TangentialDivDivNullPositiveHHKernelPacket carrier) :=
  no_TangentialDivDivNullPositiveHHKernel_of_kernelToTraceZeroPositiveNetJetLift
    (TangentialKernelToTraceZeroPositiveNetJetLift.ofKernelSelectedHHPositiveNetGap
      h)

