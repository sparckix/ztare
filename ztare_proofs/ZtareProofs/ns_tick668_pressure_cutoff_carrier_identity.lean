    {Ω : Type u}
    (h : LEINativeDefinitionalThresholdTransactionChannelSource Ω) :
    LEINativeHighInterfaceDefinedThresholdChannelSource Ω where
  toLEINativeTick538PositiveVariationBranchSource :=
    h.toLEINativeTick538PositiveVariationBranchSource
  selectedCorrelationThresholdIndex_eq_selectedHighInterfacePrefixIndex :=
    h.selectedCorrelationThresholdIndex_eq_selectedHighInterfacePrefixIndex
  selectedHighInterfacePrefixIndex_lt_restrictedPrefix :=
    h.selectedHighInterfacePrefixIndex_lt_restrictedPrefix
  restrictedPrefix_le_highInterfacePrefixLength :=
    h.restrictedPrefix_le_highInterfacePrefixLength
  thresholdInterfacePayment_eq_highInterfaceChannel_on_restrictedPrefix := by
    intro n hn
    have hnHigh : n < h.highInterfacePrefixLength :=
      Nat.lt_of_lt_of_le hn h.restrictedPrefix_le_highInterfacePrefixLength
    calc
      h.thresholdInterfacePayment n =
          h.suitableDefectSource.muA (h.highInterfaceEventSet n) := by
        rw [h.thresholdInterfacePayment_eq_defectActiveChannel]
      _ = h.activeMeasure (h.highInterfaceEventSet n) :=
        (h.activeMeasure_eq_defectActive_on_H n hnHigh).symm
