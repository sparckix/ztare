/--
Arithmetic consumer for the selected-prefix owner-preimage theorem.  Once the
same selected prefix has a pointwise cone charge and a finite owner-preimage
budget, the core-plus-sheath event prefix is bounded by `rootBudget / c`.
-/
theorem totalConeSelectedPrefixEventPay_le_rootBudget_div_c
    (h : TotalConeSelectedPrefixOwnerPreimageReceipt) :
    ∀ N : Nat,
      nsTick668FinitePrefixSum h.angularEventPay N ≤ h.rootBudget / h.c := by
  intro N
  have hpoint :
      nsTick668FinitePrefixSum
          (fun n : Nat => h.c * h.angularEventPay n) N ≤
        nsTick668FinitePrefixSum
          (fun n : Nat => h.ownerAtomCharge (h.ownerOfEvent n)) N :=
    nsTick668FinitePrefixSum_le_of_pointwise
      h.pointwiseEventToOwnerConeCharge N
  rw [nsTick668FinitePrefixSum_const_mul_left] at hpoint
  have hbudget :
      h.c * nsTick668FinitePrefixSum h.angularEventPay N ≤
        h.rootBudget := by
    exact le_trans hpoint (h.selectedPrefixOwnerPreimageBudget N)
  have hbudget' :
      nsTick668FinitePrefixSum h.angularEventPay N * h.c ≤
        h.rootBudget := by
    simpa [mul_comm] using hbudget
  exact (le_div_iff₀ h.c_pos).2 hbudget'

