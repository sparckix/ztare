/--
Stronger repaired payment-biased selector after the zero-interface sink attack.
The threshold law is allowed to be interface-weighted only if it produces a
same-source event that is both interface-floor-high and boundary-paid before
payoff.  This is the current live analytic source theorem.
-/
structure InterfaceWeightedBoundaryPaidFloorCorrelationSource extends
    PaymentBiasedCoareaSliceSource where
  sourceInterfaceLawFixedBeforePayoff : Prop
  sourceInterfaceLawFixedBeforePayoff_proof :
    sourceInterfaceLawFixedBeforePayoff
  selectedEventHasPositiveSourceInterfaceWeight : Prop
  selectedEventHasPositiveSourceInterfaceWeight_proof :
    selectedEventHasPositiveSourceInterfaceWeight
  selectedEventPaysInterfaceFloorFromSourceLaw :
    interfacePaymentFloor <=
      thresholdInterfacePayment selectedCorrelationThresholdIndex
  selectedEventBoundaryPaysInterfaceFromSameLaw :
    thresholdInterfacePayment selectedCorrelationThresholdIndex <=
      thresholdBoundaryCharge selectedCorrelationThresholdIndex
  selectedBoundaryPaysFloorNotJustPrefixSum : Prop
  selectedBoundaryPaysFloorNotJustPrefixSum_proof :
    selectedBoundaryPaysFloorNotJustPrefixSum
  zeroInterfaceSinkExcludedByWeightLaw : Prop
  zeroInterfaceSinkExcludedByWeightLaw_proof :
    zeroInterfaceSinkExcludedByWeightLaw

/-- The repaired interface-weighted selector really pays the interface floor. -/
theorem InterfaceWeightedBoundaryPaidFloorCorrelationSource.boundary_pays_interface_floor
    (h : InterfaceWeightedBoundaryPaidFloorCorrelationSource) :
    h.interfacePaymentFloor <=
      h.thresholdBoundaryCharge h.selectedCorrelationThresholdIndex := by
  linarith [h.selectedEventPaysInterfaceFloorFromSourceLaw,
    h.selectedEventBoundaryPaysInterfaceFromSameLaw]

/--
Weighted-law confuser: an interface-weighted vocabulary can still fail if all
interface-floor events are boundary-underpaid and the boundary surplus sits on
low- or zero-interface events.
-/
structure InterfaceWeightedBoundaryPaidFloorCorrelationConfuser extends
    PaymentBiasedCoareaSliceSource where
  interfaceWeightedVocabularyPresent : Prop
  interfaceWeightedVocabularyPresent_proof : interfaceWeightedVocabularyPresent
  allInterfaceFloorEventsBoundaryUnderpaid : Prop
  allInterfaceFloorEventsBoundaryUnderpaid_proof :
    allInterfaceFloorEventsBoundaryUnderpaid
  boundarySurplusOnLowOrZeroInterfaceEvents : Prop
  boundarySurplusOnLowOrZeroInterfaceEvents_proof :
    boundarySurplusOnLowOrZeroInterfaceEvents
  weightedCorrelationReceiptMissing : Prop
  weightedCorrelationReceiptMissing_proof :
    weightedCorrelationReceiptMissing
  no_floorPaidSelector :
    InterfaceWeightedBoundaryPaidFloorCorrelationSource → False

/-- A repaired source cannot coexist with the weighted-law confuser. -/
theorem no_InterfaceWeightedBoundaryPaidFloorCorrelationSource_of_confuser
    (hConfuser : InterfaceWeightedBoundaryPaidFloorCorrelationConfuser)
    (hSource : InterfaceWeightedBoundaryPaidFloorCorrelationSource) :
    False :=
  hConfuser.no_floorPaidSelector hSource


/--
Restricted high-interface boundary-payment source.  This is the smaller theorem
exposed by the weighted-law confuser: it is not enough for the total prefix
boundary charge to dominate the total interface charge.  The selected event
must lie in the high-interface sublaw and its boundary charge must pay that
interface charge before payoff.
-/
structure RestrictedHighInterfaceBoundaryPaymentSource extends
    PaymentBiasedCoareaSliceSource where
  restrictedSourceLawPrefixLength : Nat
  selectedCorrelationThresholdIndex_lt_restrictedPrefix :
    selectedCorrelationThresholdIndex < restrictedSourceLawPrefixLength
  sourceInterfaceLawFixedBeforePayoff : Prop
  sourceInterfaceLawFixedBeforePayoff_proof :
    sourceInterfaceLawFixedBeforePayoff
  selectedEventHasPositiveSourceInterfaceWeight : Prop
  selectedEventHasPositiveSourceInterfaceWeight_proof :
    selectedEventHasPositiveSourceInterfaceWeight
  restrictedSelectedEventPaysFloorFromSourceLaw :
    interfacePaymentFloor <=
      thresholdInterfacePayment selectedCorrelationThresholdIndex
  restrictedBoundaryPaysSelectedHighInterface :
    thresholdInterfacePayment selectedCorrelationThresholdIndex <=
      thresholdBoundaryCharge selectedCorrelationThresholdIndex
  restrictedHighInterfaceBoundaryDominance : Prop
  restrictedHighInterfaceBoundaryDominance_proof :
    restrictedHighInterfaceBoundaryDominance
  selectedBoundaryPaysFloorNotJustPrefixSum : Prop
  selectedBoundaryPaysFloorNotJustPrefixSum_proof :
    selectedBoundaryPaysFloorNotJustPrefixSum
  zeroInterfaceSinkExcludedByWeightLaw : Prop
  zeroInterfaceSinkExcludedByWeightLaw_proof :
    zeroInterfaceSinkExcludedByWeightLaw
  notFinitePrefixSumOnly : Prop
  notFinitePrefixSumOnly_proof : notFinitePrefixSumOnly

/--
The restricted high-interface payment theorem is exactly sufficient to inhabit
the repaired weighted floor-correlation source.
-/
def InterfaceWeightedBoundaryPaidFloorCorrelationSource.ofRestrictedHighInterfaceBoundaryPayment
    (h : RestrictedHighInterfaceBoundaryPaymentSource) :
    InterfaceWeightedBoundaryPaidFloorCorrelationSource where
  toPaymentBiasedCoareaSliceSource := h.toPaymentBiasedCoareaSliceSource
  sourceInterfaceLawFixedBeforePayoff := h.sourceInterfaceLawFixedBeforePayoff
  sourceInterfaceLawFixedBeforePayoff_proof :=
    h.sourceInterfaceLawFixedBeforePayoff_proof
  selectedEventHasPositiveSourceInterfaceWeight :=
    h.selectedEventHasPositiveSourceInterfaceWeight
  selectedEventHasPositiveSourceInterfaceWeight_proof :=
    h.selectedEventHasPositiveSourceInterfaceWeight_proof
  selectedEventPaysInterfaceFloorFromSourceLaw :=
    h.restrictedSelectedEventPaysFloorFromSourceLaw
  selectedEventBoundaryPaysInterfaceFromSameLaw :=
    h.restrictedBoundaryPaysSelectedHighInterface
  selectedBoundaryPaysFloorNotJustPrefixSum :=
    h.selectedBoundaryPaysFloorNotJustPrefixSum
  selectedBoundaryPaysFloorNotJustPrefixSum_proof :=
    h.selectedBoundaryPaysFloorNotJustPrefixSum_proof
  zeroInterfaceSinkExcludedByWeightLaw := h.zeroInterfaceSinkExcludedByWeightLaw
  zeroInterfaceSinkExcludedByWeightLaw_proof :=
    h.zeroInterfaceSinkExcludedByWeightLaw_proof


