/--
Final-carrier-only no-go for the frame self-tax source.  The new self-tax `Q`
must be a pre-summed same-source pressure-frame price; it cannot be charged to
the final projected carrier after core/sheath cancellation.
-/
structure PressureL2FrameSelfTaxFinalCarrierNoGo
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    (formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade)
    (frameSelfTaxPrice finalCarrierReceipt : Real) where
  exactSheathCancellation :
    formula.sheathErrorMoment = -formula.coreMoment
  frameSelfTaxPrice_pos : 0 < frameSelfTaxPrice
  finalCarrierReceipt_eq :
    finalCarrierReceipt =
      renormalizedPressureHessianL2Carrier pressureL2 radialGrade
  finalCarrierOnlyReceiptWouldPay :
    frameSelfTaxPrice ≤ finalCarrierReceipt

/--
A positive frame self-tax cannot be paid by a final-carrier-only pressure
receipt under exact same-window sheath cancellation.
-/
theorem false_of_pressureL2FrameSelfTaxFinalCarrierNoGo
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    {frameSelfTaxPrice finalCarrierReceipt : Real}
    (h :
      PressureL2FrameSelfTaxFinalCarrierNoGo formula
        frameSelfTaxPrice finalCarrierReceipt) :
    False :=
  no_positive_pressureConeCharge_bound_by_finalCarrierReceipt
    formula h.exactSheathCancellation h.finalCarrierReceipt_eq
    h.frameSelfTaxPrice_pos h.finalCarrierOnlyReceiptWouldPay

/--
Signed-budget gap confuser for the sterility branch.  Local positive pockets or
unsigned production are irrelevant unless the same trajectory has nonpositive
net budget.  If the net budget is positive, sterility is false by definition.
-/
structure BalancedCoreSheathSignedBudgetGapConfuser where
  packet : BalancedCoreSheathDiniLadderConePacket
  state : NS.StealthGrowthState
  localPositivePockets : Real
  localPositivePockets_pos : 0 < localPositivePockets
  sameOwnerSelectedStream : Prop
  sameOwnerSelectedStream_proof : sameOwnerSelectedStream
  positiveNetBudget : 0 < NS.netEnstrophyBudget state

/--
The finite trace-zero positive-production jet instantiates the signed-budget gap
confuser, hence blocks sterility unless an extra same-trajectory budget theorem
excludes this local algebra.
-/
def BalancedCoreSheathSignedBudgetGapConfuser.ofTraceZeroPositiveNetBudgetJet
    (h : TraceZeroStrainPositiveNetBudgetJet) :
    BalancedCoreSheathSignedBudgetGapConfuser where
  packet := h.packet
  state := h.state
  localPositivePockets := h.eta * h.A
  localPositivePockets_pos := mul_pos h.eta_pos h.A_pos
  sameOwnerSelectedStream := h.sameOwnerSelectedStream
  sameOwnerSelectedStream_proof := h.sameOwnerSelectedStream_proof
  positiveNetBudget := positiveNetBudget_of_traceZeroStrainPositiveProductionJet h

/--
Positive same-trajectory net budget rules out a signed-growth sterility receipt
for that state.
-/
theorem no_BalancedCoreSheathSignedGrowthSterilityReceipt_of_positiveNetBudget
    (hConfuser : BalancedCoreSheathSignedBudgetGapConfuser)
    (hReceipt : BalancedCoreSheathSignedGrowthSterilityReceipt)
    (_hSamePacket : hReceipt.packet = hConfuser.packet)
    (hSameState : hReceipt.state = hConfuser.state) :
    False := by
  have hsterile : NS.stealthGrowthSterile hConfuser.state := by
    simpa [hSameState] using hReceipt.stealthGrowthSterile
  exact not_le_of_gt hConfuser.positiveNetBudget hsterile

/--
The five-shadow valuation budget cannot be paid by the balanced Dini ladder's
overflow currency.  The valuation prefix may be the pre-summed total cone
variation; overflow remains the wrong payer.
-/
theorem no_TraceFreeL2ValuationC7CofinalOwnerBudget_of_balancedDiniOverflowOnly
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hPacket : BalancedCoreSheathDiniLadderConePacket)
    (hBudget : TraceFreeL2ValuationC7CofinalOwnerBudget formula)
    (N : Nat)
    (hSameValuationPrefix :
      nsTick668FinitePrefixSum hBudget.source.tracefreeValuationPay N =
        hPacket.totalConeVariationPrefix)
    (hOwnerPaidOnlyByOverflow :
      hBudget.budget.C * hBudget.budget.ownerTVBudget ≤
        hPacket.comparisonConstant * hPacket.overflowChargePrefix) :
    False := by
  have hValuationBound :=
    hBudget.valuationPrefix_le_ownerTVBudget_all N
  have hPrefixBound :
      nsTick668FinitePrefixSum hBudget.source.tracefreeValuationPay N ≤
        hPacket.comparisonConstant * hPacket.overflowChargePrefix :=
    le_trans hValuationBound hOwnerPaidOnlyByOverflow
  have hTotalBound :
      hPacket.totalConeVariationPrefix ≤
        hPacket.comparisonConstant * hPacket.overflowChargePrefix := by
    simpa [hSameValuationPrefix] using hPrefixBound
  exact no_totalConeVariationPayment_from_balancedCoreSheathDiniLadder
    hPacket hTotalBound

/--
Replay-invariant budget language does not itself defeat the diagonal Dini
packet.  If its payment stream is the same overflowing harmonic shadow-TV
stream, the receipt's owner-prefix bound contradicts the packet.
-/
theorem no_ReplayInvariantFiveShadowValuationBudgetReceipt_of_diagonalDiniOverflow
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hPacket : FiveShadowDiagonalDiniValuationOverflowConfuser)
    (hReceipt : ReplayInvariantFiveShadowValuationBudgetReceipt formula)
    (hSameReplayStream :
      hReceipt.replayInvariantShadowTVPay =
        hPacket.replayInvariantShadowTVPay) :
    False := by
  rcases hPacket.replayInvariantShadowTVPrefixesOverflow
      (hReceipt.budget.C * hReceipt.budget.ownerTVBudget) with
    ⟨N, hExceeds⟩
  have hBound :
      nsTick668FinitePrefixSum hPacket.replayInvariantShadowTVPay N ≤
        hReceipt.budget.C * hReceipt.budget.ownerTVBudget := by
    simpa [hSameReplayStream]
      using hReceipt.replayInvariantShadowTVPrefix_le_ownerBudget_all N
  exact not_lt_of_ge hBound hExceeds

/--
The Dini square/linear packet also blocks the valuation-specific owner budget
when the five-shadow valuation stream is the same overflowing linear stream.
-/
theorem no_TraceFreeL2ValuationC7CofinalOwnerBudget_of_diniSquareOnly
