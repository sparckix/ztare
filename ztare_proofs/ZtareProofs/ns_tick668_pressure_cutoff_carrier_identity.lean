  selectedSectionContainedInPositiveEigencone : Prop
  selectedSectionContainedInPositiveEigencone_proof :
    selectedSectionContainedInPositiveEigencone
  radialStrainAbsLowerBoundOnCone : Prop
  radialStrainAbsLowerBoundOnCone_proof : radialStrainAbsLowerBoundOnCone
  activeScalePiPinnedAs_sR2_over_nu : Prop
  activeScalePiPinnedAs_sR2_over_nu_proof : activeScalePiPinnedAs_sR2_over_nu
  rawConeVariationPaysGeometricFraction :
    coneConstant * (affineReynoldsRatio - 1) <= rawConeInterfaceVariation
  coneLossPaidBeforeProjection :
    affineReynoldsRatio - 1 <= coneNormalizedSelectedVariation
  selectedAbsoluteVariation_eq_coneNormalizedVariation :
    selectedAbsoluteVariation = coneNormalizedSelectedVariation

