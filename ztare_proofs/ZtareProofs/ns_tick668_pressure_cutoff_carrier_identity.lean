/--
A dual-price pressure-frame receipt produces the quantitative production bound
with `C * residual + retuningError` compressed into a single error reserve.
-/
theorem signedProduction_le_viscous_plus_error_of_dualPriceFrameReceipt
    (h : TraceZeroPositiveNetBudgetDualPriceFrameReceipt) :
    h.state.signedProduction ≤ h.state.viscousDissipation + h.errorReserve := by
  have hprod_avg :
      h.state.signedProduction ≤
        (h.state.viscousDissipation + h.frameSelfTaxPrice) / 2 :=
    NS.production_le_dual_price_average
      h.viscousDissipation_nonnegative
      h.frameSelfTaxPrice_nonnegative
      h.production_sq_le_dual_product
  nlinarith [hprod_avg, h.frameSelfTaxPrice_le_viscous_plus_two_error]

/--
The dual-price pressure-frame route excludes the positive trace-zero jet once
its explicit error reserve is smaller than the jet gap.
