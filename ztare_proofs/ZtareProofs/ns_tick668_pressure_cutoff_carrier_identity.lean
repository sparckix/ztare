theorem LEINativeSelectedTopologyOrientationCapacityPrefixSource.prefix_bound
    {Ω : Type u}
    (h : LEINativeSelectedTopologyOrientationCapacityPrefixSource Ω) :
    ∀ K, (Finset.range K).sum h.costSeq ≤ h.capacityBudget := by
  intro K
  have haccount := h.cleanVolumeAccountingForSelectedStream
  have hPollutionLeCapacity : h.Vpolluted ≤ h.Vtotal + h.Vcleaned := by
    unfold cleanVolumeAccounting at haccount
    linarith [h.cleanVolume_nonneg]
  have hMul : h.κ * (Finset.range K).sum h.costSeq ≤ h.κ * h.capacityBudget := by
    linarith [h.selectedCostCreatesOrientationPollution K,
      hPollutionLeCapacity, h.finiteOrientationCapacityConvertedToBudget]
  exact le_of_mul_le_mul_left hMul h.κ_pos

