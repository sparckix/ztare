/--
Localized affine packet binding source.  This is the PDE-facing consumer for the
finite-dimensional cone theorem: the packet must supply eigenvalue data, trace
zero, max ordering, selected-section cone inclusion, and active-scale binding
before the cone-loss-paid interface variation source can be used.
-/
structure LocalizedAffineEigenframeSectionBindingSource extends
    AffinePositiveEigenconeLossPaidInterfaceVariationSource where
  positiveEigenvalue : Real
  transverseEigenvalue : Real
  remainingEigenvalue : Real
  selectedDirectionCosSq : Real
  positiveEigenvalue_nonneg : 0 <= positiveEigenvalue
  traceZeroEigenvalueSum :
    positiveEigenvalue + transverseEigenvalue + remainingEigenvalue = 0
  remainingEigenvalue_le_positiveEigenvalue :
    remainingEigenvalue <= positiveEigenvalue
  selectedDirectionInFixedCone :
    (5 / 6 : Real) <= selectedDirectionCosSq
  selectedDirectionCosSq_le_one : selectedDirectionCosSq <= 1
  activeScaleStrain_eq_positiveEigenvalue : Prop
  activeScaleStrain_eq_positiveEigenvalue_proof :
    activeScaleStrain_eq_positiveEigenvalue
  selectedSectionConeInclusionFromPacketGeometry : Prop
  selectedSectionConeInclusionFromPacketGeometry_proof :
    selectedSectionConeInclusionFromPacketGeometry

/--
The localized affine binding source exposes the finite-dimensional lower bound
that must be transferred into the interface variation estimate.
-/
theorem LocalizedAffineEigenframeSectionBindingSource.finiteDimensionalConeLowerBound
    (h : LocalizedAffineEigenframeSectionBindingSource) :
    (1 / 2 : Real) * h.positiveEigenvalue <=
      h.positiveEigenvalue * h.selectedDirectionCosSq +
        h.transverseEigenvalue * (1 - h.selectedDirectionCosSq) :=
  traceZeroMaxEigencone_radialStrain_ge_half h.positiveEigenvalue_nonneg
    h.traceZeroEigenvalueSum h.remainingEigenvalue_le_positiveEigenvalue
    h.selectedDirectionInFixedCone h.selectedDirectionCosSq_le_one

