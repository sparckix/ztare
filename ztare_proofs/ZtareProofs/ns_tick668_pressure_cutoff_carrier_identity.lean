structure TwoInvoiceProjectionLossPacket extends
    PreprojectionProjectedCollarExchangeSource where
  collarAndTailEachUseSeparateTotalInvoice : Prop
  collarAndTailEachUseSeparateTotalInvoice_proof :
    collarAndTailEachUseSeparateTotalInvoice
  sharedPartitionMissing : Prop
  sharedPartitionMissing_proof : sharedPartitionMissing
  totalInvoice_lt_projectedPayment : totalInvoice < projectedAngularBoundaryPayment

/-- A two-invoice packet blocks the shared-partition source for matching data. -/
theorem no_SharedPartitionProjectedCollarInvoiceSource_of_twoInvoiceProjectionLoss
    (c : TwoInvoiceProjectionLossPacket)
    (h : SharedPartitionProjectedCollarInvoiceSource)
    (sameTotalInvoice : h.totalInvoice = c.totalInvoice)
    (sameProjectedPayment :
      h.projectedAngularBoundaryPayment = c.projectedAngularBoundaryPayment) : False := by
  have hle := h.projectedPayment_le_totalInvoice
  rw [sameTotalInvoice, sameProjectedPayment] at hle
  linarith [hle, c.totalInvoice_lt_projectedPayment]

/--
Owner-root joint collar/tail partition source.  This is stricter than the
shared total-invoice partition: the collar charge and projection-tail reserve
must be paid by one fixed owner-root channel before projection, not merely by
labels inside the ambient total invoice.
-/
structure JointOwnerRootCollarTailPartitionSource extends
    PreprojectionProjectedCollarExchangeSource where
  jointCollarTailChannel : Real
  jointCollarTailChannel_nonneg : 0 <= jointCollarTailChannel
  collar_plus_tail_le_jointChannel :
    coareaCollarCharge + projectionTailReserve <= jointCollarTailChannel
  jointChannel_le_ownerRootBudget : jointCollarTailChannel <= ownerRootBudget
  existingCollarReserveSpend : Real
  existingCollarReserveSpend_nonneg : 0 <= existingCollarReserveSpend
  existingCollarReserveSpend_eq_pressure_duhamel_inherited :
    existingCollarReserveSpend =
      angularCollarPressureReserveSpend + angularCollarDuhamelReserveSpend +
        angularCollarInheritedReserveSpend
  projectionTailPlusExistingReserveNoOverlapBound :
    projectionTailReserve + existingCollarReserveSpend <= jointCollarTailChannel
  jointChannelDeclaredBeforePayoffStep : Nat
  projectedPayoffStep : Nat
  jointChannelDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    jointChannelDeclaredBeforePayoffStep < projectedPayoffStep
  sameOwnerJointChannel_le_ownerRootBudget :
    jointCollarTailChannel <= ownerRootBudget
  mainSurplusSpend : Real
  mainSurplusSpend_nonneg : 0 <= mainSurplusSpend
  jointChannelNoReuseWithMainSurplusSpend :
    jointCollarTailChannel + mainSurplusSpend <= ownerRootBudget
  jointChannelFixedBeforeProjection : Prop
  jointChannelFixedBeforeProjection_proof : jointChannelFixedBeforeProjection
  jointChannelRefinesOwnerPreimage : Prop
  jointChannelRefinesOwnerPreimage_proof : jointChannelRefinesOwnerPreimage
  jointChannelNoOverlapWithExistingCollarReserves : Prop
  jointChannelNoOverlapWithExistingCollarReserves_proof :
    jointChannelNoOverlapWithExistingCollarReserves
  jointChannelNotDefinedFromPayoff : Prop
  jointChannelNotDefinedFromPayoff_proof : jointChannelNotDefinedFromPayoff

/-- A joint owner-root channel gives the projected payment bound under the owner root. -/
theorem JointOwnerRootCollarTailPartitionSource.projectedPayment_le_ownerRootBudget
    (h : JointOwnerRootCollarTailPartitionSource) :
    h.projectedAngularBoundaryPayment <= h.ownerRootBudget := by
  linarith [h.projectedPayment_le_preprojection_plus_tail,
    h.collar_plus_tail_le_jointChannel,
    h.jointChannel_le_ownerRootBudget]

/-- The owner-root joint channel also implies the weaker total-invoice bound. -/
theorem JointOwnerRootCollarTailPartitionSource.projectedPayment_le_totalInvoice
    (h : JointOwnerRootCollarTailPartitionSource) :
    h.projectedAngularBoundaryPayment <= h.totalInvoice := by
  linarith [h.projectedPayment_le_ownerRootBudget,
    h.ownerRootBudget_le_totalInvoice]

/-- The joint channel can pay the projection tail without rebilling existing collar reserves. -/
theorem JointOwnerRootCollarTailPartitionSource.tail_plus_existing_reserves_le_ownerRootBudget
    (h : JointOwnerRootCollarTailPartitionSource) :
    h.projectionTailReserve + h.existingCollarReserveSpend <= h.ownerRootBudget := by
  linarith [h.projectionTailPlusExistingReserveNoOverlapBound,
    h.jointChannel_le_ownerRootBudget]

/-- The joint channel and main surplus are both inside the same owner-root budget. -/
theorem JointOwnerRootCollarTailPartitionSource.joint_plus_mainSurplus_le_ownerRootBudget
    (h : JointOwnerRootCollarTailPartitionSource) :
    h.jointCollarTailChannel + h.mainSurplusSpend <= h.ownerRootBudget :=
  h.jointChannelNoReuseWithMainSurplusSpend

/--
Finite projected-window no-overlap assignment.  This is the smaller theorem
surfaced by the PDE workbench: before passing through the projected window,
assign tail atoms and existing collar-reserve atoms to one owner-root joint
channel, then prove the finite no-overlap assignment persists under projection.
-/
structure FiniteProjectedWindowNoOverlapAssignmentSource extends
    JointOwnerRootCollarTailPartitionSource where
  finiteProjectedWindow : Nat
  tailAssignment : Nat → Nat
  reserveAssignment : Nat → Nat
  tailAtomCharge : Nat → Real
  reserveAtomCharge : Nat → Real
  jointAtomCharge : Nat → Real
  tailPrefixCharge : Real
  tailPrefixCharge_nonneg : 0 <= tailPrefixCharge
  reservePrefixCharge : Real
  reservePrefixCharge_nonneg : 0 <= reservePrefixCharge
  assignmentOverlapReserve : Real
  assignmentOverlapReserve_nonneg : 0 <= assignmentOverlapReserve
  projectionTailReserve_le_tailPrefixCharge :
    projectionTailReserve <= tailPrefixCharge
  existingReserveSpend_le_reservePrefixCharge :
    existingCollarReserveSpend <= reservePrefixCharge
  finiteTailReservePrefixes_le_jointChannel_plus_overlap :
    tailPrefixCharge + reservePrefixCharge <=
      jointCollarTailChannel + assignmentOverlapReserve
  assignmentOverlapReserve_eq_zero : assignmentOverlapReserve = 0
  assignmentFixedBeforeProjection : Prop
  assignmentFixedBeforeProjection_proof : assignmentFixedBeforeProjection
  tailReserveAssignmentSameCarrier : Prop
  tailReserveAssignmentSameCarrier_proof : tailReserveAssignmentSameCarrier
  noOverlapAssignmentPersistsToProjectedWindow : Prop
  noOverlapAssignmentPersistsToProjectedWindow_proof :
    noOverlapAssignmentPersistsToProjectedWindow
  limitPassageInheritanceLemmaNamed : Prop
  limitPassageInheritanceLemmaNamed_proof : limitPassageInheritanceLemmaNamed

/-- The finite no-overlap assignment recovers the joint-channel overlap bound. -/
theorem FiniteProjectedWindowNoOverlapAssignmentSource.projectionTailPlusExistingReserveNoOverlapBound_fromAssignment
    (h : FiniteProjectedWindowNoOverlapAssignmentSource) :
    h.projectionTailReserve + h.existingCollarReserveSpend <=
      h.jointCollarTailChannel := by
  have hpre := h.finiteTailReservePrefixes_le_jointChannel_plus_overlap
  rw [h.assignmentOverlapReserve_eq_zero] at hpre
  norm_num at hpre
  have htail : h.projectionTailReserve <= h.tailPrefixCharge :=
    h.projectionTailReserve_le_tailPrefixCharge
  have hres : h.existingCollarReserveSpend <= h.reservePrefixCharge :=
    h.existingReserveSpend_le_reservePrefixCharge
  linarith [htail, hres, hpre]

/-- The finite assignment supplies the owner-root bound for tail plus existing reserves. -/
theorem FiniteProjectedWindowNoOverlapAssignmentSource.tail_plus_existing_reserves_le_ownerRootBudget_fromAssignment
    (h : FiniteProjectedWindowNoOverlapAssignmentSource) :
    h.projectionTailReserve + h.existingCollarReserveSpend <= h.ownerRootBudget := by
  linarith [h.projectionTailPlusExistingReserveNoOverlapBound_fromAssignment,
    h.jointChannel_le_ownerRootBudget]

/--
Projection-window no-overlap persistence failure packet.  The finite assignment
exists before projection, but the projected window sends tail mass into reserve
atoms unless an inheritance lemma preserves the no-overlap assignment.
-/
structure ProjectionWindowNoOverlapPersistenceFailurePacket extends
    JointOwnerRootCollarTailPartitionSource where
  finiteAssignmentBeforeProjection : Prop
  finiteAssignmentBeforeProjection_proof : finiteAssignmentBeforeProjection
  noOverlapHoldsBeforeProjection : Prop
  noOverlapHoldsBeforeProjection_proof : noOverlapHoldsBeforeProjection
  noOverlapPersistenceLemmaMissing : Prop
  noOverlapPersistenceLemmaMissing_proof : noOverlapPersistenceLemmaMissing
  projectedWindowReintroducesOverlap : Prop
  projectedWindowReintroducesOverlap_proof : projectedWindowReintroducesOverlap
  ownerRootBudget_lt_tail_plus_existingReserve :
    ownerRootBudget < projectionTailReserve + existingCollarReserveSpend

/-- A persistence-failure packet blocks the finite no-overlap assignment source. -/
theorem no_FiniteProjectedWindowNoOverlapAssignmentSource_of_persistenceFailure
    (c : ProjectionWindowNoOverlapPersistenceFailurePacket)
    (h : FiniteProjectedWindowNoOverlapAssignmentSource)
    (sameOwnerRootBudget : h.ownerRootBudget = c.ownerRootBudget)
    (sameProjectionTailReserve : h.projectionTailReserve = c.projectionTailReserve)
    (sameExistingReserveSpend :
      h.existingCollarReserveSpend = c.existingCollarReserveSpend) : False := by
  have hle := h.tail_plus_existing_reserves_le_ownerRootBudget_fromAssignment
  rw [sameOwnerRootBudget, sameProjectionTailReserve,
    sameExistingReserveSpend] at hle
  linarith [hle, c.ownerRootBudget_lt_tail_plus_existingReserve]


/--
Paid-overlap projected-window assignment source.  This is the sibling repair of
`FiniteProjectedWindowNoOverlapAssignmentSource`: projection may reintroduce a
nonzero tail/reserve overlap, but the overlap is carried as a separately paid
same-owner reserve fixed before projection.
-/
structure PaidOverlapProjectedWindowAssignmentSource extends
    PreprojectionProjectedCollarExchangeSource where
  jointCollarTailChannel : Real
  jointCollarTailChannel_nonneg : 0 <= jointCollarTailChannel
  existingCollarReserveSpend : Real
  existingCollarReserveSpend_nonneg : 0 <= existingCollarReserveSpend
  existingCollarReserveSpend_eq_pressure_duhamel_inherited :
    existingCollarReserveSpend =
      angularCollarPressureReserveSpend + angularCollarDuhamelReserveSpend +
        angularCollarInheritedReserveSpend
  paidProjectedOverlapReserve : Real
  paidProjectedOverlapReserve_nonneg : 0 <= paidProjectedOverlapReserve
  collar_plus_tail_le_joint_plus_paidOverlap :
    coareaCollarCharge + projectionTailReserve <=
      jointCollarTailChannel + paidProjectedOverlapReserve
  tail_plus_existingReserve_le_joint_plus_paidOverlap :
    projectionTailReserve + existingCollarReserveSpend <=
      jointCollarTailChannel + paidProjectedOverlapReserve
  joint_plus_paidOverlap_le_ownerRootBudget :
    jointCollarTailChannel + paidProjectedOverlapReserve <= ownerRootBudget
  jointChannelDeclaredBeforePayoffStep : Nat
  paidOverlapDeclaredBeforePayoffStep : Nat
  projectedPayoffStep : Nat
  jointChannelDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    jointChannelDeclaredBeforePayoffStep < projectedPayoffStep
  paidOverlapDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    paidOverlapDeclaredBeforePayoffStep < projectedPayoffStep
  mainSurplusSpend : Real
  mainSurplusSpend_nonneg : 0 <= mainSurplusSpend
  joint_paidOverlap_noReuseWithMainSurplusSpend :
    jointCollarTailChannel + paidProjectedOverlapReserve + mainSurplusSpend <=
      ownerRootBudget
  paidOverlapReserveFixedBeforeProjection : Prop
  paidOverlapReserveFixedBeforeProjection_proof :
    paidOverlapReserveFixedBeforeProjection
  paidOverlapReserveSameOwnerRoot : Prop
  paidOverlapReserveSameOwnerRoot_proof : paidOverlapReserveSameOwnerRoot
  paidOverlapReserveRefinesProjectedWindowOverlap : Prop
  paidOverlapReserveRefinesProjectedWindowOverlap_proof :
    paidOverlapReserveRefinesProjectedWindowOverlap
  paidOverlapReserveNotDefinedFromPayoff : Prop
  paidOverlapReserveNotDefinedFromPayoff_proof :
    paidOverlapReserveNotDefinedFromPayoff

/-- A paid projected-overlap reserve recovers the owner-root projected payment bound. -/
theorem PaidOverlapProjectedWindowAssignmentSource.projectedPayment_le_ownerRootBudget
    (h : PaidOverlapProjectedWindowAssignmentSource) :
    h.projectedAngularBoundaryPayment <= h.ownerRootBudget := by
  linarith [h.projectedPayment_le_preprojection_plus_tail,
    h.collar_plus_tail_le_joint_plus_paidOverlap,
    h.joint_plus_paidOverlap_le_ownerRootBudget]

/-- The paid-overlap repair also pays tail plus existing reserves under the owner root. -/
theorem PaidOverlapProjectedWindowAssignmentSource.tail_plus_existing_reserves_le_ownerRootBudget
    (h : PaidOverlapProjectedWindowAssignmentSource) :
    h.projectionTailReserve + h.existingCollarReserveSpend <= h.ownerRootBudget := by
  linarith [h.tail_plus_existingReserve_le_joint_plus_paidOverlap,
    h.joint_plus_paidOverlap_le_ownerRootBudget]

/-- The paid-overlap channel and main surplus are both spent inside the owner root. -/
theorem PaidOverlapProjectedWindowAssignmentSource.joint_paidOverlap_mainSurplus_le_ownerRootBudget
    (h : PaidOverlapProjectedWindowAssignmentSource) :
    h.jointCollarTailChannel + h.paidProjectedOverlapReserve + h.mainSurplusSpend <=
      h.ownerRootBudget :=
  h.joint_paidOverlap_noReuseWithMainSurplusSpend


/--
Finite projected-window paid nonzero-overlap reserve source.  This is the
nonzero-overlap sibling of the finite no-overlap source: the overlap is not set
to zero, but is paid by a positive same-owner reserve fixed before projection
and carried through a named limit-passage inheritance lemma.
-/
structure FiniteProjectedWindowPaidNonzeroOverlapReserveSource extends
    PreprojectionProjectedCollarExchangeSource where
  jointCollarTailChannel : Real
  jointCollarTailChannel_nonneg : 0 <= jointCollarTailChannel
  paidOverlapReserve : Real
  paidOverlapReserve_nonneg : 0 <= paidOverlapReserve
  paidOverlapReserve_pos : 0 < paidOverlapReserve
  collar_plus_tail_le_jointChannel :
    coareaCollarCharge + projectionTailReserve <= jointCollarTailChannel
  joint_plus_paidOverlap_le_ownerRootBudget :
    jointCollarTailChannel + paidOverlapReserve <= ownerRootBudget
  sameOwnerPaidOverlapReserve_le_ownerRootBudget :
    paidOverlapReserve <= ownerRootBudget
  existingCollarReserveSpend : Real
  existingCollarReserveSpend_nonneg : 0 <= existingCollarReserveSpend
  existingCollarReserveSpend_eq_pressure_duhamel_inherited :
    existingCollarReserveSpend =
      angularCollarPressureReserveSpend + angularCollarDuhamelReserveSpend +
        angularCollarInheritedReserveSpend
  tailPrefixCharge : Real
  tailPrefixCharge_nonneg : 0 <= tailPrefixCharge
  reservePrefixCharge : Real
  reservePrefixCharge_nonneg : 0 <= reservePrefixCharge
  projectionTailReserve_le_tailPrefixCharge :
    projectionTailReserve <= tailPrefixCharge
  existingReserveSpend_le_reservePrefixCharge :
    existingCollarReserveSpend <= reservePrefixCharge
  finiteTailReservePrefixes_le_jointChannel_plus_paidOverlap :
    tailPrefixCharge + reservePrefixCharge <=
      jointCollarTailChannel + paidOverlapReserve
  jointChannelDeclaredBeforePayoffStep : Nat
  paidOverlapDeclaredBeforePayoffStep : Nat
  projectedPayoffStep : Nat
  jointChannelDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    jointChannelDeclaredBeforePayoffStep < projectedPayoffStep
  paidOverlapDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    paidOverlapDeclaredBeforePayoffStep < projectedPayoffStep
  paidOverlapReserveFixedBeforeProjection : Prop
  paidOverlapReserveFixedBeforeProjection_proof :
    paidOverlapReserveFixedBeforeProjection
  paidOverlapReservePaidOnSameOwnerRootPreimage : Prop
  paidOverlapReservePaidOnSameOwnerRootPreimage_proof :
    paidOverlapReservePaidOnSameOwnerRootPreimage
  paidOverlapReserveNotDefinedFromPayoff : Prop
  paidOverlapReserveNotDefinedFromPayoff_proof :
    paidOverlapReserveNotDefinedFromPayoff
  tailReserveAssignmentSameCarrier : Prop
  tailReserveAssignmentSameCarrier_proof : tailReserveAssignmentSameCarrier
  paidOverlapAssignmentPersistsToProjectedWindow : Prop
  paidOverlapAssignmentPersistsToProjectedWindow_proof :
    paidOverlapAssignmentPersistsToProjectedWindow
  limitPassagePaidOverlapReserveInheritanceLemmaNamed : Prop
  limitPassagePaidOverlapReserveInheritanceLemmaNamed_proof :
    limitPassagePaidOverlapReserveInheritanceLemmaNamed
  mainSurplusSpend : Real
  mainSurplusSpend_nonneg : 0 <= mainSurplusSpend
  joint_plus_paidOverlap_noReuseWithMainSurplus :
    jointCollarTailChannel + paidOverlapReserve + mainSurplusSpend <= ownerRootBudget

/-- A finite paid-overlap assignment recovers the projected payment owner-root bound. -/
theorem FiniteProjectedWindowPaidNonzeroOverlapReserveSource.projectedPayment_le_ownerRootBudget
    (h : FiniteProjectedWindowPaidNonzeroOverlapReserveSource) :
    h.projectedAngularBoundaryPayment <= h.ownerRootBudget := by
  have hjoint_le_owner : h.jointCollarTailChannel <= h.ownerRootBudget := by
    linarith [h.joint_plus_paidOverlap_le_ownerRootBudget, h.paidOverlapReserve_nonneg]
  linarith [h.projectedPayment_le_preprojection_plus_tail,
    h.collar_plus_tail_le_jointChannel, hjoint_le_owner]

/-- A finite paid-overlap assignment pays tail plus existing reserves under the owner root. -/
theorem FiniteProjectedWindowPaidNonzeroOverlapReserveSource.tail_plus_existing_reserves_le_ownerRootBudget
    (h : FiniteProjectedWindowPaidNonzeroOverlapReserveSource) :
    h.projectionTailReserve + h.existingCollarReserveSpend <= h.ownerRootBudget := by
  have htail : h.projectionTailReserve <= h.tailPrefixCharge :=
    h.projectionTailReserve_le_tailPrefixCharge
  have hres : h.existingCollarReserveSpend <= h.reservePrefixCharge :=
    h.existingReserveSpend_le_reservePrefixCharge
  linarith [htail, hres, h.finiteTailReservePrefixes_le_jointChannel_plus_paidOverlap,
    h.joint_plus_paidOverlap_le_ownerRootBudget]

/-- The finite paid-overlap channel and main surplus are both inside the owner root. -/
theorem FiniteProjectedWindowPaidNonzeroOverlapReserveSource.joint_paidOverlap_mainSurplus_le_ownerRootBudget
    (h : FiniteProjectedWindowPaidNonzeroOverlapReserveSource) :
    h.jointCollarTailChannel + h.paidOverlapReserve + h.mainSurplusSpend <=
      h.ownerRootBudget :=
  h.joint_plus_paidOverlap_noReuseWithMainSurplus



/--
Four-way owner-root subpartition source.  This is the next smaller theorem after
the paid-overlap fork: split the owner-root angular cutoff budget before payoff
into collar, tail, overlap, and main-surplus subchannels.  It is a sibling of
the finite paid-overlap source rather than an extension, so the no-reuse budget
inequality is derived from the subpartition instead of assumed.
-/
structure FourWayOwnerRootSubpartitionSource extends
    PreprojectionProjectedCollarExchangeSource where
  jointCollarTailChannel : Real
  jointCollarTailChannel_nonneg : 0 <= jointCollarTailChannel
  paidOverlapReserve : Real
  paidOverlapReserve_nonneg : 0 <= paidOverlapReserve
  paidOverlapReserve_pos : 0 < paidOverlapReserve
  existingCollarReserveSpend : Real
  existingCollarReserveSpend_nonneg : 0 <= existingCollarReserveSpend
  existingCollarReserveSpend_eq_pressure_duhamel_inherited :
    existingCollarReserveSpend =
      angularCollarPressureReserveSpend + angularCollarDuhamelReserveSpend +
        angularCollarInheritedReserveSpend
  tailPrefixCharge : Real
  tailPrefixCharge_nonneg : 0 <= tailPrefixCharge
  reservePrefixCharge : Real
  reservePrefixCharge_nonneg : 0 <= reservePrefixCharge
  projectionTailReserve_le_tailPrefixCharge :
    projectionTailReserve <= tailPrefixCharge
  existingReserveSpend_le_reservePrefixCharge :
    existingCollarReserveSpend <= reservePrefixCharge
  finiteTailReservePrefixes_le_jointChannel_plus_paidOverlap :
    tailPrefixCharge + reservePrefixCharge <=
      jointCollarTailChannel + paidOverlapReserve
  collarSubchannel : Real
  collarSubchannel_nonneg : 0 <= collarSubchannel
  tailSubchannel : Real
  tailSubchannel_nonneg : 0 <= tailSubchannel
  overlapSubchannel : Real
  overlapSubchannel_nonneg : 0 <= overlapSubchannel
  mainSurplusSubchannel : Real
  mainSurplusSubchannel_nonneg : 0 <= mainSurplusSubchannel
  coareaCollarCharge_le_collarSubchannel :
    coareaCollarCharge <= collarSubchannel
  projectionTailReserve_le_tailSubchannel :
    projectionTailReserve <= tailSubchannel
  paidOverlapReserve_le_overlapSubchannel :
    paidOverlapReserve <= overlapSubchannel
  mainSurplusSpend : Real
  mainSurplusSpend_nonneg : 0 <= mainSurplusSpend
  mainSurplusSpend_le_mainSurplusSubchannel :
    mainSurplusSpend <= mainSurplusSubchannel
  jointChannel_le_collar_plus_tail_subchannels :
    jointCollarTailChannel <= collarSubchannel + tailSubchannel
  fourWaySubchannels_le_ownerRootBudget :
    collarSubchannel + tailSubchannel + overlapSubchannel +
        mainSurplusSubchannel <= ownerRootBudget
  noReuseFourWaySubchannels_le_ownerRootBudget :
    collarSubchannel + tailSubchannel + overlapSubchannel +
        mainSurplusSubchannel <= ownerRootBudget
  jointChannelDeclaredBeforePayoffStep : Nat
  paidOverlapDeclaredBeforePayoffStep : Nat
  fourWaySubpartitionDeclaredBeforePayoffStep : Nat
  projectedPayoffStep : Nat
  jointChannelDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    jointChannelDeclaredBeforePayoffStep < projectedPayoffStep
  paidOverlapDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    paidOverlapDeclaredBeforePayoffStep < projectedPayoffStep
  fourWaySubpartitionDeclaredBeforePayoffStep_lt_projectedPayoffStep :
    fourWaySubpartitionDeclaredBeforePayoffStep < projectedPayoffStep
  sameOwnerPaidOverlapReserve_le_ownerRootBudget :
    paidOverlapReserve <= ownerRootBudget
  fourWaySubpartitionFixedBeforePayoff : Prop
  fourWaySubpartitionFixedBeforePayoff_proof :
    fourWaySubpartitionFixedBeforePayoff
  fourWaySubchannelsSameOwnerRoot : Prop
  fourWaySubchannelsSameOwnerRoot_proof : fourWaySubchannelsSameOwnerRoot
  overlapSubchannelNotReusedByCollarTailOrMain : Prop
  overlapSubchannelNotReusedByCollarTailOrMain_proof :
    overlapSubchannelNotReusedByCollarTailOrMain
  paidOverlapReserveNotDefinedFromPayoff : Prop
  paidOverlapReserveNotDefinedFromPayoff_proof :
    paidOverlapReserveNotDefinedFromPayoff
  tailReserveAssignmentSameCarrier : Prop
  tailReserveAssignmentSameCarrier_proof : tailReserveAssignmentSameCarrier
  paidOverlapAssignmentPersistsToProjectedWindow : Prop
  paidOverlapAssignmentPersistsToProjectedWindow_proof :
    paidOverlapAssignmentPersistsToProjectedWindow
  limitPassagePaidOverlapReserveInheritanceLemmaNamed : Prop
  limitPassagePaidOverlapReserveInheritanceLemmaNamed_proof :
    limitPassagePaidOverlapReserveInheritanceLemmaNamed

/-- The four-way subpartition gives the paid-overlap no-reuse inequality. -/
theorem FourWayOwnerRootSubpartitionSource.joint_paidOverlap_mainSurplus_le_ownerRootBudget_fromSubpartition
    (h : FourWayOwnerRootSubpartitionSource) :
    h.jointCollarTailChannel + h.paidOverlapReserve + h.mainSurplusSpend <=
      h.ownerRootBudget := by
  linarith [h.jointChannel_le_collar_plus_tail_subchannels,
    h.paidOverlapReserve_le_overlapSubchannel,
    h.mainSurplusSpend_le_mainSurplusSubchannel,
    h.noReuseFourWaySubchannels_le_ownerRootBudget]

/-- The four-way source pays tail plus existing reserves under the owner root. -/
theorem FourWayOwnerRootSubpartitionSource.tail_plus_existing_reserves_le_ownerRootBudget
    (h : FourWayOwnerRootSubpartitionSource) :
    h.projectionTailReserve + h.existingCollarReserveSpend <= h.ownerRootBudget := by
  have htail : h.projectionTailReserve <= h.tailPrefixCharge :=
    h.projectionTailReserve_le_tailPrefixCharge
  have hres : h.existingCollarReserveSpend <= h.reservePrefixCharge :=
    h.existingReserveSpend_le_reservePrefixCharge
  have hbudget := h.joint_paidOverlap_mainSurplus_le_ownerRootBudget_fromSubpartition
  linarith [htail, hres, h.finiteTailReservePrefixes_le_jointChannel_plus_paidOverlap,
    hbudget, h.mainSurplusSpend_nonneg]

/-- The four-way source recovers the owner-root projected payment bound. -/
theorem FourWayOwnerRootSubpartitionSource.projectedPayment_le_ownerRootBudget
    (h : FourWayOwnerRootSubpartitionSource) :
    h.projectedAngularBoundaryPayment <= h.ownerRootBudget := by
  have hcollar_tail :
      h.coareaCollarCharge + h.projectionTailReserve <=
        h.collarSubchannel + h.tailSubchannel := by
    linarith [h.coareaCollarCharge_le_collarSubchannel,
      h.projectionTailReserve_le_tailSubchannel]
  have hsub : h.collarSubchannel + h.tailSubchannel <= h.ownerRootBudget := by
    linarith [h.fourWaySubchannels_le_ownerRootBudget,
      h.overlapSubchannel_nonneg, h.mainSurplusSubchannel_nonneg]
  linarith [h.projectedPayment_le_preprojection_plus_tail, hcollar_tail, hsub]

/--
Four-way owner-root rebilling packet.  The overlap reserve is drawn from the
same angular cutoff spend already used by collar, tail, or main surplus, so the
four-way spend exceeds the owner-root budget for matching data.
-/
structure FourWayOwnerRootRebillingPacket extends
    PreprojectionProjectedCollarExchangeSource where
  jointCollarTailChannel : Real
  paidOverlapReserve : Real
  mainSurplusSpend : Real
  overlapReserveReusesCollarTailOrMainSpend : Prop
  overlapReserveReusesCollarTailOrMainSpend_proof :
    overlapReserveReusesCollarTailOrMainSpend
  fourWaySubpartitionMissing : Prop
  fourWaySubpartitionMissing_proof : fourWaySubpartitionMissing
  ownerRootBudget_lt_joint_paidOverlap_mainSurplus :
    ownerRootBudget < jointCollarTailChannel + paidOverlapReserve + mainSurplusSpend

/-- A four-way rebilling packet blocks the four-way subpartition source. -/
theorem no_FourWayOwnerRootSubpartitionSource_of_rebillingPacket
    (c : FourWayOwnerRootRebillingPacket)
    (h : FourWayOwnerRootSubpartitionSource)
    (sameOwnerRootBudget : h.ownerRootBudget = c.ownerRootBudget)
    (sameJointChannel : h.jointCollarTailChannel = c.jointCollarTailChannel)
