/--
In the normalized cutoff-payment model, the total invoice pays the affine
surplus.
-/
theorem totalInvoice_ge_surplus_of_parabolicCutoffInvoicePaysAffineSurplusModel
    (h : ParabolicCutoffInvoicePaysAffineSurplusModel) :
    h.localJet.eta * h.localJet.A <= h.totalInvoice := by
  have hA_nonneg : 0 <= h.localJet.A := le_of_lt h.localJet.A_pos
  have hsurplus_le_cutoff :
      h.localJet.eta * h.localJet.A <= h.cutoffConstant * h.localJet.A :=
    mul_le_mul_of_nonneg_right h.eta_le_cutoffConstant hA_nonneg
  have hsurplus_le_cutoffInvoice :
      h.localJet.eta * h.localJet.A <= h.cutoffInvoice := by
    simpa [h.cutoffInvoice_eq] using hsurplus_le_cutoff
  exact le_trans hsurplus_le_cutoffInvoice h.totalInvoice_ge_cutoffInvoice

