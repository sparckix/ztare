/-- Bounded-ratio arithmetic for converting strict mean surplus into support mass. -/
theorem boundedRatioMean_forces_boundaryPaid_lowerBound
    {boundaryPaidMeasureLowerBound ratioMeanSurplus ratioUpperBound
      boundaryPaidSetMeasure : Real}
    (hupper_gt_one : 1 < ratioUpperBound)
    (hlower :
      boundaryPaidMeasureLowerBound * (ratioUpperBound - 1) <= ratioMeanSurplus)
    (hmean : ratioMeanSurplus <=
      (ratioUpperBound - 1) * boundaryPaidSetMeasure) :
    boundaryPaidMeasureLowerBound <= boundaryPaidSetMeasure := by
  have hslack_pos : 0 < ratioUpperBound - 1 := by
    linarith
  have hmul :
      boundaryPaidMeasureLowerBound * (ratioUpperBound - 1) <=
        boundaryPaidSetMeasure * (ratioUpperBound - 1) := by
    linarith
  nlinarith [hslack_pos, hmul]

