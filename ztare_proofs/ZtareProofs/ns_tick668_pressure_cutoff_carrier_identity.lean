theorem SelectedCKNCollarTransactionEquivalenceNoEscape.endpointDebitPrefix_le_budget
    (h : SelectedCKNCollarTransactionEquivalenceNoEscape) :
    ∀ N : Nat, nsTick668FinitePrefixSum h.endpointDebit N <=
      h.C * h.transactionBudget := by
  intro N
  have hprefix := h.endpointDebitPrefix_le_C_mul_transactionPrefix N
  have hbudget := h.transactionPrefix_le_budget N
  have hmul : h.C * nsTick668FinitePrefixSum h.transactionPay N <=
      h.C * h.transactionBudget := by
    exact mul_le_mul_of_nonneg_left hbudget h.C_nonnegative
  exact le_trans hprefix hmul

