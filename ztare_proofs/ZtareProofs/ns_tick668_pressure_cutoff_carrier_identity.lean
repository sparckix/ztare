/-!
TICK668 pressure/cutoff carrier identity boundary for the A_visc tensor route.

After the isotropic-mixture witness, pressure information can only rescue the
A_visc traceless-tensor route if the pressure angular carrier and cutoff are
proved to be the exact A_visc invoice fiber before payoff.  This file records
that identity as a typed object and separates it from the confuser where
pressure angular moments exist on a different Riesz/cutoff carrier.
-/

/--
Positive continuation theorem shape: pressure/cutoff data may select the A_visc
eigenframe only after the carrier and cutoff are identified with the exact
A_visc invoice fiber, before payoff.
-/
structure PressureCutoffCarrierIdentityForAViscInvoiceFiber where
  pressureAngularMomentAvailable : Prop
  pressureAngularMomentAvailable_proof :
    pressureAngularMomentAvailable
  pressureCarrierEqualsAViscInvoiceFiber : Prop
  pressureCarrierEqualsAViscInvoiceFiber_proof :
    pressureCarrierEqualsAViscInvoiceFiber
  cutoffMatchesAViscInvoiceFiber : Prop
  cutoffMatchesAViscInvoiceFiber_proof :
    cutoffMatchesAViscInvoiceFiber
  eigenframeSelectionActsBeforePayoff : Prop
  eigenframeSelectionActsBeforePayoff_proof :
    eigenframeSelectionActsBeforePayoff
  eigenframeSelectionForcesAViscTensorNonCancellation : Prop
  eigenframeSelectionForcesAViscTensorNonCancellation_proof :
    eigenframeSelectionForcesAViscTensorNonCancellation

/--
Hostile boundary for the pressure route: the pressure angular moment may be
visible while same-window core/sheath cancellation or tangential div-div null
stress prevents identification with the A_visc invoice fiber.
-/
structure PressureCutoffCarrierIdentityMismatchConfuser where
  pressureAngularMomentAvailable : Prop
  pressureAngularMomentAvailable_proof :
    pressureAngularMomentAvailable
  sameWindowCoreSheathCancellationPacket : Prop
  sameWindowCoreSheathCancellationPacket_proof :
    sameWindowCoreSheathCancellationPacket
  tangentialDivDivNullStressPacket : Prop
  tangentialDivDivNullStressPacket_proof :
    tangentialDivDivNullStressPacket
  pressureCarrierMayDifferFromAViscInvoiceFiber : Prop
  pressureCarrierMayDifferFromAViscInvoiceFiber_proof :
    pressureCarrierMayDifferFromAViscInvoiceFiber
  cutoffMayDifferFromAViscInvoiceFiber : Prop
  cutoffMayDifferFromAViscInvoiceFiber_proof :
    cutoffMayDifferFromAViscInvoiceFiber
  identityRowsUnpaidBeforePayoff : Prop
  identityRowsUnpaidBeforePayoff_proof :
    identityRowsUnpaidBeforePayoff
  noCarrierIdentity :
    ¬ ∃ hId : PressureCutoffCarrierIdentityForAViscInvoiceFiber,
        hId.pressureAngularMomentAvailable =
          pressureAngularMomentAvailable

/--
The mismatch confuser blocks the carrier-identity theorem even though pressure
angular moments remain available.
-/
theorem no_PressureCutoffCarrierIdentityForAViscInvoiceFiber_of_mismatch
    (hConfuser : PressureCutoffCarrierIdentityMismatchConfuser)
    (hId : PressureCutoffCarrierIdentityForAViscInvoiceFiber)
    (hSameAngular :
      hId.pressureAngularMomentAvailable =
        hConfuser.pressureAngularMomentAvailable) :
    False :=
  hConfuser.noCarrierIdentity ⟨hId, hSameAngular⟩

