/--
Level408 carrier-bound pressure-frame adapter.  The older dual-price receipts
control a pressure-frame state budget; the Level407 anti-null bridge needs the
selected high-high quotient-carrier functional and the cutoff invoice on that
same carrier.  This structure is the narrow source target that prevents direct
consumption of a bare pressure-frame receipt.
-/
structure PressureFramePaysSelectedHHOnQuotientCarrier
    (carrier : QuotientMinimalTransactionCarrier) where
  dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt
  carrierPacketStateBinding : Prop
  carrierPacketStateBinding_proof : carrierPacketStateBinding
  selectedHH_eq_or_le_stateSignedProduction : Prop
  selectedHH_eq_or_le_stateSignedProduction_proof :
    selectedHH_eq_or_le_stateSignedProduction
  sourceToSelectedHHProductionCoercivity : Prop
  sourceToSelectedHHProductionCoercivity_proof :
    sourceToSelectedHHProductionCoercivity
  cutoffInvoicePaidOnSameCarrier : Prop
  cutoffInvoicePaidOnSameCarrier_proof : cutoffInvoicePaidOnSameCarrier
  duhamelReserveBilledOnSameCarrier : Prop
  duhamelReserveBilledOnSameCarrier_proof :
    duhamelReserveBilledOnSameCarrier
  productionInvoiceChannelSeparated : Prop
  productionInvoiceChannelSeparated_proof :
    productionInvoiceChannelSeparated
  inheritedReserveChannelSeparated : Prop
  inheritedReserveChannelSeparated_proof :
    inheritedReserveChannelSeparated
  pressureFramePartitionFixedBeforeSpend : Prop
  pressureFramePartitionFixedBeforeSpend_proof :
    pressureFramePartitionFixedBeforeSpend
  sectionIdentityFixedBeforeSelectedHHSpend : Prop
  sectionIdentityFixedBeforeSelectedHHSpend_proof :
    sectionIdentityFixedBeforeSelectedHHSpend
  noReuseChannelSeparatedForSelectedHHBridge : Prop
  noReuseChannelSeparatedForSelectedHHBridge_proof :
    noReuseChannelSeparatedForSelectedHHBridge
  selectedKernelCyclesZeroProduction : Prop
  selectedKernelCyclesZeroProduction_proof :
    selectedKernelCyclesZeroProduction
  noProxyPressureFrameCurrency : Prop
  noProxyPressureFrameCurrency_proof : noProxyPressureFrameCurrency
  noFinalCarrierCancellationOrTargetDefinedAntiNull : Prop
  noFinalCarrierCancellationOrTargetDefinedAntiNull_proof :
    noFinalCarrierCancellationOrTargetDefinedAntiNull
  noTangentialDivDivNullPositiveHHKernel :
    ¬ Nonempty (TangentialDivDivNullPositiveHHKernelPacket carrier)

/--
The universal kernel-to-jet lift supplies the anti-null field required by the
carrier-bound pressure-frame adapter.  The remaining fields are still explicit
source receipts: source coercivity and separated spend channels are not inferred
from the lift by label.
-/
def PressureFramePaysSelectedHHOnQuotientCarrier.ofKernelToTraceZeroPositiveNetJetLift
    {carrier : QuotientMinimalTransactionCarrier}
    {dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt}
    (hLift : TangentialKernelToTraceZeroPositiveNetJetLift carrier dualPrice)
    {sourceToSelectedHHProductionCoercivity : Prop}
    (hSourceCoercivity : sourceToSelectedHHProductionCoercivity)
    {duhamelReserveBilledOnSameCarrier : Prop}
    (hDuhamel : duhamelReserveBilledOnSameCarrier)
    {productionInvoiceChannelSeparated : Prop}
    (hProductionInvoice : productionInvoiceChannelSeparated)
    {inheritedReserveChannelSeparated : Prop}
    (hInheritedReserve : inheritedReserveChannelSeparated)
    {pressureFramePartitionFixedBeforeSpend : Prop}
    (hPartition : pressureFramePartitionFixedBeforeSpend)
    {sectionIdentityFixedBeforeSelectedHHSpend : Prop}
    (hSectionIdentity : sectionIdentityFixedBeforeSelectedHHSpend)
    {noReuseChannelSeparatedForSelectedHHBridge : Prop}
    (hNoReuse : noReuseChannelSeparatedForSelectedHHBridge) :
    PressureFramePaysSelectedHHOnQuotientCarrier carrier where
  dualPrice := dualPrice
  carrierPacketStateBinding :=
    hLift.quotientCarrierRepresentativeFixedBeforeLift
  carrierPacketStateBinding_proof :=
    hLift.quotientCarrierRepresentativeFixedBeforeLift_proof
  selectedHH_eq_or_le_stateSignedProduction :=
    hLift.selectedHHBecomesStateSignedProduction
  selectedHH_eq_or_le_stateSignedProduction_proof :=
    hLift.selectedHHBecomesStateSignedProduction_proof
  sourceToSelectedHHProductionCoercivity :=
    sourceToSelectedHHProductionCoercivity
  sourceToSelectedHHProductionCoercivity_proof := hSourceCoercivity
  cutoffInvoicePaidOnSameCarrier :=
    hLift.sameCarrierCutoffInvoicePaidForLiftedJet
  cutoffInvoicePaidOnSameCarrier_proof :=
    hLift.sameCarrierCutoffInvoicePaidForLiftedJet_proof
  duhamelReserveBilledOnSameCarrier := duhamelReserveBilledOnSameCarrier
  duhamelReserveBilledOnSameCarrier_proof := hDuhamel
  productionInvoiceChannelSeparated := productionInvoiceChannelSeparated
  productionInvoiceChannelSeparated_proof := hProductionInvoice
  inheritedReserveChannelSeparated := inheritedReserveChannelSeparated
  inheritedReserveChannelSeparated_proof := hInheritedReserve
  pressureFramePartitionFixedBeforeSpend := pressureFramePartitionFixedBeforeSpend
  pressureFramePartitionFixedBeforeSpend_proof := hPartition
  sectionIdentityFixedBeforeSelectedHHSpend :=
    sectionIdentityFixedBeforeSelectedHHSpend
  sectionIdentityFixedBeforeSelectedHHSpend_proof := hSectionIdentity
  noReuseChannelSeparatedForSelectedHHBridge :=
    noReuseChannelSeparatedForSelectedHHBridge
  noReuseChannelSeparatedForSelectedHHBridge_proof := hNoReuse
  selectedKernelCyclesZeroProduction :=
    hLift.selectedHHBecomesStateSignedProduction
  selectedKernelCyclesZeroProduction_proof :=
    hLift.selectedHHBecomesStateSignedProduction_proof
  noProxyPressureFrameCurrency := hLift.noProxyPressureVisibilityOnlyLift
  noProxyPressureFrameCurrency_proof :=
    hLift.noProxyPressureVisibilityOnlyLift_proof
  noFinalCarrierCancellationOrTargetDefinedAntiNull :=
    hLift.noFinalCarrierCancellationInLift ∧ hLift.noTargetDefinedLiftAfterPayoff
  noFinalCarrierCancellationOrTargetDefinedAntiNull_proof :=
    And.intro hLift.noFinalCarrierCancellationInLift_proof
      hLift.noTargetDefinedLiftAfterPayoff_proof
  noTangentialDivDivNullPositiveHHKernel :=
    no_TangentialDivDivNullPositiveHHKernel_of_kernelToTraceZeroPositiveNetJetLift
      hLift

/--
Once the pressure-frame receipt is bound to the selected quotient carrier, it
can pay the two Level407 hard fields.  The construction deliberately consumes
the carrier-bound adapter rather than the bare dual-price receipt.
-/
def AngularTomographyNoTangentialProductionBridgeSource.ofPressureFrameSelectedHH
    {carrier : QuotientMinimalTransactionCarrier}
    (tomography : AngularPressureTomographySelectedPacketReceipt)
    (h : PressureFramePaysSelectedHHOnQuotientCarrier carrier) :
    AngularTomographyNoTangentialProductionBridgeSource carrier where
  tomography := tomography
  angularFrameBoundToQuotientCarrier := h.carrierPacketStateBinding
  angularFrameBoundToQuotientCarrier_proof :=
    h.carrierPacketStateBinding_proof
  sourceToSelectedHHProductionCoercivity :=
    h.sourceToSelectedHHProductionCoercivity
  sourceToSelectedHHProductionCoercivity_proof :=
    h.sourceToSelectedHHProductionCoercivity_proof
  cutoffInvoicePaidOnSameCarrier := h.cutoffInvoicePaidOnSameCarrier
  cutoffInvoicePaidOnSameCarrier_proof :=
    h.cutoffInvoicePaidOnSameCarrier_proof
  noProxyPressureVisibilityOnly := h.noProxyPressureFrameCurrency
  noProxyPressureVisibilityOnly_proof :=
    h.noProxyPressureFrameCurrency_proof
  noAntiNullConclusionByLabelOnly :=
    h.noFinalCarrierCancellationOrTargetDefinedAntiNull
  noAntiNullConclusionByLabelOnly_proof :=
    h.noFinalCarrierCancellationOrTargetDefinedAntiNull_proof
  noTangentialDivDivNullPositiveHHKernel :=
    h.noTangentialDivDivNullPositiveHHKernel

/--
Bare dual-price pressure-frame data lives in the wrong currency unless it also
pays carrier/state binding, selected-HH functional binding, and the same-carrier
