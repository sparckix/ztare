  dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt
  carrierPacketStateBindingMissing : Prop
  carrierPacketStateBindingMissing_proof : carrierPacketStateBindingMissing
  selectedHHFunctionalBindingMissing : Prop
  selectedHHFunctionalBindingMissing_proof :
    selectedHHFunctionalBindingMissing
  sameCarrierCutoffInvoiceMissing : Prop
  sameCarrierCutoffInvoiceMissing_proof : sameCarrierCutoffInvoiceMissing
  pressureFrameCurrencyIsProxyOnly : Prop
  pressureFrameCurrencyIsProxyOnly_proof : pressureFrameCurrencyIsProxyOnly
  directDualPriceConsumptionWouldBeRelabel : Prop
  directDualPriceConsumptionWouldBeRelabel_proof :
    directDualPriceConsumptionWouldBeRelabel

/--
Carrier/state mismatch alone blocks consumption of a bare dual-price receipt as
the selected-HH quotient-carrier adapter.
-/
theorem no_PressureFramePaysSelectedHHOnQuotientCarrier_of_bareDualPriceCarrierMismatch
    {carrier : QuotientMinimalTransactionCarrier}
    (hConfuser : BareDualPricePressureFrameWithoutCarrierBindingConfuser carrier)
    (h : PressureFramePaysSelectedHHOnQuotientCarrier carrier)
    (_hSameDualPrice : h.dualPrice = hConfuser.dualPrice)
    (hBindingSame :
      h.carrierPacketStateBinding =
        (hConfuser.carrierPacketStateBindingMissing = False)) :
    False := by
  have hmissing :
      hConfuser.carrierPacketStateBindingMissing = False := by
    simpa [hBindingSame] using h.carrierPacketStateBinding_proof
  have hproof := hConfuser.carrierPacketStateBindingMissing_proof
  rw [hmissing] at hproof
  exact hproof

/--
Even with carrier naming present, a pressure-frame receipt is still insufficient
if the selected high-high quotient functional is not identified with the state
