/--
The sourced effective invoice coefficient pays the affine surplus.
-/
theorem totalInvoice_ge_surplus_of_parabolicEffectiveInvoiceCoefficientPaysAffineSurplus
    (h : ParabolicEffectiveInvoiceCoefficientPaysAffineSurplus) :
    h.localJet.eta * h.localJet.A <= h.totalInvoice := by
  have hA_nonneg : 0 <= h.localJet.A := le_of_lt h.localJet.A_pos
  have heta_le_coeff : h.localJet.eta <= h.effectiveInvoiceCoefficient := by
    linarith [h.eta_le_reynolds_excess,
      h.reynolds_excess_le_effectiveInvoiceCoefficient]
  have hsurplus_le_effective :
      h.localJet.eta * h.localJet.A <=
        h.effectiveInvoiceCoefficient * h.localJet.A :=
    mul_le_mul_of_nonneg_right heta_le_coeff hA_nonneg
  exact le_trans hsurplus_le_effective h.effectiveInvoice_le_totalInvoice

