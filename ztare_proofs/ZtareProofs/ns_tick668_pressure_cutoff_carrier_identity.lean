/--
Existing route-1 nonadaptive annular C7 source selection supplies the numerical
owner-prefix half of the annular Riesz bridge.  The remaining hypotheses are
exactly the PDE reinterpretation checks: the projected target must be the fixed
annular output packet of this selected event stream, cutoff tails must be paid
on that stream, and no raw CZ, BV, or CF input may be smuggled in.
-/
def AnnularBandlimitedRieszNonadaptiveOwnerPrefixBridge.ofNonadaptiveAnnularC7SourceSelection
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hSelect : NonadaptiveAnnularC7SourceSelection h hId)
    {selectedTargetUsesAnnularBandlimitedOutputPacket : Prop}
    (hTarget : selectedTargetUsesAnnularBandlimitedOutputPacket)
    {annularProjectedPacketIdentifiedWithNonadaptiveEventStream : Prop}
    (hStream : annularProjectedPacketIdentifiedWithNonadaptiveEventStream)
    {annularEventPay_eq_priorNonadaptiveEventStream : Prop}
    (hEventLock : annularEventPay_eq_priorNonadaptiveEventStream)
    {annularBandlimitFixedBeforePayoff : Prop}
    (hBandlimitFixed : annularBandlimitFixedBeforePayoff)
    {outputPacketSupportSameAnnularCarrier : Prop}
    (hSupport : outputPacketSupportSameAnnularCarrier)
    {traceFreeTensorTotalVariationNotSignedMoment : Prop}
    (hTotalVariation : traceFreeTensorTotalVariationNotSignedMoment)
    {noLowHighLeakageAfterProjection : Prop}
    (hNoLeakage : noLowHighLeakageAfterProjection)
    {annularRieszKernelHasUniformL1Norm : Prop}
    (hKernel : annularRieszKernelHasUniformL1Norm)
    {PSDTracePaysAnnularProjectedPacket : Prop}
    (hPSDTrace : PSDTracePaysAnnularProjectedPacket)
    {cutoffCommutatorTailsPaidBySameStreamShardC : Prop}
    (hCutoff : cutoffCommutatorTailsPaidBySameStreamShardC)
    {notRawCZMeasureL1 : Prop}
    (hNotRawCZ : notRawCZMeasureL1)
    {notBesovBVOrCFImport : Prop}
    (hNotBesovCF : notBesovBVOrCFImport) :
    AnnularBandlimitedRieszNonadaptiveOwnerPrefixBridge where
  annularEventPay := hSelect.eventRadiusPayment
  ownerBudget := hSelect.multiplicityBound * hSelect.atomBudget
  annularEventPay_nonnegative :=
    hSelect.ownerPreimagePackingReceipt.eventPay_nonnegative
  ownerBudget_nonnegative :=
    mul_nonneg hSelect.multiplicityBound_nonnegative
      hSelect.atomBudget_nonnegative
  finitePrefixAnnularOwnerBudget := by
    intro N
    rw [nsTick668FinitePrefixSum_eq_nsPrefixSum]
    exact NonadaptiveAnnularC7SourceSelection.eventPrefix_le_ownerBudget
      hSelect N
  selectedTargetUsesAnnularBandlimitedOutputPacket :=
    selectedTargetUsesAnnularBandlimitedOutputPacket
  selectedTargetUsesAnnularBandlimitedOutputPacket_proof := hTarget
  annularProjectedPacketIdentifiedWithNonadaptiveEventStream :=
    annularProjectedPacketIdentifiedWithNonadaptiveEventStream
  annularProjectedPacketIdentifiedWithNonadaptiveEventStream_proof := hStream
  annularEventPay_eq_priorNonadaptiveEventStream :=
    annularEventPay_eq_priorNonadaptiveEventStream
  annularEventPay_eq_priorNonadaptiveEventStream_proof := hEventLock
  annularBandlimitFixedBeforePayoff := annularBandlimitFixedBeforePayoff
  annularBandlimitFixedBeforePayoff_proof := hBandlimitFixed
  outputPacketSupportSameAnnularCarrier := outputPacketSupportSameAnnularCarrier
  outputPacketSupportSameAnnularCarrier_proof := hSupport
  traceFreeTensorTotalVariationNotSignedMoment :=
    traceFreeTensorTotalVariationNotSignedMoment
  traceFreeTensorTotalVariationNotSignedMoment_proof := hTotalVariation
  noLowHighLeakageAfterProjection := noLowHighLeakageAfterProjection
  noLowHighLeakageAfterProjection_proof := hNoLeakage
  annularRieszKernelHasUniformL1Norm := annularRieszKernelHasUniformL1Norm
  annularRieszKernelHasUniformL1Norm_proof := hKernel
  PSDTracePaysAnnularProjectedPacket := PSDTracePaysAnnularProjectedPacket
  PSDTracePaysAnnularProjectedPacket_proof := hPSDTrace
  cutoffCommutatorTailsPaidBySameStreamShardC :=
    cutoffCommutatorTailsPaidBySameStreamShardC
  cutoffCommutatorTailsPaidBySameStreamShardC_proof := hCutoff
  ownerPrefixBudgetInheritedFromPriorNonadaptiveSelection :=
    hSelect.ownerPreimagePackingReceipt.globalSelectedTreePreimageBound
  ownerPrefixBudgetInheritedFromPriorNonadaptiveSelection_proof :=
    hSelect.ownerPreimagePackingReceipt.globalSelectedTreePreimageBound_proof
  paymentFixedBeforeAngularSpendPayoff :=
    hSelect.ownerChosenByStoppingRuleBeforePayoff
  paymentFixedBeforeAngularSpendPayoff_proof :=
    hSelect.ownerChosenByStoppingRuleBeforePayoff_proof
  notRawCZMeasureL1 := notRawCZMeasureL1
  notRawCZMeasureL1_proof := hNotRawCZ
  notBesovBVOrCFImport := notBesovBVOrCFImport
  notBesovBVOrCFImport_proof := hNotBesovCF

/--
The nonadaptive owner-prefix bridge gives the arithmetic same-carrier payment.
The equality `freshCharge = annularEventPay` is admissible only because the
bridge carries the prior-selection and target-identity fields above.
-/
def TraceFreeVariationPointwiseSameCarrierPaymentReceipt.ofAnnularBandlimitedRieszNonadaptiveOwnerPrefixBridge
    (h : AnnularBandlimitedRieszNonadaptiveOwnerPrefixBridge) :
    TraceFreeVariationPointwiseSameCarrierPaymentReceipt where
  angularEventPay := h.annularEventPay
  freshCharge := h.annularEventPay
  c := 1
  rootBudget := h.ownerBudget
  c_pos := by norm_num
  angularEventPay_nonneg := h.annularEventPay_nonnegative
  freshCharge_nonneg := h.annularEventPay_nonnegative
  rootBudget_nonneg := h.ownerBudget_nonnegative
  pointwiseTraceFreeVariationPayment := by
    intro n
    simp
  finitePrefixFreshCarrierBudget := h.finitePrefixAnnularOwnerBudget
  traceFreeAtomsAreSameCarrierFreshCharge :=
    h.annularProjectedPacketIdentifiedWithNonadaptiveEventStream
  traceFreeAtomsAreSameCarrierFreshCharge_proof :=
    h.annularProjectedPacketIdentifiedWithNonadaptiveEventStream_proof
  paymentCurrencyIsTraceFreeVariationNotBetaSquare :=
    h.PSDTracePaysAnnularProjectedPacket
  paymentCurrencyIsTraceFreeVariationNotBetaSquare_proof :=
    h.PSDTracePaysAnnularProjectedPacket_proof
  paymentFixedBeforeAngularSpendPayoff :=
    h.paymentFixedBeforeAngularSpendPayoff ∧
      h.annularBandlimitFixedBeforePayoff
  paymentFixedBeforeAngularSpendPayoff_proof :=
    ⟨h.paymentFixedBeforeAngularSpendPayoff_proof,
      h.annularBandlimitFixedBeforePayoff_proof⟩
  noProductL2OrBesovProxyInPayment := h.notBesovBVOrCFImport
  noProductL2OrBesovProxyInPayment_proof := h.notBesovBVOrCFImport_proof

