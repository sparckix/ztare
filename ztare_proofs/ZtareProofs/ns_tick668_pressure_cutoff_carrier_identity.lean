/-- A null-locked selected prefix excludes any typed positive no-null-lock source on that same projected sequence. -/
theorem no_LEINativeSelectedTopologyProjectedPressurePrefixNoNullLockSource_of_nullLockedSubsequenceConfuser
    {Ω : Type u}
    (c : LEINativeSelectedTopologyNullLockedSubsequenceConfuser Ω)
    (h : LEINativeSelectedTopologyProjectedPressurePrefixNoNullLockSource Ω)
    (hP : h.P = c.P) : False := by
  have hzero : projectedPressureAbsSum h.P c.K = 0 := by
    simpa [hP] using c.projectedPressureAbsSum_zero
  exact no_LEINativeSelectedTopologyProjectedPressurePrefixNoNullLockSource_of_zeroAbsPrefix
    h c.K_pos hzero

/-- Pointwise transversality is also blocked by a same-stream null-locked selected prefix. -/
theorem no_LEINativeSelectedTopologyPointwiseTransversalityNoNullLockSource_of_nullLockedSubsequenceConfuser
    {Ω : Type u}
    (c : LEINativeSelectedTopologyNullLockedSubsequenceConfuser Ω)
    (h : LEINativeSelectedTopologyPointwiseTransversalityNoNullLockSource Ω)
    (hP : h.P = c.P) : False := by
  exact no_LEINativeSelectedTopologyProjectedPressurePrefixNoNullLockSource_of_nullLockedSubsequenceConfuser
    c h.toPrefixNoNullLockSource hP

/-- The pollution bridge cannot pass through a linked sequence with a null-locked selected prefix. -/
theorem no_LEINativeSelectedTopologyNoNullLockPollutionBridgeSource_of_nullLockedSubsequenceConfuser
    {Ω : Type u}
    (c : LEINativeSelectedTopologyNullLockedSubsequenceConfuser Ω)
    (h : LEINativeSelectedTopologyNoNullLockPollutionBridgeSource Ω)
    (hP : h.P = c.P) : False := by
  have hsrcP : h.prefixNoNullLockSource.P = c.P := by
    calc
      h.prefixNoNullLockSource.P = h.P := h.samePressureSequenceAsPrefixNoNullSource
      _ = c.P := hP
  exact no_LEINativeSelectedTopologyProjectedPressurePrefixNoNullLockSource_of_nullLockedSubsequenceConfuser
    c h.prefixNoNullLockSource hsrcP

/--
Algebraic null-lock kill lemma: a selected prefix with zero absolute projected
pressure cannot satisfy any positive no-null-lock floor.
-/
theorem no_noNullLockAverageLowerBound_of_projectedPressureAbsSum_zero
    {P : ProjectedPressureSequence} {N : ℕ} {pFloor : ℝ}
    (hN : 0 < (N : ℝ))
    (hfloor : 0 < pFloor)
    (hzero : projectedPressureAbsSum P N = 0) :
    ¬ noNullLockAverageLowerBound P N pFloor := by
  intro hlock
  unfold noNullLockAverageLowerBound at hlock
  rw [hzero] at hlock
  have hpos : 0 < (N : ℝ) * pFloor := mul_pos hN hfloor
  exact not_lt_of_ge hlock hpos

/--
Composite positive constructor: sequence-level no-null-lock pressure pollution
plus finite orientation-capacity accounting gives the selected topology prefix
budget. This is the non-laundered form of the Hofstadter reinterpretation: the
old capacity obstruction is consumed only after the pressure sequence pays the
same selected topology stream.
-/
structure LEINativeSelectedTopologyNoNullLockOrientationCapacitySource (Ω : Type u) where
  pollutionBridge :
    LEINativeSelectedTopologyNoNullLockPollutionBridgeSource Ω
  Vclean : CleanOrientationVolume
  Vtotal : OrientationVolume
  Vcleaned : CleanedOrientationVolume
  capacityBudget : ℝ
  cleanVolume_nonneg : 0 ≤ Vclean
  cleanVolumeAccountingForSelectedStream :
    cleanVolumeAccounting Vclean Vtotal pollutionBridge.Vpolluted Vcleaned
  finiteOrientationCapacityConvertedToBudget :
    Vtotal + Vcleaned ≤ pollutionBridge.κCost * capacityBudget
  noHiddenCapacityOnlyBookkeeping : Prop
  noHiddenCapacityOnlyBookkeeping_proof : noHiddenCapacityOnlyBookkeeping

/--
The composite no-null-lock/capacity source pays the selected topology prefix
budget with no separate finite-budget label.
-/
theorem LEINativeSelectedTopologyNoNullLockOrientationCapacitySource.prefix_bound
    {Ω : Type u}
    (h : LEINativeSelectedTopologyNoNullLockOrientationCapacitySource Ω)
    (hκ : 0 < h.pollutionBridge.κCost) :
    ∀ K, (Finset.range K).sum h.pollutionBridge.costSeq ≤ h.capacityBudget := by
  intro K
  have haccount := h.cleanVolumeAccountingForSelectedStream
  have hPollutionLeCapacity :
      h.pollutionBridge.Vpolluted ≤ h.Vtotal + h.Vcleaned := by
    unfold cleanVolumeAccounting at haccount
    linarith [h.cleanVolume_nonneg]
  have hCostPollutes :
      h.pollutionBridge.κCost *
          (Finset.range K).sum h.pollutionBridge.costSeq ≤
        h.pollutionBridge.Vpolluted :=
    h.pollutionBridge.selected_cost_creates_pollution K
  have hMul :
      h.pollutionBridge.κCost *
          (Finset.range K).sum h.pollutionBridge.costSeq ≤
        h.pollutionBridge.κCost * h.capacityBudget := by
    linarith [hCostPollutes, hPollutionLeCapacity,
      h.finiteOrientationCapacityConvertedToBudget]
  exact le_of_mul_le_mul_left hMul hκ

