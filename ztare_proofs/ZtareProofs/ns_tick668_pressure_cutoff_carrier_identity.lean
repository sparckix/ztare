      C * nsTick668FinitePrefixSum channelPayment N
  channelPrefix_le_budget :
    ∀ N : Nat, nsTick668FinitePrefixSum channelPayment N <= channelBudget
  channelFixedBeforePayoff : Prop
  channelFixedBeforePayoff_proof : channelFixedBeforePayoff
  sameSelectedPrefixStream : Prop
  sameSelectedPrefixStream_proof : sameSelectedPrefixStream
  channelPaymentNotDefinedFromTargetDeficit : Prop
  channelPaymentNotDefinedFromTargetDeficit_proof :
    channelPaymentNotDefinedFromTargetDeficit
  nonnegativeMonotoneChannelNotSignedCancellation : Prop
  nonnegativeMonotoneChannelNotSignedCancellation_proof :
    nonnegativeMonotoneChannelNotSignedCancellation

/--
A nonnegative selected-prefix channel that pays the target stream and has a
finite budget supplies the exact all-prefix target budget.
-/
theorem SelectedPrefixNonnegativeChannelCollapseSource.targetPrefix_le_budget
    (h : SelectedPrefixNonnegativeChannelCollapseSource) :
    ∀ N : Nat, nsTick668FinitePrefixSum h.targetDebit N <=
      h.C * h.channelBudget := by
  intro N
  have hprefix := h.targetPrefix_le_C_mul_channelPrefix N
  have hbudget := h.channelPrefix_le_budget N
  have hmul : h.C * nsTick668FinitePrefixSum h.channelPayment N <=
      h.C * h.channelBudget := by
    exact mul_le_mul_of_nonneg_left hbudget h.C_nonnegative
  exact le_trans hprefix hmul

/--
Unbounded target debit kills any finite nonnegative selected-prefix channel
unless the proposed rescue supplies a signed/coalescent escape outside this
nonnegative accounting surface.
-/
structure SelectedPrefixUnboundedDebitChannelConfuser where
  targetDebit : Nat → Real
  channelPayment : Nat → Real
  channelBudget : Real
  C : Real
  channelBudget_nonnegative : 0 <= channelBudget
  C_nonnegative : 0 <= C
  targetPrefix_unbounded :
    ∀ B : Real, ∃ N : Nat, B < nsTick668FinitePrefixSum targetDebit N
  nonnegativeChannelLabelOnly : Prop
  nonnegativeChannelLabelOnly_proof : nonnegativeChannelLabelOnly
  signedOrCoalescentEscapeNotSupplied : Prop
  signedOrCoalescentEscapeNotSupplied_proof :
    signedOrCoalescentEscapeNotSupplied

/--
The generic nonnegative-channel collapse source cannot coexist with an
unbounded selected target debit on the same stream and budget constant.
-/
theorem no_SelectedPrefixNonnegativeChannelCollapseSource_of_unboundedDebit
    (c : SelectedPrefixUnboundedDebitChannelConfuser)
    (h : SelectedPrefixNonnegativeChannelCollapseSource)
    (sameDebit : h.targetDebit = c.targetDebit)
    (sameBudget : h.channelBudget = c.channelBudget)
    (sameC : h.C = c.C) : False := by
  obtain ⟨N, hgt⟩ :=
    c.targetPrefix_unbounded (c.C * c.channelBudget)
  have hle := h.targetPrefix_le_budget N
  rw [sameDebit, sameBudget, sameC] at hle
  exact not_lt_of_ge hle hgt

/--
Current-theoretic/coalescent support escape, stated as a quotient-debit source.
Coalescence can help only after every selected endpoint debit assigned to a
coalescent class is paid by that class before payoff.  Otherwise the quotient
forgets omitted children and replays the topology/barcode no-null obstruction.
-/
structure SelectedCoalescentCurrentSupportQuotientDebitSource where
  endpointDebit : Nat → Real
  coalescentClassDebit : Nat → Real
  coalescentBudget : Real
  C : Real
  endpointDebit_nonnegative : ∀ n : Nat, 0 <= endpointDebit n
  coalescentClassDebit_nonnegative : ∀ n : Nat, 0 <= coalescentClassDebit n
  coalescentBudget_nonnegative : 0 <= coalescentBudget
  C_nonnegative : 0 <= C
  endpointPrefix_le_C_mul_coalescentClassPrefix :
    ∀ N : Nat, nsTick668FinitePrefixSum endpointDebit N <=
      C * nsTick668FinitePrefixSum coalescentClassDebit N
  coalescentClassPrefix_le_budget :
    ∀ N : Nat, nsTick668FinitePrefixSum coalescentClassDebit N <=
      coalescentBudget
  currentSupportRelationFixedBeforePayoff : Prop
  currentSupportRelationFixedBeforePayoff_proof :
    currentSupportRelationFixedBeforePayoff
  coalescentClassMapFixedBeforePayoff : Prop
  coalescentClassMapFixedBeforePayoff_proof :
    coalescentClassMapFixedBeforePayoff
  omittedEndpointDebitPaidBeforeQuotient : Prop
  omittedEndpointDebitPaidBeforeQuotient_proof :
    omittedEndpointDebitPaidBeforeQuotient
  quotientDebitNotDefinedFromTargetDeficit : Prop
  quotientDebitNotDefinedFromTargetDeficit_proof :
    quotientDebitNotDefinedFromTargetDeficit
  signedCancellationNotSpentAsPositiveDebit : Prop
  signedCancellationNotSpentAsPositiveDebit_proof :
    signedCancellationNotSpentAsPositiveDebit

/--
A coalescent current quotient is a valid payment source only by becoming a
nonnegative selected-prefix channel for the original endpoint debit.
-/
def SelectedCoalescentCurrentSupportQuotientDebitSource.toNonnegativeChannel
    (h : SelectedCoalescentCurrentSupportQuotientDebitSource) :
    SelectedPrefixNonnegativeChannelCollapseSource where
  targetDebit := h.endpointDebit
  channelPayment := h.coalescentClassDebit
  channelBudget := h.coalescentBudget
  C := h.C
  targetDebit_nonnegative := h.endpointDebit_nonnegative
  channelPayment_nonnegative := h.coalescentClassDebit_nonnegative
  channelBudget_nonnegative := h.coalescentBudget_nonnegative
  C_nonnegative := h.C_nonnegative
  targetPrefix_le_C_mul_channelPrefix :=
    h.endpointPrefix_le_C_mul_coalescentClassPrefix
  channelPrefix_le_budget := h.coalescentClassPrefix_le_budget
  channelFixedBeforePayoff :=
    h.currentSupportRelationFixedBeforePayoff ∧
      h.coalescentClassMapFixedBeforePayoff
  channelFixedBeforePayoff_proof :=
    ⟨h.currentSupportRelationFixedBeforePayoff_proof,
      h.coalescentClassMapFixedBeforePayoff_proof⟩
  sameSelectedPrefixStream := h.omittedEndpointDebitPaidBeforeQuotient
  sameSelectedPrefixStream_proof :=
    h.omittedEndpointDebitPaidBeforeQuotient_proof
  channelPaymentNotDefinedFromTargetDeficit :=
    h.quotientDebitNotDefinedFromTargetDeficit
  channelPaymentNotDefinedFromTargetDeficit_proof :=
    h.quotientDebitNotDefinedFromTargetDeficit_proof
  nonnegativeMonotoneChannelNotSignedCancellation :=
    h.signedCancellationNotSpentAsPositiveDebit
  nonnegativeMonotoneChannelNotSignedCancellation_proof :=
    h.signedCancellationNotSpentAsPositiveDebit_proof

/-- A paid coalescent quotient gives the original endpoint prefix budget. -/
theorem SelectedCoalescentCurrentSupportQuotientDebitSource.endpointPrefix_le_budget
    (h : SelectedCoalescentCurrentSupportQuotientDebitSource) :
    ∀ N : Nat, nsTick668FinitePrefixSum h.endpointDebit N <=
      h.C * h.coalescentBudget :=
  h.toNonnegativeChannel.targetPrefix_le_budget

/--
Many-endpoints-one-class confuser.  A current/coalescent label can merge many
selected endpoint debits into one class while leaving omitted endpoint debit
unpaid; then the quotient budget does not pay the original selected stream.
-/
structure ManyEndpointOneCurrentClassUnderpaidConfuser where
  endpointDebit : Nat → Real
  coalescentClassDebit : Nat → Real
  coalescentBudget : Real
  C : Real
  coalescentBudget_nonnegative : 0 <= coalescentBudget
  C_nonnegative : 0 <= C
  underpaidSelectedPrefix :
    ∃ N : Nat, C * coalescentBudget <
      nsTick668FinitePrefixSum endpointDebit N
  manySelectedEndpointsShareOneCurrentClass : Prop
  manySelectedEndpointsShareOneCurrentClass_proof :
    manySelectedEndpointsShareOneCurrentClass
  omittedEndpointDebitUnpaidBeforeQuotient : Prop
  omittedEndpointDebitUnpaidBeforeQuotient_proof :
    omittedEndpointDebitUnpaidBeforeQuotient
  quotientLabelOnly : Prop
  quotientLabelOnly_proof : quotientLabelOnly

/--
A coalescent quotient source is impossible for the same stream when a selected
prefix already exceeds the finite quotient budget.
-/
theorem no_SelectedCoalescentCurrentSupportQuotientDebitSource_of_manyEndpointUnderpayment
    (c : ManyEndpointOneCurrentClassUnderpaidConfuser)
    (h : SelectedCoalescentCurrentSupportQuotientDebitSource)
    (sameDebit : h.endpointDebit = c.endpointDebit)
    (sameBudget : h.coalescentBudget = c.coalescentBudget)
    (sameC : h.C = c.C) : False := by
  obtain ⟨N, hgt⟩ := c.underpaidSelectedPrefix
  have hle := h.endpointPrefix_le_budget N
  rw [sameDebit, sameBudget, sameC] at hle
  exact not_lt_of_ge hle hgt

/--
Exact CKN/current discriminator after the nonnegative-channel collapse.  A
current/coalescent reinterpretation may survive only if it changes the object
before positive endpoint debit is formed, or if the quotient class pays every
omitted endpoint child before aggregation.  The first exit is a signed/current
annihilation receipt; the second exit reduces to the finite-prefix payment
surface above.
-/
structure PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit where
  endpointDebit : Nat → Real
  coalescentClassDebit : Nat → Real
  coalescentBudget : Real
  C : Real
  endpointDebit_nonnegative : ∀ n : Nat, 0 <= endpointDebit n
  coalescentClassDebit_nonnegative : ∀ n : Nat, 0 <= coalescentClassDebit n
  coalescentBudget_nonnegative : 0 <= coalescentBudget
  C_nonnegative : 0 <= C
  currentSupportRelationFixedBeforePayoff : Prop
  currentSupportRelationFixedBeforePayoff_proof :
    currentSupportRelationFixedBeforePayoff
  selectedEndpointDebitFormedAfterCurrentReduction : Prop
  selectedEndpointDebitFormedAfterCurrentReduction_proof :
    selectedEndpointDebitFormedAfterCurrentReduction
  prePositiveCurrentAnnihilatesEndpointDebit : Prop
  paidOmittedEndpointDebitBeforeQuotient : Prop
  admissibleCurrentExit :
    prePositiveCurrentAnnihilatesEndpointDebit ∨
      paidOmittedEndpointDebitBeforeQuotient
  paidExit_endpointPrefix_le_C_mul_coalescentClassPrefix :
    paidOmittedEndpointDebitBeforeQuotient →
      ∀ N : Nat, nsTick668FinitePrefixSum endpointDebit N <=
        C * nsTick668FinitePrefixSum coalescentClassDebit N
  paidExit_coalescentClassPrefix_le_budget :
    paidOmittedEndpointDebitBeforeQuotient →
      ∀ N : Nat, nsTick668FinitePrefixSum coalescentClassDebit N <=
        coalescentBudget
  quotientDebitNotDefinedFromTargetDeficit : Prop
  quotientDebitNotDefinedFromTargetDeficit_proof :
    quotientDebitNotDefinedFromTargetDeficit
  annihilationReceiptNotPositivePaymentRelabel : Prop
  annihilationReceiptNotPositivePaymentRelabel_proof :
    annihilationReceiptNotPositivePaymentRelabel
  noHiddenNoNullMinkowskiESSBKMOrCFInput : Prop
  noHiddenNoNullMinkowskiESSBKMOrCFInput_proof :
    noHiddenNoNullMinkowskiESSBKMOrCFInput

/-- If the paid-omission exit fires, the discriminator collapses to the old budget. -/
theorem PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit.paid_exit_endpointPrefix_le_budget
    (h : PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit)
    (hpaid : h.paidOmittedEndpointDebitBeforeQuotient) :
    ∀ N : Nat, nsTick668FinitePrefixSum h.endpointDebit N <=
      h.C * h.coalescentBudget := by
  intro N
  have hprefix := h.paidExit_endpointPrefix_le_C_mul_coalescentClassPrefix hpaid N
  have hbudget := h.paidExit_coalescentClassPrefix_le_budget hpaid N
  have hmul : h.C * nsTick668FinitePrefixSum h.coalescentClassDebit N <=
      h.C * h.coalescentBudget := by
    exact mul_le_mul_of_nonneg_left hbudget h.C_nonnegative
  exact le_trans hprefix hmul

/--
If pre-positive annihilation is absent, the exact current discriminator cannot
coexist with the many-endpoints-one-class underpayment packet.
-/
theorem no_PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit_of_manyEndpointUnderpayment_withoutAnnihilation
    (c : ManyEndpointOneCurrentClassUnderpaidConfuser)
    (h : PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit)
    (sameDebit : h.endpointDebit = c.endpointDebit)
    (sameBudget : h.coalescentBudget = c.coalescentBudget)
    (sameC : h.C = c.C)
    (noAnnihilation : ¬ h.prePositiveCurrentAnnihilatesEndpointDebit) :
    False := by
  cases h.admissibleCurrentExit with
  | inl hann =>
      exact noAnnihilation hann
  | inr hpaid =>
      obtain ⟨N, hgt⟩ := c.underpaidSelectedPrefix
      have hle := h.paid_exit_endpointPrefix_le_budget hpaid N
      rw [sameDebit, sameBudget, sameC] at hle
      exact not_lt_of_ge hle hgt

/--
Order-of-operations confuser for the last CKN/current socket.  If the selected
endpoint debit has already been converted into a nonnegative scalar charge, an
oriented current cancellation cannot be spent as annihilation of that positive
stream.  The only escape left is a genuinely pre-scalar current reduction that
changes the object before the endpoint debit is formed.
-/
structure PositiveScalarEndpointDebitCurrentAnnihilationConfuser extends
    ManyEndpointOneCurrentClassUnderpaidConfuser where
  endpointDebitAlreadyPositiveScalar : Prop
  endpointDebitAlreadyPositiveScalar_proof :
    endpointDebitAlreadyPositiveScalar
  positiveScalarizationPrecedesCurrentQuotient : Prop
  positiveScalarizationPrecedesCurrentQuotient_proof :
    positiveScalarizationPrecedesCurrentQuotient
  orientedCurrentCancellationOnlyPreScalar : Prop
  orientedCurrentCancellationOnlyPreScalar_proof :
    orientedCurrentCancellationOnlyPreScalar
  endpointDebitInvariantUnderPostScalarCurrentCancellation : Prop
  endpointDebitInvariantUnderPostScalarCurrentCancellation_proof :
    endpointDebitInvariantUnderPostScalarCurrentCancellation
  genuinePreScalarCurrentReductionNotSupplied : Prop
  genuinePreScalarCurrentReductionNotSupplied_proof :
    genuinePreScalarCurrentReductionNotSupplied
  noPrePositiveCurrentAnnihilationForScalarEndpoint :
    ∀ h : PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit,
      h.endpointDebit = endpointDebit →
        ¬ h.prePositiveCurrentAnnihilatesEndpointDebit

/--
A positive-scalar endpoint debit plus an underpaid quotient kills the current
annihilation socket unless a genuinely pre-scalar current reduction is supplied.
-/
theorem no_PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit_of_positiveScalarEndpointDebitConfuser
    (c : PositiveScalarEndpointDebitCurrentAnnihilationConfuser)
    (h : PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit)
    (sameDebit : h.endpointDebit = c.endpointDebit)
    (sameBudget : h.coalescentBudget = c.coalescentBudget)
    (sameC : h.C = c.C) : False :=
  no_PrePositiveDebitCurrentAnnihilationOrPaidOmittedEndpointDebit_of_manyEndpointUnderpayment_withoutAnnihilation
    c.toManyEndpointOneCurrentClassUnderpaidConfuser h sameDebit sameBudget sameC
    (c.noPrePositiveCurrentAnnihilationForScalarEndpoint h sameDebit)

/--
Tick538 can pay the selected LEI active floor only as a conditional
non-intermittent branch: the selected LEI event must lie in the corrected
tick538 density branch, and the tick538 `alphaA` receipt must be bridged to the
positive-variation carrier `muA` on the same event.
-/
theorem LEINativeHighInterfaceEventTentPrefixSource.selected_active_floor_from_tick538_alpha_bridge
    {Ω : Type u}
    (h : LEINativeHighInterfaceEventTentPrefixSource Ω)
    (T :
      NSTick538TypeIDensityLowerCorrected.TypeIDensityLowerCorrected
        h.suitableDefectSource)
    (hQ :
      T.branch
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex))
    (halpha_mu :
      h.suitableDefectSource.alphaA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) <=
        h.suitableDefectSource.muA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex))
    (hfloor :
      h.interfacePaymentFloor <=
        T.poincareActiveConstant *
          (T.m (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) /
            (2 * T.M ^ 3)) *
          T.r (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex)) :
    h.interfacePaymentFloor <=
      h.suitableDefectSource.muA
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) := by
  have halpha :
      T.poincareActiveConstant *
          (T.m (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) /
            (2 * T.M ^ 3)) *
          T.r (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) <=
        h.suitableDefectSource.alphaA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
    NSTick538TypeIDensityLowerCorrected.alphaA_radius_receipt_corrected
      h.suitableDefectSource T
      (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) hQ
  exact le_trans hfloor (le_trans halpha halpha_mu)

/--
Version of the tick538 bridge that sources the `alphaA <= muA` exchange from a
positive-variation domination receipt. The selected-event branch membership and
floor-below-radius receipt remain explicit inputs.
-/
theorem LEINativeHighInterfaceEventTentPrefixSource.selected_active_floor_from_tick538_positiveVariation
    {Ω : Type u}
    (h : LEINativeHighInterfaceEventTentPrefixSource Ω)
    (T :
      NSTick538TypeIDensityLowerCorrected.TypeIDensityLowerCorrected
        h.suitableDefectSource)
    (hQ :
      T.branch
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex))
    (b :
      ActivePositiveVariationDominatesSignedActiveSource
        h.suitableDefectSource)
    (hfloor :
      h.interfacePaymentFloor <=
        T.poincareActiveConstant *
          (T.m (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) /
            (2 * T.M ^ 3)) *
          T.r (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex)) :
    h.interfacePaymentFloor <=
      h.suitableDefectSource.muA
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) := by
  exact h.selected_active_floor_from_tick538_alpha_bridge T hQ
    (alphaA_le_muA_of_activePositiveVariationDominatesSignedActive b
      (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex))
    hfloor

/--
Stricter positive branch source: the LEI-native source is constructed without
assuming `selectedLEIEventActiveFloor`. Instead the selected floor is paid by a
non-intermittent tick538 branch receipt plus a same-event positive-variation
bridge from `alphaA` to `muA`.
-/
structure LEINativeTick538PositiveVariationBranchSource (Ω : Type u)
    extends SuitableDefectBackedHighInterfaceMeasureSplitCore Ω where
  eventFamilyBindingPaidByDefinition : Prop
  eventFamilyBindingPaidByDefinition_proof :
    eventFamilyBindingPaidByDefinition
  highInterfaceEventsAreSuitableDefectEventTents : Prop
  highInterfaceEventsAreSuitableDefectEventTents_proof :
    highInterfaceEventsAreSuitableDefectEventTents
  tick538DensityBranch :
    NSTick538TypeIDensityLowerCorrected.TypeIDensityLowerCorrected
      suitableDefectSource
  selectedEventInTick538Branch :
    tick538DensityBranch.branch
      (highInterfaceEventSet selectedHighInterfacePrefixIndex)
  activePositiveVariationBridge :
    ActivePositiveVariationDominatesSignedActiveSource suitableDefectSource
  selectedFloor_le_tick538RadiusReceipt :
    interfacePaymentFloor <=
      tick538DensityBranch.poincareActiveConstant *
        (tick538DensityBranch.m
          (highInterfaceEventSet selectedHighInterfacePrefixIndex) /
          (2 * tick538DensityBranch.M ^ 3)) *
        tick538DensityBranch.r
          (highInterfaceEventSet selectedHighInterfacePrefixIndex)

/-- The stricter branch source derives the selected LEI active floor. -/
theorem LEINativeTick538PositiveVariationBranchSource.selectedLEIEventActiveFloor_derived
    {Ω : Type u}
    (h : LEINativeTick538PositiveVariationBranchSource Ω) :
    h.interfacePaymentFloor <=
      h.suitableDefectSource.muA
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) := by
  have halpha :
      h.tick538DensityBranch.poincareActiveConstant *
          (h.tick538DensityBranch.m
            (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) /
            (2 * h.tick538DensityBranch.M ^ 3)) *
          h.tick538DensityBranch.r
            (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) <=
        h.suitableDefectSource.alphaA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
    NSTick538TypeIDensityLowerCorrected.alphaA_radius_receipt_corrected
      h.suitableDefectSource h.tick538DensityBranch
      (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex)
      h.selectedEventInTick538Branch
  have hmu :
      h.suitableDefectSource.alphaA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) <=
        h.suitableDefectSource.muA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
    alphaA_le_muA_of_activePositiveVariationDominatesSignedActive
      h.activePositiveVariationBridge
      (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex)
  exact le_trans h.selectedFloor_le_tick538RadiusReceipt
    (le_trans halpha hmu)

/-- The stricter branch source constructs the original LEI-native source. -/
def LEINativeHighInterfaceEventTentPrefixSource.ofTick538PositiveVariationBranch
    {Ω : Type u}
    (h : LEINativeTick538PositiveVariationBranchSource Ω) :
    LEINativeHighInterfaceEventTentPrefixSource Ω where
  toSuitableDefectBackedHighInterfaceMeasureSplitCore :=
    h.toSuitableDefectBackedHighInterfaceMeasureSplitCore
  eventFamilyBindingPaidByDefinition :=
    h.eventFamilyBindingPaidByDefinition
  eventFamilyBindingPaidByDefinition_proof :=
    h.eventFamilyBindingPaidByDefinition_proof
  highInterfaceEventsAreSuitableDefectEventTents :=
    h.highInterfaceEventsAreSuitableDefectEventTents
  highInterfaceEventsAreSuitableDefectEventTents_proof :=
    h.highInterfaceEventsAreSuitableDefectEventTents_proof
  selectedLEIEventActiveFloor :=
    h.selectedLEIEventActiveFloor_derived

