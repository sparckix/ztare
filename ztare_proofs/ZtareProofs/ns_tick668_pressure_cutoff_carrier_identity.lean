  ZtareProofs.NSTick553DualChannelBesicovitchLojasiewicz.freshness_from_either_channel
    h.costSeq h.reserveSeq h.repairSeq h.errorSeq
    h.multiplicityConst h.atomBudget h.reserveBudgetBound
    h.costSeq_nonneg h.reserveSeq_nonneg h.geometricMultiplicity_or_analyticReserveDrop

