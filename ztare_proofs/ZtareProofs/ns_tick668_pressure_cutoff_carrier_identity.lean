  h.toRestrictedHighInterfaceBoundaryPaymentSource


/--
Finite-prefix source for conditional average dominance on the high-interface law.
This is the numeric positive constructor behind the average-dominance receipt:
the prefix is fixed before payoff, both charges live on the same high-interface
source family, and the selected witness is a floor-paying boundary-paid event.
-/
structure HighInterfaceFinitePrefixAverageBoundaryDominanceSource extends
    HighInterfaceConditionalAverageBoundaryDominanceSource where
  highInterfaceBoundaryCharge : Nat → Real
  highInterfacePayment : Nat → Real
  highInterfacePrefixLength : Nat
  highInterfacePrefixLength_pos : 0 < highInterfacePrefixLength
  selectedHighInterfacePrefixIndex : Nat
  selectedHighInterfacePrefixIndex_lt :
    selectedHighInterfacePrefixIndex < highInterfacePrefixLength
  finitePrefixHighInterfacePayment_le_boundaryCharge :
    nsTick668FinitePrefixSum highInterfacePayment highInterfacePrefixLength <=
      nsTick668FinitePrefixSum highInterfaceBoundaryCharge highInterfacePrefixLength
  highInterfaceBoundaryProductionSpend : Real
  highInterfaceBoundaryProductionSpend_nonneg :
    0 <= highInterfaceBoundaryProductionSpend
  highInterfaceBoundaryPressureReserveSpend : Real
  highInterfaceBoundaryPressureReserveSpend_nonneg :
    0 <= highInterfaceBoundaryPressureReserveSpend
  highInterfaceBoundaryDuhamelReserveSpend : Real
  highInterfaceBoundaryDuhamelReserveSpend_nonneg :
    0 <= highInterfaceBoundaryDuhamelReserveSpend
  highInterfaceBoundaryInheritedReserveSpend : Real
  highInterfaceBoundaryInheritedReserveSpend_nonneg :
    0 <= highInterfaceBoundaryInheritedReserveSpend
  highInterfaceBoundaryPartitionSingleSpend :
    highInterfaceBoundaryProductionSpend +
      highInterfaceBoundaryPressureReserveSpend +
      highInterfaceBoundaryDuhamelReserveSpend +
      highInterfaceBoundaryInheritedReserveSpend <=
        nsTick668FinitePrefixSum highInterfaceBoundaryCharge highInterfacePrefixLength
  sameOwnerHighInterfaceBoundaryBudget : Real
  sameOwnerHighInterfaceBoundaryBudget_nonneg :
    0 <= sameOwnerHighInterfaceBoundaryBudget
  highInterfaceBoundaryPrefixSpend_le_sameOwnerBudget :
    nsTick668FinitePrefixSum highInterfaceBoundaryCharge highInterfacePrefixLength <=
      sameOwnerHighInterfaceBoundaryBudget
  sameOwnerHighInterfaceBoundaryBudget_le_ownerRootBudget :
    sameOwnerHighInterfaceBoundaryBudget <= ownerRootBudget
  noReuseHighInterfaceBoundaryBudget : Real
  noReuseHighInterfaceBoundaryBudget_nonneg :
    0 <= noReuseHighInterfaceBoundaryBudget
  highInterfaceBoundaryPrefixSpend_le_noReuseBudget :
    nsTick668FinitePrefixSum highInterfaceBoundaryCharge highInterfacePrefixLength <=
      noReuseHighInterfaceBoundaryBudget
  noReuseHighInterfaceBoundaryBudget_le_ownerRootBudget :
    noReuseHighInterfaceBoundaryBudget <= ownerRootBudget
  selectedHighInterfacePaymentPaysFloor :
    interfacePaymentFloor <= highInterfacePayment selectedHighInterfacePrefixIndex
  selectedHighBoundaryPaysInterface :
    highInterfacePayment selectedHighInterfacePrefixIndex <=
      highInterfaceBoundaryCharge selectedHighInterfacePrefixIndex
  highInterfacePrefixFamilyFixedBeforePayoff : Prop
  highInterfacePrefixFamilyFixedBeforePayoff_proof :
    highInterfacePrefixFamilyFixedBeforePayoff
  boundaryAndInterfaceChargesSameHighInterfaceLaw : Prop
  boundaryAndInterfaceChargesSameHighInterfaceLaw_proof :
    boundaryAndInterfaceChargesSameHighInterfaceLaw
  selectedPrefixWitnessMatchesRestrictedEvent : Prop
  selectedPrefixWitnessMatchesRestrictedEvent_proof :
    selectedPrefixWitnessMatchesRestrictedEvent
  finitePrefixDominanceNotGlobalBoundarySurplus : Prop
  finitePrefixDominanceNotGlobalBoundarySurplus_proof :
    finitePrefixDominanceNotGlobalBoundarySurplus
  sourceContractAlignmentCheckPassedForHighInterfacePrefix : Prop
  sourceContractAlignmentCheckPassedForHighInterfacePrefix_proof :
    sourceContractAlignmentCheckPassedForHighInterfacePrefix

/-- The finite-prefix source contains an actual high-interface boundary-paid witness. -/
theorem HighInterfaceFinitePrefixAverageBoundaryDominanceSource.exists_boundary_pays_interface
    (h : HighInterfaceFinitePrefixAverageBoundaryDominanceSource) :
    ∃ n : Nat, n < h.highInterfacePrefixLength ∧
      h.highInterfacePayment n <= h.highInterfaceBoundaryCharge n :=
  nsTick668_exists_boundary_ge_interface_of_prefix_interface_le_boundary
    h.highInterfacePrefixLength_pos h.finitePrefixHighInterfacePayment_le_boundaryCharge

/-- The selected finite-prefix witness pays the floor through boundary charge. -/
theorem HighInterfaceFinitePrefixAverageBoundaryDominanceSource.boundary_pays_floor
    (h : HighInterfaceFinitePrefixAverageBoundaryDominanceSource) :
    h.interfacePaymentFloor <=
      h.highInterfaceBoundaryCharge h.selectedHighInterfacePrefixIndex := by
  linarith [h.selectedHighInterfacePaymentPaysFloor,
    h.selectedHighBoundaryPaysInterface]

/-- The finite-prefix dominance source supplies the conditional-average source. -/
def HighInterfaceConditionalAverageBoundaryDominanceSource.ofFinitePrefixAverageDominance
    (h : HighInterfaceFinitePrefixAverageBoundaryDominanceSource) :
    HighInterfaceConditionalAverageBoundaryDominanceSource :=
  h.toHighInterfaceConditionalAverageBoundaryDominanceSource


/--
Level418 finite-prefix threshold-formula bridge.  The finite-prefix source
selects a boundary-paid high-interface witness; this bridge additionally pins
that witness to the selected threshold event and identifies its interface
payment with the selected-section absolute variation before payoff.
-/
structure FinitePrefixThresholdFormulaSelectedVariationSource extends
    HighInterfaceFinitePrefixAverageBoundaryDominanceSource where
  selectedCorrelationThresholdIndex_eq_selectedHighInterfacePrefixIndex :
    selectedCorrelationThresholdIndex = selectedHighInterfacePrefixIndex
  selectedHighInterfacePrefixIndex_lt_restrictedPrefix :
    selectedHighInterfacePrefixIndex < restrictedSourceLawPrefixLength
  thresholdInterfacePayment_eq_highInterfacePayment_on_restrictedPrefix :
    ∀ n : Nat, n < restrictedSourceLawPrefixLength →
      thresholdInterfacePayment n = highInterfacePayment n
  thresholdBoundaryCharge_eq_highInterfaceBoundaryCharge_on_restrictedPrefix :
    ∀ n : Nat, n < restrictedSourceLawPrefixLength →
      thresholdBoundaryCharge n = highInterfaceBoundaryCharge n
  selectedAbsoluteVariation_eq_selectedHighInterfacePayment :
    selectedAbsoluteVariation = highInterfacePayment selectedHighInterfacePrefixIndex
  finitePrefixThresholdFormulaFixedBeforePayoff : Prop
  finitePrefixThresholdFormulaFixedBeforePayoff_proof :
    finitePrefixThresholdFormulaFixedBeforePayoff
  selectedFinitePrefixIndexFixedBeforePayoff : Prop
  selectedFinitePrefixIndexFixedBeforePayoff_proof :
    selectedFinitePrefixIndexFixedBeforePayoff
  thresholdHighInterfaceLawSameCarrier : Prop
  thresholdHighInterfaceLawSameCarrier_proof :
    thresholdHighInterfaceLawSameCarrier
  selectedPaymentRepresentsExtensionalInterfaceVariation : Prop
  selectedPaymentRepresentsExtensionalInterfaceVariation_proof :
    selectedPaymentRepresentsExtensionalInterfaceVariation
  finitePrefixThresholdFormulaNoOverlapWithPriorInvoices : Prop
  finitePrefixThresholdFormulaNoOverlapWithPriorInvoices_proof :
    finitePrefixThresholdFormulaNoOverlapWithPriorInvoices
  finitePrefixThresholdFormulaNoReuseNoRebilling : Prop
  finitePrefixThresholdFormulaNoReuseNoRebilling_proof :
    finitePrefixThresholdFormulaNoReuseNoRebilling
  lowerBoundComesFromFinitePrefixThresholdFormulaGeometry : Prop
  lowerBoundComesFromFinitePrefixThresholdFormulaGeometry_proof :
    lowerBoundComesFromFinitePrefixThresholdFormulaGeometry
  noPostPayoffFinitePrefixFormulaRepair : Prop
  noPostPayoffFinitePrefixFormulaRepair_proof :
    noPostPayoffFinitePrefixFormulaRepair
  noTotalInvoiceAfterPayoffFinitePrefixEqualityRecovery : Prop
  noTotalInvoiceAfterPayoffFinitePrefixEqualityRecovery_proof :
    noTotalInvoiceAfterPayoffFinitePrefixEqualityRecovery

/-- The finite-prefix bridge proves the selected-threshold equality required by Level417. -/
theorem FinitePrefixThresholdFormulaSelectedVariationSource.selectedAbs_eq_thresholdPayment
    (h : FinitePrefixThresholdFormulaSelectedVariationSource) :
    h.selectedAbsoluteVariation =
      h.thresholdInterfacePayment h.selectedCorrelationThresholdIndex := by
  calc
    h.selectedAbsoluteVariation =
        h.highInterfacePayment h.selectedHighInterfacePrefixIndex :=
      h.selectedAbsoluteVariation_eq_selectedHighInterfacePayment
    _ = h.thresholdInterfacePayment h.selectedHighInterfacePrefixIndex :=
      (h.thresholdInterfacePayment_eq_highInterfacePayment_on_restrictedPrefix
        h.selectedHighInterfacePrefixIndex
        h.selectedHighInterfacePrefixIndex_lt_restrictedPrefix).symm
    _ = h.thresholdInterfacePayment h.selectedCorrelationThresholdIndex := by
      rw [h.selectedCorrelationThresholdIndex_eq_selectedHighInterfacePrefixIndex]

/-- The finite-prefix threshold-formula bridge supplies the Level417 source. -/
noncomputable def RestrictedThresholdFormulaSelectedSectionLinkSource.ofFinitePrefixThresholdFormula
    (h : FinitePrefixThresholdFormulaSelectedVariationSource) :
    RestrictedThresholdFormulaSelectedSectionLinkSource where
  toRestrictedHighInterfaceBoundaryPaymentSource :=
    h.toRestrictedHighInterfaceBoundaryPaymentSource
  selectedAbsoluteVariation_eq_thresholdInterfacePayment :=
    h.selectedAbs_eq_thresholdPayment
  sourceThresholdFormulaFixedBeforePayoff :=
    h.finitePrefixThresholdFormulaFixedBeforePayoff
  sourceThresholdFormulaFixedBeforePayoff_proof :=
    h.finitePrefixThresholdFormulaFixedBeforePayoff_proof
  selectedThresholdFormulaNoReuseNoRebilling :=
    h.finitePrefixThresholdFormulaNoReuseNoRebilling
  selectedThresholdFormulaNoReuseNoRebilling_proof :=
    h.finitePrefixThresholdFormulaNoReuseNoRebilling_proof
  lowerBoundComesFromRestrictedThresholdFormulaGeometry :=
    h.lowerBoundComesFromFinitePrefixThresholdFormulaGeometry
  lowerBoundComesFromRestrictedThresholdFormulaGeometry_proof :=
    h.lowerBoundComesFromFinitePrefixThresholdFormulaGeometry_proof
  noPostPayoffSectionRepairInEquality :=
    h.noPostPayoffFinitePrefixFormulaRepair
  noPostPayoffSectionRepairInEquality_proof :=
    h.noPostPayoffFinitePrefixFormulaRepair_proof
  noTotalInvoiceAfterPayoffEqualityRecovery :=
    h.noTotalInvoiceAfterPayoffFinitePrefixEqualityRecovery
  noTotalInvoiceAfterPayoffEqualityRecovery_proof :=
    h.noTotalInvoiceAfterPayoffFinitePrefixEqualityRecovery_proof

/-- The finite-prefix threshold-formula bridge reaches the selected-section analytic bridge. -/
noncomputable def SelectedSectionExtensionalInterfaceVariationAnalyticLowerBoundBridge.ofFinitePrefixThresholdFormula
    (h : FinitePrefixThresholdFormulaSelectedVariationSource) :
    SelectedSectionExtensionalInterfaceVariationAnalyticLowerBoundBridge :=
  SelectedSectionExtensionalInterfaceVariationAnalyticLowerBoundBridge.ofRestrictedThresholdFormulaLink
    (RestrictedThresholdFormulaSelectedSectionLinkSource.ofFinitePrefixThresholdFormula h)


/--
Local-energy invoice dominance source on the high-interface prefix.  This is the
non-signed interpretation of boundary payment: the spendable boundary charge is
an invoice made from visible positive boundary charge plus an independently paid
residual reserve, both fixed before payoff and on the same owner prefix.
-/
structure LocalEnergyInvoiceHighInterfaceDominanceSource extends
    HighInterfaceConditionalAverageBoundaryDominanceSource where
  highInterfaceBoundaryCharge : Nat → Real
  highInterfacePayment : Nat → Real
  highInterfacePrefixLength : Nat
  highInterfacePrefixLength_pos : 0 < highInterfacePrefixLength
  selectedHighInterfacePrefixIndex : Nat
  selectedHighInterfacePrefixIndex_lt :
    selectedHighInterfacePrefixIndex < highInterfacePrefixLength
  visibleBoundaryCharge : Nat → Real
  residualReserveCharge : Nat → Real
  localEnergyInvoiceCharge : Nat → Real
  visibleBoundaryCharge_nonneg : ∀ n : Nat, 0 <= visibleBoundaryCharge n
  residualReserveCharge_nonneg : ∀ n : Nat, 0 <= residualReserveCharge n
  localEnergyInvoice_eq_visible_plus_residual :
    ∀ n : Nat, localEnergyInvoiceCharge n =
      visibleBoundaryCharge n + residualReserveCharge n
  localEnergyInvoice_eq_boundaryCharge :
    ∀ n : Nat, highInterfaceBoundaryCharge n = localEnergyInvoiceCharge n
  pointwiseHighInterfacePayment_le_localEnergyInvoice :
    ∀ n : Nat, n < highInterfacePrefixLength →
      highInterfacePayment n <= localEnergyInvoiceCharge n
  selectedHighInterfacePaymentPaysFloor :
    interfacePaymentFloor <= highInterfacePayment selectedHighInterfacePrefixIndex
  highInterfaceBoundaryProductionSpend : Real
  highInterfaceBoundaryProductionSpend_nonneg :
    0 <= highInterfaceBoundaryProductionSpend
  highInterfaceBoundaryPressureReserveSpend : Real
  highInterfaceBoundaryPressureReserveSpend_nonneg :
    0 <= highInterfaceBoundaryPressureReserveSpend
  highInterfaceBoundaryDuhamelReserveSpend : Real
  highInterfaceBoundaryDuhamelReserveSpend_nonneg :
    0 <= highInterfaceBoundaryDuhamelReserveSpend
  highInterfaceBoundaryInheritedReserveSpend : Real
  highInterfaceBoundaryInheritedReserveSpend_nonneg :
    0 <= highInterfaceBoundaryInheritedReserveSpend
  highInterfaceBoundaryPartitionSingleSpend :
    highInterfaceBoundaryProductionSpend +
      highInterfaceBoundaryPressureReserveSpend +
      highInterfaceBoundaryDuhamelReserveSpend +
      highInterfaceBoundaryInheritedReserveSpend <=
        nsTick668FinitePrefixSum highInterfaceBoundaryCharge highInterfacePrefixLength
  sameOwnerHighInterfaceBoundaryBudget : Real
  sameOwnerHighInterfaceBoundaryBudget_nonneg :
    0 <= sameOwnerHighInterfaceBoundaryBudget
  highInterfaceBoundaryPrefixSpend_le_sameOwnerBudget :
    nsTick668FinitePrefixSum highInterfaceBoundaryCharge highInterfacePrefixLength <=
      sameOwnerHighInterfaceBoundaryBudget
  sameOwnerHighInterfaceBoundaryBudget_le_ownerRootBudget :
    sameOwnerHighInterfaceBoundaryBudget <= ownerRootBudget
  noReuseHighInterfaceBoundaryBudget : Real
  noReuseHighInterfaceBoundaryBudget_nonneg :
    0 <= noReuseHighInterfaceBoundaryBudget
  highInterfaceBoundaryPrefixSpend_le_noReuseBudget :
    nsTick668FinitePrefixSum highInterfaceBoundaryCharge highInterfacePrefixLength <=
      noReuseHighInterfaceBoundaryBudget
  noReuseHighInterfaceBoundaryBudget_le_ownerRootBudget :
    noReuseHighInterfaceBoundaryBudget <= ownerRootBudget
  localEnergyIdentityFixedBeforePayoff : Prop
  localEnergyIdentityFixedBeforePayoff_proof :
    localEnergyIdentityFixedBeforePayoff
  residualReserveIndependentlyGenerated : Prop
  residualReserveIndependentlyGenerated_proof :
    residualReserveIndependentlyGenerated
  visibleBoundaryAndResidualSameOwnerPrefix : Prop
  visibleBoundaryAndResidualSameOwnerPrefix_proof :
    visibleBoundaryAndResidualSameOwnerPrefix
  residualReserveNotDefinedFromBoundaryDeficit : Prop
  residualReserveNotDefinedFromBoundaryDeficit_proof :
    residualReserveNotDefinedFromBoundaryDeficit
  localEnergyInvoiceNotSignedPressureVisibility : Prop
  localEnergyInvoiceNotSignedPressureVisibility_proof :
    localEnergyInvoiceNotSignedPressureVisibility

/-- The local-energy invoice source supplies the finite-prefix constructor. -/
def HighInterfaceFinitePrefixAverageBoundaryDominanceSource.ofLocalEnergyInvoiceDominance
    (h : LocalEnergyInvoiceHighInterfaceDominanceSource) :
    HighInterfaceFinitePrefixAverageBoundaryDominanceSource where
  toHighInterfaceConditionalAverageBoundaryDominanceSource :=
    h.toHighInterfaceConditionalAverageBoundaryDominanceSource
  highInterfaceBoundaryCharge := h.highInterfaceBoundaryCharge
  highInterfacePayment := h.highInterfacePayment
  highInterfacePrefixLength := h.highInterfacePrefixLength
  highInterfacePrefixLength_pos := h.highInterfacePrefixLength_pos
  selectedHighInterfacePrefixIndex := h.selectedHighInterfacePrefixIndex
  selectedHighInterfacePrefixIndex_lt := h.selectedHighInterfacePrefixIndex_lt
  finitePrefixHighInterfacePayment_le_boundaryCharge := by
    refine nsTick668FinitePrefixSum_le_of_pointwise_on_prefix
      h.highInterfacePrefixLength ?_
    intro n hn
    have hpay := h.pointwiseHighInterfacePayment_le_localEnergyInvoice n hn
    rw [← h.localEnergyInvoice_eq_boundaryCharge n] at hpay
    exact hpay
  highInterfaceBoundaryProductionSpend := h.highInterfaceBoundaryProductionSpend
  highInterfaceBoundaryProductionSpend_nonneg :=
    h.highInterfaceBoundaryProductionSpend_nonneg
  highInterfaceBoundaryPressureReserveSpend :=
    h.highInterfaceBoundaryPressureReserveSpend
  highInterfaceBoundaryPressureReserveSpend_nonneg :=
    h.highInterfaceBoundaryPressureReserveSpend_nonneg
  highInterfaceBoundaryDuhamelReserveSpend :=
    h.highInterfaceBoundaryDuhamelReserveSpend
  highInterfaceBoundaryDuhamelReserveSpend_nonneg :=
    h.highInterfaceBoundaryDuhamelReserveSpend_nonneg
  highInterfaceBoundaryInheritedReserveSpend :=
    h.highInterfaceBoundaryInheritedReserveSpend
  highInterfaceBoundaryInheritedReserveSpend_nonneg :=
    h.highInterfaceBoundaryInheritedReserveSpend_nonneg
  highInterfaceBoundaryPartitionSingleSpend :=
    h.highInterfaceBoundaryPartitionSingleSpend
  sameOwnerHighInterfaceBoundaryBudget := h.sameOwnerHighInterfaceBoundaryBudget
  sameOwnerHighInterfaceBoundaryBudget_nonneg :=
    h.sameOwnerHighInterfaceBoundaryBudget_nonneg
  highInterfaceBoundaryPrefixSpend_le_sameOwnerBudget :=
    h.highInterfaceBoundaryPrefixSpend_le_sameOwnerBudget
  sameOwnerHighInterfaceBoundaryBudget_le_ownerRootBudget :=
    h.sameOwnerHighInterfaceBoundaryBudget_le_ownerRootBudget
  noReuseHighInterfaceBoundaryBudget := h.noReuseHighInterfaceBoundaryBudget
  noReuseHighInterfaceBoundaryBudget_nonneg :=
    h.noReuseHighInterfaceBoundaryBudget_nonneg
  highInterfaceBoundaryPrefixSpend_le_noReuseBudget :=
    h.highInterfaceBoundaryPrefixSpend_le_noReuseBudget
  noReuseHighInterfaceBoundaryBudget_le_ownerRootBudget :=
    h.noReuseHighInterfaceBoundaryBudget_le_ownerRootBudget
  selectedHighInterfacePaymentPaysFloor :=
    h.selectedHighInterfacePaymentPaysFloor
  selectedHighBoundaryPaysInterface := by
    have hpay := h.pointwiseHighInterfacePayment_le_localEnergyInvoice
      h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt
    rw [← h.localEnergyInvoice_eq_boundaryCharge h.selectedHighInterfacePrefixIndex]
      at hpay
    exact hpay
  highInterfacePrefixFamilyFixedBeforePayoff :=
    h.localEnergyIdentityFixedBeforePayoff
  highInterfacePrefixFamilyFixedBeforePayoff_proof :=
    h.localEnergyIdentityFixedBeforePayoff_proof
  boundaryAndInterfaceChargesSameHighInterfaceLaw :=
    h.visibleBoundaryAndResidualSameOwnerPrefix
  boundaryAndInterfaceChargesSameHighInterfaceLaw_proof :=
    h.visibleBoundaryAndResidualSameOwnerPrefix_proof
  selectedPrefixWitnessMatchesRestrictedEvent :=
