/--
Finite trace-zero strain jet that realizes positive same-trajectory net budget.
It records the local algebraic obstruction to any SOS sterility certificate: a
trace-free strain may stretch vorticity along one eigenvector while compensating
in the transverse directions.
-/
structure TraceZeroStrainPositiveNetBudgetJet where
  packet : BalancedCoreSheathDiniLadderConePacket
  state : NS.StealthGrowthState
  lam1 : Real
  lam2 : Real
  lam3 : Real
  eta : Real
  A : Real
  traceZero : lam1 + lam2 + lam3 = 0
  stretchingEigenvaluePositive : 0 < lam1
  transverseCompensation : lam2 + lam3 < 0
  production_eq : state.signedProduction = (1 + eta) * A
  dissipation_eq : state.viscousDissipation = A
  eta_pos : 0 < eta
  A_pos : 0 < A
  packetEncodesNearStealthBalancedCone : Prop
  packetEncodesNearStealthBalancedCone_proof :
    packetEncodesNearStealthBalancedCone
  sameOwnerSelectedStream : Prop
  sameOwnerSelectedStream_proof : sameOwnerSelectedStream

/--
The finite trace-zero positive-production jet has positive net enstrophy budget.
-/
theorem positiveNetBudget_of_traceZeroStrainPositiveProductionJet
    (h : TraceZeroStrainPositiveNetBudgetJet) :
    0 < NS.netEnstrophyBudget h.state := by
  unfold NS.netEnstrophyBudget
  rw [h.production_eq, h.dissipation_eq]
  nlinarith [h.eta_pos, h.A_pos]

/--
The same-state trace-zero positive-production jet is the exact falsifier for a
near-stealth SOS gap certificate.  An SOS certificate with positive slack proves
negative net budget on its state, while the jet proves positive net budget on
the same state.  This keeps Level338 from accepting numeric-SOS or block-only
certificates before the positive-net jet is ruled out.
-/
theorem no_BalancedCoreSheathSosGapCertificateSource_of_traceZeroPositiveNetBudgetJet
    (hJet : TraceZeroStrainPositiveNetBudgetJet)
    (hCert : BalancedCoreSheathSosGapCertificateSource)
    (_hSamePacket : hCert.packet = hJet.packet)
    (hSameState : hCert.state = hJet.state) :
    False := by
  have hnet_lt_cert : NS.netEnstrophyBudget hCert.state < 0 :=
    NS.nonpositive_net_budget_of_sos_gap_certificate
      hCert.state hCert.slack hCert.terms hCert.slack_pos
      hCert.sos_gap_certificate
  have hnet_lt_jet : NS.netEnstrophyBudget hJet.state < 0 := by
    simpa [hSameState] using hnet_lt_cert
  have hnet_pos_jet : 0 < NS.netEnstrophyBudget hJet.state :=
    positiveNetBudget_of_traceZeroStrainPositiveProductionJet hJet
  nlinarith [hnet_pos_jet, hnet_lt_jet]

