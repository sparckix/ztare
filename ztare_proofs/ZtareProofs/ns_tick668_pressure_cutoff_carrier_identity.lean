  cheapBoundaryMeasureLowerBound_nonneg : 0 <= cheapBoundaryMeasureLowerBound
  highInterfaceMeasureLowerBound : Real
  highInterfaceMeasureLowerBound_nonneg : 0 <= highInterfaceMeasureLowerBound
  cheapBoundaryMeasureLowerBound_le_lowBoundarySetMeasure :
    cheapBoundaryMeasureLowerBound <= lowBoundarySetMeasure
  lowerBoundsOverfillThresholdSpace :
    thresholdSpaceMeasure < cheapBoundaryMeasureLowerBound + highInterfaceMeasureLowerBound
  interfaceFirstMoment : Real
  interfaceFirstMomentLowerBound : Real
  interfaceFirstMomentLowerBound_nonneg : 0 <= interfaceFirstMomentLowerBound
  interfaceAmplitudeCap : Real
  interfaceAmplitudeCap_pos : 0 < interfaceAmplitudeCap
  interfaceFirstMomentLowerBound_le_interfaceFirstMoment :
    interfaceFirstMomentLowerBound <= interfaceFirstMoment
  interfaceFirstMoment_le_cap_mul_highInterfaceSetMeasure :
    interfaceFirstMoment <= interfaceAmplitudeCap * highInterfaceSetMeasure
  highInterfaceLowerBound_mul_cap_le_firstMomentLowerBound :
    highInterfaceMeasureLowerBound * interfaceAmplitudeCap <=
      interfaceFirstMomentLowerBound
  cheapBoundaryLowerBoundFromMarkovCoareaAverage : Prop
  cheapBoundaryLowerBoundFromMarkovCoareaAverage_proof :
    cheapBoundaryLowerBoundFromMarkovCoareaAverage
  highInterfaceLowerBoundFromAmplitudeCap : Prop
  highInterfaceLowerBoundFromAmplitudeCap_proof :
    highInterfaceLowerBoundFromAmplitudeCap
  fixedProfileAmplitudeCapFromAngularCollar : Prop
  fixedProfileAmplitudeCapFromAngularCollar_proof :
    fixedProfileAmplitudeCapFromAngularCollar
  sameThresholdFamilyAsCoareaInterfacePayment : Prop
  sameThresholdFamilyAsCoareaInterfacePayment_proof :
    sameThresholdFamilyAsCoareaInterfacePayment
  amplitudeCapFixedBeforePayoff : Prop
  amplitudeCapFixedBeforePayoff_proof : amplitudeCapFixedBeforePayoff
  notLayerCakeFirstMomentOnly : Prop
  notLayerCakeFirstMomentOnly_proof : notLayerCakeFirstMomentOnly
  interfaceSecondMomentReceiptFromAmplitudeCap : Prop
  interfaceSecondMomentReceiptFromAmplitudeCap_proof :
    interfaceSecondMomentReceiptFromAmplitudeCap

/-- The fixed-profile amplitude cap derives the high-interface support bound. -/
theorem FixedProfileAmplitudeCapAntiSpikeSizeSumSource.highInterfaceMeasureLowerBound_le_highInterfaceSetMeasure
    (h : FixedProfileAmplitudeCapAntiSpikeSizeSumSource) :
    h.highInterfaceMeasureLowerBound <= h.highInterfaceSetMeasure :=
