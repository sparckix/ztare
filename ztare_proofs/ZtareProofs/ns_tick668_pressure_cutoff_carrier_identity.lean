      Nat.lt_of_lt_of_le hn h.restrictedPrefix_le_highInterfacePrefixLength
    calc
      h.thresholdInterfacePayment n = h.highInterfacePayment n :=
        h.thresholdInterfacePayment_eq_highInterfaceChannel_on_restrictedPrefix n hn
      _ = h.activeMeasure (h.highInterfaceEventSet n) :=
        h.highInterfacePayment_eq_activeMeasure n hnHigh
      _ = h.suitableDefectSource.muA (h.highInterfaceEventSet n) :=
