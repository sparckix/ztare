    noProductL2OrBesovProxyInPayment

/--
Route1-style arithmetic consumer for the pointwise same-carrier payment
receipt.  This is the positive fragment that is already reusable: after
`c * angularEventPay e <= freshCharge e` is paid, every trace-free event prefix
is bounded by `rootBudget / c`.
-/
theorem traceFreeVariationPrefix_le_rootBudget_div_c_of_pointwisePayment
    (h : TraceFreeVariationPointwiseSameCarrierPaymentReceipt) :
    ∀ N : Nat,
      nsTick668FinitePrefixSum h.angularEventPay N ≤ h.rootBudget / h.c := by
  intro N
  have hpoint :
      nsTick668FinitePrefixSum
          (fun n : Nat => h.c * h.angularEventPay n) N ≤
        nsTick668FinitePrefixSum h.freshCharge N :=
    nsTick668FinitePrefixSum_le_of_pointwise
      h.pointwiseTraceFreeVariationPayment N
  rw [nsTick668FinitePrefixSum_const_mul_left] at hpoint
  have hbudget :
      h.c * nsTick668FinitePrefixSum h.angularEventPay N ≤
        h.rootBudget := by
    exact le_trans hpoint (h.finitePrefixFreshCarrierBudget N)
  have hbudget' :
      nsTick668FinitePrefixSum h.angularEventPay N * h.c ≤
        h.rootBudget := by
    simpa [mul_comm] using hbudget
  exact (le_div_iff₀ h.c_pos).2 hbudget'

