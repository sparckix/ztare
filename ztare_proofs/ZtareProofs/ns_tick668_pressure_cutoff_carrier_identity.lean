/--
Dual hostile model for the normalized cutoff-payment subcase.  If the same
active-scale cutoff normalization is present but the affine surplus fraction is
larger than the cutoff constant, then selected ownership alone has not paid the
invoice.  The parameter `theta` records the strict-fraction slack chosen before
payoff.
-/
structure ParabolicCutoffInvoiceUnderpaidLeakModel where
  localJet : LocalAffineTraceZeroPositiveStretchingJet
  cutoffInvoice : Real
  totalInvoice : Real
  cutoffConstant : Real
  theta : Real
  theta_nonneg : 0 <= theta
  theta_lt_one : theta < 1
  cutoffConstant_le_theta_eta : cutoffConstant <= theta * localJet.eta
  cutoffInvoice_eq : cutoffInvoice = cutoffConstant * localJet.A
  totalInvoice_eq_cutoffInvoice : totalInvoice = cutoffInvoice
  parabolicActiveScaleOwnerStream : Prop
  parabolicActiveScaleOwnerStream_proof : parabolicActiveScaleOwnerStream
  finiteEnergyHighPiRegime : Prop
  finiteEnergyHighPiRegime_proof : finiteEnergyHighPiRegime
  cutoffLerayPressureNoReuseInvoicesOnSameTent : Prop
  cutoffLerayPressureNoReuseInvoicesOnSameTent_proof :
    cutoffLerayPressureNoReuseInvoicesOnSameTent
  sourceContractAlignedToAffineTent : Prop
  sourceContractAlignedToAffineTent_proof : sourceContractAlignedToAffineTent

/--
The underpaid normalized cutoff model realizes the strict-fraction scaling leak.
This is the formal version of the adversarial packet: ownership and cutoff
normalization do not imply payment unless the numeric `eta <= c_cut` line is
also supplied.
-/
noncomputable def LocalizedC7TentScalingLeakCertificate.ofCutoffUnderpaidModel
    (h : ParabolicCutoffInvoiceUnderpaidLeakModel) :
    LocalizedC7TentScalingLeakCertificate where
  localJet := h.localJet
  cutoffInvoice := h.cutoffInvoice
  lerayProjectionInvoice := 0
  pressureTailInvoice := 0
  noReuseInvoice := 0
  totalInvoice := h.totalInvoice
  surplus := h.localJet.eta * h.localJet.A
  theta := h.theta
  theta_nonneg := h.theta_nonneg
  theta_lt_one := h.theta_lt_one
  totalInvoice_eq := by
    rw [h.totalInvoice_eq_cutoffInvoice]
    ring
  surplus_eq := rfl
  totalInvoice_le_theta_surplus := by
    have hA_nonneg : 0 <= h.localJet.A := le_of_lt h.localJet.A_pos
    have hcut_le_theta :
        h.cutoffConstant * h.localJet.A <=
          (h.theta * h.localJet.eta) * h.localJet.A :=
      mul_le_mul_of_nonneg_right h.cutoffConstant_le_theta_eta hA_nonneg
    have htotal_le_cut : h.totalInvoice <= h.cutoffConstant * h.localJet.A := by
      rw [h.totalInvoice_eq_cutoffInvoice, h.cutoffInvoice_eq]
    calc
      h.totalInvoice <= h.cutoffConstant * h.localJet.A := htotal_le_cut
      _ <= (h.theta * h.localJet.eta) * h.localJet.A := hcut_le_theta
      _ = h.theta * (h.localJet.eta * h.localJet.A) := by ring
  finiteEnergyHighPiRegime := h.finiteEnergyHighPiRegime
  finiteEnergyHighPiRegime_proof := h.finiteEnergyHighPiRegime_proof
  cutoffLerayPressureNoReuseInvoicesOnSameTent :=
    h.cutoffLerayPressureNoReuseInvoicesOnSameTent
  cutoffLerayPressureNoReuseInvoicesOnSameTent_proof :=
    h.cutoffLerayPressureNoReuseInvoicesOnSameTent_proof
  sourceContractAlignedToAffineTent := h.sourceContractAlignedToAffineTent
  sourceContractAlignedToAffineTent_proof :=
    h.sourceContractAlignedToAffineTent_proof

/--
The normalized cutoff-payment model directly excludes a strict-fraction scaling
leak on the same localized affine tent.  This is the adversarial payoff of the
small positive subcase.
-/
theorem no_LocalizedC7TentScalingLeakCertificate_of_parabolicCutoffInvoicePaysAffineSurplusModel
    (hLeak : LocalizedC7TentScalingLeakCertificate)
    (hModel : ParabolicCutoffInvoicePaysAffineSurplusModel)
    (hSameJet : hModel.localJet = hLeak.localJet)
    (hSameInvoice : hModel.totalInvoice = hLeak.totalInvoice)
    (hSameSurplus : hModel.localJet.eta * hModel.localJet.A = hLeak.surplus) :
    False := by
  let hLower :=
    ParabolicFiniteEnergyInvoiceLowerBoundForLocalizedAffineTent.ofCutoffModel
      hModel
  exact no_LocalizedC7TentScalingLeakCertificate_of_parabolicFiniteEnergyInvoiceLowerBound
    hLeak hLower hSameJet hSameInvoice hSameSurplus

/--
The cutoff-payment model and the underpaid cutoff leak are mutually exclusive
when they name the same localized affine jet and total invoice.
-/
theorem no_ParabolicCutoffInvoicePaysAffineSurplusModel_of_underpaidLeak
    (hLeak : ParabolicCutoffInvoiceUnderpaidLeakModel)
    (hModel : ParabolicCutoffInvoicePaysAffineSurplusModel)
    (hSameJet : hModel.localJet = hLeak.localJet)
    (hSameInvoice : hModel.totalInvoice = hLeak.totalInvoice) :
    False := by
  have hSameSurplus :
      hModel.localJet.eta * hModel.localJet.A =
        (LocalizedC7TentScalingLeakCertificate.ofCutoffUnderpaidModel hLeak).surplus := by
    simp [LocalizedC7TentScalingLeakCertificate.ofCutoffUnderpaidModel, hSameJet]
  exact no_LocalizedC7TentScalingLeakCertificate_of_parabolicCutoffInvoicePaysAffineSurplusModel
    (LocalizedC7TentScalingLeakCertificate.ofCutoffUnderpaidModel hLeak)
    hModel hSameJet hSameInvoice hSameSurplus

/--
