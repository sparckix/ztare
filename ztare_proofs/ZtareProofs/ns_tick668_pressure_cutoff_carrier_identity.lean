      _ = h.visibleBoundaryMeasure (h.highInterfaceEventSet n) +
          h.residualReserveMeasure (h.highInterfaceEventSet n) :=
        h.highInterfaceBoundaryCharge_eq_visible_plus_residual n hnHigh
  selectedAbsoluteVariation_eq_selectedDefectActive :=
