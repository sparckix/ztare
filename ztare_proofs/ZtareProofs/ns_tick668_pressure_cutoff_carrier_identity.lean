      (∀ K, (Finset.range K).sum costSeq ≤ multiplicityConst * atomBudget)
      ∨ ((∀ n, costSeq n ≤ reserveSeq n - reserveSeq (n + 1) + repairSeq n + errorSeq n)
          ∧ ∀ K, reserveSeq 0 + (Finset.range K).sum repairSeq
                  + (Finset.range K).sum errorSeq ≤ reserveBudgetBound)

