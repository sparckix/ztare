    (h : SizeSumCorrelatedCoareaHighLowSliceSource)
    (hdisjointUpper :
      h.lowBoundarySetMeasure + h.highInterfaceSetMeasure <= h.thresholdSpaceMeasure) :
    False := by
  exact thresholdSet_sizeSum_forces_intersection
    h.lowPlusHighMeasure_gt_thresholdSpaceMeasure hdisjointUpper


/--
Lower-bound arithmetic feeding the size-sum source.  If separate certified lower
bounds for the cheap-boundary set and high-interface set already overfill the
threshold space, then the actual set measures also overfill it.
-/
theorem lowerBounds_force_threshold_size_sum_surplus
    {thresholdSpaceMeasure lowBoundarySetMeasure highInterfaceSetMeasure : Real}
    {cheapBoundaryMeasureLowerBound highInterfaceMeasureLowerBound : Real}
    (hlow : cheapBoundaryMeasureLowerBound <= lowBoundarySetMeasure)
    (hhigh : highInterfaceMeasureLowerBound <= highInterfaceSetMeasure)
    (hsurplus :
      thresholdSpaceMeasure < cheapBoundaryMeasureLowerBound + highInterfaceMeasureLowerBound) :
    thresholdSpaceMeasure < lowBoundarySetMeasure + highInterfaceSetMeasure := by
  linarith

/--
Markov/Paley-Zygmund style sufficient source for the high-low size sum.  The
names record the intended PDE route: coarea/Markov supplies a lower bound on
cheap-boundary thresholds, while a second-moment/anti-concentration receipt
supplies a lower bound on high-interface thresholds.  The arithmetic then only
checks that the two lower bounds strictly overfill the threshold space.
-/
structure MarkovPaleyZygmundSizeSumCoareaSource extends
    SizeSumCorrelatedCoareaHighLowSliceSource where
  cheapBoundaryMeasureLowerBound : Real
  cheapBoundaryMeasureLowerBound_nonneg : 0 <= cheapBoundaryMeasureLowerBound
  highInterfaceMeasureLowerBound : Real
  highInterfaceMeasureLowerBound_nonneg : 0 <= highInterfaceMeasureLowerBound
  cheapBoundaryMeasureLowerBound_le_lowBoundarySetMeasure :
    cheapBoundaryMeasureLowerBound <= lowBoundarySetMeasure
  highInterfaceMeasureLowerBound_le_highInterfaceSetMeasure :
    highInterfaceMeasureLowerBound <= highInterfaceSetMeasure
  lowerBoundsOverfillThresholdSpace :
    thresholdSpaceMeasure < cheapBoundaryMeasureLowerBound + highInterfaceMeasureLowerBound
  cheapBoundaryLowerBoundFromMarkovCoareaAverage : Prop
  cheapBoundaryLowerBoundFromMarkovCoareaAverage_proof :
    cheapBoundaryLowerBoundFromMarkovCoareaAverage
  highInterfaceLowerBoundFromPaleyZygmund : Prop
  highInterfaceLowerBoundFromPaleyZygmund_proof :
    highInterfaceLowerBoundFromPaleyZygmund
  interfaceSecondMomentReceipt : Prop
  interfaceSecondMomentReceipt_proof : interfaceSecondMomentReceipt
  paleyZygmundThresholdFixedBeforePayoff : Prop
  paleyZygmundThresholdFixedBeforePayoff_proof :
    paleyZygmundThresholdFixedBeforePayoff

/-- The Markov/PZ source supplies the size-sum source. -/
def SizeSumCorrelatedCoareaHighLowSliceSource.ofMarkovPaleyZygmund
    (h : MarkovPaleyZygmundSizeSumCoareaSource) :
    SizeSumCorrelatedCoareaHighLowSliceSource :=
  h.toSizeSumCorrelatedCoareaHighLowSliceSource

/-- The Markov/PZ lower bounds reproduce the strict size-sum surplus. -/
theorem MarkovPaleyZygmundSizeSumCoareaSource.thresholdSpaceMeasure_lt_actualMeasureSum
    (h : MarkovPaleyZygmundSizeSumCoareaSource) :
    h.thresholdSpaceMeasure < h.lowBoundarySetMeasure + h.highInterfaceSetMeasure := by
  exact lowerBounds_force_threshold_size_sum_surplus
    h.cheapBoundaryMeasureLowerBound_le_lowBoundarySetMeasure
    h.highInterfaceMeasureLowerBound_le_highInterfaceSetMeasure
    h.lowerBoundsOverfillThresholdSpace


/--
Anti-amnesia boundary for the high-interface second-moment route.  A second
moment receipt counts as new for this coarea/interface branch only if it is on
the same threshold family and pays the high-interface set before payoff; a
borrowed selected-tent or strict-tail anti-concentration label without that
identity is the old basin again.
-/
structure HighInterfaceSecondMomentKnownBasinBoundary extends
    PreprojectionProjectedCollarExchangeSource where
  thresholdSpaceMeasure : Real
  lowBoundarySetMeasure : Real
  highInterfaceSetMeasure : Real
  lowPlusHighMeasure_le_thresholdSpaceMeasure :
    lowBoundarySetMeasure + highInterfaceSetMeasure <= thresholdSpaceMeasure
  borrowedSelectedTentAntiConcentrationLabel : Prop
  borrowedSelectedTentAntiConcentrationLabel_proof :
    borrowedSelectedTentAntiConcentrationLabel
  sameThresholdFamilySecondMomentMissing : Prop
  sameThresholdFamilySecondMomentMissing_proof :
    sameThresholdFamilySecondMomentMissing
  strictTailOrSparseHighHighBasinRecurrence : Prop
  strictTailOrSparseHighHighBasinRecurrence_proof :
    strictTailOrSparseHighHighBasinRecurrence
  notANewCoareaInterfaceSecondMomentReceipt : Prop
  notANewCoareaInterfaceSecondMomentReceipt_proof :
    notANewCoareaInterfaceSecondMomentReceipt

/-- Borrowing the old anti-concentration label without same-threshold identity blocks the source. -/
theorem no_MarkovPaleyZygmundSizeSumCoareaSource_of_knownBasinBoundary
    (c : HighInterfaceSecondMomentKnownBasinBoundary)
    (h : MarkovPaleyZygmundSizeSumCoareaSource)
    (sameThresholdSpaceMeasure : h.thresholdSpaceMeasure = c.thresholdSpaceMeasure)
    (sameLowBoundarySetMeasure : h.lowBoundarySetMeasure = c.lowBoundarySetMeasure)
    (sameHighInterfaceSetMeasure : h.highInterfaceSetMeasure = c.highInterfaceSetMeasure) :
    False := by
  have hsurplus := h.thresholdSpaceMeasure_lt_actualMeasureSum
  rw [sameThresholdSpaceMeasure, sameLowBoundarySetMeasure,
    sameHighInterfaceSetMeasure] at hsurplus
  linarith [hsurplus, c.lowPlusHighMeasure_le_thresholdSpaceMeasure]


/--
Threshold spike second-moment arithmetic.  A payment concentrated on an `eps`
portion of threshold space has first moment `eps * amp` and second moment
`eps * amp^2`; hence `second * eps = first^2`.  For fixed first moment and
small support, the second moment must grow, exactly the Paley-Zygmund debt.
-/
theorem thresholdSpike_secondMoment_identity
    {eps amp firstMoment secondMoment : Real}
    (hfirst : firstMoment = eps * amp)
    (hsecond : secondMoment = eps * amp ^ 2) :
    secondMoment * eps = firstMoment ^ 2 := by
  rw [hfirst, hsecond]
  ring

/--
Concentrated threshold-spike packet for the high-interface measure.  It records
the obstruction that first-moment/layer-cake data alone can be concentrated on a
small threshold set, making the second moment too large for a Paley-Zygmund
high-set lower bound.
-/
structure InterfaceSecondMomentConcentrationSpikePacket extends
    PreprojectionProjectedCollarExchangeSource where
  thresholdSupportMeasure : Real
  thresholdSupportMeasure_nonneg : 0 <= thresholdSupportMeasure
  interfaceSpikeAmplitude : Real
  interfaceFirstMoment : Real
  interfaceSecondMoment : Real
  interfaceFirstMoment_eq_support_mul_amplitude :
    interfaceFirstMoment = thresholdSupportMeasure * interfaceSpikeAmplitude
  interfaceSecondMoment_eq_support_mul_amplitude_sq :
    interfaceSecondMoment = thresholdSupportMeasure * interfaceSpikeAmplitude ^ 2
  thresholdSpaceMeasure : Real
  lowBoundarySetMeasure : Real
  highInterfaceSetMeasure : Real
  lowPlusHighMeasure_le_thresholdSpaceMeasure :
    lowBoundarySetMeasure + highInterfaceSetMeasure <= thresholdSpaceMeasure
  cheapBoundaryLowerBoundAvailable : Prop
  cheapBoundaryLowerBoundAvailable_proof : cheapBoundaryLowerBoundAvailable
  layerCakeFirstMomentAvailable : Prop
  layerCakeFirstMomentAvailable_proof : layerCakeFirstMomentAvailable
  interfaceSecondMomentTooLargeForPZ : Prop
  interfaceSecondMomentTooLargeForPZ_proof : interfaceSecondMomentTooLargeForPZ
  highInterfaceAntiConcentrationMissing : Prop
  highInterfaceAntiConcentrationMissing_proof :
    highInterfaceAntiConcentrationMissing

/-- The spike identity holds inside the concentrated-threshold packet. -/
theorem InterfaceSecondMomentConcentrationSpikePacket.secondMoment_times_support_eq_firstMoment_sq
    (c : InterfaceSecondMomentConcentrationSpikePacket) :
    c.interfaceSecondMoment * c.thresholdSupportMeasure = c.interfaceFirstMoment ^ 2 := by
  exact thresholdSpike_secondMoment_identity
    c.interfaceFirstMoment_eq_support_mul_amplitude
    c.interfaceSecondMoment_eq_support_mul_amplitude_sq

/-- A concentrated high-interface spike blocks the Markov/PZ size-sum source. -/
theorem no_MarkovPaleyZygmundSizeSumCoareaSource_of_interfaceSpike
    (c : InterfaceSecondMomentConcentrationSpikePacket)
    (h : MarkovPaleyZygmundSizeSumCoareaSource)
    (sameThresholdSpaceMeasure : h.thresholdSpaceMeasure = c.thresholdSpaceMeasure)
    (sameLowBoundarySetMeasure : h.lowBoundarySetMeasure = c.lowBoundarySetMeasure)
    (sameHighInterfaceSetMeasure : h.highInterfaceSetMeasure = c.highInterfaceSetMeasure) :
    False := by
  have hsurplus := h.thresholdSpaceMeasure_lt_actualMeasureSum
  rw [sameThresholdSpaceMeasure, sameLowBoundarySetMeasure,
    sameHighInterfaceSetMeasure] at hsurplus
  linarith [hsurplus, c.lowPlusHighMeasure_le_thresholdSpaceMeasure]


/--
Amplitude-cap anti-spike arithmetic.  A fixed pre-payoff cap on the threshold
interface payment turns first-moment mass into a support lower bound.  This is
the deterministic substitute for a generic Paley-Zygmund slogan: without the
cap, a threshold spike can keep the same first moment on arbitrarily small
support.
-/
theorem amplitudeCap_firstMoment_forces_highInterface_lowerBound
    {highInterfaceMeasureLowerBound interfaceAmplitudeCap
      interfaceFirstMomentLowerBound interfaceFirstMoment highInterfaceSetMeasure : Real}
    (hcap_pos : 0 < interfaceAmplitudeCap)
    (hlb_cap : highInterfaceMeasureLowerBound * interfaceAmplitudeCap <=
      interfaceFirstMomentLowerBound)
    (hlb_first : interfaceFirstMomentLowerBound <= interfaceFirstMoment)
    (hfirst_cap : interfaceFirstMoment <=
      interfaceAmplitudeCap * highInterfaceSetMeasure) :
    highInterfaceMeasureLowerBound <= highInterfaceSetMeasure := by
  have hmul : highInterfaceMeasureLowerBound * interfaceAmplitudeCap <=
      highInterfaceSetMeasure * interfaceAmplitudeCap := by
    linarith
  exact le_of_mul_le_mul_right hmul hcap_pos

/--
Fixed-profile amplitude-cap source for the high-interface threshold set.  It is
