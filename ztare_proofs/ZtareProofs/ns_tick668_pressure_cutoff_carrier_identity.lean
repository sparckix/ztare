    boundaryPaidMeasureLowerBound * ratioSecondMomentCap <= ratioFirstMomentSq
  ratioFirstMomentSq_le_secondMomentCap_mul_boundaryPaidSetMeasure :
    ratioFirstMomentSq <= ratioSecondMomentCap * boundaryPaidSetMeasure
  lowerBoundPlusHighInterfaceOverfillsThreshold :
    thresholdSpaceMeasure < boundaryPaidMeasureLowerBound + highInterfaceFloorSetMeasure
  ratioLawBoundToSameSourceInterfaceLaw : Prop
  ratioLawBoundToSameSourceInterfaceLaw_proof :
    ratioLawBoundToSameSourceInterfaceLaw
  ratioSecondMomentCapSamePrefix : Prop
  ratioSecondMomentCapSamePrefix_proof : ratioSecondMomentCapSamePrefix
  ratioMassNotCarriedByLowInterfaceSurplus : Prop
  ratioMassNotCarriedByLowInterfaceSurplus_proof :
    ratioMassNotCarriedByLowInterfaceSurplus

