  paleyZygmundThresholdFixedBeforePayoff := h.amplitudeCapFixedBeforePayoff
  paleyZygmundThresholdFixedBeforePayoff_proof := h.amplitudeCapFixedBeforePayoff_proof



/--
Second-moment anti-spike arithmetic.  A same-prefix second-moment cap converts a
first-moment lower bound into support.  This is the Cauchy/Paley-Zygmund core,
made explicit so that a proxy or global second moment cannot be silently spent.
-/
theorem secondMomentCap_firstMoment_forces_highInterface_lowerBound
    {highInterfaceMeasureLowerBound interfaceSecondMomentCap
      interfaceFirstMomentLowerBound highInterfaceSetMeasure : Real}
    (hcap_pos : 0 < interfaceSecondMomentCap)
    (hlb_cap : highInterfaceMeasureLowerBound * interfaceSecondMomentCap <=
      interfaceFirstMomentLowerBound ^ 2)
    (hfirst_second : interfaceFirstMomentLowerBound ^ 2 <=
      interfaceSecondMomentCap * highInterfaceSetMeasure) :
    highInterfaceMeasureLowerBound <= highInterfaceSetMeasure := by
  have hmul : highInterfaceMeasureLowerBound * interfaceSecondMomentCap <=
      highInterfaceSetMeasure * interfaceSecondMomentCap := by
    linarith
  exact le_of_mul_le_mul_right hmul hcap_pos

/--
Same-prefix second-moment cap source.  This is the non-L∞ version of the
anti-spike constructor: the high-interface support lower bound comes from a
second-moment cap on the same threshold/interface prefix, not from a generic
anti-concentration label or a global energy proxy.
-/
structure SamePrefixInterfaceSecondMomentCapSizeSumSource extends
    SizeSumCorrelatedCoareaHighLowSliceSource where
  cheapBoundaryMeasureLowerBound : Real
  cheapBoundaryMeasureLowerBound_nonneg : 0 <= cheapBoundaryMeasureLowerBound
  highInterfaceMeasureLowerBound : Real
  highInterfaceMeasureLowerBound_nonneg : 0 <= highInterfaceMeasureLowerBound
  cheapBoundaryMeasureLowerBound_le_lowBoundarySetMeasure :
    cheapBoundaryMeasureLowerBound <= lowBoundarySetMeasure
  lowerBoundsOverfillThresholdSpace :
    thresholdSpaceMeasure < cheapBoundaryMeasureLowerBound + highInterfaceMeasureLowerBound
  interfaceFirstMomentLowerBound : Real
  interfaceFirstMomentLowerBound_nonneg : 0 <= interfaceFirstMomentLowerBound
  interfaceSecondMomentCap : Real
  interfaceSecondMomentCap_pos : 0 < interfaceSecondMomentCap
  highInterfaceLowerBound_mul_secondMomentCap_le_firstMomentSq :
    highInterfaceMeasureLowerBound * interfaceSecondMomentCap <=
      interfaceFirstMomentLowerBound ^ 2
