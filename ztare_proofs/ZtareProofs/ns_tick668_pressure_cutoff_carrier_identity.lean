    simpa [hSelectedSame] using
      h.selectedHH_eq_or_le_stateSignedProduction_proof
  have hproof := hConfuser.selectedHHFunctionalBindingMissing_proof
  rw [hmissing] at hproof
  exact hproof

/--
The same-carrier cutoff invoice remains a separate spend channel; a dual-price
pressure-frame receipt alone cannot pay it.
-/
theorem no_PressureFramePaysSelectedHHOnQuotientCarrier_of_bareDualPriceCutoffMismatch
    {carrier : QuotientMinimalTransactionCarrier}
    (hConfuser : BareDualPricePressureFrameWithoutCarrierBindingConfuser carrier)
    (h : PressureFramePaysSelectedHHOnQuotientCarrier carrier)
    (hCutoffSame :
      h.cutoffInvoicePaidOnSameCarrier =
        (hConfuser.sameCarrierCutoffInvoiceMissing = False)) :
    False := by
  have hmissing :
      hConfuser.sameCarrierCutoffInvoiceMissing = False := by
    simpa [hCutoffSame] using h.cutoffInvoicePaidOnSameCarrier_proof
  have hproof := hConfuser.sameCarrierCutoffInvoiceMissing_proof
  rw [hmissing] at hproof
  exact hproof

/--
Confuser for Level366: pressure/source visibility plus finite-frame vocabulary
