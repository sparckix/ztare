/--
Rank-one scalar functional defect.  A single scalar pressure/Riesz functional
can vanish on a nonzero trace-free tensor direction, so it cannot identify
trace-free tensor total variation without an extra coercivity or full-frame
identity theorem.
-/
structure TraceFreeRankOneScalarFunctionalDefectConfuser where
  scalarFunctionalPay : Nat → Real
  traceFreeTotalVariationPay : Nat → Real
  N : Nat
  scalarFunctionalPrefixZero :
    nsTick668FinitePrefixSum scalarFunctionalPay N = 0
  traceFreeVariationPrefixPositive :
    0 < nsTick668FinitePrefixSum traceFreeTotalVariationPay N
  traceFreeTensorSpaceDimensionFive : Prop
  traceFreeTensorSpaceDimensionFive_proof :
    traceFreeTensorSpaceDimensionFive
  scalarFunctionalRankOne : Prop
  scalarFunctionalRankOne_proof : scalarFunctionalRankOne
  nonzeroTraceFreeTensorInScalarKernel : Prop
  nonzeroTraceFreeTensorInScalarKernel_proof :
    nonzeroTraceFreeTensorInScalarKernel
  dimensionCompatibilityDoesNotPayTensorIdentity : Prop
  dimensionCompatibilityDoesNotPayTensorIdentity_proof :
    dimensionCompatibilityDoesNotPayTensorIdentity

/--
The route1 annular output identity receipt cannot be discharged by a rank-one
scalar functional with nonzero trace-free tensor kernel.
-/
theorem no_Route1AnnularOutputEventStreamIdentityReceipt_of_rankOneScalarFunctionalDefect
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hConfuser : TraceFreeRankOneScalarFunctionalDefectConfuser)
    (hIdentity : Route1AnnularOutputEventStreamIdentityReceipt formula)
    (hSameEventRadius :
      hIdentity.eventRadiusPayment = hConfuser.scalarFunctionalPay)
    (hSameTraceFreeOutput :
      hIdentity.projectedTracefreeAnnularOutputVariation =
        hConfuser.traceFreeTotalVariationPay) :
    False := by
  have hStream :
      hConfuser.traceFreeTotalVariationPay =
        hConfuser.scalarFunctionalPay := by
    funext n
    calc
      hConfuser.traceFreeTotalVariationPay n =
          hIdentity.projectedTracefreeAnnularOutputVariation n := by
        rw [hSameTraceFreeOutput]
      _ = hIdentity.eventRadiusPayment n := by
        exact (hIdentity.eventRadiusPayment_eq_projectedTracefreeAnnularOutputVariation n).symm
      _ = hConfuser.scalarFunctionalPay n := by
        rw [hSameEventRadius]
  have hPos := hConfuser.traceFreeVariationPrefixPositive
  rw [hStream, hConfuser.scalarFunctionalPrefixZero] at hPos
  exact (lt_irrefl (0 : Real)) hPos

/--
The source-side route1 packet certificate is also impossible when the proposed
source stream is only a rank-one scalar functional with a nonzero trace-free
tensor kernel.  The proof deliberately factors through the downstream identity
consumer: this theorem does not prove PDE content, it pins the required source
certificate to the same scalar-to-tensor obstruction.
-/
theorem no_Route1AnnularOutputPacketTracefreeIdentitySource_of_rankOneScalarFunctionalDefect
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hConfuser : TraceFreeRankOneScalarFunctionalDefectConfuser)
    (hSource : Route1AnnularOutputPacketTracefreeIdentitySource formula)
    (hSameEventRadius :
      hSource.eventRadiusPayment = hConfuser.scalarFunctionalPay)
    (hSameTraceFreeOutput :
      hSource.projectedTracefreeAnnularOutputVariation =
        hConfuser.traceFreeTotalVariationPay) :
    False :=
  no_Route1AnnularOutputEventStreamIdentityReceipt_of_rankOneScalarFunctionalDefect
    hConfuser
    (Route1AnnularOutputEventStreamIdentityReceipt.ofPacketTracefreeIdentitySource
      hSource)
    hSameEventRadius
    hSameTraceFreeOutput

