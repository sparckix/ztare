  pointwiseThresholdCharge_le_ownerBudget :
    ∀ n : Nat, thresholdCollarCharge n <= ownerCollarBudget (thresholdOwner n)
  selectedPrefixOwnerCollarBudget :
    ∀ N : Nat,
