/--
Concrete normalized diagonal eigencone bound.  For the trace-zero strain
`diag(2,-1,-1)`, the radial quadratic form on a direction with
`cosSq = n_1^2` is `3 * cosSq - 1`.  The fixed cone `cosSq >= 5/6` pays a
raw cone fraction at least `1/2`.  This is the arithmetic core of the angular
loss that the source below must pay before projection.
-/
theorem normalizedTraceZeroDiagonalEigencone_radialStrain_ge_half
    {cosSq : Real} (hcos : (5 / 6 : Real) <= cosSq) :
    (1 / 2 : Real) <= 3 * cosSq - 1 := by
  linarith

/--
Trace-zero eigenvalue arithmetic: if `lam + mu + nu = 0` and the remaining
eigenvalue `nu` is at most the selected maximum `lam`, then the transverse
eigenvalue `mu` is no worse than `-2 * lam`.
-/
theorem traceZeroEigenvalue_transverse_ge_neg_two_max
    {lam mu nu : Real}
    (htrace : lam + mu + nu = 0)
    (hnu_le_lam : nu <= lam) :
    -2 * lam <= mu := by
  linarith

/--
General one-transverse-direction version of the same cone calculation.  If the
positive eigenvalue is `lam` and the transverse contribution is no worse than
`-2 * lam`, then the cone `cosSq >= 5/6` still pays at least half of `lam`.
This is the finite-dimensional eigenframe transfer target for a trace-zero
symmetric strain after diagonalization.
-/
theorem traceZeroEigencone_radialStrain_ge_half_posEigen
    {lam mu cosSq : Real}
    (hlam : 0 <= lam)
    (hmu : -2 * lam <= mu)
    (hcos : (5 / 6 : Real) <= cosSq)
    (hcos_le : cosSq <= 1) :
    (1 / 2 : Real) * lam <= lam * cosSq + mu * (1 - cosSq) := by
  have hnonneg : 0 <= 1 - cosSq := by
    linarith
  have hmu_mul : (-2 * lam) * (1 - cosSq) <= mu * (1 - cosSq) := by
    exact mul_le_mul_of_nonneg_right hmu hnonneg
  have hbase :
      (1 / 2 : Real) * lam <= lam * cosSq + (-2 * lam) * (1 - cosSq) := by
    nlinarith [hlam, hcos]
  linarith

/--
Combined trace-zero eigencone lower bound.  This packages the finite-dimensional
part that the PDE/localized-affine source should consume: trace zero and
max-eigenvalue ordering give the transverse bound, then cone inclusion gives a
fixed half-eigenvalue radial lower bound.
-/
theorem traceZeroMaxEigencone_radialStrain_ge_half
    {lam mu nu cosSq : Real}
    (hlam : 0 <= lam)
    (htrace : lam + mu + nu = 0)
    (hnu_le_lam : nu <= lam)
    (hcos : (5 / 6 : Real) <= cosSq)
    (hcos_le : cosSq <= 1) :
    (1 / 2 : Real) * lam <= lam * cosSq + mu * (1 - cosSq) := by
  exact traceZeroEigencone_radialStrain_ge_half_posEigen hlam
    (traceZeroEigenvalue_transverse_ge_neg_two_max htrace hnu_le_lam)
    hcos hcos_le

/--
Positive source for the affine eigencone calculation.  Raw cone variation pays
only a fixed geometric fraction, so the cone loss must be paid before the
selected measure is projected back as full Reynolds-excess currency.
-/
structure AffinePositiveEigenconeLossPaidInterfaceVariationSource extends
    SelectedSectionExtensionalInterfaceVariationMeasureSource where
  coneConstant : Real
  coneConstant_pos : 0 < coneConstant
  rawConeInterfaceVariation : Real
  rawConeInterfaceVariation_nonneg : 0 <= rawConeInterfaceVariation
  coneNormalizedSelectedVariation : Real
  positiveEigenconeFixedBeforePayoff : Prop
