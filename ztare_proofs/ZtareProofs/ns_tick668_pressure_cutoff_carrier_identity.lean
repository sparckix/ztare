    AnalyticCollarExceptionDebitRetypingSource Ω where
  localizedSource := h.retypingSource.localizedSource
  collarSource := h.retypingSource.collarSource
  exceptionDebitPrefixDominatedByAnalyticCollar := by
    intro K
    have hAtoms := h.exceptionDebitSeqPrefixMatchesAtoms K
    have hPointwise :
        (Finset.range K).sum h.exceptionAtomDebit ≤
          (Finset.range K).sum (fun n =>
            h.heatCollarAtomMass (h.exceptionToHeatCollarAtom n)) := by
      exact Finset.sum_le_sum (fun n _ =>
        h.pointwiseExceptionDebitDominatedByCollarMass n)
    have hMult := h.collarPreimageMultiplicityControlsPrefix K
    exact le_trans hAtoms (le_trans hPointwise hMult)
  analyticCollarFitsExceptionBudget := h.collarWeightFitsExceptionBudget
  sameSelectedStreamRetyping := h.retypingSource.sameSelectedStreamRetyping
  sameSelectedStreamRetyping_proof := h.retypingSource.sameSelectedStreamRetyping_proof
  retypingFixedBeforePayoff := h.injectionFixedBeforePayoff
  retypingFixedBeforePayoff_proof := h.injectionFixedBeforePayoff_proof
  noTargetDefinedExceptionDebitRetyping :=
    h.retypingSource.noTargetDefinedExceptionDebitRetyping
  noTargetDefinedExceptionDebitRetyping_proof :=
    h.retypingSource.noTargetDefinedExceptionDebitRetyping_proof
  noHiddenNoNullOrCZEndpointInput := h.noHiddenNoNullOrEndpointPositivity
  noHiddenNoNullOrCZEndpointInput_proof :=
    h.noHiddenNoNullOrEndpointPositivity_proof

