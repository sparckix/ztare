    SelectedInterfaceVariationCoareaOverlapLowerPaymentSource where
  thresholdBoundaryCharge : Nat → Real
  thresholdInterfacePayment : Nat → Real
  selectedCorrelationThresholdIndex : Nat
  boundaryCostCap : Real
  boundaryCostCap_nonneg : 0 <= boundaryCostCap
  interfacePaymentFloor : Real
  interfacePaymentFloor_nonneg : 0 <= interfacePaymentFloor
  selectedBoundaryCharge_eq_coareaCollarCharge :
    thresholdBoundaryCharge selectedCorrelationThresholdIndex = coareaCollarCharge
  selectedInterfacePayment_eq_interfaceVariationMeasure :
    thresholdInterfacePayment selectedCorrelationThresholdIndex =
      interfaceVariationMeasure
  selectedThresholdBoundaryCheap :
    thresholdBoundaryCharge selectedCorrelationThresholdIndex <= boundaryCostCap
  selectedThresholdInterfaceHigh :
    interfacePaymentFloor <= thresholdInterfacePayment selectedCorrelationThresholdIndex
  paidOverlapReserve_le_interfacePaymentFloor :
    paidOverlapReserve <= interfacePaymentFloor
  interfacePaymentFloor_le_selectedBoundaryCharge :
    interfacePaymentFloor <= thresholdBoundaryCharge selectedCorrelationThresholdIndex
  lowBoundarySetIntersectsHighInterfaceSet : Prop
  lowBoundarySetIntersectsHighInterfaceSet_proof :
    lowBoundarySetIntersectsHighInterfaceSet
  sameOwnerRootForBoundaryAndInterfaceSlice : Prop
  sameOwnerRootForBoundaryAndInterfaceSlice_proof :
    sameOwnerRootForBoundaryAndInterfaceSlice
  thresholdEventFixedBeforePayoff : Prop
  thresholdEventFixedBeforePayoff_proof : thresholdEventFixedBeforePayoff
  highLowCorrelationNotPostSelected : Prop
  highLowCorrelationNotPostSelected_proof : highLowCorrelationNotPostSelected

