theorem LEINativeSelectedTopologyBenignPressureNullTransactionSource.cost_prefix_eq_zero_on_pressureNull
    {Ω : Type u}
    (h : LEINativeSelectedTopologyBenignPressureNullTransactionSource Ω)
    {K : ℕ}
