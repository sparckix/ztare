  rcases hConfuser.fiveFramePrefixesExceedEveryFiniteRouteTailBudget
      (hReceipt.C * hConfuser.routeTailOwnerBudget) with ⟨N, hExceeds⟩
  have hExchange :
      nsTick668FinitePrefixSum hConfuser.fiveFrameAngularEventPay N ≤
