    (_hSameState : hReceipt.state = hConfuser.state)
    (hNoSheathSame :
      hReceipt.noSameWindowCoreSheathCancellationForL2Frame =
        (hConfuser.sameWindowCoreSheathCancellationStillAdmissible = False)) :
