/--
Pressure visibility plus a paid exception debit gives the same selected-prefix
budget as the no-null-lock route, without requiring pointwise transversality.
-/
theorem LEINativeSelectedTopologyPressureExceptionDebitCapacitySource.prefix_bound
    {Ω : Type u}
    (h : LEINativeSelectedTopologyPressureExceptionDebitCapacitySource Ω) :
    ∀ K, (Finset.range K).sum h.costSeq ≤ h.capacityBudget := by
  intro K
  have haccount := h.cleanVolumeAccountingForSelectedStream
  have hPollutionLeCapacity : h.Vpolluted ≤ h.Vtotal + h.Vcleaned := by
    unfold cleanVolumeAccounting at haccount
    linarith [h.cleanVolume_nonneg]
  have hPressurePollutes :
      h.κPressure * projectedPressureAbsSum h.P K ≤ h.Vpolluted := by
    exact h.pressureSequenceCreatesPollutionPrefix K
  have hMul :
      h.κCost * (Finset.range K).sum h.costSeq ≤
        h.κCost * h.capacityBudget := by
    linarith [h.pressurePlusExceptionControlsSelectedCostPrefix K,
      hPressurePollutes, h.exceptionDebitPrefixBudget K,
      hPollutionLeCapacity,
      h.finiteOrientationCapacityAndExceptionConvertedToBudget]
  exact le_of_mul_le_mul_left hMul h.κCost_pos

/--
A null-locked prefix is benign only after the transaction channel has already
been defined as pressure plus same-stream exception debit. If both projected
pressure and exception debit vanish on a prefix, the selected cost prefix cannot
remain positive.
-/
theorem LEINativeSelectedTopologyPressureExceptionDebitCapacitySource.cost_prefix_le_zero_of_pressureNull_exceptionZero
    {Ω : Type u}
    (h : LEINativeSelectedTopologyPressureExceptionDebitCapacitySource Ω)
    {K : ℕ}
    (hPzero : projectedPressureAbsSum h.P K = 0)
    (hEzero : (Finset.range K).sum h.exceptionDebitSeq = 0) :
    (Finset.range K).sum h.costSeq <= 0 := by
  have hcontrol := h.pressurePlusExceptionControlsSelectedCostPrefix K
  rw [hPzero, hEzero] at hcontrol
  have hMul : h.κCost * (Finset.range K).sum h.costSeq <= h.κCost * 0 := by
    linarith
  exact le_of_mul_le_mul_left hMul h.κCost_pos

