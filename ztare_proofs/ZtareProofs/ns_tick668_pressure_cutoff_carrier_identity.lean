  PSDTracePaysAnnularProjectedPacket := h.PSDTracePaysAnnularProjectedPacket
  PSDTracePaysAnnularProjectedPacket_proof :=
    h.PSDTracePaysAnnularProjectedPacket_proof
  cutoffCommutatorTailsPaidBySameStreamShardC :=
    h.cutoffCommutatorTailsPaidBySameStreamShardC
  cutoffCommutatorTailsPaidBySameStreamShardC_proof :=
    h.cutoffCommutatorTailsPaidBySameStreamShardC_proof
  selectedPSDTraceOwnerPrefixBudget :=
