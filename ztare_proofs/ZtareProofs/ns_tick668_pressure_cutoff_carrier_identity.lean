  thresholdFormulaBindingPaidByDefinition :
    ∀ n : Nat, n < restrictedSourceLawPrefixLength →
      thresholdInterfacePayment n = suitableDefectSource.muA (highInterfaceEventSet n)
  thresholdBoundaryFormulaBindingPaidByDefinition :
    ∀ n : Nat, n < restrictedSourceLawPrefixLength →
      thresholdBoundaryCharge n =
        visibleBoundaryMeasure (highInterfaceEventSet n) +
