/-- LEI-native selected defect-active payment is the selected active measure. -/
theorem LEINativeThresholdFormulaSelectedVariationSource.selectedAbs_eq_activeMeasure
    {Ω : Type u} (h : LEINativeThresholdFormulaSelectedVariationSource Ω) :
    h.selectedAbsoluteVariation =
      h.activeMeasure (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) := by
  calc
    h.selectedAbsoluteVariation =
        h.suitableDefectSource.muA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
      h.selectedAbsoluteVariation_eq_selectedDefectActive
    _ = h.activeMeasure (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
      (h.activeMeasure_eq_defectActive_on_H
        h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt).symm

/-- The LEI-native formula binding derives the threshold/H-prefix payment equality. -/
theorem LEINativeThresholdFormulaSelectedVariationSource.thresholdPayment_eq_highInterfacePayment_on_restrictedPrefix
    {Ω : Type u} (h : LEINativeThresholdFormulaSelectedVariationSource Ω) :
    ∀ n : Nat, n < h.restrictedSourceLawPrefixLength →
      h.thresholdInterfacePayment n = h.highInterfacePayment n := by
  intro n hn
  have hnHigh : n < h.highInterfacePrefixLength :=
    Nat.lt_of_lt_of_le hn h.restrictedPrefix_le_highInterfacePrefixLength
  calc
    h.thresholdInterfacePayment n =
        h.suitableDefectSource.muA (h.highInterfaceEventSet n) :=
      h.thresholdFormulaBindingPaidByDefinition n hn
    _ = h.activeMeasure (h.highInterfaceEventSet n) :=
      (h.activeMeasure_eq_defectActive_on_H n hnHigh).symm
    _ = h.highInterfacePayment n :=
      (h.highInterfacePayment_eq_activeMeasure n hnHigh).symm

/-- The LEI-native formula binding derives the threshold/H-prefix boundary equality. -/
theorem LEINativeThresholdFormulaSelectedVariationSource.thresholdBoundary_eq_highInterfaceBoundary_on_restrictedPrefix
    {Ω : Type u} (h : LEINativeThresholdFormulaSelectedVariationSource Ω) :
    ∀ n : Nat, n < h.restrictedSourceLawPrefixLength →
      h.thresholdBoundaryCharge n = h.highInterfaceBoundaryCharge n := by
  intro n hn
  have hnHigh : n < h.highInterfacePrefixLength :=
    Nat.lt_of_lt_of_le hn h.restrictedPrefix_le_highInterfacePrefixLength
  calc
    h.thresholdBoundaryCharge n =
        h.visibleBoundaryMeasure (h.highInterfaceEventSet n) +
          h.residualReserveMeasure (h.highInterfaceEventSet n) :=
      h.thresholdBoundaryFormulaBindingPaidByDefinition n hn
    _ = h.highInterfaceBoundaryCharge n :=
      (h.highInterfaceBoundaryCharge_eq_visible_plus_residual n hnHigh).symm

