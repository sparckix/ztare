/--
A same-owner Pi-lock budget bridge pays the Level411 numeric gap line.
-/
theorem ownerRootBudgetControlsLiftedGap_of_sameOwnerPiLockBudgetBridge
    (h : SameOwnerPiLockBudgetBridge) :
    h.liftedJet.eta * h.liftedJet.A <= h.ownerRootBudgetForGap := by
  have hInvoice :
      h.piLock.localJet.eta * h.piLock.localJet.A <= h.piLock.totalInvoice :=
    totalInvoice_ge_surplus_of_parabolicCutoffInvoicePaysAffineSurplusModel
      (ParabolicCutoffInvoicePaysAffineSurplusModel.ofPiLock h.piLock)
  have hLifted :
      h.liftedJet.eta * h.liftedJet.A <= h.piLock.totalInvoice := by
    rw [h.sameEtaAsPiLock, h.sameAAsPiLock]
    exact hInvoice
  exact le_trans hLifted h.totalInvoice_le_ownerRootBudget

