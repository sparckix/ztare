/--
A projection-tail unpaid packet blocks the projected collar exchange source for
matching preprojection and projected payment data.
-/
theorem no_PreprojectionProjectedCollarExchangeSource_of_projectionTailReserveUnpaid
    (c : ProjectionTailReserveUnpaidPacket)
    (h : PreprojectionProjectedCollarExchangeSource)
    (sameCoareaCharge : h.coareaCollarCharge = c.coareaCollarCharge)
    (sameProjectedPayment :
      h.projectedAngularBoundaryPayment = c.projectedAngularBoundaryPayment)
    (tailZero : h.projectionTailReserve = 0) : False := by
  have hle : h.projectedAngularBoundaryPayment <= h.coareaCollarCharge := by
    have hp := h.projectedPayment_le_preprojection_plus_tail
    rw [tailZero] at hp
    norm_num at hp
    exact hp
  rw [sameCoareaCharge, sameProjectedPayment] at hle
  linarith [hle, c.projectedPaymentExceedsPreprojectionCollarCharge]

