/--
Core source-backed H-prefix local-energy invoice.  This version does not assume
the measure-split domination field; it derives that field from the older
`SuitableLocalEnergyDefectMeasureSource` positive-variation domination once the
H-prefix measures are identified with the source pieces.
-/
structure SuitableDefectBackedHighInterfaceMeasureSplitCore (Ω : Type u)
    extends LocalEnergyInvoiceHighInterfaceDominanceSource where
  suitableDefectSource : SuitableLocalEnergyDefectMeasureSource Ω
  highInterfaceEventSet : Nat → Set Ω
  activeMeasure : Set Ω → Real
  visibleBoundaryMeasure : Set Ω → Real
  residualReserveMeasure : Set Ω → Real
  highInterfacePayment_eq_activeMeasure :
    ∀ n : Nat, n < highInterfacePrefixLength →
      highInterfacePayment n = activeMeasure (highInterfaceEventSet n)
  highInterfaceBoundaryCharge_eq_visible_plus_residual :
    ∀ n : Nat, n < highInterfacePrefixLength →
      highInterfaceBoundaryCharge n =
        visibleBoundaryMeasure (highInterfaceEventSet n) +
          residualReserveMeasure (highInterfaceEventSet n)
  activeMeasure_eq_defectActive_on_H :
    ∀ n : Nat, n < highInterfacePrefixLength →
      activeMeasure (highInterfaceEventSet n) =
        suitableDefectSource.muA (highInterfaceEventSet n)
  visibleBoundaryMeasure_eq_defectVisible_on_H :
    ∀ n : Nat, n < highInterfacePrefixLength →
      visibleBoundaryMeasure (highInterfaceEventSet n) =
        suitableDefectSource.muT (highInterfaceEventSet n) +
          suitableDefectSource.muQP (highInterfaceEventSet n) +
            suitableDefectSource.muC (highInterfaceEventSet n)
  residualReserveMeasure_eq_defectResidual_on_H :
    ∀ n : Nat, n < highInterfacePrefixLength →
      residualReserveMeasure (highInterfaceEventSet n) =
        suitableDefectSource.muI (highInterfaceEventSet n)
  measureSplitNotWholeSpaceScalarOnly : Prop
  measureSplitNotWholeSpaceScalarOnly_proof :
    measureSplitNotWholeSpaceScalarOnly
  residualReserveBackedBySuitableDefect : residualReserveIndependentlyGenerated
  noPostHocResidualBackedBySuitableDefect :
    residualReserveNotDefinedFromBoundaryDeficit

/-- Suitable-defect positive variation supplies the H-prefix measure domination. -/
theorem SuitableDefectBackedHighInterfaceMeasureSplitCore.domination_from_suitableDefect
    {Ω : Type u}
    (h : SuitableDefectBackedHighInterfaceMeasureSplitCore Ω)
    {n : Nat} (hn : n < h.highInterfacePrefixLength) :
    h.activeMeasure (h.highInterfaceEventSet n) <=
      h.visibleBoundaryMeasure (h.highInterfaceEventSet n) +
        h.residualReserveMeasure (h.highInterfaceEventSet n) := by
  have hdom := h.suitableDefectSource.positiveVariationDomination
    (h.highInterfaceEventSet n)
  rw [h.activeMeasure_eq_defectActive_on_H n hn,
    h.visibleBoundaryMeasure_eq_defectVisible_on_H n hn,
    h.residualReserveMeasure_eq_defectResidual_on_H n hn]
  linarith

/--
The core suitable-defect source constructs the Borel-local measure-split invoice
without assuming the domination field separately.
-/
def LocalEnergyMeasureSplitHighInterfaceInvoiceSource.ofSuitableDefectBackedCore
    {Ω : Type u}
    (h : SuitableDefectBackedHighInterfaceMeasureSplitCore Ω) :
    LocalEnergyMeasureSplitHighInterfaceInvoiceSource Ω where
  toLocalEnergyInvoiceHighInterfaceDominanceSource :=
    h.toLocalEnergyInvoiceHighInterfaceDominanceSource
  highInterfaceEventSet := h.highInterfaceEventSet
  activeMeasure := h.activeMeasure
  visibleBoundaryMeasure := h.visibleBoundaryMeasure
  residualReserveMeasure := h.residualReserveMeasure
  highInterfacePayment_eq_activeMeasure :=
    h.highInterfacePayment_eq_activeMeasure
  highInterfaceBoundaryCharge_eq_visible_plus_residual :=
    h.highInterfaceBoundaryCharge_eq_visible_plus_residual
  localEnergyMeasureDominationOnHighInterfacePrefix := by
    intro n hn
    exact h.domination_from_suitableDefect hn
  measureSplitNotWholeSpaceScalarOnly :=
    h.measureSplitNotWholeSpaceScalarOnly
  measureSplitNotWholeSpaceScalarOnly_proof :=
    h.measureSplitNotWholeSpaceScalarOnly_proof

