    totalInvoice =
      cutoffInvoice + lerayProjectionInvoice + pressureTailInvoice +
        noReuseInvoice
  surplus_eq : surplus = localJet.eta * localJet.A
  totalInvoice_le_theta_surplus : totalInvoice <= theta * surplus
