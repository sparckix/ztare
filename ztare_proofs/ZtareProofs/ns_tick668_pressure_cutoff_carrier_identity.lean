    (hConfuser : PreSummedAngularOwnerBudgetMultiplicityConfuser)
    (hReceipt : PreSummedAngularPacketOwnerCarrierReceipt)
    (hSameSpend :
      hReceipt.angularTracefreeSpend = hConfuser.angularTracefreeSpend)
    (hSameBudget :
      hReceipt.ownerPacketBudget = hConfuser.ownerPacketBudget)
    (hSameC : hReceipt.C = hConfuser.C) :
    False := by
  have hle :
      hConfuser.angularTracefreeSpend ≤
        hConfuser.C * hConfuser.ownerPacketBudget := by
    simpa [hSameSpend, hSameBudget, hSameC]
      using hReceipt.packetOwnerPaysPreSummedAngularTracefreeMorphology
  exact not_lt_of_ge hle hConfuser.multiplicityViolatesAngularOwnerBudget

