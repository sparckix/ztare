  conditionalHighInterfaceLawHasPositiveMass : Prop
  conditionalHighInterfaceLawHasPositiveMass_proof :
    conditionalHighInterfaceLawHasPositiveMass
  conditionalBoundaryInterfaceSameSourceFamily : Prop
  conditionalBoundaryInterfaceSameSourceFamily_proof :
