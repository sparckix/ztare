        h.selectedAbsoluteVariation_eq_selectedThresholdChannel
      _ = h.suitableDefectSource.muA
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) := by
        rw [h.thresholdInterfacePayment_eq_defectActiveChannel]
      _ = h.activeMeasure
          (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
        (h.activeMeasure_eq_defectActive_on_H
          h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt).symm
      _ = h.highInterfacePayment h.selectedHighInterfacePrefixIndex :=
        (h.highInterfacePayment_eq_activeMeasure
          h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt).symm
