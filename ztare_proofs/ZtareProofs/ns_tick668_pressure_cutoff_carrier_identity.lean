/-- Bounded-share arithmetic: if a [0,1]-share has mean above a threshold, its upper tail has support. -/
theorem boundedShareMean_forces_boundaryPaid_lowerBound
    {boundaryPaidMeasureLowerBound shareMeanSurplus shareThreshold
      boundaryPaidSetMeasure : Real}
    (hthreshold_lt_one : shareThreshold < 1)
    (hlower :
      boundaryPaidMeasureLowerBound * (1 - shareThreshold) <= shareMeanSurplus)
    (hmean : shareMeanSurplus <=
      (1 - shareThreshold) * boundaryPaidSetMeasure) :
    boundaryPaidMeasureLowerBound <= boundaryPaidSetMeasure := by
  have hslack_pos : 0 < 1 - shareThreshold := by
    linarith
  have hmul :
      boundaryPaidMeasureLowerBound * (1 - shareThreshold) <=
        boundaryPaidSetMeasure * (1 - shareThreshold) := by
    linarith
  nlinarith [hslack_pos, hmul]

