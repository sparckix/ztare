/--
The quantitative pressure-to-production receipt excludes the finite positive-net
jet only when its explicit pressure and retuning errors are below the jet's
positive budget gap.
-/
theorem no_TraceZeroStrainPositiveNetBudgetJet_of_quantitativePressureProductionBound
    (hReceipt : TraceZeroPositiveNetBudgetQuantitativeExclusionReceipt)
    (hJet : TraceZeroStrainPositiveNetBudgetJet)
    (_hSamePacket : hReceipt.packet = hJet.packet)
    (hSameState : hReceipt.state = hJet.state)
    (hErrorsBelowGap :
      hReceipt.C * hReceipt.fiveFramePressureResidual +
          hReceipt.retuningError < hJet.eta * hJet.A) :
    False := by
  have hbound :
      hJet.state.signedProduction ≤
        hJet.state.viscousDissipation +
          (hReceipt.C * hReceipt.fiveFramePressureResidual +
            hReceipt.retuningError) := by
    simpa [hSameState] using
      hReceipt.framePressureStealth_to_sameTrajectoryProductionBound
  rw [hJet.production_eq, hJet.dissipation_eq] at hbound
  nlinarith [hErrorsBelowGap, hJet.eta_pos, hJet.A_pos]

