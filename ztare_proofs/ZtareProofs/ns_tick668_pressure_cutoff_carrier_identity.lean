  notRawCZMeasureL1 := h.notRawCZMeasureL1
  notRawCZMeasureL1_proof := h.notRawCZMeasureL1_proof
  notBesovBVOrCFImport := h.notBesovBVOrCFImport
  notBesovBVOrCFImport_proof := h.notBesovBVOrCFImport_proof

/-- Annular band-limited Riesz payment supplies the pointwise same-carrier receipt. -/
