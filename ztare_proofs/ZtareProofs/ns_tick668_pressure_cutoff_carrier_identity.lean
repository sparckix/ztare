/--
Level361 quotient-minimal transaction carrier.  It records a source quotient and
an infimum-style positive transaction carrier; by itself it controls only the
source class, not the representative selected by the dynamics.
-/
structure QuotientMinimalTransactionCarrier where
  sourceRepresentative : Type
  sourceQuotient : Type
  sourceMap : sourceRepresentative → sourceQuotient
  positiveTransactionVariation : sourceRepresentative → Real
  selectedHighHighProduction : sourceRepresentative → Real
  minimalPositiveTransactionVariation : sourceQuotient → Real
  quotientSourceLawFixedBeforePayoff : Prop
  quotientSourceLawFixedBeforePayoff_proof : quotientSourceLawFixedBeforePayoff
  minimalCarrierDefinitionFixedBeforePayoff : Prop
  minimalCarrierDefinitionFixedBeforePayoff_proof :
    minimalCarrierDefinitionFixedBeforePayoff
  washCyclesQuotientedOut : Prop
  washCyclesQuotientedOut_proof : washCyclesQuotientedOut

/--
The extra law needed before a quotient-minimal transaction carrier can pay the
actual selected high-high packet.  It is stronger than merely bounding the
quotient-minimal currency: it preserves the selected representative-level
payment.
-/
structure SelectedQuotientRepresentativeLaw
    (carrier : QuotientMinimalTransactionCarrier) where
  representativeSelector : carrier.sourceQuotient → carrier.sourceRepresentative
  selectorRespectsSource :
    ∀ g : carrier.sourceQuotient,
      carrier.sourceMap (representativeSelector g) = g
  selectorFixedBeforePayoff : Prop
  selectorFixedBeforePayoff_proof : selectorFixedBeforePayoff
  selectorIndependentOfTargetDeficit : Prop
  selectorIndependentOfTargetDeficit_proof :
    selectorIndependentOfTargetDeficit
  productionPreservedBySelector : Prop
  productionPreservedBySelector_proof : productionPreservedBySelector
  kernelCyclesZeroSelectedProduction : Prop
  kernelCyclesZeroSelectedProduction_proof :
    kernelCyclesZeroSelectedProduction
  minimalCarrierPaysSelectedProduction : Prop
  minimalCarrierPaysSelectedProduction_proof :
    minimalCarrierPaysSelectedProduction

/--
Level361 confuser: the source quotient and minimal carrier may be well-defined
and wash-invariant while an admissible kernel representative still carries the
selected high-high production.  This blocks spending MPV on the actual packet
unless the representative law is supplied.
-/
structure QuotientMinimalUnderpaymentConfuser
    (carrier : QuotientMinimalTransactionCarrier) where
  actualRepresentative : carrier.sourceRepresentative
  kernelRepresentative : carrier.sourceRepresentative
  sameSourceAfterKernelInsertion :
    carrier.sourceMap kernelRepresentative = carrier.sourceMap actualRepresentative
  selectedProductionNotQuotientInvariant : Prop
  selectedProductionNotQuotientInvariant_proof :
    selectedProductionNotQuotientInvariant
  minimizerErasesSelectedCone : Prop
  minimizerErasesSelectedCone_proof : minimizerErasesSelectedCone
  actualPacketNotSourceMinimizer : Prop
  actualPacketNotSourceMinimizer_proof : actualPacketNotSourceMinimizer
  noSelectedQuotientRepresentativeLaw :
    ¬ Nonempty (SelectedQuotientRepresentativeLaw carrier)

/--
A quotient-minimal transaction norm does not pay selected high-high production
in the presence of the Level361 underpayment confuser.
-/
theorem no_SelectedQuotientRepresentativeLaw_of_quotientMinimalUnderpaymentConfuser
    {carrier : QuotientMinimalTransactionCarrier}
    (hConfuser : QuotientMinimalUnderpaymentConfuser carrier)
    (hLaw : SelectedQuotientRepresentativeLaw carrier) :
    False :=
  hConfuser.noSelectedQuotientRepresentativeLaw ⟨hLaw⟩


/--
Level362 restricted positive socket.  The quotient-minimal representative law is
non-vacuous only on a class where source-kernel perturbations are annihilated by
the selected high-high functional, including the cross term with the chosen
representative.
-/
structure SelectedSourceKernelHHAnnihilationLaw
    (carrier : QuotientMinimalTransactionCarrier) where
  selectorLaw : SelectedQuotientRepresentativeLaw carrier
  selectedAdmissible : carrier.sourceRepresentative → Prop
  kernelPerturbation :
    carrier.sourceRepresentative → carrier.sourceRepresentative → Prop
  kernelHasSameSource :
    ∀ r k : carrier.sourceRepresentative,
      kernelPerturbation r k → carrier.sourceMap k = carrier.sourceMap r
  kernelSelectedHHZeroOrNonpositive : Prop
  kernelSelectedHHZeroOrNonpositive_proof :
    kernelSelectedHHZeroOrNonpositive
  crossTermZeroOrNonpositive : Prop
  crossTermZeroOrNonpositive_proof : crossTermZeroOrNonpositive
  restrictedSelectedProductionPaidByMPV : Prop
  restrictedSelectedProductionPaidByMPV_proof :
    restrictedSelectedProductionPaidByMPV

/--
The first boundary confuser for Level362: an energy-orthogonal or source-kernel
packet can have the same source as the selected representative while carrying
positive selected high-high production.  Energy minimality alone does not kill
this packet because the selector metric and the selected high-high functional
are different currencies.
-/
structure OrthogonalSourceKernelSelectedHHConfuser
    (carrier : QuotientMinimalTransactionCarrier) where
  representative : carrier.sourceRepresentative
  kernelPacket : carrier.sourceRepresentative
  sameSource : carrier.sourceMap kernelPacket = carrier.sourceMap representative
  selectorMetricOrthogonal : Prop
  selectorMetricOrthogonal_proof : selectorMetricOrthogonal
  kernelSelectedHHPositive : Prop
  kernelSelectedHHPositive_proof : kernelSelectedHHPositive
  crossTermNotProvedNonpositive : Prop
  crossTermNotProvedNonpositive_proof : crossTermNotProvedNonpositive
  noSelectedSourceKernelHHAnnihilationLaw :
    ¬ Nonempty (SelectedSourceKernelHHAnnihilationLaw carrier)

/--
A source-kernel packet with positive selected high-high production blocks the
restricted Level362 representative law.
-/
theorem no_SelectedSourceKernelHHAnnihilationLaw_of_orthogonalKernelHHConfuser
    {carrier : QuotientMinimalTransactionCarrier}
    (hConfuser : OrthogonalSourceKernelSelectedHHConfuser carrier)
    (hLaw : SelectedSourceKernelHHAnnihilationLaw carrier) :
    False :=
  hConfuser.noSelectedSourceKernelHHAnnihilationLaw ⟨hLaw⟩


