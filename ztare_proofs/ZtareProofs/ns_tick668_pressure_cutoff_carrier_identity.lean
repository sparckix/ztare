  finiteEnergyCutoffInvoiceUnpaid_proof : finiteEnergyCutoffInvoiceUnpaid

/--
The affine jet instantiates the existing trace-zero positive-net jet with
eigenvalues `(s, -s/2, -s/2)`.
-/
noncomputable def TraceZeroStrainPositiveNetBudgetJet.ofLocalAffine
    (h : LocalAffineTraceZeroPositiveStretchingJet) :
    TraceZeroStrainPositiveNetBudgetJet where
  packet := h.packet
  state := h.state
  lam1 := h.s
  lam2 := -h.s / 2
  lam3 := -h.s / 2
  eta := h.eta
  A := h.A
  traceZero := by ring
  stretchingEigenvaluePositive := h.s_pos
  transverseCompensation := by nlinarith [h.s_pos]
  production_eq := h.production_eq
  dissipation_eq := h.dissipation_eq
  eta_pos := h.eta_pos
  A_pos := h.A_pos
  packetEncodesNearStealthBalancedCone :=
    h.packetEncodesNearStealthBalancedCone
  packetEncodesNearStealthBalancedCone_proof :=
    h.packetEncodesNearStealthBalancedCone_proof
  sameOwnerSelectedStream := h.sameOwnerSelectedStream
  sameOwnerSelectedStream_proof := h.sameOwnerSelectedStream_proof

/--
The local affine jet has positive net budget, before any global cutoff invoice
is charged.
