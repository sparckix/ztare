    (c : BoundaryPaidHighInterfaceSizeSumDebtPacket)
    (h : BoundaryPaidHighInterfaceSizeSumSource)
    (sameThresholdSpaceMeasure :
      h.thresholdSpaceMeasure = c.thresholdSpaceMeasure)
    (sameBoundaryPaidSetMeasure :
      h.boundaryPaidSetMeasure = c.boundaryPaidSetMeasure)
    (sameHighInterfaceFloorSetMeasure :
      h.highInterfaceFloorSetMeasure = c.highInterfaceFloorSetMeasure) :
    False := by
  have hgt := h.boundaryPaidPlusHighInterface_gt_thresholdSpace
  rw [sameThresholdSpaceMeasure, sameBoundaryPaidSetMeasure,
    sameHighInterfaceFloorSetMeasure] at hgt
  linarith [hgt, c.boundaryPaidPlusHighInterface_le_thresholdSpace]

/-- Ratio second-moment arithmetic for the boundary-paid set. -/
theorem boundaryRatioSecondMoment_forces_boundaryPaid_lowerBound
    {boundaryPaidMeasureLowerBound ratioSecondMomentCap ratioFirstMomentSq
      boundaryPaidSetMeasure : Real}
    (hcap_pos : 0 < ratioSecondMomentCap)
    (hlower : boundaryPaidMeasureLowerBound * ratioSecondMomentCap <=
      ratioFirstMomentSq)
    (hmoment : ratioFirstMomentSq <=
      ratioSecondMomentCap * boundaryPaidSetMeasure) :
    boundaryPaidMeasureLowerBound <= boundaryPaidSetMeasure := by
  have hmul :
      boundaryPaidMeasureLowerBound * ratioSecondMomentCap <=
        boundaryPaidSetMeasure * ratioSecondMomentCap := by
    linarith
  nlinarith [hcap_pos, hmul]

/--
