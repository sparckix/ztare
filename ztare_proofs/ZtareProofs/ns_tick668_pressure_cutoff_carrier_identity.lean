/--
Borel-local measure-split strengthening of the high-interface invoice.  This is
not allowed to manufacture equality or nonnegativity receipts; it only records
that the already-paid boundary invoice is represented by visible plus residual
local-energy measures on the fixed H-prefix.
-/
structure LocalEnergyMeasureSplitHighInterfaceInvoiceSource (Ω : Type u) extends
    LocalEnergyInvoiceHighInterfaceDominanceSource where
  highInterfaceEventSet : Nat → Set Ω
  activeMeasure : Set Ω → Real
  visibleBoundaryMeasure : Set Ω → Real
  residualReserveMeasure : Set Ω → Real
  highInterfacePayment_eq_activeMeasure :
    ∀ n : Nat, n < highInterfacePrefixLength →
      highInterfacePayment n = activeMeasure (highInterfaceEventSet n)
  highInterfaceBoundaryCharge_eq_visible_plus_residual :
    ∀ n : Nat, n < highInterfacePrefixLength →
      highInterfaceBoundaryCharge n =
        visibleBoundaryMeasure (highInterfaceEventSet n) +
          residualReserveMeasure (highInterfaceEventSet n)
  localEnergyMeasureDominationOnHighInterfacePrefix :
    ∀ n : Nat, n < highInterfacePrefixLength →
      activeMeasure (highInterfaceEventSet n) <=
        visibleBoundaryMeasure (highInterfaceEventSet n) +
          residualReserveMeasure (highInterfaceEventSet n)
  measureSplitNotWholeSpaceScalarOnly : Prop
  measureSplitNotWholeSpaceScalarOnly_proof :
    measureSplitNotWholeSpaceScalarOnly

/-- The Borel-local split recovers pointwise high-interface payment domination. -/
theorem LocalEnergyMeasureSplitHighInterfaceInvoiceSource.pointwise_payment_le_boundary_from_measureSplit
    {Ω : Type u} (h : LocalEnergyMeasureSplitHighInterfaceInvoiceSource Ω)
    {n : Nat} (hn : n < h.highInterfacePrefixLength) :
    h.highInterfacePayment n <= h.highInterfaceBoundaryCharge n := by
  rw [h.highInterfacePayment_eq_activeMeasure n hn,
    h.highInterfaceBoundaryCharge_eq_visible_plus_residual n hn]
  exact h.localEnergyMeasureDominationOnHighInterfacePrefix n hn

