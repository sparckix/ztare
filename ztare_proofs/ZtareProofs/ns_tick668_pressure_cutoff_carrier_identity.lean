/--
A strict-fraction scaling leak certificate realizes the abstract hostile leak
packet.  The remaining mathematics is therefore not a scaling statement; it is
a same-owner lower bound showing the real NS localization invoices cannot be a
strict fraction of the affine surplus.
-/
noncomputable def LocalizedC7TentCutoffInvoiceLeakPacket.ofScalingLeakCertificate
    (h : LocalizedC7TentScalingLeakCertificate) :
    LocalizedC7TentCutoffInvoiceLeakPacket where
  localJet := h.localJet
  totalInvoice := h.totalInvoice
  surplus := h.surplus
  surplus_eq := h.surplus_eq
  totalInvoice_lt_surplus := by
    have hsurp_pos : 0 < h.surplus := by
      rw [h.surplus_eq]
      nlinarith [h.localJet.eta_pos, h.localJet.A_pos]
    have htheta : h.theta * h.surplus < 1 * h.surplus :=
      mul_lt_mul_of_pos_right h.theta_lt_one hsurp_pos
    exact lt_of_le_of_lt h.totalInvoice_le_theta_surplus (by simpa using htheta)
  cutoffLerayPressureNoReuseInvoicesOnSameTent :=
    h.cutoffLerayPressureNoReuseInvoicesOnSameTent
  cutoffLerayPressureNoReuseInvoicesOnSameTent_proof :=
    h.cutoffLerayPressureNoReuseInvoicesOnSameTent_proof

/--
A leak packet rules out the invoice-dominance receipt when both refer to the
same surplus and invoice total.
-/
theorem no_LocalizedC7TentCutoffInvoiceDominatesPositiveStretching_of_leakPacket
    (hLeak : LocalizedC7TentCutoffInvoiceLeakPacket)
    (hReceipt : LocalizedC7TentCutoffInvoiceDominatesPositiveStretching)
    (_hSameJet : hReceipt.localJet = hLeak.localJet)
    (hSameInvoice : hReceipt.totalInvoice = hLeak.totalInvoice)
    (hSameSurplus : hReceipt.surplus = hLeak.surplus) :
    False := by
  have hdom : hLeak.surplus <= hLeak.totalInvoice := by
    simpa [hSameInvoice, hSameSurplus] using hReceipt.invoiceDominatesSurplus
  exact not_lt_of_ge hdom hLeak.totalInvoice_lt_surplus

