  h.prefixNoNull

/--
Zero projected-pressure prefix blocks the typed selected topology no-null source.
-/
theorem no_LEINativeSelectedTopologyProjectedPressurePrefixNoNullLockSource_of_zeroAbsPrefix
    {Ω : Type u}
    (h : LEINativeSelectedTopologyProjectedPressurePrefixNoNullLockSource Ω)
    {K : ℕ}
    (hK : 0 < (K : ℝ))
    (hzero : projectedPressureAbsSum h.P K = 0) : False := by
  have hlock := h.prefixNoNull K hK
  unfold noNullLockAverageLowerBound at hlock
  rw [hzero] at hlock
  have hpos : 0 < (K : ℝ) * h.pFloor := mul_pos hK h.pFloor_pos
  exact not_lt_of_ge hlock hpos

/--
A pointwise projected-pressure floor on every selected prefix element is a
sufficient, deliberately strong, route to prefix no-null-lock. The hard PDE
work is proving this floor on the selected topology/reconnection stream.
-/
theorem noNullLockAverageLowerBound_of_pointwiseProjectedPressureFloor
    {P : ProjectedPressureSequence} {N : ℕ} {pFloor : ℝ}
    (hpoint : ∀ n : ℕ, n < N → pFloor ≤ |P n|) :
    noNullLockAverageLowerBound P N pFloor := by
  unfold noNullLockAverageLowerBound projectedPressureAbsSum
  have hsum :
      (Finset.range N).sum (fun _n => pFloor) ≤
        (Finset.range N).sum (fun n => |P n|) := by
    exact Finset.sum_le_sum (fun n hn => hpoint n (Finset.mem_range.mp hn))
  simpa using hsum

