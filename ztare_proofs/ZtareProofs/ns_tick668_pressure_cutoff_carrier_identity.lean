/-- The LEI-native active-floor input pays the selected high-interface floor. -/
theorem LEINativeHighInterfaceEventTentPrefixSource.selected_payment_floor_from_LEI_active
    {Ω : Type u}
    (h : LEINativeHighInterfaceEventTentPrefixSource Ω) :
    h.interfacePaymentFloor <= h.highInterfacePayment h.selectedHighInterfacePrefixIndex := by
  rw [h.highInterfacePayment_eq_activeMeasure
    h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt,
    h.activeMeasure_eq_defectActive_on_H
      h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt]
  exact h.selectedLEIEventActiveFloor

