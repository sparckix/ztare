  have hBound :
      nsTick668FinitePrefixSum hPacket.angularEventPay N ≤
        hBudget.budget.C * hBudget.budget.ownerTVBudget := by
    simpa [hSameValuationEvents]
      using hBudget.valuationPrefix_le_ownerTVBudget_all N
  exact not_lt_of_ge hBound hExceeds

/--
Degree-zero pressure/Riesz cone carriers alone cannot give the pointwise
