  conditionalBoundaryAverageDominatesInterfaceAverage : Prop
  conditionalBoundaryAverageDominatesInterfaceAverage_proof :
    conditionalBoundaryAverageDominatesInterfaceAverage
  selectedEventFromConditionalFinitePigeonhole : Prop
  selectedEventFromConditionalFinitePigeonhole_proof :
