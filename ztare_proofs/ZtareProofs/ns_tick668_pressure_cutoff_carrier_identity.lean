  have hle := h.quantitativeHeatCollarDebitCompatibility c.badAtom
  rw [c.badAtomHeatCollarMassZero h] at hle
  have hlt : (0 : ℝ) < 0 := lt_of_lt_of_le (c.badAtomExceptionDebitPositive h) hle
  exact (lt_irrefl (0 : ℝ)) hlt

