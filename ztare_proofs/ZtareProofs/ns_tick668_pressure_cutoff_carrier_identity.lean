theorem no_Route1AnnularOutputEventStreamIdentityReceipt_of_scalarMomentTotalVariationConfuser
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hConfuser : Route1ScalarProjectedMomentTotalVariationConfuser)
    (hIdentity : Route1AnnularOutputEventStreamIdentityReceipt formula)
