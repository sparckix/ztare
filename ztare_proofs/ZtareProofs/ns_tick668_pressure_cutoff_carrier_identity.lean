/--
Level409 universal lift target.  A selected tangential pressure-null positive-HH
kernel can be killed by the dual-price pressure-frame theorem only if every such
kernel packet lifts to a trace-zero positive-net jet on the same pressure-frame
state, with the dual-price error reserve below the lifted jet gap.
-/
structure TangentialKernelToTraceZeroPositiveNetJetLift
    (carrier : QuotientMinimalTransactionCarrier)
    (dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt) where
  liftKernelToJet :
    TangentialDivDivNullPositiveHHKernelPacket carrier ->
      TraceZeroStrainPositiveNetBudgetJet
  liftedJetSamePressurePacket :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      dualPrice.packet = (liftKernelToJet hKernel).packet
  liftedJetSameState :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      dualPrice.state = (liftKernelToJet hKernel).state
  errorReserveBelowLiftedGap :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      dualPrice.errorReserve <
        (liftKernelToJet hKernel).eta * (liftKernelToJet hKernel).A
  quotientCarrierRepresentativeFixedBeforeLift : Prop
  quotientCarrierRepresentativeFixedBeforeLift_proof :
    quotientCarrierRepresentativeFixedBeforeLift
  selectedHHBecomesStateSignedProduction : Prop
  selectedHHBecomesStateSignedProduction_proof :
    selectedHHBecomesStateSignedProduction
  sameCarrierCutoffInvoicePaidForLiftedJet : Prop
  sameCarrierCutoffInvoicePaidForLiftedJet_proof :
    sameCarrierCutoffInvoicePaidForLiftedJet
  noProxyPressureVisibilityOnlyLift : Prop
  noProxyPressureVisibilityOnlyLift_proof :
    noProxyPressureVisibilityOnlyLift
  noFinalCarrierCancellationInLift : Prop
  noFinalCarrierCancellationInLift_proof :
    noFinalCarrierCancellationInLift
  noTargetDefinedLiftAfterPayoff : Prop
  noTargetDefinedLiftAfterPayoff_proof : noTargetDefinedLiftAfterPayoff

/--
Level411 sharper source-law receipt for the Level409 lift.  It forbids the
direct relabeling of selected high-high kernel positivity as a same-state
positive-net jet: the representative, state, owner, gap scale, overlap, and
payoff timing must all be fixed before the dual-price reserve is compared to
`eta * A`.
-/
structure KernelSelectedHHToSameStatePositiveNetGapReceipt
    (carrier : QuotientMinimalTransactionCarrier)
    (dualPrice : TraceZeroPositiveNetBudgetDualPriceFrameReceipt) where
  liftKernelToJet :
    TangentialDivDivNullPositiveHHKernelPacket carrier ->
      TraceZeroStrainPositiveNetBudgetJet
  liftedJetSamePressurePacket :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      dualPrice.packet = (liftKernelToJet hKernel).packet
  liftedJetSameState :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      dualPrice.state = (liftKernelToJet hKernel).state
  errorReserveBelowFixedGap :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      dualPrice.errorReserve <
        (liftKernelToJet hKernel).eta * (liftKernelToJet hKernel).A
  ownerRootBudgetForGap : Real
  ownerRootBudgetForGap_nonnegative : 0 ≤ ownerRootBudgetForGap
  ownerRootBudgetControlsLiftedGap :
    ∀ hKernel : TangentialDivDivNullPositiveHHKernelPacket carrier,
      (liftKernelToJet hKernel).eta * (liftKernelToJet hKernel).A ≤
        ownerRootBudgetForGap
  sameOwnerSourceBindingForGapWitness : carrier.sourceRepresentative
  noOverlapDisjointnessForGapWitness : carrier.sourceRepresentative
  fixedBeforePayoffGapWitness : carrier.sourceRepresentative
  noReuseGapWitness : carrier.sourceRepresentative
  pressureReserveGapWitness : carrier.sourceRepresentative
  duhamelReserveGapWitness : carrier.sourceRepresentative
  inheritedReserveGapWitness : carrier.sourceRepresentative
  partitionGapWitness : carrier.sourceRepresentative
  sectionIdentityGapWitness : carrier.sourceRepresentative
  sameCarrierCutoffInvoiceGapWitness : carrier.sourceRepresentative
  representativeSelectorFixedBeforeReserveComparison : Prop
  representativeSelectorFixedBeforeReserveComparison_proof :
    representativeSelectorFixedBeforeReserveComparison
  selectedHHToStateProductionIdentity : Prop
  selectedHHToStateProductionIdentity_proof :
    selectedHHToStateProductionIdentity
  selectedHHGapLowerBoundNumeric : Prop
  selectedHHGapLowerBoundNumeric_proof : selectedHHGapLowerBoundNumeric
  etaAGapScaleFixedBeforeReserveComparison : Prop
  etaAGapScaleFixedBeforeReserveComparison_proof :
    etaAGapScaleFixedBeforeReserveComparison
  sameOwnerOrSourceBindingForGap : Prop
  sameOwnerOrSourceBindingForGap_proof : sameOwnerOrSourceBindingForGap
  ownerRootNumericBoundForGap : Prop
  ownerRootNumericBoundForGap_proof : ownerRootNumericBoundForGap
  noOverlapOrDisjointnessForGap : Prop
  noOverlapOrDisjointnessForGap_proof : noOverlapOrDisjointnessForGap
  payoffIndependenceForGap : Prop
  payoffIndependenceForGap_proof : payoffIndependenceForGap
  sameCarrierCutoffInvoicePaidForGap : Prop
  sameCarrierCutoffInvoicePaidForGap_proof :
