    ∀ K, (Finset.range K).sum retypingSource.localizedSource.exceptionDebitSeq ≤
      (Finset.range K).sum exceptionAtomDebit
  pointwiseExceptionDebitDominatedByCollarMass :
    ∀ n, exceptionAtomDebit n ≤ heatCollarAtomMass (exceptionToHeatCollarAtom n)
  collarPreimageMultiplicityBound : ℝ
  collarPreimageMultiplicityControlsPrefix :
    ∀ K, (Finset.range K).sum (fun n =>
      heatCollarAtomMass (exceptionToHeatCollarAtom n)) ≤
      retypingSource.collarSource.analyticOmissionCollarWeightPrefix K
  collarWeightFitsExceptionBudget :
    ∀ K, retypingSource.collarSource.analyticOmissionCollarWeightPrefix K ≤
      retypingSource.localizedSource.exceptionBudget
