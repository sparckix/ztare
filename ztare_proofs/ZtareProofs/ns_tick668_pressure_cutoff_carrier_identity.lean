  positiveSameTrajectoryProductionSurvives_proof := trivial

/-- Tangential div-div null stress alone blocks the same-source self-tax receipt
if the receipt tries to identify its anti-null field with the counterpacket's
missing field. -/
theorem no_PressureL2CapPaysSameSourceFrameSelfTax_of_tangentialNullCounterpacket
    (hConfuser : PressureL2SameWindowSelfTaxCounterpacket)
    (hReceipt : PressureL2CapPaysSameSourceFrameSelfTax)
    (_hSamePacket : hReceipt.packet = hConfuser.packet)
    (_hSameState : hReceipt.state = hConfuser.state)
    (hAntiNullSame :
      hReceipt.noTangentialDivDivNullStressOnProductionFrame =
        (hConfuser.tangentialDivDivNullStressStillAdmissible = False)) :
    False := by
  have hmissing :
      hConfuser.tangentialDivDivNullStressStillAdmissible = False := by
    simpa [hAntiNullSame]
      using hReceipt.noTangentialDivDivNullStressOnProductionFrame_proof
  have hproof := hConfuser.tangentialDivDivNullStressStillAdmissible_proof
  rw [hmissing] at hproof
  exact hproof

/-- Same-window core/sheath cancellation blocks the receipt unless the l=2 frame
is proved immune to that cancellation before payoff. -/
theorem no_PressureL2CapPaysSameSourceFrameSelfTax_of_sameWindowSheathCounterpacket
