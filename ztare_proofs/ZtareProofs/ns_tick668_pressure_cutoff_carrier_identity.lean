structure TangentialPressureNullProductionStillAdmissibleConfuser
    (carrier : QuotientMinimalTransactionCarrier) where
  packet : TangentialDivDivNullPositiveHHKernelPacket carrier
  pressureVisibilityOnly : Prop
  pressureVisibilityOnly_proof : pressureVisibilityOnly
  finiteFrameVocabularyOnly : Prop
  finiteFrameVocabularyOnly_proof : finiteFrameVocabularyOnly
  sourceToSelectedHHProductionCoercivityMissing : Prop
  sourceToSelectedHHProductionCoercivityMissing_proof :
    sourceToSelectedHHProductionCoercivityMissing
  sameCarrierCutoffInvoiceUnpaid : Prop
  sameCarrierCutoffInvoiceUnpaid_proof : sameCarrierCutoffInvoiceUnpaid
  noNoTangentialProductionReceipt :
    ¬ Nonempty (NoTangentialPressureNullSelectedProductionReceipt carrier)

/--
A finite-frame anti-null branch cannot close while the tangential pressure-null
positive-HH confuser remains admissible.
-/
theorem no_NoTangentialPressureNullSelectedProductionReceipt_of_admissibleConfuser
    {carrier : QuotientMinimalTransactionCarrier}
    (hConfuser : TangentialPressureNullProductionStillAdmissibleConfuser carrier)
    (hReceipt : NoTangentialPressureNullSelectedProductionReceipt carrier) :
    False :=
  hConfuser.noNoTangentialProductionReceipt ⟨hReceipt⟩

