  noUniformEnstrophyOrESSImported_proof : noUniformEnstrophyOrESSImported

/-- Tick542 arithmetic bounds the number of selected intermittent levels. -/
theorem LEINativeSelectedIntermittentFiniteBudgetSource.selected_intermitttent_depth_bounded
    {Ω : Type u}
    (h : LEINativeSelectedIntermittentFiniteBudgetSource Ω) :
    ∀ N : ℕ,
      (N : ℝ) <=
