  topologyFreshCostSource :
    LEINativeSelectedTopologyFreshCostSource Ω
  costSeq : ℕ → ℝ
  reserveSeq : ℕ → ℝ
  repairSeq : ℕ → ℝ
  errorSeq : ℕ → ℝ
