    False := by
  have hInvoice :
      hConfuser.angularQuotientProxyNotInvoiceFiber = False := by
    simpa [hInvoiceSame]
      using hExchange.angularSampleLivesOnExactInvoiceFiber_proof
  exact hConfuser.notExactInvoiceFiber hInvoice

