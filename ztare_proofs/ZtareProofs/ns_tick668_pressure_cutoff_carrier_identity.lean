/-- The H-prefix channel definition identifies selected variation with selected defect-active payment. -/
theorem LEINativeHighInterfaceDefinedThresholdChannelSource.selectedAbs_eq_selectedDefectActive
    {Ω : Type u}
    (h : LEINativeHighInterfaceDefinedThresholdChannelSource Ω) :
    h.selectedAbsoluteVariation =
      h.suitableDefectSource.muA
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) := by
  calc
    h.selectedAbsoluteVariation =
        h.highInterfacePayment h.selectedHighInterfacePrefixIndex :=
      h.selectedAbsoluteVariation_eq_selectedHighInterfacePayment
    _ = h.activeMeasure
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
      h.highInterfacePayment_eq_activeMeasure
        h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt
    _ = h.suitableDefectSource.muA
        (h.highInterfaceEventSet h.selectedHighInterfacePrefixIndex) :=
      h.activeMeasure_eq_defectActive_on_H
        h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt

