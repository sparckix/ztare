          (O.generated_quartic_survival_amplitude_projection U n)
          h

/-- Generated-block amplitude/gain cap exposed directly from the
profile/Lipschitz endpoint. -/
theorem generated_lipschitz_survival_profit_le_gain_at_amp
    (O : TrackBProfileLipschitzControlObligation)
    (U : NSEvolution) (n : ℕ) :
    ((O.lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
      ((O.lipschitz_bridge.ledger_of_evolution U).block n).gamma *
        (O.generated_quartic_survival_amplitude_projection U n).ampSq :=
  (O.generated_quartic_survival_amplitude_projection U n)
    |>.survival_profit_le_gain_at_amp

/-- Generated-block above-wall amplitude threshold exposed directly from the
profile/Lipschitz endpoint. -/
theorem generated_lipschitz_above_wall_amp_sq_le_threshold
    (O : TrackBProfileLipschitzControlObligation)
    (U : NSEvolution) (n : ℕ)
    (hgt :
      sharpTarget <
        ((O.lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (hdefect :
      1 ≤ survivalDefect
        ((O.lipschitz_bridge.ledger_of_evolution U).block n)
        (Real.sqrt
          (sharpTarget /
            ((O.lipschitz_bridge.ledger_of_evolution U).block n).gamma))) :
    (O.generated_quartic_survival_amplitude_projection U n).ampSq ≤
      sharpTarget /
        ((O.lipschitz_bridge.ledger_of_evolution U).block n).gamma :=
  (O.generated_quartic_survival_amplitude_projection U n)
    |>.above_wall_amp_sq_le_threshold hgt hdefect

