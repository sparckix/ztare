import Mathlib.Tactic
import ZtareProofs.ns_trackb_profile_decomposition_spine
import ZtareProofs.ns_low_frequency_lipschitz_control_bridge
import ZtareProofs.ns_profile_lsc_self_tax_obligation
import ZtareProofs.ns_matrix_block_sos_bossfight
import ZtareProofs.ns_finite_psd_certificate_witnesses

/-!
# Profile-pricing to Lipschitz-control Clay bridge

The earlier Track B files split the Clay bridge into two interfaces:

* profile/pricing limit passage proves `FullLedgerNoSurvivor` for every
  globally admissible block;
* low-frequency Lipschitz control turns block no-survivor into the chosen
  continuation quantity.

This file composes those interfaces.  It is still conditional: it does not
prove the PDE profile decomposition, the exact quartic pricing theorem, or the
continuation criterion.  Its purpose is to keep the remaining proof burden
non-tautological and localized: a candidate Clay proof must instantiate these
fixed maps and certificates before scoring a profitable route.
-/

namespace ZtareProofs.NS

universe u

/-- Source coupling between the profile-decomposition side and the generated
low-frequency Lipschitz ledger.

This is the seam where a closure attempt can otherwise become tautological:
the profile family and generated Lipschitz block must be declared as the same
block-level object before no-survivor pricing is used. The quartic projection
itself is carried by the typed amplitude receipt on
`TrackBProfileLipschitzControlObligation`, not by an opaque coupling `Prop`.
-/
structure TrackBProfileLipschitzSourceCoupling
    (evolution_of_initial_data : SmoothNSInitialData → NSEvolution)
    (profile_obligation : TrackBProfileDecompositionObligation)
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  generated_lipschitz_block_declared_before_profile_pricing :
    ∀ _u0 : SmoothNSInitialData, ∀ _n : ℕ, Prop
  generated_lipschitz_block_declared_before_profile_pricing_paid :
    ∀ u0 : SmoothNSInitialData, ∀ n : ℕ,
      generated_lipschitz_block_declared_before_profile_pricing u0 n
  profile_family_applied_to_generated_lipschitz_block :
    ∀ _u0 : SmoothNSInitialData, ∀ _n : ℕ, Prop
  profile_family_applied_to_generated_lipschitz_block_paid :
    ∀ u0 : SmoothNSInitialData, ∀ n : ℕ,
      profile_family_applied_to_generated_lipschitz_block u0 n
  no_posthoc_profile_lipschitz_block_substitution :
    ∀ _u0 : SmoothNSInitialData, ∀ _n : ℕ, Prop
  no_posthoc_profile_lipschitz_block_substitution_paid :
    ∀ u0 : SmoothNSInitialData, ∀ n : ℕ,
      no_posthoc_profile_lipschitz_block_substitution u0 n

/-- Mechanical profile/Lipschitz source coupling induced by the
profile-decomposition source receipt on the generated Lipschitz block.

This is intentionally not a `True`-filled coupling.  Each guard is the
corresponding source-receipt field for the concrete block generated by the
low-frequency Lipschitz ledger, using the audited global-block certificate
carried by `lipschitz_bridge`. -/
def trackB_profile_lipschitz_source_coupling_of_profile_source_receipt
    (evolution_of_initial_data : SmoothNSInitialData → NSEvolution)
    (profile_obligation : TrackBProfileDecompositionObligation)
    (lipschitz_bridge : LowFrequencyLipschitzBridge) :
    TrackBProfileLipschitzSourceCoupling
      evolution_of_initial_data
      profile_obligation
      lipschitz_bridge where
  generated_lipschitz_block_declared_before_profile_pricing := by
    intro u0 n
    let U := evolution_of_initial_data u0
    let B := (lipschitz_bridge.ledger_of_evolution U).block n
    let hglobal :=
      (lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    exact
      profile_obligation.source_receipt.profile_family_fixed_before_payoff
        B hglobal
  generated_lipschitz_block_declared_before_profile_pricing_paid := by
    intro u0 n
    let U := evolution_of_initial_data u0
    let B := (lipschitz_bridge.ledger_of_evolution U).block n
    let hglobal :=
      (lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    exact
      profile_obligation.source_receipt.profile_family_fixed_before_payoff_paid
        B hglobal
  profile_family_applied_to_generated_lipschitz_block := by
    intro u0 n
    let U := evolution_of_initial_data u0
    let B := (lipschitz_bridge.ledger_of_evolution U).block n
    let hglobal :=
      (lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    exact
      profile_obligation.source_receipt.same_family_reused_by_all_branch_certificates
        B hglobal
  profile_family_applied_to_generated_lipschitz_block_paid := by
    intro u0 n
    let U := evolution_of_initial_data u0
    let B := (lipschitz_bridge.ledger_of_evolution U).block n
    let hglobal :=
      (lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    exact
      profile_obligation.source_receipt.same_family_reused_by_all_branch_certificates_paid
        B hglobal
  no_posthoc_profile_lipschitz_block_substitution := by
    intro u0 n
    let U := evolution_of_initial_data u0
    let B := (lipschitz_bridge.ledger_of_evolution U).block n
    let hglobal :=
      (lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    exact
      profile_obligation.source_receipt.no_branch_specific_posthoc_profile_selection
        B hglobal
  no_posthoc_profile_lipschitz_block_substitution_paid := by
    intro u0 n
    let U := evolution_of_initial_data u0
    let B := (lipschitz_bridge.ledger_of_evolution U).block n
    let hglobal :=
      (lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    exact
      profile_obligation.source_receipt.no_branch_specific_posthoc_profile_selection_paid
        B hglobal

/-- Profile-pricing plus Lipschitz-control obligation, before any continuation
criterion is attached.

The key anti-tautology requirement is that both maps are fixed:

* `profile_bundle.profile_family_of_block` decomposes the block before
  payoff is scored;
* `lipschitz_bridge.ledger_of_evolution` declares the continuation-relevant
  low-frequency budget before no-survivor is used.
-/
structure TrackBProfileLipschitzControlObligation where
  evolution_of_initial_data : SmoothNSInitialData → NSEvolution
  profile_bundle : TrackBProfileDecompositionBridgeBundle
  lipschitz_bridge : LowFrequencyLipschitzBridge
  source_coupling :
    TrackBProfileLipschitzSourceCoupling
      evolution_of_initial_data
      (trackb_profile_decomposition_obligation_of_bridge_bundle
        profile_bundle)
      lipschitz_bridge
  generated_quartic_survival_amplitude_observable_source :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n)

/-- Derived profile-decomposition obligation for a profile/Lipschitz endpoint.

The obligation is no longer a free field: it is projected from the same-family
profile bridge bundle, so instantiating the top-level profile/Lipschitz object
must pay the branch-bridge provenance first. -/
def TrackBProfileLipschitzControlObligation.profile_obligation
    (O : TrackBProfileLipschitzControlObligation) :
    TrackBProfileDecompositionObligation :=
  trackb_profile_decomposition_obligation_of_bridge_bundle O.profile_bundle

/-- The generated block is source-ready for profile pricing and Lipschitz
reserve pricing under the same predeclared block identity. -/
def TrackBProfileLipschitzGeneratedBlockSourceReady
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) : Prop :=
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  let hglobal :=
    (O.lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
  O.source_coupling.generated_lipschitz_block_declared_before_profile_pricing
      u0 n ∧
    O.source_coupling.profile_family_applied_to_generated_lipschitz_block
        u0 n ∧
      O.source_coupling.no_posthoc_profile_lipschitz_block_substitution
          u0 n ∧
        TrackBProfileDecompositionBranchSourceReady
          O.profile_obligation.source_receipt
          (L.block n)
          hglobal

/-- The declared source coupling and the profile-decomposition source receipt
make every generated Lipschitz block ready for non-tautological profile
pricing. -/
theorem trackB_profile_lipschitz_generated_block_source_ready
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) :
    TrackBProfileLipschitzGeneratedBlockSourceReady O u0 n := by
  dsimp [TrackBProfileLipschitzGeneratedBlockSourceReady]
  exact
    ⟨(O.source_coupling).generated_lipschitz_block_declared_before_profile_pricing_paid u0 n,
      (O.source_coupling).profile_family_applied_to_generated_lipschitz_block_paid u0 n,
      (O.source_coupling).no_posthoc_profile_lipschitz_block_substitution_paid u0 n,
      trackb_profile_decomposition_branch_source_ready
        O.profile_obligation.source_receipt
        ((O.lipschitz_bridge.ledger_of_evolution
          (O.evolution_of_initial_data u0)).block n)
        ((O.lipschitz_bridge.audited_certificate_of_evolution
          (O.evolution_of_initial_data u0)).block_is_global n)⟩

/-- The generated Lipschitz block also carries the profile-decomposition
threshold-handoff source receipt consumed by the no-survivor bridge.

This is separate from branch source readiness: a closure must not only price
all profile branches with a fixed family, but also hand the same predeclared
family to the threshold-defect/quartic projection step. -/
theorem trackB_profile_lipschitz_generated_block_threshold_handoff_source_ready
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) :
    let U := O.evolution_of_initial_data u0
    let L := O.lipschitz_bridge.ledger_of_evolution U
    let hglobal :=
      (O.lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    TrackBProfileDecompositionThresholdHandoffSourceReady
      O.profile_obligation.source_receipt
      (L.block n)
      hglobal := by
  dsimp
  exact
    trackb_profile_decomposition_threshold_handoff_source_ready
      O.profile_obligation.source_receipt
      ((O.lipschitz_bridge.ledger_of_evolution
        (O.evolution_of_initial_data u0)).block n)
      ((O.lipschitz_bridge.audited_certificate_of_evolution
        (O.evolution_of_initial_data u0)).block_is_global n)

/-- Combined source package for the generated Lipschitz block.

This forces the final no-survivor bridge through both the profile/Lipschitz
source coupling and the threshold-handoff source receipt for the same
generated block. -/
def TrackBProfileLipschitzGeneratedBlockHandoffSourceReady
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) : Prop :=
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  let hglobal :=
    (O.lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
  TrackBProfileLipschitzGeneratedBlockSourceReady O u0 n ∧
    TrackBProfileDecompositionThresholdHandoffSourceReady
      O.profile_obligation.source_receipt
      (L.block n)
      hglobal

/-- Existing source receipts produce the combined generated-block handoff
package used by the no-survivor theorem. -/
theorem trackB_profile_lipschitz_generated_block_handoff_source_ready
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) :
    TrackBProfileLipschitzGeneratedBlockHandoffSourceReady O u0 n := by
  dsimp [TrackBProfileLipschitzGeneratedBlockHandoffSourceReady]
  exact
    ⟨trackB_profile_lipschitz_generated_block_source_ready O u0 n,
      trackB_profile_lipschitz_generated_block_threshold_handoff_source_ready
        O u0 n⟩

/-- Branch source readiness projected from the generated Lipschitz block
source package. -/
theorem trackB_profile_lipschitz_generated_block_branch_source_ready_of_source_ready
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ)
    (hsource :
      TrackBProfileLipschitzGeneratedBlockSourceReady O u0 n) :
    let U := O.evolution_of_initial_data u0
    let L := O.lipschitz_bridge.ledger_of_evolution U
    let hglobal :=
      (O.lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    TrackBProfileDecompositionBranchSourceReady
      O.profile_obligation.source_receipt
      (L.block n)
      hglobal := by
  dsimp [TrackBProfileLipschitzGeneratedBlockSourceReady] at hsource
  exact hsource.2.2.2

/-- Threshold-handoff source readiness projected from the combined generated
Lipschitz block handoff package. -/
theorem trackB_profile_lipschitz_generated_block_threshold_handoff_source_ready_of_handoff_ready
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ)
    (hsource :
      TrackBProfileLipschitzGeneratedBlockHandoffSourceReady O u0 n) :
    let U := O.evolution_of_initial_data u0
    let L := O.lipschitz_bridge.ledger_of_evolution U
    let hglobal :=
      (O.lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
    TrackBProfileDecompositionThresholdHandoffSourceReady
      O.profile_obligation.source_receipt
      (L.block n)
      hglobal := by
  dsimp [TrackBProfileLipschitzGeneratedBlockHandoffSourceReady] at hsource
  exact hsource.2

/-- Source-aware threshold defects for one generated profile/Lipschitz block.

This theorem is the local bridge from the generated-block source package into
the four profile-decomposition branch prices.  It consumes the branch-source
readiness carried by `TrackBProfileLipschitzGeneratedBlockSourceReady` and the
threshold handoff carried by
`TrackBProfileLipschitzGeneratedBlockHandoffSourceReady`, so downstream
no-survivor proofs do not jump directly from a bridge bundle to threshold
convexity while leaving the generated-block source coupling decorative. -/
theorem threshold_defects_of_trackB_profile_lipschitz_generated_block_handoff_source
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ)
    (hsource :
      TrackBProfileLipschitzGeneratedBlockHandoffSourceReady O u0 n) :
    let U := O.evolution_of_initial_data u0
    let L := O.lipschitz_bridge.ledger_of_evolution U
    ThresholdDefectConvexity (L.block n) ∧
      ThresholdDefectConvexity (L.block n) ∧
        ThresholdDefectConvexity (L.block n) ∧
          ThresholdDefectConvexity (L.block n) := by
  dsimp [TrackBProfileLipschitzGeneratedBlockHandoffSourceReady,
    TrackBProfileLipschitzGeneratedBlockSourceReady] at hsource
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  let B := L.block n
  have hglobal : IsGlobalTrackBBlock B :=
    (O.lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
  rcases hsource with ⟨hgenerated_source, hthreshold_source⟩
  rcases hgenerated_source with
    ⟨_hblock_declared, _hfamily_applied, _hno_substitution, hbranch_source⟩
  let Obl := O.profile_obligation
  let F := Obl.profile_family_of_block B
  have hnull :
      familyPayoff F ≤ familyPrice F :=
    family_no_arbitrage_of_null_profile_cap_branch
      F
      (Obl.null_certificate B hglobal hbranch_source)
  have hconcentration :
      familyPayoff F ≤ familyPrice F :=
    family_no_arbitrage_of_concentration_impact
      F
      (Obl.concentration_certificate B hglobal hbranch_source)
  have hvanishing :
      familyPayoff F ≤ familyPrice F :=
    family_no_arbitrage_of_vanishing
      F
      (Obl.vanishing_certificate B hglobal hbranch_source)
  have hcross :=
    Obl.dichotomy_cross_certificate B hglobal hbranch_source
  have hdichotomy :
      familyPayoff F ≤ familyPrice F :=
    family_no_arbitrage_of_cross_profile_charging
      F
      hcross.1
      hcross.2
  exact
    ⟨threshold_defect_of_trackb_profile_decomposition_family_no_arbitrage
        Obl
        B hglobal hthreshold_source hnull,
      threshold_defect_of_trackb_profile_decomposition_family_no_arbitrage
        Obl
        B hglobal hthreshold_source hconcentration,
      threshold_defect_of_trackb_profile_decomposition_family_no_arbitrage
        Obl
        B hglobal hthreshold_source hvanishing,
      threshold_defect_of_trackb_profile_decomposition_family_no_arbitrage
        Obl
        B hglobal hthreshold_source hdichotomy⟩

/-- Generated-block adapter from the amplitude-level survival receipt to the
quartic projection required by the profile/Lipschitz bridge.

This is non-tautological because the amplitude receipt pays the two actual
cap estimates: below-wall unit-amplitude profit control and above-wall
threshold amplitude control for the same generated Lipschitz block. -/
def generated_quartic_survival_projection_of_amplitude_receipts
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (hamplitude :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeProjectionReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalProjectionReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact quartic_survival_projection_of_amplitude_receipt
    ((lipschitz_bridge.ledger_of_evolution U).block n)
    (hamplitude U n)

/-- Source-facing generated amplitude family built from scalar amplitude
projections plus separately paid signed-observable provenance.

This names the exact split left by the Track B profile/Lipschitz blocker: the
scalar amplitude inequalities and the fully charged observable/source match
can be constructed independently, then joined before the endpoint stores a
`QuarticSurvivalAmplitudeObservableSource`. -/
def generated_amplitude_sources_of_projections_and_observables
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (hamplitude_projection :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeProjectionReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_fully_charged :
      ∀ (U : NSEvolution) (n : ℕ),
        GlobalSignedObservableFullyCharged
          (observable_of_generated_block U n))
    (observable_matches_survival_profit :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (observable_matches_survival_profit_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        observable_matches_survival_profit U n) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    quartic_survival_amplitude_observable_source_of_projection_and_fully_charged_observable
      ((lipschitz_bridge.ledger_of_evolution U).block n)
      (hamplitude_projection U n)
      (observable_of_generated_block U n)
      (observable_fully_charged U n)
      (observable_matches_survival_profit U n)
      (observable_matches_survival_profit_paid U n)

/-- Input bundle for the generated Track B amplitude-source family.

This keeps the scalar amplitude projection and the signed-observable
provenance as separate paid inputs while requiring a structured match receipt
for the exact generated block, observable, and amplitude square. -/
structure GeneratedQuarticSurvivalAmplitudeSourceInputs
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  amplitude_projection :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeProjectionReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n)
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block U n)
  observable_match :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (observable_of_generated_block U n)
        ((amplitude_projection U n).ampSq)

/-- Generated amplitude source family built from the structured input bundle. -/
def generated_amplitude_sources_of_input_receipts
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (I : GeneratedQuarticSurvivalAmplitudeSourceInputs lipschitz_bridge) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    quartic_survival_amplitude_observable_source_of_projection_and_match_receipt
      ((lipschitz_bridge.ledger_of_evolution U).block n)
      (I.amplitude_projection U n)
      (I.observable_of_generated_block U n)
        (I.observable_fully_charged U n)
        (I.observable_match U n)

/-- Threshold-root version of the generated Track B amplitude-source inputs.

This is closer to the PDE/SOS source shape than the compact projection input:
for each generated block, the caller supplies a threshold-root amplitude source
whose root-square bound is then projected mechanically to the compact quartic
amplitude projection receipt. -/
structure GeneratedQuarticSurvivalThresholdRootAmplitudeSourceInputs
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  threshold_root_source :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalThresholdRootAmplitudeSource
        ((lipschitz_bridge.ledger_of_evolution U).block n)
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block U n)
  observable_match :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (observable_of_generated_block U n)
        ((threshold_root_source U n).ampSq)

/-- Compact generated-amplitude inputs projected from threshold-root source
inputs. -/
def generated_amplitude_source_inputs_of_threshold_root_sources
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (I :
      GeneratedQuarticSurvivalThresholdRootAmplitudeSourceInputs
        lipschitz_bridge) :
    GeneratedQuarticSurvivalAmplitudeSourceInputs lipschitz_bridge where
  amplitude_projection :=
    quartic_survival_amplitude_projection_family2_of_threshold_root_sources
      (fun U n => (lipschitz_bridge.ledger_of_evolution U).block n)
      I.threshold_root_source
  observable_of_generated_block :=
    I.observable_of_generated_block
  observable_fully_charged :=
    I.observable_fully_charged
  observable_match := by
    intro U n
    simpa [
      quartic_survival_amplitude_projection_family2_of_threshold_root_sources,
      quartic_survival_amplitude_projection_of_threshold_root_source
    ] using I.observable_match U n

/-- Generated amplitude source family built directly from threshold-root source
inputs. -/
def generated_amplitude_sources_of_threshold_root_source_inputs
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (I :
      GeneratedQuarticSurvivalThresholdRootAmplitudeSourceInputs
        lipschitz_bridge) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) :=
  generated_amplitude_sources_of_input_receipts
    lipschitz_bridge
    (generated_amplitude_source_inputs_of_threshold_root_sources
      lipschitz_bridge I)

/-- Generated amplitude sources from the strongest local source object.

This is the preferred endpoint when the PDE/SOS side has already produced a
typed threshold-root observable source for each generated block.  It avoids the
older raw match-`Prop` adapter and preserves the explicit numerical fields
`survival_profit_le_gain_at_amp` and `amp_sq_le_threshold_root`. -/
def generated_amplitude_sources_of_threshold_root_observable_sources
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootObservableSource
          ((lipschitz_bridge.ledger_of_evolution U).block n)) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    quartic_survival_amplitude_observable_source_of_threshold_root_observable_source
      ((lipschitz_bridge.ledger_of_evolution U).block n)
      (source U n)

/-- Replay-indexed generated quartic source.

This is a general source object for finite or symbolic replay families that are
selected before payoff and then identified with generated Lipschitz blocks.  It
turns the replay into a typed source map instead of a loose comment like "this
block is the Phase 5FB row": the block equality, observable/source receipts, and
gain cap are all fields. -/
structure ReplayIndexedGeneratedQuarticSource
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  ReplayIdx : Type u
  replayOf : NSEvolution → ℕ → ReplayIdx
  replayBlock : ReplayIdx → FullLedgerBlock
  replayObservable : ReplayIdx → SignedObservable
  replayAmpSq : ReplayIdx → Real
  replay_declared_before_payoff : ∀ (_U : NSEvolution) (_n : ℕ), Prop
  replay_declared_before_payoff_paid :
    ∀ (U : NSEvolution) (n : ℕ),
      replay_declared_before_payoff U n
  replay_block_eq_generated :
    ∀ (U : NSEvolution) (n : ℕ),
      replayBlock (replayOf U n) =
        ((lipschitz_bridge.ledger_of_evolution U).block n)
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (replayObservable (replayOf U n))
  observable_match :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (replayObservable (replayOf U n))
        (replayAmpSq (replayOf U n))
  root_ledger_match :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalRootDefectLedgerMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (replayObservable (replayOf U n))
        (replayAmpSq (replayOf U n))
  gamma_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ),
      0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  amp_sq_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ), 0 ≤ replayAmpSq (replayOf U n)
  amp_sq_le_one :
    ∀ (U : NSEvolution) (n : ℕ), replayAmpSq (replayOf U n) ≤ 1
  survival_profit_le_replay_gain :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          replayAmpSq (replayOf U n)
  replay_gain_le_target :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
        replayAmpSq (replayOf U n) ≤ sharpTarget

/-- Hostile branches for a replay-indexed generated quartic source. -/
inductive ReplayIndexedGeneratedQuarticSourceFalsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : ReplayIndexedGeneratedQuarticSource lipschitz_bridge) : Type (u + 1)
    where
  | replayNotDeclared
      (U : NSEvolution) (n : ℕ) :
      ¬ S.replay_declared_before_payoff U n →
        ReplayIndexedGeneratedQuarticSourceFalsifier S
  | replayBlockMismatch
      (U : NSEvolution) (n : ℕ) :
      S.replayBlock (S.replayOf U n) ≠
        ((lipschitz_bridge.ledger_of_evolution U).block n) →
        ReplayIndexedGeneratedQuarticSourceFalsifier S
  | survivalGainFailure
      (U : NSEvolution) (n : ℕ) :
      ¬ ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          S.replayAmpSq (S.replayOf U n) →
        ReplayIndexedGeneratedQuarticSourceFalsifier S
  | replayCapFailure
      (U : NSEvolution) (n : ℕ) :
      sharpTarget <
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          S.replayAmpSq (S.replayOf U n) →
        ReplayIndexedGeneratedQuarticSourceFalsifier S
  | replayAmplitudeNegative
      (U : NSEvolution) (n : ℕ) :
      ¬ 0 ≤ S.replayAmpSq (S.replayOf U n) →
        ReplayIndexedGeneratedQuarticSourceFalsifier S
  | replayAmplitudeAmplifies
      (U : NSEvolution) (n : ℕ) :
      1 < S.replayAmpSq (S.replayOf U n) →
        ReplayIndexedGeneratedQuarticSourceFalsifier S

/-- A replay-indexed generated quartic source excludes its named hostile
branches. -/
theorem no_replay_indexed_generated_quartic_source_falsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : ReplayIndexedGeneratedQuarticSource lipschitz_bridge) :
    ReplayIndexedGeneratedQuarticSourceFalsifier S → False := by
  intro F
  cases F with
  | replayNotDeclared U n hbad =>
      exact hbad (S.replay_declared_before_payoff_paid U n)
  | replayBlockMismatch U n hbad =>
      exact hbad (S.replay_block_eq_generated U n)
  | survivalGainFailure U n hbad =>
      exact hbad (S.survival_profit_le_replay_gain U n)
  | replayCapFailure U n hbad =>
      exact not_lt_of_ge (S.replay_gain_le_target U n) hbad
  | replayAmplitudeNegative U n hbad =>
      exact hbad (S.amp_sq_nonnegative U n)
  | replayAmplitudeAmplifies U n hbad =>
      exact not_lt_of_ge (S.amp_sq_le_one U n) hbad

/-- Convert a replay-indexed source into the strong local threshold-root
observable source shape consumed by the profile/Lipschitz endpoint. -/
def generated_threshold_root_observable_sources_of_replay_indexed_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : ReplayIndexedGeneratedQuarticSource lipschitz_bridge) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalThresholdRootObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    { observable := S.replayObservable (S.replayOf U n)
      observable_fully_charged := S.observable_fully_charged U n
      ampSq := S.replayAmpSq (S.replayOf U n)
      observable_match := S.observable_match U n
      root_ledger_match := S.root_ledger_match U n
      gamma_nonnegative := S.gamma_nonnegative U n
      amp_sq_nonnegative := S.amp_sq_nonnegative U n
      amp_sq_le_one := S.amp_sq_le_one U n
      survival_profit_le_gain_at_amp :=
        S.survival_profit_le_replay_gain U n
      amp_sq_le_threshold_root := by
        intro hgt
        exact
          amp_sq_le_threshold_root_of_gain_action_cap
            ((lipschitz_bridge.ledger_of_evolution U).block n)
            hgt
            (S.replay_gain_le_target U n) }

/-- Threshold-root generated-source inputs projected from strong observable
sources.

The strong source carries the structured survival-profit match, root-ledger
match, full observable charge, and both scalar amplitude inequalities.  This
adapter only changes endpoint shape for existing constructors. -/
def generated_threshold_root_source_inputs_of_observable_sources
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootObservableSource
          ((lipschitz_bridge.ledger_of_evolution U).block n)) :
    GeneratedQuarticSurvivalThresholdRootAmplitudeSourceInputs
      lipschitz_bridge where
  threshold_root_source := by
    intro U n
    exact
      quartic_survival_threshold_root_source_of_observable_source
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (source U n)
  observable_of_generated_block := fun U n => (source U n).observable
  observable_fully_charged := fun U n =>
    (source U n).observable_fully_charged
  observable_match := by
    intro U n
    simpa [quartic_survival_threshold_root_source_of_observable_source] using
      (source U n).observable_match

/-- Exact numeric PDE frontier for generated Lipschitz threshold-root amplitude.

This is the smallest non-proven analytic primitive left after the observable
and matrix/SOS provenance are separated: choose an amplitude square for every
generated block, prove its normalization, prove the survival-profit gain cap,
and prove the root-square bound at the Track B threshold. -/
structure GeneratedLipschitzThresholdRootAmplitudeBounds
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  ampSq : NSEvolution → ℕ → Real
  gamma_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ),
      0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  amp_sq_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ), 0 ≤ ampSq U n
  amp_sq_le_one :
    ∀ (U : NSEvolution) (n : ℕ), ampSq U n ≤ 1
  survival_profit_le_gain_at_amp :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma * ampSq U n
  amp_sq_le_threshold_root :
    ∀ (U : NSEvolution) (n : ℕ),
      sharpTarget <
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma →
        ampSq U n ≤
          (Real.sqrt
            (sharpTarget /
              ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)) ^
              (2 : Nat)

/-- Generated threshold-root bounds from already constructed local
threshold-root sources.

This adapter is intentionally one-way: it extracts the numeric bound package
from a stronger source object, without using the broader amplitude projection
receipt or assuming the Track B endpoint. -/
def generated_lipschitz_threshold_root_bounds_of_threshold_root_sources
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n)) :
    GeneratedLipschitzThresholdRootAmplitudeBounds lipschitz_bridge where
  ampSq := fun U n => (source U n).ampSq
  gamma_nonnegative := fun U n => (source U n).gamma_nonnegative
  amp_sq_nonnegative := fun U n => (source U n).amp_sq_nonnegative
  amp_sq_le_one := fun U n => (source U n).amp_sq_le_one
  survival_profit_le_gain_at_amp := fun U n =>
    (source U n).survival_profit_le_gain_at_amp
  amp_sq_le_threshold_root := fun U n =>
    (source U n).amp_sq_le_threshold_root

/-- Source-facing dual gain-action cap for generated Lipschitz blocks.

This is a narrower PDE primitive than an amplitude projection receipt.  It
packages a fixed charged observable and an amplitude square, then asks the PDE
side for the dual action inequality
`gamma * ampSq <= sharpTarget`.  The threshold-root square bound is recovered
mechanically by `generated_lipschitz_threshold_root_bounds_of_gain_caps`. -/
structure GeneratedLipschitzGainActionDualSource
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  ampSq : NSEvolution → ℕ → Real
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block U n)
  gamma_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ),
      0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  amp_sq_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ), 0 ≤ ampSq U n
  amp_sq_le_one :
    ∀ (U : NSEvolution) (n : ℕ), ampSq U n ≤ 1
  survival_profit_le_gain_at_amp :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          ampSq U n
  dual_gain_action_cap :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
        ampSq U n ≤ sharpTarget

/-- Fixed-ratio version of the generated gain-action source.

This is the right Lean target for finite symbolic threshold replays such as
Phase 5FB: the symbolic audit supplies one normalized amplitude-square ratio,
while the PDE side must still prove that each generated block's survival profit
is bounded by `gamma * ratio` and that this gain action is below the sharp
target. -/
structure GeneratedLipschitzFixedAmplitudeRatioSource
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  ratio : Real
  ratio_nonnegative : 0 ≤ ratio
  ratio_le_one : ratio ≤ 1
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block U n)
  gamma_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ),
      0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  survival_profit_le_ratio_gain :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma * ratio
  ratio_gain_cap :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).gamma * ratio ≤
        sharpTarget

/-- Normalized unit-amplitude version of the generated gain-action source.

This is the clean target when a finite symbolic replay proves the below-wall
bound directly as `survivalProfit <= gamma` and the PDE side supplies the
global cap `gamma <= sharpTarget`.  It does not identify an operator response
ratio with an amplitude channel; the amplitude square is the normalized unit
channel. -/
structure GeneratedLipschitzUnitAmplitudeGainCapSource
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block U n)
  gamma_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ),
      0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  survival_profit_le_gamma :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  gamma_le_target :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
        sharpTarget

/-- A fixed-ratio source is just a generated dual gain-action source with a
constant amplitude square. -/
def generated_lipschitz_gain_action_dual_source_of_fixed_ratio_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzFixedAmplitudeRatioSource lipschitz_bridge) :
    GeneratedLipschitzGainActionDualSource lipschitz_bridge where
  ampSq := fun _U _n => S.ratio
  observable_of_generated_block := S.observable_of_generated_block
  observable_fully_charged := S.observable_fully_charged
  gamma_nonnegative := S.gamma_nonnegative
  amp_sq_nonnegative := fun _U _n => S.ratio_nonnegative
  amp_sq_le_one := fun _U _n => S.ratio_le_one
  survival_profit_le_gain_at_amp := S.survival_profit_le_ratio_gain
  dual_gain_action_cap := S.ratio_gain_cap

/-- A unit-amplitude source is a generated dual gain-action source with
`ampSq = 1`. -/
def generated_lipschitz_gain_action_dual_source_of_unit_amplitude_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge) :
    GeneratedLipschitzGainActionDualSource lipschitz_bridge where
  ampSq := fun _U _n => 1
  observable_of_generated_block := S.observable_of_generated_block
  observable_fully_charged := S.observable_fully_charged
  gamma_nonnegative := S.gamma_nonnegative
  amp_sq_nonnegative := fun _U _n => by norm_num
  amp_sq_le_one := fun _U _n => by norm_num
  survival_profit_le_gain_at_amp := by
    intro U n
    simpa using S.survival_profit_le_gamma U n
  dual_gain_action_cap := by
    intro U n
    simpa using S.gamma_le_target U n

/-- Build a normalized unit-amplitude source from any certified gamma cap.

This is the reusable interface for finite PSD/SOS replays: the replay may
prove a sharp scalar upper `cap`, while the PDE side separately proves each
generated block's gamma channel is below that cap. -/
def generated_lipschitz_unit_amplitude_source_of_gamma_cap
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_fully_charged :
      ∀ (U : NSEvolution) (n : ℕ),
        GlobalSignedObservableFullyCharged
          (observable_of_generated_block U n))
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (survival_profit_le_gamma :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    {cap : Real}
    (gamma_le_cap :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤ cap)
    (cap_le_target : cap ≤ sharpTarget) :
    GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge where
  observable_of_generated_block := observable_of_generated_block
  observable_fully_charged := observable_fully_charged
  gamma_nonnegative := gamma_nonnegative
  survival_profit_le_gamma := survival_profit_le_gamma
  gamma_le_target := fun U n => (gamma_le_cap U n).trans cap_le_target

/-- Unit-amplitude source with typed same-source observable/root provenance.

This is the normalized endpoint target after the finite/SOS side has proved a
below-wall gamma cap.  The source is not just `ampSq = 1`: it also carries the
structured receipts tying that unit amplitude to the generated block's charged
survival-profit observable and threshold-root defect ledger. -/
structure GeneratedLipschitzUnitAmplitudeObservableSource
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  gain_cap_source :
    GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge
  observable_match :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (gain_cap_source.observable_of_generated_block U n)
        (1 : Real)
  root_ledger_match :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalRootDefectLedgerMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (gain_cap_source.observable_of_generated_block U n)
        (1 : Real)

/-- Construct the unit-amplitude observable source from typed source bindings.

This is the falsification-friendly form: each provenance claim is an equality
inside a typed payload binding, not a free same-source slogan. -/
def generated_lipschitz_unit_amplitude_observable_source_of_source_bindings
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge)
    (amplitude_square_source :
      ∀ (U : NSEvolution) (n : ℕ),
        DeclaredSourceBinding
          (ObservableScalarPayload SignedObservable Real)
          { observable := S.observable_of_generated_block U n,
            scalar := (1 : Real) })
    (survival_profit_channel_source :
      ∀ (U : NSEvolution) (n : ℕ),
        DeclaredSourceBinding
          (BlockObservablePayload FullLedgerBlock SignedObservable)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := S.observable_of_generated_block U n })
    (gain_bound_source :
      ∀ (U : NSEvolution) (n : ℕ),
        DeclaredSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := S.observable_of_generated_block U n,
            scalar := (1 : Real) })
    (root_defect_source :
      ∀ (U : NSEvolution) (n : ℕ),
        NonPosthocSourceBinding
          (BlockObservablePayload FullLedgerBlock SignedObservable)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := S.observable_of_generated_block U n })
    (threshold_root_amplitude_source :
      ∀ (U : NSEvolution) (n : ℕ),
        NonPosthocSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := S.observable_of_generated_block U n,
            scalar := (1 : Real) }) :
    GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge where
  gain_cap_source := S
  observable_match := fun U n =>
    quartic_survival_amplitude_observable_match_receipt_of_source_bindings
      (S.observable_fully_charged U n)
      (amplitude_square_source U n)
      (survival_profit_channel_source U n)
      (gain_bound_source U n)
  root_ledger_match := fun U n =>
    quartic_survival_root_defect_ledger_match_receipt_of_source_bindings
      (S.observable_fully_charged U n)
      (root_defect_source U n)
      (threshold_root_amplitude_source U n)

/-- Joint source bindings for a generated unit-amplitude observable family.

This packages the five provenance payloads required to upgrade a compact
unit-amplitude gain cap into a full
`QuarticSurvivalAmplitudeObservableSource`.  It is intentionally generic in the
observable selector; Phase 5FB, matrix/SOS, phase-latency, or MV routes can all
use the same binding object. -/
structure GeneratedUnitAmplitudeJointSourceBindings
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable) where
  amplitude_square_source :
    ∀ (U : NSEvolution) (n : ℕ),
      DeclaredSourceBinding
        (ObservableScalarPayload SignedObservable Real)
        { observable := observable_of_generated_block U n,
          scalar := (1 : Real) }
  survival_profit_channel_source :
    ∀ (U : NSEvolution) (n : ℕ),
      DeclaredSourceBinding
        (BlockObservablePayload FullLedgerBlock SignedObservable)
        { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
          observable := observable_of_generated_block U n }
  gain_bound_source :
    ∀ (U : NSEvolution) (n : ℕ),
      DeclaredSourceBinding
        (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
        { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
          observable := observable_of_generated_block U n,
          scalar := (1 : Real) }
  root_defect_source :
    ∀ (U : NSEvolution) (n : ℕ),
      NonPosthocSourceBinding
        (BlockObservablePayload FullLedgerBlock SignedObservable)
        { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
          observable := observable_of_generated_block U n }
  threshold_root_amplitude_source :
    ∀ (U : NSEvolution) (n : ℕ),
      NonPosthocSourceBinding
        (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
        { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
          observable := observable_of_generated_block U n,
          scalar := (1 : Real) }

/-- Upgrade a compact unit-amplitude source using a reusable joint binding
pack. -/
def generated_lipschitz_unit_amplitude_observable_source_of_joint_bindings
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge)
    (J :
      GeneratedUnitAmplitudeJointSourceBindings
        lipschitz_bridge
        S.observable_of_generated_block) :
    GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge :=
  generated_lipschitz_unit_amplitude_observable_source_of_source_bindings
    S
    J.amplitude_square_source
    J.survival_profit_channel_source
    J.gain_bound_source
    J.root_defect_source
    J.threshold_root_amplitude_source

/-- Forget the observable provenance down to the compact unit-amplitude gain
source. -/
def generated_lipschitz_unit_amplitude_gain_cap_source_of_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge) :
    GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge :=
  S.gain_cap_source

/-- Unit-amplitude observable sources also expose the compact dual gain-action
source. -/
def generated_lipschitz_gain_action_dual_source_of_unit_amplitude_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge) :
    GeneratedLipschitzGainActionDualSource lipschitz_bridge :=
  generated_lipschitz_gain_action_dual_source_of_unit_amplitude_source
    S.gain_cap_source

/-- Phase 5FB-specialized fixed-ratio source.

The exact symbolic replay fixes only the amplitude-square ratio
`1444/3969`.  The two displayed inequalities remain the live PDE work: they
must be proved for the generated Lipschitz blocks before this source exists. -/
noncomputable def generated_lipschitz_phase5fb_global_matrix_ratio_source
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_fully_charged :
      ∀ (U : NSEvolution) (n : ℕ),
        GlobalSignedObservableFullyCharged
          (observable_of_generated_block U n))
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (survival_profit_le_phase5fb_ratio_gain :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            phase5fbLowHighClusterKGlobalMatrixLiftedRatio)
    (phase5fb_ratio_gain_cap :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            phase5fbLowHighClusterKGlobalMatrixLiftedRatio ≤
          sharpTarget) :
    GeneratedLipschitzFixedAmplitudeRatioSource lipschitz_bridge where
  ratio := phase5fbLowHighClusterKGlobalMatrixLiftedRatio
  ratio_nonnegative :=
    phase5fbLowHighClusterKGlobalMatrixLiftedRatio_nonnegative
  ratio_le_one :=
    phase5fbLowHighClusterKGlobalMatrixLiftedRatio_le_one
  observable_of_generated_block := observable_of_generated_block
  observable_fully_charged := observable_fully_charged
  gamma_nonnegative := gamma_nonnegative
  survival_profit_le_ratio_gain :=
    survival_profit_le_phase5fb_ratio_gain
  ratio_gain_cap := phase5fb_ratio_gain_cap

/-- Phase 5FB-specialized unit-amplitude source using the exact
`global_matrix` low-high cap `38/63`.

This is the normalized route suggested by the symbolic replay.  It uses the
exact scalar theorem `38/63 <= sharpTarget`, but it does not claim a generated
block has that cap: the caller must still prove `survivalProfit <= gamma` and
`gamma <= 38/63` for the block family. -/
noncomputable def generated_lipschitz_phase5fb_global_matrix_unit_amplitude_source
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_fully_charged :
      ∀ (U : NSEvolution) (n : ℕ),
        GlobalSignedObservableFullyCharged
          (observable_of_generated_block U n))
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (survival_profit_le_gamma :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (gamma_le_phase5fb_global_matrix_upper :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
          (38 : Real) / 63) :
    GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge :=
  generated_lipschitz_unit_amplitude_source_of_gamma_cap
    lipschitz_bridge
    observable_of_generated_block
    observable_fully_charged
    gamma_nonnegative
    survival_profit_le_gamma
    gamma_le_phase5fb_global_matrix_upper
    phase5fbLowHighClusterKGlobalMatrixUpper_le_sharpTarget

/-- Phase 5FB full-ledger unit-root source for the exact
`global_matrix / low_high_cluster_K` replay.

The symbolic replay proves two distinct facts for the same finite-stencil
family: the lifted global-matrix response is capped by `38/63`, and every
linear mixed response is orthogonal to every quadratic self-output.  The latter
turns the first full-ledger defect root into a contraction (`rootSq <= 1`), so
the unit channel pays `survivalProfit <= gamma` without appealing to
`FullLedgerNoSurvivor`.

This structure keeps those facts as source obligations.  It is deliberately not
a theorem about arbitrary generated blocks. -/
structure Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block U n)
  rootSq : NSEvolution → ℕ → Real
  symbolic_global_matrix_replay_prices_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), Prop
  symbolic_global_matrix_replay_prices_generated_block_paid :
    ∀ (U : NSEvolution) (n : ℕ),
      symbolic_global_matrix_replay_prices_generated_block U n
  full_ledger_linear_quadratic_orthogonality :
    ∀ (_U : NSEvolution) (_n : ℕ), Prop
  full_ledger_linear_quadratic_orthogonality_paid :
    ∀ (U : NSEvolution) (n : ℕ),
      full_ledger_linear_quadratic_orthogonality U n
  root_square_is_first_unit_defect_root :
    ∀ (_U : NSEvolution) (_n : ℕ), Prop
  root_square_is_first_unit_defect_root_paid :
    ∀ (U : NSEvolution) (n : ℕ),
      root_square_is_first_unit_defect_root U n
  gamma_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ),
      0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  root_square_le_one :
    ∀ (U : NSEvolution) (n : ℕ), rootSq U n ≤ 1
  survival_profit_eq_gamma_times_root_square :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          rootSq U n
  gamma_le_phase5fb_global_matrix_upper :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
        (38 : Real) / 63

/-- Falsifiers for the Phase 5FB full-ledger unit-root source.

These are intentionally scalar and provenance focused.  A failing branch should
produce one of: the generated block was not priced by the symbolic replay, the
linear/quadratic orthogonality did not hold for the same block, the root was not
the first unit defect root, the root amplified the unit channel, or the 38/63
cap did not apply. -/
inductive Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource
      lipschitz_bridge) :
    Type where
  | replayNotSameGeneratedBlock
      (U : NSEvolution) (n : ℕ) :
      ¬ S.symbolic_global_matrix_replay_prices_generated_block U n →
        Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S
  | orthogonalityNotPaid
      (U : NSEvolution) (n : ℕ) :
      ¬ S.full_ledger_linear_quadratic_orthogonality U n →
        Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S
  | rootNotFirstUnitDefectRoot
      (U : NSEvolution) (n : ℕ) :
      ¬ S.root_square_is_first_unit_defect_root U n →
        Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S
  | gammaNegative
      (U : NSEvolution) (n : ℕ) :
      ¬ 0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma →
        Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S
  | rootAmplifiesUnitChannel
      (U : NSEvolution) (n : ℕ) :
      1 < S.rootSq U n →
        Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S
  | survivalRootMismatch
      (U : NSEvolution) (n : ℕ) :
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≠
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          S.rootSq U n →
        Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S
  | gammaCapFailure
      (U : NSEvolution) (n : ℕ) :
      ¬ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
          (38 : Real) / 63 →
        Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S

theorem no_phase5fb_global_matrix_low_high_full_ledger_unit_root_source_falsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S :
      Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource
        lipschitz_bridge) :
    Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSourceFalsifier S →
      False := by
  intro F
  cases F with
  | replayNotSameGeneratedBlock U n hbad =>
      exact hbad
        (S.symbolic_global_matrix_replay_prices_generated_block_paid U n)
  | orthogonalityNotPaid U n hbad =>
      exact hbad
        (S.full_ledger_linear_quadratic_orthogonality_paid U n)
  | rootNotFirstUnitDefectRoot U n hbad =>
      exact hbad
        (S.root_square_is_first_unit_defect_root_paid U n)
  | gammaNegative U n hbad =>
      exact hbad (S.gamma_nonnegative U n)
  | rootAmplifiesUnitChannel U n hbad =>
      exact not_lt_of_ge (S.root_square_le_one U n) hbad
  | survivalRootMismatch U n hbad =>
      exact hbad
        (S.survival_profit_eq_gamma_times_root_square U n)
  | gammaCapFailure U n hbad =>
      exact hbad
        (S.gamma_le_phase5fb_global_matrix_upper U n)

/-- The Phase 5FB full-ledger root source yields the normalized unit-amplitude
generated source.

The proof of `survivalProfit <= gamma` is the exact root contraction:
`survivalProfit = gamma * rootSq`, `rootSq <= 1`, and `0 <= gamma`. -/
noncomputable def generated_lipschitz_unit_amplitude_source_of_phase5fb_full_ledger_root
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S :
      Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource
        lipschitz_bridge) :
    GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge :=
  generated_lipschitz_phase5fb_global_matrix_unit_amplitude_source
    lipschitz_bridge
    S.observable_of_generated_block
    S.observable_fully_charged
    S.gamma_nonnegative
    (by
      intro U n
      have hgain :
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
              S.rootSq U n ≤
            ((lipschitz_bridge.ledger_of_evolution U).block n).gamma :=
        mul_le_of_le_one_right
          (S.gamma_nonnegative U n)
          (S.root_square_le_one U n)
      rw [S.survival_profit_eq_gamma_times_root_square U n]
      exact hgain)
    S.gamma_le_phase5fb_global_matrix_upper

/-- Provenance-bearing unit-amplitude source from the Phase 5FB full-ledger
root receipt and a reusable joint binding pack. -/
noncomputable def generated_lipschitz_unit_amplitude_observable_source_of_phase5fb_full_ledger_root
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S :
      Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource
        lipschitz_bridge)
    (J :
      GeneratedUnitAmplitudeJointSourceBindings
        lipschitz_bridge
        S.observable_of_generated_block) :
    GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge :=
  generated_lipschitz_unit_amplitude_observable_source_of_joint_bindings
    (generated_lipschitz_unit_amplitude_source_of_phase5fb_full_ledger_root S)
    J

inductive GeneratedLipschitzGainActionDualSourceFalsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzGainActionDualSource lipschitz_bridge) :
    Type where
  | observableUndercharged
      (U : NSEvolution) (n : ℕ) :
      ¬ GlobalSignedObservableFullyCharged
          (S.observable_of_generated_block U n) →
        GeneratedLipschitzGainActionDualSourceFalsifier S
  | amplitudeNegative
      (U : NSEvolution) (n : ℕ) :
      ¬ 0 ≤ S.ampSq U n →
        GeneratedLipschitzGainActionDualSourceFalsifier S
  | amplitudeAboveOne
      (U : NSEvolution) (n : ℕ) :
      ¬ S.ampSq U n ≤ 1 →
        GeneratedLipschitzGainActionDualSourceFalsifier S
  | survivalGainMismatch
      (U : NSEvolution) (n : ℕ) :
      ¬ ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            S.ampSq U n →
        GeneratedLipschitzGainActionDualSourceFalsifier S
  | dualGainCapFailure
      (U : NSEvolution) (n : ℕ) :
      ¬ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          S.ampSq U n ≤ sharpTarget →
        GeneratedLipschitzGainActionDualSourceFalsifier S

theorem no_generated_lipschitz_gain_action_dual_source_falsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzGainActionDualSource lipschitz_bridge) :
    GeneratedLipschitzGainActionDualSourceFalsifier S → False := by
  intro F
  cases F with
  | observableUndercharged U n h =>
      exact h (S.observable_fully_charged U n)
  | amplitudeNegative U n h =>
      exact h (S.amp_sq_nonnegative U n)
  | amplitudeAboveOne U n h =>
      exact h (S.amp_sq_le_one U n)
  | survivalGainMismatch U n h =>
      exact h (S.survival_profit_le_gain_at_amp U n)
  | dualGainCapFailure U n h =>
      exact h (S.dual_gain_action_cap U n)

/-- A generated dual gain-action source is already a no-survivor source for
each generated Lipschitz block.

This is the anti-tautology read of the compact source: proving the dual action
cap is not a minor routing fact. Together with the survival-profit gain bound
it directly proves the sharp survival cap for the generated block. -/
theorem no_survivor_of_generated_lipschitz_gain_action_dual_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzGainActionDualSource lipschitz_bridge)
    (U : NSEvolution) (n : ℕ) :
    FullLedgerNoSurvivor
      ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  unfold FullLedgerNoSurvivor
  exact
    (S.survival_profit_le_gain_at_amp U n).trans
      (S.dual_gain_action_cap U n)

/-- A fixed-ratio source already rules out generated-block survivors, because
the ratio gain cap is the no-survivor inequality in compact form. -/
theorem no_survivor_of_generated_lipschitz_fixed_ratio_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzFixedAmplitudeRatioSource lipschitz_bridge)
    (U : NSEvolution) (n : ℕ) :
    FullLedgerNoSurvivor
      ((lipschitz_bridge.ledger_of_evolution U).block n) :=
  no_survivor_of_generated_lipschitz_gain_action_dual_source
    (generated_lipschitz_gain_action_dual_source_of_fixed_ratio_source S)
    U n

/-- Unit-amplitude generated sources also rule out survivors once the block
gamma is below the sharp target. -/
theorem no_survivor_of_generated_lipschitz_unit_amplitude_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeGainCapSource lipschitz_bridge)
    (U : NSEvolution) (n : ℕ) :
    FullLedgerNoSurvivor
      ((lipschitz_bridge.ledger_of_evolution U).block n) :=
  no_survivor_of_generated_lipschitz_gain_action_dual_source
    (generated_lipschitz_gain_action_dual_source_of_unit_amplitude_source S)
    U n

/-- The provenance-bearing unit-amplitude source also rules out generated-block
survivors through its compact gain-cap component. -/
theorem no_survivor_of_generated_lipschitz_unit_amplitude_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge)
    (U : NSEvolution) (n : ℕ) :
    FullLedgerNoSurvivor
      ((lipschitz_bridge.ledger_of_evolution U).block n) :=
  no_survivor_of_generated_lipschitz_gain_action_dual_source
    (generated_lipschitz_gain_action_dual_source_of_unit_amplitude_observable_source S)
    U n

/-- Threshold-root generated inputs expose the narrower dual gain-action
source.

This is only a projection of an already-paid threshold-root source: it does not
invent the PDE amplitude estimate.  Its value is that downstream constructors
can target the compact dual-action interface when the root-square source is
already available. -/
def generated_lipschitz_gain_action_dual_source_of_threshold_root_inputs
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (I :
      GeneratedQuarticSurvivalThresholdRootAmplitudeSourceInputs
        lipschitz_bridge) :
    GeneratedLipschitzGainActionDualSource lipschitz_bridge where
  ampSq := fun U n => (I.threshold_root_source U n).ampSq
  observable_of_generated_block := I.observable_of_generated_block
  observable_fully_charged := I.observable_fully_charged
  gamma_nonnegative := fun U n =>
    (I.threshold_root_source U n).gamma_nonnegative
  amp_sq_nonnegative := fun U n =>
    (I.threshold_root_source U n).amp_sq_nonnegative
  amp_sq_le_one := fun U n =>
    (I.threshold_root_source U n).amp_sq_le_one
  survival_profit_le_gain_at_amp := fun U n =>
    (I.threshold_root_source U n).survival_profit_le_gain_at_amp
  dual_gain_action_cap := fun U n =>
    gain_at_amp_le_target_of_quartic_survival_threshold_root_source
      ((lipschitz_bridge.ledger_of_evolution U).block n)
      (I.threshold_root_source U n)

/-- Action-sandwich source for generated Lipschitz blocks.

This is the PDE-facing split of the dual cap.  A proof may naturally control a
declared action functional first, then identify it with `gamma * ampSq`.  The
cap is valid only when the action channel is declared before payoff scoring,
the survival profit is below that action, the action is below the sharp target,
and the action is exactly the gain-at-amplitude quantity. -/
structure GeneratedLipschitzActionSandwichDualSource
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  ampSq : NSEvolution → ℕ → Real
  action : NSEvolution → ℕ → Real
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ (U : NSEvolution) (n : ℕ),
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block U n)
  action_channel_declared_before_payoff :
    ∀ (_U : NSEvolution) (_n : ℕ), Prop
  action_channel_declared_before_payoff_paid :
    ∀ (U : NSEvolution) (n : ℕ),
      action_channel_declared_before_payoff U n
  gamma_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ),
      0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma
  amp_sq_nonnegative :
    ∀ (U : NSEvolution) (n : ℕ), 0 ≤ ampSq U n
  amp_sq_le_one :
    ∀ (U : NSEvolution) (n : ℕ), ampSq U n ≤ 1
  action_eq_gain_at_amp :
    ∀ (U : NSEvolution) (n : ℕ),
      action U n =
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          ampSq U n
  survival_profit_le_action :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
        action U n
  action_le_target :
    ∀ (U : NSEvolution) (n : ℕ), action U n ≤ sharpTarget

inductive GeneratedLipschitzActionSandwichDualSourceFalsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzActionSandwichDualSource lipschitz_bridge) :
    Type where
  | observableUndercharged
      (U : NSEvolution) (n : ℕ) :
      ¬ GlobalSignedObservableFullyCharged
          (S.observable_of_generated_block U n) →
        GeneratedLipschitzActionSandwichDualSourceFalsifier S
  | actionChannelPosthoc
      (U : NSEvolution) (n : ℕ) :
      ¬ S.action_channel_declared_before_payoff U n →
        GeneratedLipschitzActionSandwichDualSourceFalsifier S
  | amplitudeNegative
      (U : NSEvolution) (n : ℕ) :
      ¬ 0 ≤ S.ampSq U n →
        GeneratedLipschitzActionSandwichDualSourceFalsifier S
  | amplitudeAboveOne
      (U : NSEvolution) (n : ℕ) :
      ¬ S.ampSq U n ≤ 1 →
        GeneratedLipschitzActionSandwichDualSourceFalsifier S
  | actionGainMismatch
      (U : NSEvolution) (n : ℕ) :
      S.action U n ≠
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            S.ampSq U n →
        GeneratedLipschitzActionSandwichDualSourceFalsifier S
  | survivalActionMismatch
      (U : NSEvolution) (n : ℕ) :
      ¬ ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
          S.action U n →
        GeneratedLipschitzActionSandwichDualSourceFalsifier S
  | actionTargetFailure
      (U : NSEvolution) (n : ℕ) :
      ¬ S.action U n ≤ sharpTarget →
        GeneratedLipschitzActionSandwichDualSourceFalsifier S

theorem no_generated_lipschitz_action_sandwich_dual_source_falsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzActionSandwichDualSource lipschitz_bridge) :
    GeneratedLipschitzActionSandwichDualSourceFalsifier S → False := by
  intro F
  cases F with
  | observableUndercharged U n h =>
      exact h (S.observable_fully_charged U n)
  | actionChannelPosthoc U n h =>
      exact h (S.action_channel_declared_before_payoff_paid U n)
  | amplitudeNegative U n h =>
      exact h (S.amp_sq_nonnegative U n)
  | amplitudeAboveOne U n h =>
      exact h (S.amp_sq_le_one U n)
  | actionGainMismatch U n h =>
      exact h (S.action_eq_gain_at_amp U n)
  | survivalActionMismatch U n h =>
      exact h (S.survival_profit_le_action U n)
  | actionTargetFailure U n h =>
      exact h (S.action_le_target U n)

/-- A generated action-sandwich source is also a direct no-survivor source. -/
theorem no_survivor_of_generated_lipschitz_action_sandwich_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzActionSandwichDualSource lipschitz_bridge)
    (U : NSEvolution) (n : ℕ) :
    FullLedgerNoSurvivor
      ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  unfold FullLedgerNoSurvivor
  exact (S.survival_profit_le_action U n).trans (S.action_le_target U n)

/-- Promote a compact generated gain-action source to the action-sandwich
surface once the action channel has been predeclared.

This constructor is intentionally not free: `GeneratedLipschitzGainActionDualSource`
already pays the real cap `gamma * ampSq <= sharpTarget`, but it does not by
itself say that the action channel was declared before payoff scoring.  The
caller must still supply that provenance guard. -/
def generated_lipschitz_action_sandwich_dual_source_of_gain_action_dual_source
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (S : GeneratedLipschitzGainActionDualSource lipschitz_bridge)
    (action_channel_declared_before_payoff :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (action_channel_declared_before_payoff_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        action_channel_declared_before_payoff U n) :
    GeneratedLipschitzActionSandwichDualSource lipschitz_bridge where
  ampSq := S.ampSq
  action := fun U n =>
    ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
      S.ampSq U n
  observable_of_generated_block := S.observable_of_generated_block
  observable_fully_charged := S.observable_fully_charged
  action_channel_declared_before_payoff :=
    action_channel_declared_before_payoff
  action_channel_declared_before_payoff_paid :=
    action_channel_declared_before_payoff_paid
  gamma_nonnegative := S.gamma_nonnegative
  amp_sq_nonnegative := S.amp_sq_nonnegative
  amp_sq_le_one := S.amp_sq_le_one
  action_eq_gain_at_amp := by
    intro U n
    rfl
  survival_profit_le_action := S.survival_profit_le_gain_at_amp
  action_le_target := S.dual_gain_action_cap

/-- Threshold-root generated inputs also lift to the action-sandwich surface
when the action channel provenance is paid.

The threshold-root source pays the cap; this adapter only chooses the explicit
action functional to be the paid gain-at-amplitude quantity and carries the
separate no-posthoc action-channel guard. -/
def generated_lipschitz_action_sandwich_dual_source_of_threshold_root_inputs
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (I :
      GeneratedQuarticSurvivalThresholdRootAmplitudeSourceInputs
        lipschitz_bridge)
    (action_channel_declared_before_payoff :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (action_channel_declared_before_payoff_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        action_channel_declared_before_payoff U n) :
    GeneratedLipschitzActionSandwichDualSource lipschitz_bridge :=
  generated_lipschitz_action_sandwich_dual_source_of_gain_action_dual_source
    lipschitz_bridge
    (generated_lipschitz_gain_action_dual_source_of_threshold_root_inputs
      lipschitz_bridge
      I)
    action_channel_declared_before_payoff
    action_channel_declared_before_payoff_paid

/-- Forget an action-sandwich source down to the compact dual gain-action
source consumed by the existing threshold-root constructors. -/
def generated_lipschitz_gain_action_dual_source_of_action_sandwich
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (S : GeneratedLipschitzActionSandwichDualSource lipschitz_bridge) :
    GeneratedLipschitzGainActionDualSource lipschitz_bridge where
  ampSq := S.ampSq
  observable_of_generated_block := S.observable_of_generated_block
  observable_fully_charged := S.observable_fully_charged
  gamma_nonnegative := S.gamma_nonnegative
  amp_sq_nonnegative := S.amp_sq_nonnegative
  amp_sq_le_one := S.amp_sq_le_one
  survival_profit_le_gain_at_amp := by
    intro U n
    have hsurv := S.survival_profit_le_action U n
    simpa [S.action_eq_gain_at_amp U n] using hsurv
  dual_gain_action_cap := by
    intro U n
    have hcap := S.action_le_target U n
    simpa [S.action_eq_gain_at_amp U n] using hcap

/-- Dual gain-action source projected to generated threshold-root amplitude
