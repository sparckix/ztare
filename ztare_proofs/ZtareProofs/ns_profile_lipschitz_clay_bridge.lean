/-- Strong generated threshold-root observable sources from matrix parts plus
root-bound and provenance receipts.

The scalar amplitude projection in `P` already pays
`survival_profit_le_gain_at_amp`, `gamma_nonnegative`, `amp_sq_nonnegative`, and
`amp_sq_le_one` for the generated block.  The only remaining source facts are
the structured observable/root-ledger matches and the actual threshold-root
amplitude bound. -/
def generated_threshold_root_observable_sources_of_matrix_parts
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (observable_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeObservableMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (generated_matrix_block_observable_of_parts P U n)
          ((P.amplitude_projection U n).ampSq))
    (root_ledger_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalRootDefectLedgerMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (generated_matrix_block_observable_of_parts P U n)
          ((P.amplitude_projection U n).ampSq))
    (amp_sq_le_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        sharpTarget <
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma →
          (P.amplitude_projection U n).ampSq ≤
            (Real.sqrt
              (sharpTarget /
                ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)) ^
                (2 : Nat)) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalThresholdRootObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    { observable := generated_matrix_block_observable_of_parts P U n
      observable_fully_charged :=
        generated_matrix_block_observable_fully_charged_of_parts P U n
      ampSq := (P.amplitude_projection U n).ampSq
      observable_match := observable_match U n
      root_ledger_match := root_ledger_match U n
      gamma_nonnegative := (P.amplitude_projection U n).gamma_nonnegative
      amp_sq_nonnegative := (P.amplitude_projection U n).amp_sq_nonnegative
      amp_sq_le_one := (P.amplitude_projection U n).amp_sq_le_one
      survival_profit_le_gain_at_amp :=
        (P.amplitude_projection U n).survival_profit_le_gain_at_amp
      amp_sq_le_threshold_root :=
        amp_sq_le_threshold_root U n }

/-- Threshold-root matrix parts preserve the same amplitude square after the
compact generated-amplitude projection is formed.

The statement is intentionally only an identity reducer: it does not construct
an observable/source match, but it lets a real match receipt over the
threshold-root amplitude square be transported to the compact projection used
by existing generated-source constructors. -/
theorem generated_matrix_block_threshold_root_ampSq_eq_parts_projection
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (matrix_branch :
      ∀ (_U : NSEvolution) (_n : ℕ), MatrixBlockSOSBranchReceipt)
    (matrix_branch_prices_generated_block :
      ∀ (U : NSEvolution) (n : ℕ),
        (matrix_branch U n).block =
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (U : NSEvolution) (n : ℕ) :
    ((generated_matrix_block_amplitude_source_parts_of_threshold_root_sources
      lipschitz_bridge
      threshold_root_source
      matrix_branch
      matrix_branch_prices_generated_block).amplitude_projection U n).ampSq =
        (threshold_root_source U n).ampSq := by
  rfl

/-- Threshold-root generated-amplitude inputs from matrix-branch parts.

The matrix side supplies only the observable and its full-charge receipt.  The
caller must still provide the typed observable/source match for the generated
block, the matrix-branch observable, and the threshold-root amplitude square.
The generated-block identity remains visible through
`GeneratedMatrixBlockAmplitudeSourceParts.matrix_branch_prices_generated_block`;
no match field is synthesized from the SOS receipt. -/
def generated_threshold_root_source_inputs_of_matrix_parts
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (observable_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeObservableMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (generated_matrix_block_observable_of_parts P U n)
          ((threshold_root_source U n).ampSq)) :
    GeneratedQuarticSurvivalThresholdRootAmplitudeSourceInputs
      lipschitz_bridge where
  threshold_root_source := threshold_root_source
  observable_of_generated_block :=
    generated_matrix_block_observable_of_parts P
  observable_fully_charged :=
    generated_matrix_block_observable_fully_charged_of_parts P
  observable_match := by
    intro U n
    exact observable_match U n

/-- Compact generated-amplitude inputs from threshold-root matrix parts.

This is the direct gap reducer for the existing compact input bundle: the
scalar projection comes from `GeneratedMatrixBlockAmplitudeSourceParts`, the
observable and full-charge receipt come from the matrix/SOS branch, and the
only remaining source assumption is a real
`QuarticSurvivalAmplitudeObservableMatchReceipt`. -/
def generated_amplitude_source_inputs_of_threshold_root_matrix_parts
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (parts_ampSq_matches_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        (P.amplitude_projection U n).ampSq =
          (threshold_root_source U n).ampSq)
    (observable_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeObservableMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (generated_matrix_block_observable_of_parts P U n)
          ((threshold_root_source U n).ampSq)) :
    GeneratedQuarticSurvivalAmplitudeSourceInputs lipschitz_bridge where
  amplitude_projection := P.amplitude_projection
  observable_of_generated_block :=
    generated_matrix_block_observable_of_parts P
  observable_fully_charged :=
    generated_matrix_block_observable_fully_charged_of_parts P
  observable_match := by
    intro U n
    have hamp := parts_ampSq_matches_threshold_root U n
    simpa [hamp] using observable_match U n

/-- Explicit gap left by matrix SOS/PSD receipts when constructing generated
amplitude-source inputs: the structured observable/source match for the exact
generated block, observable, and amplitude square may still be absent.

This is the Lean-side falsifier for a closure attempt that has matrix
observables and scalar amplitude projections but no same-source match receipt.
-/
inductive GeneratedMatrixBlockAmplitudeSourceInputsGap
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge) :
    Type where
  | missingObservableSourceMatch
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (QuarticSurvivalAmplitudeObservableMatchReceipt
            ((lipschitz_bridge.ledger_of_evolution U).block n)
            (generated_matrix_block_observable_of_parts P U n)
            ((P.amplitude_projection U n).ampSq))) →
        GeneratedMatrixBlockAmplitudeSourceInputsGap P

/-- Typed scalar-inclusive source-binding gaps left by generated matrix parts.

Matrix parts identify the generated block with the matrix branch block and give
a fully charged observable. They do not, by themselves, identify the amplitude
square or gain-bound scalar source with that same observable. -/
inductive GeneratedMatrixBlockTypedSourceBindingGap
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge) :
    Type where
  | missingAmplitudeSquareSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (DeclaredSourceBinding
          (ObservableScalarPayload SignedObservable Real)
          { observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })) →
        GeneratedMatrixBlockTypedSourceBindingGap P
  | missingGainBoundSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (DeclaredSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })) →
        GeneratedMatrixBlockTypedSourceBindingGap P
  | missingThresholdRootAmplitudeSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (NonPosthocSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })) →
        GeneratedMatrixBlockTypedSourceBindingGap P

/-- Completion rule for the generated matrix-block typed-binding surface.

If the three scalar-inclusive source-binding families exist, the typed binding
gap cannot fire. This is intentionally conditional: it does not manufacture the
source bindings, but it makes the exact completion boundary type-checkable. -/
theorem no_generated_matrix_block_typed_source_binding_gap
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (amplitude_square_source :
      ∀ (U : NSEvolution) (n : ℕ),
        DeclaredSourceBinding
          (ObservableScalarPayload SignedObservable Real)
          { observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })
    (gain_bound_source :
      ∀ (U : NSEvolution) (n : ℕ),
        DeclaredSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })
    (threshold_root_amplitude_source :
      ∀ (U : NSEvolution) (n : ℕ),
        NonPosthocSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq }) :
    GeneratedMatrixBlockTypedSourceBindingGap P → False := by
  intro G
  cases G with
  | missingAmplitudeSquareSource U n h =>
      exact h ⟨amplitude_square_source U n⟩
  | missingGainBoundSource U n h =>
      exact h ⟨gain_bound_source U n⟩
  | missingThresholdRootAmplitudeSource U n h =>
      exact h ⟨threshold_root_amplitude_source U n⟩

/-- Amplitude-square typed binding supplied by a threshold-root amplitude
source family.

The binding source is the threshold-root source's own amplitude square, not the
target payload copied back into itself.  The caller pays the identity between
that source amplitude and the compact generated projection. -/
def generated_matrix_amplitude_square_source_binding_of_threshold_root_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (parts_ampSq_matches_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        (P.amplitude_projection U n).ampSq =
          (threshold_root_source U n).ampSq)
    (U : NSEvolution) (n : ℕ) :
    DeclaredSourceBinding
      (ObservableScalarPayload SignedObservable Real)
      { observable := generated_matrix_block_observable_of_parts P U n,
        scalar := (P.amplitude_projection U n).ampSq } where
  source :=
    { observable := generated_matrix_block_observable_of_parts P U n,
      scalar := (threshold_root_source U n).ampSq }
  source_eq_target := by
    simp [parts_ampSq_matches_threshold_root U n]
  declared_before_use :=
    (threshold_root_source U n).survival_observable_fixed_before_defect_scoring
  declared_before_use_paid :=
    (threshold_root_source U n).survival_observable_fixed_before_defect_scoring_paid

