/-- Hostile surface for the one-sided continuum/Phase 5FB alignment source.

These are the two mathematically meaningful ways the weaker LSC corridor can
fail: the continuum all-output payoff has escaped the declared profile family,
or the declared family price is not dominated by the continuum self-tax target.
-/
inductive ContinuumPhase5FBSigmaObservableInequalityAlignmentSourceFalsifier
    {τ : ContinuumLPProfileTopology.{u}}
    {profile_family_of_block : FullLedgerBlock → PricingProfileFamily}
    {self_tax_source :
      LeraySelfTaxContinuumAllOutputProfilePriceStreamFamilySource τ}
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S :
      ContinuumPhase5FBSigmaObservableInequalityAlignmentSource
        profile_family_of_block self_tax_source lipschitz_bridge) :
    Type where
  | continuumPayoffEscapesProfile
      (B : FullLedgerBlock) (hglobal : IsGlobalTrackBBlock B) :
      familyPayoff (profile_family_of_block B) <
        (self_tax_source.all_output_source_of_global B hglobal).stream.smoothCandidatePayoff →
        ContinuumPhase5FBSigmaObservableInequalityAlignmentSourceFalsifier S
  | profilePriceEscapesContinuum
      (B : FullLedgerBlock) (hglobal : IsGlobalTrackBBlock B) :
      continuumGlobalSelfTaxTarget
          ((self_tax_source.all_output_source_of_global B hglobal).stream) <
        familyPrice (profile_family_of_block B) →
        ContinuumPhase5FBSigmaObservableInequalityAlignmentSourceFalsifier S

/-- A one-sided continuum/Phase 5FB alignment source rules out the two named
LSC escape branches. -/
theorem no_continuum_phase5fb_sigma_observable_inequality_alignment_source_falsifier
    {τ : ContinuumLPProfileTopology.{u}}
    {profile_family_of_block : FullLedgerBlock → PricingProfileFamily}
    {self_tax_source :
      LeraySelfTaxContinuumAllOutputProfilePriceStreamFamilySource τ}
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S :
      ContinuumPhase5FBSigmaObservableInequalityAlignmentSource
        profile_family_of_block self_tax_source lipschitz_bridge)
    (F :
      ContinuumPhase5FBSigmaObservableInequalityAlignmentSourceFalsifier S) :
    False := by
  cases F with
  | continuumPayoffEscapesProfile B hglobal hbad =>
      exact
        not_lt_of_ge
          (S.alignment.continuum_payoff_le_family_payoff B hglobal)
          hbad
  | profilePriceEscapesContinuum B hglobal hbad =>
      exact
        not_lt_of_ge
          (S.alignment.family_price_le_continuum B hglobal)
          hbad

