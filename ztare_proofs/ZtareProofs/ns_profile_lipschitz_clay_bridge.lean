/-- The joint source-binding object projects to the two generated-block
provenance receipts needed by the self-tax/matrix route. -/
def GeneratedMatrixBlockJointSourceBindings.to_provenance_receipts
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge}
    (J : GeneratedMatrixBlockJointSourceBindings P) :
