    J.root_defect_no_posthoc_selection
    J.root_defect_no_posthoc_selection_paid
    J.threshold_root_amplitude_source

/-- A real threshold-root source family supplies the full joint source map for
generated matrix parts once its amplitude square is identified with the compact
matrix projection.

This keeps the direction honest: the source object is the threshold-root
family, and the generated matrix route only transports its scalar through the
explicit `parts_ampSq_matches_threshold_root` identity. -/
def generated_matrix_block_joint_source_bindings_of_threshold_root_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (parts_ampSq_matches_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        (P.amplitude_projection U n).ampSq =
          (threshold_root_source U n).ampSq) :
    GeneratedMatrixBlockJointSourceBindings P where
  amplitude_square_source :=
    generated_matrix_amplitude_square_source_binding_of_threshold_root_source
      P threshold_root_source parts_ampSq_matches_threshold_root
  survival_profit_channel_declared_before_payoff :=
    fun U n =>
      (threshold_root_source U n).survival_observable_fixed_before_defect_scoring
  survival_profit_channel_declared_before_payoff_paid :=
    fun U n =>
      (threshold_root_source U n).survival_observable_fixed_before_defect_scoring_paid
  gain_bound_source :=
    generated_matrix_gain_bound_source_binding_of_threshold_root_source
      P threshold_root_source parts_ampSq_matches_threshold_root
  root_defect_block_declared_before_scoring :=
    fun U n =>
      (threshold_root_source U n).survival_observable_fixed_before_defect_scoring
