    hgt hdefect

/-- Hostile surface for the trajectory-level profile/Lipschitz source.

The branches are intentionally pre-endpoint: fixed-family source receipt,
same-family profile bundle, and per-block charged-observable amplitude source.
-/
inductive TrackBProfileLipschitzTrajectoryControlSourceFalsifier
    (S : TrackBProfileLipschitzTrajectoryControlSource) : Type where
  | profileSourceFailure :
      TrackBProfileDecompositionSourceFalsifier
        S.profile_obligation.source_receipt →
        TrackBProfileLipschitzTrajectoryControlSourceFalsifier S
  | profileBundleFailure :
      TrackBProfileDecompositionBridgeBundleFalsifier S.profile_bundle →
        TrackBProfileLipschitzTrajectoryControlSourceFalsifier S
  | amplitudeSourceFailure
      (n : ℕ) :
      QuarticSurvivalAmplitudeObservableSourceFalsifier
        ((S.lipschitz_bridge.ledger_of_evolution
          (S.evolution_of_initial_data S.initialData)).block n)
        (S.generated_amplitude_source n) →
        TrackBProfileLipschitzTrajectoryControlSourceFalsifier S

/-- A trajectory source excludes the named source, family, and amplitude
falsifiers without invoking no-survivor or endpoint closure. -/
theorem no_trackB_profile_lipschitz_trajectory_control_source_falsifier
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (F : TrackBProfileLipschitzTrajectoryControlSourceFalsifier S) :
    False := by
  cases F with
  | profileSourceFailure h =>
      exact
        no_trackb_profile_decomposition_source_receipt_of_falsifier
          S.profile_obligation.source_receipt h
  | profileBundleFailure h =>
      exact
        no_trackb_profile_decomposition_bridge_bundle_falsifier
          S.profile_bundle h
  | amplitudeSourceFailure n h =>
      exact
        no_quartic_survival_amplitude_observable_source_falsifier
          ((S.lipschitz_bridge.ledger_of_evolution
            (S.evolution_of_initial_data S.initialData)).block n)
          (S.generated_amplitude_source n)
          h

/-- Trajectory-level diagonal obstruction.

If any generated Lipschitz block is merely the abstract unlinked ledger
counterexample, then the trajectory source cannot exist.  This is the
metatheoretic reason endpoint-level prompting stalls: the missing theorem is
not another profile wrapper, but a linked survival-observable invariant for the
generated PDE block. -/
theorem no_trackB_profile_lipschitz_trajectory_source_for_unlinked_generated_block
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (n : ℕ)
    (hblock :
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n) =
          thresholdDefectButSurvivalProfitUnlinkedLedger) :
    False := by
  have hsource := S.generated_amplitude_source n
  rw [hblock] at hsource
  exact
    no_quartic_survival_amplitude_observable_source_for_unlinked_counterexample
      ⟨hsource⟩

/-- One generated block on a trajectory source has no survivor.

This is the local version of
`generated_lipschitz_block_no_survivor_of_profile_lipschitz_source`: it uses the
same profile-bundle threshold defects and the same amplitude-source projection,
but avoids first building a global source over arbitrary evolutions. -/
theorem generated_lipschitz_block_no_survivor_of_trajectory_source
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (n : ℕ) :
    FullLedgerNoSurvivor
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n) := by
  let U := S.evolution_of_initial_data S.initialData
  let L := S.lipschitz_bridge.ledger_of_evolution U
  let B := L.block n
  have hglobal : IsGlobalTrackBBlock B :=
    (S.lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n
  have hthresholds :
      ThresholdDefectConvexity B ∧
        ThresholdDefectConvexity B ∧
          ThresholdDefectConvexity B ∧
            ThresholdDefectConvexity B :=
    threshold_defects_of_all_trackb_profile_decomposition_branches
      S.profile_obligation B hglobal
  exact
    full_ledger_no_survivor_of_quartic_survival_amplitude_projection
      B
      (S.generated_amplitude_projection n)
      hthresholds.2.2.2

/-- Trajectory-level profile/Lipschitz control closes the critical-control
predicate for that initial datum.

The proof is the same continuation handoff as the endpoint version, but it is
parameterized by a single source trajectory.  A final proof can quantify over
`initialData` after constructing this source family. -/
theorem critical_control_of_trackB_profile_lipschitz_trajectory_source
    (S : TrackBProfileLipschitzTrajectoryControlSource) :
    (S.evolution_of_initial_data S.initialData).criticalControl := by
  let U := S.evolution_of_initial_data S.initialData
  let L := S.lipschitz_bridge.ledger_of_evolution U
  have hblocks : ∀ n : ℕ, FullLedgerNoSurvivor (L.block n) := by
    intro n
    exact generated_lipschitz_block_no_survivor_of_trajectory_source S n
  have hcrit : L.U.criticalControl :=
    critical_control_of_audited_low_frequency_lipschitz_certificate
      L
      (S.lipschitz_bridge.audited_certificate_of_evolution U)
      hblocks
  rw [S.lipschitz_bridge.ledger_evolution_eq U] at hcrit
  exact hcrit

/-- Single-trajectory profile/Lipschitz control feeds the standard
continuation criterion.

This is the trajectory analogue of
`global_regular_of_trackB_profile_lipschitz_closure`: it exposes the smaller
object needed for one initial datum before the final Clay statement quantifies
over all initial data. -/
theorem global_regular_of_trackB_profile_lipschitz_trajectory_source
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (continuation : NSContinuationCriterion)
    (hsmooth : (S.evolution_of_initial_data S.initialData).smoothOnLocalInterval)
    (henergy : (S.evolution_of_initial_data S.initialData).finiteEnergyInequality) :
    (S.evolution_of_initial_data S.initialData).globalRegular :=
  continuation.continues
    (S.evolution_of_initial_data S.initialData)
    hsmooth
    henergy
    (critical_control_of_trackB_profile_lipschitz_trajectory_source S)

/-- Trajectory-level Phase 5FB linked-observable source.

This is the level-separated replacement for trying to synthesize a global
`∀ U n` amplitude source.  The finite replay/source identity is required only
on the generated trajectory, while the constructed output is the exact
trajectory amplitude source consumed by
`TrackBProfileLipschitzTrajectoryControlSource`.

The source still carries the hard analytic facts explicitly: same-block replay,
fully charged observable and observable/root-ledger matches.  The exact root
contraction, gamma nonnegativity, and `38/63` cap are read from the typed replay
payload itself. -/
structure TrackBProfileLipschitzTrajectoryPhase5FBObservableSource where
  evolution_of_initial_data : SmoothNSInitialData → NSEvolution
  initialData : SmoothNSInitialData
  profile_bundle : TrackBProfileDecompositionBridgeBundle
  lipschitz_bridge : LowFrequencyLipschitzBridge
  observable_of_generated_block :
    ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable
  observable_fully_charged :
    ∀ n : ℕ,
      GlobalSignedObservableFullyCharged
        (observable_of_generated_block
          (evolution_of_initial_data initialData) n)
  typed_replay_source :
    ∀ n : ℕ,
      Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
        (lipschitz_bridge := lipschitz_bridge)
        observable_of_generated_block
        (evolution_of_initial_data initialData)
        n
  observable_match :
    ∀ n : ℕ,
      QuarticSurvivalAmplitudeObservableMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution
          (evolution_of_initial_data initialData)).block n)
        (observable_of_generated_block
          (evolution_of_initial_data initialData) n)
        (1 : Real)
  root_ledger_match :
    ∀ n : ℕ,
      QuarticSurvivalRootDefectLedgerMatchReceipt
        ((lipschitz_bridge.ledger_of_evolution
          (evolution_of_initial_data initialData)).block n)
        (observable_of_generated_block
          (evolution_of_initial_data initialData) n)
        (1 : Real)

/-- Local Phase 5FB source for one generated block on the trajectory. -/
noncomputable def TrackBProfileLipschitzTrajectoryPhase5FBObservableSource.thresholdRootObservableSource
    (S : TrackBProfileLipschitzTrajectoryPhase5FBObservableSource)
    (n : ℕ) :
    QuarticSurvivalThresholdRootObservableSource
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n) :=
  { observable :=
      S.observable_of_generated_block
        (S.evolution_of_initial_data S.initialData) n
    observable_fully_charged := S.observable_fully_charged n
    ampSq := 1
    observable_match := S.observable_match n
    root_ledger_match := S.root_ledger_match n
    gamma_nonnegative :=
      phase5fb_gamma_nonnegative_of_typed_generated_observable_source
        (S.typed_replay_source n)
    amp_sq_nonnegative := by norm_num
    amp_sq_le_one := by norm_num
    survival_profit_le_gain_at_amp := by
      have hroot :
          ((S.lipschitz_bridge.ledger_of_evolution
            (S.evolution_of_initial_data S.initialData)).block n).gamma *
              phase5fbFirstUnitDefectRootSquare
                ((S.typed_replay_source n).source.sigma) ≤
            ((S.lipschitz_bridge.ledger_of_evolution
              (S.evolution_of_initial_data S.initialData)).block n).gamma :=
        mul_le_of_le_one_right
          (phase5fb_gamma_nonnegative_of_typed_generated_observable_source
            (S.typed_replay_source n))
          (phase5fbFirstUnitDefectRootSquare_le_one
            (phase5fb_sigma_nonnegative_of_typed_generated_observable_source
              (S.typed_replay_source n)))
      rw [
        phase5fb_survival_profit_eq_symbolic_root_of_typed_generated_observable_source
          (S.typed_replay_source n)]
      simpa using hroot
    amp_sq_le_threshold_root := by
      intro hgt
      have hcap :
          ((S.lipschitz_bridge.ledger_of_evolution
            (S.evolution_of_initial_data S.initialData)).block n).gamma *
              (1 : Real) ≤ sharpTarget := by
        have hgamma :
            ((S.lipschitz_bridge.ledger_of_evolution
              (S.evolution_of_initial_data S.initialData)).block n).gamma ≤
              (38 : Real) / 63 :=
          phase5fb_gamma_cap_of_typed_generated_observable_source
            (S.typed_replay_source n)
        simpa using
          hgamma.trans phase5fbLowHighClusterKGlobalMatrixUpper_le_sharpTarget
      exact
        amp_sq_le_threshold_root_of_gain_action_cap
          ((S.lipschitz_bridge.ledger_of_evolution
            (S.evolution_of_initial_data S.initialData)).block n)
          hgt
          hcap }

/-- The local Phase 5FB source constructs the trajectory amplitude source. -/
noncomputable def TrackBProfileLipschitzTrajectoryPhase5FBObservableSource.generatedAmplitudeSource
    (S : TrackBProfileLipschitzTrajectoryPhase5FBObservableSource)
    (n : ℕ) :
    QuarticSurvivalAmplitudeObservableSource
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n) :=
  quartic_survival_amplitude_observable_source_of_threshold_root_observable_source
    ((S.lipschitz_bridge.ledger_of_evolution
      (S.evolution_of_initial_data S.initialData)).block n)
    (S.thresholdRootObservableSource n)

/-- The local Phase 5FB linked-observable source instantiates the trajectory
control source. -/
noncomputable def trackB_profile_lipschitz_trajectory_source_of_phase5fb_observable_source
    (S : TrackBProfileLipschitzTrajectoryPhase5FBObservableSource) :
    TrackBProfileLipschitzTrajectoryControlSource where
  evolution_of_initial_data := S.evolution_of_initial_data
  initialData := S.initialData
  profile_bundle := S.profile_bundle
  lipschitz_bridge := S.lipschitz_bridge
  generated_amplitude_source := S.generatedAmplitudeSource

/-- Full profile-pricing plus Lipschitz-control closure obligation with a
declared standard continuation criterion.

The handoff/GP216 spine should use `TrackBProfileLipschitzControlObligation`
unless it is directly invoking `continuation.continues`. -/
structure TrackBProfileLipschitzClayObligation extends
    TrackBProfileLipschitzControlObligation where
  continuation : NSContinuationCriterion

/-- Profile decomposition plus the generated low-frequency Lipschitz bridge
already supplies the critical-control predicate.

This exposes the continuation handoff as its own theorem: the PDE work here is
the fixed profile decomposition, quartic no-survivor projection, and generated
Lipschitz ledger.  The standard continuation criterion is a separate final
consumer of this critical-control fact. -/
theorem critical_control_of_trackB_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData) :
    (O.evolution_of_initial_data u0).criticalControl := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  have hblocks :
      ∀ n : ℕ, FullLedgerNoSurvivor (L.block n) := by
    intro n
    exact
      generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
        O u0 n
  have hcrit : L.U.criticalControl :=
    critical_control_of_audited_low_frequency_lipschitz_certificate
      L
      (O.lipschitz_bridge.audited_certificate_of_evolution U)
      hblocks
  rw [O.lipschitz_bridge.ledger_evolution_eq U] at hcrit
  exact hcrit

/-- Falsifier form of the profile/Lipschitz critical-control closure. -/
theorem no_trackB_profile_lipschitz_critical_control_falsifier
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (h : ¬ (O.evolution_of_initial_data u0).criticalControl) :
    False :=
  h (critical_control_of_trackB_profile_lipschitz_closure O u0)

/-- Profile limit passage plus low-frequency Lipschitz reserve implies the
top-level regularity conclusion.  All hard PDE content is isolated in the
fields of `TrackBProfileLipschitzClayObligation`; this theorem only checks that
the interfaces compose without changing the observable class after the fact. -/
theorem global_regular_of_trackB_profile_lipschitz_closure
    (O : TrackBProfileLipschitzClayObligation)
    (u0 : SmoothNSInitialData)
    (hsmooth : (O.evolution_of_initial_data u0).smoothOnLocalInterval)
    (henergy : (O.evolution_of_initial_data u0).finiteEnergyInequality) :
    (O.evolution_of_initial_data u0).globalRegular := by
  let U := O.evolution_of_initial_data u0
  have hcritical : U.criticalControl :=
    critical_control_of_trackB_profile_lipschitz_closure
      O.toTrackBProfileLipschitzControlObligation u0
  exact O.continuation.continues U hsmooth henergy hcritical

/-- Pointwise generated Lipschitz cost is priced by the generated reserve
price under the fixed profile/Lipschitz closure.

This exposes the local reserve-pricing edge before prefix summation or
continuation handoff.  The PDE content remains in the fixed fields of
`TrackBProfileLipschitzControlObligation`. -/
theorem generated_lipschitz_cost_le_reserve_price_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) :
    let U := O.evolution_of_initial_data u0
    let L := O.lipschitz_bridge.ledger_of_evolution U
    L.lipschitzCost n ≤ L.reservePrice n := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  have hnosurvivor :
      FullLedgerNoSurvivor (L.block n) :=
    generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
      O u0 n
  exact
    (O.lipschitz_bridge.audited_certificate_of_evolution U)
      |>.no_survivor_prices_lipschitz n hnosurvivor

/-- Every generated Lipschitz prefix is bounded by the declared critical
budget under the fixed profile/Lipschitz closure. -/
theorem generated_lipschitz_prefix_le_budget_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (N : ℕ) :
    let U := O.evolution_of_initial_data u0
    let L := O.lipschitz_bridge.ledger_of_evolution U
    lipschitzPrefixCost L N ≤ L.criticalBudget := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  have hnosurvivor :
      ∀ n : ℕ, FullLedgerNoSurvivor (L.block n) := by
    intro n
    exact
      generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
        O u0 n
  exact lipschitz_prefix_le_budget_under_audited_no_survivor
    L (O.lipschitz_bridge.audited_certificate_of_evolution U) hnosurvivor N

/-- The generated Lipschitz ledger itself cannot be underpriced at a single
entry. -/
theorem no_underpriced_lipschitz_entry_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ)
    (hunderpriced :
      let U := O.evolution_of_initial_data u0
      let L := O.lipschitz_bridge.ledger_of_evolution U
      L.reservePrice n < L.lipschitzCost n) :
    False := by
  exact not_lt_of_ge
    (generated_lipschitz_cost_le_reserve_price_of_profile_lipschitz_closure
      O u0 n)
    hunderpriced

/-- Pointwise-embedded market-impact prefixes are bounded by the generated
critical budget under the fixed profile/Lipschitz closure. -/
theorem generated_market_impact_prefix_le_budget_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (marketImpactCost : ℕ → Real)
    (hmarket :
      ∀ n : ℕ,
        marketImpactCost n ≤
          (O.lipschitz_bridge.ledger_of_evolution
            (O.evolution_of_initial_data u0)).lipschitzCost n)
    (N : ℕ) :
    let U := O.evolution_of_initial_data u0
    let L := O.lipschitz_bridge.ledger_of_evolution U
    nsPrefixSum marketImpactCost N ≤ L.criticalBudget := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  have hnosurvivor :
      ∀ n : ℕ, FullLedgerNoSurvivor (L.block n) := by
    intro n
    exact
      generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
        O u0 n
  exact market_impact_prefix_le_budget_under_audited_no_survivor
    L (O.lipschitz_bridge.audited_certificate_of_evolution U)
    hnosurvivor marketImpactCost hmarket N

/-- Any predeclared control-cost stream embedded in the generated Lipschitz
ledger is charged pointwise by the generated reserve and has every finite
prefix inside the generated critical budget.

This is the reusable adapter for phase-latency `controlBudget` and
phase-alignment `controlEnergy`; the non-tautological step is the profile
no-survivor pricing of the generated Lipschitz ledger. -/
theorem generated_embedded_control_cost_charged_by_reserve_and_budget_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (controlCost : ℕ → Real)
    (hcontrol :
      ∀ n : ℕ,
        controlCost n ≤
          (O.lipschitz_bridge.ledger_of_evolution
            (O.evolution_of_initial_data u0)).lipschitzCost n) :
    (∀ n : ℕ,
      controlCost n ≤
        (O.lipschitz_bridge.ledger_of_evolution
          (O.evolution_of_initial_data u0)).reservePrice n) ∧
      (∀ N : ℕ,
        nsPrefixSum controlCost N ≤
          (O.lipschitz_bridge.ledger_of_evolution
            (O.evolution_of_initial_data u0)).criticalBudget) := by
  constructor
  · intro n
    exact (hcontrol n).trans
      (generated_lipschitz_cost_le_reserve_price_of_profile_lipschitz_closure
        O u0 n)
  · intro N
    exact
      generated_market_impact_prefix_le_budget_of_profile_lipschitz_closure
        O u0 controlCost hcontrol N

/-- Top-level finite-prefix falsifier for the composed Clay bridge.

Once a profile-pricing obligation and a low-frequency Lipschitz reserve bridge
are both fixed, an overbudget Lipschitz prefix for the generated evolution is
impossible.  This is the direct non-tautological failure test for a proposed
Track B Clay closure: one valid finite prefix whose predeclared Lipschitz cost
exceeds the declared critical budget breaks the bridge. -/
theorem no_overbudget_lipschitz_prefix_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (N : ℕ)
    (hover :
      let U := O.evolution_of_initial_data u0
      let L := O.lipschitz_bridge.ledger_of_evolution U
      L.criticalBudget < lipschitzPrefixCost L N) :
    False := by
  exact not_lt_of_ge
    (generated_lipschitz_prefix_le_budget_of_profile_lipschitz_closure
      O u0 N)
    hover

/-- Top-level market-impact finite-prefix falsifier for the composed bridge.

If a predeclared market-impact stream embeds pointwise into the Lipschitz
ledger of the generated evolution, then an overbudget finite prefix of that
stream also breaks the profile + Lipschitz Clay closure. -/
theorem no_overbudget_market_impact_prefix_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (marketImpactCost : ℕ → Real)
    (hmarket :
      let U := O.evolution_of_initial_data u0
      let L := O.lipschitz_bridge.ledger_of_evolution U
      ∀ n : ℕ, marketImpactCost n ≤ L.lipschitzCost n)
    (N : ℕ)
    (hover :
      let U := O.evolution_of_initial_data u0
      let L := O.lipschitz_bridge.ledger_of_evolution U
      L.criticalBudget < nsPrefixSum marketImpactCost N) :
    False := by
  exact not_lt_of_ge
    (generated_market_impact_prefix_le_budget_of_profile_lipschitz_closure
      O u0 marketImpactCost hmarket N)
    hover

/-- One-entry market-impact underpricing is already a falsifier for the
composed profile/Lipschitz closure.

This is the sharp local adversarial test behind the prefix theorem: a proposed
LP/Bony low-high block may have a valid local leakage estimate, but if its
predeclared market-impact entry cannot be embedded below the generated reserve
price for the same shell, the closure is invalid before any limit passage. -/
theorem no_underpriced_market_impact_entry_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (marketImpactCost : ℕ → Real)
    (hmarket :
      let U := O.evolution_of_initial_data u0
      let L := O.lipschitz_bridge.ledger_of_evolution U
      ∀ n : ℕ, marketImpactCost n ≤ L.lipschitzCost n)
    (n : ℕ)
    (hunderpriced :
      let U := O.evolution_of_initial_data u0
      let L := O.lipschitz_bridge.ledger_of_evolution U
      L.reservePrice n < marketImpactCost n) :
    False := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  have hnosurvivor :
      ∀ n : ℕ, FullLedgerNoSurvivor (L.block n) := by
    intro n
    exact
      generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
        O u0 n
  exact no_underpriced_market_impact_entry_under_audited_no_survivor
    L
    (O.lipschitz_bridge.audited_certificate_of_evolution U)
    hnosurvivor
    marketImpactCost
    hmarket
    n
    hunderpriced

/-- If Lipschitz prefixes are unbounded for the generated evolution, the
composed closure bridge cannot hold.

This is the abstract limit-passage version of the finite-prefix falsifier:
uniform prefix control is not optional, because any unbounded prefix stream
eventually exceeds the declared critical budget. -/
theorem no_unbounded_lipschitz_prefix_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (hunbounded :
      ∀ B : Real, ∃ N : ℕ,
        B <
          lipschitzPrefixCost
            (O.lipschitz_bridge.ledger_of_evolution
              (O.evolution_of_initial_data u0)) N) :
    False := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  obtain ⟨N, hover⟩ := hunbounded L.criticalBudget
  exact no_overbudget_lipschitz_prefix_of_profile_lipschitz_closure
    O u0 N hover

/-- If a market-impact stream embeds in the generated Lipschitz ledger and has
unbounded finite prefixes, the composed closure bridge cannot hold.

This is the theorem-level form of the shear market-impact read: a catalyst can
exist locally, but if executing it across shells requires an unbounded reserve
prefix, it cannot be reconciled with a finite critical budget in the fixed
profile + Lipschitz closure interface. -/
theorem no_unbounded_market_impact_prefix_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (marketImpactCost : ℕ → Real)
    (hmarket :
      ∀ n : ℕ,
        marketImpactCost n ≤
          (O.lipschitz_bridge.ledger_of_evolution
            (O.evolution_of_initial_data u0)).lipschitzCost n)
    (hunbounded :
      ∀ B : Real, ∃ N : ℕ, B < nsPrefixSum marketImpactCost N) :
    False := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  obtain ⟨N, hover⟩ := hunbounded L.criticalBudget
  exact no_overbudget_market_impact_prefix_of_profile_lipschitz_closure
    O u0 marketImpactCost hmarket N hover

/-- Pointwise-unbounded nonnegative market-impact entries are impossible in
the generated profile/Lipschitz closure.

This is the shape produced by many concrete shell-cascade attempts before they
are summed into a prefix: the local cost grows without bound while remaining
pointwise embedded in the same predeclared Lipschitz ledger. -/
theorem no_pointwise_unbounded_market_impact_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (marketImpactCost : ℕ → Real)
    (hmarket_nonnegative :
      ∀ n : ℕ, 0 ≤ marketImpactCost n)
    (hmarket :
      ∀ n : ℕ,
        marketImpactCost n ≤
          (O.lipschitz_bridge.ledger_of_evolution
            (O.evolution_of_initial_data u0)).lipschitzCost n)
    (hunbounded :
      ∀ B : Real, ∃ n : ℕ, B < marketImpactCost n) :
    False := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  have hnosurvivor :
      ∀ n : ℕ, FullLedgerNoSurvivor (L.block n) := by
    intro n
    exact
      generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
        O u0 n
  exact no_pointwise_unbounded_market_impact_under_audited_no_survivor
    L
    (O.lipschitz_bridge.audited_certificate_of_evolution U)
    hnosurvivor
    marketImpactCost
    hmarket_nonnegative
    hmarket
    hunbounded

/-- Linear-in-shell market-impact lower bounds are impossible on an unbounded
shell cascade once they embed in the generated Lipschitz ledger. -/
theorem no_linear_shell_market_impact_of_profile_lipschitz_closure
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (shellLabel marketImpactCost : ℕ → Real)
    (a : Real)
    (ha : 0 < a)
    (hmarket_nonnegative : ∀ n : ℕ, 0 ≤ marketImpactCost n)
    (hlinear : ∀ n : ℕ, a * shellLabel n ≤ marketImpactCost n)
    (hmarket :
      ∀ n : ℕ,
        marketImpactCost n ≤
          (O.lipschitz_bridge.ledger_of_evolution
            (O.evolution_of_initial_data u0)).lipschitzCost n)
    (hshell_unbounded :
      ∀ B : Real, ∃ n : ℕ, B < shellLabel n) :
    False := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  have hnosurvivor :
      ∀ n : ℕ, FullLedgerNoSurvivor (L.block n) := by
    intro n
    exact
      generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
        O u0 n
  exact no_linear_shell_market_impact_under_audited_no_survivor
    L
    (O.lipschitz_bridge.audited_certificate_of_evolution U)
    hnosurvivor
    shellLabel
    marketImpactCost
    a
    ha
    hmarket_nonnegative
    hlinear
    hmarket
    hshell_unbounded

