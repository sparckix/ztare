    (symbolic_global_matrix_replay_prices_generated_block_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        symbolic_global_matrix_replay_prices_generated_block U n)
    (full_ledger_linear_quadratic_orthogonality :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (full_ledger_linear_quadratic_orthogonality_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        full_ledger_linear_quadratic_orthogonality U n)
    (root_square_is_first_unit_defect_root :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (root_square_is_first_unit_defect_root_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        root_square_is_first_unit_defect_root U n)
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (root_square_le_one :
      ∀ (U : NSEvolution) (n : ℕ), rootSq U n ≤ 1)
    (survival_profit_eq_gamma_times_root_square :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            rootSq U n)
    (gamma_le_phase5fb_global_matrix_upper :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
          (38 : Real) / 63) :
    Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource lipschitz_bridge where
  observable_of_generated_block :=
    generated_matrix_block_observable_of_observable_parts P
  observable_fully_charged :=
    generated_matrix_block_observable_fully_charged_of_observable_parts P
  rootSq := rootSq
  symbolic_global_matrix_replay_prices_generated_block :=
    symbolic_global_matrix_replay_prices_generated_block
  symbolic_global_matrix_replay_prices_generated_block_paid :=
    symbolic_global_matrix_replay_prices_generated_block_paid
  full_ledger_linear_quadratic_orthogonality :=
    full_ledger_linear_quadratic_orthogonality
  full_ledger_linear_quadratic_orthogonality_paid :=
    full_ledger_linear_quadratic_orthogonality_paid
  root_square_is_first_unit_defect_root :=
    root_square_is_first_unit_defect_root
  root_square_is_first_unit_defect_root_paid :=
    root_square_is_first_unit_defect_root_paid
  gamma_nonnegative := gamma_nonnegative
  root_square_le_one := root_square_le_one
  survival_profit_eq_gamma_times_root_square :=
    survival_profit_eq_gamma_times_root_square
  gamma_le_phase5fb_global_matrix_upper :=
    gamma_le_phase5fb_global_matrix_upper

/-- Phase 5FB symbolic replay family tags. -/
inductive Phase5FBReplayFamily where
  | lowHighClusterK
deriving DecidableEq, Repr

/-- Phase 5FB symbolic replay observable tags. -/
inductive Phase5FBReplayObservable where
  | globalMatrix
deriving DecidableEq, Repr

/-- Typed payload for a Phase 5FB replay row.

The payload carries the finite replay metadata and the block/observable selected
by that row.  It also carries the exact unit-root algebra from the replay:
`D(t)=t^2+sigma*t^4`, the first-root square, and the resulting survival-root
identity.  This keeps the root channel tied to the finite Fourier source
instead of passing it as a detached equality later. -/
structure Phase5FBReplayBlockPayload where
  family : Phase5FBReplayFamily
  observableTag : Phase5FBReplayObservable
  K : ℕ
  block : FullLedgerBlock
  observable : SignedObservable
  sigma : Real
  sigma_nonnegative : 0 ≤ sigma
  full_ledger_linear_quadratic_orthogonality : Prop
  full_ledger_linear_quadratic_orthogonality_paid :
    full_ledger_linear_quadratic_orthogonality
  root_square_is_first_unit_defect_root : Prop
  root_square_is_first_unit_defect_root_paid :
    root_square_is_first_unit_defect_root
  gamma_nonnegative : 0 ≤ block.gamma
  survival_profit_eq_gamma_times_symbolic_root :
    block.survivalProfit =
      block.gamma * phase5fbFirstUnitDefectRootSquare sigma
  gamma_le_phase5fb_global_matrix_upper : block.gamma ≤ (38 : Real) / 63

/-- Typed generated-block source saying that a generated matrix branch is
exactly the Phase 5FB `global_matrix / low_high_cluster_K` replay row.

This is the missing source identity the symbolic replay cannot provide by
itself: the replay row must be declared as the same generated Lipschitz block,
with `K >= 2`, before the Phase 5FB scalar facts are allowed to price it. -/
structure Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge)
    (U : NSEvolution) (n : ℕ) where
  source : Phase5FBReplayBlockPayload
  family_eq : source.family = Phase5FBReplayFamily.lowHighClusterK
  observable_eq :
    source.observableTag = Phase5FBReplayObservable.globalMatrix
  K_ge_two : 2 ≤ source.K
  block_eq :
    source.block =
      ((lipschitz_bridge.ledger_of_evolution U).block n)
  observable_eq_generated :
    source.observable =
      generated_matrix_block_observable_of_observable_parts P U n
  matrix_branch_eq :
    (P.matrix_branch U n).block = source.block

/-- Constructor for a typed Phase 5FB generated-block source from replay
payload facts.

The matrix-branch equality is derived from the matrix-observable source
itself, so callers only need to prove that the replay payload names the same
generated Lipschitz block and observable. -/
def phase5fb_global_matrix_low_high_clusterK_generated_block_source_of_payload
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge}
    {U : NSEvolution} {n : ℕ}
    (source : Phase5FBReplayBlockPayload)
    (family_eq : source.family = Phase5FBReplayFamily.lowHighClusterK)
    (observable_eq :
      source.observableTag = Phase5FBReplayObservable.globalMatrix)
    (K_ge_two : 2 ≤ source.K)
    (block_eq :
      source.block =
        ((lipschitz_bridge.ledger_of_evolution U).block n))
    (observable_eq_generated :
      source.observable =
        generated_matrix_block_observable_of_observable_parts P U n) :
    Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n where
  source := source
  family_eq := family_eq
  observable_eq := observable_eq
  K_ge_two := K_ge_two
  block_eq := block_eq
  observable_eq_generated := observable_eq_generated
  matrix_branch_eq :=
    (P.matrix_branch_prices_generated_block U n).trans block_eq.symm

/-- Hostile branches for the typed Phase 5FB generated-block source. -/
inductive Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge}
    {U : NSEvolution} {n : ℕ}
    (S : Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n) :
    Type where
  | wrongFamily :
      S.source.family ≠ Phase5FBReplayFamily.lowHighClusterK →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier S
  | wrongObservable :
      S.source.observableTag ≠ Phase5FBReplayObservable.globalMatrix →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier S
  | indexBelowReplayRange :
      ¬ 2 ≤ S.source.K →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier S
  | blockMismatch :
      S.source.block ≠
        ((lipschitz_bridge.ledger_of_evolution U).block n) →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier S
  | observableMismatch :
      S.source.observable ≠
        generated_matrix_block_observable_of_observable_parts P U n →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier S
  | matrixBranchMismatch :
      (P.matrix_branch U n).block ≠ S.source.block →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier S

/-- A typed Phase 5FB generated-block source excludes the named mismatch
branches. -/
theorem no_phase5fb_global_matrix_low_high_clusterK_generated_block_source_falsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge}
    {U : NSEvolution} {n : ℕ}
    (S : Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n) :
    Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSourceFalsifier S →
      False := by
  intro F
  cases F with
  | wrongFamily hbad =>
      exact hbad S.family_eq
  | wrongObservable hbad =>
      exact hbad S.observable_eq
  | indexBelowReplayRange hbad =>
      exact hbad S.K_ge_two
  | blockMismatch hbad =>
      exact hbad S.block_eq
  | observableMismatch hbad =>
      exact hbad S.observable_eq_generated
  | matrixBranchMismatch hbad =>
      exact hbad S.matrix_branch_eq

/-- The typed Phase 5FB block replay carries the exact `38/63` gamma cap for
the same generated block. -/
theorem phase5fb_gamma_cap_of_typed_generated_block_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge}
    {U : NSEvolution} {n : ℕ}
    (S : Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n) :
    ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
      (38 : Real) / 63 := by
  simpa [S.block_eq] using S.source.gamma_le_phase5fb_global_matrix_upper

/-- The typed Phase 5FB block replay carries the exact symbolic sigma
nonnegativity for the same generated block. -/
theorem phase5fb_sigma_nonnegative_of_typed_generated_block_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge}
    {U : NSEvolution} {n : ℕ}
    (S : Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n) :
    0 ≤ S.source.sigma :=
  S.source.sigma_nonnegative

/-- The typed Phase 5FB block replay carries nonnegative gamma for the same
generated block. -/
theorem phase5fb_gamma_nonnegative_of_typed_generated_block_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge}
    {U : NSEvolution} {n : ℕ}
    (S : Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n) :
    0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma := by
  simpa [S.block_eq] using S.source.gamma_nonnegative

/-- The typed Phase 5FB block replay carries the exact unit-root survival
identity for the same generated block. -/
theorem phase5fb_survival_profit_eq_symbolic_root_of_typed_generated_block_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge}
    {U : NSEvolution} {n : ℕ}
    (S : Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n) :
    ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
      ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
        phase5fbFirstUnitDefectRootSquare S.source.sigma := by
  simpa [S.block_eq] using S.source.survival_profit_eq_gamma_times_symbolic_root

/-- Phase 5FB full-ledger root source from typed generated-block replay sources.

This is the non-`True` replay hook: the existing source structure's replay field
is instantiated as `Nonempty` of the typed Phase 5FB generated-block source. -/
noncomputable def phase5fb_full_ledger_unit_root_source_of_typed_generated_block_sources
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge)
    (typed_replay_source :
      ∀ (U : NSEvolution) (n : ℕ),
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n)
    (rootSq : NSEvolution → ℕ → Real)
    (full_ledger_linear_quadratic_orthogonality :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (full_ledger_linear_quadratic_orthogonality_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        full_ledger_linear_quadratic_orthogonality U n)
    (root_square_is_first_unit_defect_root :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (root_square_is_first_unit_defect_root_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        root_square_is_first_unit_defect_root U n)
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (root_square_le_one :
      ∀ (U : NSEvolution) (n : ℕ), rootSq U n ≤ 1)
    (survival_profit_eq_gamma_times_root_square :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            rootSq U n)
    (gamma_le_phase5fb_global_matrix_upper :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
          (38 : Real) / 63) :
    Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource lipschitz_bridge :=
  phase5fb_full_ledger_unit_root_source_of_matrix_observable_parts
    P
    rootSq
    (fun U n =>
      Nonempty
        (Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n))
    (fun U n => ⟨typed_replay_source U n⟩)
    full_ledger_linear_quadratic_orthogonality
    full_ledger_linear_quadratic_orthogonality_paid
    root_square_is_first_unit_defect_root
    root_square_is_first_unit_defect_root_paid
    gamma_nonnegative
    root_square_le_one
    survival_profit_eq_gamma_times_root_square
    gamma_le_phase5fb_global_matrix_upper

/-- Phase 5FB full-ledger root source from the replay's explicit
`D(t)=t^2+sigma*t^4` root formula.

This is a stricter source constructor than the generic root-square route:
callers no longer choose an arbitrary `rootSq`.  They provide the replay's
nonnegative `sigma` parameter and the survival identity against the canonical
first-root square `2 / (1 + sqrt (1 + 4*sigma))`; the non-amplification
inequality is then derived internally. -/
noncomputable def phase5fb_full_ledger_unit_root_source_of_typed_generated_block_sources_and_sigma
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge)
    (typed_replay_source :
      ∀ (U : NSEvolution) (n : ℕ),
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n)
    (sigma : NSEvolution → ℕ → Real)
    (sigma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ), 0 ≤ sigma U n)
    (full_ledger_linear_quadratic_orthogonality :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (full_ledger_linear_quadratic_orthogonality_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        full_ledger_linear_quadratic_orthogonality U n)
    (root_square_is_first_unit_defect_root :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (root_square_is_first_unit_defect_root_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        root_square_is_first_unit_defect_root U n)
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (survival_profit_eq_gamma_times_symbolic_root :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            phase5fbFirstUnitDefectRootSquare (sigma U n))
    (gamma_le_phase5fb_global_matrix_upper :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
          (38 : Real) / 63) :
    Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource lipschitz_bridge :=
  phase5fb_full_ledger_unit_root_source_of_typed_generated_block_sources
    P
    typed_replay_source
    (fun U n => phase5fbFirstUnitDefectRootSquare (sigma U n))
    full_ledger_linear_quadratic_orthogonality
    full_ledger_linear_quadratic_orthogonality_paid
    root_square_is_first_unit_defect_root
    root_square_is_first_unit_defect_root_paid
    gamma_nonnegative
    (fun U n =>
      phase5fbFirstUnitDefectRootSquare_le_one
        (sigma_nonnegative U n))
    survival_profit_eq_gamma_times_symbolic_root
    gamma_le_phase5fb_global_matrix_upper

/-- Phase 5FB full-ledger root source from typed replay rows whose payloads
already carry the exact `38/63` cap for the same generated block. -/
noncomputable def phase5fb_full_ledger_unit_root_source_of_typed_generated_block_sources_and_sigma_auto_cap
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge)
    (typed_replay_source :
      ∀ (U : NSEvolution) (n : ℕ),
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n)
    (sigma : NSEvolution → ℕ → Real)
    (sigma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ), 0 ≤ sigma U n)
    (full_ledger_linear_quadratic_orthogonality :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (full_ledger_linear_quadratic_orthogonality_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        full_ledger_linear_quadratic_orthogonality U n)
    (root_square_is_first_unit_defect_root :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (root_square_is_first_unit_defect_root_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        root_square_is_first_unit_defect_root U n)
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (survival_profit_eq_gamma_times_symbolic_root :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            phase5fbFirstUnitDefectRootSquare (sigma U n)) :
    Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource lipschitz_bridge :=
  phase5fb_full_ledger_unit_root_source_of_typed_generated_block_sources_and_sigma
    P
    typed_replay_source
    sigma
    sigma_nonnegative
    full_ledger_linear_quadratic_orthogonality
    full_ledger_linear_quadratic_orthogonality_paid
    root_square_is_first_unit_defect_root
    root_square_is_first_unit_defect_root_paid
    gamma_nonnegative
    survival_profit_eq_gamma_times_symbolic_root
    (fun U n =>
      phase5fb_gamma_cap_of_typed_generated_block_source
        (typed_replay_source U n))

/-- Phase 5FB full-ledger root source from typed replay payloads that already
carry the exact sigma/root/gamma facts.

This is the strictest generated-block route: the symbolic replay payload is the
single source of truth for sigma, root provenance, gamma nonnegativity, the
survival-root identity, and the `38/63` cap. -/
noncomputable def phase5fb_full_ledger_unit_root_source_of_typed_generated_block_payloads
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockObservableSourceParts lipschitz_bridge)
    (typed_replay_source :
      ∀ (U : NSEvolution) (n : ℕ),
        Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource P U n) :
    Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource lipschitz_bridge :=
  phase5fb_full_ledger_unit_root_source_of_typed_generated_block_sources_and_sigma_auto_cap
    P
    typed_replay_source
    (fun U n => (typed_replay_source U n).source.sigma)
    (fun U n =>
      phase5fb_sigma_nonnegative_of_typed_generated_block_source
        (typed_replay_source U n))
    (fun U n =>
      (typed_replay_source U n).source.full_ledger_linear_quadratic_orthogonality)
