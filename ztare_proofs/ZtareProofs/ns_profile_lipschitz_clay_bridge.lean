      root_defect_no_posthoc_selection
      root_defect_no_posthoc_selection_paid
      threshold_root_amplitude_source)

/-- Typed Phase 5FB generated-block source for a predeclared observable family.

This is the lighter sibling of
`Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource`: it ties the replay
payload to the generated Lipschitz block and observable selector without
requiring the observable to have been produced by the threshold-SOS matrix
branch.  The observable still has to be globally fully charged before it can
feed a Track B endpoint. -/
structure Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (U : NSEvolution) (n : ℕ) where
  source : Phase5FBReplayBlockPayload
  family_eq : source.family = Phase5FBReplayFamily.lowHighClusterK
  observable_eq :
    source.observableTag = Phase5FBReplayObservable.globalMatrix
  K_ge_two : 2 ≤ source.K
  block_eq :
    source.block =
      ((lipschitz_bridge.ledger_of_evolution U).block n)
  observable_eq_generated :
    source.observable = observable_of_generated_block U n

/-- Constructor for a Phase 5FB generated-observable source from replay
payload facts. -/
def phase5fb_global_matrix_low_high_clusterK_generated_observable_source_of_payload
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable}
    {U : NSEvolution} {n : ℕ}
    (source : Phase5FBReplayBlockPayload)
    (family_eq : source.family = Phase5FBReplayFamily.lowHighClusterK)
    (observable_eq :
      source.observableTag = Phase5FBReplayObservable.globalMatrix)
    (K_ge_two : 2 ≤ source.K)
    (block_eq :
      source.block =
        ((lipschitz_bridge.ledger_of_evolution U).block n))
    (observable_eq_generated :
      source.observable = observable_of_generated_block U n) :
    Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
      (lipschitz_bridge := lipschitz_bridge)
      observable_of_generated_block U n where
  source := source
  family_eq := family_eq
  observable_eq := observable_eq
  K_ge_two := K_ge_two
  block_eq := block_eq
  observable_eq_generated := observable_eq_generated

/-- Hostile branches for the typed Phase 5FB generated-observable source. -/
inductive Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSourceFalsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable}
    {U : NSEvolution} {n : ℕ}
    (S :
      Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
        (lipschitz_bridge := lipschitz_bridge)
        observable_of_generated_block U n) :
    Type where
  | wrongFamily :
      S.source.family ≠ Phase5FBReplayFamily.lowHighClusterK →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSourceFalsifier S
  | wrongObservable :
      S.source.observableTag ≠ Phase5FBReplayObservable.globalMatrix →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSourceFalsifier S
  | indexBelowReplayRange :
      ¬ 2 ≤ S.source.K →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSourceFalsifier S
  | blockMismatch :
      S.source.block ≠
        ((lipschitz_bridge.ledger_of_evolution U).block n) →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSourceFalsifier S
  | observableMismatch :
      S.source.observable ≠ observable_of_generated_block U n →
        Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSourceFalsifier S

/-- A typed Phase 5FB generated-observable source excludes replay mismatch
branches. -/
theorem no_phase5fb_global_matrix_low_high_clusterK_generated_observable_source_falsifier
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable}
    {U : NSEvolution} {n : ℕ}
    (S :
      Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
        (lipschitz_bridge := lipschitz_bridge)
        observable_of_generated_block U n) :
    Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSourceFalsifier S →
      False := by
  intro F
  cases F with
  | wrongFamily hbad =>
      exact hbad S.family_eq
  | wrongObservable hbad =>
      exact hbad S.observable_eq
  | indexBelowReplayRange hbad =>
      exact hbad S.K_ge_two
  | blockMismatch hbad =>
      exact hbad S.block_eq
  | observableMismatch hbad =>
      exact hbad S.observable_eq_generated

/-- The typed Phase 5FB observable replay carries the exact `38/63` gamma cap
for the same generated block. -/
theorem phase5fb_gamma_cap_of_typed_generated_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable}
    {U : NSEvolution} {n : ℕ}
    (S :
      Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
        (lipschitz_bridge := lipschitz_bridge)
        observable_of_generated_block U n) :
    ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
      (38 : Real) / 63 := by
  simpa [S.block_eq] using S.source.gamma_le_phase5fb_global_matrix_upper

/-- The typed Phase 5FB observable replay carries the exact symbolic sigma
nonnegativity for the same generated block. -/
theorem phase5fb_sigma_nonnegative_of_typed_generated_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable}
    {U : NSEvolution} {n : ℕ}
    (S :
      Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
        (lipschitz_bridge := lipschitz_bridge)
        observable_of_generated_block U n) :
    0 ≤ S.source.sigma :=
  S.source.sigma_nonnegative

/-- The typed Phase 5FB observable replay carries nonnegative gamma for the
same generated block. -/
theorem phase5fb_gamma_nonnegative_of_typed_generated_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable}
    {U : NSEvolution} {n : ℕ}
    (S :
      Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
        (lipschitz_bridge := lipschitz_bridge)
        observable_of_generated_block U n) :
    0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma := by
  simpa [S.block_eq] using S.source.gamma_nonnegative

/-- The typed Phase 5FB observable replay carries the exact unit-root survival
identity for the same generated block. -/
theorem phase5fb_survival_profit_eq_symbolic_root_of_typed_generated_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    {observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable}
    {U : NSEvolution} {n : ℕ}
    (S :
      Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
        (lipschitz_bridge := lipschitz_bridge)
        observable_of_generated_block U n) :
    ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
      ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
        phase5fbFirstUnitDefectRootSquare S.source.sigma := by
  simpa [S.block_eq] using S.source.survival_profit_eq_gamma_times_symbolic_root

/-- Phase 5FB full-ledger root source from a typed replay source and a
predeclared fully charged observable family.

This route deliberately avoids importing `MatrixBlockOperatorPSDReceipt` as a
proxy for observable provenance.  The finite Phase 5FB replay pays the
global-matrix/low-high source identity, while `observable_fully_charged` and
the unit-amplitude bindings remain explicit anti-tautology inputs. -/
noncomputable def phase5fb_full_ledger_unit_root_source_of_typed_generated_observable_sources_and_sigma
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_fully_charged :
      ∀ (U : NSEvolution) (n : ℕ),
        GlobalSignedObservableFullyCharged
          (observable_of_generated_block U n))
    (typed_replay_source :
      ∀ (U : NSEvolution) (n : ℕ),
        Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
          (lipschitz_bridge := lipschitz_bridge)
          observable_of_generated_block U n)
    (sigma : NSEvolution → ℕ → Real)
    (sigma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ), 0 ≤ sigma U n)
    (full_ledger_linear_quadratic_orthogonality :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (full_ledger_linear_quadratic_orthogonality_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        full_ledger_linear_quadratic_orthogonality U n)
    (root_square_is_first_unit_defect_root :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (root_square_is_first_unit_defect_root_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        root_square_is_first_unit_defect_root U n)
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (survival_profit_eq_gamma_times_symbolic_root :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit =
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            phase5fbFirstUnitDefectRootSquare (sigma U n))
    (gamma_le_phase5fb_global_matrix_upper :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
          (38 : Real) / 63) :
    Phase5FBGlobalMatrixLowHighFullLedgerUnitRootSource
      lipschitz_bridge where
  observable_of_generated_block := observable_of_generated_block
  observable_fully_charged := observable_fully_charged
  rootSq := fun U n => phase5fbFirstUnitDefectRootSquare (sigma U n)
  symbolic_global_matrix_replay_prices_generated_block :=
    fun U n =>
      Nonempty
        (Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
          (lipschitz_bridge := lipschitz_bridge)
          observable_of_generated_block U n)
  symbolic_global_matrix_replay_prices_generated_block_paid :=
    fun U n => ⟨typed_replay_source U n⟩
  full_ledger_linear_quadratic_orthogonality :=
    full_ledger_linear_quadratic_orthogonality
  full_ledger_linear_quadratic_orthogonality_paid :=
    full_ledger_linear_quadratic_orthogonality_paid
  root_square_is_first_unit_defect_root :=
    root_square_is_first_unit_defect_root
  root_square_is_first_unit_defect_root_paid :=
    root_square_is_first_unit_defect_root_paid
  gamma_nonnegative := gamma_nonnegative
  root_square_le_one := by
    intro U n
    exact
      phase5fbFirstUnitDefectRootSquare_le_one
        (sigma_nonnegative U n)
  survival_profit_eq_gamma_times_root_square :=
    survival_profit_eq_gamma_times_symbolic_root
  gamma_le_phase5fb_global_matrix_upper :=
    gamma_le_phase5fb_global_matrix_upper

/-- Phase 5FB full-ledger root source from typed observable replay rows whose
payloads already carry the exact `38/63` cap for the same generated block. -/
noncomputable def phase5fb_full_ledger_unit_root_source_of_typed_generated_observable_sources_and_sigma_auto_cap
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (observable_of_generated_block :
