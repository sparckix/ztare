          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (parts_ampSq_matches_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        (P.amplitude_projection U n).ampSq =
          (threshold_root_source U n).ampSq) :
    GeneratedMatrixBlockJointSourceBindingGap P → False :=
  no_generated_matrix_block_joint_source_binding_gap
    P
    (generated_matrix_block_joint_source_bindings_of_threshold_root_source
      P threshold_root_source parts_ampSq_matches_threshold_root)

