  phase5fb_full_ledger_unit_root_source_of_typed_generated_observable_sources_and_sigma_auto_cap
    observable_of_generated_block
    observable_fully_charged
    typed_replay_source
    (fun U n => (typed_replay_source U n).source.sigma)
    (fun U n =>
      phase5fb_sigma_nonnegative_of_typed_generated_observable_source
        (typed_replay_source U n))
    (fun U n =>
      (typed_replay_source U n).source.full_ledger_linear_quadratic_orthogonality)
    (fun U n =>
      (typed_replay_source U n).source.full_ledger_linear_quadratic_orthogonality_paid)
