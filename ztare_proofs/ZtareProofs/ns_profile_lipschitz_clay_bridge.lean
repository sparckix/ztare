  declared_before_use :=
    (threshold_root_source U n).survival_observable_fixed_before_defect_scoring
  declared_before_use_paid :=
    (threshold_root_source U n).survival_observable_fixed_before_defect_scoring_paid
  no_posthoc_selection :=
    (threshold_root_source U n).root_defect_ledger_same_as_survival_observable
  no_posthoc_selection_paid :=
    (threshold_root_source U n).root_defect_ledger_same_as_survival_observable_paid

/-- A threshold-root amplitude source family closes the generated matrix-block
typed-source-binding gap once its scalar is identified with the compact
generated projection. -/
theorem no_generated_matrix_block_typed_source_binding_gap_of_threshold_root_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (parts_ampSq_matches_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        (P.amplitude_projection U n).ampSq =
          (threshold_root_source U n).ampSq) :
    GeneratedMatrixBlockTypedSourceBindingGap P → False :=
  no_generated_matrix_block_typed_source_binding_gap
    P
    (generated_matrix_amplitude_square_source_binding_of_threshold_root_source
      P threshold_root_source parts_ampSq_matches_threshold_root)
    (generated_matrix_gain_bound_source_binding_of_threshold_root_source
      P threshold_root_source parts_ampSq_matches_threshold_root)
    (generated_matrix_threshold_root_amplitude_source_binding_of_threshold_root_source
      P threshold_root_source parts_ampSq_matches_threshold_root)

/-- Matrix parts built directly from threshold-root sources have no remaining
generated-block typed-source-binding gap.

This packages the `rfl` scalar identity from
`generated_matrix_block_threshold_root_ampSq_eq_parts_projection` with the
anchored source-binding constructors above.  The analytic debt is now exactly
the threshold-root source family and the matrix-branch block identity. -/
theorem no_generated_matrix_block_typed_source_binding_gap_of_matrix_threshold_root_sources
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (matrix_branch :
      ∀ (_U : NSEvolution) (_n : ℕ), MatrixBlockSOSBranchReceipt)
    (matrix_branch_prices_generated_block :
      ∀ (U : NSEvolution) (n : ℕ),
        (matrix_branch U n).block =
          ((lipschitz_bridge.ledger_of_evolution U).block n)) :
    GeneratedMatrixBlockTypedSourceBindingGap
      (generated_matrix_block_amplitude_source_parts_of_threshold_root_sources
        lipschitz_bridge
        threshold_root_source
        matrix_branch
        matrix_branch_prices_generated_block) → False :=
  no_generated_matrix_block_typed_source_binding_gap_of_threshold_root_source
    (generated_matrix_block_amplitude_source_parts_of_threshold_root_sources
      lipschitz_bridge
      threshold_root_source
      matrix_branch
      matrix_branch_prices_generated_block)
    threshold_root_source
    (fun U n =>
      generated_matrix_block_threshold_root_ampSq_eq_parts_projection
        lipschitz_bridge
        threshold_root_source
        matrix_branch
        matrix_branch_prices_generated_block
        U n)

/-- Matrix parts plus threshold-root observable provenance close the
generated-block typed-source-binding gap.

This is the practical local boundary: matrix parts already supply the generated
observable and compact scalar projection; the caller pays the amplitude match,
root-ledger match, and threshold-root amplitude bound. -/
theorem no_generated_matrix_block_typed_source_binding_gap_of_matrix_observable_sources
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (observable_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeObservableMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (generated_matrix_block_observable_of_parts P U n)
          ((P.amplitude_projection U n).ampSq))
    (root_ledger_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalRootDefectLedgerMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (generated_matrix_block_observable_of_parts P U n)
          ((P.amplitude_projection U n).ampSq))
    (amp_sq_le_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        sharpTarget <
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma →
          (P.amplitude_projection U n).ampSq ≤
            (Real.sqrt
              (sharpTarget /
                ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)) ^
                (2 : Nat)) :
    GeneratedMatrixBlockTypedSourceBindingGap P → False :=
  no_generated_matrix_block_typed_source_binding_gap_of_threshold_root_source
    P
    (fun U n =>
      quartic_survival_threshold_root_source_of_observable_source
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        (generated_threshold_root_observable_sources_of_matrix_parts
          P
          observable_match
          root_ledger_match
          amp_sq_le_threshold_root
          U n))
    (fun _U _n => rfl)

/-- A noncircular Young/defect self-tax source reduces the generated-block
