/-- Build the exact generated amplitude-bound primitive from a direct gain cap.

This is often the cleaner PDE target: prove `gamma * ampSq <= sharpTarget` for
the generated block, then the threshold-root square bound follows by scalar
algebra. -/
def generated_lipschitz_threshold_root_bounds_of_gain_caps
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (ampSq : NSEvolution → ℕ → Real)
    (gamma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ),
        0 ≤ ((lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (amp_sq_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ), 0 ≤ ampSq U n)
    (amp_sq_le_one :
      ∀ (U : NSEvolution) (n : ℕ), ampSq U n ≤ 1)
    (survival_profit_le_gain_at_amp :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
          ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
            ampSq U n)
    (gain_at_amp_le_target :
      ∀ (U : NSEvolution) (n : ℕ),
        ((lipschitz_bridge.ledger_of_evolution U).block n).gamma *
          ampSq U n ≤ sharpTarget) :
    GeneratedLipschitzThresholdRootAmplitudeBounds lipschitz_bridge where
  ampSq := ampSq
  gamma_nonnegative := gamma_nonnegative
  amp_sq_nonnegative := amp_sq_nonnegative
  amp_sq_le_one := amp_sq_le_one
  survival_profit_le_gain_at_amp := survival_profit_le_gain_at_amp
  amp_sq_le_threshold_root := by
    intro U n hgt
    exact
      amp_sq_le_threshold_root_of_gain_action_cap
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        hgt
        (gain_at_amp_le_target U n)

/-- Generated amplitude bounds derived from a noncircular Young/defect
self-tax stream-family source.

The amplitude projection pays the local scalar fields; the self-tax source
pays the noncircular threshold-defect handoff that gives the generated
`gamma * ampSq ≤ sharpTarget` cap for every global generated block. -/
def generated_lipschitz_threshold_root_bounds_of_noncircular_mv_stream_family_source
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (self_tax_source :
      LeraySelfTaxNoncircularMeasureValuedProfilePriceStreamFamilySource)
    (amplitude_projection :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeProjectionReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)) :
    GeneratedLipschitzThresholdRootAmplitudeBounds lipschitz_bridge :=
  generated_lipschitz_threshold_root_bounds_of_gain_caps
    lipschitz_bridge
    (fun U n => (amplitude_projection U n).ampSq)
    (fun U n => (amplitude_projection U n).gamma_nonnegative)
    (fun U n => (amplitude_projection U n).amp_sq_nonnegative)
    (fun U n => (amplitude_projection U n).amp_sq_le_one)
    (fun U n => (amplitude_projection U n).survival_profit_le_gain_at_amp)
    (fun U n =>
      gain_at_amp_le_target_of_leray_self_tax_noncircular_mv_stream_family_source
        self_tax_source
        ((lipschitz_bridge.ledger_of_evolution U).block n)
        ((lipschitz_bridge.audited_certificate_of_evolution U).block_is_global n)
        (amplitude_projection U n))

