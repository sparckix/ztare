/-- Source-preserving generated-block no-survivor theorem for the
profile/Lipschitz obligation.

This is the local version of the generated-ledger theorem used downstream:
the profile family/source coupling and the threshold handoff are consumed
before the quartic survival projection is applied to the generated Lipschitz
block. -/
theorem generated_lipschitz_block_no_survivor_of_profile_lipschitz_source
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) :
    FullLedgerNoSurvivor
      ((O.lipschitz_bridge.ledger_of_evolution
        (O.evolution_of_initial_data u0)).block n) := by
  let U := O.evolution_of_initial_data u0
  let L := O.lipschitz_bridge.ledger_of_evolution U
  let B := L.block n
  have hhandoff_source :
      TrackBProfileLipschitzGeneratedBlockHandoffSourceReady O u0 n :=
    trackB_profile_lipschitz_generated_block_handoff_source_ready O u0 n
  have hthresholds :=
    threshold_defects_of_trackB_profile_lipschitz_generated_block_handoff_source
      O u0 n hhandoff_source
  exact
    full_ledger_no_survivor_of_quartic_survival_amplitude_projection
      B
      (O.generated_quartic_survival_amplitude_projection U n)
      hthresholds.2.2.2

/-- Single-initial-data profile/Lipschitz source target.

This is a source-facing compression, not an endpoint closure.  The global
`TrackBProfileLipschitzControlObligation` asks for a generated amplitude source
for every `NSEvolution`; the continuation handoff below consumes only the
trajectory `evolution_of_initial_data initialData`.  This target lets the PDE
side prove that trajectory first, then quantify over initial data later.

It carries no `FullLedgerNoSurvivor` field and does not assume the endpoint
closure theorem. -/
structure TrackBProfileLipschitzTrajectoryControlSource where
  evolution_of_initial_data : SmoothNSInitialData → NSEvolution
  initialData : SmoothNSInitialData
  profile_bundle : TrackBProfileDecompositionBridgeBundle
  lipschitz_bridge : LowFrequencyLipschitzBridge
  generated_amplitude_source :
    ∀ n : ℕ,
      QuarticSurvivalAmplitudeObservableSource
        ((lipschitz_bridge.ledger_of_evolution
          (evolution_of_initial_data initialData)).block n)

/-- Profile-decomposition obligation projected from a trajectory source. -/
def TrackBProfileLipschitzTrajectoryControlSource.profile_obligation
    (S : TrackBProfileLipschitzTrajectoryControlSource) :
    TrackBProfileDecompositionObligation :=
  trackb_profile_decomposition_obligation_of_bridge_bundle S.profile_bundle

/-- Generated amplitude projection exposed on the trajectory source. -/
def TrackBProfileLipschitzTrajectoryControlSource.generated_amplitude_projection
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (n : ℕ) :
    QuarticSurvivalAmplitudeProjectionReceipt
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n) :=
  quartic_survival_amplitude_projection_of_observable_source
    ((S.lipschitz_bridge.ledger_of_evolution
      (S.evolution_of_initial_data S.initialData)).block n)
    (S.generated_amplitude_source n)

/-- Trajectory-level quartic survival projection exposed from the local
charged-observable amplitude source. -/
def TrackBProfileLipschitzTrajectoryControlSource.generated_quartic_survival_projection
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (n : ℕ) :
    QuarticSurvivalProjectionReceipt
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n) :=
  quartic_survival_projection_of_amplitude_receipt
    ((S.lipschitz_bridge.ledger_of_evolution
      (S.evolution_of_initial_data S.initialData)).block n)
    (S.generated_amplitude_projection n)

/-- The trajectory generated block's survival profit is bounded by its charged
amplitude gain. -/
theorem trajectory_lipschitz_survival_profit_le_gain_at_amp
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (n : ℕ) :
    ((S.lipschitz_bridge.ledger_of_evolution
      (S.evolution_of_initial_data S.initialData)).block n).survivalProfit ≤
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n).gamma *
        (S.generated_amplitude_projection n).ampSq :=
  (S.generated_amplitude_projection n).survival_profit_le_gain_at_amp

/-- The trajectory generated block exposes the above-wall amplitude threshold. -/
theorem trajectory_lipschitz_above_wall_amp_sq_le_threshold
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (n : ℕ)
    (hgt :
      sharpTarget <
        ((S.lipschitz_bridge.ledger_of_evolution
          (S.evolution_of_initial_data S.initialData)).block n).gamma)
    (hdefect :
      1 ≤ survivalDefect
        ((S.lipschitz_bridge.ledger_of_evolution
          (S.evolution_of_initial_data S.initialData)).block n)
        (Real.sqrt
          (sharpTarget /
            ((S.lipschitz_bridge.ledger_of_evolution
