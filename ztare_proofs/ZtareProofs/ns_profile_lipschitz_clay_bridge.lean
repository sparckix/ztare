    (sigma : NSEvolution → ℕ → Real)
    (sigma_nonnegative :
      ∀ (U : NSEvolution) (n : ℕ), 0 ≤ sigma U n)
    (full_ledger_linear_quadratic_orthogonality :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
    (full_ledger_linear_quadratic_orthogonality_paid :
      ∀ (U : NSEvolution) (n : ℕ),
        full_ledger_linear_quadratic_orthogonality U n)
    (root_square_is_first_unit_defect_root :
      ∀ (_U : NSEvolution) (_n : ℕ), Prop)
