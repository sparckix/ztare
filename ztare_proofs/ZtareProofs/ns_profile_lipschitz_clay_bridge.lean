    (F : GeneratedQuarticSurvivalAmplitudeSourceInputsFalsifier I) :
    False := by
  cases F with
  | observableMatchFailure U n h =>
      exact
        no_quartic_survival_amplitude_observable_match_falsifier
          (I.observable_match U n)
          h

/-- Generated-block amplitude receipt projected from the source-facing
charged-observable field carried by `TrackBProfileLipschitzControlObligation`.

Downstream code can keep consuming the compact amplitude receipt, but the
obligation itself stores the stronger source object so charged-observable
provenance is not erased at construction time. -/
def TrackBProfileLipschitzControlObligation.generated_quartic_survival_amplitude_projection
    (O : TrackBProfileLipschitzControlObligation) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeProjectionReceipt
        ((O.lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    quartic_survival_amplitude_projection_of_observable_source
      ((O.lipschitz_bridge.ledger_of_evolution U).block n)
      (O.generated_quartic_survival_amplitude_observable_source U n)

/-- Projection-level generated-block receipt derived from the amplitude-level
receipt carried by `TrackBProfileLipschitzControlObligation`.

Existing downstream proofs consume the projection receipt through this method;
new instantiations must supply the stronger amplitude receipt instead of a
detached projection proof. -/
def TrackBProfileLipschitzControlObligation.generated_quartic_survival_projection
    (O : TrackBProfileLipschitzControlObligation) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalProjectionReceipt
        ((O.lipschitz_bridge.ledger_of_evolution U).block n) :=
  generated_quartic_survival_projection_of_amplitude_receipts
    O.lipschitz_bridge
    O.generated_quartic_survival_amplitude_projection

/-- The generated quartic projection keeps its survival observable fixed
before defect scoring. -/
theorem generated_lipschitz_survival_observable_fixed_before_defect_scoring_paid
    (O : TrackBProfileLipschitzControlObligation)
    (U : NSEvolution) (n : ℕ) :
    (O.generated_quartic_survival_projection U n)
      |>.survival_observable_fixed_before_defect_scoring :=
  (O.generated_quartic_survival_projection U n)
    |>.survival_observable_fixed_before_defect_scoring_proved

/-- The generated quartic projection uses the same root-defect ledger as its
survival observable. -/
theorem generated_lipschitz_root_defect_ledger_same_as_survival_observable_paid
    (O : TrackBProfileLipschitzControlObligation)
    (U : NSEvolution) (n : ℕ) :
    (O.generated_quartic_survival_projection U n)
      |>.root_defect_ledger_same_as_survival_observable :=
  (O.generated_quartic_survival_projection U n)
    |>.root_defect_ledger_same_as_survival_observable_proved

/-- Generated-block below-wall cap exposed as a named theorem.

This is the first branch of the quartic projection for the exact Lipschitz
ledger block, not a detached scalar inequality. -/
theorem generated_lipschitz_below_wall_profit_cap
    (O : TrackBProfileLipschitzControlObligation)
    (U : NSEvolution) (n : ℕ)
    (hbelow :
      ((O.lipschitz_bridge.ledger_of_evolution U).block n).gamma ≤
        sharpTarget) :
    ((O.lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
      sharpTarget := by
  exact
    (O.generated_quartic_survival_projection U n).below_wall_profit_cap
      hbelow

/-- Generated-block above-wall/root-defect cap exposed as a named theorem.

This is the second branch of the same generated Lipschitz block projection; it
keeps the root-defect hypothesis tied to the promoted survivor observable. -/
theorem generated_lipschitz_above_wall_defect_profit_cap
    (O : TrackBProfileLipschitzControlObligation)
    (U : NSEvolution) (n : ℕ)
    (hgt :
      sharpTarget <
        ((O.lipschitz_bridge.ledger_of_evolution U).block n).gamma)
    (hdefect :
      1 ≤ survivalDefect
        ((O.lipschitz_bridge.ledger_of_evolution U).block n)
        (Real.sqrt
          (sharpTarget /
            ((O.lipschitz_bridge.ledger_of_evolution U).block n).gamma))) :
    ((O.lipschitz_bridge.ledger_of_evolution U).block n).survivalProfit ≤
      sharpTarget := by
  exact
    (O.generated_quartic_survival_projection U n)
      |>.above_wall_defect_profit_cap hgt hdefect

/-- Direct generated-block gain-at-amplitude cap for the actual
initial-data-generated Lipschitz ledger.

The cap is not an extra assumption: it is derived from the generated
amplitude projection plus the profile-decomposition threshold-defect handoff
for the same block. -/
theorem generated_lipschitz_gain_at_amp_le_target_of_profile_lipschitz_source
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (n : ℕ) :
    let U := O.evolution_of_initial_data u0
    let B := (O.lipschitz_bridge.ledger_of_evolution U).block n
    B.gamma *
        (O.generated_quartic_survival_amplitude_projection U n).ampSq ≤
      sharpTarget := by
  let U := O.evolution_of_initial_data u0
  let B := (O.lipschitz_bridge.ledger_of_evolution U).block n
  have hhandoff_source :
      TrackBProfileLipschitzGeneratedBlockHandoffSourceReady O u0 n :=
    trackB_profile_lipschitz_generated_block_handoff_source_ready O u0 n
  have hthresholds :=
    threshold_defects_of_trackB_profile_lipschitz_generated_block_handoff_source
      O u0 n hhandoff_source
  exact
    gain_at_amp_le_target_of_quartic_survival_amplitude_projection
      B
      (O.generated_quartic_survival_amplitude_projection U n)
      hthresholds.2.2.2

