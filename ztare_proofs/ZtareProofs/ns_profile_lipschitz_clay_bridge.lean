    observable_of_generated_block
    observable_admissible
    observable_matrix_kind
    positive_self_tax
    observable_match
    root_ledger_match

/-- Continuum all-output route from a named scalar-alignment source plus one
universal SOS pricing receipt.

This is the compressed non-tautological endpoint for the current Lipschitz
branch: the caller still supplies the scalar-alignment witness object, but no
longer passes its five fields as loose arguments. -/
def trackB_profile_lipschitz_control_of_continuum_alignment_source_and_universal_sos_receipt
    {τ : ContinuumLPProfileTopology.{u}}
    (evolution_of_initial_data : SmoothNSInitialData → NSEvolution)
    (profile_family_of_block : FullLedgerBlock → PricingProfileFamily)
    (source_receipt :
      TrackBProfileDecompositionSourceReceipt profile_family_of_block)
    (null_certificate_of_global :
      ∀ B : FullLedgerBlock,
        IsGlobalTrackBBlock B →
          NullProfileCapBranchCertificate (profile_family_of_block B))
    (concentration_certificate_of_global :
      ∀ B : FullLedgerBlock,
        IsGlobalTrackBBlock B →
          ConcentrationImpactFamilyCertificate (profile_family_of_block B))
    (vanishing_certificate_of_global :
      ∀ B : FullLedgerBlock,
        IsGlobalTrackBBlock B →
          VanishingFamilyCertificate (profile_family_of_block B))
    (priced_fragments_of_global :
      ∀ B : FullLedgerBlock,
        IsGlobalTrackBBlock B →
          PricedFragmentCertificate (profile_family_of_block B))
    (cross_profile_charged_of_global :
      ∀ B : FullLedgerBlock,
        IsGlobalTrackBBlock B →
          CrossProfileRecombinationCertificate (profile_family_of_block B))
    (self_tax_source :
      LeraySelfTaxContinuumAllOutputProfilePriceStreamFamilySource τ)
    (alignment :
      ContinuumProfileFamilyScalarAlignmentSource
        profile_family_of_block self_tax_source)
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (sos_receipt : UniversalStatePricingSOSReceipt)
    (amplitude_projection :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeProjectionReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_admissible :
      ∀ (U : NSEvolution) (n : ℕ),
        IsAdmissibleObservable (observable_of_generated_block U n))
    (observable_matrix_kind :
      ∀ (U : NSEvolution) (n : ℕ),
        (observable_of_generated_block U n).kind = ObservableKind.matrixBlock)
    (positive_self_tax :
      ∀ (U : NSEvolution) (n : ℕ),
        0 < ((lipschitz_bridge.ledger_of_evolution U).block n).selfTax)
    (observable_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeObservableMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (observable_of_generated_block U n)
          ((amplitude_projection U n).ampSq))
    (root_ledger_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalRootDefectLedgerMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (observable_of_generated_block U n)
          ((amplitude_projection U n).ampSq)) :
    TrackBProfileLipschitzControlObligation :=
  trackB_profile_lipschitz_control_of_continuum_scalar_alignment_and_universal_sos_receipt
    evolution_of_initial_data
    profile_family_of_block
    source_receipt
    null_certificate_of_global
    concentration_certificate_of_global
    vanishing_certificate_of_global
    priced_fragments_of_global
    cross_profile_charged_of_global
    self_tax_source
    alignment.profile_family_and_stream_declared_together
    alignment.profile_family_and_stream_declared_together_paid
    alignment.profile_mem_of_global
    alignment.family_payoff_matches_continuum
    alignment.family_price_matches_continuum
    lipschitz_bridge
    sos_receipt
    amplitude_projection
    observable_of_generated_block
    observable_admissible
    observable_matrix_kind
    positive_self_tax
    observable_match
    root_ledger_match

/-- Hostile falsifier for a profile/Lipschitz closure that changes the
generated block, profile family, or projection source after payoff is known. -/
inductive TrackBProfileLipschitzSourceCouplingFalsifier
    (O : TrackBProfileLipschitzControlObligation) : Type where
  | generatedBlockChosenAfterProfilePricing
      (u0 : SmoothNSInitialData) (n : ℕ) :
      ¬ (O.source_coupling).generated_lipschitz_block_declared_before_profile_pricing u0 n →
        TrackBProfileLipschitzSourceCouplingFalsifier O
  | profileFamilyNotAppliedToGeneratedBlock
      (u0 : SmoothNSInitialData) (n : ℕ) :
      ¬ (O.source_coupling).profile_family_applied_to_generated_lipschitz_block u0 n →
        TrackBProfileLipschitzSourceCouplingFalsifier O
  | posthocBlockSubstitution
      (u0 : SmoothNSInitialData) (n : ℕ) :
      ¬ (O.source_coupling).no_posthoc_profile_lipschitz_block_substitution u0 n →
        TrackBProfileLipschitzSourceCouplingFalsifier O

/-- A declared profile/Lipschitz source coupling rules out its guard failures.
-/
theorem no_trackB_profile_lipschitz_source_coupling_falsifier
    (O : TrackBProfileLipschitzControlObligation)
    (F : TrackBProfileLipschitzSourceCouplingFalsifier O) :
    False := by
  cases F with
  | generatedBlockChosenAfterProfilePricing u0 n h =>
      exact h
        ((O.source_coupling).generated_lipschitz_block_declared_before_profile_pricing_paid u0 n)
  | profileFamilyNotAppliedToGeneratedBlock u0 n h =>
      exact h
        ((O.source_coupling).profile_family_applied_to_generated_lipschitz_block_paid u0 n)
  | posthocBlockSubstitution u0 n h =>
      exact h
        ((O.source_coupling).no_posthoc_profile_lipschitz_block_substitution_paid u0 n)

/-- The composed profile/Lipschitz endpoint inherits the profile-decomposition
source-receipt falsifier surface for its generated profile obligation. -/
theorem no_trackB_profile_lipschitz_profile_source_falsifier
    (O : TrackBProfileLipschitzControlObligation)
    (F :
      TrackBProfileDecompositionSourceFalsifier
        O.profile_obligation.source_receipt) :
    False :=
  no_trackb_profile_decomposition_source_receipt_of_falsifier
    O.profile_obligation.source_receipt
    F

/-- The composed profile/Lipschitz endpoint inherits the audited low-frequency
continuation-source falsifier surface for each generated evolution. -/
theorem no_trackB_profile_lipschitz_continuation_source_falsifier
    (O : TrackBProfileLipschitzControlObligation)
    (u0 : SmoothNSInitialData)
    (F :
      LowFrequencyLipschitzContinuationSourceFalsifier
        (O.lipschitz_bridge.ledger_of_evolution
          (O.evolution_of_initial_data u0))
        (O.lipschitz_bridge.continuation_source_of_evolution
          (O.evolution_of_initial_data u0))) :
    False :=
  no_low_frequency_lipschitz_bridge_continuation_source_falsifier
    O.lipschitz_bridge
    (O.evolution_of_initial_data u0)
    F

/-- Generated-block charged-observable amplitude-source falsifier lifted to
the profile/Lipschitz endpoint.

This is the strongest local failure surface for the remaining amplitude PDE
work: the generated block must carry a fully charged signed observable source,
not only a scalar amplitude receipt. -/
inductive TrackBProfileLipschitzGeneratedAmplitudeObservableSourceFalsifier
    (O : TrackBProfileLipschitzControlObligation) : Type where
  | sourceFailure
      (U : NSEvolution) (n : ℕ) :
      QuarticSurvivalAmplitudeObservableSourceFalsifier
        ((O.lipschitz_bridge.ledger_of_evolution U).block n)
        (O.generated_quartic_survival_amplitude_observable_source U n) →
        TrackBProfileLipschitzGeneratedAmplitudeObservableSourceFalsifier O

/-- A profile/Lipschitz endpoint carrying generated charged-observable
amplitude sources rules out every source-level amplitude failure branch. -/
theorem no_trackB_profile_lipschitz_generated_amplitude_observable_source_falsifier
    (O : TrackBProfileLipschitzControlObligation)
    (F : TrackBProfileLipschitzGeneratedAmplitudeObservableSourceFalsifier O) :
    False := by
  cases F with
  | sourceFailure U n h =>
      exact
        no_quartic_survival_amplitude_observable_source_falsifier
          ((O.lipschitz_bridge.ledger_of_evolution U).block n)
          (O.generated_quartic_survival_amplitude_observable_source U n)
          h

/-- Generated-block amplitude falsifier lifted to the profile/Lipschitz
endpoint.

This names the actual remaining PDE failure surface for
`TrackBProfileLipschitzControlObligation`: the generated block must carry a
same-observable amplitude receipt whose gain cap and above-wall threshold
bound are both paid.  A closure attempt should fail here, not at a generic
missing-constructor site. -/
inductive TrackBProfileLipschitzGeneratedAmplitudeFalsifier
    (O : TrackBProfileLipschitzControlObligation) : Type where
  | amplitudeFailure
