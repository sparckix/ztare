/-- Hostile branches for the joint generated-block source map.

Unlike the scalar-only gap above, this falsifier also names channel provenance:
the survival-profit channel and root-defect channel must be declared against the
same generated block/observable payload, not only the scalar payload. -/
inductive GeneratedMatrixBlockJointSourceBindingGap
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge) :
    Type where
  | missingAmplitudeSquareSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (DeclaredSourceBinding
          (ObservableScalarPayload SignedObservable Real)
          { observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })) →
        GeneratedMatrixBlockJointSourceBindingGap P
  | missingSurvivalProfitChannelSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (DeclaredSourceBinding
          (BlockObservablePayload FullLedgerBlock SignedObservable)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n })) →
        GeneratedMatrixBlockJointSourceBindingGap P
  | missingGainBoundSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (DeclaredSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })) →
        GeneratedMatrixBlockJointSourceBindingGap P
  | missingRootDefectChannelSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (NonPosthocSourceBinding
          (BlockObservablePayload FullLedgerBlock SignedObservable)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n })) →
        GeneratedMatrixBlockJointSourceBindingGap P
  | missingThresholdRootAmplitudeSource
      (U : NSEvolution) (n : ℕ) :
      (¬ Nonempty
        (NonPosthocSourceBinding
          (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := generated_matrix_block_observable_of_parts P U n,
            scalar := (P.amplitude_projection U n).ampSq })) →
        GeneratedMatrixBlockJointSourceBindingGap P

/-- A joint source-binding object excludes every named source-map failure
branch for the generated matrix route. -/
theorem no_generated_matrix_block_joint_source_binding_gap
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (J : GeneratedMatrixBlockJointSourceBindings P) :
    GeneratedMatrixBlockJointSourceBindingGap P → False := by
  intro G
  cases G with
  | missingAmplitudeSquareSource U n h =>
      exact h ⟨J.amplitude_square_source U n⟩
  | missingSurvivalProfitChannelSource U n h =>
      exact h
        ⟨generated_matrix_block_observable_binding_of_parts
          P U n
          (J.survival_profit_channel_declared_before_payoff U n)
          (J.survival_profit_channel_declared_before_payoff_paid U n)⟩
  | missingGainBoundSource U n h =>
      exact h ⟨J.gain_bound_source U n⟩
  | missingRootDefectChannelSource U n h =>
      exact h
        ⟨generated_matrix_block_nonposthoc_observable_binding_of_parts
          P U n
          (J.root_defect_block_declared_before_scoring U n)
          (J.root_defect_block_declared_before_scoring_paid U n)
          (J.root_defect_no_posthoc_selection U n)
          (J.root_defect_no_posthoc_selection_paid U n)⟩
  | missingThresholdRootAmplitudeSource U n h =>
      exact h ⟨J.threshold_root_amplitude_source U n⟩

/-- A threshold-root source family excludes the joint source-map gap once its
amplitude square is identified with the generated matrix projection. -/
theorem no_generated_matrix_block_joint_source_binding_gap_of_threshold_root_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
