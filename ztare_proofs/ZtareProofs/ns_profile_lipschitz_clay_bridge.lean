  source_eq_target := by
    simp [parts_ampSq_matches_threshold_root U n]
  declared_before_use :=
    (threshold_root_source U n).survival_observable_fixed_before_defect_scoring
  declared_before_use_paid :=
    (threshold_root_source U n).survival_observable_fixed_before_defect_scoring_paid

/-- Threshold-root amplitude typed binding supplied by a threshold-root source
family.

This is the no-posthoc version used by the root-defect ledger route.  The
no-posthoc guard is inherited from the threshold-root source's ledger/observable
identity field. -/
def generated_matrix_threshold_root_amplitude_source_binding_of_threshold_root_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (P : GeneratedMatrixBlockAmplitudeSourceParts lipschitz_bridge)
    (threshold_root_source :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalThresholdRootAmplitudeSource
          ((lipschitz_bridge.ledger_of_evolution U).block n))
    (parts_ampSq_matches_threshold_root :
      ∀ (U : NSEvolution) (n : ℕ),
        (P.amplitude_projection U n).ampSq =
          (threshold_root_source U n).ampSq)
    (U : NSEvolution) (n : ℕ) :
    NonPosthocSourceBinding
      (BlockObservableScalarPayload FullLedgerBlock SignedObservable Real)
      { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
        observable := generated_matrix_block_observable_of_parts P U n,
        scalar := (P.amplitude_projection U n).ampSq } where
  source :=
    { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
      observable := generated_matrix_block_observable_of_parts P U n,
