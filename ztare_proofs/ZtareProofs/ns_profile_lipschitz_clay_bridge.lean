    (S.generated_amplitude_projection n).ampSq ≤
      sharpTarget /
        ((S.lipschitz_bridge.ledger_of_evolution
          (S.evolution_of_initial_data S.initialData)).block n).gamma :=
  (S.generated_amplitude_projection n).above_wall_amp_sq_le_threshold
    hgt hdefect

/-- Below-wall generated-block cap exposed on the trajectory source. -/
theorem trajectory_lipschitz_below_wall_profit_cap
    (S : TrackBProfileLipschitzTrajectoryControlSource)
    (n : ℕ)
    (hbelow :
      ((S.lipschitz_bridge.ledger_of_evolution
        (S.evolution_of_initial_data S.initialData)).block n).gamma ≤
          sharpTarget) :
    ((S.lipschitz_bridge.ledger_of_evolution
