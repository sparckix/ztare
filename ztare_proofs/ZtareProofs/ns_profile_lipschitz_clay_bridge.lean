/-- Continuum/profile alignment plus typed Phase 5FB sigma replay.

This is a source bundle, not an endpoint theorem.  It packages the current
shortest Track B route before no-survivor pricing is imported: continuum
profile/self-tax scalar alignment builds the profile bundle, matrix/PSD
observable parts choose the generated observable, and typed Phase 5FB replay
fixes the analytic first-root square `phase5fbFirstUnitDefectRootSquare sigma`.

The real missing analytic receipts remain visible as fields: in particular the
matrix parts must come from a genuine operator/PSD source, and the replay/root
equalities must refer to the same generated block.  No `FullLedgerNoSurvivor`
or threshold-gap positivity conclusion is stored here. -/
structure ContinuumPhase5FBSigmaMatrixAlignmentSource
    {τ : ContinuumLPProfileTopology.{u}}
    (profile_family_of_block : FullLedgerBlock → PricingProfileFamily)
    (self_tax_source :
      LeraySelfTaxContinuumAllOutputProfilePriceStreamFamilySource τ)
    (lipschitz_bridge : LowFrequencyLipschitzBridge) where
  source_receipt :
    TrackBProfileDecompositionSourceReceipt profile_family_of_block
  null_certificate_of_global :
    ∀ B : FullLedgerBlock,
      IsGlobalTrackBBlock B →
        NullProfileCapBranchCertificate (profile_family_of_block B)
  concentration_certificate_of_global :
    ∀ B : FullLedgerBlock,
      IsGlobalTrackBBlock B →
        ConcentrationImpactFamilyCertificate (profile_family_of_block B)
  vanishing_certificate_of_global :
    ∀ B : FullLedgerBlock,
      IsGlobalTrackBBlock B →
        VanishingFamilyCertificate (profile_family_of_block B)
  priced_fragments_of_global :
    ∀ B : FullLedgerBlock,
      IsGlobalTrackBBlock B →
        PricedFragmentCertificate (profile_family_of_block B)
  cross_profile_charged_of_global :
    ∀ B : FullLedgerBlock,
      IsGlobalTrackBBlock B →
        CrossProfileRecombinationCertificate (profile_family_of_block B)
  alignment :
    ContinuumProfileFamilyScalarAlignmentSource
      profile_family_of_block self_tax_source
  matrix_parts :
    GeneratedMatrixBlockObservableSourceParts lipschitz_bridge
  typed_replay_source :
    ∀ (U : NSEvolution) (n : ℕ),
      Phase5FBGlobalMatrixLowHighClusterKGeneratedBlockSource
        matrix_parts U n
  sigma_matches_generated_self_tax :
    ∀ (U : NSEvolution) (n : ℕ),
      (typed_replay_source U n).source.sigma =
        ((lipschitz_bridge.ledger_of_evolution U).block n).selfTax
  generated_cross_channel_vanishes :
    ∀ (U : NSEvolution) (n : ℕ),
      ((lipschitz_bridge.ledger_of_evolution U).block n).cross = 0
  unit_bindings :
    GeneratedUnitAmplitudeJointSourceBindings
      lipschitz_bridge
      (generated_matrix_block_observable_of_observable_parts matrix_parts)

/-- Profile bundle projected from a continuum/Phase 5FB alignment source. -/
