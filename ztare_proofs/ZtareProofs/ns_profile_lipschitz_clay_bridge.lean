/-- Threshold-root amplitude sources from numeric bounds plus typed channel
source bindings.

This separates the analytic scalar inequality from provenance.  The numeric
fields come from `bounds`; the two guard fields are paid by declared/no-posthoc
source bindings for the exact generated `(block, observable)` channel. -/
def generated_threshold_root_amplitude_sources_of_bounds_and_channel_sources
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (bounds : GeneratedLipschitzThresholdRootAmplitudeBounds lipschitz_bridge)
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (survival_channel_source :
      ∀ (U : NSEvolution) (n : ℕ),
        DeclaredSourceBinding
          (BlockObservablePayload FullLedgerBlock SignedObservable)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := observable_of_generated_block U n })
    (root_defect_channel_source :
      ∀ (U : NSEvolution) (n : ℕ),
        NonPosthocSourceBinding
          (BlockObservablePayload FullLedgerBlock SignedObservable)
          { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
            observable := observable_of_generated_block U n }) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalThresholdRootAmplitudeSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    { survival_observable_fixed_before_defect_scoring :=
        (survival_channel_source U n).declared_before_use ∧
          (survival_channel_source U n).source =
            { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
              observable := observable_of_generated_block U n }
      root_defect_ledger_same_as_survival_observable :=
        (root_defect_channel_source U n).no_posthoc_selection ∧
          (root_defect_channel_source U n).source =
            { block := ((lipschitz_bridge.ledger_of_evolution U).block n),
              observable := observable_of_generated_block U n }
      survival_observable_fixed_before_defect_scoring_paid :=
        ⟨(survival_channel_source U n).declared_before_use_paid,
          (survival_channel_source U n).source_eq_target⟩
      root_defect_ledger_same_as_survival_observable_paid :=
        ⟨(root_defect_channel_source U n).no_posthoc_selection_paid,
          (root_defect_channel_source U n).source_eq_target⟩
      ampSq := bounds.ampSq U n
      gamma_nonnegative := bounds.gamma_nonnegative U n
      amp_sq_nonnegative := bounds.amp_sq_nonnegative U n
      amp_sq_le_one := bounds.amp_sq_le_one U n
      survival_profit_le_gain_at_amp :=
        bounds.survival_profit_le_gain_at_amp U n
      amp_sq_le_threshold_root :=
        bounds.amp_sq_le_threshold_root U n }

/-- Strong generated threshold-root sources from the exact numeric PDE frontier
and independently paid observable provenance. -/
def generated_threshold_root_sources_of_bounds_and_observables
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (bounds :
      GeneratedLipschitzThresholdRootAmplitudeBounds lipschitz_bridge)
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_fully_charged :
      ∀ (U : NSEvolution) (n : ℕ),
        GlobalSignedObservableFullyCharged
          (observable_of_generated_block U n))
    (observable_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalAmplitudeObservableMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (observable_of_generated_block U n)
          (bounds.ampSq U n))
    (root_ledger_match :
      ∀ (U : NSEvolution) (n : ℕ),
        QuarticSurvivalRootDefectLedgerMatchReceipt
          ((lipschitz_bridge.ledger_of_evolution U).block n)
          (observable_of_generated_block U n)
          (bounds.ampSq U n)) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalThresholdRootObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) := by
  intro U n
  exact
    { observable := observable_of_generated_block U n
      observable_fully_charged := observable_fully_charged U n
      ampSq := bounds.ampSq U n
      observable_match := observable_match U n
      root_ledger_match := root_ledger_match U n
      gamma_nonnegative := bounds.gamma_nonnegative U n
      amp_sq_nonnegative := bounds.amp_sq_nonnegative U n
      amp_sq_le_one := bounds.amp_sq_le_one U n
      survival_profit_le_gain_at_amp :=
        bounds.survival_profit_le_gain_at_amp U n
      amp_sq_le_threshold_root :=
        bounds.amp_sq_le_threshold_root U n }

/-- Strong generated threshold-root sources from a provenance-bearing
unit-amplitude source. -/
def generated_threshold_root_observable_sources_of_unit_amplitude_observable_source
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (S : GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalThresholdRootObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) :=
  generated_threshold_root_sources_of_bounds_and_observables
    (generated_lipschitz_threshold_root_bounds_of_unit_amplitude_observable_source
      lipschitz_bridge
      S)
    S.gain_cap_source.observable_of_generated_block
    S.gain_cap_source.observable_fully_charged
    (fun U n => by
      simpa [
        generated_lipschitz_threshold_root_bounds_of_unit_amplitude_observable_source,
        generated_lipschitz_threshold_root_bounds_of_gain_action_dual_source,
        generated_lipschitz_gain_action_dual_source_of_unit_amplitude_observable_source,
        generated_lipschitz_gain_action_dual_source_of_unit_amplitude_source
      ] using S.observable_match U n)
    (fun U n => by
      simpa [
        generated_lipschitz_threshold_root_bounds_of_unit_amplitude_observable_source,
        generated_lipschitz_threshold_root_bounds_of_gain_action_dual_source,
        generated_lipschitz_gain_action_dual_source_of_unit_amplitude_observable_source,
        generated_lipschitz_gain_action_dual_source_of_unit_amplitude_source
      ] using S.root_ledger_match U n)

/-- Generated amplitude sources from a provenance-bearing unit-amplitude
source. -/
def generated_amplitude_sources_of_unit_amplitude_observable_source
    (lipschitz_bridge : LowFrequencyLipschitzBridge)
    (S : GeneratedLipschitzUnitAmplitudeObservableSource lipschitz_bridge) :
    ∀ (U : NSEvolution) (n : ℕ),
      QuarticSurvivalAmplitudeObservableSource
        ((lipschitz_bridge.ledger_of_evolution U).block n) :=
  generated_amplitude_sources_of_threshold_root_observable_sources
    lipschitz_bridge
    (generated_threshold_root_observable_sources_of_unit_amplitude_observable_source S)

