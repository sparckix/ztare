This is a checklist, not a proof.  A future local proof or ZTARE run that does
not pay or falsify one of these fields is not advancing the Clay closure.
-/
structure TrackBProfileLipschitzOpenObligations where
  fixed_leray_profile_decomposition : Prop
  profile_price_lower_semicontinuity : Prop
  profile_payoff_upper_approximation : Prop
  cross_profile_recombination_charged : Prop
  null_profiles_capped : Prop
  quartic_threshold_defect_theorem : Prop
  fixed_low_frequency_lipschitz_ledger : Prop
  no_survivor_prices_lipschitz_reserve : Prop
  reserve_budget_implies_critical_control : Prop
  continuation_criterion_instantiated : Prop

end ZtareProofs.NS
