/-- A profile/Lipschitz endpoint carrying generated amplitude receipts rules
out every named amplitude/gain failure branch on every generated block. -/
theorem no_trackB_profile_lipschitz_generated_amplitude_falsifier
    (O : TrackBProfileLipschitzControlObligation)
    (F : TrackBProfileLipschitzGeneratedAmplitudeFalsifier O) :
