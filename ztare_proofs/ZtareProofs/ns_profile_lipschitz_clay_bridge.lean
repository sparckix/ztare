/-- Phase 5FB full-ledger root source from typed observable replay payloads that
already carry the exact sigma/root/gamma facts.

This is the observable-family analogue of
`phase5fb_full_ledger_unit_root_source_of_typed_generated_block_payloads`: the
finite replay payload supplies the root algebra, while the charged observable
and unit-amplitude bindings remain explicit downstream provenance. -/
noncomputable def phase5fb_full_ledger_unit_root_source_of_typed_generated_observable_payloads
    {lipschitz_bridge : LowFrequencyLipschitzBridge}
    (observable_of_generated_block :
      ∀ (_U : NSEvolution) (_n : ℕ), SignedObservable)
    (observable_fully_charged :
      ∀ (U : NSEvolution) (n : ℕ),
        GlobalSignedObservableFullyCharged
          (observable_of_generated_block U n))
    (typed_replay_source :
      ∀ (U : NSEvolution) (n : ℕ),
        Phase5FBGlobalMatrixLowHighClusterKGeneratedObservableSource
          (lipschitz_bridge := lipschitz_bridge)
