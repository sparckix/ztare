import Mathlib.Tactic
import ZtareProofs.lean_dojo_ns.Navierstokes

namespace ZtareProofs.NS

noncomputable section

/-! ## §1. Bohr-Fourier representation (opaque) -/

/-- **Opaque**: a velocity field has Bohr-Fourier representation with
spectrum `Σ ⊂ ℝ³` countable and amplitude `a : ℝ³ → ℂ³`.

  `u(x) = Σ_{ξ ∈ Σ} a_ξ e^{2πi ξ·x}`

Held opaque because formal Bohr-AP infrastructure is a Mathlib gap. -/
opaque HasBohrFourierRepr
    (_u : NavierStokes.VelocityField 3) (_BohrSpec : Set (Euc ℝ 3))
    (_a : Euc ℝ 3 → Euc ℂ 3) : Prop

/-- **Opaque**: the divergence-free Bohr-Fourier constraint
`ξ · a_ξ = 0` for all `ξ ∈ Σ`. -/
opaque BohrDivergenceFree
    (_BohrSpec : Set (Euc ℝ 3)) (_a : Euc ℝ 3 → Euc ℂ 3) : Prop

/-- **Opaque**: the stationary NS equation in Bohr-Fourier form. -/
opaque BohrStationaryNS
    (_u : NavierStokes.VelocityField 3) : Prop

/-! ## §2. The transversality conclusion at leaked sums -/

/-- **Opaque**: the transversality conclusion
   `P_{ζ^⊥} [(a_{ξ_1}·ξ_2) a_{ξ_2} + (a_{ξ_2}·ξ_1) a_{ξ_1}] = 0`
where `ζ = ξ_1 + ξ_2`. -/
opaque BilinearTransversalityVanishes
    (_a : Euc ℝ 3 → Euc ℂ 3) (_ξ_1 _ξ_2 : Euc ℝ 3) : Prop

/-- **Opaque**: the finite-pairing condition at `ζ` (needed for the
sum to be a finite algebraic identity rather than a series). For
Liouville-orbit-generated `BohrSpec`, follows from `Σ ⊂ ℤ-span{ξ*}` plus
`dim_ℚ = N`. -/
opaque FinitePairingAt
    (_BohrSpec : Set (Euc ℝ 3)) (_ζ : Euc ℝ 3) : Prop

/-! ## §3. The Bilinear Sum-Closure Lemma (axiomatic, conjectural) -/

/-- **AXIOM (Bilinear Sum-Closure Lemma)** — at every leaked sum
`ξ_1 + ξ_2 ∉ BohrSpec` of a bounded smooth stationary 3D NS solution with
Bohr-Fourier spectrum `BohrSpec`, the bilinear transversality constraint
holds.

Algebra verified by direct convolution computation
(Agent H, 2026-05-08). Conjectural in Lean only because the supporting
Mathlib infrastructure (Bohr-AP coefficient uniqueness, Sohr-von Wahl
AP-pressure spectrum, AP-differentiation-commutes) is absent. The
mathematical content is CLASSICAL. -/
axiom bilinear_sum_closure_lemma
    (u : NavierStokes.VelocityField 3)
    (BohrSpec : Set (Euc ℝ 3)) (a : Euc ℝ 3 → Euc ℂ 3)
    (_h_repr : HasBohrFourierRepr u BohrSpec a)
    (_h_div : BohrDivergenceFree BohrSpec a)
    (_h_NS : BohrStationaryNS u)
    (ξ_1 ξ_2 : Euc ℝ 3) (_h_xi1 : ξ_1 ∈ BohrSpec) (_h_xi2 : ξ_2 ∈ BohrSpec)
    (_h_leak : ξ_1 + ξ_2 ∉ BohrSpec)
    (_h_finite : FinitePairingAt BohrSpec (ξ_1 + ξ_2)) :
    BilinearTransversalityVanishes a ξ_1 ξ_2

/-! ## §4. The Liouville-Orbit-Collapse Lemma (paired, axiomatic) -/

/-- **Opaque**: the predicate "Σ is generated by Liouvillian frequency
`ξ*` with `dim_ℚ ≥ 2`". -/
opaque LiouvilleOrbitGenerated
    (_BohrSpec : Set (Euc ℝ 3)) (_ξ_star : Euc ℝ 3) : Prop

/-- **Opaque**: the conclusion that `a_ξ ≡ 0` on the Liouville
sub-orbit (i.e., the only Bohr-Fourier amplitude is the zero-mode,
collapsing the solution to a constant). -/
opaque LiouvilleSubOrbitAmplitudeCollapse
    (_BohrSpec : Set (Euc ℝ 3)) (_a : Euc ℝ 3 → Euc ℂ 3) : Prop

/-- **AXIOM (Liouville-Orbit-Collapse Lemma — CONJECTURAL, sharper-
than-classical hypothesis)** — given Bilinear Sum-Closure
transversality at every LEAKED sum (`ξ_1 + ξ_2 ∉ BohrSpec`) + the
Liouville-orbit-generated condition + `dim_ℚ ≥ 2`, the transversality
system forces amplitude collapse on the Liouville sub-orbit.

**HONESTY (2026-05-08 meta-laundering audit catch #6)**: this axiom
takes a STRONGER mathematical claim than its docstring's classical
"transversality over generating set" framing supports. The classical
finite-rank linear algebra needs transversality on the FULL orbit
(both leaked and interior sums). This axiom claims that LEAKED-SUM
transversality ALONE suffices — sharper than classical, requiring
that interior-sum transversality be DERIVABLE from leaked-sum data
via additional structure (e.g., density of leaks + closure of orbit).

CONJECTURAL because:
1. Classical version (full transversality) is finite-rank linear
   algebra on ℤ^N orbits in ℝ³ — straightforward but not yet stated
2. Sharper version (leaked-sum-only) requires the additional density
   argument linking leaked transversality to interior — NOT clearly
   classical, possibly OPEN
3. Architecture composes this axiom with `bilinear_sum_closure_lemma`
   which only delivers leaked-sum transversality, so the sharper
   version is what's actually NEEDED for the composition theorem to
   fire

Either tighten hypothesis to full ∀ξ_1 ξ_2 ∈ BohrSpec (and re-engineer
the composition to discharge interior sums separately via additional
axiom) OR maintain this sharper conjectural form with explicit
acknowledgment that the leaked-sum-suffices step is itself an open
linear-algebra question, not classical. -/
axiom liouville_orbit_collapse_lemma
    (BohrSpec : Set (Euc ℝ 3)) (a : Euc ℝ 3 → Euc ℂ 3)
    (ξ_star : Euc ℝ 3)
    (_h_orbit : LiouvilleOrbitGenerated BohrSpec ξ_star)
    (_h_transversal : ∀ ξ_1 ξ_2 : Euc ℝ 3, ξ_1 ∈ BohrSpec → ξ_2 ∈ BohrSpec →
      ξ_1 + ξ_2 ∉ BohrSpec → BilinearTransversalityVanishes a ξ_1 ξ_2) :
    LiouvilleSubOrbitAmplitudeCollapse BohrSpec a

/-! ## §5. The composition theorem (T15 closure on W6 residual) -/

/-- **THEOREM (T15 closure on W6 Liouvillian residual — CONJECTURAL
on TWO axiomatic primitives)**: composition of Bilinear Sum-Closure +
Liouville-Orbit-Collapse closes T15 on the Liouvillian-frequency-AP
measure-zero sub-stratum.

Formally: if `u` is bounded smooth stationary 3D NS with
Liouville-orbit-generated Bohr-Fourier spectrum, then all amplitudes
on the Liouville sub-orbit vanish, forcing `u` to be the constant
zero-mode (T15 conclusion). -/
theorem T15_W6_closure_via_bilinear_sum_closure
    (u : NavierStokes.VelocityField 3)
    (BohrSpec : Set (Euc ℝ 3)) (a : Euc ℝ 3 → Euc ℂ 3)
    (ξ_star : Euc ℝ 3)
    (h_repr : HasBohrFourierRepr u BohrSpec a)
    (h_div : BohrDivergenceFree BohrSpec a)
    (h_NS : BohrStationaryNS u)
    (h_orbit : LiouvilleOrbitGenerated BohrSpec ξ_star)
    (h_finite : ∀ ζ : Euc ℝ 3, FinitePairingAt BohrSpec ζ) :
    LiouvilleSubOrbitAmplitudeCollapse BohrSpec a := by
  apply liouville_orbit_collapse_lemma BohrSpec a ξ_star h_orbit
  intro ξ_1 ξ_2 h_xi1 h_xi2 h_leak
  exact bilinear_sum_closure_lemma u BohrSpec a h_repr h_div h_NS
    ξ_1 ξ_2 h_xi1 h_xi2 h_leak (h_finite (ξ_1 + ξ_2))

