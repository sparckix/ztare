    outsideAtomNotProjectionTailOmittedSilently

/--
A positive invoice atom outside the material window-charge prefix contradicts
`totalInvoice <= windowChargePrefix` for the same collar source and prefix.
-/
theorem no_MaterialWindowChargePrefixAtomAssignmentSource_of_windowChargeOutsideAtom
    {Ω : Type u}
    (C : WindowChargePrefixOutsideInvoiceAtomCounterpacket Ω)
    (h : MaterialWindowChargePrefixAtomAssignmentSource Ω)
    (hSameTotalInvoice : h.collarSource.totalInvoice = C.collarSource.totalInvoice)
    (hSameWindowChargePrefix :
      (Finset.range h.invoicePrefixLength).sum
        h.sameEventLaw.bindingSource.windowCharge = C.windowChargePrefix) : False := by
  have hle := h.totalInvoice_le_windowChargePrefix
  rw [hSameTotalInvoice, hSameWindowChargePrefix,
    C.totalInvoice_eq_windowChargePrefix_plus_outside] at hle
  linarith [C.outsideInvoiceAtom_pos]

