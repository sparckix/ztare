        (seq := seq) (K := K) (hRho := hRho)
        (hCarrier := hCarrier) (hBeta := hBeta) (hEvents := hEvents)
        supportLength) :
    ∀ (Q : NSL3MultiscaleYM.DyadicParabolicCube),
      Q ∈ hCarrier.selectedBadNodes →
        ∀ e : ℕ, hEvents.eventToBadNode e = Q → e < supportLength - 1 := by
  intro Q hQ e heq
  by_contra hnot
  have hlate : supportLength - 1 ≤ e := Nat.le_of_not_gt hnot
  exact h.lateEvent_not_selectedBadNode e hlate (by
    rw [heq]
    exact hQ)

