/--
Level450 typed support-index law source.  This strengthens the Level449
boundary-paid selector contract by replacing the remaining selector labels with
actual membership, restricted-prefix, injectivity, totality, and payment-transfer
laws for a boundary-paid support predicate.
-/
structure TypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource
    (Ω : Type u)
    extends BoundaryPaidHighInterfaceOrderedSupportSelectorSource Ω where
  boundaryPaidSupportIndex : ℕ → Prop
  supportIndex_mem_boundaryPaidSupport :
    ∀ k : ℕ, k < supportLength →
      boundaryPaidSupportIndex (supportIndex k)
  boundaryPaidSupportIndex_lt_restricted :
    ∀ n : ℕ, boundaryPaidSupportIndex n →
      n < thresholdFormula.restrictedSourceLawPrefixLength
  supportIndex_injective_on_prefix_typed :
    ∀ i j : ℕ, i < supportLength → j < supportLength →
      supportIndex i = supportIndex j → i = j
  supportIndex_total_on_boundaryPaidSupport_typed :
    ∀ n : ℕ, boundaryPaidSupportIndex n →
      ∃ k : ℕ, k < supportLength ∧ supportIndex k = n
  typedSupportIndexLawsFixedBeforePayoff : Prop
  typedSupportIndexLawsFixedBeforePayoff_proof :
    typedSupportIndexLawsFixedBeforePayoff
  typedSupportIndexLawsNotTargetDefined : Prop
  typedSupportIndexLawsNotTargetDefined_proof :
    typedSupportIndexLawsNotTargetDefined
  noCarlesonPackingLabelInTypedSupportLaws : Prop
  noCarlesonPackingLabelInTypedSupportLaws_proof :
    noCarlesonPackingLabelInTypedSupportLaws
  noSelectedEventWitnessAsTotalSupport : Prop
  noSelectedEventWitnessAsTotalSupport_proof :
    noSelectedEventWitnessAsTotalSupport

/-- Project the typed Level450 source back to the Level449 positive source. -/
def TypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource.toBoundaryPaidOrderedSupportSelectorSource
    {Ω : Type u}
    (h : TypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource Ω) :
    BoundaryPaidHighInterfaceOrderedSupportSelectorSource Ω :=
  h.toBoundaryPaidHighInterfaceOrderedSupportSelectorSource

/-- Every typed boundary-paid support index inherits the support lower payment. -/
theorem TypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource.boundaryPaidSupportIndex_payment_lower_bound
    {Ω : Type u}
    (h : TypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource Ω)
    (n : ℕ)
    (hn : h.boundaryPaidSupportIndex n) :
    h.δ <= h.thresholdFormula.thresholdInterfacePayment n := by
  obtain ⟨k, hk, hkn⟩ :=
    h.supportIndex_total_on_boundaryPaidSupport_typed n hn
  rw [← hkn]
  exact h.selectedThresholdInterfacePaymentLowerBound_on_support k hk

/-- Every typed boundary-paid support index inherits the boundary-payment domination. -/
theorem TypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource.boundaryPaidSupportIndex_boundary_payment
    {Ω : Type u}
    (h : TypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource Ω)
    (n : ℕ)
    (hn : h.boundaryPaidSupportIndex n) :
    h.thresholdFormula.thresholdInterfacePayment n <=
      h.thresholdFormula.thresholdBoundaryCharge n := by
  obtain ⟨k, hk, hkn⟩ :=
    h.supportIndex_total_on_boundaryPaidSupport_typed n hn
  rw [← hkn]
  exact h.thresholdInterfacePayment_le_thresholdBoundaryCharge_on_support k hk

