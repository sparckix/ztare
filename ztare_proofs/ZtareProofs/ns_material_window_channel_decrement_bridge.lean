/--
Adjacent interval-image totality plus strict prefix order excludes skipped Nat
support-index slots between adjacent prefix indices.
-/
theorem IntervalImageSupportIndexSource.no_supportIndex_between_adjacent_on_prefix
    {Ω : Type u}
    (h : IntervalImageSupportIndexSource Ω) :
    ∀ k n : ℕ, k + 1 < h.supportLength →
      h.supportIndex k < n → n < h.supportIndex (k + 1) → False := by
  intro k n hk hkn hnk
  rcases h.supportIndex_adjacent_interval_total_on_prefix k n hk hkn hnk with
    ⟨i, hi, hin⟩
  have hk_len : k < h.supportLength :=
    lt_trans (Nat.lt_succ_self k) hk
  by_cases hi_left : i < k + 1
  · have hi_le_k : i ≤ k := Nat.lt_succ_iff.mp hi_left
    rcases lt_or_eq_of_le hi_le_k with hi_lt_k | hi_eq_k
    · have hlt :=
        h.supportIndex_strictly_increasing_on_prefix i k hi hk_len hi_lt_k
      have hn_lt_hsk : n < h.supportIndex k := by
        simpa [hin] using hlt
      exact lt_asymm hkn hn_lt_hsk
    · have hnn : n < n := by
        have hk_eq_n : h.supportIndex k = n := by
          simpa [hi_eq_k] using hin
        rw [hk_eq_n] at hkn
        exact hkn
      exact (Nat.lt_irrefl n) hnn
  · have hk1_le_i : k + 1 ≤ i := Nat.le_of_not_gt hi_left
    rcases lt_or_eq_of_le hk1_le_i with hk1_lt_i | hk1_eq_i
    · have hlt :=
        h.supportIndex_strictly_increasing_on_prefix (k + 1) i hk hi hk1_lt_i
      have hnext_lt_n : h.supportIndex (k + 1) < n := by
        simpa [hin] using hlt
      exact lt_asymm hnk hnext_lt_n
    · have hnn : n < n := by
        have hk1_eq_n : h.supportIndex (k + 1) = n := by
          simpa [hk1_eq_i] using hin
        rw [hk1_eq_n] at hnk
        exact hnk
      exact (Nat.lt_irrefl n) hnn

