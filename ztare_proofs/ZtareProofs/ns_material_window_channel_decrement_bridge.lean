/-- Endpoint lower and upper bounds pin every supportIndex value to `baseIndex + k`. -/
theorem EndpointTightSupportIndexSource.supportIndex_eq_base_add_on_prefix
    {Ω : Type u}
    (h : EndpointTightSupportIndexSource Ω) :
    ∀ k : ℕ, k < h.supportLength →
      h.supportIndex k = h.baseIndex + k := by
  intro k hk
  exact le_antisymm
    (h.supportIndex_base_upper_on_prefix k hk)
    (h.supportIndex_base_lower_on_prefix k hk)

/-- Endpoint tightness rules out skipped Nat slots between adjacent supportIndex values. -/
theorem EndpointTightSupportIndexSource.no_supportIndex_between_adjacent_on_prefix
    {Ω : Type u}
    (h : EndpointTightSupportIndexSource Ω) :
    ∀ k n : ℕ, k + 1 < h.supportLength →
      h.supportIndex k < n → n < h.supportIndex (k + 1) → False := by
  intro k n hk hkn hnk
  have hk0 : k < h.supportLength := by
    exact lt_trans (Nat.lt_succ_self k) hk
  have e0 :=
    EndpointTightSupportIndexSource.supportIndex_eq_base_add_on_prefix h k hk0
  have e1 :=
    EndpointTightSupportIndexSource.supportIndex_eq_base_add_on_prefix
      h (k + 1) hk
  have hleft : h.baseIndex + k < n := by
    simpa [e0] using hkn
  have hright0 : n < h.baseIndex + (k + 1) := by
    simpa [e1] using hnk
  have hright : n < Nat.succ (h.baseIndex + k) := by
    simpa [Nat.succ_eq_add_one, Nat.add_assoc] using hright0
  have hnle : n ≤ h.baseIndex + k := Nat.lt_succ_iff.mp hright
  exact (not_lt_of_ge hnle) hleft

