as the Level483 final-slot payer only after the numeric prefix-count bridge is
made explicit.  The parent source carries the two numeric inequalities; the
extra fields bind those inequalities to the displayed L3A lock and block the
Prop-only projection confuser.
-/
structure L3ASameTreeLockPaysFinalSlotCountSource
    (Ω : Type u)
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
