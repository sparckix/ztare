/-- The finite-prefix five-channel drop sequence. -/
noncomputable def FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource.channelDrop
    {Ω : Type u}
    (h : FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource Ω) :
    ℕ → ℝ :=
  fun n =>
    h.productionDrop n + h.pressureReserve n + h.duhamelReserve n +
      h.inheritedReserve n + h.paidChildInvoice n

/-- Finite-prefix reserve accounting bounds only the selected finite prefix. -/
theorem FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource.prefix_depth_bounded
    {Ω : Type u}
    (h : FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource Ω) :
    (h.prefixLength : ℝ) <= h.criticalBudget / h.δ := by
  have hpay_lower :
      (Finset.range h.prefixLength).sum (fun _ : ℕ => h.δ) <=
        (Finset.range h.prefixLength).sum h.highInterfacePayment := by
    exact Finset.sum_le_sum (fun n hn =>
      h.selectedPaymentLowerBound_on_prefix n (Finset.mem_range.mp hn))
  have hpay_boundary :
      (Finset.range h.prefixLength).sum h.highInterfacePayment <=
        (Finset.range h.prefixLength).sum h.boundaryCharge := by
    exact Finset.sum_le_sum (fun n hn =>
      h.selectedPayment_le_boundaryCharge_on_prefix n (Finset.mem_range.mp hn))
  have hboundary_measure_eq :
      (Finset.range h.prefixLength).sum h.boundaryCharge =
        (Finset.range h.prefixLength).sum (fun n =>
          h.boundaryMeasure (h.highInterfaceEventSet n)) := by
    apply Finset.sum_congr rfl
    intro n hn
    exact h.boundaryCharge_eq_boundaryMeasureOnSelectedTent_on_prefix n
      (Finset.mem_range.mp hn)
  have hmeasure_drop :
      (Finset.range h.prefixLength).sum (fun n =>
          h.boundaryMeasure (h.highInterfaceEventSet n)) <=
        (Finset.range h.prefixLength).sum h.channelDrop := by
    exact Finset.sum_le_sum (fun n hn =>
      h.boundaryMeasure_le_channelDrop_on_prefix n (Finset.mem_range.mp hn))
  have hdrop_budget :
      (Finset.range h.prefixLength).sum h.channelDrop <= h.criticalBudget := by
    exact h.channelDropPrefix_le_criticalBudget
  have hδ_sum :
      (Finset.range h.prefixLength).sum (fun _ : ℕ => h.δ) =
        (h.prefixLength : ℝ) * h.δ := by
    simp [Finset.sum_const, nsmul_eq_mul]
  have hprefix_delta_le_budget : (h.prefixLength : ℝ) * h.δ <= h.criticalBudget := by
    rw [← hδ_sum]
    exact le_trans hpay_lower
      (le_trans hpay_boundary
        (by
          rw [hboundary_measure_eq]
          exact le_trans hmeasure_drop hdrop_budget))
  rw [le_div_iff₀ h.δ_pos]
  exact hprefix_delta_le_budget

/-- The finite selected prefix still forces a nonnegative critical budget. -/
theorem FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource.criticalBudget_nonnegative
    {Ω : Type u}
    (h : FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource Ω) :
    0 ≤ h.criticalBudget := by
  have hbound := h.prefix_depth_bounded
  have hprefix_pos : (0 : ℝ) < (h.prefixLength : ℝ) := by
    exact_mod_cast h.prefixLength_pos
  have hprefix_delta_le_budget :
      (h.prefixLength : ℝ) * h.δ ≤ h.criticalBudget := by
    rwa [le_div_iff₀ h.δ_pos] at hbound
  exact le_trans (le_of_lt (mul_pos hprefix_pos h.δ_pos))
    hprefix_delta_le_budget

/--
Finite-prefix owner-preimage receipt.  It is the prefix-scoped replacement for
the all-prefix `MaterialTimeWindowOwnerPreimageReceipt` when the support witness
is one fixed selected prefix.
-/
