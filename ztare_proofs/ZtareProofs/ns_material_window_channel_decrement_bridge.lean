  (Finset.range h.supportLength).image h.supportIndex

/-- The supportIndex image source constructs the Level453 finite-support source. -/
def SupportIndexImageFiniteSupportExtractionSource.toBoundaryGeometryFiniteSupportExtractionSource
    {Ω : Type u}
    (h : SupportIndexImageFiniteSupportExtractionSource Ω) :
    BoundaryGeometryFiniteSupportExtractionSource Ω where
  toBoundaryPaidHighInterfaceOrderedSupportSelectorSource :=
    h.toBoundaryPaidHighInterfaceOrderedSupportSelectorSource
  extractedBoundaryPaidSupport := h.imageSupport
  supportIndex_mem_extracted := by
    intro k hk
    exact Finset.mem_image_of_mem h.supportIndex (Finset.mem_range.mpr hk)
  extractedSupport_lt_restricted := by
    intro n hn
    rcases Finset.mem_image.mp hn with ⟨k, hk, hkn⟩
    simpa [hkn] using
      h.supportIndex_lt_restricted k (Finset.mem_range.mp hk)
  supportIndex_injective_on_prefix_extracted :=
    h.supportIndex_injective_on_prefix_image
  supportIndex_total_on_extractedSupport := by
    intro n hn
    rcases Finset.mem_image.mp hn with ⟨k, hk, hkn⟩
    exact ⟨k, Finset.mem_range.mp hk, hkn⟩
  extractedSupport_card_eq_supportLength := by
    have hInj :
        Set.InjOn h.supportIndex (Finset.range h.supportLength : Set ℕ) := by
      intro i hi j hj hij
      exact h.supportIndex_injective_on_prefix_image i j
        (Finset.mem_range.mp hi) (Finset.mem_range.mp hj) hij
    rw [SupportIndexImageFiniteSupportExtractionSource.imageSupport]
    rw [Finset.card_image_of_injOn hInj, Finset.card_range]
  finiteSupportExtractionFixedBeforePayoff :=
    h.finiteImageSupportFixedBeforePayoff
  finiteSupportExtractionFixedBeforePayoff_proof :=
    h.finiteImageSupportFixedBeforePayoff_proof
  finiteSupportExtractionNotTargetDefined :=
    h.finiteImageSupportNotTargetDefined
  finiteSupportExtractionNotTargetDefined_proof :=
    h.finiteImageSupportNotTargetDefined_proof
  noMeasureOnlyAsFiniteSupport := h.noMeasureOnlyAsImageSupport
  noMeasureOnlyAsFiniteSupport_proof :=
    h.noMeasureOnlyAsImageSupport_proof
  noPackingLabelAsFiniteSupport := h.noPackingLabelAsImageSupport
  noPackingLabelAsFiniteSupport_proof :=
    h.noPackingLabelAsImageSupport_proof
  noSelectedEventWitnessAsFiniteSupport :=
    h.noSelectedEventWitnessAsImageSupport
  noSelectedEventWitnessAsFiniteSupport_proof :=
    h.noSelectedEventWitnessAsImageSupport_proof
  finiteSupportMembershipFixedBeforePayoff :=
    h.imageSupportMembershipFixedBeforePayoff
  finiteSupportMembershipFixedBeforePayoff_proof :=
    h.imageSupportMembershipFixedBeforePayoff_proof
  noPostPayoffFiniteSupportPruning := h.noPostPayoffImageDomainPruning
  noPostPayoffFiniteSupportPruning_proof :=
    h.noPostPayoffImageDomainPruning_proof

