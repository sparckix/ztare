/--
Level439 audit: the all-`Nat` version of the channel-separated source is
uninhabitable over the real numbers.  A positive lower payment for every index
plus a finite prefix budget for every `N` gives a bound on all naturals, which
contradicts Archimedeanness.  Future constructive sources must therefore be
finite-prefix/support-bounded rather than all-index lower-bound streams.
-/
theorem ChannelSeparatedStoppingTreeDecrementReserveSource.allNat_depth_impossible
    {Ω : Type u}
    (h : ChannelSeparatedStoppingTreeDecrementReserveSource Ω) : False := by
  obtain ⟨N, hN⟩ := exists_nat_gt (h.criticalBudget / h.δ)
  exact not_lt_of_ge (h.selected_depth_bounded N) hN

/-- The Level438 formula-native all-`Nat` source inherits the same impossibility. -/
theorem FormulaNativeChannelSeparatedStoppingTreeDecrementReserveSource.allNat_depth_impossible
    {Ω : Type u}
    (h : FormulaNativeChannelSeparatedStoppingTreeDecrementReserveSource Ω) :
    False :=
  h.toChannelSeparatedSource.allNat_depth_impossible

/--
Level440 finite-prefix repair: the Level439 contradiction came from combining
an all-`Nat` positive lower payment with one finite all-prefix budget.  The
repaired support contract makes the selected prefix explicit.  Every analytic
payment/domination field is scoped by `n < prefixLength`, and the exported
budget theorem can only bound this fixed prefix.
-/
structure FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource
    (Ω : Type u) where
  selectedSurvivor : LEINativeSelectedAsymptoticIntermittentSurvivor Ω
  prefixLength : ℕ
  prefixLength_pos : 0 < prefixLength
  highInterfaceEventSet : ℕ → Set Ω
  boundaryMeasure : Set Ω → ℝ
  highInterfacePayment : ℕ → ℝ
  boundaryCharge : ℕ → ℝ
  productionDrop : ℕ → ℝ
  pressureReserve : ℕ → ℝ
  duhamelReserve : ℕ → ℝ
  inheritedReserve : ℕ → ℝ
  paidChildInvoice : ℕ → ℝ
  criticalBudget : ℝ
  δ : ℝ
  δ_pos : 0 < δ
  selectedPaymentLowerBound_on_prefix :
    ∀ n : ℕ, n < prefixLength → δ <= highInterfacePayment n
  selectedPayment_le_boundaryCharge_on_prefix :
    ∀ n : ℕ, n < prefixLength → highInterfacePayment n <= boundaryCharge n
  boundaryCharge_eq_boundaryMeasureOnSelectedTent_on_prefix :
    ∀ n : ℕ, n < prefixLength →
      boundaryCharge n = boundaryMeasure (highInterfaceEventSet n)
  boundaryMeasure_le_channelDrop_on_prefix :
    ∀ n : ℕ, n < prefixLength →
      boundaryMeasure (highInterfaceEventSet n) <=
        productionDrop n + pressureReserve n + duhamelReserve n +
          inheritedReserve n + paidChildInvoice n
  channelDropPrefix_le_criticalBudget :
    (Finset.range prefixLength).sum (fun n =>
      productionDrop n + pressureReserve n + duhamelReserve n +
        inheritedReserve n + paidChildInvoice n) <= criticalBudget
  productionDrop_nonnegative : Prop
  productionDrop_nonnegative_proof : productionDrop_nonnegative
  pressureReserve_nonnegative : Prop
  pressureReserve_nonnegative_proof : pressureReserve_nonnegative
  duhamelReserve_nonnegative : Prop
  duhamelReserve_nonnegative_proof : duhamelReserve_nonnegative
  inheritedReserve_nonnegative : Prop
  inheritedReserve_nonnegative_proof : inheritedReserve_nonnegative
  paidChildInvoice_nonnegative : Prop
  paidChildInvoice_nonnegative_proof : paidChildInvoice_nonnegative
  highInterfaceBoundaryTentFamily : Prop
  highInterfaceBoundaryTentFamily_proof : highInterfaceBoundaryTentFamily
  selectedTentFamilyFixedBeforePayoff : Prop
  selectedTentFamilyFixedBeforePayoff_proof :
    selectedTentFamilyFixedBeforePayoff
  channelPartitionFixedBeforePayoff : Prop
  channelPartitionFixedBeforePayoff_proof : channelPartitionFixedBeforePayoff
  pressureDuhamelInheritedRefillPaidSeparately : Prop
  pressureDuhamelInheritedRefillPaidSeparately_proof :
