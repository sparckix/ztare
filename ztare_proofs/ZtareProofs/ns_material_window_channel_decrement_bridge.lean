/--
The same-tree fresh-frequency payer supplies the Level481 final-slot bound.
The remaining analytic content is now isolated in the prefix domination and
no-rebilling fields.
-/
theorem SameTreeFreshFrequencyFinalSlotPayerSource.supportIndex_final_slot_upper_bound
    {Ω : Type u}
    (h : SameTreeFreshFrequencyFinalSlotPayerSource Ω) :
    0 < h.supportLength →
      h.supportIndex (h.supportLength - 1) ≤
        h.baseIndex + (h.supportLength - 1) := by
  intro hpos
  exact le_trans
    (h.supportIndex_finalSlot_le_base_plus_freshPrefixCount hpos)
    (Nat.add_le_add_left
      (h.freshPrefixCount_finalSlot_le_finalSlot hpos) h.baseIndex)

/--
Level485 arithmetic split for the prefix-count bridge: first pay the target
supportIndex jumps by a target prefix count, then pay that count by the source
fresh-event prefix.  The analytic proof still owes both input inequalities.
-/
theorem supportIndex_finalSlot_le_base_plus_sourcePrefixCount_of_targetPrefixBridge
    {supportIndex targetPrefixCount sourcePrefixCount : ℕ → ℕ}
    {baseIndex supportLength : ℕ}
    (hTarget :
      0 < supportLength →
        supportIndex (supportLength - 1) ≤
          baseIndex + targetPrefixCount (supportLength - 1))
    (hBridge :
      0 < supportLength →
        targetPrefixCount (supportLength - 1) ≤
          sourcePrefixCount (supportLength - 1)) :
    0 < supportLength →
      supportIndex (supportLength - 1) ≤
        baseIndex + sourcePrefixCount (supportLength - 1) := by
  intro hpos
  exact le_trans
    (hTarget hpos)
    (Nat.add_le_add_left (hBridge hpos) baseIndex)

/--
If the source fresh-event prefix is bounded by the final slot, the Level485
target/source split yields the same final-slot upper bound consumed by Level481.
-/
theorem supportIndex_finalSlot_le_base_plus_finalSlot_of_prefixCountBridge
    {supportIndex targetPrefixCount sourcePrefixCount : ℕ → ℕ}
    {baseIndex supportLength : ℕ}
    (hTarget :
      0 < supportLength →
        supportIndex (supportLength - 1) ≤
          baseIndex + targetPrefixCount (supportLength - 1))
    (hBridge :
      0 < supportLength →
        targetPrefixCount (supportLength - 1) ≤
          sourcePrefixCount (supportLength - 1))
    (hSourceBudget :
      0 < supportLength →
        sourcePrefixCount (supportLength - 1) ≤ supportLength - 1) :
    0 < supportLength →
      supportIndex (supportLength - 1) ≤
        baseIndex + (supportLength - 1) := by
  intro hpos
  exact le_trans
    (supportIndex_finalSlot_le_base_plus_sourcePrefixCount_of_targetPrefixBridge
      hTarget hBridge hpos)
    (Nat.add_le_add_left (hSourceBudget hpos) baseIndex)

