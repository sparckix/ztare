/-- Positive-stride affine supportIndex formulas are strictly increasing. -/
theorem AffineSupportIndexOrderSource.supportIndex_strictly_increasing_on_prefix
    {Ω : Type u}
    (h : AffineSupportIndexOrderSource Ω) :
    ∀ i j : ℕ, i < h.supportLength → j < h.supportLength →
      i < j → h.supportIndex i < h.supportIndex j := by
  intro i j hi hj hij
  have hmul : h.stride * i < h.stride * j :=
    Nat.mul_lt_mul_of_pos_left hij h.stride_pos
  simpa [h.supportIndex_affine_on_prefix i hi,
    h.supportIndex_affine_on_prefix j hj] using
      Nat.add_lt_add_left hmul h.baseIndex

