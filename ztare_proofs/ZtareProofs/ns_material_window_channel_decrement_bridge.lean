/--
A positive tail/ambient atom outside the five-channel prefix contradicts exact
atom inclusion when both name the same collar invoice and the same prefix sum.
-/
theorem no_ExactFiveChannelTotalInvoiceAtomInclusionSource_of_projectionTailAmbientAtom
    {Ω : Type u}
    (C : ProjectionTailAmbientAtomCounterpacket Ω)
    (h : ExactFiveChannelTotalInvoiceAtomInclusionSource Ω)
    (hSameTotalInvoice : h.collarSource.totalInvoice = C.collarSource.totalInvoice)
    (hSamePrefixSum :
      (Finset.range h.invoicePrefixLength).sum (fun n : Nat =>
        h.sameEventLaw.bindingSource.channelSource.productionDrop n +
          h.sameEventLaw.bindingSource.channelSource.pressureReserve n +
            h.sameEventLaw.bindingSource.channelSource.duhamelReserve n +
              h.sameEventLaw.bindingSource.channelSource.inheritedReserve n +
                h.sameEventLaw.bindingSource.channelSource.paidChildInvoice n) =
