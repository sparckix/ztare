/-- The least bounded incident event supplies the final-slot target assignment. -/
noncomputable def L3ATargetSlotFromBoundedIncidenceLeastHitSource.targetSlot
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      NSL3MultiscaleYM.BadCenterScaleTruncationPresentation
        seq K hRho hCarrier hBeta}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      L3ATargetSlotFromBoundedIncidenceLeastHitSource
        (seq := seq) (K := K) (hRho := hRho)
        (hCarrier := hCarrier) (hBeta := hBeta) (hEvents := hEvents)
        (L := L) (hScale := hScale) (hInc := hInc)
        supportLength targetPrefixCount) :
    Fin (targetPrefixCount (supportLength - 1)) →
      Fin (supportLength - 1) :=
  fun i => by
    classical
    exact ⟨Nat.find (h.boundedIncidentEventExists i),
      (Nat.find_spec (h.boundedIncidentEventExists i)).1⟩

/-- The least-hit target assignment keeps the displayed incidence witness. -/
theorem L3ATargetSlotFromBoundedIncidenceLeastHitSource.targetSlot_incident
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      NSL3MultiscaleYM.BadCenterScaleTruncationPresentation
        seq K hRho hCarrier hBeta}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      L3ATargetSlotFromBoundedIncidenceLeastHitSource
        (seq := seq) (K := K) (hRho := hRho)
        (hCarrier := hCarrier) (hBeta := hBeta) (hEvents := hEvents)
        (L := L) (hScale := hScale) (hInc := hInc)
        supportLength targetPrefixCount) :
    ∀ i, hInc.incidence (h.targetSlot i).val (h.targetNode i) := by
  classical
  intro i
  exact (Nat.find_spec (h.boundedIncidentEventExists i)).2

