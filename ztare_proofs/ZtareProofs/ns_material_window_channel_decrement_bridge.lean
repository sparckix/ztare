    h.finiteSupportExtractionFixedBeforePayoff
  extractedSupportFixedBeforePayoff_proof :=
    h.finiteSupportExtractionFixedBeforePayoff_proof
  extractedSupportNotTargetDefined :=
    h.finiteSupportExtractionNotTargetDefined
  extractedSupportNotTargetDefined_proof :=
    h.finiteSupportExtractionNotTargetDefined_proof
