    {Ω : Type u}
    (h : BoundaryGeometryFiniteSupportExtractionSource Ω) :
    FiniteExtractedBoundaryPaidSupportSelectorSource Ω where
  toTypedBoundaryPaidHighInterfaceOrderedSupportSelectorSource := {
    toBoundaryPaidHighInterfaceOrderedSupportSelectorSource :=
      h.toBoundaryPaidHighInterfaceOrderedSupportSelectorSource
    boundaryPaidSupportIndex :=
      fun n : ℕ => n ∈ h.extractedBoundaryPaidSupport
    supportIndex_mem_boundaryPaidSupport :=
      h.supportIndex_mem_extracted
