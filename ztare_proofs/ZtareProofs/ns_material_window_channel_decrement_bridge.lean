/--
Confuser: a pre-summed angular packet partition has the wrong inequality
direction for Level392.  It says named channel spends are bounded by an owner
packet budget; it does not embed the collar `totalInvoice` into the finite
channel-drop prefix.
-/
structure WrongWayPreSummedCarrierPartitionConfuser (Ω : Type u) where
  candidate : PreSummedAngularPacketOwnerCarrierReceipt
  visibleChannelSpends_le_ownerPacketBudget : Prop
  visibleChannelSpends_le_ownerPacketBudget_proof :
    visibleChannelSpends_le_ownerPacketBudget
  ownerPacketBudgetNotEmbeddedIntoFiniteChannelPrefix : Prop
  ownerPacketBudgetNotEmbeddedIntoFiniteChannelPrefix_proof :
    ownerPacketBudgetNotEmbeddedIntoFiniteChannelPrefix
  no_exactFiveChannelTotalInvoiceAtomInclusionSource :
    ExactFiveChannelTotalInvoiceAtomInclusionSource Ω -> False

/-- Wrong-way pre-summed packet partitions do not supply exact invoice atom inclusion. -/
theorem no_ExactFiveChannelTotalInvoiceAtomInclusionSource_of_wrongWayPreSummedCarrierPartition
    {Ω : Type u}
    (C : WrongWayPreSummedCarrierPartitionConfuser Ω)
    (h : ExactFiveChannelTotalInvoiceAtomInclusionSource Ω) : False :=
  C.no_exactFiveChannelTotalInvoiceAtomInclusionSource h

/--
Confuser: one-shot cutoff invoice dominance can rule out a localized affine
leak, but it is not a Nat-indexed finite-prefix partition of collar total
invoice into the channel-drop stream.
-/
structure OneShotCutoffDominanceWithoutFinitePrefixPartitionConfuser (Ω : Type u) where
  cutoffLowerBound : ParabolicFiniteEnergyInvoiceLowerBoundForLocalizedAffineTent
  oneShotSurplusPaymentVisible : Prop
  oneShotSurplusPaymentVisible_proof : oneShotSurplusPaymentVisible
  natIndexedFiveChannelPartitionMissing : Prop
  natIndexedFiveChannelPartitionMissing_proof : natIndexedFiveChannelPartitionMissing
  materialWindowEventIdentityMissing : Prop
  materialWindowEventIdentityMissing_proof : materialWindowEventIdentityMissing
  no_exactFiveChannelTotalInvoiceAtomInclusionSource :
    ExactFiveChannelTotalInvoiceAtomInclusionSource Ω -> False

/-- One-shot cutoff dominance does not supply the Level393 finite-prefix partition. -/
theorem no_ExactFiveChannelTotalInvoiceAtomInclusionSource_of_oneShotCutoffDominance
    {Ω : Type u}
    (C : OneShotCutoffDominanceWithoutFinitePrefixPartitionConfuser Ω)
    (h : ExactFiveChannelTotalInvoiceAtomInclusionSource Ω) : False :=
  C.no_exactFiveChannelTotalInvoiceAtomInclusionSource h

