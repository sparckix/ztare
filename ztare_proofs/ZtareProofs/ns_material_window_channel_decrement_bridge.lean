/--
Strict tail-step counting plus the final-slot upper bound yields the Level478
tail-capacity inequality.
-/
theorem FinalSlotUpperBoundTailCapacityEndpointSource.supportIndex_tail_capacity_on_prefix
    {Ω : Type u}
    (h : FinalSlotUpperBoundTailCapacityEndpointSource Ω) :
    ∀ k : ℕ, k < h.supportLength →
      h.supportIndex k + (h.supportLength - (k + 1)) ≤
        h.baseIndex + (h.supportLength - 1) := by
  intro k hk
  have htail_to_final :
      h.supportIndex k + (h.supportLength - (k + 1)) ≤
        h.supportIndex (h.supportLength - 1) :=
    StrictOrderedSupportIndexImageSource.supportIndex_tail_le_final_on_prefix
      h.toStrictOrderedSupportIndexImageSource k hk
  have hpos : 0 < h.supportLength :=
    Nat.lt_of_le_of_lt (Nat.zero_le k) hk
  exact le_trans htail_to_final (h.supportIndex_final_slot_upper_bound hpos)

