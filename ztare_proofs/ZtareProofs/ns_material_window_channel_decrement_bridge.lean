/--
Level432 producer: a suitable-defect threshold formula plus the material-window
same-event law produces the repaired Level431 shared-channel bridge.  This is a
source-level constructor; it does not assume Level430 or Level431 as fields.
-/
structure SuitableDefectFormulaMaterialSameEventProducerSource (Ω : Type u) where
  thresholdFormula : SuitableDefectThresholdFormulaSelectedVariationSource Ω
  sameEventLaw : MaterialWindowChannelSameEventSourceLaw Ω
  formulaEvent_eq_channelEvent_on_restrictedPrefix :
    ∀ n : Nat, n < thresholdFormula.restrictedSourceLawPrefixLength →
      thresholdFormula.highInterfaceEventSet n =
        sameEventLaw.bindingSource.channelSource.highInterfaceEventSet n
  formulaPayment_eq_channelPayment_on_restrictedPrefix :
    ∀ n : Nat, n < thresholdFormula.restrictedSourceLawPrefixLength →
      thresholdFormula.thresholdInterfacePayment n =
        sameEventLaw.bindingSource.channelSource.highInterfacePayment n
  formulaPayment_eq_windowCharge_on_restrictedPrefix :
    ∀ n : Nat, n < thresholdFormula.restrictedSourceLawPrefixLength →
      thresholdFormula.thresholdInterfacePayment n =
        sameEventLaw.bindingSource.windowCharge n
  formulaBoundary_eq_channelBoundary_on_restrictedPrefix :
    ∀ n : Nat, n < thresholdFormula.restrictedSourceLawPrefixLength →
      thresholdFormula.thresholdBoundaryCharge n =
        sameEventLaw.bindingSource.channelSource.boundaryCharge n
  formulaBudgetUseSameSuitableDefectStream : Prop
  formulaBudgetUseSameSuitableDefectStream_proof :
    formulaBudgetUseSameSuitableDefectStream
  formulaEventIdentityNoProxyPaid : Prop
  formulaEventIdentityNoProxyPaid_proof : formulaEventIdentityNoProxyPaid
  separatedChannelsNoRebillingPaid : Prop
  separatedChannelsNoRebillingPaid_proof : separatedChannelsNoRebillingPaid
  noBudgetLegSpentAsFormulaDefinition : Prop
  noBudgetLegSpentAsFormulaDefinition_proof :
    noBudgetLegSpentAsFormulaDefinition
  noTick538BranchImported : Prop
  noTick538BranchImported_proof : noTick538BranchImported
  noHiddenUniformEnstrophyESSCFImport : Prop
  noHiddenUniformEnstrophyESSCFImport_proof :
    noHiddenUniformEnstrophyESSCFImport

/-- The producer first builds the suitable-defect local certificate. -/
def SuitableDefectFormulaMaterialSameEventProducerSource.toLocalCertificate
    {Ω : Type u}
    (h : SuitableDefectFormulaMaterialSameEventProducerSource Ω) :
    SuitableDefectThresholdFormulaWithSeparatedBoundaryBudgetSource Ω where
  thresholdFormula := h.thresholdFormula
  separatedBudget := h.sameEventLaw.bindingSource.channelSource
  formulaBudgetEvent_eq_on_restrictedPrefix :=
    h.formulaEvent_eq_channelEvent_on_restrictedPrefix
  formulaBudgetPayment_eq_on_restrictedPrefix :=
    h.formulaPayment_eq_channelPayment_on_restrictedPrefix
  formulaBudgetBoundary_eq_on_restrictedPrefix :=
    h.formulaBoundary_eq_channelBoundary_on_restrictedPrefix
  formulaBudgetUseSameSuitableDefectStream :=
    h.formulaBudgetUseSameSuitableDefectStream
  formulaBudgetUseSameSuitableDefectStream_proof :=
    h.formulaBudgetUseSameSuitableDefectStream_proof
  formulaEventIdentityNoProxyPaid := h.formulaEventIdentityNoProxyPaid
  formulaEventIdentityNoProxyPaid_proof :=
    h.formulaEventIdentityNoProxyPaid_proof
  separatedChannelsNoRebillingPaid := h.separatedChannelsNoRebillingPaid
  separatedChannelsNoRebillingPaid_proof :=
    h.separatedChannelsNoRebillingPaid_proof
  noBudgetLegSpentAsFormulaDefinition :=
    h.noBudgetLegSpentAsFormulaDefinition
  noBudgetLegSpentAsFormulaDefinition_proof :=
    h.noBudgetLegSpentAsFormulaDefinition_proof
  noTick538BranchImported := h.noTick538BranchImported
  noTick538BranchImported_proof := h.noTick538BranchImported_proof
  noHiddenUniformEnstrophyESSCFImport :=
    h.noHiddenUniformEnstrophyESSCFImport
  noHiddenUniformEnstrophyESSCFImport_proof :=
    h.noHiddenUniformEnstrophyESSCFImport_proof

/-- The same producer then builds the repaired Level431 shared-channel bridge. -/
noncomputable def SuitableDefectFormulaMaterialSameEventProducerSource.toSameChannelBridge
    {Ω : Type u}
    (h : SuitableDefectFormulaMaterialSameEventProducerSource Ω) :
    SuitableDefectFormulaBudgetMaterialWindowBindingSource Ω where
  localCertificate := h.toLocalCertificate
  materialBinding := h.sameEventLaw.bindingSource
  sameChannelSource := rfl
  materialChannelEvent_eq_formulaEvent_on_restrictedPrefix := by
    intro n hn
    exact (h.formulaEvent_eq_channelEvent_on_restrictedPrefix n hn).symm
  materialWindowCharge_eq_formulaPayment_on_restrictedPrefix := by
    intro n hn
    exact (h.formulaPayment_eq_windowCharge_on_restrictedPrefix n hn).symm
  materialBoundary_eq_formulaBoundary_on_restrictedPrefix := by
    intro n hn
    exact (h.formulaBoundary_eq_channelBoundary_on_restrictedPrefix n hn).symm
  materialChannelDrop_eq_localChannelDrop_on_restrictedPrefix := by
    intro n hn
    simp [MaterialWindowChannelSeparatedDecrementBindingSource.channelDrop,
      SuitableDefectFormulaMaterialSameEventProducerSource.toLocalCertificate]
  localAndMaterialWindowsUseSameSelectedStream :=
    h.sameEventLaw.bindingSource.sameEventStreamAsChannelSource
  localAndMaterialWindowsUseSameSelectedStream_proof :=
    h.sameEventLaw.bindingSource.sameEventStreamAsChannelSource_proof
  materialWindowNotProxyForThresholdEvents := h.sameEventLaw.noBoundaryProxyEventFamily
  materialWindowNotProxyForThresholdEvents_proof :=
    h.sameEventLaw.noBoundaryProxyEventFamily_proof
  channelLedgerNotDuplicated := h.separatedChannelsNoRebillingPaid
  channelLedgerNotDuplicated_proof := h.separatedChannelsNoRebillingPaid_proof
  noPostPayoffMaterialWindowRepair := h.sameEventLaw.materialTubeWindowFixedBeforePayoff
  noPostPayoffMaterialWindowRepair_proof :=
    h.sameEventLaw.materialTubeWindowFixedBeforePayoff_proof
  noHiddenCFBKMPSLOrLipschitzFlowImport :=
    h.sameEventLaw.noHiddenCFBKMPSLOrLipschitzFlowImport
  noHiddenCFBKMPSLOrLipschitzFlowImport_proof :=
    h.sameEventLaw.noHiddenCFBKMPSLOrLipschitzFlowImport_proof

/-- The producer gives the material window charge / threshold payment identity. -/
theorem SuitableDefectFormulaMaterialSameEventProducerSource.windowCharge_eq_thresholdPayment
    {Ω : Type u}
    (h : SuitableDefectFormulaMaterialSameEventProducerSource Ω) :
    ∀ n : Nat, n < h.thresholdFormula.restrictedSourceLawPrefixLength →
      h.sameEventLaw.bindingSource.windowCharge n =
        h.thresholdFormula.thresholdInterfacePayment n := by
  intro n hn
  exact (h.formulaPayment_eq_windowCharge_on_restrictedPrefix n hn).symm

