/--
Tail capacity cancels the remaining prefix room and yields the Level476 upper
endpoint bound.
-/
theorem BaseAnchoredTailCapacityEndpointSource.supportIndex_base_upper_on_prefix
    {Ω : Type u}
    (h : BaseAnchoredTailCapacityEndpointSource Ω) :
    ∀ k : ℕ, k < h.supportLength →
      h.supportIndex k ≤ h.baseIndex + k := by
  intro k hk
  have htail_eq :
      h.supportLength - (k + 1) = h.supportLength - 1 - k := by
    rw [Nat.sub_sub, Nat.add_comm]
  have hk_le_last : k ≤ h.supportLength - 1 :=
    Nat.le_sub_one_of_lt hk
  have hlast_decomp :
      h.supportLength - 1 =
        k + (h.supportLength - (k + 1)) := by
    rw [htail_eq]
    exact (Nat.add_sub_of_le hk_le_last).symm
  have hcap := h.supportIndex_tail_capacity_on_prefix k hk
  have hcap_rewritten :
      h.supportIndex k + (h.supportLength - (k + 1)) ≤
        h.baseIndex + k + (h.supportLength - (k + 1)) := by
    simpa [hlast_decomp, Nat.add_assoc] using hcap
  exact Nat.add_le_add_iff_right.mp hcap_rewritten

