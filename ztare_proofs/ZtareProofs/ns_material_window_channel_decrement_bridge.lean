def ReindexedThresholdSupportFiniteChannelSource.toFinitePrefixChannelSource
    {Ω : Type u}
    (h : ReindexedThresholdSupportFiniteChannelSource Ω) :
    FinitePrefixChannelSeparatedStoppingTreeDecrementReserveSource Ω where
  selectedSurvivor := h.selectedSurvivor
  prefixLength := h.supportLength
  prefixLength_pos := h.supportLength_pos
  highInterfaceEventSet := fun k =>
    h.thresholdFormula.highInterfaceEventSet (h.supportIndex k)
