/--
The selected-node event-rank support boundary excludes selected bad-node images
at and after the final prefix.
-/
theorem L3ASelectedBadNodeEventRankSupportBoundarySource.lateEvent_not_selectedBadNode
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {supportLength : ℕ}
    (h :
      L3ASelectedBadNodeEventRankSupportBoundarySource
        (seq := seq) (K := K) (hRho := hRho)
        (hCarrier := hCarrier) (hBeta := hBeta) (hEvents := hEvents)
        supportLength) :
    ∀ e : ℕ, supportLength - 1 ≤ e →
      hEvents.eventToBadNode e ∉ hCarrier.selectedBadNodes := by
  intro e hlate hSelected
  let Q := hEvents.eventToBadNode e
  have hOccursBeforeRank :
      e ≤ h.selectedBadNodeEventRank Q :=
    h.eventToSelectedBadNode_occursBeforeRank e Q rfl hSelected
  have hRankInsidePrefix :
      h.selectedBadNodeEventRank Q < supportLength - 1 :=
    h.selectedBadNodeEventRank_bound Q hSelected
  exact (not_lt_of_ge hlate)
    (lt_of_le_of_lt hOccursBeforeRank hRankInsidePrefix)

