  collarSource : OwnerPreimageCoareaCollarChargeSource
  sameEventLaw : MaterialWindowChannelSameEventSourceLaw Ω
  invoicePrefixLength : Nat
  windowChargePrefix : Real
  outsideInvoiceAtom : Real
  outsideInvoiceAtom_pos : 0 < outsideInvoiceAtom
  totalInvoice_eq_windowChargePrefix_plus_outside :
    collarSource.totalInvoice = windowChargePrefix + outsideInvoiceAtom
  windowChargePrefix_eq_materialWindowChargePrefix :
    windowChargePrefix =
      (Finset.range invoicePrefixLength).sum
        sameEventLaw.bindingSource.windowCharge
