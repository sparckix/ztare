  sameBoundaryCarrierAcrossSelectedTents_proof :
    sameBoundaryCarrierAcrossSelectedTents
  noNestedBoundaryMassReuse : Prop
  noNestedBoundaryMassReuse_proof : noNestedBoundaryMassReuse
  noReserveRefillRebilling : Prop
  noReserveRefillRebilling_proof : noReserveRefillRebilling
  finitePrefixSupportNotAllNat : Prop
  finitePrefixSupportNotAllNat_proof : finitePrefixSupportNotAllNat
  noAllIndexSelectedDepthExport : Prop
