  extractedBoundaryPaidSupport := h.extractedBoundaryPaidSupport
  boundaryPaidSupportIndex_iff_mem_extracted := by
    intro n
    rfl
  extractedSupport_card_eq_supportLength :=
    h.extractedSupport_card_eq_supportLength
