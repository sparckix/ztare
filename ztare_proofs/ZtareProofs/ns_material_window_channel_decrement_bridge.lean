/-- Strict prefix order gives injectivity of the supportIndex on the prefix. -/
theorem StrictOrderedSupportIndexImageSource.supportIndex_injective_on_prefix_from_strict
    {Ω : Type u}
    (h : StrictOrderedSupportIndexImageSource Ω) :
    ∀ i j : ℕ, i < h.supportLength → j < h.supportLength →
      h.supportIndex i = h.supportIndex j → i = j := by
  intro i j hi hj hij
  by_cases hEq : i = j
  · exact hEq
  · rcases lt_or_gt_of_ne hEq with hij_lt | hji_lt
    · have hlt :=
        h.supportIndex_strictly_increasing_on_prefix i j hi hj hij_lt
      simp [← hij] at hlt
    · have hlt :=
        h.supportIndex_strictly_increasing_on_prefix j i hj hi hji_lt
      simp [hij] at hlt

