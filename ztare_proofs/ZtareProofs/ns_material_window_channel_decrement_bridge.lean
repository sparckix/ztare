/--
A base-anchored strictly ordered supportIndex stream cannot lag behind
`baseIndex + k` on its finite prefix.
-/
theorem BaseAnchoredStrictSupportIndexLowerBoundSource.supportIndex_base_lower_on_prefix
    {Ω : Type u}
    (h : BaseAnchoredStrictSupportIndexLowerBoundSource Ω) :
    ∀ k : ℕ, k < h.supportLength →
      h.baseIndex + k ≤ h.supportIndex k := by
  intro k
  induction k with
  | zero =>
      intro hk
      have hzero : h.supportIndex 0 = h.baseIndex :=
        h.supportIndex_zero_eq_base hk
      simp [hzero]
  | succ k ih =>
      intro hk
      have hkprev : k < h.supportLength := by
        exact Nat.lt_trans (Nat.lt_succ_self k) hk
      have hlt : h.supportIndex k < h.supportIndex (Nat.succ k) :=
        h.supportIndex_strictly_increasing_on_prefix k (Nat.succ k)
          hkprev hk (Nat.lt_succ_self k)
      have hprev : h.baseIndex + k ≤ h.supportIndex k :=
        ih hkprev
      have hstep :
          Nat.succ (h.baseIndex + k) ≤ h.supportIndex (Nat.succ k) :=
        Nat.succ_le_of_lt (lt_of_le_of_lt hprev hlt)
      simpa [Nat.succ_eq_add_one, Nat.add_assoc] using hstep

/--
A strictly increasing Nat-valued supportIndex gains at least one Nat unit per
prefix step.
-/
theorem StrictOrderedSupportIndexImageSource.supportIndex_add_gap_le_on_prefix
    {Ω : Type u}
    (h : StrictOrderedSupportIndexImageSource Ω) :
    ∀ i d : ℕ, i + d < h.supportLength →
      h.supportIndex i + d ≤ h.supportIndex (i + d) := by
  intro i d
  induction d with
  | zero =>
      intro hid
      simp
  | succ d ih =>
      intro hsucc
      have hprev_lt_succ : i + d < i + Nat.succ d :=
        Nat.add_lt_add_left (Nat.lt_succ_self d) i
      have hprev : i + d < h.supportLength :=
        Nat.lt_trans hprev_lt_succ hsucc
      have hlt :
          h.supportIndex (i + d) < h.supportIndex (i + Nat.succ d) :=
        h.supportIndex_strictly_increasing_on_prefix
          (i + d) (i + Nat.succ d) hprev hsucc hprev_lt_succ
      have hprev_le : h.supportIndex i + d ≤ h.supportIndex (i + d) :=
        ih hprev
      have hstep :
          Nat.succ (h.supportIndex i + d) ≤
            h.supportIndex (i + Nat.succ d) :=
        Nat.succ_le_of_lt (lt_of_le_of_lt hprev_le hlt)
      simpa only [Nat.add_succ] using hstep

/--
Strict supportIndex order pays the tail step count up to the final prefix slot.
-/
theorem StrictOrderedSupportIndexImageSource.supportIndex_tail_le_final_on_prefix
    {Ω : Type u}
    (h : StrictOrderedSupportIndexImageSource Ω) :
    ∀ k : ℕ, k < h.supportLength →
      h.supportIndex k + (h.supportLength - (k + 1)) ≤
        h.supportIndex (h.supportLength - 1) := by
  intro k hk
  have htail_eq :
      h.supportLength - (k + 1) = h.supportLength - 1 - k := by
    rw [Nat.sub_sub, Nat.add_comm]
  have hk_le_last : k ≤ h.supportLength - 1 :=
    Nat.le_sub_one_of_lt hk
  have hlast_decomp :
      h.supportLength - 1 =
        k + (h.supportLength - (k + 1)) := by
    rw [htail_eq]
    exact (Nat.add_sub_of_le hk_le_last).symm
  have hpos : 0 < h.supportLength :=
    Nat.lt_of_le_of_lt (Nat.zero_le k) hk
  have hlast_lt : h.supportLength - 1 < h.supportLength :=
    Nat.sub_lt hpos Nat.zero_lt_one
  have htail_lt :
      k + (h.supportLength - (k + 1)) < h.supportLength := by
    rw [← hlast_decomp]
    exact hlast_lt
  have hgap :=
    StrictOrderedSupportIndexImageSource.supportIndex_add_gap_le_on_prefix
      h k (h.supportLength - (k + 1)) htail_lt
  simpa [← hlast_decomp] using hgap

