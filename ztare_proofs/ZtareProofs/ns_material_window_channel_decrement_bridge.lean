/-- Level487 two-target/one-source hostile supportIndex. -/
def sourceBudgetWithoutInjectionSupportIndex : ℕ → ℕ
  | 0 => 0
  | _ + 1 => 2

/-- Level487 target count: enough to pay the two final supportIndex jumps. -/
def sourceBudgetWithoutInjectionTargetPrefixCount (_ : ℕ) : ℕ := 2

/-- Level487 source count: budget-feasible but too small without injection. -/
def sourceBudgetWithoutInjectionSourcePrefixCount (_ : ℕ) : ℕ := 1

/-- The target prefix count can pay the final supportIndex slot in the witness. -/
theorem sourceBudgetWithoutInjection_targetPrefix_pays_supportIndex :
    0 < 2 →
      sourceBudgetWithoutInjectionSupportIndex (2 - 1) ≤
        0 + sourceBudgetWithoutInjectionTargetPrefixCount (2 - 1) := by
  intro _hpos
  norm_num [
    sourceBudgetWithoutInjectionSupportIndex,
    sourceBudgetWithoutInjectionTargetPrefixCount]

/-- The source prefix count is itself within the final-slot budget. -/
theorem sourceBudgetWithoutInjection_sourcePrefix_budget :
    0 < 2 →
      sourceBudgetWithoutInjectionSourcePrefixCount (2 - 1) ≤ 2 - 1 := by
  intro _hpos
  norm_num [sourceBudgetWithoutInjectionSourcePrefixCount]

/--
Level496 target-count obstruction: the same two-target/one-final-slot witness
also violates the Level495 numeric assignment bound.
-/
theorem sourceBudgetWithoutInjection_targetPrefix_finalSlot_bound_fails :
    ¬ (0 < 2 →
      sourceBudgetWithoutInjectionTargetPrefixCount (2 - 1) ≤ 2 - 1) := by
  intro h
  have hle := h (by norm_num)
  norm_num [sourceBudgetWithoutInjectionTargetPrefixCount] at hle

/--
The same obstruction survives opaque same-tree, prefix-domination, and incidence
receipt props: those labels alone do not supply the Level495 target-count
numeric field.
-/
theorem sourceBudgetWithoutInjection_targetPrefix_finalSlot_bound_fails_with_opaque_prefixReceipts
    (sameTreeLock prefixDominationPrimitive targetPrefixMapFromL3APrefixDomination
      targetPrefixBoundUsesIncidenceGeometry : Prop) :
    sameTreeLock →
    prefixDominationPrimitive →
    targetPrefixMapFromL3APrefixDomination →
    targetPrefixBoundUsesIncidenceGeometry →
    (0 < 2 →
      sourceBudgetWithoutInjectionSupportIndex (2 - 1) ≤
        0 + sourceBudgetWithoutInjectionTargetPrefixCount (2 - 1)) →
    ¬ (0 < 2 →
      sourceBudgetWithoutInjectionTargetPrefixCount (2 - 1) ≤ 2 - 1) := by
  intro _hLock _hPrefix _hMap _hIncidence _hPays hBound
  have hle := hBound (by norm_num)
  norm_num [sourceBudgetWithoutInjectionTargetPrefixCount] at hle

/--
Level498 obstruction: the two-target/one-final-slot witness cannot carry the
explicit target-slot injection source either.  Any such source would give the
Level495 numeric field by finite cardinality, contradicting `2 ≤ 1`.
-/
theorem sourceBudgetWithoutInjection_no_targetFinalSlotInjectionSource :
    TargetPrefixToFinalSlotInjectionSource
      2 sourceBudgetWithoutInjectionTargetPrefixCount → False := by
  intro h
  have hle := h.targetPrefixCount_finalSlot_le_finalSlot
  norm_num [sourceBudgetWithoutInjectionTargetPrefixCount] at hle

/--
The no-injection obstruction is unchanged by same-tree/incidence/prefix labels:
unless those labels provide a concrete finite map with injectivity, they do not
construct `TargetPrefixToFinalSlotInjectionSource`.
-/
theorem sourceBudgetWithoutInjection_no_targetFinalSlotInjectionSource_with_opaque_prefixReceipts
    (sameTreeLock prefixDominationPrimitive targetPrefixMapFromL3APrefixDomination
      targetPrefixBoundUsesIncidenceGeometry targetSlotFromSameTreeIncidence : Prop) :
    sameTreeLock →
    prefixDominationPrimitive →
    targetPrefixMapFromL3APrefixDomination →
    targetPrefixBoundUsesIncidenceGeometry →
    targetSlotFromSameTreeIncidence →
    TargetPrefixToFinalSlotInjectionSource
      2 sourceBudgetWithoutInjectionTargetPrefixCount → False := by
  intro _hLock _hPrefix _hMap _hIncidence _hTargetSlot h
  exact sourceBudgetWithoutInjection_no_targetFinalSlotInjectionSource h

/--
Level499 obstruction: the two-target/one-final-slot witness also rules out the
sharper finite-incidence extraction source.  Equality reflection would package
into the Level497 finite injection source, which is already impossible here.
-/
theorem sourceBudgetWithoutInjection_no_finiteIncidenceExtractionSource :
    TargetSlotFromFiniteIncidenceExtractionSource
      2 sourceBudgetWithoutInjectionTargetPrefixCount → False := by
  intro h
  exact sourceBudgetWithoutInjection_no_targetFinalSlotInjectionSource
    h.toTargetPrefixToFinalSlotInjectionSource

/--
Opaque incidence, prefix, fanout, and same-tree labels do not repair the
Level499 obstruction unless they supply the actual selector and equality
reflection data inside `TargetSlotFromFiniteIncidenceExtractionSource`.
-/
theorem sourceBudgetWithoutInjection_no_finiteIncidenceExtractionSource_with_opaque_receipts
    (sameTreeLock prefixDominationPrimitive displayedIncidence
      boundedFanoutNoLogReuse collisionExclusionLabel : Prop) :
    sameTreeLock →
    prefixDominationPrimitive →
    displayedIncidence →
    boundedFanoutNoLogReuse →
    collisionExclusionLabel →
    TargetSlotFromFiniteIncidenceExtractionSource
      2 sourceBudgetWithoutInjectionTargetPrefixCount → False := by
  intro _hLock _hPrefix _hInc _hFanout _hCollision h
  exact sourceBudgetWithoutInjection_no_finiteIncidenceExtractionSource h

/--
Level500 obstruction: a bounded injective natural event-index selector into one
final slot is also impossible for the two-target witness, because it packages
into the Level499 finite extraction source.
-/
theorem sourceBudgetWithoutInjection_no_boundedEventIndexInjectionSource :
    TargetSlotFromBoundedEventIndexInjectionSource
      2 sourceBudgetWithoutInjectionTargetPrefixCount → False := by
  intro h
  exact sourceBudgetWithoutInjection_no_finiteIncidenceExtractionSource
    h.toFiniteIncidenceExtractionSource

/--
The Level500 obstruction is unchanged by opaque incidence/fanout/prefix labels:
the missing datum is an actual bounded injective event-index selector.
-/
theorem sourceBudgetWithoutInjection_no_boundedEventIndexInjectionSource_with_opaque_receipts
    (sameTreeLock prefixDominationPrimitive displayedIncidence
      boundedFanoutNoLogReuse eventIndexSelectionLabel : Prop) :
    sameTreeLock →
    prefixDominationPrimitive →
    displayedIncidence →
    boundedFanoutNoLogReuse →
    eventIndexSelectionLabel →
    TargetSlotFromBoundedEventIndexInjectionSource
      2 sourceBudgetWithoutInjectionTargetPrefixCount → False := by
  intro _hLock _hPrefix _hInc _hFanout _hSelection h
  exact sourceBudgetWithoutInjection_no_boundedEventIndexInjectionSource h

/-- But the target/source bridge fails: two target jumps cannot inject into one source atom. -/
theorem sourceBudgetWithoutInjection_target_le_source_bridge_fails :
    ¬ (0 < 2 →
      sourceBudgetWithoutInjectionTargetPrefixCount (2 - 1) ≤
        sourceBudgetWithoutInjectionSourcePrefixCount (2 - 1)) := by
  intro h
  have hle := h (by norm_num)
  norm_num [
    sourceBudgetWithoutInjectionTargetPrefixCount,
    sourceBudgetWithoutInjectionSourcePrefixCount] at hle

/-- Consequently source budget alone cannot pay the final supportIndex slot. -/
theorem sourceBudgetWithoutInjection_final_source_bound_fails :
    ¬ (0 < 2 →
      sourceBudgetWithoutInjectionSupportIndex (2 - 1) ≤
        0 + sourceBudgetWithoutInjectionSourcePrefixCount (2 - 1)) := by
  intro h
  have hle := h (by norm_num)
  norm_num [
    sourceBudgetWithoutInjectionSupportIndex,
    sourceBudgetWithoutInjectionSourcePrefixCount] at hle

