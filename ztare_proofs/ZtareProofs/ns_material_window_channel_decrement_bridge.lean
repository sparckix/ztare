      h.coverageChoiceUsesSameBadCenterEventNodes
    eventNodeIdentificationBinding_proof :=
      h.coverageChoiceUsesSameBadCenterEventNodes_proof
    eventPrefixMembershipSource :=
      h.coverage.everySelectedBadNodeAppearsInSomePrefix ∧
        h.coverageChoiceUsesTargetMembership
    eventPrefixMembershipSource_proof :=
      And.intro
        h.everySelectedBadNodeAppearsInSomePrefix_proof
        h.coverageChoiceUsesTargetMembership_proof
    incidenceGeometryBinding :=
      h.coverageChoiceUsesSameBadCenterEventNodes
    incidenceGeometryBinding_proof :=
      h.coverageChoiceUsesSameBadCenterEventNodes_proof
    notArbitrarySelectedIndex :=
      h.coverage.noShellOnlyEnumerationShortcut ∧
        h.notClassicalChoiceFromBareAppearance
    notArbitrarySelectedIndex_proof :=
      And.intro
        h.noShellOnlyEnumerationShortcut_proof
        h.notClassicalChoiceFromBareAppearance_proof
    notEventToBadNodeLabelOnly :=
      h.coverageChoiceUsesSameBadCenterEventNodes
    notEventToBadNodeLabelOnly_proof :=
      h.coverageChoiceUsesSameBadCenterEventNodes_proof
    notIncidenceLabelOnly :=
      h.coverageChoiceUsesSameBadCenterEventNodes
    notIncidenceLabelOnly_proof :=
      h.coverageChoiceUsesSameBadCenterEventNodes_proof
    downstreamFiniteScaleCofinalitySource :=
      h.downstreamCoverageSelectedIndexSource
    downstreamFiniteScaleCofinalitySource_proof :=
      h.downstreamCoverageSelectedIndexSource_proof
  }
  coverage := h.coverage
  eventPrefixesExhaustSelectedBadNodes_proof :=
    h.eventPrefixesExhaustSelectedBadNodes_proof
  everySelectedBadNodeAppearsInSomePrefix_proof :=
    h.everySelectedBadNodeAppearsInSomePrefix_proof
