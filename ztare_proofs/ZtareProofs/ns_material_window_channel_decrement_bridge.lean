/--
Level475 arithmetic witness.  The double-step supportIndex is strictly ordered
on a two-slot prefix, but it skips the Nat slot `1` between adjacent values
`0` and `2`.
-/
def skippedSlotDoubleSupportIndex (k : ℕ) : ℕ :=
  2 * k

/-- The double-step supportIndex keeps strict order on the two-slot prefix. -/
theorem skippedSlotDoubleSupportIndex_strict_on_two :
    ∀ i j : ℕ, i < 2 → j < 2 → i < j →
      skippedSlotDoubleSupportIndex i < skippedSlotDoubleSupportIndex j := by
  intro i j _hi _hj hij
  exact Nat.mul_lt_mul_of_pos_left hij (by norm_num : 0 < 2)

/-- The skipped Nat slot `1` lies between the two adjacent supportIndex values. -/
theorem skippedSlotDoubleSupportIndex_skips_one :
    skippedSlotDoubleSupportIndex 0 < 1 ∧
      1 < skippedSlotDoubleSupportIndex 1 := by
  norm_num [skippedSlotDoubleSupportIndex]

/-- Therefore the double-step map cannot satisfy the no-hole adjacent law. -/
theorem skippedSlotDoubleSupportIndex_not_noHole_on_two
    (hno :
      ∀ k n : ℕ, k + 1 < 2 →
        skippedSlotDoubleSupportIndex k < n →
        n < skippedSlotDoubleSupportIndex (k + 1) → False) :
    False := by
  exact hno 0 1
    (by norm_num)
    (by norm_num [skippedSlotDoubleSupportIndex])
    (by norm_num [skippedSlotDoubleSupportIndex])

/--
Hostile separation witness: a strict ordered supportIndex source may expose a
skipped Nat slot between adjacent supportIndex values.  This records the
independence of strict order/cardinality-style labels from no-hole contiguity.
-/
structure StrictOrderedSupportIndexImageSkippedSlotWitness
    (Ω : Type u)
    extends StrictOrderedSupportIndexImageSource Ω where
  skippedSlot_k : ℕ
  skippedSlot_n : ℕ
  skippedSlot_k_succ_lt_supportLength :
    skippedSlot_k + 1 < supportLength
  supportIndex_lt_skippedSlot :
    supportIndex skippedSlot_k < skippedSlot_n
  skippedSlot_lt_next_supportIndex :
    skippedSlot_n < supportIndex (skippedSlot_k + 1)
  weakBoundaryOrPackingEvidenceVisible : Prop
  weakBoundaryOrPackingEvidenceVisible_proof :
    weakBoundaryOrPackingEvidenceVisible
  weakCardinalityEvidenceVisible : Prop
  weakCardinalityEvidenceVisible_proof :
    weakCardinalityEvidenceVisible
  weakSelectedEventOrSizeSumEvidenceVisible : Prop
  weakSelectedEventOrSizeSumEvidenceVisible_proof :
    weakSelectedEventOrSizeSumEvidenceVisible
  notEmptyDomainVacuity : Prop
  notEmptyDomainVacuity_proof : notEmptyDomainVacuity
  notLevel473VacuousAdapter : Prop
  notLevel473VacuousAdapter_proof :
    notLevel473VacuousAdapter

/--
A skipped-slot witness is incompatible with a no-hole source on the same
supportLength and pointwise same supportIndex map.
-/
theorem StrictOrderedSupportIndexImageSkippedSlotWitness.not_noHoleContiguousSupportIndexSource_on_same_supportIndex
    {Ω : Type u}
    (w : StrictOrderedSupportIndexImageSkippedSlotWitness Ω)
    (h : NoHoleContiguousSupportIndexSource Ω)
    (hsupportLength : h.supportLength = w.supportLength)
    (hsupportIndex : ∀ i : ℕ, h.supportIndex i = w.supportIndex i) :
    False := by
  have hk : w.skippedSlot_k + 1 < h.supportLength := by
    rw [hsupportLength]
    exact w.skippedSlot_k_succ_lt_supportLength
  have hleft : h.supportIndex w.skippedSlot_k < w.skippedSlot_n := by
    rw [hsupportIndex w.skippedSlot_k]
    exact w.supportIndex_lt_skippedSlot
  have hright :
      w.skippedSlot_n < h.supportIndex (w.skippedSlot_k + 1) := by
    rw [hsupportIndex (w.skippedSlot_k + 1)]
    exact w.skippedSlot_lt_next_supportIndex
  exact h.no_supportIndex_between_adjacent_on_prefix
    w.skippedSlot_k w.skippedSlot_n hk hleft hright

