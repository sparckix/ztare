/-- The finite high-interface payment is paid by the finite five-channel drop. -/
theorem FinitePrefixHighInterfaceTentMaterialWindowInterpretationSource.highInterfacePayment_le_channelDrop_on_prefix
    {Ω : Type u}
    (h : FinitePrefixHighInterfaceTentMaterialWindowInterpretationSource Ω) :
    ∀ n : ℕ, n < h.channelSource.prefixLength →
      h.channelSource.highInterfacePayment n ≤ h.channelSource.channelDrop n := by
  intro n hn
  calc
    h.channelSource.highInterfacePayment n ≤ h.channelSource.boundaryCharge n :=
      h.channelSource.selectedPayment_le_boundaryCharge_on_prefix n hn
    _ = h.channelSource.boundaryMeasure
          (h.channelSource.highInterfaceEventSet n) :=
      h.channelSource.boundaryCharge_eq_boundaryMeasureOnSelectedTent_on_prefix
        n hn
    _ ≤ h.channelSource.channelDrop n :=
      h.channelSource.boundaryMeasure_le_channelDrop_on_prefix n hn

