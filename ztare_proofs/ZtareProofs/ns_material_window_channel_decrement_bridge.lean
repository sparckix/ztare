/-- The selected-prefix material charge is paid by the finite channel budget. -/
theorem FinitePrefixMaterialWindowChannelSeparatedDecrementBindingSource.prefixWindowCharge_le_channelBudget
    {Ω : Type u}
    (h : FinitePrefixMaterialWindowChannelSeparatedDecrementBindingSource Ω) :
    (Finset.range h.channelSource.prefixLength).sum h.windowCharge ≤
      h.channelSource.criticalBudget := by
  have hwindow_drop :
      (Finset.range h.channelSource.prefixLength).sum h.windowCharge ≤
        (Finset.range h.channelSource.prefixLength).sum h.channelSource.channelDrop := by
    exact Finset.sum_le_sum (fun n hn =>
      h.pointwiseWindowCharge_le_channelDrop_on_prefix n
        (Finset.mem_range.mp hn))
  exact le_trans hwindow_drop h.channelSource.channelDropPrefix_le_criticalBudget

/-- The finite binding instantiates the finite-prefix owner-preimage receipt. -/
noncomputable def FinitePrefixMaterialWindowChannelSeparatedDecrementBindingSource.toFinitePrefixOwnerPreimageReceipt
    {Ω : Type u}
    (h : FinitePrefixMaterialWindowChannelSeparatedDecrementBindingSource Ω) :
    FinitePrefixMaterialWindowOwnerPreimageReceipt :=
  FinitePrefixMaterialWindowOwnerPreimageReceipt.ofIdentityWindowAtoms
    h.channelSource.prefixLength h.windowCharge h.channelSource.channelDrop
    h.channelSource.criticalBudget
    h.windowCharge_nonnegative_on_prefix
    (by
      intro n hn
      exact le_trans (h.windowCharge_nonnegative_on_prefix n hn)
        (h.pointwiseWindowCharge_le_channelDrop_on_prefix n hn))
    h.channelSource.criticalBudget_nonnegative
    h.pointwiseWindowCharge_le_channelDrop_on_prefix
    h.channelSource.channelDropPrefix_le_criticalBudget
    h.ownerMapFixedBeforePayoff h.ownerMapFixedBeforePayoff_proof
    h.sameCarrierAndOwnerBinding h.sameCarrierAndOwnerBinding_proof
    h.globalSelectedWindowPreimageBound h.globalSelectedWindowPreimageBound_proof

