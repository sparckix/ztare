        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      NSL3MultiscaleYM.BadCenterScaleTruncationPresentation
        seq K hRho hCarrier hBeta}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      L3ASelectedIndexFromEventToBadNodeSource
        (seq := seq) (K := K) (hRho := hRho)
