  selectedPrefixLength : ℕ
  owner : ℕ → ℕ
  windowCharge : ℕ → ℝ
  atomCharge : ℕ → ℝ
  activeAtomBound : ℕ
  C : ℝ
  atomBudget : ℝ
  windowCharge_nonnegative_on_prefix :
    ∀ n : ℕ, n < selectedPrefixLength → 0 ≤ windowCharge n
  atomCharge_nonnegative_on_active_prefix :
    ∀ a : ℕ, a < activeAtomBound → 0 ≤ atomCharge a
  C_nonnegative : 0 ≤ C
  atomBudget_nonnegative : 0 ≤ atomBudget
  owner_lt_activeAtomBound_on_prefix :
    ∀ {e : ℕ}, e < selectedPrefixLength → owner e < activeAtomBound
  pointwiseOwnedAtomPaysWindow_on_prefix :
    ∀ e : ℕ, e < selectedPrefixLength → windowCharge e ≤ atomCharge (owner e)
  ownerPreimagePrefixInequality :
    (Finset.range selectedPrefixLength).sum windowCharge ≤
      C * (Finset.range activeAtomBound).sum atomCharge
  activeAtomPrefixBudget :
    (Finset.range activeAtomBound).sum atomCharge ≤ atomBudget
  ownerMapFixedBeforePayoff : Prop
  ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff
  sameMaterialTimeCarrier : Prop
  sameMaterialTimeCarrier_proof : sameMaterialTimeCarrier
  globalSelectedWindowPreimageBound : Prop
  globalSelectedWindowPreimageBound_proof : globalSelectedWindowPreimageBound

/-- Consume a finite-prefix owner-preimage receipt as a selected-prefix budget. -/
theorem FinitePrefixMaterialWindowOwnerPreimageReceipt.windowPrefix_le_ownerBudget
    (h : FinitePrefixMaterialWindowOwnerPreimageReceipt) :
    (Finset.range h.selectedPrefixLength).sum h.windowCharge ≤
      h.C * h.atomBudget := by
  exact le_trans h.ownerPreimagePrefixInequality
    (mul_le_mul_of_nonneg_left h.activeAtomPrefixBudget h.C_nonnegative)

/-- Identity-owner constructor for one selected finite prefix. -/
def FinitePrefixMaterialWindowOwnerPreimageReceipt.ofIdentityWindowAtoms
    (selectedPrefixLength : ℕ)
    (windowCharge atomCharge : ℕ → ℝ) (atomBudget : ℝ)
    (windowCharge_nonnegative_on_prefix :
      ∀ n : ℕ, n < selectedPrefixLength → 0 ≤ windowCharge n)
    (atomCharge_nonnegative_on_prefix :
      ∀ n : ℕ, n < selectedPrefixLength → 0 ≤ atomCharge n)
    (atomBudget_nonnegative : 0 ≤ atomBudget)
    (pointwiseWindowCharge_le_atomCharge_on_prefix :
      ∀ n : ℕ, n < selectedPrefixLength → windowCharge n ≤ atomCharge n)
    (atomPrefixBudget :
      (Finset.range selectedPrefixLength).sum atomCharge ≤ atomBudget)
    (ownerMapFixedBeforePayoff : Prop)
    (ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff)
    (sameMaterialTimeCarrier : Prop)
    (sameMaterialTimeCarrier_proof : sameMaterialTimeCarrier)
    (globalSelectedWindowPreimageBound : Prop)
    (globalSelectedWindowPreimageBound_proof :
      globalSelectedWindowPreimageBound) :
    FinitePrefixMaterialWindowOwnerPreimageReceipt where
  selectedPrefixLength := selectedPrefixLength
  owner := fun n : ℕ => n
  windowCharge := windowCharge
  atomCharge := atomCharge
  activeAtomBound := selectedPrefixLength
  C := 1
  atomBudget := atomBudget
  windowCharge_nonnegative_on_prefix := windowCharge_nonnegative_on_prefix
  atomCharge_nonnegative_on_active_prefix := atomCharge_nonnegative_on_prefix
  C_nonnegative := by norm_num
  atomBudget_nonnegative := atomBudget_nonnegative
  owner_lt_activeAtomBound_on_prefix := by
    intro e he
    exact he
  pointwiseOwnedAtomPaysWindow_on_prefix :=
    pointwiseWindowCharge_le_atomCharge_on_prefix
  ownerPreimagePrefixInequality := by
    simpa using
      Finset.sum_le_sum
        (fun n hn =>
          pointwiseWindowCharge_le_atomCharge_on_prefix n
            (Finset.mem_range.mp hn))
  activeAtomPrefixBudget := atomPrefixBudget
  ownerMapFixedBeforePayoff := ownerMapFixedBeforePayoff
  ownerMapFixedBeforePayoff_proof := ownerMapFixedBeforePayoff_proof
  sameMaterialTimeCarrier := sameMaterialTimeCarrier
  sameMaterialTimeCarrier_proof := sameMaterialTimeCarrier_proof
  globalSelectedWindowPreimageBound := globalSelectedWindowPreimageBound
  globalSelectedWindowPreimageBound_proof :=
    globalSelectedWindowPreimageBound_proof

