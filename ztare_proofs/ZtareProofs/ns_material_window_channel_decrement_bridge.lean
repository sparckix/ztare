/--
Bridge from the existing channel-separated boundary decrement source to the
material time-window owner-preimage socket.

This does not say the handoff is automatic.  It requires same-event material
window binding plus numerical nonnegativity/payment receipts for the channel
sum, because the Level331 source's qualitative channel labels alone are not the
Level382 owner-preimage receipt.
-/
structure MaterialWindowChannelSeparatedDecrementBindingSource (Ω : Type u) where
  channelSource : ChannelSeparatedStoppingTreeDecrementReserveSource Ω
  windowCharge : Nat -> Real
  channelDrop_nonnegative :
    ∀ n : Nat, 0 ≤
      channelSource.productionDrop n + channelSource.pressureReserve n +
        channelSource.duhamelReserve n + channelSource.inheritedReserve n +
          channelSource.paidChildInvoice n
  windowCharge_nonnegative : ∀ n : Nat, 0 ≤ windowCharge n
  criticalBudget_nonnegative : 0 ≤ channelSource.criticalBudget
  pointwiseWindowCharge_le_channelDrop :
    ∀ n : Nat, windowCharge n ≤
      channelSource.productionDrop n + channelSource.pressureReserve n +
        channelSource.duhamelReserve n + channelSource.inheritedReserve n +
          channelSource.paidChildInvoice n
  materialWindowEventFamilyBinding : Prop
  materialWindowEventFamilyBinding_proof : materialWindowEventFamilyBinding
  materialWindowIndexMapTotalOnPrefix : Prop
  materialWindowIndexMapTotalOnPrefix_proof : materialWindowIndexMapTotalOnPrefix
  sameEventStreamAsChannelSource : Prop
  sameEventStreamAsChannelSource_proof : sameEventStreamAsChannelSource
  sameCarrierAndOwnerBinding : Prop
  sameCarrierAndOwnerBinding_proof : sameCarrierAndOwnerBinding
  noProxyWindowFamily : Prop
  noProxyWindowFamily_proof : noProxyWindowFamily
  ownerMapFixedBeforePayoff : Prop
  ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff
  globalSelectedWindowPreimageBound : Prop
  globalSelectedWindowPreimageBound_proof : globalSelectedWindowPreimageBound

/-- The channel drop sequence used by the bridge. -/
noncomputable def MaterialWindowChannelSeparatedDecrementBindingSource.channelDrop
    {Ω : Type u} (h : MaterialWindowChannelSeparatedDecrementBindingSource Ω) :
    Nat -> Real :=
  fun n : Nat =>
    h.channelSource.productionDrop n + h.channelSource.pressureReserve n +
      h.channelSource.duhamelReserve n + h.channelSource.inheritedReserve n +
        h.channelSource.paidChildInvoice n

/--
With same-event binding and numeric channel receipts, the existing Level331
channel prefix budget instantiates the Level382 material-window owner receipt.
-/
noncomputable def MaterialWindowChannelSeparatedDecrementBindingSource.toMaterialTimeWindowOwnerPreimageReceipt
    {Ω : Type u} (h : MaterialWindowChannelSeparatedDecrementBindingSource Ω) :
    MaterialTimeWindowOwnerPreimageReceipt :=
  MaterialTimeWindowOwnerPreimageReceipt.ofIdentityWindowAtoms
    h.windowCharge h.channelDrop h.channelSource.criticalBudget
    h.windowCharge_nonnegative h.channelDrop_nonnegative
    h.criticalBudget_nonnegative
    h.pointwiseWindowCharge_le_channelDrop
    h.channelSource.channelDropPrefix_le_criticalBudget
    h.ownerMapFixedBeforePayoff h.ownerMapFixedBeforePayoff_proof
    h.sameCarrierAndOwnerBinding h.sameCarrierAndOwnerBinding_proof
    h.globalSelectedWindowPreimageBound h.globalSelectedWindowPreimageBound_proof

