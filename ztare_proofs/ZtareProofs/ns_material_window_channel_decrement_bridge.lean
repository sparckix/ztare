    h.noMeasureOnlyAsFiniteSupport
  noSizeSumOrMeasureOnlyAsExtractedSupport_proof :=
    h.noMeasureOnlyAsFiniteSupport_proof
  noCarlesonPackingLabelAsExtractedSupport :=
    h.noPackingLabelAsFiniteSupport
  noCarlesonPackingLabelAsExtractedSupport_proof :=
    h.noPackingLabelAsFiniteSupport_proof
