    {Ω : Type u}
    (h : FinitePrefixThresholdInterfaceFormulaChannelSource Ω) :
    ∀ n : ℕ, n < h.prefixLength →
      n < h.thresholdFormula.restrictedSourceLawPrefixLength := by
  intro n hn
  exact lt_of_lt_of_le hn h.prefixLength_le_restrictedSourceLawPrefixLength

/-- Convert the threshold-interface finite source to the Level440 formula-native source. -/
def FinitePrefixThresholdInterfaceFormulaChannelSource.toFinitePrefixFormulaNativeChannelSource
    {Ω : Type u}
    (h : FinitePrefixThresholdInterfaceFormulaChannelSource Ω) :
    FinitePrefixFormulaNativeChannelSeparatedStoppingTreeDecrementReserveSource Ω where
  thresholdFormula := h.thresholdFormula
