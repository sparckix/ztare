    extends BaseAnchoredStrictSupportIndexLowerBoundSource Ω where
  capacityFail_k : ℕ
  capacityFail_k_lt_supportLength :
    capacityFail_k < supportLength
  finalEndpoint_lt_tailCapacityAtFailure :
    baseIndex + (supportLength - 1) <
      supportIndex capacityFail_k + (supportLength - (capacityFail_k + 1))
