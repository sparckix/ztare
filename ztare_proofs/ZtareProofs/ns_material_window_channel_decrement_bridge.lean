/-- Convert the pressure/cutoff prefix-sum primitive to the Finset prefix form used here. -/
theorem finsetRange_sum_eq_nsTick668FinitePrefixSum (x : Nat -> Real) :
    ∀ N : Nat, (Finset.range N).sum x = nsTick668FinitePrefixSum x N := by
  intro N
  induction N with
  | zero =>
      simp [nsTick668FinitePrefixSum]
  | succ n ih =>
      rw [Finset.sum_range_succ, ih, nsTick668FinitePrefixSum]

