    intro k hk
    have hrestricted := h.supportIndex_lt_restricted k hk
    have heq :=
      h.thresholdFormula.thresholdInterfacePayment_eq_highInterfacePayment_on_restrictedPrefix
        (h.supportIndex k) hrestricted
    rw [← heq]
