/--
Strict adjacent increase plus absence of an intermediate Nat value forces the
next support-index slot to be exactly the Nat successor.
-/
theorem NoHoleContiguousSupportIndexSource.supportIndex_succ_eq_succ_on_prefix
    {Ω : Type u}
    (h : NoHoleContiguousSupportIndexSource Ω) :
    ∀ k : ℕ, k + 1 < h.supportLength →
      h.supportIndex (k + 1) = Nat.succ (h.supportIndex k) := by
  intro k hk
  let a := h.supportIndex k
  let b := h.supportIndex (k + 1)
  have hlt : a < b := by
    exact h.supportIndex_strict_succ_on_prefix k hk
  have hsle : Nat.succ a ≤ b := Nat.succ_le_of_lt hlt
  by_cases heq : b = Nat.succ a
  · exact heq
  · have hne : Nat.succ a ≠ b := by
      exact Ne.symm heq
    have hbetween : Nat.succ a < b := lt_of_le_of_ne hsle hne
    exfalso
    exact h.no_supportIndex_between_adjacent_on_prefix k (Nat.succ a) hk
      (Nat.lt_succ_self a) hbetween

