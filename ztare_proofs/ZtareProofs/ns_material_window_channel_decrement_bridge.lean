/-- Fixed successor steps imply the global affine supportIndex formula. -/
theorem FixedStepSupportIndexOrderSource.supportIndex_affine_on_prefix
    {Ω : Type u}
    (h : FixedStepSupportIndexOrderSource Ω) :
    ∀ k : ℕ, k < h.supportLength →
      h.supportIndex k = h.baseIndex + h.stride * k := by
  intro k
  induction k with
  | zero =>
      intro hk
      simpa using h.supportIndex_zero_eq_base hk
  | succ k ih =>
      intro hk
      have hkprev : k < h.supportLength :=
        Nat.lt_trans (Nat.lt_succ_self k) hk
      have hstep :
          h.supportIndex (Nat.succ k) = h.supportIndex k + h.stride := by
        simpa [Nat.succ_eq_add_one] using
          h.supportIndex_succ_step_on_prefix k hk
      calc
        h.supportIndex (Nat.succ k)
            = h.supportIndex k + h.stride := hstep
        _ = (h.baseIndex + h.stride * k) + h.stride := by
          rw [ih hkprev]
        _ = h.baseIndex + h.stride * Nat.succ k := by
          simp [Nat.mul_succ, Nat.add_assoc]

