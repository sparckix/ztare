/--
Level431 same-channel bridge: a suitable-defect threshold/formula local
certificate and a material-window owner-preimage binding consume the same
channel-separated reserve ledger.  This is a source-alignment receipt, not a new
proof that the separated budget exists.
-/
structure SuitableDefectFormulaBudgetMaterialWindowBindingSource (Ω : Type u) where
  localCertificate : SuitableDefectThresholdFormulaWithSeparatedBoundaryBudgetSource Ω
  materialBinding : MaterialWindowChannelSeparatedDecrementBindingSource Ω
  sameChannelSource : materialBinding.channelSource = localCertificate.separatedBudget
  materialChannelEvent_eq_formulaEvent_on_restrictedPrefix :
    ∀ n : Nat, n < localCertificate.thresholdFormula.restrictedSourceLawPrefixLength →
      materialBinding.channelSource.highInterfaceEventSet n =
        localCertificate.thresholdFormula.highInterfaceEventSet n
  materialWindowCharge_eq_formulaPayment_on_restrictedPrefix :
    ∀ n : Nat, n < localCertificate.thresholdFormula.restrictedSourceLawPrefixLength →
      materialBinding.windowCharge n =
        localCertificate.thresholdFormula.thresholdInterfacePayment n
  materialBoundary_eq_formulaBoundary_on_restrictedPrefix :
    ∀ n : Nat, n < localCertificate.thresholdFormula.restrictedSourceLawPrefixLength →
      materialBinding.channelSource.boundaryCharge n =
        localCertificate.thresholdFormula.thresholdBoundaryCharge n
  materialChannelDrop_eq_localChannelDrop_on_restrictedPrefix :
    ∀ n : Nat, n < localCertificate.thresholdFormula.restrictedSourceLawPrefixLength →
      materialBinding.channelDrop n =
        localCertificate.separatedBudget.productionDrop n +
          localCertificate.separatedBudget.pressureReserve n +
          localCertificate.separatedBudget.duhamelReserve n +
          localCertificate.separatedBudget.inheritedReserve n +
          localCertificate.separatedBudget.paidChildInvoice n
  localAndMaterialWindowsUseSameSelectedStream : Prop
  localAndMaterialWindowsUseSameSelectedStream_proof :
    localAndMaterialWindowsUseSameSelectedStream
  materialWindowNotProxyForThresholdEvents : Prop
  materialWindowNotProxyForThresholdEvents_proof :
    materialWindowNotProxyForThresholdEvents
  channelLedgerNotDuplicated : Prop
  channelLedgerNotDuplicated_proof : channelLedgerNotDuplicated
  noPostPayoffMaterialWindowRepair : Prop
  noPostPayoffMaterialWindowRepair_proof : noPostPayoffMaterialWindowRepair
  noHiddenCFBKMPSLOrLipschitzFlowImport : Prop
  noHiddenCFBKMPSLOrLipschitzFlowImport_proof :
    noHiddenCFBKMPSLOrLipschitzFlowImport

/-- The local threshold/formula certificate is still available from the aligned source. -/
theorem SuitableDefectFormulaBudgetMaterialWindowBindingSource.localCertificateReceipt
    {Ω : Type u}
    (h : SuitableDefectFormulaBudgetMaterialWindowBindingSource Ω) :
    ∃ _ : SelectedSectionExtensionalInterfaceVariationAnalyticLowerBoundBridge,
      ∀ N : ℕ,
        (N : ℝ) <=
          h.localCertificate.separatedBudget.criticalBudget /
            h.localCertificate.separatedBudget.δ :=
  h.localCertificate.localCertificate

/-- The material-window owner-preimage receipt is available from the same channel binding. -/
noncomputable def SuitableDefectFormulaBudgetMaterialWindowBindingSource.ownerPreimageReceipt
    {Ω : Type u}
    (h : SuitableDefectFormulaBudgetMaterialWindowBindingSource Ω) :
    MaterialTimeWindowOwnerPreimageReceipt :=
  h.materialBinding.toMaterialTimeWindowOwnerPreimageReceipt

/-- The two consumers share the same critical budget by the same-channel receipt. -/
theorem SuitableDefectFormulaBudgetMaterialWindowBindingSource.sharedCriticalBudget
    {Ω : Type u}
    (h : SuitableDefectFormulaBudgetMaterialWindowBindingSource Ω) :
    h.materialBinding.channelSource.criticalBudget =
      h.localCertificate.separatedBudget.criticalBudget := by
  rw [h.sameChannelSource]

/-- The two consumers share the same selected-depth scale by the same-channel receipt. -/
theorem SuitableDefectFormulaBudgetMaterialWindowBindingSource.sharedDelta
    {Ω : Type u}
    (h : SuitableDefectFormulaBudgetMaterialWindowBindingSource Ω) :
    h.materialBinding.channelSource.δ = h.localCertificate.separatedBudget.δ := by
  rw [h.sameChannelSource]

/-- Material window charge is tied to the formula payment on the restricted prefix. -/
theorem SuitableDefectFormulaBudgetMaterialWindowBindingSource.windowCharge_eq_thresholdPayment
    {Ω : Type u}
    (h : SuitableDefectFormulaBudgetMaterialWindowBindingSource Ω) :
    ∀ n : Nat, n < h.localCertificate.thresholdFormula.restrictedSourceLawPrefixLength →
      h.materialBinding.windowCharge n =
        h.localCertificate.thresholdFormula.thresholdInterfacePayment n :=
  h.materialWindowCharge_eq_formulaPayment_on_restrictedPrefix

/-- Material channel events are tied to the formula events on the restricted prefix. -/
theorem SuitableDefectFormulaBudgetMaterialWindowBindingSource.channelEvent_eq_formulaEvent
    {Ω : Type u}
    (h : SuitableDefectFormulaBudgetMaterialWindowBindingSource Ω) :
    ∀ n : Nat, n < h.localCertificate.thresholdFormula.restrictedSourceLawPrefixLength →
      h.materialBinding.channelSource.highInterfaceEventSet n =
        h.localCertificate.thresholdFormula.highInterfaceEventSet n :=
  h.materialChannelEvent_eq_formulaEvent_on_restrictedPrefix

