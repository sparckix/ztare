    ∀ n : Nat,
      h.channelSource.highInterfacePayment n ≤
        h.channelSource.productionDrop n + h.channelSource.pressureReserve n +
          h.channelSource.duhamelReserve n + h.channelSource.inheritedReserve n +
            h.channelSource.paidChildInvoice n := by
  intro n
  calc
    h.channelSource.highInterfacePayment n ≤ h.channelSource.boundaryCharge n :=
      h.channelSource.selectedPayment_le_boundaryCharge n
    _ = h.channelSource.boundaryMeasure (h.channelSource.highInterfaceEventSet n) :=
      h.channelSource.boundaryCharge_eq_boundaryMeasureOnSelectedTent n
    _ ≤ h.channelSource.productionDrop n + h.channelSource.pressureReserve n +
          h.channelSource.duhamelReserve n + h.channelSource.inheritedReserve n +
            h.channelSource.paidChildInvoice n :=
      h.channelSource.boundaryMeasure_le_channelDrop n

