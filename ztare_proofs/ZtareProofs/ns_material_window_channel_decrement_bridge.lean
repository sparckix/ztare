/--
Level501 least-hit incidence selector.  This replaces a supplied
`targetEventIndex` by a bounded existence theorem against the displayed
incidence relation, plus a collision-free theorem for incident targets.  Lean
then chooses the least incident event index and proves the bounded injection
needed by Level500.
-/
structure TargetEventIndexFromBoundedIncidenceLeastHitSource
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L)
    (supportLength : ℕ)
    (targetPrefixCount : ℕ → ℕ) where
  targetNode :
    Fin (targetPrefixCount (supportLength - 1)) →
      NSL3MultiscaleYM.DyadicParabolicCube
  boundedIncidentEventExists :
    ∀ i,
      ∃ e : ℕ,
        e < supportLength - 1 ∧ hInc.incidence e (targetNode i)
  incidentEventCollisionFree :
    ∀ i j e,
      hInc.incidence e (targetNode i) →
        hInc.incidence e (targetNode j) → i = j
  targetNodesComeFromTargetPrefix : Prop
  targetNodesComeFromTargetPrefix_proof :
    targetNodesComeFromTargetPrefix
  boundedExistenceUsesDisplayedIncidence : Prop
  boundedExistenceUsesDisplayedIncidence_proof :
    boundedExistenceUsesDisplayedIncidence
  boundedExistenceUsesPrefixDomination : Prop
  boundedExistenceUsesPrefixDomination_proof :
    boundedExistenceUsesPrefixDomination
  boundedExistenceUsesFanoutNoLogReuse : Prop
  boundedExistenceUsesFanoutNoLogReuse_proof :
    boundedExistenceUsesFanoutNoLogReuse
  collisionFreeBeforeCardinality : Prop
  collisionFreeBeforeCardinality_proof :
    collisionFreeBeforeCardinality
  fixedBeforePayoff : Prop
  fixedBeforePayoff_proof :
    fixedBeforePayoff
  noPostPayoffLeastHitChoice : Prop
  noPostPayoffLeastHitChoice_proof :
    noPostPayoffLeastHitChoice
  notTargetDeficitSelected : Prop
  notTargetDeficitSelected_proof :
    notTargetDeficitSelected
  notCardinalityAsIndexInjectivity : Prop
  notCardinalityAsIndexInjectivity_proof :
    notCardinalityAsIndexInjectivity
  notLabelOnlyIncidence : Prop
  notLabelOnlyIncidence_proof :
    notLabelOnlyIncidence

/-- Choose the least bounded incident event for each target node. -/
noncomputable def TargetEventIndexFromBoundedIncidenceLeastHitSource.targetEventIndex
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      TargetEventIndexFromBoundedIncidenceLeastHitSource
        hInc supportLength targetPrefixCount) :
    Fin (targetPrefixCount (supportLength - 1)) → ℕ :=
  fun i => by
    classical
    exact Nat.find (h.boundedIncidentEventExists i)

/-- The least incident event lands below the final-slot bound. -/
theorem TargetEventIndexFromBoundedIncidenceLeastHitSource.targetEventIndex_lt_finalSlot
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      TargetEventIndexFromBoundedIncidenceLeastHitSource
        hInc supportLength targetPrefixCount) :
    ∀ i, h.targetEventIndex i < supportLength - 1 := by
  classical
  intro i
  exact (Nat.find_spec (h.boundedIncidentEventExists i)).1

/-- Collision-free incidence makes the least-hit event-index selector injective. -/
theorem TargetEventIndexFromBoundedIncidenceLeastHitSource.targetEventIndex_injective
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      TargetEventIndexFromBoundedIncidenceLeastHitSource
        hInc supportLength targetPrefixCount) :
    Function.Injective h.targetEventIndex := by
  classical
  intro i j hij
  have hiInc :
      hInc.incidence (h.targetEventIndex i) (h.targetNode i) :=
    (Nat.find_spec (h.boundedIncidentEventExists i)).2
  have hjIncRaw :
      hInc.incidence (h.targetEventIndex j) (h.targetNode j) :=
    (Nat.find_spec (h.boundedIncidentEventExists j)).2
  have hjInc :
      hInc.incidence (h.targetEventIndex i) (h.targetNode j) := by
    rw [hij]
    exact hjIncRaw
  exact h.incidentEventCollisionFree i j (h.targetEventIndex i) hiInc hjInc

