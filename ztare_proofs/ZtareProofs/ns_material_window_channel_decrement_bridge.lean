The two-slot double-step witness fails final-endpoint tail capacity at its
right endpoint: `baseIndex + finalSlot = 1`, while `supportIndex 1 = 2`.
-/
theorem skippedSlotDoubleSupportIndex_tail_capacity_failure_on_two :
    0 + (2 - 1) <
      skippedSlotDoubleSupportIndex 1 + (2 - (1 + 1)) := by
  norm_num [skippedSlotDoubleSupportIndex]

/--
A Level479 failure witness cannot share supportLength, baseIndex, and
supportIndex values with a Level478 tail-capacity source.
-/
theorem BaseAnchoredTailCapacityFailureWitness.not_baseAnchoredTailCapacityEndpointSource_on_same_supportIndex
    {Ω : Type u}
    (w : BaseAnchoredTailCapacityFailureWitness Ω)
    (h : BaseAnchoredTailCapacityEndpointSource Ω)
    (hsupportLength : h.supportLength = w.supportLength)
    (hbaseIndex : h.baseIndex = w.baseIndex)
    (hsupportIndex : ∀ i : ℕ, h.supportIndex i = w.supportIndex i) :
    False := by
  have hk : w.capacityFail_k < h.supportLength := by
    rw [hsupportLength]
    exact w.capacityFail_k_lt_supportLength
  have hcap := h.supportIndex_tail_capacity_on_prefix w.capacityFail_k hk
  have hcap_w :
      w.supportIndex w.capacityFail_k +
          (w.supportLength - (w.capacityFail_k + 1)) ≤
        w.baseIndex + (w.supportLength - 1) := by
    simpa [hsupportLength, hbaseIndex, hsupportIndex w.capacityFail_k]
      using hcap
  exact (not_lt_of_ge hcap_w) w.finalEndpoint_lt_tailCapacityAtFailure

