/--
The Level511 cover relation is the selected-index graph guarded by the two
finite-prefix fields of the displayed same-tree prefix primitive.
-/
def L3APrefixCoverFromFiniteScaleCofinalitySource.targetEventDataIndexCover
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      NSL3MultiscaleYM.BadCenterScaleTruncationPresentation
        seq K hRho hCarrier hBeta}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      L3APrefixCoverFromFiniteScaleCofinalitySource
        (seq := seq) (K := K) (hRho := hRho)
        (hCarrier := hCarrier) (hBeta := hBeta) (hEvents := hEvents)
        (L := L) (hScale := hScale) (hInc := hInc)
        supportLength targetPrefixCount) :
    Fin (targetPrefixCount (supportLength - 1)) →
      Fin (supportLength - 1) → Prop :=
  fun i j =>
    h.prefixDominationPrimitive.finiteScalePrefixComparison ∧
      h.prefixDominationPrimitive.eventPrefixCofinalWithScalePrefix ∧
        j = h.selectedEventDataIndex i

/-- The selected eventData index is a member of the Level511 guarded graph. -/
theorem L3APrefixCoverFromFiniteScaleCofinalitySource.selectedEventDataIndex_covers
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      NSL3MultiscaleYM.BadCenterScaleTruncationPresentation
        seq K hRho hCarrier hBeta}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      L3APrefixCoverFromFiniteScaleCofinalitySource
        (seq := seq) (K := K) (hRho := hRho)
        (hCarrier := hCarrier) (hBeta := hBeta) (hEvents := hEvents)
        (L := L) (hScale := hScale) (hInc := hInc)
        supportLength targetPrefixCount) :
    ∀ i,
      h.targetEventDataIndexCover i (h.selectedEventDataIndex i) := by
  intro i
  exact ⟨h.finiteScalePrefixComparison_proof,
    h.eventPrefixCofinalWithScalePrefix_proof, rfl⟩

/-- The guarded graph transports displayed incidence from the selected index. -/
theorem L3APrefixCoverFromFiniteScaleCofinalitySource.coverImpliesDisplayedIncidence
    {seq : NSL3MultiscaleYM.LerayHopfSequence}
    {K : NSL3MultiscaleYM.CompactSubCylinder}
    {hRho : NSL3MultiscaleYM.RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NSL3MultiscaleYM.NonadaptiveBadCenterCarrierFromNormalizedExcess
        seq K hRho}
    {hBeta :
      NSL3MultiscaleYM.BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents :
      NSL3MultiscaleYM.BadCenterEventNodeIdentification
        seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      NSL3MultiscaleYM.BadCenterScaleTruncationPresentation
        seq K hRho hCarrier hBeta}
    {hInc :
      NSL3MultiscaleYM.BadCenterEventIncidenceGeometry
        seq K hRho hCarrier hBeta hEvents L}
    {supportLength : ℕ}
    {targetPrefixCount : ℕ → ℕ}
    (h :
      L3APrefixCoverFromFiniteScaleCofinalitySource
        (seq := seq) (K := K) (hRho := hRho)
        (hCarrier := hCarrier) (hBeta := hBeta) (hEvents := hEvents)
        (L := L) (hScale := hScale) (hInc := hInc)
        supportLength targetPrefixCount) :
    ∀ i j, h.targetEventDataIndexCover i j →
      hInc.incidence j.val (h.targetNode i) := by
  intro i j hcover
  rcases hcover with ⟨_, _, hj⟩
  subst j
  exact h.selectedEventDataIndex_incident i

