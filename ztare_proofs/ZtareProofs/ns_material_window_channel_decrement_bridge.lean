/--
Level443 selected-witness threshold-interface source.  The suitable-defect
formula gives one selected threshold payment and its selected boundary payment;
this is useful information, but it is not the prefix-wide lower-payment source
required by Level442.
-/
structure SelectedThresholdInterfaceWitnessSource (Ω : Type u) where
  thresholdFormula : SuitableDefectThresholdFormulaSelectedVariationSource Ω
  δ : ℝ
  δ_pos : 0 < δ
  selectedThresholdIndex : ℕ
  selectedThresholdIndex_eq_selectedHighInterfaceIndex :
    selectedThresholdIndex =
      thresholdFormula.selectedHighInterfacePrefixIndex
  selectedThresholdIndex_lt_restrictedPrefix :
    selectedThresholdIndex < thresholdFormula.restrictedSourceLawPrefixLength
  selectedThresholdInterfacePaymentLowerBound :
    δ <= thresholdFormula.thresholdInterfacePayment selectedThresholdIndex
  selectedThresholdInterfacePayment_le_boundaryCharge :
    thresholdFormula.thresholdInterfacePayment selectedThresholdIndex <=
      thresholdFormula.thresholdBoundaryCharge selectedThresholdIndex
  selectedWitnessFixedBeforePayoff : Prop
  selectedWitnessFixedBeforePayoff_proof :
    selectedWitnessFixedBeforePayoff
  selectedWitnessSameCarrierAsFormula : Prop
  selectedWitnessSameCarrierAsFormula_proof :
    selectedWitnessSameCarrierAsFormula
  selectedWitnessNoReuseNoRebilling : Prop
  selectedWitnessNoReuseNoRebilling_proof :
    selectedWitnessNoReuseNoRebilling
  selectedWitnessOnlyNotPrefixWide : Prop
  selectedWitnessOnlyNotPrefixWide_proof :
    selectedWitnessOnlyNotPrefixWide

/-- The suitable-defect threshold formula supplies exactly the selected witness. -/
noncomputable def SelectedThresholdInterfaceWitnessSource.ofSuitableDefectThresholdFormula
    {Ω : Type u}
    (h : SuitableDefectThresholdFormulaSelectedVariationSource Ω)
    (δ : ℝ)
    (hδ_pos : 0 < δ)
    (hδ_le_floor : δ <= h.interfacePaymentFloor)
    (selectedWitnessOnlyNotPrefixWide : Prop)
    (selectedWitnessOnlyNotPrefixWide_proof :
      selectedWitnessOnlyNotPrefixWide) :
    SelectedThresholdInterfaceWitnessSource Ω where
  thresholdFormula := h
  δ := δ
  δ_pos := hδ_pos
  selectedThresholdIndex := h.selectedHighInterfacePrefixIndex
  selectedThresholdIndex_eq_selectedHighInterfaceIndex := rfl
  selectedThresholdIndex_lt_restrictedPrefix :=
    h.selectedHighInterfacePrefixIndex_lt_restrictedPrefix
  selectedThresholdInterfacePaymentLowerBound := by
    have hpay :=
      h.thresholdInterfacePayment_eq_highInterfacePayment_on_restrictedPrefix
        h.selectedHighInterfacePrefixIndex
        h.selectedHighInterfacePrefixIndex_lt_restrictedPrefix
    rw [hpay]
    linarith [hδ_le_floor, h.selectedHighInterfacePaymentPaysFloor]
  selectedThresholdInterfacePayment_le_boundaryCharge := by
    have hpay :=
      h.thresholdInterfacePayment_eq_highInterfacePayment_on_restrictedPrefix
        h.selectedHighInterfacePrefixIndex
        h.selectedHighInterfacePrefixIndex_lt_restrictedPrefix
    have hboundary :=
      h.thresholdBoundaryCharge_eq_highInterfaceBoundaryCharge_on_restrictedPrefix
        h.selectedHighInterfacePrefixIndex
        h.selectedHighInterfacePrefixIndex_lt_restrictedPrefix
    have hselectedBoundary :=
      h.pointwiseHighInterfacePayment_le_localEnergyInvoice
        h.selectedHighInterfacePrefixIndex h.selectedHighInterfacePrefixIndex_lt
    rw [← h.localEnergyInvoice_eq_boundaryCharge
      h.selectedHighInterfacePrefixIndex] at hselectedBoundary
    rw [hpay, hboundary]
    exact hselectedBoundary
  selectedWitnessFixedBeforePayoff :=
    h.suitableDefectSelectedIndexFixedBeforePayoff
  selectedWitnessFixedBeforePayoff_proof :=
    h.suitableDefectSelectedIndexFixedBeforePayoff_proof
  selectedWitnessSameCarrierAsFormula :=
    h.suitableDefectThresholdHighInterfaceLawSameCarrier
  selectedWitnessSameCarrierAsFormula_proof :=
    h.suitableDefectThresholdHighInterfaceLawSameCarrier_proof
  selectedWitnessNoReuseNoRebilling :=
    h.suitableDefectThresholdFormulaNoReuseNoRebilling
  selectedWitnessNoReuseNoRebilling_proof :=
    h.suitableDefectThresholdFormulaNoReuseNoRebilling_proof
  selectedWitnessOnlyNotPrefixWide := selectedWitnessOnlyNotPrefixWide
  selectedWitnessOnlyNotPrefixWide_proof :=
    selectedWitnessOnlyNotPrefixWide_proof

