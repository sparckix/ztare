      hInvoice).doesNotFactorThroughCFDirectionAlignment =
      hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.doesNotFactorThroughCFDirectionAlignment
  notDegreeZeroRieszBookkeeping_eq :
