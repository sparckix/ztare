/--
PSD trace payment receipt for the selected annular projected packet.

This is the remaining field after the route-output and operator-admissibility
splits.  It is intentionally stronger than a preprojection PSD label: it
requires the selected projected target to be identified with the PSD fiber,
excludes projected shell overflow, and records selected-prefix no-reuse.
-/
structure C7PSDTracePaysAnnularProjectedPacketReceipt where
  preprojectionIdentity :
    TraceFreeVariationProjectedTargetPreprojectionIdentityReceipt
  sameAnnularProjectedPacketAsPreprojectionPSDFiber : Prop
  sameAnnularProjectedPacketAsPreprojectionPSDFiber_proof :
    sameAnnularProjectedPacketAsPreprojectionPSDFiber
  projectedCZShellOverflowExcluded : Prop
  projectedCZShellOverflowExcluded_proof :
    projectedCZShellOverflowExcluded
  selectedPSDTraceOwnerPrefixNoReuse : Prop
  selectedPSDTraceOwnerPrefixNoReuse_proof :
    selectedPSDTraceOwnerPrefixNoReuse
  psdTraceNotReusedAcrossSelectedInvoices : Prop
  psdTraceNotReusedAcrossSelectedInvoices_proof :
    psdTraceNotReusedAcrossSelectedInvoices
  notPreprojectionOnlyLabel : Prop
  notPreprojectionOnlyLabel_proof : notPreprojectionOnlyLabel

/-- The field consumed by the annular Riesz/PSD theorem profile. -/
def C7PSDTracePaysAnnularProjectedPacketReceipt.paymentField
    (h : C7PSDTracePaysAnnularProjectedPacketReceipt) : Prop :=
  h.preprojectionIdentity.selectedC7ProjectedTargetIsPreprojectionPSDFiber ∧
    h.preprojectionIdentity.selectedC7ReadsPreprojectionStress ∧
    h.preprojectionIdentity.projectionKernelFixedBeforePayoff ∧
    h.preprojectionIdentity.noLerayRieszL1PaymentHiddenInIdentity ∧
    h.sameAnnularProjectedPacketAsPreprojectionPSDFiber ∧
    h.projectedCZShellOverflowExcluded ∧
    h.selectedPSDTraceOwnerPrefixNoReuse ∧
    h.psdTraceNotReusedAcrossSelectedInvoices ∧
    h.notPreprojectionOnlyLabel

/-- A PSD projected-packet receipt supplies the annular PSD payment field. -/
theorem C7PSDTracePaysAnnularProjectedPacketReceipt.paymentField_proof
    (h : C7PSDTracePaysAnnularProjectedPacketReceipt) :
    h.paymentField := by
  exact
    ⟨h.preprojectionIdentity.selectedC7ProjectedTargetIsPreprojectionPSDFiber_proof,
      h.preprojectionIdentity.selectedC7ReadsPreprojectionStress_proof,
      h.preprojectionIdentity.projectionKernelFixedBeforePayoff_proof,
      h.preprojectionIdentity.noLerayRieszL1PaymentHiddenInIdentity_proof,
      h.sameAnnularProjectedPacketAsPreprojectionPSDFiber_proof,
      h.projectedCZShellOverflowExcluded_proof,
      h.selectedPSDTraceOwnerPrefixNoReuse_proof,
      h.psdTraceNotReusedAcrossSelectedInvoices_proof,
      h.notPreprojectionOnlyLabel_proof⟩

/--
Confuser for the PSD projected-packet receipt.

It ties the new receipt back to the existing Tick668 blockers: projected CZ
shell overflow, selected-invoice reuse, and preprojection-only PSD labels.
-/
structure C7PSDProjectedPacketReceiptConfuser where
  shellOverflow : TraceFreeVariationProjectedCZShellOverflowConfuser
  reuseGap : ProjectedRieszPSDTraceReuseGapPacket
  preprojectionOnly : TraceFreeVariationPSDPreprojectionOnlyConfuser
  noShellOverflowExclusionForAnyReceipt :
    ∀ h : C7PSDTracePaysAnnularProjectedPacketReceipt,
      ¬ h.projectedCZShellOverflowExcluded
  noSelectedPrefixNoReuseForAnyReceipt :
    ∀ h : C7PSDTracePaysAnnularProjectedPacketReceipt,
      ¬ h.selectedPSDTraceOwnerPrefixNoReuse
  noNonPreprojectionOnlyLabelForAnyReceipt :
    ∀ h : C7PSDTracePaysAnnularProjectedPacketReceipt,
      ¬ h.notPreprojectionOnlyLabel

/-- Projected shell overflow blocks the PSD projected-packet receipt. -/
theorem no_C7PSDTracePaysAnnularProjectedPacketReceipt_of_shellOverflow
    (hConfuser : C7PSDProjectedPacketReceiptConfuser) :
    ¬ Nonempty C7PSDTracePaysAnnularProjectedPacketReceipt := by
  intro hNonempty
  rcases hNonempty with ⟨hReceipt⟩
  exact hConfuser.noShellOverflowExclusionForAnyReceipt hReceipt
    hReceipt.projectedCZShellOverflowExcluded_proof

/-- Selected-invoice PSD trace reuse blocks the PSD projected-packet receipt. -/
theorem no_C7PSDTracePaysAnnularProjectedPacketReceipt_of_traceReuse
    (hConfuser : C7PSDProjectedPacketReceiptConfuser) :
    ¬ Nonempty C7PSDTracePaysAnnularProjectedPacketReceipt := by
  intro hNonempty
  rcases hNonempty with ⟨hReceipt⟩
  exact hConfuser.noSelectedPrefixNoReuseForAnyReceipt hReceipt
    hReceipt.selectedPSDTraceOwnerPrefixNoReuse_proof

/-- A preprojection-only PSD label blocks the PSD projected-packet receipt. -/
theorem no_C7PSDTracePaysAnnularProjectedPacketReceipt_of_preprojectionOnly
    (hConfuser : C7PSDProjectedPacketReceiptConfuser) :
    ¬ Nonempty C7PSDTracePaysAnnularProjectedPacketReceipt := by
  intro hNonempty
  rcases hNonempty with ⟨hReceipt⟩
  exact hConfuser.noNonPreprojectionOnlyLabelForAnyReceipt hReceipt
    hReceipt.notPreprojectionOnlyLabel_proof

/--
Missing target identity blocks the full PSD projected-packet payment receipt.

This is the Tick669-facing form of the lower Tick668 blocker: a PSD trace
packet cannot pay the selected projected annular packet merely by being a
preprojection PSD label.
-/
theorem no_C7PSDTracePaysAnnularProjectedPacketReceipt_of_missingPreprojectionTargetIdentity
    (hConfuser :
      TraceFreeVariationProjectedTargetPreprojectionIdentityMissingConfuser)
    (hReceipt : C7PSDTracePaysAnnularProjectedPacketReceipt)
    (hIdentitySame :
      hReceipt.preprojectionIdentity.selectedC7ProjectedTargetIsPreprojectionPSDFiber =
        (hConfuser.preprojectionIdentityMissing = False)) :
    False :=
  no_TraceFreeVariationProjectedTargetPreprojectionIdentityReceipt_of_missingIdentity
    hConfuser
    hReceipt.preprojectionIdentity
    hIdentitySame

/--
Route-1 source form of the same blocker: the projected Riesz formula source
does not supply the C7 preprojection target identity by itself.
-/
theorem no_C7PSDTracePaysAnnularProjectedPacketReceipt_of_route1MissingPreprojectionTargetIdentity
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hConfuser :
      TraceFreeVariationRoute1ProjectedRieszTargetLockConfuser formula)
    (hReceipt : C7PSDTracePaysAnnularProjectedPacketReceipt)
    (hIdentitySame :
      hReceipt.preprojectionIdentity.selectedC7ProjectedTargetIsPreprojectionPSDFiber =
        (hConfuser.preprojectionIdentityMissing = False)) :
    False :=
  no_C7PSDTracePaysAnnularProjectedPacketReceipt_of_missingPreprojectionTargetIdentity
    (TraceFreeVariationProjectedTargetPreprojectionIdentityMissingConfuser.ofRoute1ProjectedTargetLock
      hConfuser)
    hReceipt
    hIdentitySame

