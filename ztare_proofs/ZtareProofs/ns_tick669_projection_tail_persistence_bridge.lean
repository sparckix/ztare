        hSplit.splitWitness.telescoping}
    (hLimit :
      C7ProjectionTailFinitePrefixLimitPassageReceipt
        hSrc hLock hInvoice) where
  projectionTailNoLossMatchesInfiniteTreeNoBoundaryLoss :
    hLimit.noProjectionTailLossAtLimit =
      hSplit.splitWitness.telescoping.infiniteTreeLimitNoBoundaryLoss

/--
Finite-prefix projection-tail no-loss pays the selected split witness's
infinite-tree no-boundary-loss field once the compatibility receipt identifies
the fields.
-/
theorem C7ProofCarryingResidualRadiusSplitWitness.infiniteTreeNoBoundaryLossProof_ofFinitePrefixLimitCompatibility
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
