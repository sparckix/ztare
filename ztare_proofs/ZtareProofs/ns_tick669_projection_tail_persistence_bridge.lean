        seq K hRho hPot hTree hDrop}
    {hInvoice :
      ExcessDropTelescopingCarriesSameTreeFreshInvoice
        seq K hRho hPot hTree hDrop hTel}
    {hComplete : CoronaDuhamelC7SourceCompletion h hId}
    (hConcrete :
      C7DisplayedInvoiceGuardedConcreteIdentityReceipt
        (hElig := hElig) (hLock := hLock)
        hInvoice)
    (dropNodeRadiusIsResidualOrInherited :
      hDrop.nodeRadius = hElig.residualOrInherited.nodeRadius)
    (telescopingRadiusChargeMatchesProjectedCarrier :
      hTel.radiusChargingMeasure =
        hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.producesRadiusCharging)
    (hProp :
      C7DisplayedInvoiceSourceTimingPropIdentityReceipt
        hInvoice hComplete) :
    C7DisplayedInvoiceTelescopingFieldIdentityReceipt
      hInvoice hComplete :=
  C7DisplayedInvoiceTelescopingFieldIdentityReceipt.ofSourceTimingPropIdentity
    hConcrete.dropBadNodesAreSelectedBadNodes
    dropNodeRadiusIsResidualOrInherited
    hConcrete.invoiceRegion_eq
    hConcrete.dropNoReuseMatchesSameTreeLock
    telescopingRadiusChargeMatchesProjectedCarrier
    hProp

