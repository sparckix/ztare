noncomputable def FiveFrameCarlesonSameOwnerFiberStreamReceipt.ofC7SeparatedSourceOwnerGeometryBridgeAndActiveCarlesonBudget
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
