    (hSourceEqBudget :
      source.tracefreeValuationPay = budget.angularEventPay)
    (hPrefixBound :
      ∀ N : Nat,
        nsTick668FinitePrefixSum replayInvariantShadowTVPay N ≤
          budget.C * budget.ownerTVBudget)
