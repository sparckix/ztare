      Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hSource : FiveFrameTracefreeValuationSource formula)
    (hCarleson :
      TraceFreeVariationSameCarrierFreshNoReuseCarlesonReceipt) where
  noCommonOwnerFiberReceipt :
    ¬ Nonempty
      (FiveFrameCarlesonSameOwnerFiberStreamReceipt hSource hCarleson)
  sourceAndCarlesonVisible : Prop
  sourceAndCarlesonVisible_proof : sourceAndCarlesonVisible
  proxyFiberOrScalarVisibilitySurvives : Prop
  proxyFiberOrScalarVisibilitySurvives_proof :
    proxyFiberOrScalarVisibilitySurvives

/-- A proxy owner fiber blocks the same-owner-fiber stream receipt. -/
