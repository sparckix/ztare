      hInvoice).notDegreeZeroRieszBookkeeping =
      hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.notDegreeZeroRieszBookkeeping
  notParabolicRateSlavedScalar_eq :
    (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
      hInvoice).notParabolicRateSlavedScalar =
      hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.notParabolicRateSlavedScalar
  telescopingRadiusChargeMatchesProjectedCarrier :
    hTel.radiusChargingMeasure =
      hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.producesRadiusCharging

