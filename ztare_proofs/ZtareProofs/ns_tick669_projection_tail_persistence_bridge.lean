      hInvoice).invoicePaysRadiusForEachSelectedBadNode =
      hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.residualBranchLedgerEventsPayNodeRadii
  invoiceUsesSameNormalizedExcessStoppingTree_eq :
    (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
      hInvoice).invoiceUsesSameNormalizedExcessStoppingTree =
      hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.invoiceUsesSameNormalizedExcessStoppingTree
  descendantInvoicesDisjointOrBoundedOverlap_eq :
