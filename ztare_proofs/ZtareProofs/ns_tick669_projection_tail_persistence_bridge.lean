      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hPot : ExcessDropPotentialCandidate seq K hRho}
    {hTree : ExcessDropTreeSuperadditivity seq K hRho hPot}
    (badNodeConsumesResidualRadius : Prop)
    (chargesResidualRadiusNotClassicalRadiusSquared : Prop)
    (noReuseOfResidualRadiusDropAlongNestedBadNodes : Prop)
    (sourceUsesResidualInheritedDichotomy : Prop)
    (sourceUsesResidualInheritedDichotomy_proof :
      sourceUsesResidualInheritedDichotomy)
    (notPostSelectedFromDisplayedInvoice : Prop) :
    C7ResidualNodeRadiusBadNodeRadiusDropSource
      (hElig := hElig) (hPot := hPot) (hTree := hTree) where
  badNodeRadiusDrop := {
    badNodes := hCarrier.selectedBadNodes
    nodeRadius := hElig.residualOrInherited.nodeRadius
    badNodeConsumesRadius := badNodeConsumesResidualRadius
    chargesRadiusNotClassicalRadiusSquared :=
      chargesResidualRadiusNotClassicalRadiusSquared
    noReuseOfSameDropAlongNestedBadNodes :=
      noReuseOfResidualRadiusDropAlongNestedBadNodes
  }
  badNodesAreSelectedBadNodes := rfl
  nodeRadiusIsResidualOrInherited := rfl
  sourceUsesResidualInheritedDichotomy :=
    sourceUsesResidualInheritedDichotomy
  sourceUsesResidualInheritedDichotomy_proof :=
    sourceUsesResidualInheritedDichotomy_proof
  notPostSelectedFromDisplayedInvoice :=
    notPostSelectedFromDisplayedInvoice

/--
Classical `r_Q^2` mass charge cannot supply the residual-node-radius drop
source, because that source projects to an actual `BadNodeRadiusDrop`.
-/
theorem no_C7ResidualNodeRadiusBadNodeRadiusDropSource_of_classicalMassCharge
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hPot : ExcessDropPotentialCandidate seq K hRho}
    {hTree : ExcessDropTreeSuperadditivity seq K hRho hPot}
    (hClassical :
      ClassicalMassChargeDoesNotDefineExcessDropPotential seq K hRho) :
    ¬ Nonempty
      (C7ResidualNodeRadiusBadNodeRadiusDropSource
        (hElig := hElig) (hPot := hPot) (hTree := hTree)) := by
  intro hSource
  exact hClassical.cannotConstructBadNodeRadiusDrop hPot hTree
    ⟨hSource.some.badNodeRadiusDrop⟩

/--
Unnormalized mass/enstrophy telescoping with only square-scale bad-node cost
cannot supply the residual-node-radius drop source.
-/
theorem no_C7ResidualNodeRadiusBadNodeRadiusDropSource_of_unnormalizedMassSquareCharge
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hPot : ExcessDropPotentialCandidate seq K hRho}
    {hTree : ExcessDropTreeSuperadditivity seq K hRho hPot}
    (hUnnormalized :
      UnnormalizedMassTelescopesOnlyRadiusSquared seq K hRho) :
    ¬ Nonempty
      (C7ResidualNodeRadiusBadNodeRadiusDropSource
        (hElig := hElig) (hPot := hPot) (hTree := hTree)) := by
  intro hSource
  exact hUnnormalized.cannotConstructBadNodeRadiusDrop hPot hTree
    ⟨hSource.some.badNodeRadiusDrop⟩

