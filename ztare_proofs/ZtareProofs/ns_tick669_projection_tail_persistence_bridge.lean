/--
A fixed split witness with the wrong bad-node set cannot be linked to the C7
residual-node-radius drop source.
-/
theorem no_C7ResidualDropSourceLinkedSplitWitness_of_badNodesMismatch
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    (hSplit : ExcessDropChargesBadCylinderRadiusSplitWitness seq K hRho)
    (hMismatch :
      hSplit.badNodeRadiusDrop.badNodes ≠ hCarrier.selectedBadNodes) :
    ¬ Nonempty
      { hLinked : C7ResidualDropSourceLinkedSplitWitness (hElig := hElig) //
        hLinked.splitWitness = hSplit } := by
  intro hLinked
  have hBad0 :
      hLinked.some.val.splitWitness.badNodeRadiusDrop.badNodes =
        hCarrier.selectedBadNodes := by
    have hDrop := hLinked.some.val.splitDropMatchesResidualSource
    have hSourceBad := hLinked.some.val.source.badNodesAreSelectedBadNodes
    rw [hDrop]
    exact hSourceBad
  have hBad :
      hSplit.badNodeRadiusDrop.badNodes = hCarrier.selectedBadNodes := by
    rw [hLinked.some.property] at hBad0
    exact hBad0
  exact hMismatch hBad

