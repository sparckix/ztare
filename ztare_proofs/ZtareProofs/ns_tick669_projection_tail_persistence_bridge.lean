/-- A displayed-invoice mismatch blocks the typed identity receipt. -/
theorem no_C7DisplayedInvoiceMatchesProjectedCarrierReceipt_of_mismatch
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {hPot : ExcessDropPotentialCandidate seq K hRho}
    {hTree : ExcessDropTreeSuperadditivity seq K hRho hPot}
    {hDrop : BadNodeRadiusDrop seq K hRho hPot hTree}
    {hTel :
      ExcessDropTelescopesToRadiusCharging
        seq K hRho hPot hTree hDrop}
    {hInvoice :
      ExcessDropTelescopingCarriesSameTreeFreshInvoice
        seq K hRho hPot hTree hDrop hTel}
    {hComplete : CoronaDuhamelC7SourceCompletion h hId}
    (hMismatch :
      C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
          hInvoice ≠
        C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding
          hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding) :
    ¬ Nonempty
      (C7DisplayedInvoiceMatchesProjectedCarrierReceipt
        hInvoice hComplete) := by
  intro hReceipt
  exact hMismatch
    hReceipt.some.displayedInvoiceMatchesProjectedCarrier

/--
Extensionality for displayed C7 invoices using only the non-proof fields.
Proof fields are Prop-valued and are discharged by proof irrelevance after the
named fields are identified.
-/
theorem C7SameTreeFreshRadiusInvoice.eq_of_fieldwise_identity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {a b : C7SameTreeFreshRadiusInvoice seq K hRho}
    (badNodes_eq : a.badNodes = b.badNodes)
    (nodeRadius_eq : a.nodeRadius = b.nodeRadius)
    (invoiceRegion_eq : a.invoiceRegion = b.invoiceRegion)
    (invoiceAssignedBeforeSubtreeSelection_eq :
      a.invoiceAssignedBeforeSubtreeSelection =
        b.invoiceAssignedBeforeSubtreeSelection)
    (invoicePaysRadiusForEachSelectedBadNode_eq :
      a.invoicePaysRadiusForEachSelectedBadNode =
        b.invoicePaysRadiusForEachSelectedBadNode)
    (invoiceUsesSameNormalizedExcessStoppingTree_eq :
      a.invoiceUsesSameNormalizedExcessStoppingTree =
        b.invoiceUsesSameNormalizedExcessStoppingTree)
    (oneUseNoDescendantRebilling_eq :
      a.oneUseNoDescendantRebilling = b.oneUseNoDescendantRebilling)
    (descendantInvoicesDisjointOrBoundedOverlap_eq :
      a.descendantInvoicesDisjointOrBoundedOverlap =
        b.descendantInvoicesDisjointOrBoundedOverlap)
    (finiteFreshInvoiceBudget_eq :
      a.finiteFreshInvoiceBudget = b.finiteFreshInvoiceBudget)
    (doesNotFactorThroughCFDirectionAlignment_eq :
      a.doesNotFactorThroughCFDirectionAlignment =
        b.doesNotFactorThroughCFDirectionAlignment)
    (notDegreeZeroRieszBookkeeping_eq :
      a.notDegreeZeroRieszBookkeeping =
        b.notDegreeZeroRieszBookkeeping)
    (notParabolicRateSlavedScalar_eq :
      a.notParabolicRateSlavedScalar =
        b.notParabolicRateSlavedScalar)
    (producesRadiusCharging_eq :
      a.producesRadiusCharging = b.producesRadiusCharging) :
    a = b := by
  cases a
  cases b
  simp_all

