        hNoPostHocFreshCapacityFromRealizedRadiusSum
        matchingScheduleFixedBeforeRadiusSum
        hMatchingScheduleFixedBeforeRadiusSum
        sourceCompletionNotDeclarationOnly) :=
  C7ExcessDropRadiusChargeSourceFieldCompatibilityReceipt.ofProjectedCarrierEmbeddingIdentity
    hEmbeddingProducedCharge
    (C7ProjectedCarrierSameTreeInvoiceEmbeddingIdentityReceipt.ofCanonicalSelectedSameTreeInvoiceEmbeddingData
