/--
Local decay without a telescoping parent-child radius drop cannot supply the
residual-node-radius source with radius charging.
-/
theorem no_C7ResidualNodeRadiusDropSourceWithRadiusCharging_of_localDecayWithoutTelescoping
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hPot : ExcessDropPotentialCandidate seq K hRho}
    {hTree : ExcessDropTreeSuperadditivity seq K hRho hPot}
    (hLocal :
      LocalExcessDecayWithoutTelescopingDoesNotChargeRadius seq K hRho) :
    ¬ Nonempty
      (C7ResidualNodeRadiusDropSourceWithRadiusCharging
        (hElig := hElig) (hPot := hPot) (hTree := hTree)) := by
  intro hSource
  exact hLocal.cannotConstructRadiusCharging
    ⟨hSource.some.telescoping.radiusChargingMeasure⟩

