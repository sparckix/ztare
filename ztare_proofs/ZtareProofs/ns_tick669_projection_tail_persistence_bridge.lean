      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hWindow :
      C7CarrierGeometryProjectionTailWindowReceipt hPack hAssign)
    (finiteProjectedWindow_eq_c7ProjectionTailWindow :
      hAssign.finiteProjectedWindow = hWindow.c7ProjectionTailWindow)
    (tailAssignmentUsesResidualFreshCarrier :
      hAssign.tailReserveAssignmentSameCarrier ∧
        hPack.matchedCapacityLivesOnSameResidualFreshCarrier)
    (ownerRootRefinesC7SameCarrierWindow :
      hAssign.jointChannelRefinesOwnerPreimage ∧
        hPack.noDescendantCapacityReuse)
    (assignmentFixedBeforeProjectionOnThisWindow :
      hAssign.assignmentFixedBeforeProjection ∧
        hPack.nonadaptiveSourceSelection.matchingScheduleFixedBeforeRadiusSum)
    (notScalarOrCollarTailOnly :
      hPack.capacityNotScalarLedgerOnly ∧
        hAssign.jointChannelNotDefinedFromPayoff) :
    C7FiniteNoOverlapAssignmentExactSourceIsomorphism
      hPack hAssign where
  carrierGeometryWindowSource := {
    c7ProjectionTailWindow :=
      hWindow.c7ProjectionTailWindow
    selectedBySameCarrierRouteAuditPrefix :=
      hWindow.selectedBySameCarrierRouteAuditPrefix
    selectedBySameCarrierRouteAuditPrefix_proof :=
