/--
Fieldwise extensionality for the raw same-tree invoice embedding.

The proof avoids a wrapper-level invoice equality: every non-proof field of the
embedding itself must match, including the produced radius-charge measure.
-/
theorem SameTreeCarlesonInvoiceEmbedding.eq_of_fieldwise_identity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (a b : SameTreeCarlesonInvoiceEmbedding hElig hLock)
    (invoiceAssignedBeforeSubtreeSelection_eq :
      a.invoiceAssignedBeforeSubtreeSelection =
        b.invoiceAssignedBeforeSubtreeSelection)
    (eventDataMatchedToResidualFreshAuditIndex_eq :
      a.eventDataMatchedToResidualFreshAuditIndex =
        b.eventDataMatchedToResidualFreshAuditIndex)
    (residualBranchLedgerEventsPayNodeRadii_eq :
      a.residualBranchLedgerEventsPayNodeRadii =
        b.residualBranchLedgerEventsPayNodeRadii)
    (pressureCarrierIdentifiedWithResidualFreshRegion_eq :
      a.pressureCarrierIdentifiedWithResidualFreshRegion =
        b.pressureCarrierIdentifiedWithResidualFreshRegion)
