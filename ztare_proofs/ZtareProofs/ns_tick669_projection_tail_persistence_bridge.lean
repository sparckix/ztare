      (hPot := hPot) (hTree := hTree) (hDrop := hDrop) (hTel := hTel)
      hComplete where
  projectedBadNodesAreDropBadNodes :=
    hConcrete.dropBadNodesAreSelectedBadNodes.symm
  projectedNodeRadiusIsDropNodeRadius :=
    hCompat.dropNodeRadiusIsResidualOrInherited.symm
  projectedRadiusChargeIsTelescopingCharge :=
    hCompat.telescopingRadiusChargeMatchesProjectedCarrier.symm
  projectedNoReuseIsDropNoReuse :=
    hConcrete.dropNoReuseMatchesSameTreeLock.symm

