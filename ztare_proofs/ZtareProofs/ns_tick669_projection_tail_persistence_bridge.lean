/--
Assignment-free C7 selector for the projection-tail window.

This object is intentionally typed before any finite no-overlap assignment is
mentioned.  It is the C7-side witness that the projected window has been chosen
from same-carrier route/audit geometry, before comparing it to an older finite
assignment window.
-/
structure C7CarrierGeometryProjectionTailWindowSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId) where
  c7ProjectionTailWindow : Nat
  selectedBySameCarrierRouteAuditPrefix : Prop
  selectedBySameCarrierRouteAuditPrefix_proof :
    selectedBySameCarrierRouteAuditPrefix
  selectedBeforeProjectionTailPayment : Prop
  selectedBeforeProjectionTailPayment_proof :
    selectedBeforeProjectionTailPayment
  indexesResidualFreshCarrierWindow : Prop
  indexesResidualFreshCarrierWindow_proof :
    indexesResidualFreshCarrierWindow
  notDefinedFromFiniteNoOverlapAssignment : Prop
  notDefinedFromFiniteNoOverlapAssignment_proof :
    notDefinedFromFiniteNoOverlapAssignment

/--
Carrier window source from an owner-preimage prefix.

The selected C7 window is the active owner-atom prefix bound attached to a
same-carrier owner-preimage receipt at a route/audit prefix length.  The finite
no-overlap assignment is not an input.
-/
def C7CarrierGeometryProjectionTailWindowSource.ofOwnerPreimagePrefix
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    (hOwner : C7PackingOwnerPreimageReceipt hPack)
    (routeAuditPrefixLength : Nat)
    (routeAuditPrefixSelectedBeforeProjectionTailPayment : Prop)
    (hRouteAuditPrefixSelectedBeforeProjectionTailPayment :
      routeAuditPrefixSelectedBeforeProjectionTailPayment)
    (routeAuditPrefixCoversProjectionTailCarrier : Prop)
    (hRouteAuditPrefixCoversProjectionTailCarrier :
      routeAuditPrefixCoversProjectionTailCarrier)
    (ownerPrefixIndexesResidualFreshCarrierWindow : Prop)
    (hOwnerPrefixIndexesResidualFreshCarrierWindow :
      ownerPrefixIndexesResidualFreshCarrierWindow)
    (ownerPrefixNotDefinedFromFiniteNoOverlapAssignment : Prop)
    (hOwnerPrefixNotDefinedFromFiniteNoOverlapAssignment :
      ownerPrefixNotDefinedFromFiniteNoOverlapAssignment) :
    C7CarrierGeometryProjectionTailWindowSource hPack where
  c7ProjectionTailWindow :=
    hOwner.activeOwnerAtomBound routeAuditPrefixLength
  selectedBySameCarrierRouteAuditPrefix :=
    hOwner.ownerLivesInSameAnnularPhaseSpaceTent ∧
      routeAuditPrefixCoversProjectionTailCarrier
  selectedBySameCarrierRouteAuditPrefix_proof :=
    ⟨hOwner.ownerLivesInSameAnnularPhaseSpaceTent_proof,
      hRouteAuditPrefixCoversProjectionTailCarrier⟩
  selectedBeforeProjectionTailPayment :=
    hOwner.ownerChosenByStoppingRuleBeforePayoff ∧
      routeAuditPrefixSelectedBeforeProjectionTailPayment
  selectedBeforeProjectionTailPayment_proof :=
    ⟨hOwner.ownerChosenByStoppingRuleBeforePayoff_proof,
      hRouteAuditPrefixSelectedBeforeProjectionTailPayment⟩
  indexesResidualFreshCarrierWindow :=
    hOwner.ownerBudgetIsSameCoronaDuhamelCarrier ∧
      ownerPrefixIndexesResidualFreshCarrierWindow
  indexesResidualFreshCarrierWindow_proof :=
    ⟨hOwner.ownerBudgetIsSameCoronaDuhamelCarrier_proof,
      hOwnerPrefixIndexesResidualFreshCarrierWindow⟩
  notDefinedFromFiniteNoOverlapAssignment :=
    hOwner.ownerChosenByStoppingRuleBeforePayoff ∧
      ownerPrefixNotDefinedFromFiniteNoOverlapAssignment
  notDefinedFromFiniteNoOverlapAssignment_proof :=
    ⟨hOwner.ownerChosenByStoppingRuleBeforePayoff_proof,
      hOwnerPrefixNotDefinedFromFiniteNoOverlapAssignment⟩

/--
Alignment receipt between the owner-preimage active prefix bound and the finite
projected-window assignment.

This is the current narrow bridge target.  It bundles the owner-prefix selector,
the Nat equality to the finite projected window, and the source-field pairs
needed downstream.
-/
structure C7OwnerPreimageFiniteWindowAlignmentReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (hAssign : FiniteProjectedWindowNoOverlapAssignmentSource) where
  ownerPrefixReceipt :
    C7PackingOwnerPreimageReceipt hPack
  routeAuditPrefixLength : Nat
  routeAuditPrefixSelectedBeforeProjectionTailPayment : Prop
  routeAuditPrefixSelectedBeforeProjectionTailPayment_proof :
    routeAuditPrefixSelectedBeforeProjectionTailPayment
  routeAuditPrefixCoversProjectionTailCarrier : Prop
  routeAuditPrefixCoversProjectionTailCarrier_proof :
    routeAuditPrefixCoversProjectionTailCarrier
  ownerPrefixIndexesResidualFreshCarrierWindow : Prop
  ownerPrefixIndexesResidualFreshCarrierWindow_proof :
    ownerPrefixIndexesResidualFreshCarrierWindow
  ownerPrefixNotDefinedFromFiniteNoOverlapAssignment : Prop
  ownerPrefixNotDefinedFromFiniteNoOverlapAssignment_proof :
    ownerPrefixNotDefinedFromFiniteNoOverlapAssignment
  finiteProjectedWindow_eq_ownerActiveBound :
    hAssign.finiteProjectedWindow =
      ownerPrefixReceipt.activeOwnerAtomBound routeAuditPrefixLength
  tailAssignmentUsesResidualFreshCarrier :
    hAssign.tailReserveAssignmentSameCarrier ∧
      hPack.matchedCapacityLivesOnSameResidualFreshCarrier
  ownerRootRefinesC7SameCarrierWindow :
    hAssign.jointChannelRefinesOwnerPreimage ∧
      hPack.noDescendantCapacityReuse
  assignmentFixedBeforeProjectionOnThisWindow :
    hAssign.assignmentFixedBeforeProjection ∧
      hPack.nonadaptiveSourceSelection.matchingScheduleFixedBeforeRadiusSum
  notScalarOrCollarTailOnly :
    hPack.capacityNotScalarLedgerOnly ∧
      hAssign.jointChannelNotDefinedFromPayoff

/--
Identity active-bound shortcut for the owner-prefix/finite-window alignment.

When the owner-preimage active bound is the identity function, choosing the
route/audit prefix length to be `hAssign.finiteProjectedWindow` pays the Nat
equality in the alignment receipt.
-/
def C7OwnerPreimageFiniteWindowAlignmentReceipt.ofIdentityOwnerActiveBound
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hOwner : C7PackingOwnerPreimageReceipt hPack)
    (activeOwnerAtomBound_eq_id :
      hOwner.activeOwnerAtomBound = fun N : Nat => N)
    (routeAuditPrefixSelectedBeforeProjectionTailPayment : Prop)
    (hRouteAuditPrefixSelectedBeforeProjectionTailPayment :
      routeAuditPrefixSelectedBeforeProjectionTailPayment)
    (routeAuditPrefixCoversProjectionTailCarrier : Prop)
    (hRouteAuditPrefixCoversProjectionTailCarrier :
      routeAuditPrefixCoversProjectionTailCarrier)
    (ownerPrefixIndexesResidualFreshCarrierWindow : Prop)
    (hOwnerPrefixIndexesResidualFreshCarrierWindow :
      ownerPrefixIndexesResidualFreshCarrierWindow)
    (ownerPrefixNotDefinedFromFiniteNoOverlapAssignment : Prop)
    (hOwnerPrefixNotDefinedFromFiniteNoOverlapAssignment :
      ownerPrefixNotDefinedFromFiniteNoOverlapAssignment)
    (tailAssignmentUsesResidualFreshCarrier :
      hAssign.tailReserveAssignmentSameCarrier ∧
        hPack.matchedCapacityLivesOnSameResidualFreshCarrier)
    (ownerRootRefinesC7SameCarrierWindow :
      hAssign.jointChannelRefinesOwnerPreimage ∧
        hPack.noDescendantCapacityReuse)
    (assignmentFixedBeforeProjectionOnThisWindow :
      hAssign.assignmentFixedBeforeProjection ∧
        hPack.nonadaptiveSourceSelection.matchingScheduleFixedBeforeRadiusSum)
    (notScalarOrCollarTailOnly :
      hPack.capacityNotScalarLedgerOnly ∧
        hAssign.jointChannelNotDefinedFromPayoff) :
    C7OwnerPreimageFiniteWindowAlignmentReceipt hPack hAssign where
  ownerPrefixReceipt := hOwner
  routeAuditPrefixLength := hAssign.finiteProjectedWindow
  routeAuditPrefixSelectedBeforeProjectionTailPayment :=
    routeAuditPrefixSelectedBeforeProjectionTailPayment
  routeAuditPrefixSelectedBeforeProjectionTailPayment_proof :=
    hRouteAuditPrefixSelectedBeforeProjectionTailPayment
  routeAuditPrefixCoversProjectionTailCarrier :=
    routeAuditPrefixCoversProjectionTailCarrier
  routeAuditPrefixCoversProjectionTailCarrier_proof :=
    hRouteAuditPrefixCoversProjectionTailCarrier
  ownerPrefixIndexesResidualFreshCarrierWindow :=
    ownerPrefixIndexesResidualFreshCarrierWindow
  ownerPrefixIndexesResidualFreshCarrierWindow_proof :=
    hOwnerPrefixIndexesResidualFreshCarrierWindow
  ownerPrefixNotDefinedFromFiniteNoOverlapAssignment :=
    ownerPrefixNotDefinedFromFiniteNoOverlapAssignment
  ownerPrefixNotDefinedFromFiniteNoOverlapAssignment_proof :=
    hOwnerPrefixNotDefinedFromFiniteNoOverlapAssignment
  finiteProjectedWindow_eq_ownerActiveBound := by
    rw [activeOwnerAtomBound_eq_id]
  tailAssignmentUsesResidualFreshCarrier :=
    tailAssignmentUsesResidualFreshCarrier
