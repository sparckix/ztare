    (hCompat :
      C7ProofCarryingSplitWitnessInfiniteTreeNoBoundaryLossCompatibilityReceipt
        hLimit) :
    hSplit.splitWitness.telescoping.infiniteTreeLimitNoBoundaryLoss := by
  have hNoLoss : hLimit.noProjectionTailLossAtLimit :=
    hLimit.noProjectionTailLossAtLimit_proof
  rw [hCompat.projectionTailNoLossMatchesInfiniteTreeNoBoundaryLoss] at hNoLoss
  exact hNoLoss

