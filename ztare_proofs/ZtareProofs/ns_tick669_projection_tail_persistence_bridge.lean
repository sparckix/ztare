/--
Side-field source receipt for the radius-measure/drop nonclassical-charge
compatibility.

The side receipt already carries a proof of its own nonclassical-charge
proposition.  This receipt supplies the two missing identifications: that the
side receipt's radius measure is the selected split telescoping measure, and
that the side charge proposition is both the measure's charge field and the
selected drop charge field.
-/
structure C7SideFieldRadiusMeasureNonclassicalChargeCompatibilityReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    (hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig))
    (hSide :
      C7ResidualRadiusChargingSideFieldReceipt
        (hElig := hElig)
        (hPot := hSplit.splitWitness.potentialCandidate)
        (hTree := hSplit.splitWitness.treeSuperadditivity)) where
  sideRadiusMeasureIsSelectedTelescopingMeasure :
    hSide.radiusChargingMeasure =
      hSplit.splitWitness.telescoping.radiusChargingMeasure
  sideChargePropIsRadiusMeasureCharge :
    hSide.chargesResidualRadiusNotClassicalRadiusSquared =
      hSide.radiusChargingMeasure.chargesRadiusNotClassicalRadiusSquared
  sideChargePropIsSelectedDropCharge :
    hSide.chargesResidualRadiusNotClassicalRadiusSquared =
      hSplit.splitWitness.badNodeRadiusDrop.chargesRadiusNotClassicalRadiusSquared

/--
The side-field receipt pays the nonclassical-charge compatibility only after a
side-field/radius-measure identity receipt supplies the exact field bindings.
-/
def C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt.ofSideFieldRadiusMeasureCompatibility
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig)}
    {hSide :
      C7ResidualRadiusChargingSideFieldReceipt
        (hElig := hElig)
        (hPot := hSplit.splitWitness.potentialCandidate)
        (hTree := hSplit.splitWitness.treeSuperadditivity)}
    (hSideCompat :
      C7SideFieldRadiusMeasureNonclassicalChargeCompatibilityReceipt
        hSplit hSide) :
    C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt
      hSplit where
  radiusMeasureNonclassicalChargeProof := by
    have hCharge :
        hSide.chargesResidualRadiusNotClassicalRadiusSquared :=
      hSide.chargesResidualRadiusNotClassicalRadiusSquared_proof
    rw [hSideCompat.sideChargePropIsRadiusMeasureCharge] at hCharge
    rw [hSideCompat.sideRadiusMeasureIsSelectedTelescopingMeasure] at hCharge
    exact hCharge
  radiusMeasureNonclassicalChargeMatchesDropCharge := by
    have hMeasureField :
        hSide.radiusChargingMeasure.chargesRadiusNotClassicalRadiusSquared =
          hSplit.splitWitness.telescoping.radiusChargingMeasure.chargesRadiusNotClassicalRadiusSquared :=
      congrArg
        (fun hMeasure : RadiusChargingBadScaleMeasure seq K hRho =>
          hMeasure.chargesRadiusNotClassicalRadiusSquared)
        hSideCompat.sideRadiusMeasureIsSelectedTelescopingMeasure
    exact hMeasureField.symm.trans
      (hSideCompat.sideChargePropIsRadiusMeasureCharge.symm.trans
        hSideCompat.sideChargePropIsSelectedDropCharge)

/-- Side receipt whose radius measure is not the selected split measure cannot
pay the side-field-to-nonclassical compatibility receipt. -/
