def C7FiniteNoOverlapAssignmentExactSourceIsomorphism.ofCarrierGeometryWindowReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
