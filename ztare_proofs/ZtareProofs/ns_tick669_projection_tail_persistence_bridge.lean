      C7OwnerPreimageFiniteWindowAlignmentReceipt hPack hAssign}
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula :
      Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hSource :
      Route1AnnularOutputPacketTracefreeIdentitySource formula) :
    C7PSDRouteOutputSelectedStreamDefinition hAlign formula where
  outputSource := hSource
  selectedPSDInvoiceStreamDefinedByRoute1OutputBeforeSpend :=
    hSource.sameSelectedPrefixMapFixedBeforePayoff ∧
      hSource.noTargetDefinedOutputPacket
  selectedPSDInvoiceStreamDefinedByRoute1OutputBeforeSpend_proof :=
    ⟨hSource.sameSelectedPrefixMapFixedBeforePayoff_proof,
      hSource.noTargetDefinedOutputPacket_proof⟩
  selectedPSDOwnerWindowDefinedByRouteAuditPrefixBeforeSpend :=
    hAlign.routeAuditPrefixSelectedBeforeProjectionTailPayment ∧
      hAlign.ownerPrefixNotDefinedFromFiniteNoOverlapAssignment
  selectedPSDOwnerWindowDefinedByRouteAuditPrefixBeforeSpend_proof :=
    ⟨hAlign.routeAuditPrefixSelectedBeforeProjectionTailPayment_proof,
      hAlign.ownerPrefixNotDefinedFromFiniteNoOverlapAssignment_proof⟩
  notPostselectedFromPSDInvoiceValues :=
    hSource.noTargetDefinedOutputPacket ∧
      hAlign.ownerPrefixNotDefinedFromFiniteNoOverlapAssignment
  notPostselectedFromPSDInvoiceValues_proof :=
    ⟨hSource.noTargetDefinedOutputPacket_proof,
      hAlign.ownerPrefixNotDefinedFromFiniteNoOverlapAssignment_proof⟩

