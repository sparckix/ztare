/--
Field-level blockers for the finite no-overlap assignment binding.  These rule
out spending a collar/tail or owner-root assignment as C7 progress unless the
assignment is identified with the C7 projection-tail window and residual-fresh
carrier.
-/
structure C7FiniteNoOverlapAssignmentBindingIdentityConfuser
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (hAssign : FiniteProjectedWindowNoOverlapAssignmentSource) where
  windowMismatchAgainstEveryBinding :
    ∀ hBind :
      C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign,
      ¬ hBind.assignmentWindowIsC7ProjectionTailWindow
  carrierMismatchAgainstEveryBinding :
    ∀ hBind :
      C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign,
      ¬ hBind.assignmentUsesSameResidualFreshCarrier
  ownerWindowMismatchAgainstEveryBinding :
    ∀ hBind :
      C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign,
      ¬ hBind.ownerRootWindowMatchesC7SameCarrierWindow
  collarTailAnalogyOnlyAgainstEveryBinding :
    ∀ hBind :
      C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign,
      ¬ hBind.notCollarTailAnalogyOnly

/--
Confuser for a tautological window equality: the proposed C7 projection-tail
window is chosen from the finite assignment instead of being selected by the
C7 carrier geometry.
-/
structure C7ProjectionTailWindowPostselectedFromAssignmentConfuser
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (hAssign : FiniteProjectedWindowNoOverlapAssignmentSource) where
  noCarrierGeometryWindowForAnyIsomorphism :
    ∀ hIso :
      C7FiniteNoOverlapAssignmentExactSourceIsomorphism hPack hAssign,
      ¬ hIso.c7ProjectionTailWindowSelectedFromCarrierGeometry
  finiteAssignmentWindowUsedAsDefinition : Prop
  finiteAssignmentWindowUsedAsDefinition_proof :
    finiteAssignmentWindowUsedAsDefinition
  equalityIsPostselectedNotGeometric : Prop
  equalityIsPostselectedNotGeometric_proof :
    equalityIsPostselectedNotGeometric

/--
Carrier-side selector missing packet.  This blocks the finite no-overlap bridge
before any finite assignment equality is inspected.
-/
structure C7CarrierGeometryProjectionTailWindowSourceMissingConfuser
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId) where
  rejectsEveryCarrierGeometryWindowSource :
    ∀ _ :
      C7CarrierGeometryProjectionTailWindowSource hPack,
      False
  carrierRouteAuditPrefixDoesNotSelectWindow : Prop
  carrierRouteAuditPrefixDoesNotSelectWindow_proof :
    carrierRouteAuditPrefixDoesNotSelectWindow
  finitePrefixPackingDoesNotNameProjectedWindow : Prop
  finitePrefixPackingDoesNotNameProjectedWindow_proof :
    finitePrefixPackingDoesNotNameProjectedWindow

/--
An exact finite-assignment/C7 source isomorphism must expose a C7-owned
projection-tail window source, independent of the finite assignment.
-/
theorem no_C7FiniteNoOverlapAssignmentExactSourceIsomorphism_without_carrierGeometryWindowSource
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hConfuser :
      C7CarrierGeometryProjectionTailWindowSourceMissingConfuser hPack) :
    ¬ Nonempty
      (C7FiniteNoOverlapAssignmentExactSourceIsomorphism hPack hAssign) := by
  intro hNonempty
  rcases hNonempty with ⟨hIso⟩
  exact hConfuser.rejectsEveryCarrierGeometryWindowSource
    (C7CarrierGeometryProjectionTailWindowSource.ofExactSourceIsomorphism hIso)

/--
The owner-preimage prefix route still must match the finite projected window.
If the C7 source window is the active owner-atom bound at prefix `N`, then a
mismatched finite assignment window cannot instantiate the exact isomorphism.
-/
theorem no_C7FiniteNoOverlapAssignmentExactSourceIsomorphism_of_ownerPreimagePrefixWindowMismatch
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hOwner : C7PackingOwnerPreimageReceipt hPack)
    (N : Nat)
    (hMismatch :
      hAssign.finiteProjectedWindow ≠ hOwner.activeOwnerAtomBound N) :
    ¬ ∃ hIso :
        C7FiniteNoOverlapAssignmentExactSourceIsomorphism hPack hAssign,
        hIso.carrierGeometryWindowSource.c7ProjectionTailWindow =
          hOwner.activeOwnerAtomBound N := by
  intro hExists
  rcases hExists with ⟨hIso, hSourceWindow⟩
  apply hMismatch
  calc
    hAssign.finiteProjectedWindow = hIso.c7ProjectionTailWindow :=
      hIso.finiteProjectedWindow_eq_c7ProjectionTailWindow
    _ = hIso.carrierGeometryWindowSource.c7ProjectionTailWindow :=
      hIso.c7ProjectionTailWindow_eq_source
    _ = hOwner.activeOwnerAtomBound N :=
      hSourceWindow

/--
If the C7 window is not selected from carrier geometry, the exact source
isomorphism is unavailable even if the finite-window equality is visible.
-/
theorem no_C7FiniteNoOverlapAssignmentExactSourceIsomorphism_of_windowPostselected
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hConfuser :
      C7ProjectionTailWindowPostselectedFromAssignmentConfuser hPack hAssign) :
    ¬ Nonempty
      (C7FiniteNoOverlapAssignmentExactSourceIsomorphism hPack hAssign) := by
  intro hNonempty
  rcases hNonempty with ⟨hIso⟩
  exact hConfuser.noCarrierGeometryWindowForAnyIsomorphism hIso
    hIso.c7ProjectionTailWindowSelectedFromCarrierGeometry_proof

/-- A finite assignment whose projected window is not the C7 window cannot bind. -/
theorem no_C7ProjectionTailPersistenceBinding_of_assignmentWindowMismatch
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hConfuser :
      C7FiniteNoOverlapAssignmentBindingIdentityConfuser hPack hAssign) :
    ¬ Nonempty
      (C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign) := by
  intro hNonempty
  rcases hNonempty with ⟨hBind⟩
  exact hConfuser.windowMismatchAgainstEveryBinding hBind
    hBind.assignmentWindowIsC7ProjectionTailWindow_proof

/-- A finite assignment on a generic same carrier cannot bind to the C7 source. -/
theorem no_C7ProjectionTailPersistenceBinding_of_residualFreshCarrierMismatch
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hConfuser :
      C7FiniteNoOverlapAssignmentBindingIdentityConfuser hPack hAssign) :
    ¬ Nonempty
      (C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign) := by
  intro hNonempty
  rcases hNonempty with ⟨hBind⟩
  exact hConfuser.carrierMismatchAgainstEveryBinding hBind
    hBind.assignmentUsesSameResidualFreshCarrier_proof

/-- A finite assignment on a different owner-root window cannot bind to C7. -/
theorem no_C7ProjectionTailPersistenceBinding_of_ownerRootWindowMismatch
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hConfuser :
      C7FiniteNoOverlapAssignmentBindingIdentityConfuser hPack hAssign) :
    ¬ Nonempty
      (C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign) := by
  intro hNonempty
  rcases hNonempty with ⟨hBind⟩
  exact hConfuser.ownerWindowMismatchAgainstEveryBinding hBind
    hBind.ownerRootWindowMatchesC7SameCarrierWindow_proof

/-- A collar/tail analogy without source identity cannot bind to C7. -/
theorem no_C7ProjectionTailPersistenceBinding_of_collarTailAnalogyOnly
    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hConfuser :
      C7FiniteNoOverlapAssignmentBindingIdentityConfuser hPack hAssign) :
    ¬ Nonempty
      (C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
        hPack hAssign) := by
  intro hNonempty
  rcases hNonempty with ⟨hBind⟩
  exact hConfuser.collarTailAnalogyOnlyAgainstEveryBinding hBind
    hBind.notCollarTailAnalogyOnly_proof

