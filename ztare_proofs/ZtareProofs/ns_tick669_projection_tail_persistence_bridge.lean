      hInvoice hComplete where
  displayedInvoiceNodeRadiusMatchesProjectedCarrier := by
    calc
      (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
        hInvoice).nodeRadius = hDrop.nodeRadius := by
          simpa [C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice]
            using hInvoice.invoiceUsesDisplayedNodeRadius
      _ = hElig.residualOrInherited.nodeRadius :=
          hNode.dropNodeRadiusIsResidualOrInherited
      _ =
          (C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding
            hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding).nodeRadius := by
          rfl

