    ReplayInvariantFiveShadowValuationBudgetReceipt formula where
  source := source
  budget := budget
  replayInvariantShadowTVPay := replayInvariantShadowTVPay
  replayInvariantShadowTVPay_eq_sourceValuationPay := hReplayEqSource
  sourceValuationPay_eq_budgetAngularEventPay := hSourceEqBudget
  replayInvariantShadowTVPrefix_le_ownerBudget_all := hPrefixBound
  shadowTVFixedBeforeFinalScalarCancellation :=
    shadowTVFixedBeforeFinalScalarCancellation
  shadowTVFixedBeforeFinalScalarCancellation_proof := hShadowTVFixed
  ownerBudgetIndependentOfReplayTargetSpend :=
    ownerBudgetIndependentOfReplayTargetSpend
  ownerBudgetIndependentOfReplayTargetSpend_proof := hOwnerBudgetIndependent
  diagonalDiniReplayOverflowExcludedByMechanism :=
    ∀ hBinding : FiveShadowDiagonalDiniDynamicTransversalityBinding, False
  diagonalDiniReplayOverflowExcludedByMechanism_proof := by
    intro hBinding
    exact
      no_FiveShadowDiagonalDiniValuationOverflowConfuser_of_dynamicTransversalityBinding
        hBinding
  notFinalScalarVisibilityOrBetaSquareBudget :=
    notFinalScalarVisibilityOrBetaSquareBudget
  notFinalScalarVisibilityOrBetaSquareBudget_proof := hNotScalarOrSquare

