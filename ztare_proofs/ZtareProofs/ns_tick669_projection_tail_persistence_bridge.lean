/--
Binding receipt from the older finite projected-window no-overlap assignment
source to the current C7 projection-tail limit-passage fields.

The older source may control collar/tail overlap, but it is only admissible for
TICK669 after its owner-root projected window is identified with the same C7
same-carrier packing window.
-/
structure C7ProjectionTailPersistenceBindingFromFiniteNoOverlapAssignment
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (hAssign : FiniteProjectedWindowNoOverlapAssignmentSource) where
  assignmentWindowIsC7ProjectionTailWindow : Prop
  assignmentWindowIsC7ProjectionTailWindow_proof :
    assignmentWindowIsC7ProjectionTailWindow
  assignmentUsesSameResidualFreshCarrier : Prop
  assignmentUsesSameResidualFreshCarrier_proof :
    assignmentUsesSameResidualFreshCarrier
  preprojectionIdentityPersistsToLimit :
    hPack.finitePrefixMatchingSaturatesRouteDemand
  tailReservePaymentPersistsToLimit :
    hAssign.limitPassageInheritanceLemmaNamed
  sameSourceWindowPersistsToLimit :
    hPack.matchedCapacityLivesOnSameResidualFreshCarrier
  noProjectionTailLossAtLimit :
    hAssign.noOverlapAssignmentPersistsToProjectedWindow
  ownerRootWindowMatchesC7SameCarrierWindow : Prop
  ownerRootWindowMatchesC7SameCarrierWindow_proof :
    ownerRootWindowMatchesC7SameCarrierWindow
  notCollarTailAnalogyOnly : Prop
  notCollarTailAnalogyOnly_proof :
    notCollarTailAnalogyOnly

/--
PDE receipt for projection-tail no-loss on the selected annular stream.

This is the physical route behind the finite-assignment no-loss field.  It
does not identify budgets by name: source-tail tightness, a uniform annular
Riesz/Leray envelope, and same-stream cutoff commutator payment must dominate
the projected tail loss before the finite-assignment no-overlap field can be
used.
-/
structure C7ProjectionTailAnnularTightnessNoLossReceipt
    (hAssign : FiniteProjectedWindowNoOverlapAssignmentSource) where
  selectedSourceTailTightOnResidualFreshCarrier : Prop
  selectedSourceTailTightOnResidualFreshCarrier_proof :
    selectedSourceTailTightOnResidualFreshCarrier
  uniformAnnularRieszL1EnvelopeOnSelectedBand : Prop
  uniformAnnularRieszL1EnvelopeOnSelectedBand_proof :
    uniformAnnularRieszL1EnvelopeOnSelectedBand
  cutoffCommutatorTailPaidOnSameStream : Prop
  cutoffCommutatorTailPaidOnSameStream_proof :
    cutoffCommutatorTailPaidOnSameStream
  lowHighProjectionLeakagePaidOrExcluded : Prop
  lowHighProjectionLeakagePaidOrExcluded_proof :
    lowHighProjectionLeakagePaidOrExcluded
  projectedTailLossDominatedBySourceTailAndCommutator : Prop
  projectedTailLossDominatedBySourceTailAndCommutator_proof :
    projectedTailLossDominatedBySourceTailAndCommutator
  sameStreamBindingNotProxyCarrier : Prop
  sameStreamBindingNotProxyCarrier_proof :
    sameStreamBindingNotProxyCarrier
  dominationForcesNoProjectionTailLoss :
    selectedSourceTailTightOnResidualFreshCarrier ∧
      uniformAnnularRieszL1EnvelopeOnSelectedBand ∧
      cutoffCommutatorTailPaidOnSameStream ∧
      lowHighProjectionLeakagePaidOrExcluded ∧
      projectedTailLossDominatedBySourceTailAndCommutator ∧
      sameStreamBindingNotProxyCarrier →
        hAssign.noOverlapAssignmentPersistsToProjectedWindow

/-- Project the physical annular tightness receipt to the finite-assignment
no-loss field consumed by the projection-tail limit passage. -/
theorem C7ProjectionTailAnnularTightnessNoLossReceipt.noProjectionTailLossAtLimit
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (h : C7ProjectionTailAnnularTightnessNoLossReceipt hAssign) :
    hAssign.noOverlapAssignmentPersistsToProjectedWindow :=
  h.dominationForcesNoProjectionTailLoss
    ⟨h.selectedSourceTailTightOnResidualFreshCarrier_proof,
      h.uniformAnnularRieszL1EnvelopeOnSelectedBand_proof,
      h.cutoffCommutatorTailPaidOnSameStream_proof,
      h.lowHighProjectionLeakagePaidOrExcluded_proof,
      h.projectedTailLossDominatedBySourceTailAndCommutator_proof,
      h.sameStreamBindingNotProxyCarrier_proof⟩

/-- Persistent projected tail leakage blocks the physical no-loss receipt. -/
theorem no_C7ProjectionTailAnnularTightnessNoLossReceipt_of_persistentProjectedTailLeak
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hLeak : ¬ hAssign.noOverlapAssignmentPersistsToProjectedWindow) :
    ¬ Nonempty (C7ProjectionTailAnnularTightnessNoLossReceipt hAssign) := by
  intro hNonempty
  rcases hNonempty with ⟨hReceipt⟩
  exact hLeak hReceipt.noProjectionTailLossAtLimit

