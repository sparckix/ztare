    have hCharge :
        hSplit.splitWitness.telescoping.radiusChargingMeasure.chargesRadiusNotClassicalRadiusSquared :=
      hCompat.radiusMeasureNonclassicalChargeProof
    rw [← hProducedMeasure] at hCharge
    exact hCharge
  invoiceProducedRadiusMeasureNonclassicalChargeMatchesDropCharge := by
    have hProducedMeasure :
