      hWindow.notDefinedFromFiniteNoOverlapAssignment_proof
  }
  c7ProjectionTailWindow :=
    hWindow.c7ProjectionTailWindow
  c7ProjectionTailWindow_eq_source := rfl
  c7ProjectionTailWindowSelectedFromCarrierGeometry :=
    hWindow.selectedBySameCarrierRouteAuditPrefix ∧
      hWindow.indexesResidualFreshCarrierWindow
  c7ProjectionTailWindowSelectedFromCarrierGeometry_proof :=
    ⟨hWindow.selectedBySameCarrierRouteAuditPrefix_proof,
      hWindow.indexesResidualFreshCarrierWindow_proof⟩
  c7ProjectionTailWindowNotChosenFromFiniteAssignment :=
    hWindow.notDefinedFromFiniteNoOverlapAssignment
  c7ProjectionTailWindowNotChosenFromFiniteAssignment_proof :=
    hWindow.notDefinedFromFiniteNoOverlapAssignment_proof
  finiteProjectedWindow_eq_c7ProjectionTailWindow :=
    finiteProjectedWindow_eq_c7ProjectionTailWindow
  tailAssignmentUsesResidualFreshCarrier :=
    tailAssignmentUsesResidualFreshCarrier
  ownerRootRefinesC7SameCarrierWindow :=
    ownerRootRefinesC7SameCarrierWindow
  assignmentFixedBeforeProjectionOnThisWindow :=
    assignmentFixedBeforeProjectionOnThisWindow
  notScalarOrCollarTailOnly :=
    notScalarOrCollarTailOnly

/--
