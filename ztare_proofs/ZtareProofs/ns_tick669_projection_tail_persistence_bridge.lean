/--
For the canonical side-field receipt produced from a fixed split side-proof,
the side-field compatibility receipt is paid exactly by the selected
radius-measure/drop nonclassical compatibility.
-/
def C7SideFieldRadiusMeasureNonclassicalChargeCompatibilityReceipt.ofCanonicalSideProofReceiptAndRadiusMeasureCompatibility
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig)}
    (hSideProof :
      C7ProofCarryingSplitWitnessSideProofReceipt hSplit)
    (hCompat :
      C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt
        hSplit) :
    C7SideFieldRadiusMeasureNonclassicalChargeCompatibilityReceipt
      hSplit
      (C7ResidualRadiusChargingSideFieldReceipt.ofProofCarryingSplitWitnessSideProofReceipt
        hSideProof) where
  sideRadiusMeasureIsSelectedTelescopingMeasure := by
    rfl
  sideChargePropIsRadiusMeasureCharge := by
    simpa [
      C7ResidualRadiusChargingSideFieldReceipt.ofProofCarryingSplitWitnessSideProofReceipt,
      C7ResidualRadiusChargingSideFieldReceipt.ofProofCarryingSplitWitnessAndSideProofs]
      using hCompat.radiusMeasureNonclassicalChargeMatchesDropCharge.symm
  sideChargePropIsSelectedDropCharge := by
    rfl

/--
For the canonical side-field receipt, side-field compatibility is equivalent
to the already-isolated radius-measure/drop nonclassical compatibility.
-/
theorem C7SideFieldRadiusMeasureNonclassicalChargeCompatibilityReceipt.nonempty_canonicalSideProof_iff_radiusMeasureCompatibility
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig)}
    (hSideProof :
      C7ProofCarryingSplitWitnessSideProofReceipt hSplit) :
    Nonempty
      (C7SideFieldRadiusMeasureNonclassicalChargeCompatibilityReceipt
        hSplit
        (C7ResidualRadiusChargingSideFieldReceipt.ofProofCarryingSplitWitnessSideProofReceipt
          hSideProof)) ↔
    Nonempty
      (C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt
        hSplit) := by
  constructor
  · intro hSideCompat
    exact ⟨
      C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt.ofSideFieldRadiusMeasureCompatibility
        hSideCompat.some⟩
  · intro hCompat
    exact ⟨
      C7SideFieldRadiusMeasureNonclassicalChargeCompatibilityReceipt.ofCanonicalSideProofReceiptAndRadiusMeasureCompatibility
        hSideProof hCompat.some⟩

/--
Displayed-invoice source for the radius-measure nonclassical-charge field.

The invoice already identifies its produced radius-charging measure with the
telescoping measure.  This receipt supplies the extra nonclassical-charge proof
and the selected drop-field identity for that produced measure.
-/
structure C7DisplayedInvoiceRadiusMeasureNonclassicalChargeReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    (hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig))
    (hInvoice :
      ExcessDropTelescopingCarriesSameTreeFreshInvoice
        seq K hRho
        hSplit.splitWitness.potentialCandidate
        hSplit.splitWitness.treeSuperadditivity
        hSplit.splitWitness.badNodeRadiusDrop
