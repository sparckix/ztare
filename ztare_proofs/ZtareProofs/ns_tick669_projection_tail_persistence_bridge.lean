    {hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    {hAssign : FiniteProjectedWindowNoOverlapAssignmentSource}
    (hSource :
      C7CarrierGeometryProjectionTailWindowSource hPack)
    (finiteProjectedWindow_eq_c7ProjectionTailWindow :
      hAssign.finiteProjectedWindow = hSource.c7ProjectionTailWindow)
    (tailAssignmentUsesResidualFreshCarrier :
      hAssign.tailReserveAssignmentSameCarrier ∧
