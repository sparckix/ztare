        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {hPot : ExcessDropPotentialCandidate seq K hRho}
    {hTree : ExcessDropTreeSuperadditivity seq K hRho hPot}
    {hDrop : BadNodeRadiusDrop seq K hRho hPot hTree}
    {hTel :
      ExcessDropTelescopesToRadiusCharging
        seq K hRho hPot hTree hDrop}
    {hInvoice :
      ExcessDropTelescopingCarriesSameTreeFreshInvoice
        seq K hRho hPot hTree hDrop hTel}
    {hComplete : CoronaDuhamelC7SourceCompletion h hId}
    (hFields :
      C7DisplayedInvoiceTelescopingFieldIdentityReceipt
        hInvoice hComplete) :
    C7DisplayedInvoiceFieldwiseIdentityReceipt hInvoice hComplete where
  badNodes_eq := by
    calc
      (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
        hInvoice).badNodes = hDrop.badNodes := by
          simpa [C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice]
            using hInvoice.invoiceUsesDisplayedBadNodes
      _ = hCarrier.selectedBadNodes :=
          hFields.dropBadNodesAreSelectedBadNodes
      _ = (C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding
            hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding).badNodes := by
          rfl
  nodeRadius_eq := by
    calc
      (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
        hInvoice).nodeRadius = hDrop.nodeRadius := by
          simpa [C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice]
            using hInvoice.invoiceUsesDisplayedNodeRadius
      _ = hElig.residualOrInherited.nodeRadius :=
          hFields.dropNodeRadiusIsResidualOrInherited
      _ = (C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding
            hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding).nodeRadius := by
          rfl
  invoiceRegion_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.invoiceRegion_eq
  invoiceAssignedBeforeSubtreeSelection_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.invoiceAssignedBeforeSubtreeSelection_eq
  invoicePaysRadiusForEachSelectedBadNode_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.invoicePaysRadiusForEachSelectedBadNode_eq
  invoiceUsesSameNormalizedExcessStoppingTree_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.invoiceUsesSameNormalizedExcessStoppingTree_eq
  oneUseNoDescendantRebilling_eq := by
    calc
      (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
        hInvoice).oneUseNoDescendantRebilling =
          hDrop.noReuseOfSameDropAlongNestedBadNodes := by
            simpa [C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice]
              using hInvoice.oneUseAccountingIsTheNoReuseField
      _ = hLock.noRepeatedDescendantCharging :=
          hFields.dropNoReuseMatchesSameTreeLock
      _ = (C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding
            hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding).oneUseNoDescendantRebilling := by
          rfl
  descendantInvoicesDisjointOrBoundedOverlap_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.descendantInvoicesDisjointOrBoundedOverlap_eq
  finiteFreshInvoiceBudget_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.finiteFreshInvoiceBudget_eq
  doesNotFactorThroughCFDirectionAlignment_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.doesNotFactorThroughCFDirectionAlignment_eq
  notDegreeZeroRieszBookkeeping_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.notDegreeZeroRieszBookkeeping_eq
  notParabolicRateSlavedScalar_eq := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hFields.notParabolicRateSlavedScalar_eq
  producesRadiusCharging_eq := by
    calc
      (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
        hInvoice).producesRadiusCharging =
          hTel.radiusChargingMeasure := by
            simpa [C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice]
              using hInvoice.invoiceProducesTelescopingRadiusCharge
      _ = hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.producesRadiusCharging :=
          hFields.telescopingRadiusChargeMatchesProjectedCarrier
      _ = (C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding
            hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding).producesRadiusCharging := by
          rfl

/--
Source/timing Prop-field identity for the displayed invoice comparison.
