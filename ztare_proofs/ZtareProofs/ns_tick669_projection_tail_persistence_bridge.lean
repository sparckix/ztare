/--
Same-owner-fiber source receipt for the five-shadow/Carleson stream equality.

This is the physical equality needed by the replay-budget route: the
five-shadow trace-free valuation stream and the Carleson angular event stream
must be generated by the same annular owner-fiber payment before the final
radius-sum payoff is observed.
-/
structure FiveFrameCarlesonSameOwnerFiberStreamReceipt
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula :
      Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hSource : FiveFrameTracefreeValuationSource formula)
    (hCarleson :
      TraceFreeVariationSameCarrierFreshNoReuseCarlesonReceipt) where
  sameAnnularOwnerFiberPay : Nat → Real
  sourceTracefreeValuationPay_eq_ownerFiberPay :
    hSource.tracefreeValuationPay = sameAnnularOwnerFiberPay
  carlesonAngularEventPay_eq_ownerFiberPay :
    hCarleson.budget.angularEventPay = sameAnnularOwnerFiberPay
  ownerFiberSelectedBeforeFinalPayoff : Prop
  ownerFiberSelectedBeforeFinalPayoff_proof :
    ownerFiberSelectedBeforeFinalPayoff
  ownerFiberIsSameCarrierFreshNoReuseGeneration : Prop
  ownerFiberIsSameCarrierFreshNoReuseGeneration_proof :
    ownerFiberIsSameCarrierFreshNoReuseGeneration
  notProxyFiberOrScalarVisibility : Prop
  notProxyFiberOrScalarVisibility_proof :
    notProxyFiberOrScalarVisibility

/-- The same-owner-fiber receipt pays the exact Nat-indexed stream equality. -/
def FiveFrameCarlesonSameOwnerFiberStreamReceipt.sameStream
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula :
      Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    {hSource : FiveFrameTracefreeValuationSource formula}
    {hCarleson :
      TraceFreeVariationSameCarrierFreshNoReuseCarlesonReceipt}
    (hFiber :
      FiveFrameCarlesonSameOwnerFiberStreamReceipt hSource hCarleson) :
    hSource.tracefreeValuationPay = hCarleson.budget.angularEventPay := by
  calc
    hSource.tracefreeValuationPay = hFiber.sameAnnularOwnerFiberPay :=
      hFiber.sourceTracefreeValuationPay_eq_ownerFiberPay
    _ = hCarleson.budget.angularEventPay := by
      simpa using hFiber.carlesonAngularEventPay_eq_ownerFiberPay.symm

/--
Same-owner-fiber receipt from the event-radius/target-charge identity.

This is the sharper physical source theorem behind the stream equality: the
five-frame event-radius payment stream must be the Carleson budget's target
charge stream.  The existing pointwise fields then identify those streams with
the five-shadow valuation stream and the Carleson angular event stream.
-/
def FiveFrameCarlesonSameOwnerFiberStreamReceipt.ofEventRadiusTargetChargeIdentity
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula :
      Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hSource : FiveFrameTracefreeValuationSource formula)
    (hCarleson :
      TraceFreeVariationSameCarrierFreshNoReuseCarlesonReceipt)
    (hTargetCharge :
      hSource.eventRadiusPayment = hCarleson.budget.targetCharge)
    (ownerFiberIsSameCarrierFreshNoReuseGeneration : Prop)
    (hOwnerFiberGeneration :
      ownerFiberIsSameCarrierFreshNoReuseGeneration)
    (notProxyFiberOrScalarVisibility : Prop)
    (hNotProxy :
      notProxyFiberOrScalarVisibility) :
    FiveFrameCarlesonSameOwnerFiberStreamReceipt hSource hCarleson where
  sameAnnularOwnerFiberPay := hSource.eventRadiusPayment
  sourceTracefreeValuationPay_eq_ownerFiberPay := by
    funext n
    exact (hSource.eventRadiusPayment_eq_tracefreeValuationPay n).symm
  carlesonAngularEventPay_eq_ownerFiberPay := by
    funext n
    calc
      hCarleson.budget.angularEventPay n =
          hCarleson.budget.targetCharge n := by
        exact (hCarleson.budget.targetCharge_eq_angularEventPay n).symm
      _ = hSource.eventRadiusPayment n := by
        exact congrFun hTargetCharge.symm n
  ownerFiberSelectedBeforeFinalPayoff :=
    hSource.angularFrameFixedBeforePayoff ∧
      hCarleson.budget.ownerIsTraceFreeVariationDisintegrationSection
  ownerFiberSelectedBeforeFinalPayoff_proof :=
    ⟨hSource.angularFrameFixedBeforePayoff_proof,
      hCarleson.budget.ownerIsTraceFreeVariationDisintegrationSection_proof⟩
  ownerFiberIsSameCarrierFreshNoReuseGeneration :=
    ownerFiberIsSameCarrierFreshNoReuseGeneration
  ownerFiberIsSameCarrierFreshNoReuseGeneration_proof :=
    hOwnerFiberGeneration
  notProxyFiberOrScalarVisibility :=
    notProxyFiberOrScalarVisibility
  notProxyFiberOrScalarVisibility_proof :=
    hNotProxy

/--
The valuation-specific cofinal owner budget already pays the sharper
event-radius/target-charge identity.

Its field `valuationPay_eq_budgetAngularEventPay` identifies the five-shadow
valuation stream with the Carleson angular-event stream.  The source and
budget pointwise fields then move this identity back to the pre-conversion
streams `eventRadiusPayment` and `targetCharge`.
-/
def TraceFreeL2ValuationC7CofinalOwnerBudget.eventRadiusPayment_eq_targetCharge
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula :
      Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hVal : TraceFreeL2ValuationC7CofinalOwnerBudget formula) :
    hVal.source.eventRadiusPayment = hVal.budget.targetCharge := by
  funext n
  calc
    hVal.source.eventRadiusPayment n =
        hVal.source.tracefreeValuationPay n := by
      exact hVal.source.eventRadiusPayment_eq_tracefreeValuationPay n
    _ = hVal.budget.angularEventPay n := by
      exact congrFun hVal.valuationPay_eq_budgetAngularEventPay n
    _ = hVal.budget.targetCharge n := by
      exact (hVal.budget.targetCharge_eq_angularEventPay n).symm

/--
Common owner-fiber receipt from a valuation-specific cofinal owner budget whose
budget is the same one carried by the Carleson receipt.

This is the productive PDE reduction: target-charge equality is not a separate
axiom once the route has constructed a valuation-specific owner budget on the
active Carleson budget.
-/
def FiveFrameCarlesonSameOwnerFiberStreamReceipt.ofValuationCofinalOwnerBudget
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula :
      Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    (hVal : TraceFreeL2ValuationC7CofinalOwnerBudget formula)
    (hCarleson :
      TraceFreeVariationSameCarrierFreshNoReuseCarlesonReceipt)
    (hBudget :
      hVal.budget = hCarleson.budget)
    (ownerFiberIsSameCarrierFreshNoReuseGeneration : Prop)
    (hOwnerFiberGeneration :
      ownerFiberIsSameCarrierFreshNoReuseGeneration)
    (notProxyFiberOrScalarVisibility : Prop)
    (hNotProxy :
      notProxyFiberOrScalarVisibility) :
    FiveFrameCarlesonSameOwnerFiberStreamReceipt hVal.source hCarleson :=
  FiveFrameCarlesonSameOwnerFiberStreamReceipt.ofEventRadiusTargetChargeIdentity
    hVal.source
    hCarleson
    (by
      calc
        hVal.source.eventRadiusPayment = hVal.budget.targetCharge :=
          hVal.eventRadiusPayment_eq_targetCharge
        _ = hCarleson.budget.targetCharge := by
          rw [hBudget])
    ownerFiberIsSameCarrierFreshNoReuseGeneration
    hOwnerFiberGeneration
    notProxyFiberOrScalarVisibility
    hNotProxy

/--
Same-owner-fiber receipt from the separated-source C7 owner-geometry bridge.

This is the route-facing consumer for TICK669.  It does not accept an arbitrary
valuation-budget record: the valuation budget is the constructor-produced one
from the separated-source owner-geometry bridge, and the remaining equality is
only the active-budget identity against the Carleson receipt.
