      hCompat.radiusMeasureNonclassicalChargeMatchesDropCharge

/--
The displayed-invoice nonclassical-charge receipt is equivalent to the selected
split radius-measure/drop compatibility receipt once the invoice-produced
measure is known to be the telescoping radius measure.
-/
theorem C7DisplayedInvoiceRadiusMeasureNonclassicalChargeReceipt.nonempty_iff_radiusMeasureCompatibility
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig)}
    {hInvoice :
      ExcessDropTelescopingCarriesSameTreeFreshInvoice
        seq K hRho
        hSplit.splitWitness.potentialCandidate
        hSplit.splitWitness.treeSuperadditivity
        hSplit.splitWitness.badNodeRadiusDrop
        hSplit.splitWitness.telescoping} :
    Nonempty
      (C7DisplayedInvoiceRadiusMeasureNonclassicalChargeReceipt
        hSplit hInvoice) ↔
    Nonempty
      (C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt
        hSplit) := by
  constructor
  · intro hReceipt
    exact ⟨
      C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt.ofDisplayedInvoiceRadiusMeasureNonclassicalCharge
        hReceipt.some⟩
  · intro hCompat
    exact ⟨
      C7DisplayedInvoiceRadiusMeasureNonclassicalChargeReceipt.ofRadiusMeasureCompatibility
        (hInvoice := hInvoice) hCompat.some⟩

