/--
Transport the projected-carrier nonclassical-charge proof to the selected
split radius measure through the telescoping field identity.
-/
def C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt.ofProjectedCarrierChargeAndTelescopingFieldIdentity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {hComplete : CoronaDuhamelC7SourceCompletion h hId}
    {hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig)}
    {hInvoice :
      ExcessDropTelescopingCarriesSameTreeFreshInvoice
        seq K hRho
        hSplit.splitWitness.potentialCandidate
        hSplit.splitWitness.treeSuperadditivity
        hSplit.splitWitness.badNodeRadiusDrop
        hSplit.splitWitness.telescoping}
    (hProjected :
      C7ProjectedCarrierRadiusMeasureNonclassicalChargeReceipt hComplete)
    (hFields :
      C7DisplayedInvoiceTelescopingFieldIdentityReceipt
        hInvoice hComplete)
    (radiusMeasureNonclassicalChargeMatchesDropCharge :
      hSplit.splitWitness.telescoping.radiusChargingMeasure.chargesRadiusNotClassicalRadiusSquared =
        hSplit.splitWitness.badNodeRadiusDrop.chargesRadiusNotClassicalRadiusSquared) :
    C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt
      hSplit where
  radiusMeasureNonclassicalChargeProof := by
    have hCharge :
        hComplete.scheduleCompletion.projectedCarrier.sameTreeInvoiceEmbedding.producesRadiusCharging.chargesRadiusNotClassicalRadiusSquared :=
      hProjected.projectedCarrierRadiusMeasureNonclassicalChargeProof
    rw [← hFields.telescopingRadiusChargeMatchesProjectedCarrier] at hCharge
    exact hCharge
  radiusMeasureNonclassicalChargeMatchesDropCharge :=
    radiusMeasureNonclassicalChargeMatchesDropCharge

