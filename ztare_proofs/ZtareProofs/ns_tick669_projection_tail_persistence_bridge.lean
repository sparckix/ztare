  invoiceProducedRadiusMeasureNonclassicalChargeProof :
    (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
      hInvoice).producesRadiusCharging.chargesRadiusNotClassicalRadiusSquared
  invoiceProducedRadiusMeasureNonclassicalChargeMatchesDropCharge :
    (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
      hInvoice).producesRadiusCharging.chargesRadiusNotClassicalRadiusSquared =
      hSplit.splitWitness.badNodeRadiusDrop.chargesRadiusNotClassicalRadiusSquared

/--
The displayed invoice nonclassical-charge receipt pays the selected split
nonclassical-charge compatibility after using the invoice-produced-measure
identity.
-/
def C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt.ofDisplayedInvoiceRadiusMeasureNonclassicalCharge
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hSplit :
      C7ProofCarryingResidualRadiusSplitWitness (hElig := hElig)}
    {hInvoice :
      ExcessDropTelescopingCarriesSameTreeFreshInvoice
        seq K hRho
        hSplit.splitWitness.potentialCandidate
        hSplit.splitWitness.treeSuperadditivity
        hSplit.splitWitness.badNodeRadiusDrop
        hSplit.splitWitness.telescoping}
    (hReceipt :
      C7DisplayedInvoiceRadiusMeasureNonclassicalChargeReceipt
        hSplit hInvoice) :
    C7ProofCarryingSplitWitnessNonclassicalChargeCompatibilityReceipt
      hSplit where
  radiusMeasureNonclassicalChargeProof := by
    have hProducedMeasure :
        (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
          hInvoice).producesRadiusCharging =
          hSplit.splitWitness.telescoping.radiusChargingMeasure := by
      simpa [C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice]
        using hInvoice.invoiceProducesTelescopingRadiusCharge
    have hCharge :
        (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
          hInvoice).producesRadiusCharging.chargesRadiusNotClassicalRadiusSquared :=
      hReceipt.invoiceProducedRadiusMeasureNonclassicalChargeProof
    rw [hProducedMeasure] at hCharge
    exact hCharge
  radiusMeasureNonclassicalChargeMatchesDropCharge := by
    have hProducedMeasure :
        (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
          hInvoice).producesRadiusCharging =
          hSplit.splitWitness.telescoping.radiusChargingMeasure := by
      simpa [C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice]
        using hInvoice.invoiceProducesTelescopingRadiusCharge
    have hField :
        (C7SameTreeFreshRadiusInvoice.ofExcessDropTelescopingInvoice
          hInvoice).producesRadiusCharging.chargesRadiusNotClassicalRadiusSquared =
          hSplit.splitWitness.telescoping.radiusChargingMeasure.chargesRadiusNotClassicalRadiusSquared :=
      congrArg
        (fun hMeasure : RadiusChargingBadScaleMeasure seq K hRho =>
          hMeasure.chargesRadiusNotClassicalRadiusSquared)
        hProducedMeasure
    exact hField.symm.trans
      hReceipt.invoiceProducedRadiusMeasureNonclassicalChargeMatchesDropCharge

