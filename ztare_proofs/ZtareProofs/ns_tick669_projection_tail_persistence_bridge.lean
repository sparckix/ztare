      (hPot := hPot) (hTree := hTree) (hDrop := hDrop) (hTel := hTel)
      (CoronaDuhamelC7SourceCompletion.ofProjectedCarrierProofsAndTiming
        (h :=
          CoronaDuhamelProductionSingleSpendCarrier.ofSelectedSameTreeInvoiceEmbeddingData
            hData)
        (hId := hId)
        (by
          simpa [CoronaDuhamelProductionSingleSpendCarrier.ofSelectedSameTreeInvoiceEmbeddingData]
            using hEmbedding.eventDataMatchedToResidualFreshAuditIndex_proof)
        (by
          simpa [CoronaDuhamelProductionSingleSpendCarrier.ofSelectedSameTreeInvoiceEmbeddingData]
            using hEmbedding.residualBranchLedgerEventsPayNodeRadii_proof)
        (by
          simpa [CoronaDuhamelProductionSingleSpendCarrier.ofSelectedSameTreeInvoiceEmbeddingData]
            using hEmbedding.invoiceAssignedBeforeSubtreeSelection_proof)
        (by
          simpa [CoronaDuhamelProductionSingleSpendCarrier.ofSelectedSameTreeInvoiceEmbeddingData]
            using hEmbedding.invoiceUsesSameNormalizedExcessStoppingTree_proof)
        (by
          simpa [CoronaDuhamelProductionSingleSpendCarrier.ofSelectedSameTreeInvoiceEmbeddingData]
            using hEmbedding.descendantInvoicesDisjointOrBoundedOverlap_proof)
        (by
          simpa [CoronaDuhamelProductionSingleSpendCarrier.ofSelectedSameTreeInvoiceEmbeddingData]
            using hEmbedding.finiteFreshInvoiceBudget_proof)
