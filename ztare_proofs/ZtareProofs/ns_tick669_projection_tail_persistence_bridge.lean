/--
Primitive-field constructor for the residual-node-radius source together with
telescoping radius charging.

This names the positive theorem inputs left after excluding square-charge,
signed-flux, and local-decay substitutes.
-/
def C7ResidualNodeRadiusDropSourceWithRadiusCharging.ofResidualNodeRadiusTelescopingFields
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hPot : ExcessDropPotentialCandidate seq K hRho}
    {hTree : ExcessDropTreeSuperadditivity seq K hRho hPot}
    (badNodeConsumesResidualRadius : Prop)
    (chargesResidualRadiusNotClassicalRadiusSquared : Prop)
    (noReuseOfResidualRadiusDropAlongNestedBadNodes : Prop)
    (sourceUsesResidualInheritedDichotomy : Prop)
    (sourceUsesResidualInheritedDichotomy_proof :
      sourceUsesResidualInheritedDichotomy)
    (notPostSelectedFromDisplayedInvoice : Prop)
    (finiteBadSubtreeAccounting : Prop)
    (infiniteTreeLimitNoBoundaryLoss : Prop)
    (boundedOverlapForSelectedBadTents : Prop)
    (radiusChargingMeasure : RadiusChargingBadScaleMeasure seq K hRho)
    (chargingNotSignedFluxOnly : Prop)
    (chargingNotLocalDecayOnly : Prop) :
    C7ResidualNodeRadiusDropSourceWithRadiusCharging
      (hElig := hElig) (hPot := hPot) (hTree := hTree) :=
  let hSource :=
    C7ResidualNodeRadiusBadNodeRadiusDropSource.ofResidualNodeRadiusFields
      (hElig := hElig) (hPot := hPot) (hTree := hTree)
      badNodeConsumesResidualRadius
      chargesResidualRadiusNotClassicalRadiusSquared
      noReuseOfResidualRadiusDropAlongNestedBadNodes
      sourceUsesResidualInheritedDichotomy
      sourceUsesResidualInheritedDichotomy_proof
      notPostSelectedFromDisplayedInvoice
  C7ResidualNodeRadiusDropSourceWithRadiusCharging.ofSourceAndTelescoping
    (hElig := hElig) (hPot := hPot) (hTree := hTree)
    hSource
    ({
      finiteBadSubtreeAccounting := finiteBadSubtreeAccounting
      infiniteTreeLimitNoBoundaryLoss := infiniteTreeLimitNoBoundaryLoss
      boundedOverlapForSelectedBadTents := boundedOverlapForSelectedBadTents
      radiusChargingMeasure := radiusChargingMeasure
    } :
      ExcessDropTelescopesToRadiusCharging
        seq K hRho hPot hTree hSource.badNodeRadiusDrop)
    chargingNotSignedFluxOnly
    chargingNotLocalDecayOnly

