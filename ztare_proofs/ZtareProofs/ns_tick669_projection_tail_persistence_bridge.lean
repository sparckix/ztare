structure C7CoronaDuhamelSelectedSameTreeInvoiceEmbeddingCarrierData
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L)
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L)
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hEmbedding : SameTreeCarlesonInvoiceEmbedding hElig hLock) where
  lowerEnvelopeSource :
    ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel
  sectionIdentity :
    ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel
  lowerEnvelopeSourceUsesSectionIdentity :
    lowerEnvelopeSource.sectionIdentity = sectionIdentity
  defectMeasure : C7ProductionDefectMeasure seq K hRho
  localizedProductionGain :
    LocalizedProductionLevelSetGain seq K hRho
  duhamelHeatLocalization :
    ResidualFreshDuhamelHeatLocalizedToPuncturedInvoiceCarrier
      hElig hGeom hDuhamel
  pressureComplementLocalization :
    ResidualFreshPressureComplementDualTestLocalization
      hElig hGeom hPressure
  annularHarmonicMomentCancellation :
    AnnularHarmonicMomentCancellation hElig hGeom hPressure
  inheritedNonchargeability :
    InheritedNodesRoutedOffSameLedgerParentInvoice hElig hLock
  auditIndexFixedBeforeSpendPartition :
    ResidualFreshAuditIndexFixedBeforeSpendPartition
      hElig hGeom hPressure hDuhamel
  heatKernelLowerBound : ℝ
  crownPositiveSourceMass : ℝ
  productionSpend : ℝ
  parentRadiusInvoiceSpend : ℝ
  pressureReserveSpend : ℝ
  duhamelReserveSpend : ℝ
  inheritedReserveSpend : ℝ
  totalBudget : ℝ
  childCrownMassSum : ℝ
  pressureComplementSpend : ℝ
  heatKernelLowerBound_nonnegative : 0 ≤ heatKernelLowerBound
  crownPositiveSourceMass_nonnegative : 0 ≤ crownPositiveSourceMass
  productionSpend_nonnegative : 0 ≤ productionSpend
  parentRadiusInvoiceSpend_nonnegative : 0 ≤ parentRadiusInvoiceSpend
  pressureReserveSpend_nonnegative : 0 ≤ pressureReserveSpend
  duhamelReserveSpend_nonnegative : 0 ≤ duhamelReserveSpend
  inheritedReserveSpend_nonnegative : 0 ≤ inheritedReserveSpend
  crownDuhamelLowerBound :
    heatKernelLowerBound * crownPositiveSourceMass ≤ productionSpend
  productionSpend_le_duhamelReserveSpend :
    productionSpend ≤ duhamelReserveSpend
  childCrownMass_le_inheritedReserve :
    childCrownMassSum ≤ inheritedReserveSpend
  rawMassSplit :
    CoronaDuhamelRawMassSplit
      heatKernelLowerBound crownPositiveSourceMass
      productionSpend inheritedReserveSpend
  pressureComplementSpend_le_pressureReserve :
    pressureComplementSpend ≤ pressureReserveSpend
  parentRadiusInvoice_le_splitBudget :
    parentRadiusInvoiceSpend ≤
      productionSpend + pressureReserveSpend + inheritedReserveSpend
  singleSpendPartition :
    productionSpend + parentRadiusInvoiceSpend + pressureReserveSpend +
      duhamelReserveSpend + inheritedReserveSpend ≤ totalBudget
  coronaThresholdTheta : ℝ
  coronaThresholdTheta_pos : 0 < coronaThresholdTheta
  crownProductionOrInheritedDichotomy : Prop
  parentCrownSelectedBeforeChildPayoff :
    hDuhamel.assignedBeforeRadiusAccounting
  pressureReserveNotParentInvoice : Prop
  duhamelReserveNotShellProcessLedger : Prop
  duhamelReserveNotShellProcessLedger_proof :
    duhamelReserveNotShellProcessLedger
  inheritedDescendantsDoNotMintParentInvoices : Prop
  noRepeatedDescendantCharging :
    hLock.noRepeatedDescendantCharging
  heatLengthOnlyParabolicScale : Prop
  heatLengthOnlyParabolicScale_proof :
    heatLengthOnlyParabolicScale
  notConstantinFeffermanAlignment : Prop
  notDegreeZeroRieszBookkeeping : Prop
  notParabolicRateSlavedScalar : Prop

