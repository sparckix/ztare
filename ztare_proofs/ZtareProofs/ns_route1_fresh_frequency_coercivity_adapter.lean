/--
The sparse high-high ghost directly kills the upstream annular source-selection
theorem once the route tail is identified with the sparse source-square stream.

This proof consumes the owner-preimage prefix budget from
`NonadaptiveAnnularC7SourceSelection` itself, not the downstream
corona-Duhamel or same-carrier packing consumer.  Therefore the next PDE
obligation is exactly at the owner-map boundary: prove that the selected C7
route tail is not this sparse high-high ghost, or supply a genuine
owner-preimage/strict-tail theorem that makes the ghost inadmissible.
-/
theorem no_nonadaptiveAnnularC7SourceSelection_of_sparseHighHighGhost
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hGhost : SparseHighHighCriticalSourceGhostPacket routeActiveTail)
    (hSelect :
      NonadaptiveAnnularC7SourceSelection h hId) :
    False := by
  rcases hGhost.sourceSquarePrefixesExceedEveryFiniteBudget
      (hSelect.multiplicityBound * hSelect.atomBudget) with ⟨N, hgt⟩
  have hOwner :=
    NonadaptiveAnnularC7SourceSelection.eventPrefix_le_ownerBudget hSelect N
  have hRoute :
      NS.nsPrefixSum routeActiveTail N ≤
        hSelect.multiplicityBound * hSelect.atomBudget := by
    simpa [hSelect.eventRadiusPayment_eq_routeActiveTail] using hOwner
  exact not_lt_of_ge hRoute hgt

/--
The accepted constructive predecessor for the non-parabolic ghost-killer is the
annular owner-preimage source-selection theorem.  It supplies the explicit
owner map, selected-prefix packing, bounded multiplicity, timing, and
same-carrier no-reuse data; paired with a sparse high-high ghost, its owner
prefix budget gives contradiction.
-/
def SparseHighHighGhostNonParabolicSelectedC7Mechanism.ofNonadaptiveAnnularC7SourceSelection
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
