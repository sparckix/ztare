        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L) where
  sectionIdentity :
    ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel
  positivePartSelectedBeforePayoff :
    hDuhamel.assignedBeforeRadiusAccounting
  reverseHolderAboveThreshold :
    ProductionReverseHolderAboveThreshold seq K hRho
  reverseHolderUsesUnshadowedCrownPositivePart : Prop
  eventKernelLowerBoundIsOnlyLocalizationInput : Prop
  notQuadraticReserveOnly : Prop
  notPosthocPositivePartSelection : Prop
  notConstantinFeffermanAlignment : Prop
  notBKMOrSupNormInput : Prop

/-- A Duhamel positive-part bridge supplies the generic localized production
gain by projecting its strict above-threshold reverse Holder estimate. -/
def LocalizedProductionLevelSetGain.ofDuhamelPositivePartProductionGainBridge
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
