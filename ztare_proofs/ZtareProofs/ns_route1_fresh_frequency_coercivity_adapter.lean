  pointwiseSameCarrierPayment :=
    hMatch.pointwiseMatchedCapacityPaysRouteTail
  finitePrefixFreshCarrierBudget :=
    hMatch.finitePrefixMatchedCapacityBudget
  matchedCapacityLivesOnSameResidualFreshCarrier :=
    hMatch.matchedCapacityLivesOnSameResidualFreshCarrier
  matchedCapacityLivesOnSameResidualFreshCarrier_proof :=
    hMatch.matchedCapacityLivesOnSameResidualFreshCarrier_proof
  finitePrefixMatchingSaturatesRouteDemand :=
    hMatch.finitePrefixMatchingSaturatesRouteDemand
  finitePrefixMatchingSaturatesRouteDemand_proof :=
    hMatch.finitePrefixMatchingSaturatesRouteDemand_proof
  noDescendantCapacityReuse :=
    hMatch.noDescendantCapacityReuse
  noDescendantCapacityReuse_proof :=
    hMatch.noDescendantCapacityReuse_proof
  noSameCapacityDescendantRebilling :=
    hMatch.noSameCapacityDescendantRebilling
  noSameCapacityDescendantRebilling_proof :=
    hMatch.noSameCapacityDescendantRebilling_proof
  capacityNotScalarLedgerOnly :=
