  pressureComplementLocalization :
    ResidualFreshPressureComplementDualTestLocalization
      hElig hGeom hPressure
  annularHarmonicMomentCancellation :
    AnnularHarmonicMomentCancellation hElig hGeom hPressure
  sameTreeInvoiceEmbedding :
    SameTreeCarlesonInvoiceEmbedding hElig hLock
  inheritedNonchargeability :
    InheritedNodesRoutedOffSameLedgerParentInvoice hElig hLock
  productionSpend : ℝ
  invoiceSpend : ℝ
  pressureReserveSpend : ℝ
  duhamelReserveSpend : ℝ
  inheritedReserveSpend : ℝ
  totalBudget : ℝ
  spendsNonnegative : Prop
  productionSpend_nonnegative : 0 ≤ productionSpend
  invoiceSpend_nonnegative : 0 ≤ invoiceSpend
  pressureReserveSpend_nonnegative : 0 ≤ pressureReserveSpend
  duhamelReserveSpend_nonnegative : 0 ≤ duhamelReserveSpend
  inheritedReserveSpend_nonnegative : 0 ≤ inheritedReserveSpend
  auditIndexFixedBeforeSpendPartition :
    ResidualFreshAuditIndexFixedBeforeSpendPartition
      hElig hGeom hPressure hDuhamel
  productionUsesSameResidualFreshCarrier : Prop
  singleSpendPartition :
    productionSpend + invoiceSpend + pressureReserveSpend +
      duhamelReserveSpend + inheritedReserveSpend ≤ totalBudget
  pressureReserveNotParentInvoice : Prop
  duhamelReserveNotShellProcessLedger : Prop
  inheritedDescendantsDoNotMintParentInvoices : Prop
  noRepeatedDescendantCharging :
    hLock.noRepeatedDescendantCharging
  notBetaFrequencyPaymentRelabel : Prop
  notShellProcessReserveRelabel : Prop
  notConstantinFeffermanAlignment : Prop
  notDegreeZeroRieszBookkeeping : Prop
  notParabolicRateSlavedScalar : Prop

/-- The audit-indexed single-spend carrier projects to the older C7 bridge.
The reverse projection is absent because the older bridge does not display the
Duhamel section identity or the audit-index timing. -/
def C7SingleSpendDualLedgerBridge.ofResidualFreshAuditIndexedSingleSpendCarrier
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (h :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock) :
    C7SingleSpendDualLedgerBridge hElig hGeom hPressure hLock where
  defectMeasure := h.defectMeasure
  localizedProductionGain := h.localizedProductionGain
  sameTreeInvoiceEmbedding := h.sameTreeInvoiceEmbedding
  pressureComplementLocalization := h.pressureComplementLocalization
  annularHarmonicMomentCancellation := h.annularHarmonicMomentCancellation
  inheritedNonchargeability := h.inheritedNonchargeability
  productionSpend := h.productionSpend
  invoiceSpend := h.invoiceSpend
  pressureReserveSpend := h.pressureReserveSpend
  inheritedReserveSpend := h.inheritedReserveSpend
  totalBudget := h.totalBudget
  spendsNonnegative := h.spendsNonnegative
  productionSpend_nonnegative := h.productionSpend_nonnegative
  invoiceSpend_nonnegative := h.invoiceSpend_nonnegative
  pressureReserveSpend_nonnegative := h.pressureReserveSpend_nonnegative
  inheritedReserveSpend_nonnegative := h.inheritedReserveSpend_nonnegative
  totalBudgetPartitionsSpend :=
    h.productionSpend + h.invoiceSpend + h.pressureReserveSpend +
      h.inheritedReserveSpend ≤ h.totalBudget
  productionAndInvoiceSupportsDisjoint :=
    h.productionUsesSameResidualFreshCarrier
  pressureCollarReserveNotParentRadiusInvoice :=
    h.pressureReserveNotParentInvoice
  inheritedDescendantsDoNotMintParentInvoices :=
    h.inheritedDescendantsDoNotMintParentInvoices
  noRepeatedDescendantCharging := h.noRepeatedDescendantCharging
  totalSpend_le_totalBudget := by
    have hdrop :
        h.productionSpend + h.invoiceSpend + h.pressureReserveSpend +
            h.inheritedReserveSpend
          ≤ h.productionSpend + h.invoiceSpend + h.pressureReserveSpend +
            h.duhamelReserveSpend + h.inheritedReserveSpend := by
      linarith [h.duhamelReserveSpend_nonnegative]
    exact le_trans hdrop h.singleSpendPartition
  notConstantinFeffermanAlignment := h.notConstantinFeffermanAlignment
  notDegreeZeroRieszBookkeeping := h.notDegreeZeroRieszBookkeeping
  notParabolicRateSlavedScalar := h.notParabolicRateSlavedScalar

/--
Arithmetic core of the corona threshold dichotomy.  This is not the hard PDE
selection theorem; it records the exact bookkeeping that remains once a parent
crown has been split into unshadowed source mass and child-shadowed mass.
-/
structure CoronaDuhamelRawMassSplit
    (heatKernelLowerBound crownPositiveSourceMass
      productionSpend inheritedReserveSpend : ℝ) where
  unshadowedCrownRawMass : ℝ
  childCrownRawMass : ℝ
  unshadowedCrownRawMass_nonnegative : 0 ≤ unshadowedCrownRawMass
  childCrownRawMass_nonnegative : 0 ≤ childCrownRawMass
  crownSourceMass_le_split :
    crownPositiveSourceMass ≤ unshadowedCrownRawMass + childCrownRawMass
  unshadowedMassPaysProduction :
    heatKernelLowerBound * unshadowedCrownRawMass ≤ productionSpend
  childShadowMassPaysInheritedReserve :
    heatKernelLowerBound * childCrownRawMass ≤ inheritedReserveSpend

/-- Once the raw corona split is supplied, heat-scaled source mass is paid by
parent production plus inherited reserve. -/
theorem CoronaDuhamelRawMassSplit.heat_scaled_source_le_production_add_inherited
    {heatKernelLowerBound crownPositiveSourceMass
      productionSpend inheritedReserveSpend : ℝ}
    (h :
      CoronaDuhamelRawMassSplit
        heatKernelLowerBound crownPositiveSourceMass
        productionSpend inheritedReserveSpend)
    (hKernel : 0 ≤ heatKernelLowerBound) :
    heatKernelLowerBound * crownPositiveSourceMass ≤
      productionSpend + inheritedReserveSpend := by
  have hscaled :
      heatKernelLowerBound * crownPositiveSourceMass ≤
        heatKernelLowerBound *
          (h.unshadowedCrownRawMass + h.childCrownRawMass) :=
    mul_le_mul_of_nonneg_left h.crownSourceMass_le_split hKernel
  have hsplit :
      heatKernelLowerBound *
          (h.unshadowedCrownRawMass + h.childCrownRawMass) =
        heatKernelLowerBound * h.unshadowedCrownRawMass +
          heatKernelLowerBound * h.childCrownRawMass := by
    ring
  linarith [
    hscaled,
    hsplit,
    h.unshadowedMassPaysProduction,
    h.childShadowMassPaysInheritedReserve]

/--
Lower source for the corona raw-mass split.

The previous raw split was pure arithmetic.  This source is the next analytic
layer: the parent crown, unshadowed crown, and child-shadow crown are fixed as
event-local sets before payoff, and the positive source mass is dominated by
the two displayed positive charges.  Constructing this object is still PDE
work; once supplied, the remaining projection is arithmetic.
-/
structure CoronaDuhamelCrownMeasureSplitSource
    (Ω : Type u) (heatKernelLowerBound productionSpend
      inheritedReserveSpend : ℝ) where
  parentCrown : Set Ω
  unshadowedCrown : Set Ω
  childShadowCrown : Set Ω
  positiveSourceMass : Set Ω → ℝ
  unshadowedSourceMass : Set Ω → ℝ
  childShadowSourceMass : Set Ω → ℝ
  parentCrownSourceMass_nonnegative :
    0 ≤ positiveSourceMass parentCrown
  unshadowedSourceMass_nonnegative :
    0 ≤ unshadowedSourceMass unshadowedCrown
  childShadowSourceMass_nonnegative :
    0 ≤ childShadowSourceMass childShadowCrown
  parentCrownCoveredByFixedSplit :
    positiveSourceMass parentCrown ≤
      unshadowedSourceMass unshadowedCrown +
        childShadowSourceMass childShadowCrown
  unshadowedMassPaysProduction :
    heatKernelLowerBound * unshadowedSourceMass unshadowedCrown ≤
      productionSpend
  childShadowMassPaysInheritedReserve :
    heatKernelLowerBound * childShadowSourceMass childShadowCrown ≤
      inheritedReserveSpend
  crownSetsFixedBeforePayoff : Prop
  positiveSourceMassChosenBeforePayoff : Prop
  sameDuhamelSectionIdentityCarrier : Prop
  positiveVariationTakenBeforeRouteBudget : Prop
  childShadowMassNotSelectedFromParentDeficit : Prop
  noPosthocPositivePartSelection : Prop

/--
Section-fixed unsigned localized crown mass.

This is the extensional datum missing from scalar/reserve bookkeeping: the
parent, unshadowed, and child-shadow crowns and the unsigned mass functional
are tied to the fixed Duhamel section, rather than chosen after inspecting the
parent invoice or route payoff.
-/
structure SectionFixedUnsignedLocalizedCrownMass
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    (hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel)
    (hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel)
    (Ω : Type u) where
  parentCrown : Set Ω
  unshadowedCrown : Set Ω
  childShadowCrown : Set Ω
  mass : Set Ω → ℝ
  lowerEnvelopeSourceUsesSectionIdentity :
    hLower.sectionIdentity = hSection
  parentCrown_eq_unshadowed_union_childShadow :
    parentCrown = unshadowedCrown ∪ childShadowCrown
  unshadowed_childShadow_disjoint :
    Disjoint unshadowedCrown childShadowCrown
  parentCrownMass_le_split :
    mass parentCrown ≤ mass unshadowedCrown + mass childShadowCrown
  parentCrownFromSectionIncidence : Prop
  parentCrownFromSectionIncidence_proof :
    parentCrownFromSectionIncidence
  unshadowedChildSplitFromSectionIncidence : Prop
  unshadowedChildSplitFromSectionIncidence_proof :
    unshadowedChildSplitFromSectionIncidence
  massFixedByDuhamelLowerEnvelope : Prop
  massFixedByDuhamelLowerEnvelope_proof :
    massFixedByDuhamelLowerEnvelope
  independentOfParentInvoiceInput : Prop
  independentOfParentInvoiceInput_proof :
    independentOfParentInvoiceInput
  fixedBeforeRoutePayoff : Prop
  fixedBeforeRoutePayoff_proof :
    fixedBeforeRoutePayoff

/--
Oracle ambiguity for the section-fixed unsigned mass object.

The current object binds the receipt to a lower-envelope source and section
identity and forces the split to be taken from one mass functional.  It still
does not construct that mass from the Duhamel lower envelope.  This witness
keeps that source-realization gap explicit: the same lower-envelope/section
identity and same crown sets can carry different unsigned masses unless a
separate lower-envelope unsigned-variation theorem is supplied.
-/
structure SectionFixedUnsignedLocalizedCrownMassOracleAmbiguity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    (hLowerUses : hLower.sectionIdentity = hSection) where
  zeroMass :
    SectionFixedUnsignedLocalizedCrownMass hLower hSection Unit
  oneMass :
    SectionFixedUnsignedLocalizedCrownMass hLower hSection Unit
  sameParentCrown :
    zeroMass.parentCrown = oneMass.parentCrown
  sameUnshadowedCrown :
    zeroMass.unshadowedCrown = oneMass.unshadowedCrown
  sameChildShadowCrown :
    zeroMass.childShadowCrown = oneMass.childShadowCrown
  zeroParentMass_eq :
    zeroMass.mass zeroMass.parentCrown = 0
  oneParentMass_eq :
    oneMass.mass oneMass.parentCrown = 1

/--
The lower-envelope/section binding plus split restriction is not yet a
construction of the unsigned mass.  Both witnesses use the same crowns and
same section identity; only the mass functional differs.
-/
def SectionFixedUnsignedLocalizedCrownMassOracleAmbiguity.ofLowerSection
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    (hLowerUses : hLower.sectionIdentity = hSection) :
    SectionFixedUnsignedLocalizedCrownMassOracleAmbiguity hLowerUses where
  zeroMass :=
    { parentCrown := Set.univ
      unshadowedCrown := Set.univ
      childShadowCrown := ∅
      mass := fun _ => 0
      lowerEnvelopeSourceUsesSectionIdentity := hLowerUses
      parentCrown_eq_unshadowed_union_childShadow := by simp
      unshadowed_childShadow_disjoint := by simp
      parentCrownMass_le_split := by simp
      parentCrownFromSectionIncidence := True
      parentCrownFromSectionIncidence_proof := trivial
      unshadowedChildSplitFromSectionIncidence := True
      unshadowedChildSplitFromSectionIncidence_proof := trivial
      massFixedByDuhamelLowerEnvelope := True
      massFixedByDuhamelLowerEnvelope_proof := trivial
      independentOfParentInvoiceInput := True
      independentOfParentInvoiceInput_proof := trivial
      fixedBeforeRoutePayoff := True
      fixedBeforeRoutePayoff_proof := trivial }
  oneMass :=
    { parentCrown := Set.univ
      unshadowedCrown := Set.univ
      childShadowCrown := ∅
      mass := fun _ => 1
      lowerEnvelopeSourceUsesSectionIdentity := hLowerUses
      parentCrown_eq_unshadowed_union_childShadow := by simp
      unshadowed_childShadow_disjoint := by simp
      parentCrownMass_le_split := by norm_num
      parentCrownFromSectionIncidence := True
      parentCrownFromSectionIncidence_proof := trivial
      unshadowedChildSplitFromSectionIncidence := True
      unshadowedChildSplitFromSectionIncidence_proof := trivial
      massFixedByDuhamelLowerEnvelope := True
      massFixedByDuhamelLowerEnvelope_proof := trivial
      independentOfParentInvoiceInput := True
      independentOfParentInvoiceInput_proof := trivial
      fixedBeforeRoutePayoff := True
      fixedBeforeRoutePayoff_proof := trivial }
  sameParentCrown := rfl
  sameUnshadowedCrown := rfl
  sameChildShadowCrown := rfl
  zeroParentMass_eq := rfl
  oneParentMass_eq := rfl

/--
Candidate uniqueness extractor for the section-fixed unsigned parent mass.

This is the exact false promotion the route must avoid: reading a determined
parent-crown mass from the lower-envelope source and section identity alone.
-/
structure SectionFixedUnsignedParentMassDeterminedByLowerEnvelope
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    (_hLowerUses : hLower.sectionIdentity = hSection) where
  parentMass : ℝ
  allUnitCrownSectionMassesHaveParentMass :
    ∀ hMass :
      SectionFixedUnsignedLocalizedCrownMass hLower hSection Unit,
      hMass.parentCrown = Set.univ →
      hMass.unshadowedCrown = Set.univ →
      hMass.childShadowCrown = ∅ →
      hMass.mass hMass.parentCrown = parentMass

/--
No parent-crown mass extractor exists from the displayed lower-envelope source
and section identity alone.

The proof consumes the oracle ambiguity above.  Both section mass objects have
the same lower-envelope source, same section identity, and same crowns, yet
their parent masses are `0` and `1`.
-/
theorem no_sectionFixedUnsignedParentMassDeterminedByLowerEnvelope
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    (hLowerUses : hLower.sectionIdentity = hSection) :
    ¬ Nonempty
        (SectionFixedUnsignedParentMassDeterminedByLowerEnvelope
          hLowerUses) := by
  intro hDeterminedNonempty
  let hDetermined := hDeterminedNonempty.some
  let hAmb :=
    SectionFixedUnsignedLocalizedCrownMassOracleAmbiguity.ofLowerSection
      hLowerUses
  have hZeroMass :
      hAmb.zeroMass.mass hAmb.zeroMass.parentCrown =
        hDetermined.parentMass :=
    hDetermined.allUnitCrownSectionMassesHaveParentMass
      hAmb.zeroMass rfl rfl rfl
  have hOneMass :
      hAmb.oneMass.mass hAmb.oneMass.parentCrown =
        hDetermined.parentMass :=
    hDetermined.allUnitCrownSectionMassesHaveParentMass
      hAmb.oneMass rfl rfl rfl
  have hParentZero : hDetermined.parentMass = 0 := by
    rw [← hZeroMass]
    exact hAmb.zeroParentMass_eq
  have hParentOne : hDetermined.parentMass = 1 := by
    rw [← hOneMass]
    exact hAmb.oneParentMass_eq
  linarith

/--
Pairwise form of the same no-go: the lower-envelope source and section identity
do not determine the parent mass even when two candidate section mass objects
have identical parent, unshadowed, and child-shadow crowns.
-/
theorem no_sectionFixedUnsignedParentMassPairwiseDeterminedByLowerEnvelope
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    (hLowerUses : hLower.sectionIdentity = hSection) :
    ¬ (∀ M₀ M₁ :
          SectionFixedUnsignedLocalizedCrownMass hLower hSection Unit,
        M₀.parentCrown = M₁.parentCrown →
        M₀.unshadowedCrown = M₁.unshadowedCrown →
        M₀.childShadowCrown = M₁.childShadowCrown →
        M₀.mass M₀.parentCrown = M₁.mass M₁.parentCrown) := by
  intro hDetermined
  let hAmb :=
    SectionFixedUnsignedLocalizedCrownMassOracleAmbiguity.ofLowerSection
      hLowerUses
  have hEq :
      hAmb.zeroMass.mass hAmb.zeroMass.parentCrown =
        hAmb.oneMass.mass hAmb.oneMass.parentCrown :=
    hDetermined
      hAmb.zeroMass hAmb.oneMass
      hAmb.sameParentCrown
      hAmb.sameUnshadowedCrown
      hAmb.sameChildShadowCrown
  rw [hAmb.zeroParentMass_eq, hAmb.oneParentMass_eq] at hEq
  norm_num at hEq

/--
Deterministic lower-envelope unsigned-variation realization.

This is the false canonical promotion, not the still-open constructive
receipt: it asserts that the lower-envelope source and section identity
determine the localized unsigned parent mass for any two section-fixed mass
objects with the same crowns.  A future positive theorem must add extensional
NS data that constructs the mass; it cannot use this determinacy shortcut.
-/
structure DuhamelLowerEnvelopeUnsignedVariationRealization
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    (_hLowerUses : hLower.sectionIdentity = hSection) where
  parentMassDeterminedByLowerEnvelopeAndSection :
    ∀ M₀ M₁ :
        SectionFixedUnsignedLocalizedCrownMass hLower hSection Unit,
      M₀.parentCrown = M₁.parentCrown →
      M₀.unshadowedCrown = M₁.unshadowedCrown →
      M₀.childShadowCrown = M₁.childShadowCrown →
      M₀.mass M₀.parentCrown = M₁.mass M₁.parentCrown
  notScalarReserveWrapper : Prop
  notScalarReserveWrapper_proof : notScalarReserveWrapper
  notPointwiseOwnerPaymentOnly : Prop
  notPointwiseOwnerPaymentOnly_proof : notPointwiseOwnerPaymentOnly

/--
The current lower-envelope source and section identity do not support the
deterministic unsigned-variation realization above.

This consumes the pairwise oracle ambiguity.  It leaves open only a stronger
future theorem that supplies new extensional NS data constructing the unsigned
mass itself, rather than claiming determinacy from scalar lower-envelope data.
-/
theorem no_DuhamelLowerEnvelopeUnsignedVariationRealization_of_oracleAmbiguity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    (hLowerUses : hLower.sectionIdentity = hSection) :
    ¬ Nonempty
        (DuhamelLowerEnvelopeUnsignedVariationRealization hLowerUses) := by
  intro hRealization
  exact
    no_sectionFixedUnsignedParentMassPairwiseDeterminedByLowerEnvelope
      hLowerUses
      hRealization.some.parentMassDeterminedByLowerEnvelopeAndSection

/--
Unsigned localized crown measure receipt fixed by the Duhamel section.

This is the positive escape from the signed-scalar/reserve extractor no-go. It
adds data not visible to `SignedDuhamelScalarQuadraticReserveParentCrownExtractor`:
a section-fixed unsigned mass functional on localized parent/unshadowed/child
crown sets, chosen before payoff and before the route budget is inspected.
The projection to `CoronaDuhamelCrownMeasureSplitSource` is arithmetic; the
hard PDE work is constructing this receipt from the Duhamel section identity.
-/
structure DuhamelSectionFixedUnsignedCrownMeasureReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L)
    (hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel)
    (hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel)
    (heatKernelLowerBound productionSpend inheritedReserveSpend : ℝ) where
  Ω : Type u
  parentCrown : Set Ω
  unshadowedCrown : Set Ω
  childShadowCrown : Set Ω
  positiveSourceMass : Set Ω → ℝ
  unshadowedSourceMass : Set Ω → ℝ
  childShadowSourceMass : Set Ω → ℝ
  sectionUnsignedMass :
    SectionFixedUnsignedLocalizedCrownMass hLower hSection Ω
  positiveSourceMass_eq_sectionUnsignedMass :
    ∀ E : Set Ω, positiveSourceMass E = sectionUnsignedMass.mass E
  parentCrown_eq_sectionParentCrown :
    parentCrown = sectionUnsignedMass.parentCrown
  unshadowedCrown_eq_sectionUnshadowedCrown :
    unshadowedCrown = sectionUnsignedMass.unshadowedCrown
  childShadowCrown_eq_sectionChildShadowCrown :
    childShadowCrown = sectionUnsignedMass.childShadowCrown
  unshadowedSourceMass_crown_eq_sectionUnsignedMass :
    unshadowedSourceMass unshadowedCrown =
      sectionUnsignedMass.mass sectionUnsignedMass.unshadowedCrown
  childShadowSourceMass_crown_eq_sectionUnsignedMass :
    childShadowSourceMass childShadowCrown =
      sectionUnsignedMass.mass sectionUnsignedMass.childShadowCrown
  parentCrownSourceMass_nonnegative :
    0 ≤ positiveSourceMass parentCrown
  unshadowedSourceMass_nonnegative :
    0 ≤ unshadowedSourceMass unshadowedCrown
  childShadowSourceMass_nonnegative :
    0 ≤ childShadowSourceMass childShadowCrown
  unshadowedMassPaysProduction :
    heatKernelLowerBound * unshadowedSourceMass unshadowedCrown ≤
      productionSpend
  childShadowMassPaysInheritedReserve :
    heatKernelLowerBound * childShadowSourceMass childShadowCrown ≤
      inheritedReserveSpend
  sectionIncidenceFixedBeforePayoff :
    hDuhamel.assignedBeforeRadiusAccounting
  duhamelPrecertificatePresent :
    hSection.notBareSectionIncidenceWithoutDuhamelPrecertificate
  parentCrownFixedByDuhamelSection : Prop
  parentCrownFixedByDuhamelSection_proof :
    parentCrownFixedByDuhamelSection
  unshadowedCrownFixedByDuhamelSection : Prop
  unshadowedCrownFixedByDuhamelSection_proof :
    unshadowedCrownFixedByDuhamelSection
  childShadowCrownFixedByDuhamelSection : Prop
  childShadowCrownFixedByDuhamelSection_proof :
    childShadowCrownFixedByDuhamelSection
  unsignedMassFunctionalFixedByDuhamelLowerEnvelope : Prop
  unsignedMassFunctionalFixedByDuhamelLowerEnvelope_proof :
    unsignedMassFunctionalFixedByDuhamelLowerEnvelope
  sameDuhamelSectionIdentityCarrier : Prop
  sameDuhamelSectionIdentityCarrier_proof :
    sameDuhamelSectionIdentityCarrier
  positiveVariationTakenBeforeRouteBudget : Prop
  positiveVariationTakenBeforeRouteBudget_proof :
    positiveVariationTakenBeforeRouteBudget
  childShadowMassNotSelectedFromParentDeficit : Prop
  childShadowMassNotSelectedFromParentDeficit_proof :
    childShadowMassNotSelectedFromParentDeficit
  noPositivePartChosenFromParentInvoice : Prop
  noPositivePartChosenFromParentInvoice_proof :
    noPositivePartChosenFromParentInvoice
  noPosthocPositivePartSelection : Prop
  noPosthocPositivePartSelection_proof :
    noPosthocPositivePartSelection

/--
A section-fixed unsigned receipt supplies the existing crown measure split.

This adapter is intentionally one-way: the existing split fields do not imply
that the unsigned measure was fixed by the Duhamel section.  That stronger
information is exactly what escapes the parent/child shadow-swap no-go.
-/
def CoronaDuhamelCrownMeasureSplitSource.ofSectionFixedUnsignedReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hSection :
      ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel}
    {hLower :
      ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel}
    {heatKernelLowerBound productionSpend inheritedReserveSpend : ℝ}
    (h :
      DuhamelSectionFixedUnsignedCrownMeasureReceipt
        hElig hDuhamel hSection hLower
        heatKernelLowerBound productionSpend inheritedReserveSpend) :
    CoronaDuhamelCrownMeasureSplitSource
      h.Ω heatKernelLowerBound productionSpend inheritedReserveSpend where
  parentCrown := h.parentCrown
  unshadowedCrown := h.unshadowedCrown
  childShadowCrown := h.childShadowCrown
  positiveSourceMass := h.positiveSourceMass
  unshadowedSourceMass := h.unshadowedSourceMass
  childShadowSourceMass := h.childShadowSourceMass
  parentCrownSourceMass_nonnegative :=
    h.parentCrownSourceMass_nonnegative
  unshadowedSourceMass_nonnegative :=
    h.unshadowedSourceMass_nonnegative
  childShadowSourceMass_nonnegative :=
    h.childShadowSourceMass_nonnegative
  parentCrownCoveredByFixedSplit :=
    by
      calc
        h.positiveSourceMass h.parentCrown
            = h.sectionUnsignedMass.mass h.parentCrown :=
              h.positiveSourceMass_eq_sectionUnsignedMass h.parentCrown
        _ = h.sectionUnsignedMass.mass h.sectionUnsignedMass.parentCrown := by
              rw [h.parentCrown_eq_sectionParentCrown]
        _ ≤
            h.sectionUnsignedMass.mass h.sectionUnsignedMass.unshadowedCrown +
              h.sectionUnsignedMass.mass h.sectionUnsignedMass.childShadowCrown :=
              h.sectionUnsignedMass.parentCrownMass_le_split
        _ =
            h.unshadowedSourceMass h.unshadowedCrown +
              h.childShadowSourceMass h.childShadowCrown := by
              rw [← h.unshadowedSourceMass_crown_eq_sectionUnsignedMass,
                ← h.childShadowSourceMass_crown_eq_sectionUnsignedMass]
  unshadowedMassPaysProduction := h.unshadowedMassPaysProduction
  childShadowMassPaysInheritedReserve :=
