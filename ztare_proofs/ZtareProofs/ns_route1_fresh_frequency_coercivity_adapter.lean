        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock) :
    ResidualFreshAuditIndexedSingleSpendCarrier
      hElig hGeom hPressure hDuhamel hLock where
  defectMeasure := h.defectMeasure
  localizedProductionGain := h.localizedProductionGain
  duhamelHeatLocalization := h.duhamelHeatLocalization
  pressureComplementLocalization := h.pressureComplementLocalization
  annularHarmonicMomentCancellation := h.annularHarmonicMomentCancellation
  sameTreeInvoiceEmbedding := h.sameTreeInvoiceEmbedding
  inheritedNonchargeability := h.inheritedNonchargeability
  productionSpend := h.productionSpend
  invoiceSpend := h.parentRadiusInvoiceSpend
  pressureReserveSpend := h.pressureReserveSpend
  duhamelReserveSpend := h.duhamelReserveSpend
  inheritedReserveSpend := h.inheritedReserveSpend
  totalBudget := h.totalBudget
  spendsNonnegative := True
  productionSpend_nonnegative := h.productionSpend_nonnegative
  invoiceSpend_nonnegative := h.parentRadiusInvoiceSpend_nonnegative
  pressureReserveSpend_nonnegative := h.pressureReserveSpend_nonnegative
  duhamelReserveSpend_nonnegative := h.duhamelReserveSpend_nonnegative
  inheritedReserveSpend_nonnegative := h.inheritedReserveSpend_nonnegative
  auditIndexFixedBeforeSpendPartition :=
    h.auditIndexFixedBeforeSpendPartition
  productionUsesSameResidualFreshCarrier :=
    h.crownProductionOrInheritedDichotomy
  singleSpendPartition := h.singleSpendPartition
  pressureReserveNotParentInvoice := h.pressureReserveNotParentInvoice
  duhamelReserveNotShellProcessLedger := h.duhamelReserveNotShellProcessLedger
  inheritedDescendantsDoNotMintParentInvoices :=
    h.inheritedDescendantsDoNotMintParentInvoices
  noRepeatedDescendantCharging := h.noRepeatedDescendantCharging
  notBetaFrequencyPaymentRelabel := h.heatLengthOnlyParabolicScale
  notShellProcessReserveRelabel := h.duhamelReserveNotShellProcessLedger
  notConstantinFeffermanAlignment := h.notConstantinFeffermanAlignment
  notDegreeZeroRieszBookkeeping := h.notDegreeZeroRieszBookkeeping
  notParabolicRateSlavedScalar := h.notParabolicRateSlavedScalar

/--
C7 lineage-schedule source target.

This is the de-anchored finite-tail source theorem for the corona-Duhamel
lane.  The active tail alone is not the right numeraire for the route tail.
To feed the existing route-1 pincer, the selected C7 schedule must be paid by
the same single-spend carrier through active/passive production, Duhamel
recharge, pressure/cutoff residual, and the parent-invoice/routed tail channel.
-/
structure CoronaDuhamelLineageScheduleBudgetSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock) where
  lineageTailSchedule : Nat → Real
  activeLocalEnergyTail : Nat → Real
  passiveCaloricCharge : Nat → Real
  duhamelRecharge : Nat → Real
  pressureCutoffResidual : Nat → Real
  parentInvoiceOrRoutedTail : Nat → Real
  lineageTailSchedule_le_components :
    ∀ N : Nat,
      NS.nsPrefixSum lineageTailSchedule N ≤
        NS.nsPrefixSum
          (fun n : Nat =>
            activeLocalEnergyTail n + passiveCaloricCharge n +
              duhamelRecharge n + pressureCutoffResidual n +
                parentInvoiceOrRoutedTail n) N
  activePassivePrefix_le_productionInherited :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat => activeLocalEnergyTail n + passiveCaloricCharge n) N ≤
        h.productionSpend + h.inheritedReserveSpend
  duhamelPrefix_le_duhamelReserve :
    ∀ N : Nat, NS.nsPrefixSum duhamelRecharge N ≤ h.duhamelReserveSpend
  pressureCutoffPrefix_le_pressureReserve :
    ∀ N : Nat,
      NS.nsPrefixSum pressureCutoffResidual N ≤ h.pressureReserveSpend
  parentInvoicePrefix_le_parentInvoiceSpend :
    ∀ N : Nat,
      NS.nsPrefixSum parentInvoiceOrRoutedTail N ≤ h.parentRadiusInvoiceSpend
  parentRadiusInvoiceSpend_nonnegative_verified :
    0 ≤ h.parentRadiusInvoiceSpend
  singleSpendPartition_verified :
    h.productionSpend + h.parentRadiusInvoiceSpend + h.pressureReserveSpend +
      h.duhamelReserveSpend + h.inheritedReserveSpend ≤ h.totalBudget
  duhamelSectionIdentityForLineage :
    ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel
  noRepeatedDescendantCharging_verified :
    hLock.noRepeatedDescendantCharging
  activePassiveShareProductionInheritedNoDoubleCount : Prop
  duhamelRechargeBookedOnlyInDuhamelReserve : Prop
  pressureCutoffBookedOnlyInPressureReserve : Prop
  parentInvoiceTailBookedOnlyInParentInvoiceSpend : Prop
  lineageMultiplicityBoundedBeforePayoff : Prop
  noPostHocScheduleDefinition : Prop
  noActiveOnlyTailControlClaim : Prop
  noUpstreamBranchClosureClaim : Prop

/--
The C7 lineage schedule source feeds the existing concrete aggregate budget
node.  This is only a budget connector; persistence, same-carrier tail-square
identification, and branch exhaustion remain separate obligations.
-/
def LineageScheduleConcreteAggregateBudgetSource.ofCoronaDuhamelLineageSchedule
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    (s : CoronaDuhamelLineageScheduleBudgetSource h) :
    LineageScheduleConcreteAggregateBudgetSource where
  lineageTailSchedule := s.lineageTailSchedule
  activeLocalEnergyTail := s.activeLocalEnergyTail
  passiveCaloricCharge := s.passiveCaloricCharge
  duhamelRecharge := s.duhamelRecharge
  cutoffCommutatorResidual := s.pressureCutoffResidual
  routedResidual := s.parentInvoiceOrRoutedTail
  rootReserveBudget := h.productionSpend + h.inheritedReserveSpend
  eventPriceBudget := h.duhamelReserveSpend
  cutoffErrorBudget := h.pressureReserveSpend
  routedResidualBudget := h.parentRadiusInvoiceSpend
  scheduleBudget := h.totalBudget
  scheduleBudget_nonneg := by
    have hspends_nonneg :
        0 ≤ h.productionSpend + h.parentRadiusInvoiceSpend +
          h.pressureReserveSpend + h.duhamelReserveSpend +
            h.inheritedReserveSpend := by
      nlinarith [h.productionSpend_nonnegative,
        h.parentRadiusInvoiceSpend_nonnegative,
        h.pressureReserveSpend_nonnegative,
        h.duhamelReserveSpend_nonnegative,
        h.inheritedReserveSpend_nonnegative]
    nlinarith [hspends_nonneg, h.singleSpendPartition]
  M_lineage := 1
  activePassivePrefix_le_rootReserve :=
    s.activePassivePrefix_le_productionInherited
  duhamelPrefix_le_eventBudget := by
    intro N
    simpa using s.duhamelPrefix_le_duhamelReserve N
  cutoffPrefix_le_cutoffBudget := by
    intro N
    simpa using s.pressureCutoffPrefix_le_pressureReserve N
  routedResidualPrefix_le_budget :=
    s.parentInvoicePrefix_le_parentInvoiceSpend
  aggregateBudget_le_scheduleBudget := by
    nlinarith [h.singleSpendPartition]
  lineageTailSchedule_le_components :=
    s.lineageTailSchedule_le_components
  activePassiveShareRootReserveNoDoubleCount :=
    s.activePassiveShareProductionInheritedNoDoubleCount
  duhamelRechargeBookedOnlyInEventPriceBudget :=
    s.duhamelRechargeBookedOnlyInDuhamelReserve
  cutoffResidualBookedOnlyInCutoffBudget :=
    s.pressureCutoffBookedOnlyInPressureReserve
  routedResidualExcludesNamedComponents :=
    s.parentInvoiceTailBookedOnlyInParentInvoiceSpend
  boundedLineageMultiplicityNumeric :=
    s.lineageMultiplicityBoundedBeforePayoff
  noPostHocScheduleDefinition :=
    s.noPostHocScheduleDefinition
  noPersistenceEstimateClaim :=
    s.noActiveOnlyTailControlClaim
  noUpstreamBranchClosureClaim :=
    s.noUpstreamBranchClosureClaim

/-- TICK656 boundary for the pressure complement route.  A missing
complement-dual-test localization is now localized to a harmonic-collar
rebilling obstruction unless the stronger single-spend bridge supplies the
moment cancellation and invoice partition explicitly. -/
structure ResidualFreshPressureComplementDualTestObstructionBoundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L)
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc) where
  complementDualTestLocalizationMissing :
    ¬ Nonempty
      (ResidualFreshPressureComplementDualTestLocalization
        hElig hGeom hPressure)
  annularHarmonicMomentCancellationMissing :
    ¬ Nonempty
      (AnnularHarmonicMomentCancellation hElig hGeom hPressure)
  singleSpendDualLedgerBridgeMissing :
    ¬ Nonempty
      (C7SingleSpendDualLedgerBridge hElig hGeom hPressure hLock)
  harmonicCollarRebillingObstruction :
    HarmonicCollarRebillingObstruction hElig hGeom hPressure
  standalonePressureCzRouteRetired : Prop
  conditionalReplacementIsSingleSpendDualLedger : Prop
  pressureGaugeAloneDoesNotKillQuadraticMode : Prop
  noCreditForDegreeZeroEndpointRepackaging : Prop

/-- Constructor for the TICK656 pressure-complement boundary. -/
theorem residualFreshPressureComplementDualTest_needs_harmonicMomentOrSingleSpend
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hNoDual :
      ¬ Nonempty
        (ResidualFreshPressureComplementDualTestLocalization
          hElig hGeom hPressure))
    (hNoMoment :
      ¬ Nonempty
        (AnnularHarmonicMomentCancellation hElig hGeom hPressure))
    (hNoBridge :
      ¬ Nonempty
        (C7SingleSpendDualLedgerBridge hElig hGeom hPressure hLock)) :
    Nonempty
      (ResidualFreshPressureComplementDualTestObstructionBoundary
        hElig hGeom hPressure hLock) := by
  refine ⟨{
    complementDualTestLocalizationMissing := hNoDual
    annularHarmonicMomentCancellationMissing := hNoMoment
    singleSpendDualLedgerBridgeMissing := hNoBridge
    harmonicCollarRebillingObstruction := {
      pressureCarrierAlreadyEventTent := hGeom.pressureCarrier_eq_eventTent
      freshRegionCanBeStrictlySmallerThanEventTent := True
      annularExteriorDivergenceFreePacketAvailable := True
      exteriorPressureIsHarmonicOnFreshRegion := True
      nonzeroQuadraticHarmonicModeSurvivesGauge := True
      complementDualTestCanPairWithQuadraticMode := fun _ _ _ => True
      inheritedOrChildCollarPressureCanRebillParentInvoice := True
      dyadicCopiesHaveScaleInvariantPairing := True
      noBetaOrRadiusPaymentFromDegreeZeroPressureAlone := True
      pressureTailLocalizedToFreshVelocityIsOnlyCoarse :=
        hElig.pressureTailLocalizedToFreshVelocity
    }
    standalonePressureCzRouteRetired := True
    conditionalReplacementIsSingleSpendDualLedger := True
    pressureGaugeAloneDoesNotKillQuadraticMode := True
    noCreditForDegreeZeroEndpointRepackaging := True
  }⟩

/--
TICK663 boundary.  The fresh-frequency pressure/Duhamel same-carrier lock is
not yet the same thing as a parent fresh-radius invoice.  It controls a prefix
event price and exposes no-descendant charging through the same-tree lock, but
the C7 route still needs the stronger single-spend bridge that separates local
production, same-tree radius invoice, pressure reserve, and inherited reserve.
-/
