/--
Nearest-confuser surface for the TICK668 finite-prefix matching lane.

This is the polished wrong-path artifact the receipt gate must reject: it has
the same state-price-looking numerical fields as a finite-prefix matching
certificate, but its fresh capacity or matching schedule is selected after the
radius-sum payoff is visible.  The point is not to prove a PDE theorem from
this object; the point is to make the nonadaptive receipt a formal discriminator
instead of relying on vocabulary such as "Hall", "state price", or "capacity".
-/
structure C7PostPayoffMatchingConfuserFromIndexedCarrier
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock) where
  routeActiveTail : Nat → Real
  freshCharge : Nat → Real
  c : Real
  rootBudget : Real
  c_pos : 0 < c
  routeTailIdentification :
    C7RouteActiveTailEventBetaSquareIdentification
      (hBeta := hBeta) (hEvents := hEvents) (L := L)
      routeActiveTail
  pointwiseStatePriceDominatesPayoff :
    ∀ n : Nat, c * routeActiveTail n ≤ freshCharge n
  finitePrefixStatePriceBudget :
    ∀ N : Nat, NS.nsPrefixSum freshCharge N ≤ rootBudget
  sameVisibleSurfaceAsFinitePrefixMatching : Prop
  sameVisibleSurfaceAsFinitePrefixMatching_proof :
    sameVisibleSurfaceAsFinitePrefixMatching
  freshCapacitySelectedAfterRadiusPayoff : Prop
  freshCapacitySelectedAfterRadiusPayoff_proof :
    freshCapacitySelectedAfterRadiusPayoff
  matchingScheduleSelectedAfterRadiusSum : Prop
  matchingScheduleSelectedAfterRadiusSum_proof :
    matchingScheduleSelectedAfterRadiusSum
  rejectsNonadaptiveSourceSelection :
    ∀ {candidateActiveTail : Nat → Real}
      (hId :
        C7RouteActiveTailEventBetaSquareIdentification
          (hBeta := hBeta) (hEvents := hEvents) (L := L)
          candidateActiveTail),
        C7NonadaptiveSourceSelectionReceipt hIndexed hId → False

/--
The post-payoff matching confuser cannot be accepted as a finite-prefix matching
certificate.  Any such certificate carries `nonadaptiveSourceSelection`, and the
confuser's receipt gate rejects exactly that field.
-/
theorem C7PostPayoffMatchingConfuserFromIndexedCarrier.noFinitePrefixMatchingCertificate
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
