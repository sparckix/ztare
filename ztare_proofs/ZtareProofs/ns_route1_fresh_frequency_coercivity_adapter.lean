  l3LinfNormFinite_nonneg : 0 ≤ l3LinfNormFinite
  essApplies : Prop
  /-- ESS conclusion: regularity on the bad set under `l3LinfBoundedOnBadSet`. -/
  regularityOnBadSet : Prop
  ess_l3_implies_regularity :
    l3LinfBoundedOnBadSet → essApplies → regularityOnBadSet
  /-- A regular bad set cannot host a silent flat defect (`cknBadAtAllScales` is empty). -/
  regularityRefutesDefect : regularityOnBadSet → ¬ defect.silentDefectExists
  essIsExternalToCKN : Prop
  notProvedInternallyHere : Prop

