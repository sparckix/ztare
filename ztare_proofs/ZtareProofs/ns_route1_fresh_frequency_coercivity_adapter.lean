  excludesLogarithmicBadScaleReuse :=
    hLock.noRepeatedDescendantCharging
  doesNotFactorThroughCFGlobalExtension :=
    h.notConstantinFeffermanAlignment

/--
TICK663 strict intermediate.  The carrier is indexed by the residual-fresh
audit event itself, so the same preselected event stream is forced to carry
Duhamel heat localization, pressure complement reserve, local production gain,
and the parent radius invoice without descendant rebilling.

This is stronger than `C7SingleSpendDualLedgerBridge`: it displays the
Duhamel side and the audit-index timing that the older bridge does not name.
-/
structure ResidualFreshAuditIndexedSingleSpendCarrier
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
