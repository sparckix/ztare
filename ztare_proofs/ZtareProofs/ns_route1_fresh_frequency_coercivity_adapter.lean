    (hSelect :
      NonadaptiveAnnularC7SourceSelection h hId)
    (hConf :
      C7PostPayoffMatchingConfuserFromIndexedCarrier
        (CoronaDuhamelC7SourceCompletion.ofNonadaptiveAnnularC7SourceSelection
          hSelect).scheduleCompletion.projectedCarrier) :
    False :=
  no_coronaDuhamelC7SourceCompletion_of_postPayoffMatchingConfuser
    (CoronaDuhamelC7SourceCompletion.ofNonadaptiveAnnularC7SourceSelection
      hSelect)
    hConf

/--
Endpoint consumer for the finite-prefix matching certificate.

Once the matching certificate is genuinely inhabited, the route active-tail
prefixes are bounded by the displayed fresh-capacity budget.  The hard PDE work
is still sourcing the certificate; this theorem records the exact numerical
payoff once that source theorem exists.
-/
theorem activeTailPrefix_le_rootBudget_div_c_of_finitePrefixMatchingCertificate
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    (hMatch :
      FreshAnnularFinitePrefixMatchingCertificateFromIndexedCarrier hIndexed) :
    ∀ N : Nat,
      NS.nsPrefixSum hMatch.routeActiveTail N ≤
        hMatch.rootBudget / hMatch.c := by
  intro N
  have hpoint :
      NS.nsPrefixSum
          (fun n : Nat => hMatch.c * hMatch.routeActiveTail n) N ≤
        NS.nsPrefixSum hMatch.freshCharge N :=
    NS.ns_prefix_sum_le_of_pointwise
      (fun n : Nat => hMatch.c * hMatch.routeActiveTail n)
      hMatch.freshCharge
      hMatch.pointwiseMatchedCapacityPaysRouteTail N
  rw [nsPrefixSum_const_mul_left] at hpoint
  have hbudget :
      hMatch.c * NS.nsPrefixSum hMatch.routeActiveTail N ≤
        hMatch.rootBudget := by
    exact le_trans hpoint (hMatch.finitePrefixMatchedCapacityBudget N)
  have hbudget' :
      NS.nsPrefixSum hMatch.routeActiveTail N * hMatch.c ≤
        hMatch.rootBudget := by
    simpa [mul_comm] using hbudget
  exact (le_div_iff₀ hMatch.c_pos).2 hbudget'

