/--
Two-packet toy witness for the signed-cancellation shadow ambiguity.

The parent and child packets have the same heat-kernel moment.  The signed
profiles `(1,0)` and `(-1,2)` have the same scalar event pairing and both fit a
common quadratic reserve budget, but their positive mass lies on different
crown pieces.  Thus scalar Duhamel event data cannot determine the unsigned
parent/child crown split without a separate localized measure receipt.
-/
theorem twoPacket_signedCancellationShadowAmbiguity_toy :
    ∃ (kernelParent kernelChild budget
        profileAParent profileAChild profileBParent profileBChild : ℝ),
      0 < kernelParent ∧
      kernelParent = kernelChild ∧
      0 ≤ budget ∧
      kernelParent * profileAParent + kernelChild * profileAChild =
        kernelParent * profileBParent + kernelChild * profileBChild ∧
      profileAParent ^ (2 : Nat) + profileAChild ^ (2 : Nat) ≤ budget ∧
      profileBParent ^ (2 : Nat) + profileBChild ^ (2 : Nat) ≤ budget ∧
      0 < profileAParent ∧
      profileAChild = 0 ∧
      profileBParent < 0 ∧
      0 < profileBChild := by
  refine ⟨1, 1, 5, 1, 0, -1, 2, ?_⟩
  norm_num

/--
Same displayed event scalar and same quadratic reserve still do not determine
which crown owns the positive production tail.

Profile A places the spike on the parent crown and profile B places the same
spike on the child crown.  With equal event kernels, the signed event scalar
and the quadratic reserve are identical, but the parent positive cubic tail of
profile A can be made arbitrarily large while profile B has no parent spike.
Thus an unsigned localized crown source needs an extra localized measure
receipt; it cannot be read off from the displayed scalar Duhamel event data
and a common quadratic reserve.
-/
theorem sameEventAndQuadraticReserve_do_not_determine_parentPositiveCubicTail :
    ∀ B : ℝ, 0 ≤ B →
      ∃ kernelParent kernelChild amplitude supportMass : ℝ,
        0 < kernelParent ∧
        kernelParent = kernelChild ∧
        0 < amplitude ∧
        0 < supportMass ∧
        kernelParent * (amplitude * supportMass) + kernelChild * 0 =
          kernelParent * 0 + kernelChild * (amplitude * supportMass) ∧
        amplitude ^ (2 : Nat) * supportMass = 1 ∧
        amplitude ^ (2 : Nat) * supportMass + 0 =
          0 + amplitude ^ (2 : Nat) * supportMass ∧
        B < amplitude ^ (3 : Nat) * supportMass := by
  intro B hB
  let A : ℝ := B + 1
  have hApos : 0 < A := by
    dsimp [A]
    linarith
  have hAne : A ≠ 0 := ne_of_gt hApos
  let m : ℝ := (A ^ (2 : Nat))⁻¹
  have hmpos : 0 < m := by
    dsimp [m]
    exact inv_pos.mpr (pow_pos hApos 2)
  refine ⟨1, 1, A, m, by norm_num, rfl, hApos, hmpos, ?_, ?_, ?_, ?_⟩
  · ring
  · dsimp [m]
    field_simp [hAne]
  · ring
  · have hcubic : A ^ (3 : Nat) * m = A := by
      dsimp [m]
      field_simp [hAne]
    rw [hcubic]
    dsimp [A]
    linarith

/--
Hypothetical extractor for the false inference currently under attack.

It sees only a signed scalar Duhamel event value and a quadratic reserve
budget.  The specification says this data determines the parent-crown positive
mass for every parent/child signed profile.  The next theorem shows no such
extractor exists, even in a two-packet model.
-/
structure SignedDuhamelScalarQuadraticReserveParentCrownExtractor where
  parentPositiveMassOfSignedData : ℝ → ℝ → ℝ
  parentPositiveMassOfSignedData_spec :
    ∀ {k budget parent child : ℝ},
      0 < k →
      0 ≤ budget →
      parent ^ (2 : Nat) + child ^ (2 : Nat) ≤ budget →
      parentPositiveMassOfSignedData (k * parent + k * child) budget =
        max parent 0

/--
No parent-crown positive mass can be extracted from signed scalar Duhamel data
plus a quadratic reserve alone.

The profiles `(parent, child) = (1, 0)` and `(-1, 2)` have the same displayed
scalar when the parent and child kernels are both one, and both fit the same
quadratic reserve budget.  The parent positive masses are different, so any
extractor depending only on those displayed quantities is contradictory.
-/
theorem no_signedDuhamelScalarQuadraticReserveParentCrownExtractor :
    ¬ Nonempty SignedDuhamelScalarQuadraticReserveParentCrownExtractor := by
  intro hExtractor
  rcases hExtractor with ⟨E⟩
  have hA :
      E.parentPositiveMassOfSignedData 1 5 = 1 := by
    have hSpec :=
      E.parentPositiveMassOfSignedData_spec
        (k := 1) (budget := 5) (parent := 1) (child := 0)
        (by norm_num) (by norm_num) (by norm_num)
    norm_num at hSpec
    exact hSpec
  have hB :
      E.parentPositiveMassOfSignedData 1 5 = 0 := by
    have hSpec :=
      E.parentPositiveMassOfSignedData_spec
        (k := 1) (budget := 5) (parent := -1) (child := 2)
        (by norm_num) (by norm_num) (by norm_num)
    norm_num at hSpec
    exact hSpec
  linarith

