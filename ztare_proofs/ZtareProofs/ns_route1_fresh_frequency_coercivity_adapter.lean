noncomputable def C7AnnularSelectionScaledCurrencyNormalizationBridge.ofCanonicalOwnerGeometryCore
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
