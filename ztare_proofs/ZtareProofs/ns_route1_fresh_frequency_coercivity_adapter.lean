    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hSelect :
      NonadaptiveAnnularC7SourceSelection h hId) :
    SparseHighHighGhostNonParabolicSelectedC7Mechanism
      (seq := seq) (K := K) (hRho := hRho) routeActiveTail where
  sparseGhostInadmissible := by
    intro hGhost
    exact no_nonadaptiveAnnularC7SourceSelection_of_sparseHighHighGhost
      hGhost hSelect
  productionSourceSeparatedBeforePayoff :=
    hSelect.scheduleCompletion.projectedCarrier.productionUsesSameResidualFreshCarrier
  parentRadiusInvoiceSeparatedBeforePayoff :=
    hSelect.ownerPreimagePackingReceipt.ownerIsFullOutputScalePacket
  pressureReserveSeparatedFromProduction :=
    hSelect.scheduleCompletion.projectedCarrier.pressureReserveNotParentInvoice
  duhamelReserveSeparatedFromProduction :=
    hSelect.scheduleCompletion.projectedCarrier.duhamelReserveNotShellProcessLedger
  inheritedReserveSeparatedFromParentInvoice :=
    hSelect.scheduleCompletion.projectedCarrier.inheritedDescendantsDoNotMintParentInvoices
  partitionFixedBeforeSelectedPayoff :=
    hSelect.scheduleCompletion.propDeclarationsBackedByReceipts
  sectionIdentityFixedBeforeSelectedPayoff :=
    hSelect.sourceCompletionNotDeclarationOnly
  timingPrecommittedBeforeSelectedPayoff :=
    hSelect.ownerChosenByStoppingRuleBeforePayoff
  noReuseOfDescendantOrShadowCharges :=
    hSelect.ownerPreimagePackingReceipt.globalSelectedTreePreimageBound
  selectedC7OwnerPreimageOrSurplusWitness :=
    hSelect.ownerBudgetIsSameCoronaDuhamelCarrier
  boundedProjectionMultiplicityWitness :=
    hSelect.boundedOwnerMultiplicityOnLineage
  rejectsDSSOnlySelfSimilarExclusion :=
    hSelect.notUniformEnstrophyBudgetDisguise
  rejectsParabolicSlavedScalarReuse :=
    hSelect.notMonotoneTailCarrier
  rejectsDegreeZeroRieszBiotSavartBookkeeping :=
    hSelect.notScalarMeasureCarrier
  notMerelySparseGhostRediscovery :=
    hSelect.sourceCompletionNotDeclarationOnly

