    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {heatKernelLowerBound productionSpend inheritedReserveSpend : ℝ}
    (_hUnsigned :
      UnsignedLocalizedCrownSourceFromDuhamelSection
        (hScale := hScale) (hInc := hInc)
        hElig hDuhamel heatKernelLowerBound
        productionSpend inheritedReserveSpend)
    (hGhost : SparseHighHighCriticalSourceGhostPacket routeActiveTail)
