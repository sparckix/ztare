    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {routeActiveTail : Nat → Real}
    (hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock)
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail)
    (hReceipts :
      BadCenterBetaSquareScheduleReceiptsFromIndexedCarrier hIndexed)
    (hNoPostHocAuditIndexFromSpendOutcome :
      hIndexed.auditIndexFixedBeforeSpendPartition.noPostHocAuditIndexFromSpendOutcome)
    (freshCapacitySelectionFixedBeforeMatching : Prop)
    (hFreshCapacitySelectionFixedBeforeMatching :
      freshCapacitySelectionFixedBeforeMatching)
    (noPostHocFreshCapacityFromRealizedRadiusSum : Prop)
    (hNoPostHocFreshCapacityFromRealizedRadiusSum :
      noPostHocFreshCapacityFromRealizedRadiusSum)
    (matchingScheduleFixedBeforeRadiusSum : Prop)
    (hMatchingScheduleFixedBeforeRadiusSum :
      matchingScheduleFixedBeforeRadiusSum) :
    C7SameCarrierPackingNoReuseReceipt hIndexed hId where
  freshCharge :=
    fun n : Nat => L.eventWeight n * (L.eventGain n) ^ (2 : Nat)
  c := 1
  rootBudget := L.priceBudget
  c_pos := zero_lt_one
  nonadaptiveSourceSelection :=
    C7NonadaptiveSourceSelectionReceipt.ofIndexedCarrierAndRouteIdentification
      hIndexed hId hReceipts hNoPostHocAuditIndexFromSpendOutcome
      freshCapacitySelectionFixedBeforeMatching
      hFreshCapacitySelectionFixedBeforeMatching
      noPostHocFreshCapacityFromRealizedRadiusSum
      hNoPostHocFreshCapacityFromRealizedRadiusSum
      matchingScheduleFixedBeforeRadiusSum
      hMatchingScheduleFixedBeforeRadiusSum
  pointwiseSameCarrierPayment := by
    intro n
    simpa using
      c7RouteActiveTail_paid_by_eventCharge_of_eventBetaSquareIdentification
        hId n
  finitePrefixFreshCarrierBudget := by
    intro N
    simpa [NS.eventWeightedGainPricePrefix]
      using hLock.finiteIndependentEnstrophyDuhamelBudget N
  matchedCapacityLivesOnSameResidualFreshCarrier :=
    And
      hIndexed.sameTreeInvoiceEmbedding.invoiceUsesSameNormalizedExcessStoppingTree
      hLock.generatedFromSameBadCenterStoppingTree
  matchedCapacityLivesOnSameResidualFreshCarrier_proof :=
    And.intro
      hReceipts.invoiceUsesSameNormalizedExcessStoppingTree_proof
      hReceipts.generatedFromSameBadCenterStoppingTree_proof
  finitePrefixMatchingSaturatesRouteDemand :=
    ∀ N : Nat, NS.nsPrefixSum routeActiveTail N ≤ L.priceBudget
  finitePrefixMatchingSaturatesRouteDemand_proof := by
    intro N
    have hpoint :
        NS.nsPrefixSum
            (fun n : Nat => (1 : Real) * routeActiveTail n) N ≤
          NS.nsPrefixSum
            (fun n : Nat => L.eventWeight n * (L.eventGain n) ^ (2 : Nat)) N :=
      NS.ns_prefix_sum_le_of_pointwise
        (fun n : Nat => (1 : Real) * routeActiveTail n)
        (fun n : Nat => L.eventWeight n * (L.eventGain n) ^ (2 : Nat))
        (by
          intro n
          simpa using
            c7RouteActiveTail_paid_by_eventCharge_of_eventBetaSquareIdentification
              hId n)
        N
    rw [nsPrefixSum_const_mul_left] at hpoint
    have hbudget :
        (1 : Real) * NS.nsPrefixSum routeActiveTail N ≤ L.priceBudget := by
      exact le_trans hpoint
        (by
          simpa [NS.eventWeightedGainPricePrefix]
            using hLock.finiteIndependentEnstrophyDuhamelBudget N)
    simpa using hbudget
  noDescendantCapacityReuse :=
    hLock.noRepeatedDescendantCharging
  noDescendantCapacityReuse_proof :=
    hIndexed.noRepeatedDescendantCharging
  noSameCapacityDescendantRebilling :=
    And hId.noDescendantRebillingInActiveTailIndex
      hLock.noRepeatedDescendantCharging
  noSameCapacityDescendantRebilling_proof :=
    And.intro hId.noDescendantRebillingInActiveTailIndex_proof
      hIndexed.noRepeatedDescendantCharging
  capacityNotScalarLedgerOnly :=
    And hIndexed.notBetaFrequencyPaymentRelabel
      hIndexed.notShellProcessReserveRelabel
  capacityNotScalarLedgerOnly_proof :=
    And.intro hReceipts.notBetaFrequencyPaymentRelabel_proof
      hReceipts.notShellProcessReserveRelabel_proof

