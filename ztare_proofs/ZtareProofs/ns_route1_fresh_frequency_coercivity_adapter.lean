structure ClassicalCKNDataAloneFailsFlatRadiusReserve where
  cknMassChargeOnly_r_squared : Prop
  radiusPackingNeeds_r_linear : Prop
  rSquaredVsRGapIsAFullPowerOfR : Prop
  dyadicCountermodelSumR_diverges : Prop
  dyadicCountermodelSumRSquared_converges : Prop
  interpolationCaccioppoliPaysOnly_r_squared : Prop
  flatGeometryHasEmptyFreshRegion : Prop
  spatialCarrierGivesNoFreshDrop : Prop
  logPileupSurvivesSquareCharge : Prop
  countermodelKillsAnyCKNDerivedReserveCandidate : Prop

