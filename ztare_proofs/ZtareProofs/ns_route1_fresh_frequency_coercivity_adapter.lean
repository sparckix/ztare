/--
Fresh-energy/Poincare plus CKN-excess comparison pays shard-B's remaining
resolved mean-free square bound.
-/
theorem resolvedMeanFreeTentSquare_bound_of_decomposition
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h :
      FreshFrequencyResolvedMeanFreeTentSquareBoundDecomposition seq K hRho) :
    h.resolvedMeanFreeTentSquare ≤
      h.C_Q * h.localQuadraticTentExcess := by
  have henergy :
      h.C_energy * h.freshEnergy ≤
        h.C_energy * (h.C_ckn * h.localQuadraticTentExcess) :=
    mul_le_mul_of_nonneg_left h.freshEnergy_le_cknExcess h.C_energy_nonneg
  have hcoeff :
      h.C_energy * (h.C_ckn * h.localQuadraticTentExcess) =
        h.C_Q * h.localQuadraticTentExcess := by
    rw [h.C_Q_eq]
    ring
  nlinarith [h.resolvedSquare_le_freshEnergy, henergy, hcoeff]

/--
Assemble the resolved-bound decomposition from its two lower halves:
fresh-Poincare energy control and CKN-excess comparison.
-/
def FreshFrequencyResolvedMeanFreeTentSquareBoundDecomposition.ofFreshPoincareAndCKN
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (tailSquareFunction : Real)
    (hPoincare :
      FreshFrequencyFreshPoincareEnergyEstimate seq K hRho)
    (hCKN :
      FreshFrequencyFreshEnergyCKNExcessComparison seq K hRho)
    (hfresh :
      hPoincare.freshEnergy = hCKN.freshEnergy)
    (hresidual :
      hPoincare.residualFreshExcess = hCKN.residualFreshExcess)
    (C_Q : Real)
    (hCQ : C_Q = hPoincare.C_energy * hCKN.C_ckn) :
    FreshFrequencyResolvedMeanFreeTentSquareBoundDecomposition seq K hRho where
  cknScaleSplit := hCKN.cknScaleSplit
  residualFreshExcess := hCKN.residualFreshExcess
  tailSquareFunction := tailSquareFunction
  resolvedMeanFreeTentSquare := hPoincare.resolvedMeanFreeTentSquare
  freshEnergy := hCKN.freshEnergy
  localQuadraticTentExcess := hCKN.localQuadraticTentExcess
  C_energy := hPoincare.C_energy
  C_ckn := hCKN.C_ckn
  C_Q := C_Q
  C_energy_nonneg := by
    rw [hPoincare.C_energy_eq]
    exact mul_nonneg hPoincare.C_poincare_nonneg
      hPoincare.C_gradient_nonneg
  resolvedSquare_le_freshEnergy := by
    rw [← hfresh]
    exact resolvedSquare_le_freshEnergy_of_freshPoincareEnergyEstimate
      hPoincare
  freshEnergy_le_cknExcess := hCKN.freshEnergy_le_cknExcess
  C_Q_eq := hCQ
  cknSplitUsesSameRhoCarrier := hCKN.cknSplitUsesSameRhoCarrier
  freshEnergyIsScaleInvariant := by
    rw [← hresidual]
    exact hPoincare.scaleInvariantFreshEnergy
  resolvedSquareUsesFreshPoincareGeometry := by
    rw [← hresidual]
    exact hPoincare.freshPoincareGeometry
  pressureLocalizedBeforeCKNComparison :=
    hCKN.pressureLocalizedBeforeCKNComparison
  localSmallnessBridgeUsesCKNExcess :=
    hCKN.localSmallnessBridgeUsesCKNExcess
  meanFreeProjectionUsesGalileanGauge :=
    hPoincare.meanFreeProjectionUsesGalileanGauge
  noTailBudgetOrStrictnessInResolvedBound :=
    And hPoincare.noTailBudgetOrStrictnessInFreshPoincare
      hCKN.noTailBudgetOrStrictnessInCKNComparison

/-- Build the resolved mean-free square estimate from its lower decomposition. -/
def FreshFrequencyResolvedMeanFreeTentSquareEstimate.ofBoundDecomposition
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyResolvedMeanFreeTentSquareBoundDecomposition seq K hRho) :
    FreshFrequencyResolvedMeanFreeTentSquareEstimate
      seq K hRho hCarrier hBeta hEvents L where
  cknScaleSplit := h.cknScaleSplit
  residualFreshExcess := h.residualFreshExcess
  tailSquareFunction := h.tailSquareFunction
  resolvedMeanFreeTentSquare := h.resolvedMeanFreeTentSquare
  localQuadraticTentExcess := h.localQuadraticTentExcess
  C_Q := h.C_Q
  resolvedMeanFreeTentSquare_bound :=
    resolvedMeanFreeTentSquare_bound_of_decomposition h
  cknSplitUsesSameRhoCarrier := h.cknSplitUsesSameRhoCarrier
  resolvedSquareUsesResidualFreshRegion :=
    h.resolvedSquareUsesFreshPoincareGeometry
  meanFreeProjectionUsesGalileanGauge :=
    h.meanFreeProjectionUsesGalileanGauge
  noTailBudgetOrStrictnessInResolvedBound :=
    h.noTailBudgetOrStrictnessInResolvedBound

/--
Full source object for shard-B mean-free tent Poincare.

This binds the numeric Poincare inequalities to the regularity-scale/CKN split
and residual fresh-excess primitives already present in the L3 file.  The two
inequalities remain explicit fields: the wrapper names the PDE station, it does
not prove it.
-/
structure FreshFrequencyMeanFreeTentPoincareSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  eventTentGeometry :
    LerayHeatFreshFrequencyEventTentGeometry seq K hRho hCarrier hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  cknScaleSplit : CKNExcessRegularityScaleSplitWitness seq K
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  tailSquareFunction : Real
  resolvedMeanFreeTentSquare : Real
  localQuadraticTentExcess : Real
  frequencyLeakage : Real
  C_Q : Real
  frequencyLeakage_nonneg : 0 ≤ frequencyLeakage
  squareFunction_split :
    tailSquareFunction ≤ resolvedMeanFreeTentSquare + frequencyLeakage
  resolvedMeanFreeTentSquare_bound :
    resolvedMeanFreeTentSquare ≤ C_Q * localQuadraticTentExcess
  cknSplitUsesSameRhoCarrier : Prop
  residualFreshRegionUsesEventTentFamily : Prop
  meanFreeProjectionUsesGalileanGauge : Prop
  noTailBudgetOrStrictnessInCKNScaleSplit : Prop

/-- Build shard-B's certificate from the full CKN/residual-fresh source. -/
def FreshFrequencyMeanFreeTentPoincareCertificate.ofSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyMeanFreeTentPoincareSource
        seq K hRho hCarrier hBeta hEvents L) :
    FreshFrequencyMeanFreeTentPoincareCertificate :=
  FreshFrequencyMeanFreeTentPoincareCertificate.ofEventTentCKNData
    h.eventTentGeometry h.boundedFanoutNoLogReuse
    h.squareBudgetPaysRadiusBeta
    h.tailSquareFunction h.resolvedMeanFreeTentSquare
    h.localQuadraticTentExcess h.frequencyLeakage h.C_Q
    h.frequencyLeakage_nonneg h.squareFunction_split
    h.resolvedMeanFreeTentSquare_bound
    (And h.residualFreshExcess.freshEnstrophyDrop
      h.residualFreshRegionUsesEventTentFamily)

/--
Build shard-B's source after the square split has already been paid by a
carrier identity.  The only remaining numeric estimate is the resolved
mean-free square bound.
-/
def FreshFrequencyMeanFreeTentPoincareSource.ofSplitIdentityAndResolvedEstimate
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hSplit :
      FreshFrequencyMeanFreeTentSquareSplitIdentity
        seq K hRho hCarrier hBeta hEvents L)
    (hResolved :
      FreshFrequencyResolvedMeanFreeTentSquareEstimate
        seq K hRho hCarrier hBeta hEvents L)
    (htail :
      hResolved.tailSquareFunction = hSplit.tailSquareFunction)
    (hresolved :
      hResolved.resolvedMeanFreeTentSquare =
        hSplit.resolvedMeanFreeTentSquare) :
    FreshFrequencyMeanFreeTentPoincareSource
      seq K hRho hCarrier hBeta hEvents L where
  eventTentGeometry := hSplit.eventTentGeometry
  boundedFanoutNoLogReuse := hSplit.boundedFanoutNoLogReuse
  squareBudgetPaysRadiusBeta := hSplit.squareBudgetPaysRadiusBeta
  cknScaleSplit := hResolved.cknScaleSplit
  residualFreshExcess := hResolved.residualFreshExcess
  tailSquareFunction := hResolved.tailSquareFunction
  resolvedMeanFreeTentSquare := hSplit.resolvedMeanFreeTentSquare
  localQuadraticTentExcess := hResolved.localQuadraticTentExcess
  frequencyLeakage := hSplit.frequencyLeakage
  C_Q := hResolved.C_Q
  frequencyLeakage_nonneg := hSplit.frequencyLeakage_nonneg
  squareFunction_split := by
    rw [htail]
    exact squareFunction_split_of_meanFreeTentSquareSplitIdentity hSplit
  resolvedMeanFreeTentSquare_bound := by
    rw [← hresolved]
    exact hResolved.resolvedMeanFreeTentSquare_bound
  cknSplitUsesSameRhoCarrier := hResolved.cknSplitUsesSameRhoCarrier
  residualFreshRegionUsesEventTentFamily :=
    And
      (hSplit.residualOrInherited.freshRegion =
        hSplit.residualFreshExcess.freshRegion)
      hSplit.resolvedSquareFromFreshRegion
  meanFreeProjectionUsesGalileanGauge :=
    hResolved.meanFreeProjectionUsesGalileanGauge
  noTailBudgetOrStrictnessInCKNScaleSplit :=
    And hSplit.noTailBudgetOrStrictnessInSplit
      hResolved.noTailBudgetOrStrictnessInResolvedBound

/-- Shard 2: frequency-localized Poincare/CKN control of the square function by
local quadratic tent excess, with an explicit leakage remainder. -/
structure FreshFrequencyCKNTentPoincareControl where
  tailSquareFunction : Real
  localQuadraticTentExcess : Real
  frequencyLeakage : Real
  C_Q : Real
  frequencyLeakage_nonneg : 0 ≤ frequencyLeakage
  boundedOverlap : Prop
  frequencyLocalizedMeanFreeTail : Prop
  localQuadraticTentExcess_defined_by_cknIntegral : Prop
  localQuadraticTentExcessIsCKNBadWindowExcess : Prop
  meanFreeGalileanNormalizationBeforePoincare : Prop
  frequencyLocalizedTentPoincare :
    tailSquareFunction ≤ C_Q * localQuadraticTentExcess + frequencyLeakage

/-- Build shard B from lower mean-free tent Poincare bookkeeping. -/
def FreshFrequencyCKNTentPoincareControl.ofMeanFreeTentPoincareCertificate
    (h : FreshFrequencyMeanFreeTentPoincareCertificate) :
    FreshFrequencyCKNTentPoincareControl where
  tailSquareFunction := h.tailSquareFunction
  localQuadraticTentExcess := h.localQuadraticTentExcess
  frequencyLeakage := h.frequencyLeakage
  C_Q := h.C_Q
  frequencyLeakage_nonneg := h.frequencyLeakage_nonneg
  boundedOverlap :=
    And h.boundedOverlap h.resolvedSquareUsesSameTentFamily
  frequencyLocalizedMeanFreeTail := h.frequencyLocalizedMeanFreeTail
  localQuadraticTentExcess_defined_by_cknIntegral :=
    And
      h.localQuadraticTentExcess_defined_by_cknIntegral
      h.cknExcessFixedBeforeTailBudget
  localQuadraticTentExcessIsCKNBadWindowExcess :=
    h.localQuadraticTentExcessIsCKNBadWindowExcess
  meanFreeGalileanNormalizationBeforePoincare :=
    h.meanFreeGalileanNormalizationBeforePoincare
  frequencyLocalizedTentPoincare :=
    frequencyLocalizedTentPoincare_of_meanFreeTentPoincareCertificate h

/-- Local receipt for the tent-boundary part of shard-C leakage. -/
structure FreshFrequencyTentBoundaryTruncationReceipt where
  tentBoundaryError : Real
  boundaryLeakageCharge : Real
  boundaryCharge_bound :
    boundaryLeakageCharge ≤ tentBoundaryError
  boundaryChargeIsTentTruncationError : Prop
  boundaryChargeFixedBeforeAbsorptionFork : Prop

/--
Local receipt for the transport part of shard-C leakage.

The scalar fallback below still exists, but this structure gives future work a
place to attach the actual route-flux estimate instead of passing only `V_T`.
-/
structure FreshFrequencyTransportLeakageReceipt where
  transportVisibility : Real
  transportLeakageCharge : Real
  C_T : Real
  transportVisibility_nonneg : 0 ≤ transportVisibility
  transportCharge_bound :
    transportLeakageCharge ≤ C_T * transportVisibility
  routeFluxVisibilityProducer : Prop
  divergenceFreeCutoffFluxAccounted : Prop
  transportChargeFixedBeforeAbsorptionFork : Prop
  noGlobalTransportCancellationSmuggled : Prop

/-- Scalar fallback from the existing route-1 channel producer. -/
def FreshFrequencyTransportLeakageReceipt.ofRoute1ChannelVisibility
    (hChannels : Route1ChannelVisibilityProducer) :
    FreshFrequencyTransportLeakageReceipt where
  transportVisibility := hChannels.V_T
  transportLeakageCharge := hChannels.V_T
  C_T := (1 : Real)
  transportVisibility_nonneg := hChannels.V_T_nonneg
  transportCharge_bound := by
    simp
  routeFluxVisibilityProducer := 0 ≤ hChannels.V_T
  divergenceFreeCutoffFluxAccounted := True
  transportChargeFixedBeforeAbsorptionFork := True
  noGlobalTransportCancellationSmuggled := True

/--
Pressure-`l = 2` transport route into the fresh-frequency transport receipt.

This is still conditional on the transport estimate, but it is PDE-native:
the charge is the absolute material transport defect and the visibility budget
is the local quadratic plus advected-pressure plus commutator residual side of
`l2CarrierTransportInequality`.
-/
def FreshFrequencyTransportLeakageReceipt.ofPressureL2TransportTarget
    (transportDefect localQuadratic advectedPressure residual : Real)
    (hTarget :
      l2CarrierTransportInequality
        transportDefect localQuadratic advectedPressure residual) :
    FreshFrequencyTransportLeakageReceipt where
  transportVisibility := localQuadratic + advectedPressure + residual
  transportLeakageCharge := |transportDefect|
  C_T := (1 : Real)
  transportVisibility_nonneg := by
    exact le_trans (abs_nonneg transportDefect) hTarget
  transportCharge_bound := by
    simpa [l2CarrierTransportInequality,
      pressureHessianL2TransportTarget] using hTarget
  routeFluxVisibilityProducer :=
    l2CarrierTransportInequality
      transportDefect localQuadratic advectedPressure residual
  divergenceFreeCutoffFluxAccounted := True
  transportChargeFixedBeforeAbsorptionFork := True
  noGlobalTransportCancellationSmuggled := True

/-- Build the same receipt from the narrower pressure-`l = 2` defect obligation. -/
def FreshFrequencyTransportLeakageReceipt.ofPressureL2TransportObligation
    (stretch pressureL2 vorticitySq radialGrade Λ0 C0 decayProfile
      transportDefect localQuadratic advectedPressure commutatorResidual : Real)
    (hObligation :
      pressureL2TransportDefectObligation
        stretch pressureL2 vorticitySq radialGrade Λ0 C0 decayProfile
        transportDefect localQuadratic advectedPressure commutatorResidual) :
    FreshFrequencyTransportLeakageReceipt :=
  FreshFrequencyTransportLeakageReceipt.ofPressureL2TransportTarget
    transportDefect (C0 * localQuadratic) (C0 * advectedPressure)
    commutatorResidual
    (transport_defect_control_of_pressureL2TransportObligation
      hObligation).1

/--
Full route-flux source for the transport receipt.

This object binds the scalar pressure-`l = 2` transport target to the L3
Duchon-Robert flux carrier, the event-tent geometry, and the radius-cutoff
truncation data.  It is still not the transport estimate: the charge bound is
an explicit field.  The value is that future proofs cannot pay transport by a
free scalar without also naming the flux/cutoff source they use.
-/
structure FreshFrequencyRouteFluxTransportReceiptSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  drFlux : DuchonRobertFlux
  eventTentGeometry :
    LerayHeatFreshFrequencyEventTentGeometry seq K hRho hCarrier hEvents L
  radiusCutoff :
    BadCenterRadiusCutoffScaleTruncationData seq K hRho hCarrier hBeta
  stretch : Real
  pressureL2 : Real
  vorticitySq : Real
  radialGrade : Real
  Λ0 : Real
  C0 : Real
  decayProfile : Real
  transportDefect : Real
  localQuadratic : Real
  advectedPressure : Real
  commutatorResidual : Real
  pressureL2Transport :
    pressureL2TransportDefectObligation
      stretch pressureL2 vorticitySq radialGrade Λ0 C0 decayProfile
      transportDefect localQuadratic advectedPressure commutatorResidual
  transportVisibility : Real
  transportLeakageCharge : Real
  C_T : Real
  transportVisibility_nonneg : 0 ≤ transportVisibility
  transportCharge_bound :
    transportLeakageCharge ≤ C_T * transportVisibility
  localizedDRFluxUsesSameEventTentCutoff : Prop
  transportDefectControlsLocalizedDRFlux : Prop
  divergenceFreeCutoffFluxAccounted : Prop
  transportChargeFixedBeforeAbsorptionFork : Prop
  noGlobalTransportCancellationSmuggled : Prop

/-- Build a transport receipt from the full DR-flux/event-tent/cutoff source. -/
def FreshFrequencyTransportLeakageReceipt.ofRouteFluxTransportSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyRouteFluxTransportReceiptSource
        seq K hRho hCarrier hBeta hEvents L) :
    FreshFrequencyTransportLeakageReceipt where
  transportVisibility := h.transportVisibility
  transportLeakageCharge := h.transportLeakageCharge
  C_T := h.C_T
  transportVisibility_nonneg := h.transportVisibility_nonneg
  transportCharge_bound := h.transportCharge_bound
  routeFluxVisibilityProducer :=
    And h.localizedDRFluxUsesSameEventTentCutoff
      h.transportDefectControlsLocalizedDRFlux
  divergenceFreeCutoffFluxAccounted := h.divergenceFreeCutoffFluxAccounted
  transportChargeFixedBeforeAbsorptionFork :=
    h.transportChargeFixedBeforeAbsorptionFork
  noGlobalTransportCancellationSmuggled :=
    h.noGlobalTransportCancellationSmuggled

/--
Positive localized transport flux lower-payment source.

The transport scout separates this from the signed/global pressure-`l = 2`
defect.  A lower-payment theorem may use this object only if the positive
localized cutoff flux is actually paid by the receipt charge; same route-flux
provenance and upper visibility bounds alone are not enough.
-/
structure FixedWindowPositiveLocalizedTransportFluxLowerPaymentSource where
  transportReceipt : FreshFrequencyTransportLeakageReceipt
  normalizedTransportLeakagePart : Real
  positiveLocalizedFluxCharge : Real
  signedTransportDefectAbs : Real
  sameEventTentAndCutoff : Prop
  positiveFluxIsLocalizedCutoffFlux : Prop
  signedDefectMayCancelGlobally : Prop
  positiveFluxFixedBeforeFinalCarrier : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop
  normalizedTransport_le_positiveLocalizedFlux :
    normalizedTransportLeakagePart ≤ positiveLocalizedFluxCharge
  positiveLocalizedFlux_le_transportReceiptCharge :
    positiveLocalizedFluxCharge ≤ transportReceipt.transportLeakageCharge

/-- Positive localized flux source supplies the transport lower-payment field. -/
theorem normalizedTransportPart_le_transportReceiptCharge_of_positiveLocalizedFlux
    (h : FixedWindowPositiveLocalizedTransportFluxLowerPaymentSource) :
    h.normalizedTransportLeakagePart ≤
      h.transportReceipt.transportLeakageCharge := by
  exact le_trans h.normalizedTransport_le_positiveLocalizedFlux
    h.positiveLocalizedFlux_le_transportReceiptCharge

/--
No-go guard from the transport-flux scout: a signed/global transport defect can
underpay normalized transport leakage while positive localized flux remains
large.  Therefore `|transportDefect|` is not a valid lower-payment charge unless
one proves a no-cancellation/coercivity comparison to the positive local flux.
-/
structure FixedWindowSignedGlobalTransportCancellationUnderpay where
  normalizedTransportLeakagePart : Real
  positiveLocalizedFluxCharge : Real
  signedTransportDefectAbs : Real
  transportLeakageCharge : Real
  transportVisibility : Real
  C_T : Real
  sameEventTentAndCutoff : Prop
  positiveFluxPaysNormalizedTransport :
    normalizedTransportLeakagePart ≤ positiveLocalizedFluxCharge
  transportLeakageCharge_eq_signedDefect :
    transportLeakageCharge = signedTransportDefectAbs
  transportCharge_bound :
    transportLeakageCharge ≤ C_T * transportVisibility
  signedGlobalCancellationPresent : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop
  transportLeakageCharge_lt_normalizedTransport :
    transportLeakageCharge < normalizedTransportLeakagePart

/--
A signed/global cancellation underpay model forbids using the existing
transport charge as the normalized transport lower-payment receipt.
-/
theorem no_transportLowerPayment_of_signedGlobalCancellation
    (h : FixedWindowSignedGlobalTransportCancellationUnderpay) :
    ¬ h.normalizedTransportLeakagePart ≤ h.transportLeakageCharge := by
  intro hle
  exact not_lt_of_ge hle
    h.transportLeakageCharge_lt_normalizedTransport

/--
Sharper no-go guard: same event tent/cutoff plus local energy, DR, and
pressure-`l = 2` compatibility do not identify physical cutoff transport
leakage with a DR/pressure receipt.  A receipt charge can be small while the
physical transport leakage through the cutoff is positive.
-/
structure FixedWindowTransportLeakageNotLowerPaidByDRPressureReceipt
    (receipt : FreshFrequencyTransportLeakageReceipt)
    (normalizedTransportLeakagePart : Real) where
  sameEventTentAndCutoff : Prop
  localEnergyCKNCompatible : Prop
  pressureRecoveryCompatible : Prop
  duchonRobertFluxCompatible : Prop
  recoveredPressureL2CarrierCompatible : Prop
  normalizedTransportLeakagePositive : 0 < normalizedTransportLeakagePart
  receiptCanBeSmall :
    receipt.transportLeakageCharge < normalizedTransportLeakagePart
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/-- A small DR/pressure receipt charge forbids unconditional transport payment. -/
theorem no_transportLowerPayment_of_DRPressureReceiptSmall
    {receipt : FreshFrequencyTransportLeakageReceipt}
    {normalizedTransportLeakagePart : Real}
    (h :
      FixedWindowTransportLeakageNotLowerPaidByDRPressureReceipt
        receipt normalizedTransportLeakagePart) :
    ¬ normalizedTransportLeakagePart ≤ receipt.transportLeakageCharge := by
  intro hle
  exact not_lt_of_ge hle h.receiptCanBeSmall

/--
Concrete scout surface for coherent shear/material transport: a smooth
divergence-free shear can have positive outgoing cutoff leakage while pressure
and interscale DR/pressure-`l = 2` charges vanish.  This records the functional
mismatch without needing to formalize the analytic construction here.
-/
structure ShearTransportLeakageWithoutDRPressureCharge
    (receipt : FreshFrequencyTransportLeakageReceipt) where
  shearPacket : Prop
  smoothNavierStokesCompatible : Prop
  divergenceFree : Prop
  materialNonlinearityVanishes : Prop
  pressureConstant : Prop
  duchonRobertFluxZero : Prop
  pressureL2TransportChargeZero : Prop
  sameEventTentAndCutoff : Prop
  normalizedTransportLeakagePart : Real
  positiveOutgoingCutoffLeakage :
    0 < normalizedTransportLeakagePart
  receiptChargeZero :
    receipt.transportLeakageCharge = 0
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/-- The shear/coherent-transport scout blocks receipt lower payment. -/
theorem no_transportLowerPayment_of_shearTransportLeakageWithoutCharge
    {receipt : FreshFrequencyTransportLeakageReceipt}
    (h : ShearTransportLeakageWithoutDRPressureCharge receipt) :
    ¬ h.normalizedTransportLeakagePart ≤ receipt.transportLeakageCharge := by
  intro hle
  have hzero_lt :
      receipt.transportLeakageCharge < h.normalizedTransportLeakagePart := by
    rw [h.receiptChargeZero]
    exact h.positiveOutgoingCutoffLeakage
  exact not_lt_of_ge hle hzero_lt

/--
Same-carrier positive transport receipt.  This is the positive replacement for
the killed signed/global-defect route: the receipt must contain the positive
localized boundary-flux variation itself.
-/
structure SameCarrierPositiveTransportFluxReceipt
    (receipt : FreshFrequencyTransportLeakageReceipt)
    (normalizedTransportLeakagePart : Real) where
  sameEventTentAndCutoff : Prop
  localizedMaterialFlux : Real
  positiveFluxVariation : Real
  positiveFluxVariation_nonneg : 0 ≤ positiveFluxVariation
  localizedMaterialFluxUsesSameCutoff : Prop
  positiveFluxIsTotalVariationOrPositivePart : Prop
  normalizedLeakage_le_positiveFlux :
    normalizedTransportLeakagePart ≤ positiveFluxVariation
  receiptChargeContainsPositiveFlux :
    positiveFluxVariation ≤ receipt.transportLeakageCharge
  noSignedCancellation : Prop
  noDRPressureCarrierSubstitution : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Source object for the positive branch: the transport receipt charge contains
the same-carrier positive cutoff-flux variation.  This is still conditional;
it records the corrected receipt shape without claiming the PDE estimate that
constructs such a receipt.
-/
structure SameCarrierPositiveCutoffFluxTransportReceiptSource where
  receipt : FreshFrequencyTransportLeakageReceipt
  normalizedTransportLeakagePart : Real
  localizedMaterialFlux : Real
  positiveCutoffFluxCharge : Real
  positiveCutoffFluxCharge_nonneg : 0 ≤ positiveCutoffFluxCharge
  receiptCharge_eq_positiveCutoffFlux :
    receipt.transportLeakageCharge = positiveCutoffFluxCharge
  sameEventTentAndCutoff : Prop
  localizedMaterialFluxUsesSameCutoff : Prop
  positiveFluxIsTotalVariationOrPositivePart : Prop
  normalizedLeakage_le_positiveCutoffFlux :
    normalizedTransportLeakagePart ≤ positiveCutoffFluxCharge
  noSignedCancellation : Prop
  noDRPressureCarrierSubstitution : Prop
  invisibleTailAlternativePreserved : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/-- Positive cutoff-flux source supplies the same-carrier positive receipt. -/
def SameCarrierPositiveTransportFluxReceipt.ofPositiveCutoffFluxSource
    (h : SameCarrierPositiveCutoffFluxTransportReceiptSource) :
    SameCarrierPositiveTransportFluxReceipt
      h.receipt h.normalizedTransportLeakagePart where
  sameEventTentAndCutoff := h.sameEventTentAndCutoff
  localizedMaterialFlux := h.localizedMaterialFlux
  positiveFluxVariation := h.positiveCutoffFluxCharge
  positiveFluxVariation_nonneg := h.positiveCutoffFluxCharge_nonneg
  localizedMaterialFluxUsesSameCutoff :=
    h.localizedMaterialFluxUsesSameCutoff
  positiveFluxIsTotalVariationOrPositivePart :=
    h.positiveFluxIsTotalVariationOrPositivePart
  normalizedLeakage_le_positiveFlux :=
    h.normalizedLeakage_le_positiveCutoffFlux
  receiptChargeContainsPositiveFlux := by
    rw [h.receiptCharge_eq_positiveCutoffFlux]
  noSignedCancellation := h.noSignedCancellation
  noDRPressureCarrierSubstitution := h.noDRPressureCarrierSubstitution
  noFinalCarrierMagnitudeInput := h.noFinalCarrierMagnitudeInput
  noOverflowExcessReceiptSizing := h.noOverflowExcessReceiptSizing

/-- Same-carrier positive transport receipt instantiates the positive source. -/
def FixedWindowPositiveLocalizedTransportFluxLowerPaymentSource.ofSameCarrierReceipt
    {receipt : FreshFrequencyTransportLeakageReceipt}
    {normalizedTransportLeakagePart : Real}
    (h :
      SameCarrierPositiveTransportFluxReceipt
        receipt normalizedTransportLeakagePart) :
    FixedWindowPositiveLocalizedTransportFluxLowerPaymentSource where
  transportReceipt := receipt
  normalizedTransportLeakagePart := normalizedTransportLeakagePart
  positiveLocalizedFluxCharge := h.positiveFluxVariation
  signedTransportDefectAbs := |h.localizedMaterialFlux|
  sameEventTentAndCutoff := h.sameEventTentAndCutoff
  positiveFluxIsLocalizedCutoffFlux :=
    And h.localizedMaterialFluxUsesSameCutoff
      h.positiveFluxIsTotalVariationOrPositivePart
  signedDefectMayCancelGlobally := True
  positiveFluxFixedBeforeFinalCarrier := h.noFinalCarrierMagnitudeInput
  noFinalCarrierMagnitudeInput := h.noFinalCarrierMagnitudeInput
  noOverflowExcessReceiptSizing := h.noOverflowExcessReceiptSizing
  normalizedTransport_le_positiveLocalizedFlux :=
    h.normalizedLeakage_le_positiveFlux
  positiveLocalizedFlux_le_transportReceiptCharge :=
    h.receiptChargeContainsPositiveFlux

/-- Positive cutoff-flux source instantiates the transport lower-payment source. -/
def FixedWindowPositiveLocalizedTransportFluxLowerPaymentSource.ofPositiveCutoffFluxSource
    (h : SameCarrierPositiveCutoffFluxTransportReceiptSource) :
    FixedWindowPositiveLocalizedTransportFluxLowerPaymentSource :=
  FixedWindowPositiveLocalizedTransportFluxLowerPaymentSource.ofSameCarrierReceipt
    (SameCarrierPositiveTransportFluxReceipt.ofPositiveCutoffFluxSource h)

/--
Corrected transport branch: leakage is either paid by a same-carrier positive
boundary-flux receipt, or the uncharged remainder becomes a transport-invisible
tail to route through commutator/local-quadratic/no-invisible-profile machinery.
-/
structure FixedWindowTransportLeakageVisibleOrInvisible
    (receipt : FreshFrequencyTransportLeakageReceipt)
    (normalizedTransportLeakagePart : Real) where
  sameEventTentAndCutoff : Prop
  positiveBoundaryFluxCharge : Real
  positiveBoundaryFluxCharge_nonneg :
    0 ≤ positiveBoundaryFluxCharge
  normalizedLeakage_le_positiveBoundaryFlux :
    normalizedTransportLeakagePart ≤ positiveBoundaryFluxCharge
  transportInvisibleCriticalTail : Prop
  invisibleTailResolutionByCommutatorOrQuadraticOrNoInvisibleProfile : Prop
  paidByTransportReceipt :
    positiveBoundaryFluxCharge ≤ receipt.transportLeakageCharge
  orInvisibleTail :
    ¬ positiveBoundaryFluxCharge ≤ receipt.transportLeakageCharge →
      transportInvisibleCriticalTail
  noSignedGlobalDefectSubstitution : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Scalarized shear/functional-mismatch no-go: cutoff transport leakage can be
positive while the DR plus pressure-`l = 2` charges vanish.  This is stronger
than signed cancellation because it records that the two functionals need not
measure the same positive object.
-/
structure FixedWindowTransportShearFunctionalMismatchNoGo where
  normalizedTransportLeakagePart : Real
  transportLeakageCharge : Real
  cutoffTransportLeakage : Real
  drFluxCharge : Real
  pressureL2CarrierCharge : Real
  cutoffTransportLeakage_pos : 0 < cutoffTransportLeakage
  cutoffTransport_le_normalizedTransport :
    cutoffTransportLeakage ≤ normalizedTransportLeakagePart
  transportCharge_le_DR_plus_pressureL2 :
    transportLeakageCharge ≤ drFluxCharge + pressureL2CarrierCharge
  shearPacketHasConstantPressure : Prop
  shearPacketDRFluxZero : drFluxCharge = 0
  shearPacketPressureL2ChargeZero : pressureL2CarrierCharge = 0
  sameEventTentCutoff : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/-- Shear/functional mismatch forbids transport lower payment. -/
theorem no_transportLowerPayment_of_shearFunctionalMismatch
    (h : FixedWindowTransportShearFunctionalMismatchNoGo) :
    ¬ h.normalizedTransportLeakagePart ≤ h.transportLeakageCharge := by
  intro hle
  have hcharge_nonpos : h.transportLeakageCharge ≤ 0 := by
    nlinarith [h.transportCharge_le_DR_plus_pressureL2,
      h.shearPacketDRFluxZero, h.shearPacketPressureL2ChargeZero]
  have hnorm_pos : 0 < h.normalizedTransportLeakagePart := by
    exact lt_of_lt_of_le h.cutoffTransportLeakage_pos
      h.cutoffTransport_le_normalizedTransport
  exact not_lt_of_ge (le_trans hle hcharge_nonpos) hnorm_pos

/--
Split version of the corrected transport dichotomy.  It forces the visible
branch to be an unsigned/local receipt and leaves any shear/functional-mismatch
remainder as an explicit alternate-charge obligation.
-/
structure FixedWindowTransportVisibleOrInvisibleDichotomy
    (transportReceipt : FreshFrequencyTransportLeakageReceipt) where
  normalizedTransportLeakagePart : Real
  visibleTransportLeakage : Real
  invisibleShearLeakage : Real
  normalizedTransport_split :
    normalizedTransportLeakagePart ≤
      visibleTransportLeakage + invisibleShearLeakage
  visibleTransport_le_receiptCharge :
    visibleTransportLeakage ≤ transportReceipt.transportLeakageCharge
  invisibleShearRoutedToAlternateCharge : Prop
  visibleReceiptIsUnsignedLocalFluxOrTotalVariation : Prop
  invisibleMeansDRPressureL2FunctionalMismatch : Prop
  sameEventTentCutoff : Prop
  noGlobalSignedCancellationOnlyShortcut : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Gowers-first route closure for the corrected transport branch.  If the same
positive cutoff-flux charge splits into a visible part paid by the transport
receipt and an invisible part routed to commutator/local-quadratic/no-invisible
charges, then normalized transport leakage is paid by the route-level charge
sum.  This theorem deliberately does not identify DR flux or pressure-`l = 2`
carrier charge with the positive cutoff flux.
-/
structure FixedWindowTransportVisibleOrInvisibleRouteClosure
    (transportReceipt : FreshFrequencyTransportLeakageReceipt) where
  normalizedTransportLeakagePart : Real
  positiveBoundaryFluxCharge : Real
  visibleTransportLeakage : Real
  invisibleTransportLeakage : Real
  commutatorCharge : Real
  localQuadraticCharge : Real
  noInvisibleProfileCharge : Real
  normalizedTransport_le_positiveBoundaryFlux :
    normalizedTransportLeakagePart ≤ positiveBoundaryFluxCharge
  positiveBoundaryFlux_split :
    positiveBoundaryFluxCharge =
      visibleTransportLeakage + invisibleTransportLeakage
  visibleTransport_le_receiptCharge :
    visibleTransportLeakage ≤ transportReceipt.transportLeakageCharge
  invisibleTransport_le_alternateCharges :
    invisibleTransportLeakage ≤
      commutatorCharge + localQuadraticCharge + noInvisibleProfileCharge
  sameEventTentAndCutoff : Prop
  positiveFluxIsSameCarrierCutoffFlux : Prop
  noSignedGlobalDefectSubstitution : Prop
  noDRPressureCarrierSubstitution : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Route-level transport closure from visible/invisible split.  The proof is
scalar transitivity; the PDE content is entirely in the same-carrier positive
flux split and the alternate-charge routing fields.
-/
theorem normalizedTransport_le_transport_plus_alternateCharges_of_visibleOrInvisible
    {transportReceipt : FreshFrequencyTransportLeakageReceipt}
    (h : FixedWindowTransportVisibleOrInvisibleRouteClosure transportReceipt) :
    h.normalizedTransportLeakagePart ≤
      transportReceipt.transportLeakageCharge +
        h.commutatorCharge + h.localQuadraticCharge +
          h.noInvisibleProfileCharge := by
  calc
    h.normalizedTransportLeakagePart ≤
        h.positiveBoundaryFluxCharge :=
      h.normalizedTransport_le_positiveBoundaryFlux
    _ = h.visibleTransportLeakage + h.invisibleTransportLeakage :=
      h.positiveBoundaryFlux_split
    _ ≤ transportReceipt.transportLeakageCharge +
        (h.commutatorCharge + h.localQuadraticCharge +
          h.noInvisibleProfileCharge) :=
      add_le_add h.visibleTransport_le_receiptCharge
        h.invisibleTransport_le_alternateCharges
    _ = transportReceipt.transportLeakageCharge +
        h.commutatorCharge + h.localQuadraticCharge +
          h.noInvisibleProfileCharge := by ring

/--
Local-energy positive cutoff-flux split source.

This is the next source interface below the Gowers-first scalar closure: the
same positive boundary flux is split before the route target is summed.  The
transport-visible part is paid by the transport receipt; the residual pieces
are paid by pressure/local-quadratic, endpoint commutator, and no-invisible
profile charges.  No DR or pressure-`l = 2` carrier is substituted for the
physical positive cutoff flux.
-/
structure LocalEnergyPositiveCutoffFluxSplitSource
    (transportReceipt : FreshFrequencyTransportLeakageReceipt) where
  normalizedTransportLeakagePart : Real
  positiveBoundaryFluxCharge : Real
  visibleTransportFlux : Real
  pressureLocalQuadraticFluxResidual : Real
  commutatorFluxResidual : Real
  invisibleProfileFluxResidual : Real
  localQuadraticCharge : Real
  commutatorCharge : Real
  noInvisibleProfileCharge : Real
  normalizedTransport_le_positiveBoundaryFlux :
    normalizedTransportLeakagePart ≤ positiveBoundaryFluxCharge
  positiveBoundaryFlux_split_before_route_sum :
    positiveBoundaryFluxCharge =
      visibleTransportFlux + pressureLocalQuadraticFluxResidual +
        commutatorFluxResidual + invisibleProfileFluxResidual
  visibleTransportFlux_le_receiptCharge :
    visibleTransportFlux ≤ transportReceipt.transportLeakageCharge
  pressureFluxResidual_le_localQuadraticCharge :
    pressureLocalQuadraticFluxResidual ≤ localQuadraticCharge
  commutatorFluxResidual_le_commutatorCharge :
    commutatorFluxResidual ≤ commutatorCharge
  invisibleProfileResidual_le_noInvisibleProfileCharge :
    invisibleProfileFluxResidual ≤ noInvisibleProfileCharge
  sameEventTentAndCutoff : Prop
  positiveFluxIsSameCarrierCutoffFlux : Prop
  splitFixedBeforeRouteReceipt : Prop
  pressureResidualUsesLocalEnergyPressureFlux : Prop
  localQuadraticChargeUsesCKNTentExcess : Prop
  commutatorChargeUsesEndpointDefectMeasure : Prop
  invisibleResidualUsesNoInvisibleProfileObligation : Prop
  residualsNotDefinedAsTransportUnderpayment : Prop
  noSignedGlobalDefectSubstitution : Prop
  noDRPressureCarrierSubstitution : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
The local-energy split source instantiates the route-level visible/invisible
transport closure.  The proof is scalar bookkeeping; all PDE content is in the
four split-payment fields.
-/
def FixedWindowTransportVisibleOrInvisibleRouteClosure.ofLocalEnergySplit
    {transportReceipt : FreshFrequencyTransportLeakageReceipt}
    (h : LocalEnergyPositiveCutoffFluxSplitSource transportReceipt) :
    FixedWindowTransportVisibleOrInvisibleRouteClosure transportReceipt where
  normalizedTransportLeakagePart := h.normalizedTransportLeakagePart
  positiveBoundaryFluxCharge := h.positiveBoundaryFluxCharge
  visibleTransportLeakage := h.visibleTransportFlux
  invisibleTransportLeakage :=
    h.pressureLocalQuadraticFluxResidual + h.commutatorFluxResidual +
      h.invisibleProfileFluxResidual
  commutatorCharge := h.commutatorCharge
  localQuadraticCharge := h.localQuadraticCharge
  noInvisibleProfileCharge := h.noInvisibleProfileCharge
  normalizedTransport_le_positiveBoundaryFlux :=
    h.normalizedTransport_le_positiveBoundaryFlux
  positiveBoundaryFlux_split := by
    rw [h.positiveBoundaryFlux_split_before_route_sum]
    ring
  visibleTransport_le_receiptCharge :=
    h.visibleTransportFlux_le_receiptCharge
  invisibleTransport_le_alternateCharges := by
    nlinarith [h.pressureFluxResidual_le_localQuadraticCharge,
      h.commutatorFluxResidual_le_commutatorCharge,
      h.invisibleProfileResidual_le_noInvisibleProfileCharge]
  sameEventTentAndCutoff := h.sameEventTentAndCutoff
  positiveFluxIsSameCarrierCutoffFlux := h.positiveFluxIsSameCarrierCutoffFlux
  noSignedGlobalDefectSubstitution := h.noSignedGlobalDefectSubstitution
  noDRPressureCarrierSubstitution := h.noDRPressureCarrierSubstitution
  noFinalCarrierMagnitudeInput := h.noFinalCarrierMagnitudeInput
  noOverflowExcessReceiptSizing := h.noOverflowExcessReceiptSizing

/-- Local-energy split source pays the route-level transport closure. -/
theorem normalizedTransport_le_transport_plus_alternateCharges_of_localEnergySplit
    {transportReceipt : FreshFrequencyTransportLeakageReceipt}
    (h : LocalEnergyPositiveCutoffFluxSplitSource transportReceipt) :
    h.normalizedTransportLeakagePart ≤
      transportReceipt.transportLeakageCharge +
        h.commutatorCharge + h.localQuadraticCharge +
          h.noInvisibleProfileCharge := by
  exact
    normalizedTransport_le_transport_plus_alternateCharges_of_visibleOrInvisible
      (FixedWindowTransportVisibleOrInvisibleRouteClosure.ofLocalEnergySplit h)

/--
PDE-native positive boundary-flux subadditivity source.  Local energy and
positive-part estimates usually give an inequality such as
`F⁺ ≤ V⁺ + P⁺ + C⁺ + I`, not an exact partition of `F⁺`.  This source is
therefore weaker than `LocalEnergyPositiveCutoffFluxSplitSource` and closer to
the estimate one should try to prove from the cutoff local-energy identity.
-/
structure LocalEnergyPositiveBoundaryFluxSubadditivitySource
    (transportReceipt : FreshFrequencyTransportLeakageReceipt) where
  normalizedTransportLeakagePart : Real
  positiveBoundaryFluxCharge : Real
  visibleTransportFlux : Real
  pressureLocalQuadraticFluxCharge : Real
  commutatorFluxCharge : Real
  noInvisibleProfileCharge : Real
  localQuadraticCharge : Real
  commutatorCharge : Real
  normalizedTransport_le_positiveBoundaryFlux :
    normalizedTransportLeakagePart ≤ positiveBoundaryFluxCharge
  positiveBoundaryFlux_le_subadditivePieces :
    positiveBoundaryFluxCharge ≤
      visibleTransportFlux + pressureLocalQuadraticFluxCharge +
        commutatorFluxCharge + noInvisibleProfileCharge
  visibleTransportFlux_le_receiptCharge :
    visibleTransportFlux ≤ transportReceipt.transportLeakageCharge
  pressureFluxCharge_le_localQuadraticCharge :
    pressureLocalQuadraticFluxCharge ≤ localQuadraticCharge
  commutatorFluxCharge_le_commutatorCharge :
    commutatorFluxCharge ≤ commutatorCharge
  sameEventTentAndCutoff : Prop
  positiveFluxIsSameCarrierCutoffFlux : Prop
  positivePartSubadditivityUsed : Prop
  pressureFluxUsesLocalEnergyPressureTerm : Prop
  localQuadraticChargeUsesCKNTentExcess : Prop
  commutatorChargeUsesEndpointDefectMeasure : Prop
  noInvisibleProfileChargeUsesCompactnessObligation : Prop
  noSignedGlobalDefectSubstitution : Prop
  noDRPressureCarrierSubstitution : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Route-level payment from positive boundary-flux subadditivity.  This avoids
requiring an exact split of the positive boundary flux.
-/
theorem normalizedTransport_le_transport_plus_alternateCharges_of_boundaryFluxSubadditivity
    {transportReceipt : FreshFrequencyTransportLeakageReceipt}
    (h : LocalEnergyPositiveBoundaryFluxSubadditivitySource transportReceipt) :
    h.normalizedTransportLeakagePart ≤
      transportReceipt.transportLeakageCharge +
        h.commutatorCharge + h.localQuadraticCharge +
          h.noInvisibleProfileCharge := by
  have hpieces :
      h.visibleTransportFlux + h.pressureLocalQuadraticFluxCharge +
          h.commutatorFluxCharge + h.noInvisibleProfileCharge ≤
        transportReceipt.transportLeakageCharge +
          h.localQuadraticCharge + h.commutatorCharge +
            h.noInvisibleProfileCharge := by
    nlinarith [h.visibleTransportFlux_le_receiptCharge,
      h.pressureFluxCharge_le_localQuadraticCharge,
      h.commutatorFluxCharge_le_commutatorCharge]
  calc
    h.normalizedTransportLeakagePart ≤
        h.positiveBoundaryFluxCharge :=
      h.normalizedTransport_le_positiveBoundaryFlux
    _ ≤ h.visibleTransportFlux + h.pressureLocalQuadraticFluxCharge +
        h.commutatorFluxCharge + h.noInvisibleProfileCharge :=
      h.positiveBoundaryFlux_le_subadditivePieces
    _ ≤ transportReceipt.transportLeakageCharge +
        h.localQuadraticCharge + h.commutatorCharge +
          h.noInvisibleProfileCharge :=
      hpieces
    _ = transportReceipt.transportLeakageCharge +
        h.commutatorCharge + h.localQuadraticCharge +
          h.noInvisibleProfileCharge := by ring

/--
Borel-local measure version of the local-energy positive boundary-flux split.

This is stronger than the scalar route-total split above.  The fields are kept
as abstract event masses so this file does not depend on a particular signed
measure API; the mathematical source is a fixed local-energy signed-measure
identity plus positive-variation subadditivity.
-/
structure LocalEnergyPositiveBoundaryFluxMeasureSplitSource
    (Ω : Type u) where
  muA : Set Ω → Real
  nuvis : Set Ω → Real
  muI : Set Ω → Real
  measureDomination :
    ∀ E : Set Ω, muA E ≤ nuvis E + muI E
  residualMonotone :
    ∀ {E F : Set Ω}, E ⊆ F → muI E ≤ muI F
  fixedEventTentAndCutoff : Prop
  signedLocalEnergyMeasureIdentity : Prop
  positiveVariationSubadditivityUsed : Prop
  sameLocalEnergyCarrier : Prop
  residualMeasureIndependentlyGenerated : Prop
  noScalarOnlyRouteTotalSplit : Prop
  noFinalBudgetSlackDefinition : Prop

/--
Fixed-cutoff signed-measure identity source for the local-energy split.

The `alpha*` fields are the signed event-local pieces before positive
variation.  The `mu*` fields are the corresponding positive variations or
positive charges.  The real PDE work is to construct `signedIdentity` from the
fixed cutoff local-energy identity and to prove `positiveVariationDomination`
from the positive-variation theorem for that signed identity.
-/
structure FixedCutoffLocalEnergySignedMeasureIdentitySource
    (Ω : Type u) where
  alphaA : Set Ω → Real
  alphaT : Set Ω → Real
  alphaQP : Set Ω → Real
  alphaC : Set Ω → Real
  alphaI : Set Ω → Real
  muA : Set Ω → Real
  muT : Set Ω → Real
  muQP : Set Ω → Real
  muC : Set Ω → Real
  muI : Set Ω → Real
  fixedEventTentAndCutoff : Prop
  cutoffChosenBeforeRouteReceipt : Prop
  signedIdentity :
    ∀ E : Set Ω,
      alphaA E = alphaT E + alphaQP E + alphaC E + alphaI E
  activePositiveVariationOfAlphaA : Prop
  transportPositiveVariationOfAlphaT : Prop
  pressureQPPositiveVariationOfAlphaQP : Prop
  commutatorPositiveVariationOfAlphaC : Prop
  residualPositiveVariationOfAlphaI : Prop
  positiveVariationDomination :
    ∀ E : Set Ω, muA E ≤ muT E + muQP E + muC E + muI E
  residualMonotone :
    ∀ {E F : Set Ω}, E ⊆ F → muI E ≤ muI F
  activeMeasureUsesSameLocalEnergyCarrier : Prop
  residualMeasureIndependentlyGenerated : Prop
  noPostHocResidualChoice : Prop
  noFinalBudgetSlackDefinition : Prop
  noScalarOnlyRouteTotalSplit : Prop

/--
Suitable-local-energy source for the fixed signed event identity.

This is one layer below `FixedCutoffLocalEnergySignedMeasureIdentitySource`.
The local-energy inequality is allowed to have a defect, but that defect must
be a fixed event-local residual measure generated before positive variation is
taken.  It is not allowed to be final route slack renamed after the source
budget is known.
-/
structure SuitableLocalEnergyDefectMeasureSource
    (Ω : Type u) where
  alphaA : Set Ω → Real
  alphaT : Set Ω → Real
  alphaQP : Set Ω → Real
  alphaC : Set Ω → Real
  alphaI : Set Ω → Real
  muA : Set Ω → Real
  muT : Set Ω → Real
  muQP : Set Ω → Real
  muC : Set Ω → Real
  muI : Set Ω → Real
  fixedEventTentAndCutoff : Prop
  cutoffChosenBeforeRouteReceipt : Prop
  suitableLocalEnergyInequality :
    ∀ E : Set Ω,
      alphaA E ≤ alphaT E + alphaQP E + alphaC E + alphaI E
  defectClosesEventLocalIdentity :
    ∀ E : Set Ω,
      alphaA E = alphaT E + alphaQP E + alphaC E + alphaI E
  defectMeasureNonnegative :
    ∀ E : Set Ω, 0 ≤ alphaI E
  defectGeneratedBeforePositiveVariation : Prop
  defectIsLocalEnergyResidual : Prop
  defectMayIncludeCommutatorReynoldsResidual : Prop
  defectMayIncludeProfileCoherenceResidual : Prop
  activePositiveVariationOfAlphaA : Prop
  transportPositiveVariationOfAlphaT : Prop
  pressureQPPositiveVariationOfAlphaQP : Prop
  commutatorPositiveVariationOfAlphaC : Prop
  residualPositiveVariationOfAlphaI : Prop
  positiveVariationDomination :
    ∀ E : Set Ω, muA E ≤ muT E + muQP E + muC E + muI E
  residualMonotone :
    ∀ {E F : Set Ω}, E ⊆ F → muI E ≤ muI F
  activeMeasureUsesSameLocalEnergyCarrier : Prop
  residualMeasureIndependentlyGenerated : Prop
  noPostHocResidualChoice : Prop
  noFinalBudgetSlackDefinition : Prop
  noScalarOnlyRouteTotalSplit : Prop

/--
Source receipt for the standard signed-measure fact that the positive variation
of the active signed piece dominates the signed active measure on every event.
The base `SuitableLocalEnergyDefectMeasureSource` records positive-variation
provenance as Props; this structure is the numeric bridge needed when a later
route wants to spend an `alphaA` lower bound as `muA` currency.
-/
structure ActivePositiveVariationDominatesSignedActiveSource
    {Ω : Type u} (h : SuitableLocalEnergyDefectMeasureSource Ω) where
  sameActiveCarrier : h.activeMeasureUsesSameLocalEnergyCarrier
  activePositiveVariationReceipt : h.activePositiveVariationOfAlphaA
  alphaA_le_muA : ∀ E : Set Ω, h.alphaA E ≤ h.muA E
  bridgeFixedBeforePayoff : Prop
  bridgeFixedBeforePayoff_proof : bridgeFixedBeforePayoff

/-- Spend an active signed lower bound as active positive-variation currency. -/
theorem alphaA_le_muA_of_activePositiveVariationDominatesSignedActive
    {Ω : Type u} {h : SuitableLocalEnergyDefectMeasureSource Ω}
    (b : ActivePositiveVariationDominatesSignedActiveSource h)
    (E : Set Ω) :
    h.alphaA E ≤ h.muA E :=
  b.alphaA_le_muA E

/--
The suitable-local-energy defect source supplies the fixed-cutoff signed
identity consumed by the positive-variation source.
-/
def FixedCutoffLocalEnergySignedMeasureIdentitySource.ofSuitableLocalEnergyDefect
    {Ω : Type u}
    (h : SuitableLocalEnergyDefectMeasureSource Ω) :
    FixedCutoffLocalEnergySignedMeasureIdentitySource Ω where
  alphaA := h.alphaA
  alphaT := h.alphaT
  alphaQP := h.alphaQP
  alphaC := h.alphaC
  alphaI := h.alphaI
  muA := h.muA
  muT := h.muT
  muQP := h.muQP
  muC := h.muC
  muI := h.muI
  fixedEventTentAndCutoff := h.fixedEventTentAndCutoff
  cutoffChosenBeforeRouteReceipt := h.cutoffChosenBeforeRouteReceipt
  signedIdentity := h.defectClosesEventLocalIdentity
  activePositiveVariationOfAlphaA := h.activePositiveVariationOfAlphaA
  transportPositiveVariationOfAlphaT := h.transportPositiveVariationOfAlphaT
  pressureQPPositiveVariationOfAlphaQP :=
    h.pressureQPPositiveVariationOfAlphaQP
  commutatorPositiveVariationOfAlphaC :=
    h.commutatorPositiveVariationOfAlphaC
  residualPositiveVariationOfAlphaI := h.residualPositiveVariationOfAlphaI
  positiveVariationDomination := h.positiveVariationDomination
  residualMonotone := h.residualMonotone
  activeMeasureUsesSameLocalEnergyCarrier :=
    h.activeMeasureUsesSameLocalEnergyCarrier
  residualMeasureIndependentlyGenerated :=
    h.defectGeneratedBeforePositiveVariation ∧
      h.defectIsLocalEnergyResidual ∧
        h.residualMeasureIndependentlyGenerated
  noPostHocResidualChoice := h.noPostHocResidualChoice
  noFinalBudgetSlackDefinition := h.noFinalBudgetSlackDefinition
  noScalarOnlyRouteTotalSplit := h.noScalarOnlyRouteTotalSplit

/--
Guard: final route slack alone is not a source for the suitable-local-energy
defect measure.  The defect must be event-local and generated before positive
variation; a scalar budget remainder can match totals while failing the
per-event signed identity.
-/
structure FinalRouteSlackDoesNotSourceSuitableLocalEnergyDefect where
  Ω : Type u
  alphaA : Set Ω → Real
  alphaT : Set Ω → Real
  alphaQP : Set Ω → Real
  alphaC : Set Ω → Real
  finalRouteSlack : Real
  scalarSlackNonnegative : 0 ≤ finalRouteSlack
  witnessEvent : Set Ω
  eventIdentityFailure :
    ¬ alphaA witnessEvent =
      alphaT witnessEvent + alphaQP witnessEvent +
        alphaC witnessEvent + finalRouteSlack
  slackChosenAfterRouteSum : Prop
  noFixedEventLocalResidual : Prop

/--
Fresh event-local defect payment/no-reuse source.

Tick388 gives local measure domination.  Global route closure needs a separate
freshness theorem: selected active events must pay from fresh subregions of a
finite root budget, with lineage-level no-reuse and a monotone defect
reservoir.  Bounded Eulerian overlap by itself is not enough, because recurrent
coherent transport can revisit new-looking event tents while reusing the same
packet lineage.
-/
structure EventLocalDefectDropNoReuse
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  localEnergyMeasureSource :
    SuitableLocalEnergyDefectMeasureSource Ω
  omega : Set Ω → Real
  muT : Set Ω → Real
  muQP : Set Ω → Real
  muC : Set Ω → Real
  muI : Set Ω → Real
  omega_eq :
    ∀ E : Set Ω, omega E = muT E + muQP E + muC E + muI E
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  freshRegion : ι → Set Ω
  activeTail : ι → Real
  c : Real
  M : Real
  C : Real
  C0 : Real
  c_pos : 0 < c
  M_nonneg : 0 ≤ M
  C_nonneg : 0 ≤ C
  C0_nonneg : 0 ≤ C0
  omegaFixedBeforeEventSelection : Prop
  omegaPositiveSourceMeasure : Prop
  localActiveTailDomination :
    ∀ e : ι, e ∈ selectedEvents → activeTail e ≤ omega (eventTent e)
  freshRegion_subset_eventTent :
    ∀ e : ι, freshRegion e ⊆ eventTent e
  freshDefectPayment :
    ∀ e : ι, e ∈ selectedEvents → c * activeTail e ≤ omega (freshRegion e)
  freshRegionsBoundedOverlap : Prop
  overlapMultiplicityBound : Prop
  overlapMultiplicityIndependentOfPrefix : Prop
  lineageFreshness : Prop
  recurrentPacketReuseRejectedOrPaysRecharge : Prop
  finiteRootBudget : Prop
  rootBudgetBound : Prop
  monotoneDefectReservoir : Prop
  defectReservoirDrop : Prop
  rechargeErrorsSummable : Prop
  noPostHocFreshRegionChoice : Prop
  noReuseOfEventLocalDefectCharge : Prop
  eulerianOverlapAloneInsufficient : Prop
  noSummedVisibilityWithoutMultiplicityDiscount : Prop
  noFinalStrictGapDefinition : Prop
  eventTotalActiveTail : Real
  eventTotalActiveTail_eq :
    eventTotalActiveTail = selectedEvents.sum activeTail
  activeTailBoundConstant_eq : C = M / c
  producesGlobalActiveTailBound :
    eventTotalActiveTail ≤ C * C0

/--
The no-reuse source gives the finite selected-event active-tail bound.  This is
the global summability output; strict route closure still needs the scalar or
amortized route algebra to consume it.
-/
theorem globalActiveTailBound_of_EventLocalDefectDropNoReuse
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    (h : EventLocalDefectDropNoReuse Ω ι) :
    h.eventTotalActiveTail ≤ h.C * h.C0 :=
  h.producesGlobalActiveTailBound

/--
Lineage-fresh monotone reservoir source.

This is the non-smuggling object below `EventLocalDefectDropNoReuse`: active
tail is paid by fixed fresh regions, those regions are tied to event lineages
with bounded multiplicity, and a monotone reserve drops by the paid amount up
to a declared summable recharge/error term.  Without this object, same-tree
incidence and local measure domination can still reuse the same packet lineage.
-/
structure LineageFreshMonotoneReservoirSource
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  localEnergyMeasureSource :
    SuitableLocalEnergyDefectMeasureSource Ω
  omega : Set Ω → Real
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  freshRegion : ι → Set Ω
  activeTail : ι → Real
  eventSchedule : Nat → ι
  scheduleUsesSelectedEvents :
    ∀ n : Nat, eventSchedule n ∈ selectedEvents
  reserve : Nat → Real
  err : Nat → Real
  kappa : Real
  c : Real
  M : Real
  C0 : Real
  kappa_pos : 0 < kappa
  c_pos : 0 < c
  M_nonneg : 0 ≤ M
  C0_nonneg : 0 ≤ C0
  omegaFixedBeforeEventSelection : Prop
  omegaPositiveSourceMeasure : Prop
  freshRegion_subset_eventTent :
    ∀ e : ι, freshRegion e ⊆ eventTent e
  freshPayment :
    ∀ e : ι, e ∈ selectedEvents → c * activeTail e ≤ omega (freshRegion e)
  reserveDropWithRecharge :
    ∀ n : Nat,
      reserve (n + 1) ≤
        reserve n - kappa * omega (freshRegion (eventSchedule n)) + err n
  rechargeErrorsSummable : Prop
  lineageFreshness : Prop
  boundedLineageMultiplicity : Prop
  multiplicityIndependentOfPrefix : Prop
  finiteRootReserveBudget : reserve 0 ≤ C0
  recurrentPacketReuseRejectedOrPaysRecharge : Prop
  noPostHocFreshRegionChoice : Prop
  noFinalStrictGapDefinition : Prop
  producesNoReuse :
    EventLocalDefectDropNoReuse Ω ι

/-- Projection: a lineage-fresh monotone reservoir source supplies the generic
event-local no-reuse surface. -/
def EventLocalDefectDropNoReuse.ofLineageFreshMonotoneReservoirSource
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    (h : LineageFreshMonotoneReservoirSource Ω ι) :
    EventLocalDefectDropNoReuse Ω ι :=
  h.producesNoReuse

/--
Guard: a lineage reservoir source is stronger than bounded event overlap.

The false inference this blocks is: fixed local measure domination plus
bounded Eulerian overlap already gives a monotone reserve drop.  The drop has
to be supplied on packet/event lineages, including recharge/error bookkeeping.
-/
structure BoundedOverlapDoesNotSourceLineageReservoir
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  localEnergyMeasureSource :
    SuitableLocalEnergyDefectMeasureSource Ω
  boundedEulerianOverlap : Prop
  localEventMeasureDomination : Prop
  finiteRootMeasureBudget : Prop
  recurrentPacketLineageCanReuseEventSections : Prop
  monotoneReserveDropMissing : Prop
  rechargeErrorAccountingMissing : Prop
  noDirectLineageReservoirConclusion :
    ¬ Nonempty (LineageFreshMonotoneReservoirSource Ω ι)

/--
Noncircular frequency-localized Duhamel source for a lineage reservoir.

This source does not take `LineageFreshMonotoneReservoirSource` as an input.
It carries the raw event/lineage/cutoff/reserve fields plus the two PDE
conversion estimates that still have to be proved: active tail must be paid by
frequency-localized caloric dissipation, and that dissipation must be paid by a
monotone reserve drop plus Duhamel recharge/cutoff-error terms.
-/
structure FrequencyLocalizedDuhamelLineageReservoirSource
    (Ω : Type u) (ι : Type u) (τ : Type u) (Lineage : Type u)
    [DecidableEq ι] where
  localEnergyMeasureSource :
    SuitableLocalEnergyDefectMeasureSource Ω
  eventLedger : NS.EventRecurrencePriceLedger
  eventSectionIncidence :
    NS.EventSectionIncidenceReceipt eventLedger
  omega : Set Ω → Real
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  freshRegion : ι → Set Ω
  activeTail : ι → Real
  eventSchedule : Nat → ι
  scheduleUsesSelectedEvents :
    ∀ n : Nat, eventSchedule n ∈ selectedEvents
  lineageOfEvent : ι → Lineage
  frequency : Lineage → Real
  eventInterval : ι → Set τ
  caloricDissipation : ι → Real
  duhamelRecharge : Lineage → Nat → Real
  cutoffCommutatorError : Lineage → Nat → Real
  eventWeightedGainPriceOnLineage : Lineage → Nat → Real
  routedResidual : ι → Real
  pressureQPCharge : Real
  commutatorCharge : Real
  noInvisibleProfileCharge : Real
  reserve : Nat → Real
  err : Nat → Real
  kappa : Real
  c : Real
  M : Real
  C0 : Real
  eventPriceBudget : Real
  cutoffErrorBudget : Real
  kappa_pos : 0 < kappa
  c_pos : 0 < c
  M_nonneg : 0 ≤ M
  C0_nonneg : 0 ≤ C0
  omegaFixedBeforeEventSelection : Prop
  omegaPositiveSourceMeasure : Prop
  freshRegion_subset_eventTent :
    ∀ e : ι, freshRegion e ⊆ eventTent e
  activeTailPaidByCaloricDissipation :
    ∀ e : ι,
      e ∈ selectedEvents →
        activeTail e ≤ caloricDissipation e + routedResidual e
  freshPaymentFromCaloricDissipation :
    ∀ e : ι,
      e ∈ selectedEvents → c * activeTail e ≤ omega (freshRegion e)
  caloricDissipationPaidByReserveDropPlusRecharge :
    ∀ n : Nat,
      caloricDissipation (eventSchedule n) ≤
        reserve n - reserve (n + 1) +
          duhamelRecharge (lineageOfEvent (eventSchedule n)) n +
          cutoffCommutatorError (lineageOfEvent (eventSchedule n)) n
  reserveDropWithRecharge :
    ∀ n : Nat,
      reserve (n + 1) ≤
        reserve n - kappa * omega (freshRegion (eventSchedule n)) + err n
  rechargePaidByEventLedger :
    ∀ n : Nat,
      duhamelRecharge (lineageOfEvent (eventSchedule n)) n ≤
        eventWeightedGainPriceOnLineage (lineageOfEvent (eventSchedule n)) n
  eventLedgerBudgetFinite :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            eventWeightedGainPriceOnLineage
              (lineageOfEvent (eventSchedule n)) n)
          N ≤ eventPriceBudget
  cutoffErrorsSummable :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            cutoffCommutatorError (lineageOfEvent (eventSchedule n)) n)
          N ≤ cutoffErrorBudget
  routedResidualsPaidByOtherChannels :
    ∀ N : Nat,
      NS.nsPrefixSum (fun n : Nat => routedResidual (eventSchedule n)) N ≤
        pressureQPCharge + commutatorCharge + noInvisibleProfileCharge
  rechargeErrorsSummable : Prop
  lineageFreshness : Prop
  boundedLineageMultiplicity : Prop
  multiplicityIndependentOfPrefix : Prop
  finiteRootReserveBudget : reserve 0 ≤ C0
  recurrentPacketReuseRejectedOrPaysRecharge : Prop
  eventSectionIncidenceFeedsLineageMultiplicity :
    eventSectionIncidence.fixed_event_sections_before_payoff ∧
      eventSectionIncidence.overlap_tax_charged_before_payoff
  activeCarrierIsFrequencyLocalizedLocalEnergySource : Prop
  fixedBeforeRouteReceipt : Prop
  noPostHocFreshRegionChoice : Prop
  noPressureRieszFinalCarrierShortcut : Prop
  noDRFluxSubstitutionForCutoffFlux : Prop
  noFinalStrictGapDefinition : Prop
  producesNoReuse :
    EventLocalDefectDropNoReuse Ω ι

/--
The noncircular frequency-localized source constructs the abstract lineage
reservoir consumed by route-1 no-reuse.
-/
def LineageFreshMonotoneReservoirSource.ofFrequencyLocalizedDuhamelSource
    {Ω : Type u} {ι : Type u} {τ : Type u} {Lineage : Type u}
    [DecidableEq ι]
    (h :
      FrequencyLocalizedDuhamelLineageReservoirSource
        Ω ι τ Lineage) :
    LineageFreshMonotoneReservoirSource Ω ι where
  localEnergyMeasureSource := h.localEnergyMeasureSource
  omega := h.omega
  selectedEvents := h.selectedEvents
  eventTent := h.eventTent
  freshRegion := h.freshRegion
  activeTail := h.activeTail
  eventSchedule := h.eventSchedule
  scheduleUsesSelectedEvents := h.scheduleUsesSelectedEvents
  reserve := h.reserve
  err := h.err
  kappa := h.kappa
  c := h.c
  M := h.M
  C0 := h.C0
  kappa_pos := h.kappa_pos
  c_pos := h.c_pos
  M_nonneg := h.M_nonneg
  C0_nonneg := h.C0_nonneg
  omegaFixedBeforeEventSelection := h.omegaFixedBeforeEventSelection
  omegaPositiveSourceMeasure := h.omegaPositiveSourceMeasure
  freshRegion_subset_eventTent := h.freshRegion_subset_eventTent
  freshPayment := h.freshPaymentFromCaloricDissipation
  reserveDropWithRecharge := h.reserveDropWithRecharge
  rechargeErrorsSummable := h.rechargeErrorsSummable
  lineageFreshness := h.lineageFreshness
  boundedLineageMultiplicity := h.boundedLineageMultiplicity
  multiplicityIndependentOfPrefix := h.multiplicityIndependentOfPrefix
  finiteRootReserveBudget := h.finiteRootReserveBudget
  recurrentPacketReuseRejectedOrPaysRecharge :=
    h.recurrentPacketReuseRejectedOrPaysRecharge
  noPostHocFreshRegionChoice := h.noPostHocFreshRegionChoice
  noFinalStrictGapDefinition := h.noFinalStrictGapDefinition
  producesNoReuse := h.producesNoReuse

/--
Lower source for the caloric reserve-drop/recharge estimate.

The route-level reservoir source has a field
`caloricDissipationPaidByReserveDropPlusRecharge`.  This object lowers that
field to the frequency-localized energy estimate one expects from testing the
annular packet equation against the fixed cutoff packet:

* caloric dissipation is controlled by the annular frequency-energy
  dissipation;
* frequency-energy dissipation is controlled by localized energy drop,
  Duhamel work, and cutoff error;
* the localized drop is bounded by the named reserve drop;
* the Duhamel work and cutoff error are routed to the same-lineage recharge and
  cutoff-commutator ledgers.
-/
structure CaloricDissipationReserveDropRechargeSource
    (ι : Type u) (Lineage : Type u) where
  eventSchedule : Nat → ι
  lineageOfEvent : ι → Lineage
  caloricDissipation : ι → Real
  reserve : Nat → Real
  frequencyEnergyDissipation : Nat → Real
  localizedEnergyDrop : Nat → Real
  duhamelWork : Nat → Real
  cutoffError : Nat → Real
  duhamelRecharge : Lineage → Nat → Real
  cutoffCommutatorError : Lineage → Nat → Real
  annularFrequencyLock : Prop
  fixedCutoffScaleBounds : Prop
  frequencyLocalizedEquationTestedAgainstCutoffPacket : Prop
  localizedBernsteinOrAnnularCoercivity : Prop
  duhamelRechargeSameLineage : Prop
  cutoffErrorRoutedToCommutatorLedger : Prop
  noLowFrequencyLeakageInCaloricTerm : Prop
  noPostHocRechargeDefinition : Prop
  noFinalStrictGapDefinition : Prop
  caloric_le_frequencyEnergyDissipation :
    ∀ n : Nat,
      caloricDissipation (eventSchedule n) ≤
        frequencyEnergyDissipation n
  frequencyEnergyDissipation_le_drop_work_error :
    ∀ n : Nat,
      frequencyEnergyDissipation n ≤
        localizedEnergyDrop n + duhamelWork n + cutoffError n
  localizedEnergyDrop_le_reserveDrop :
    ∀ n : Nat,
      localizedEnergyDrop n ≤ reserve n - reserve (n + 1)
  duhamelWork_le_sameLineageRecharge :
    ∀ n : Nat,
      duhamelWork n ≤
        duhamelRecharge (lineageOfEvent (eventSchedule n)) n
  cutoffError_le_cutoffCommutator :
    ∀ n : Nat,
      cutoffError n ≤
        cutoffCommutatorError (lineageOfEvent (eventSchedule n)) n

/--
Projection: the lowered caloric source supplies the reserve-drop/recharge field
used by the lineage reservoir.
-/
theorem caloricDissipationPaidByReserveDropPlusRecharge_of_reserveDropSource
    {ι : Type u} {Lineage : Type u}
    (h : CaloricDissipationReserveDropRechargeSource ι Lineage) :
    ∀ n : Nat,
      h.caloricDissipation (h.eventSchedule n) ≤
        h.reserve n - h.reserve (n + 1) +
          h.duhamelRecharge (h.lineageOfEvent (h.eventSchedule n)) n +
          h.cutoffCommutatorError
            (h.lineageOfEvent (h.eventSchedule n)) n := by
  intro n
  have hcal := h.caloric_le_frequencyEnergyDissipation n
  have hfreq := h.frequencyEnergyDissipation_le_drop_work_error n
  have hdrop := h.localizedEnergyDrop_le_reserveDrop n
  have hrecharge := h.duhamelWork_le_sameLineageRecharge n
  have hcutoff := h.cutoffError_le_cutoffCommutator n
  nlinarith [hcal, hfreq, hdrop, hrecharge, hcutoff]

/--
Guard: the reserve-drop/recharge estimate is not available from a generic
event schedule.  It needs annular frequency coercivity, the fixed-cutoff
localized packet energy identity, same-lineage Duhamel recharge, and cutoff
error routing.
-/
structure CaloricDissipationReserveDropRechargeSourceGap
    (ι : Type u) (Lineage : Type u) where
  missingAnnularFrequencyLock : Prop
  missingFixedCutoffEnergyIdentity : Prop
  missingDuhamelRechargeIdentification : Prop
  missingCutoffCommutatorRouting : Prop
  lowFrequencyLeakCanCarryPacketEnergyWithoutLambdaDissipation : Prop
  cutoffErrorCanReenterActiveTailIfUnrouted : Prop
  rechargeMayBePostHocIfLineageNotFixed : Prop
  noReserveDropRechargeSource :
    ¬ Nonempty (CaloricDissipationReserveDropRechargeSource ι Lineage)

/--
Source object for the same-lineage recharge and cutoff-error budget fields.

The reservoir source has three ledger fields after the reserve-drop estimate:
recharge must be paid by the event ledger, the event-ledger prefixes must have
a finite budget, and cutoff commutator errors must have a finite prefix budget.
This source lowers those fields to fixed same-tree Duhamel price and cutoff
price ledgers.
-/
structure DuhamelRechargeEventLedgerAndCutoffBudgetSource
    (ι : Type u) (Lineage : Type u) where
  eventSchedule : Nat → ι
  lineageOfEvent : ι → Lineage
  duhamelRecharge : Lineage → Nat → Real
  eventWeightedGainPriceOnLineage : Lineage → Nat → Real
  cutoffCommutatorError : Lineage → Nat → Real
  sameTreeDuhamelPrice : Nat → Real
  cutoffErrorPrice : Nat → Real
  eventPriceBudget : Real
  cutoffErrorBudget : Real
  sameTreeSectionsFixedBeforeRecharge : Prop
  duhamelPriceDerivedFromForcingWork : Prop
  eventLedgerUsesSameLineageSections : Prop
  cutoffErrorLedgerUsesSameCutoffFamily : Prop
  noPostHocRechargeDefinition : Prop
  noCutoffErrorHiddenInActiveTail : Prop
  duhamelRecharge_le_sameTreeDuhamelPrice :
    ∀ n : Nat,
      duhamelRecharge (lineageOfEvent (eventSchedule n)) n ≤
        sameTreeDuhamelPrice n
  sameTreeDuhamelPrice_le_eventLedger :
    ∀ n : Nat,
      sameTreeDuhamelPrice n ≤
        eventWeightedGainPriceOnLineage
          (lineageOfEvent (eventSchedule n)) n
  eventLedgerBudgetFinite :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            eventWeightedGainPriceOnLineage
              (lineageOfEvent (eventSchedule n)) n)
          N ≤ eventPriceBudget
  cutoffCommutatorError_le_cutoffErrorPrice :
    ∀ n : Nat,
      cutoffCommutatorError (lineageOfEvent (eventSchedule n)) n ≤
        cutoffErrorPrice n
  cutoffErrorPriceBudgetFinite :
    ∀ N : Nat,
      NS.nsPrefixSum cutoffErrorPrice N ≤ cutoffErrorBudget

/-- The same-tree Duhamel price source supplies recharge payment by the event ledger. -/
theorem rechargePaidByEventLedger_of_rechargeCutoffBudgetSource
    {ι : Type u} {Lineage : Type u}
    (h : DuhamelRechargeEventLedgerAndCutoffBudgetSource ι Lineage) :
    ∀ n : Nat,
      h.duhamelRecharge (h.lineageOfEvent (h.eventSchedule n)) n ≤
        h.eventWeightedGainPriceOnLineage
          (h.lineageOfEvent (h.eventSchedule n)) n := by
  intro n
  have hduh := h.duhamelRecharge_le_sameTreeDuhamelPrice n
  have hledger := h.sameTreeDuhamelPrice_le_eventLedger n
  exact le_trans hduh hledger

/-- The source preserves the finite event-ledger prefix budget. -/
theorem eventLedgerBudgetFinite_of_rechargeCutoffBudgetSource
    {ι : Type u} {Lineage : Type u}
    (h : DuhamelRechargeEventLedgerAndCutoffBudgetSource ι Lineage) :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            h.eventWeightedGainPriceOnLineage
              (h.lineageOfEvent (h.eventSchedule n)) n)
          N ≤ h.eventPriceBudget :=
  h.eventLedgerBudgetFinite

/-- Cutoff commutator summability follows from pointwise cutoff-price payment. -/
theorem cutoffErrorsSummable_of_rechargeCutoffBudgetSource
    {ι : Type u} {Lineage : Type u}
    (h : DuhamelRechargeEventLedgerAndCutoffBudgetSource ι Lineage) :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            h.cutoffCommutatorError
              (h.lineageOfEvent (h.eventSchedule n)) n)
          N ≤ h.cutoffErrorBudget := by
  intro N
  have hprefix :
      NS.nsPrefixSum
          (fun n : Nat =>
            h.cutoffCommutatorError
              (h.lineageOfEvent (h.eventSchedule n)) n)
          N ≤ NS.nsPrefixSum h.cutoffErrorPrice N :=
    NS.ns_prefix_sum_le_of_pointwise
      (fun n : Nat =>
        h.cutoffCommutatorError
          (h.lineageOfEvent (h.eventSchedule n)) n)
      h.cutoffErrorPrice
      h.cutoffCommutatorError_le_cutoffErrorPrice
      N
  exact le_trans hprefix (h.cutoffErrorPriceBudgetFinite N)

/--
Guard: recharge and cutoff-budget fields are not sourced by same-tree labels
alone.  They need a same-lineage Duhamel price, an event-ledger comparison, and
a cutoff-error price with prefix control.
-/
structure DuhamelRechargeCutoffBudgetSourceGap
    (ι : Type u) (Lineage : Type u) where
  missingSameLineageDuhamelPrice : Prop
  missingEventLedgerComparison : Prop
  missingCutoffErrorPrice : Prop
  missingCutoffPrefixBudget : Prop
  sameTreeLabelWithoutPriceCanRepeatRecharge : Prop
  cutoffCommutatorCanAccumulateWithoutBudget : Prop
  noRechargeCutoffBudgetSource :
    ¬ Nonempty (DuhamelRechargeEventLedgerAndCutoffBudgetSource ι Lineage)

/--
Same-cutoff transport absorption target.

This is the analytic Young/Bernstein step in the GPT/Gowers proof route:
the physical transport flux through the fixed cutoff is absorbed into
frequency-localized caloric dissipation, with the overflow routed to the
local-quadratic residual and cutoff commutator error.
-/
structure SameCutoffTransportFluxAbsorption
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  transportFlux : ι → Real
  caloricDissipation : ι → Real
  localQuadraticResidual : ι → Real
  cutoffCommutatorError : ι → Real
  eps : Real
  Ceps : Real
  eps_nonneg : 0 ≤ eps
  Ceps_nonneg : 0 ≤ Ceps
  fixedCutoffCarrier : Prop
  cutoffScaleBounds : Prop
  annularFrequencyLock : Prop
  noDRFluxSubstitutionForCutoffFlux : Prop
  youngBernsteinAbsorption :
    ∀ e : ι,
      e ∈ selectedEvents →
        transportFlux e ≤
          eps * caloricDissipation e +
            Ceps * localQuadraticResidual e +
            cutoffCommutatorError e

/--
Lower source for `SameCutoffTransportFluxAbsorption`.

This separates the paper Young/Bernstein estimate into the three analytic
pieces that must be proved from the fixed cutoff and annular frequency lock:
same-cutoff transport is bounded by the raw interaction, the interaction is
split by Young into packet-scale energy plus local-quadratic overflow, and the
packet-scale term is absorbed by caloric dissipation with cutoff error.
-/
structure SameCutoffYoungBernsteinTransportSource
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  transportFlux : ι → Real
  caloricDissipation : ι → Real
  localQuadraticResidual : ι → Real
  cutoffCommutatorError : ι → Real
  rawTransportInteraction : ι → Real
  packetScaleEnergy : ι → Real
  localQuadraticOverflow : ι → Real
  cutoffTransportError : ι → Real
  eps : Real
  Ceps : Real
  eps_nonneg : 0 ≤ eps
  Ceps_nonneg : 0 ≤ Ceps
  fixedCutoffCarrier : Prop
  cutoffScaleBounds : Prop
  annularFrequencyLock : Prop
  sameCutoffFlux_le_rawInteraction :
    ∀ e : ι,
      e ∈ selectedEvents →
        transportFlux e ≤ rawTransportInteraction e
  youngSplit_rawInteraction :
    ∀ e : ι,
      e ∈ selectedEvents →
        rawTransportInteraction e ≤
          eps * packetScaleEnergy e +
            Ceps * localQuadraticOverflow e +
            cutoffTransportError e
  packetScaleAbsorbedByCaloric :
    ∀ e : ι,
      e ∈ selectedEvents →
        eps * packetScaleEnergy e + cutoffTransportError e ≤
          eps * caloricDissipation e + cutoffCommutatorError e
  localQuadraticOverflow_eq_residual :
    ∀ e : ι,
      e ∈ selectedEvents →
        localQuadraticOverflow e = localQuadraticResidual e
  noDRFluxSubstitutionForCutoffFlux : Prop
  noFinalCarrierMagnitudeShortcut : Prop

def SameCutoffTransportFluxAbsorption.ofYoungBernsteinTransportSource
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    (h : SameCutoffYoungBernsteinTransportSource Ω ι) :
    SameCutoffTransportFluxAbsorption Ω ι where
  selectedEvents := h.selectedEvents
  eventTent := h.eventTent
  transportFlux := h.transportFlux
  caloricDissipation := h.caloricDissipation
  localQuadraticResidual := h.localQuadraticResidual
  cutoffCommutatorError := h.cutoffCommutatorError
  eps := h.eps
  Ceps := h.Ceps
  eps_nonneg := h.eps_nonneg
  Ceps_nonneg := h.Ceps_nonneg
  fixedCutoffCarrier := h.fixedCutoffCarrier
  cutoffScaleBounds := h.cutoffScaleBounds
  annularFrequencyLock := h.annularFrequencyLock
  noDRFluxSubstitutionForCutoffFlux :=
    h.noDRFluxSubstitutionForCutoffFlux
  youngBernsteinAbsorption := by
    intro e he
    have hraw := h.sameCutoffFlux_le_rawInteraction e he
    have hyoung := h.youngSplit_rawInteraction e he
    have hpacket := h.packetScaleAbsorbedByCaloric e he
    have hover := h.localQuadraticOverflow_eq_residual e he
    rw [hover] at hyoung
    nlinarith [hraw, hyoung, hpacket]

/--
QP compatibility for the Young overflow term.

The same-cutoff transport absorption only names a local-quadratic overflow.  To
feed the active-tail route, the pressure/QP residual must explicitly contain
that overflow on the same event tent.
-/
structure LocalQuadraticOverflowQPResidualCompatibility
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  localQuadraticOverflow : ι → Real
  muQP : Set Ω → Real
  overflowNonnegative : ∀ e : ι, e ∈ selectedEvents → 0 ≤ localQuadraticOverflow e
  muQPContainsOverflow :
    ∀ e : ι,
      e ∈ selectedEvents →
        localQuadraticOverflow e ≤ muQP (eventTent e)
  sameEventTentAndCutoff : Prop
  pressureQPResidualPreSummed : Prop
  noFinalPressureCarrierDefinition : Prop

theorem localQuadraticResidual_le_muQP_of_overflowCompatibility
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    (hY : SameCutoffYoungBernsteinTransportSource Ω ι)
    (hQ : LocalQuadraticOverflowQPResidualCompatibility Ω ι)
    (hsEvents : hQ.selectedEvents = hY.selectedEvents)
    (hsTents : hQ.eventTent = hY.eventTent)
    (hsOverflow :
      hQ.localQuadraticOverflow = hY.localQuadraticOverflow)
    {muQP : Set Ω → Real}
    (hsMuQP : hQ.muQP = muQP) :
    ∀ e : ι,
      e ∈ hY.selectedEvents →
        hY.localQuadraticResidual e ≤ muQP (hY.eventTent e) := by
  intro e he
  have heQ : e ∈ hQ.selectedEvents := by
    simpa [hsEvents] using he
  have hcontains := hQ.muQPContainsOverflow e heQ
  have hover := hY.localQuadraticOverflow_eq_residual e he
  rw [hsOverflow] at hcontains
  simp [hsTents, hsMuQP, hover] at hcontains
  exact hcontains

/--
Guard: without QP overflow compatibility, the Young/Bernstein transport source
does not by itself feed the active-tail route.  The leftover
`localQuadraticOverflow` is then a real residual obligation, not a bookkeeping
detail.
-/
structure SameCutoffYoungBernsteinSourceWithoutQPCompatibilityGap
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  youngBernsteinSource : SameCutoffYoungBernsteinTransportSource Ω ι
  muQP : Set Ω → Real
  witnessEvent : ι
  witness_selected : witnessEvent ∈ youngBernsteinSource.selectedEvents
  overflowNotPaidByQP :
    ¬ youngBernsteinSource.localQuadraticOverflow witnessEvent ≤
      muQP (youngBernsteinSource.eventTent witnessEvent)
  cannotFeedActiveTailCompatibility :
    ¬ ∀ e : ι,
      e ∈ youngBernsteinSource.selectedEvents →
        youngBernsteinSource.localQuadraticResidual e ≤
          muQP (youngBernsteinSource.eventTent e)
  overflowMustBeResidualOrQPChannel : Prop

/--
First hard PDE sublemma target under the noncircular source.

The previous surface was too broad because it quantified over arbitrary
`activeTail`, `caloricDissipation`, and `routedResidual` functions.  This
version binds fixed same-carrier quantities: active tail is dominated by the
fixed active measure, the active measure is dominated by fixed positive
variation pieces, the same-cutoff transport piece is absorbed by caloric
dissipation plus local-quadratic overflow, and the overflow is routed to named
residual channels.
-/
structure ActiveTailPaidByCaloricDissipationOfSameTreeFreshFrequency
    (Ω : Type u) (ι : Type u) (τ : Type u) (Lineage : Type u)
    [DecidableEq ι]
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  activeTail : ι → Real
  muA : Set Ω → Real
  muT : Set Ω → Real
  muQP : Set Ω → Real
  muC : Set Ω → Real
  muI : Set Ω → Real
  routedResidual : ι → Real
  caloricDissipation : ι → Real
  sameTreeLock : ∀
    (hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta)
    (hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L),
    FreshFrequencyEventSameTreeLock
      seq K hRho hCarrier hBeta hEvents L hScale hInc → Prop
  transportAbsorption :
    SameCutoffTransportFluxAbsorption Ω ι
  transportAbsorption_uses_same_events :
    transportAbsorption.selectedEvents = selectedEvents
  transportAbsorption_uses_same_tents :
    transportAbsorption.eventTent = eventTent
  transportAbsorption_uses_same_caloric_dissipation :
    transportAbsorption.caloricDissipation = caloricDissipation
  fixedCutoffCarrier : Prop
  activeTailIsSameCarrierFrequencyLeakage : Prop
  activeTail_le_activeMeasure :
    ∀ e : ι, e ∈ selectedEvents → activeTail e ≤ muA (eventTent e)
  activeMeasurePositiveVariationDomination :
    ∀ e : ι,
      e ∈ selectedEvents →
        muA (eventTent e) ≤
          muT (eventTent e) + muQP (eventTent e) +
            muC (eventTent e) + muI (eventTent e)
  transportPiecePaidByAbsorption :
    ∀ e : ι,
      e ∈ selectedEvents →
        muT (eventTent e) ≤ transportAbsorption.transportFlux e
  localQuadraticResidual_le_muQP :
    ∀ e : ι,
      e ∈ selectedEvents →
        transportAbsorption.localQuadraticResidual e ≤ muQP (eventTent e)
  routedResidual_def :
    ∀ e : ι,
      e ∈ selectedEvents →
        routedResidual e =
          (transportAbsorption.Ceps + 1) * muQP (eventTent e) +
            muC (eventTent e) + muI (eventTent e) +
            transportAbsorption.cutoffCommutatorError e
  noPressureRieszFinalCarrierShortcut : Prop
  noDRFluxSubstitutionForCutoffFlux : Prop

/--
Once the fixed active measure, positive-variation source split, same-cutoff
transport absorption, and QP residual comparison are supplied, the active tail
is paid by caloric dissipation plus routed residual.  The analytic content is
not in this scalar proof; it is in `SameCutoffTransportFluxAbsorption`.
-/
theorem activeTailPaidByCaloricDissipation_of_sameCarrierTransportAbsorption
    {Ω : Type u} {ι : Type u} {τ : Type u} {Lineage : Type u}
    [DecidableEq ι]
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ActiveTailPaidByCaloricDissipationOfSameTreeFreshFrequency
        Ω ι τ Lineage seq K hRho hCarrier hBeta hEvents L) :
    ∀ e : ι,
      e ∈ h.selectedEvents →
        h.activeTail e ≤
          h.transportAbsorption.eps * h.caloricDissipation e +
            h.routedResidual e := by
  intro e he
  have he_transport : e ∈ h.transportAbsorption.selectedEvents := by
    simpa [h.transportAbsorption_uses_same_events] using he
  have htent :
      h.transportAbsorption.eventTent e = h.eventTent e := by
    simp [h.transportAbsorption_uses_same_tents]
  have hcal :
      h.transportAbsorption.caloricDissipation e =
        h.caloricDissipation e := by
    simp [h.transportAbsorption_uses_same_caloric_dissipation]
  have hactive := h.activeTail_le_activeMeasure e he
  have hmu := h.activeMeasurePositiveVariationDomination e he
  have hT := h.transportPiecePaidByAbsorption e he
  have habs :=
    h.transportAbsorption.youngBernsteinAbsorption e he_transport
  have hQ := h.localQuadraticResidual_le_muQP e he
  have hCnonneg :
      0 ≤ h.transportAbsorption.Ceps :=
    h.transportAbsorption.Ceps_nonneg
  have hQmul :
      h.transportAbsorption.Ceps *
          h.transportAbsorption.localQuadraticResidual e ≤
        h.transportAbsorption.Ceps * h.muQP (h.eventTent e) :=
    mul_le_mul_of_nonneg_left hQ hCnonneg
  have hroute := h.routedResidual_def e he
  have hchain :
      h.activeTail e ≤
        h.transportAbsorption.eps *
            h.transportAbsorption.caloricDissipation e +
          (h.transportAbsorption.Ceps + 1) * h.muQP (h.eventTent e) +
          h.muC (h.eventTent e) + h.muI (h.eventTent e) +
          h.transportAbsorption.cutoffCommutatorError e := by
    nlinarith [hactive, hmu, hT, habs, hQmul]
  rw [hcal] at hchain
  rw [hroute]
  nlinarith

/--
Frequency-localized Duhamel lineage reservoir estimate.

This is the PDE-native candidate below the abstract lineage reservoir.  The
carrier is a fixed frequency-localized caloric/Duhamel reserve on packet
lineages: active event tail is paid by same-lineage heat dissipation; heat
dissipation is paid by reserve drop plus Duhamel recharge and cutoff errors;
recharge is paid by the event ledger; residuals are routed to the existing
pressure/QP, commutator, and no-invisible channels.
-/
structure FrequencyLocalizedDuhamelLineageReservoirEstimate
    (Ω : Type u) (ι : Type u) (τ : Type u) (Lineage : Type u)
    [DecidableEq ι] where
  lineageReservoirSource :
    LineageFreshMonotoneReservoirSource Ω ι
  eventLedger : NS.EventRecurrencePriceLedger
  eventSectionIncidence :
    NS.EventSectionIncidenceReceipt eventLedger
  lineageOfEvent : ι → Lineage
  frequency : Lineage → Real
  eventInterval : ι → Set τ
  caloricDissipation : ι → Real
  localizedPacketEnergy : Lineage → τ → Real
  duhamelRecharge : Lineage → Nat → Real
  cutoffCommutatorError : Lineage → Nat → Real
  eventWeightedGainPriceOnLineage : Lineage → Nat → Real
  routedResidual : ι → Real
  pressureQPCharge : Real
  commutatorCharge : Real
  noInvisibleProfileCharge : Real
  eventPriceBudget : Real
  cutoffErrorBudget : Real
  C_A : Real
  C_D : Real
  C_R : Real
  C_A_nonneg : 0 ≤ C_A
  C_D_nonneg : 0 ≤ C_D
  C_R_nonneg : 0 ≤ C_R
  frequencyPositive :
    ∀ ℓ : Lineage, 0 < frequency ℓ
  localizedPacketEnergy_nonneg :
    ∀ ℓ t, 0 ≤ localizedPacketEnergy ℓ t
  caloricDissipation_nonneg :
    ∀ e : ι, 0 ≤ caloricDissipation e
  activeTailPaidByCaloricDissipation :
    ∀ e : ι,
      e ∈ lineageReservoirSource.selectedEvents →
        lineageReservoirSource.activeTail e ≤
          C_A * caloricDissipation e + routedResidual e
  freshOmegaPaidByCaloricDissipation :
    ∀ n : Nat,
      lineageReservoirSource.omega
          (lineageReservoirSource.freshRegion
            (lineageReservoirSource.eventSchedule n)) ≤
        C_D *
          caloricDissipation
            (lineageReservoirSource.eventSchedule n)
  caloricDissipationPaidByReserveDropPlusRecharge :
    ∀ n : Nat,
      C_D *
          caloricDissipation
            (lineageReservoirSource.eventSchedule n) ≤
        lineageReservoirSource.reserve n -
            lineageReservoirSource.reserve (n + 1) +
          duhamelRecharge
            (lineageOfEvent (lineageReservoirSource.eventSchedule n)) n +
          cutoffCommutatorError
            (lineageOfEvent (lineageReservoirSource.eventSchedule n)) n
  rechargePaidByEventLedger :
    ∀ n : Nat,
      duhamelRecharge
          (lineageOfEvent (lineageReservoirSource.eventSchedule n)) n ≤
        C_R *
          eventWeightedGainPriceOnLineage
            (lineageOfEvent (lineageReservoirSource.eventSchedule n)) n
  eventLedgerBudgetFinite :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            eventWeightedGainPriceOnLineage
              (lineageOfEvent (lineageReservoirSource.eventSchedule n)) n)
          N ≤ eventPriceBudget
  cutoffErrorsSummable :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            cutoffCommutatorError
              (lineageOfEvent (lineageReservoirSource.eventSchedule n)) n)
          N ≤ cutoffErrorBudget
  routedResidualsPaidByOtherChannels :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            routedResidual (lineageReservoirSource.eventSchedule n)) N ≤
        pressureQPCharge + commutatorCharge + noInvisibleProfileCharge
  eventSectionIncidenceFeedsLineageMultiplicity :
    eventSectionIncidence.fixed_event_sections_before_payoff ∧
      eventSectionIncidence.overlap_tax_charged_before_payoff
  boundedLineageMultiplicity : Prop
  activeCarrierIsFrequencyLocalizedLocalEnergySource : Prop
  fixedBeforeRouteReceipt : Prop
  noPressureRieszFinalCarrierShortcut : Prop
  noDRFluxSubstitutionForCutoffFlux : Prop
  noFinalRouteSlackDefinition : Prop
  producesLineageReservoir :
    LineageFreshMonotoneReservoirSource Ω ι
  producesLineageReservoir_eq :
    producesLineageReservoir = lineageReservoirSource

/-- Projection: the frequency-localized Duhamel reservoir estimate supplies the
abstract lineage reservoir source consumed by route-1 no-reuse. -/
def LineageFreshMonotoneReservoirSource.ofFrequencyLocalizedDuhamelEstimate
    {Ω : Type u} {ι : Type u} {τ : Type u} {Lineage : Type u}
    [DecidableEq ι]
    (h :
      FrequencyLocalizedDuhamelLineageReservoirEstimate
        Ω ι τ Lineage) :
    LineageFreshMonotoneReservoirSource Ω ι :=
  h.producesLineageReservoir

/--
Guard: event-section incidence and bounded fanout do not by themselves produce
the caloric/Duhamel reservoir estimate.

The missing field is the PDE identity that turns active same-cutoff event tail
into frequency-localized heat dissipation and then into a monotone reserve drop
plus Duhamel recharge/cutoff-error bookkeeping.
-/
structure SameTreeFanoutDoesNotSourceFrequencyDuhamelReservoir
    (Ω : Type u) (ι : Type u) (τ : Type u) (Lineage : Type u)
    [DecidableEq ι]
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  sameTreeIncidence :
    SameTreeNonadaptiveEventIncidenceCarleson
      seq K hRho hCarrier hBeta hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  eventSectionIncidence :
    NS.EventSectionIncidenceReceipt L
  missingActiveTailToCaloricDissipation : Prop
  missingCaloricDissipationToReserveDrop : Prop
  missingDuhamelRechargeToRouteOmega : Prop
  recurrentPacketReuseCanSurviveCombinatorialFanout : Prop
  noDirectFrequencyDuhamelReservoirConclusion :
    ¬ Nonempty
      (FrequencyLocalizedDuhamelLineageReservoirEstimate
        Ω ι τ Lineage)

/--
Same-tree incidence bridge for the no-reuse surface.

The graph-basin scan points back to the older same-tree/Duhamel event-budget
machinery.  This record is the intended adapter layer: it says exactly which
same-tree data would have to source the generic `EventLocalDefectDropNoReuse`
fields.  It is deliberately not a theorem from same-tree incidence alone; the
Duhamel reserve, pressure same-reserve compatibility, scale-limit persistence,
and lineage freshness remain explicit.
-/
structure SameTreeIncidenceLineageReservoirSource
    (Ω : Type u) (ι : Type u) [DecidableEq ι]
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  noReuse : EventLocalDefectDropNoReuse Ω ι
  sameTreeIncidence :
    SameTreeNonadaptiveEventIncidenceCarleson
      seq K hRho hCarrier hBeta hEvents L
  duhamelBudgetObligations :
    SameTreeDuhamelBudgetRemainingObligations
      seq K hRho hCarrier hBeta hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  lineageReservoirSource :
    LineageFreshMonotoneReservoirSource Ω ι
  sameTreeIncidence_from_duhamel :
    sameTreeIncidence =
      SameTreeDuhamelBudgetRemainingObligations.toSameTreeIncidence
        duhamelBudgetObligations
  selectedEventsUseSameBadCenterTree : Prop
  omegaIsSameTreeDuhamelReserve : Prop
  activeTailComparedToEventWeightedGainPrice : Prop
  freshRegionsAreLineageFreshEventSections : Prop
  pressureErrorsChargedToSameReserve :
    duhamelBudgetObligations.pressureErrorsChargedToSameReserve
  scaleLimitPersistence :
    duhamelBudgetObligations.survivesBadCenterScaleTruncationLimit
  prefixDominationSuppliesFreshPayment :
    duhamelBudgetObligations.eventPrefixesDominateBadCenterBetaSquareSums
  finiteSameTreeBudgetSuppliesRootBudget :
    sameTreeIncidence.finiteSameTreeEventBudget
  boundedFanoutSuppliesMultiplicity :
    boundedFanoutNoLogReuse.boundedFanoutPaysBetaSquareRadius
  boundedFanoutBlocksLogReuse :
    boundedFanoutNoLogReuse.noRepeatedDescendantCharging ∧
      boundedFanoutNoLogReuse.noSameScaleLogarithmicMultiplicityPerEvent
  lineageFreshnessSuppliesNoReuse : Prop
  lineageFreshnessFromReservoir :
    lineageReservoirSource.lineageFreshness
  monotoneDuhamelReserveSuppliesDefectDrop : Prop
  rechargeErrorsFromReservoir :
    lineageReservoirSource.rechargeErrorsSummable
  finiteRootReserveFromReservoir :
    lineageReservoirSource.reserve 0 ≤ lineageReservoirSource.C0
  recurrentReuseRejectedOrPaysRecharge : Prop
  singletonConstructorsAreAdapterOnly :
    SameTreeSingletonConstructorsAreAdapterOnly
      seq K hRho hCarrier hBeta hEvents L → Prop
  noEulerianOverlapOnlyClosure : Prop
  producesNoReuse :
    EventLocalDefectDropNoReuse Ω ι
  producesNoReuseFromReservoir :
    producesNoReuse =
      EventLocalDefectDropNoReuse.ofLineageFreshMonotoneReservoirSource
        lineageReservoirSource

/-- Projection: the same-tree lineage-reservoir source supplies the generic
event-local no-reuse surface. -/
def EventLocalDefectDropNoReuse.ofSameTreeIncidenceLineageReservoirSource
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      SameTreeIncidenceLineageReservoirSource
        Ω ι seq K hRho hCarrier hBeta hEvents L) :
    EventLocalDefectDropNoReuse Ω ι :=
  h.producesNoReuse

/--
Guard: same-tree incidence is not itself the lineage-fresh reservoir theorem.

It gives the right event family and finite-budget interface, but recurrent
reuse is still possible unless the source also supplies a monotone Duhamel
reserve drop, pressure/same-carrier compatibility, scale-limit persistence,
and lineage-level freshness.
-/
structure SameTreeIncidenceDoesNotAloneGiveLineageReservoir
    (Ω : Type u) (ι : Type u) [DecidableEq ι]
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  sameTreeIncidence :
    SameTreeNonadaptiveEventIncidenceCarleson
      seq K hRho hCarrier hBeta hEvents L
  localEnergyMeasureSource :
    SuitableLocalEnergyDefectMeasureSource Ω
  boundedEventOverlapAvailable : Prop
  finiteSameTreeBudgetAvailable :
    sameTreeIncidence.finiteSameTreeEventBudget
  lineageFreshnessMissing : Prop
  monotoneReserveDropMissing : Prop
  pressureSameReserveMayBeMissing : Prop
  recurrentPacketLineageCanReuseEventSections : Prop
  noDirectNoReuseConclusion :
    ¬ Nonempty (EventLocalDefectDropNoReuse Ω ι)

/--
Amortized route closure surface from fresh defect payment.

The reserve-drop field is the strictness source.  Local measure domination can
account for active flux, but only a fresh reserve drop can turn accounting into
amortized source-budget compression.
-/
structure Route1AmortizedStrictClosureFromDefectNoReuse
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  noReuse : EventLocalDefectDropNoReuse Ω ι
  rho : Real
  rho' : Real
  lambda : Real
  c : Real
  lambda_pos : 0 < lambda
  c_pos : 0 < c
  rho'_lt_rho : rho' < rho
  X : Nat → Real
  X_tail : Nat → Real
  X_res : Nat → Real
  S_aug : Nat → Real
  S_res : Nat → Real
  S_tail : Nat → Real
  reserve : Nat → Real
  augmentedPotential : Nat → Real
  reserve_nonneg : ∀ n : Nat, 0 ≤ reserve n
  reserveDrop :
    ∀ n : Nat, reserve (n + 1) ≤ reserve n - c * X_tail n
  lineageNoReuseDrivesReserveDrop : Prop
  rechargeErrorsAbsorbed : Prop
  resolvedStrict : Prop
  activeTailNonStrict : Prop
  augmentedPotential_eq :
    ∀ n : Nat, augmentedPotential n = X n + lambda * reserve n
  strictAugmentedStep :
    ∀ n : Nat, S_aug n ≤ rho' * augmentedPotential n

/--
Finite active-tail budget output.

This is the natural global output of the frequency/Duhamel reservoir ladder:
selected active tails are summable along the route schedule.  It is weaker
than a pointwise strict subratio and must be consumed by a separate recurrence
alternative saying that a genuine route-1 failure forces divergent active-tail
prefixes.
-/
structure Route1FiniteActiveTailBudget
    (ι : Type u) where
  activeTail : Nat → Real
  budget : Real
  budget_nonneg : 0 ≤ budget
  finiteActiveTailPrefixes :
    ∀ N : Nat, NS.nsPrefixSum activeTail N ≤ budget
  sourcedByLineageReservoir : Prop
  rechargeAndCutoffErrorsIncluded : Prop
  routedResidualsIncluded : Prop
  noPointwiseStrictSubratioClaim : Prop

/--
Finite active-tail budget sourced from the frequency-localized reservoir
pieces.

This is the summability bridge below the route-failure adapter.  It does not
claim pointwise strict subratio.  It only says that if active-tail prefixes are
paid by caloric dissipation plus routed residuals, caloric dissipation prefixes
are paid by root reserve plus recharge/cutoff budgets, and routed residuals
have their own budget, then active-tail prefixes have a finite budget.
-/
structure FrequencyLocalizedFiniteActiveTailBudgetSource where
  activeTail : Nat → Real
  caloricDissipationCharge : Nat → Real
  routedResidual : Nat → Real
  rootReserveBudget : Real
  eventPriceBudget : Real
  cutoffErrorBudget : Real
  residualBudget : Real
  totalBudget : Real
  totalBudget_nonneg : 0 ≤ totalBudget
  activeTailPrefix_le_caloric_plus_routed :
    ∀ N : Nat,
      NS.nsPrefixSum activeTail N ≤
        NS.nsPrefixSum caloricDissipationCharge N +
          NS.nsPrefixSum routedResidual N
  caloricPrefix_le_reserve_recharge_cutoff :
    ∀ N : Nat,
      NS.nsPrefixSum caloricDissipationCharge N ≤
        rootReserveBudget + eventPriceBudget + cutoffErrorBudget
  routedResidualPrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum routedResidual N ≤ residualBudget
  componentBudget_le_total :
    rootReserveBudget + eventPriceBudget + cutoffErrorBudget +
        residualBudget ≤ totalBudget
  activeTailToCaloricSourceAvailable : Prop
  reserveDropRechargeSourceAvailable : Prop
  rechargeCutoffBudgetSourceAvailable : Prop
  routedResidualBudgetSourceAvailable : Prop
  noPointwiseStrictSubratioClaim : Prop
  noRouteFailureDivergenceClaim : Prop

/-- The frequency-localized reservoir budget source supplies finite active-tail prefixes. -/
def Route1FiniteActiveTailBudget.ofFrequencyLocalizedBudgetSource
    (h : FrequencyLocalizedFiniteActiveTailBudgetSource) :
    Route1FiniteActiveTailBudget Nat where
  activeTail := h.activeTail
  budget := h.totalBudget
  budget_nonneg := h.totalBudget_nonneg
  finiteActiveTailPrefixes := by
    intro N
    have hactive := h.activeTailPrefix_le_caloric_plus_routed N
    have hcal := h.caloricPrefix_le_reserve_recharge_cutoff N
    have hres := h.routedResidualPrefixBudget N
    have htotal := h.componentBudget_le_total
    nlinarith [hactive, hcal, hres, htotal]
  sourcedByLineageReservoir := h.reserveDropRechargeSourceAvailable
  rechargeAndCutoffErrorsIncluded := h.rechargeCutoffBudgetSourceAvailable
  routedResidualsIncluded := h.routedResidualBudgetSourceAvailable
  noPointwiseStrictSubratioClaim := h.noPointwiseStrictSubratioClaim

/--
Guard: a finite active-tail budget is not the same as a pointwise strict
route-1 subratio.  It closes only failure alternatives that force divergent
active-tail prefixes.
-/
structure FrequencyBudgetDoesNotImplyPointwiseStrictSubratio where
  finiteBudget : FrequencyLocalizedFiniteActiveTailBudgetSource
  sourceCanHaveLargeSingleStepBeforeGlobalBudgetSpent : Prop
  strictSubratioNeedsSeparateScalarAdapter : Prop
  noPointwiseStrictSubratioFromFiniteBudgetAlone : Prop

/--
Prefix/amortized scalar adapter for the finite active-tail reservoir budget.

The finite active-tail budget does not produce pointwise strictness.  It
produces strictness on large prefixes once the non-strict tail carrier is
controlled by the same active-tail carrier.
-/
structure Route1FiniteTailAmortizedStrictness where
  X : Nat → Real
  S : Nat → Real
  Xtail : Nat → Real
  activeTail : Nat → Real
  rho : Real
  delta : Real
  CA : Real
  activeTailBudget : Real
  delta_pos : 0 < delta
  CA_nonneg : 0 ≤ CA
  activeTailBudget_nonneg : 0 ≤ activeTailBudget
  finiteActiveTailPrefixes :
    ∀ N : Nat, NS.nsPrefixSum activeTail N ≤ activeTailBudget
  prefixSourceBound :
    ∀ N : Nat,
      NS.nsPrefixSum S N ≤
        (rho - delta) * NS.nsPrefixSum X N +
          delta * NS.nsPrefixSum Xtail N
  sameCarrierTailControl :
    ∀ N : Nat,
      NS.nsPrefixSum Xtail N ≤
        CA * NS.nsPrefixSum activeTail N
  finiteBudgetSource :
    Route1FiniteActiveTailBudget Nat
  finiteBudgetSource_sameCarrier :
    finiteBudgetSource.activeTail = activeTail
  finiteBudgetSource_budget_matches :
    finiteBudgetSource.budget = activeTailBudget
  noPointwiseStrictSubratioClaim : Prop
  noUpstreamBranchExhaustionClaim : Prop

/--
Same-carrier tail control source for the finite-tail adapter.

This is the remaining carrier check after finite active-tail budget.  It must
not be instantiated with raw unresolved kinetic energy unless that raw tail has
already been identified with the active same-cutoff route-source carrier.
-/
structure SameCarrierRouteTailActiveTailControlSource where
  Xtail : Nat → Real
  activeTail : Nat → Real
  CA : Real
  CA_nonneg : 0 ≤ CA
  routeTailCarrierFixedBeforeActiveTail : Prop
  activeTailIsSameCutoffLocalEnergyCarrier : Prop
  tailCarrierNotRawUnresolvedEnergy : Prop
  noPostHocCarrierDefinition : Prop
  prefixTailControl :
    ∀ N : Nat,
      NS.nsPrefixSum Xtail N ≤ CA * NS.nsPrefixSum activeTail N

/--
Fresh-frequency square budget source for same-carrier tail control.

This is the bridge from shard-A tail-square bookkeeping into the finite
active-tail reservoir.  It keeps the fresh-frequency square budget and the
active local-energy source on the same event schedule before using the prefix
comparison required by the amortized route-1 adapter.
-/
structure FreshFrequencyTailSquareActiveTailSameCarrierSource where
  Xtail : Nat → Real
  tailSquareFunction : Nat → Real
  freshFrequencySquareBudget : Nat → Real
  activeTail : Nat → Real
  CA : Real
  CA_nonneg : 0 ≤ CA
  Xtail_eq_tailSquareFunction :
    Xtail = tailSquareFunction
  tailSquare_eq_freshFrequencySquareBudget :
    tailSquareFunction = freshFrequencySquareBudget
  eventScheduleFixedBeforeReceipt : Prop
  sameEventTentSchedule : Prop
  sameFreshFrequencyProjector : Prop
  sameLocalEnergyActiveSourceCarrier : Prop
  activeTailIsSameCutoffRouteSource : Prop
  noRawEnergyTailSubstitution : Prop
  noPostHocActiveTailDefinition : Prop
  noFinalRouteSlackDefinition : Prop
  prefixFreshSquare_le_activeTail :
    ∀ N : Nat,
      NS.nsPrefixSum freshFrequencySquareBudget N ≤
        CA * NS.nsPrefixSum activeTail N

/--
The fresh-frequency square/active-tail source supplies the same-carrier prefix
control required by finite-tail amortized strictness.
-/
def SameCarrierRouteTailActiveTailControlSource.ofTailSquareActiveTailSource
    (h : FreshFrequencyTailSquareActiveTailSameCarrierSource) :
    SameCarrierRouteTailActiveTailControlSource where
  Xtail := h.Xtail
  activeTail := h.activeTail
  CA := h.CA
  CA_nonneg := h.CA_nonneg
  routeTailCarrierFixedBeforeActiveTail :=
    h.eventScheduleFixedBeforeReceipt
  activeTailIsSameCutoffLocalEnergyCarrier :=
    h.activeTailIsSameCutoffRouteSource
  tailCarrierNotRawUnresolvedEnergy :=
    h.noRawEnergyTailSubstitution
  noPostHocCarrierDefinition :=
    h.noPostHocActiveTailDefinition
  prefixTailControl := by
    intro N
    simpa [h.Xtail_eq_tailSquareFunction,
      h.tailSquare_eq_freshFrequencySquareBudget] using
      h.prefixFreshSquare_le_activeTail N

/--
Broader same-carrier schedule source.

The finite-tail route adapter only needs a finite schedule that controls the
non-strict tail prefix.  That schedule may include active local-energy source
plus passive caloric persistence, Duhamel recharge, and cutoff/commutator
residuals.  This avoids forcing passive fresh-frequency square mass through
the narrower active-leakage carrier.
-/
structure SameCarrierRouteTailLineageScheduleControlSource where
  Xtail : Nat → Real
  lineageTailSchedule : Nat → Real
  C_schedule : Real
  C_schedule_nonneg : 0 ≤ C_schedule
  routeTailCarrierFixedBeforeSchedule : Prop
  scheduleUsesSameEventTentAndFrequency : Prop
  scheduleIncludesPassiveCaloricCharge : Prop
  scheduleIncludesDuhamelRecharge : Prop
  scheduleIncludesCutoffCommutatorResidual : Prop
  tailCarrierNotRawUnresolvedEnergy : Prop
  noPostHocScheduleDefinition : Prop
  prefixTailControl :
    ∀ N : Nat,
      NS.nsPrefixSum Xtail N ≤
        C_schedule * NS.nsPrefixSum lineageTailSchedule N

/--
The broader lineage schedule can feed the existing finite-tail adapter by using
the schedule as the controlled tail-payment sequence.
-/
def SameCarrierRouteTailActiveTailControlSource.ofLineageScheduleControlSource
    (h : SameCarrierRouteTailLineageScheduleControlSource) :
    SameCarrierRouteTailActiveTailControlSource where
  Xtail := h.Xtail
  activeTail := h.lineageTailSchedule
  CA := h.C_schedule
  CA_nonneg := h.C_schedule_nonneg
  routeTailCarrierFixedBeforeActiveTail :=
    h.routeTailCarrierFixedBeforeSchedule
  activeTailIsSameCutoffLocalEnergyCarrier :=
    h.scheduleUsesSameEventTentAndFrequency
  tailCarrierNotRawUnresolvedEnergy :=
    h.tailCarrierNotRawUnresolvedEnergy
  noPostHocCarrierDefinition :=
    h.noPostHocScheduleDefinition
  prefixTailControl :=
    h.prefixTailControl

/--
Fresh-frequency square budgets are controlled by a same-lineage schedule once
passive caloric persistence, Duhamel recharge, and cutoff/commutator residuals
are included as named charges.
-/
structure FreshFrequencyTailSquareLineageScheduleSource where
  Xtail : Nat → Real
  tailSquareFunction : Nat → Real
  freshFrequencySquareBudget : Nat → Real
  activeLocalEnergyTail : Nat → Real
  passiveCaloricCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  lineageTailSchedule : Nat → Real
  C_schedule : Real
  C_schedule_nonneg : 0 ≤ C_schedule
  Xtail_eq_tailSquareFunction :
    Xtail = tailSquareFunction
  tailSquare_eq_freshFrequencySquareBudget :
    tailSquareFunction = freshFrequencySquareBudget
  lineageTailSchedule_eq :
    lineageTailSchedule =
      fun n : Nat =>
        activeLocalEnergyTail n +
          passiveCaloricCharge n +
            duhamelRecharge n + cutoffCommutatorResidual n
  sameEventSchedule : Prop
  sameFreshFrequencyProjector : Prop
  passiveCaloricChargeFromFrequencyPersistence : Prop
  duhamelRechargeSameLineage : Prop
  cutoffResidualRouted : Prop
  noActiveOnlyTailPaymentClaim : Prop
  noPostHocScheduleDefinition : Prop
  prefixFreshSquare_le_lineageSchedule :
    ∀ N : Nat,
      NS.nsPrefixSum freshFrequencySquareBudget N ≤
        C_schedule * NS.nsPrefixSum lineageTailSchedule N

/-- Projection from the active-or-passive lineage schedule source to same-carrier control. -/
def SameCarrierRouteTailLineageScheduleControlSource.ofTailSquareLineageScheduleSource
    (h : FreshFrequencyTailSquareLineageScheduleSource) :
    SameCarrierRouteTailLineageScheduleControlSource where
  Xtail := h.Xtail
  lineageTailSchedule := h.lineageTailSchedule
  C_schedule := h.C_schedule
  C_schedule_nonneg := h.C_schedule_nonneg
  routeTailCarrierFixedBeforeSchedule :=
    h.sameEventSchedule
  scheduleUsesSameEventTentAndFrequency :=
    h.sameFreshFrequencyProjector
  scheduleIncludesPassiveCaloricCharge :=
    h.passiveCaloricChargeFromFrequencyPersistence
  scheduleIncludesDuhamelRecharge :=
    h.duhamelRechargeSameLineage
  scheduleIncludesCutoffCommutatorResidual :=
    h.cutoffResidualRouted
  tailCarrierNotRawUnresolvedEnergy :=
    h.noActiveOnlyTailPaymentClaim
  noPostHocScheduleDefinition :=
    h.noPostHocScheduleDefinition
  prefixTailControl := by
    intro N
    simpa [h.Xtail_eq_tailSquareFunction,
      h.tailSquare_eq_freshFrequencySquareBudget] using
      h.prefixFreshSquare_le_lineageSchedule N

/--
Finite prefix budget for the active-or-passive lineage schedule.

This is the scalar consumer of the PDE persistence/reserve work: once the
schedule is finite, it can replace the narrower active-tail sequence in the
finite-tail strictness adapter.
-/
structure LineageTailScheduleFiniteBudgetSource where
  lineageTailSchedule : Nat → Real
  scheduleBudget : Real
  scheduleBudget_nonneg : 0 ≤ scheduleBudget
  finiteLineageSchedulePrefixes :
    ∀ N : Nat,
      NS.nsPrefixSum lineageTailSchedule N ≤ scheduleBudget
  activeSourceBudgetIncluded : Prop
  passiveCaloricPersistenceBudgetIncluded : Prop
  duhamelRechargeBudgetIncluded : Prop
  cutoffCommutatorBudgetIncluded : Prop
  noPersistenceEstimateClaim : Prop
  noUpstreamBranchClosureClaim : Prop

/--
Component-level prefix budget for the active-or-passive lineage schedule.

This records the N2 node of the route-1 DAG: the schedule is finite only when
the active source, passive caloric persistence, Duhamel recharge,
cutoff/commutator residual, and routed residual components each have a finite
prefix budget or a shared reservoir budget.
-/
structure LineageSchedulePrefixBudgetSource where
  activeLocalEnergyTail : Nat → Real
  passiveCaloricCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  routedResidual : Nat → Real
  lineageTailSchedule : Nat → Real
  activeBudget : Real
  passiveCaloricBudget : Real
  duhamelRechargeBudget : Real
  cutoffResidualBudget : Real
  routedResidualBudget : Real
  scheduleBudget : Real
  scheduleBudget_nonneg : 0 ≤ scheduleBudget
  lineageTailSchedule_eq :
    lineageTailSchedule =
      fun n : Nat =>
        activeLocalEnergyTail n +
          passiveCaloricCharge n +
            duhamelRecharge n +
              cutoffCommutatorResidual n + routedResidual n
  scheduleBudget_eq :
    scheduleBudget =
      activeBudget + passiveCaloricBudget + duhamelRechargeBudget +
        cutoffResidualBudget + routedResidualBudget
  activePrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum activeLocalEnergyTail N ≤ activeBudget
  passiveCaloricPrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum passiveCaloricCharge N ≤ passiveCaloricBudget
  duhamelRechargePrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum duhamelRecharge N ≤ duhamelRechargeBudget
  cutoffResidualPrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum cutoffCommutatorResidual N ≤ cutoffResidualBudget
  routedResidualPrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum routedResidual N ≤ routedResidualBudget
  schedulePrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum lineageTailSchedule N ≤ scheduleBudget
  reservoirTelescopingSource : Prop
  boundedLineageMultiplicity : Prop
  noReuseOfCaloricReserve : Prop
  noRawTailSquareBudgetClaim : Prop
  noUpstreamBranchClosureClaim : Prop

/-- Component-level schedule budget supplies the finite lineage-schedule budget. -/
def LineageTailScheduleFiniteBudgetSource.ofPrefixBudgetSource
    (h : LineageSchedulePrefixBudgetSource) :
    LineageTailScheduleFiniteBudgetSource where
  lineageTailSchedule := h.lineageTailSchedule
  scheduleBudget := h.scheduleBudget
  scheduleBudget_nonneg := h.scheduleBudget_nonneg
  finiteLineageSchedulePrefixes := h.schedulePrefixBudget
  activeSourceBudgetIncluded :=
    True
  passiveCaloricPersistenceBudgetIncluded :=
    h.reservoirTelescopingSource
  duhamelRechargeBudgetIncluded :=
    True
  cutoffCommutatorBudgetIncluded :=
    True
  noPersistenceEstimateClaim :=
    h.noRawTailSquareBudgetClaim
  noUpstreamBranchClosureClaim :=
    h.noUpstreamBranchClosureClaim

private lemma nsPrefixSum_five_components
    (a b c d e : Nat → Real) :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat => a n + b n + c n + d n + e n) N =
        NS.nsPrefixSum (fun n : Nat => a n + b n) N +
          NS.nsPrefixSum c N +
            NS.nsPrefixSum d N + NS.nsPrefixSum e N := by
  intro N
  induction N with
  | zero =>
      simp [NS.nsPrefixSum]
  | succ N ih =>
      rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ,
        NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ,
        NS.ns_prefix_sum_succ, ih]
      ring

/--
Lower N2 budget source that derives the finite schedule prefix from an
aggregate component budget inequality.  The analytic/combinatorial work is in
the aggregate estimate: root reserve, same-lineage event prices,
cutoff/commutator budget, and routed residuals must already be combined without
double counting.
-/
structure LineageScheduleAggregateBudgetSource where
  lineageTailSchedule : Nat → Real
  activeLocalEnergyTail : Nat → Real
  passiveCaloricCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  routedResidual : Nat → Real
  scheduleBudget : Real
  scheduleBudget_nonneg : 0 ≤ scheduleBudget
  componentCharge : Nat → Real
  componentCharge_eq :
    componentCharge =
      fun n : Nat =>
        activeLocalEnergyTail n +
          passiveCaloricCharge n +
            duhamelRecharge n +
              cutoffCommutatorResidual n + routedResidual n
  lineageTailSchedule_le_componentCharge :
    ∀ N : Nat,
      NS.nsPrefixSum lineageTailSchedule N ≤
        NS.nsPrefixSum componentCharge N
  componentPrefix_le_scheduleBudget :
    ∀ N : Nat,
      NS.nsPrefixSum componentCharge N ≤ scheduleBudget
  rootReserveBudgetIncluded : Prop
  sameLineageEventPriceBudgetIncluded : Prop
  cutoffCommutatorBudgetIncluded : Prop
  routedResidualBudgetIncluded : Prop
  boundedLineageMultiplicityNumeric : Prop
  noDoubleCountingBetweenComponents : Prop
  noPostHocScheduleDefinition : Prop
  noPersistenceEstimateClaim : Prop
  noUpstreamBranchClosureClaim : Prop

/--
Concrete N2 source after the sidecar audit.

This is below `LineageScheduleAggregateBudgetSource`: the finite schedule is
paid by a combined active/passive root-reserve budget, a same-lineage event
price budget for Duhamel recharge, a cutoff-error budget, and an independently
budgeted routed residual.  Active and passive charges are deliberately bundled
into one root-reserve bound so the same caloric reserve cannot be spent twice.
-/
structure LineageScheduleConcreteAggregateBudgetSource where
  lineageTailSchedule : Nat → Real
  activeLocalEnergyTail : Nat → Real
  passiveCaloricCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  routedResidual : Nat → Real
  rootReserveBudget : Real
  eventPriceBudget : Real
  cutoffErrorBudget : Real
  routedResidualBudget : Real
  scheduleBudget : Real
  scheduleBudget_nonneg : 0 ≤ scheduleBudget
  M_lineage : Real
  activePassivePrefix_le_rootReserve :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat => activeLocalEnergyTail n + passiveCaloricCharge n) N ≤
        rootReserveBudget
  duhamelPrefix_le_eventBudget :
    ∀ N : Nat,
      NS.nsPrefixSum duhamelRecharge N ≤ M_lineage * eventPriceBudget
  cutoffPrefix_le_cutoffBudget :
    ∀ N : Nat,
      NS.nsPrefixSum cutoffCommutatorResidual N ≤
        M_lineage * cutoffErrorBudget
  routedResidualPrefix_le_budget :
    ∀ N : Nat,
      NS.nsPrefixSum routedResidual N ≤ routedResidualBudget
  aggregateBudget_le_scheduleBudget :
    rootReserveBudget + M_lineage * eventPriceBudget +
        M_lineage * cutoffErrorBudget + routedResidualBudget ≤
      scheduleBudget
  lineageTailSchedule_le_components :
    ∀ N : Nat,
      NS.nsPrefixSum lineageTailSchedule N ≤
        NS.nsPrefixSum
          (fun n : Nat =>
            activeLocalEnergyTail n +
              passiveCaloricCharge n +
                duhamelRecharge n +
                  cutoffCommutatorResidual n + routedResidual n) N
  activePassiveShareRootReserveNoDoubleCount : Prop
  duhamelRechargeBookedOnlyInEventPriceBudget : Prop
  cutoffResidualBookedOnlyInCutoffBudget : Prop
  routedResidualExcludesNamedComponents : Prop
  boundedLineageMultiplicityNumeric : Prop
  noPostHocScheduleDefinition : Prop
  noPersistenceEstimateClaim : Prop
  noUpstreamBranchClosureClaim : Prop

/-- Concrete component budgets supply the aggregate N2 budget source. -/
def LineageScheduleAggregateBudgetSource.ofConcreteAggregateBudgetSource
    (h : LineageScheduleConcreteAggregateBudgetSource) :
    LineageScheduleAggregateBudgetSource where
  lineageTailSchedule := h.lineageTailSchedule
  activeLocalEnergyTail := h.activeLocalEnergyTail
  passiveCaloricCharge := h.passiveCaloricCharge
  duhamelRecharge := h.duhamelRecharge
  cutoffCommutatorResidual := h.cutoffCommutatorResidual
  routedResidual := h.routedResidual
  scheduleBudget := h.scheduleBudget
  scheduleBudget_nonneg := h.scheduleBudget_nonneg
  componentCharge :=
    fun n : Nat =>
      h.activeLocalEnergyTail n +
        h.passiveCaloricCharge n +
          h.duhamelRecharge n +
            h.cutoffCommutatorResidual n + h.routedResidual n
  componentCharge_eq := rfl
  lineageTailSchedule_le_componentCharge :=
    h.lineageTailSchedule_le_components
  componentPrefix_le_scheduleBudget := by
    intro N
    have hsum :=
      nsPrefixSum_five_components
        h.activeLocalEnergyTail h.passiveCaloricCharge h.duhamelRecharge
        h.cutoffCommutatorResidual h.routedResidual N
    have hactive := h.activePassivePrefix_le_rootReserve N
    have hduh := h.duhamelPrefix_le_eventBudget N
    have hcut := h.cutoffPrefix_le_cutoffBudget N
    have hres := h.routedResidualPrefix_le_budget N
    nlinarith [hsum, hactive, hduh, hcut, hres,
      h.aggregateBudget_le_scheduleBudget]
  rootReserveBudgetIncluded :=
    h.activePassiveShareRootReserveNoDoubleCount
  sameLineageEventPriceBudgetIncluded :=
    h.duhamelRechargeBookedOnlyInEventPriceBudget
  cutoffCommutatorBudgetIncluded :=
    h.cutoffResidualBookedOnlyInCutoffBudget
  routedResidualBudgetIncluded :=
    h.routedResidualExcludesNamedComponents
  boundedLineageMultiplicityNumeric :=
    h.boundedLineageMultiplicityNumeric
  noDoubleCountingBetweenComponents :=
    h.activePassiveShareRootReserveNoDoubleCount ∧
      h.duhamelRechargeBookedOnlyInEventPriceBudget ∧
        h.cutoffResidualBookedOnlyInCutoffBudget ∧
          h.routedResidualExcludesNamedComponents
  noPostHocScheduleDefinition := h.noPostHocScheduleDefinition
  noPersistenceEstimateClaim := h.noPersistenceEstimateClaim
  noUpstreamBranchClosureClaim := h.noUpstreamBranchClosureClaim

/-- Aggregate component budget supplies the finite lineage schedule budget. -/
def LineageTailScheduleFiniteBudgetSource.ofAggregateBudgetSource
    (h : LineageScheduleAggregateBudgetSource) :
    LineageTailScheduleFiniteBudgetSource where
  lineageTailSchedule := h.lineageTailSchedule
  scheduleBudget := h.scheduleBudget
  scheduleBudget_nonneg := h.scheduleBudget_nonneg
  finiteLineageSchedulePrefixes := by
    intro N
    exact le_trans
      (h.lineageTailSchedule_le_componentCharge N)
      (h.componentPrefix_le_scheduleBudget N)
  activeSourceBudgetIncluded :=
    h.rootReserveBudgetIncluded
  passiveCaloricPersistenceBudgetIncluded :=
    h.rootReserveBudgetIncluded
  duhamelRechargeBudgetIncluded :=
    h.sameLineageEventPriceBudgetIncluded
  cutoffCommutatorBudgetIncluded :=
    h.cutoffCommutatorBudgetIncluded
  noPersistenceEstimateClaim :=
    h.noPersistenceEstimateClaim
  noUpstreamBranchClosureClaim :=
    h.noUpstreamBranchClosureClaim

/-- A finite lineage schedule is a finite tail-payment budget for the scalar adapter. -/
def Route1FiniteActiveTailBudget.ofLineageScheduleFiniteBudgetSource
    (h : LineageTailScheduleFiniteBudgetSource) :
    Route1FiniteActiveTailBudget Nat where
  activeTail := h.lineageTailSchedule
  budget := h.scheduleBudget
  budget_nonneg := h.scheduleBudget_nonneg
  finiteActiveTailPrefixes := h.finiteLineageSchedulePrefixes
  sourcedByLineageReservoir :=
    h.passiveCaloricPersistenceBudgetIncluded
  rechargeAndCutoffErrorsIncluded :=
    h.duhamelRechargeBudgetIncluded ∧ h.cutoffCommutatorBudgetIncluded
  routedResidualsIncluded :=
    h.activeSourceBudgetIncluded
  noPointwiseStrictSubratioClaim :=
    h.noPersistenceEstimateClaim

/--
Analytic source target for passive fresh-frequency square mass.

The key estimate is a frequency-localized persistence inequality: pointwise or
time-window tail square is paid by caloric dissipation, same-lineage Duhamel
recharge, and cutoff/commutator error.  Prefix finiteness then follows from the
already separated reservoir/recharge ledgers.
-/
structure FreshFrequencyTailSquarePersistenceSource where
  tailSquareFunction : Nat → Real
  caloricDissipationCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  C_persist : Real
  C_persist_nonneg : 0 ≤ C_persist
  eventIntervalsParabolicScaleLocked : Prop
  annularFreshFrequencyLock : Prop
  fixedCutoffFrequencyEnergyIdentity : Prop
  persistenceEstimate :
    ∀ N : Nat,
      NS.nsPrefixSum tailSquareFunction N ≤
        C_persist *
          NS.nsPrefixSum
            (fun n : Nat =>
              caloricDissipationCharge n +
                duhamelRecharge n + cutoffCommutatorResidual n) N
  noActiveLeakageOnlyClaim : Prop

/--
Lower N1 source for fresh-frequency persistence.

This is the analytic hypothesis below `FreshFrequencyTailSquarePersistenceSource`:
the actual tail-square packet must be the same fixed-cutoff annular lineage
packet appearing in the frequency energy inequality.  Inherited packet energy,
Duhamel forcing, and cutoff/projection commutators must be explicitly charged.
-/
structure FixedCutoffAnnularPacketEnergyPersistenceSource where
  tailSquareFunction : Nat → Real
  caloricDissipationCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  C_persist : Real
  C_persist_nonneg : 0 ≤ C_persist
  sameLineagePacket : Prop
  tailSquareIsSameLocalizedAnnularPacket : Prop
  eventIntervalsParabolicScaleLocked : Prop
  eventTimeInsideControlledInterval : Prop
  localizedAnnularCoercivity : Prop
  fixedCutoffFrequencyEnergyInequality : Prop
  duhamelForcingBookedSameLineage : Prop
  cutoffProjectionErrorsRouted : Prop
  noInheritedPacketEnergyUnlessCharged : Prop
  pointwiseOrAveragedTailTrace :
    ∀ N : Nat,
      NS.nsPrefixSum tailSquareFunction N ≤
        C_persist *
          NS.nsPrefixSum
            (fun n : Nat =>
              caloricDissipationCharge n +
                duhamelRecharge n + cutoffCommutatorResidual n) N
  noRawUnresolvedEnergyTail : Prop

/--
Easy branch of N1: the route tail square is already a parabolic-window
average of the fixed-cutoff annular packet energy.  Then persistence is just
the definition plus the annular caloric charge comparison.
-/
structure AveragedFixedCutoffAnnularPacketPersistenceSource where
  tailSquareFunction : Nat → Real
  caloricDissipationCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  C_persist : Real
  C_persist_nonneg : 0 ≤ C_persist
  sameLineagePacket : Prop
  tailSquareIsWindowAveragedLocalizedAnnularPacket : Prop
  eventIntervalsParabolicScaleLocked : Prop
  localizedAnnularCoercivity : Prop
  fixedCutoffFrequencyEnergyInequality : Prop
  duhamelForcingBookedSameLineage : Prop
  cutoffProjectionErrorsRouted : Prop
  averagedTailSquare_le_caloricWindowCharge :
    ∀ N : Nat,
      NS.nsPrefixSum tailSquareFunction N ≤
        C_persist *
          NS.nsPrefixSum
            (fun n : Nat =>
              caloricDissipationCharge n +
                duhamelRecharge n + cutoffCommutatorResidual n) N
  noPointwiseTraceClaim : Prop
  noRawUnresolvedEnergyTail : Prop

/--
Hard branch of N1: the route tail square is a time-slice or supremum value.
This needs a parabolic trace/persistence estimate from the localized frequency
energy inequality; without it, the route can hide inherited packet energy in a
single time slice.
-/
structure PointwiseFixedCutoffAnnularPacketTraceSource where
  tailSquareFunction : Nat → Real
  caloricDissipationCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  C_persist : Real
  C_persist_nonneg : 0 ≤ C_persist
  sameLineagePacket : Prop
  tailSquareIsEventTimeOrSupLocalizedAnnularPacket : Prop
  eventIntervalsParabolicScaleLocked : Prop
  eventTimeInsideControlledInterval : Prop
  localizedAnnularCoercivity : Prop
  fixedCutoffFrequencyEnergyInequality : Prop
  duhamelForcingBookedSameLineage : Prop
  cutoffProjectionErrorsRouted : Prop
  noInheritedPacketEnergyUnlessCharged : Prop
  parabolicTraceFromFrequencyEnergyInequality :
    ∀ N : Nat,
      NS.nsPrefixSum tailSquareFunction N ≤
        C_persist *
          NS.nsPrefixSum
            (fun n : Nat =>
              caloricDissipationCharge n +
                duhamelRecharge n + cutoffCommutatorResidual n) N
  noRawUnresolvedEnergyTail : Prop

/-- Window-averaged packet persistence supplies the fixed-cutoff annular source. -/
def FixedCutoffAnnularPacketEnergyPersistenceSource.ofAveragedPacket
    (h : AveragedFixedCutoffAnnularPacketPersistenceSource) :
    FixedCutoffAnnularPacketEnergyPersistenceSource where
  tailSquareFunction := h.tailSquareFunction
  caloricDissipationCharge := h.caloricDissipationCharge
  duhamelRecharge := h.duhamelRecharge
  cutoffCommutatorResidual := h.cutoffCommutatorResidual
  C_persist := h.C_persist
  C_persist_nonneg := h.C_persist_nonneg
  sameLineagePacket := h.sameLineagePacket
  tailSquareIsSameLocalizedAnnularPacket :=
    h.tailSquareIsWindowAveragedLocalizedAnnularPacket
  eventIntervalsParabolicScaleLocked := h.eventIntervalsParabolicScaleLocked
  eventTimeInsideControlledInterval := True
  localizedAnnularCoercivity := h.localizedAnnularCoercivity
  fixedCutoffFrequencyEnergyInequality :=
    h.fixedCutoffFrequencyEnergyInequality
  duhamelForcingBookedSameLineage := h.duhamelForcingBookedSameLineage
  cutoffProjectionErrorsRouted := h.cutoffProjectionErrorsRouted
  noInheritedPacketEnergyUnlessCharged :=
    h.noPointwiseTraceClaim
  pointwiseOrAveragedTailTrace :=
    h.averagedTailSquare_le_caloricWindowCharge
  noRawUnresolvedEnergyTail := h.noRawUnresolvedEnergyTail

/-- Pointwise/sup packet trace persistence supplies the fixed-cutoff annular source. -/
def FixedCutoffAnnularPacketEnergyPersistenceSource.ofPointwiseTrace
    (h : PointwiseFixedCutoffAnnularPacketTraceSource) :
    FixedCutoffAnnularPacketEnergyPersistenceSource where
  tailSquareFunction := h.tailSquareFunction
  caloricDissipationCharge := h.caloricDissipationCharge
  duhamelRecharge := h.duhamelRecharge
  cutoffCommutatorResidual := h.cutoffCommutatorResidual
  C_persist := h.C_persist
  C_persist_nonneg := h.C_persist_nonneg
  sameLineagePacket := h.sameLineagePacket
  tailSquareIsSameLocalizedAnnularPacket :=
    h.tailSquareIsEventTimeOrSupLocalizedAnnularPacket
  eventIntervalsParabolicScaleLocked := h.eventIntervalsParabolicScaleLocked
  eventTimeInsideControlledInterval := h.eventTimeInsideControlledInterval
  localizedAnnularCoercivity := h.localizedAnnularCoercivity
  fixedCutoffFrequencyEnergyInequality :=
    h.fixedCutoffFrequencyEnergyInequality
  duhamelForcingBookedSameLineage := h.duhamelForcingBookedSameLineage
  cutoffProjectionErrorsRouted := h.cutoffProjectionErrorsRouted
  noInheritedPacketEnergyUnlessCharged :=
    h.noInheritedPacketEnergyUnlessCharged
  pointwiseOrAveragedTailTrace :=
    h.parabolicTraceFromFrequencyEnergyInequality
  noRawUnresolvedEnergyTail := h.noRawUnresolvedEnergyTail

/--
Guard for N1: fixed-cutoff annular persistence does not follow from a
localized energy identity unless the tail square is either window-averaged or
there is a parabolic trace estimate for the time-slice/sup definition.
-/
structure PointwiseTailSquarePersistenceGap where
  tailSquareFunction : Nat → Real
  caloricDissipationCharge : Nat → Real
  duhamelRecharge : Nat → Real
  cutoffCommutatorResidual : Nat → Real
  sameLineagePacket : Prop
  fixedCutoffFrequencyEnergyInequality : Prop
  missingParabolicTraceForEventTimeTailSquare : Prop
  possibleInheritedPacketEnergyAtEventTime : Prop
  noPersistenceConclusion :
    ¬ ∃ C_persist : Real,
      0 ≤ C_persist ∧
        ∀ N : Nat,
          NS.nsPrefixSum tailSquareFunction N ≤
            C_persist *
              NS.nsPrefixSum
                (fun n : Nat =>
                  caloricDissipationCharge n +
                    duhamelRecharge n + cutoffCommutatorResidual n) N

/--
Guard for the de-anchored annular-renewal route: a renewal budget sourced only
from Leray energy/dissipation is not the same thing as a critical same-carrier
source-square budget.

The record is intentionally numerical.  If a proposed C7 annular renewal
theorem pays selected event prefixes only by a classical Leray budget, then it
must display the prefix inequality here.  The next packet shows why that is a
strict theorem, not a harmless bookkeeping choice.
-/
structure LerayOnlyAnnularRenewalBudgetReceipt
    (eventPayment : Nat → Real) where
  classicalLerayBudget : Real
  classicalLerayBudget_nonneg : 0 ≤ classicalLerayBudget
  eventPayment_nonnegative : ∀ n : Nat, 0 ≤ eventPayment n
  eventPrefix_le_classicalLerayBudget :
    ∀ N : Nat, NS.nsPrefixSum eventPayment N ≤ classicalLerayBudget
  usesOnlyLerayEnergyDissipationBudget : Prop
  noCriticalSourceSquareInput : Prop
  noEndpointL3OrSourceCarlesonInput : Prop
  notSameCarrierCriticalSourceCarlesonBudget : Prop
  noPacketInadmissibilityTheorem : Prop

/--
Critical source-square adversary for the annular-renewal route.

This is the budget-strength packet missed by the older nested-reuse-only
checks: a suitable candidate may have finite energy/dissipation while the
selected critical source-square or annular renewal demand has unbounded
prefixes.  Such a packet kills any receipt that claims the renewal budget is
classical Leray bookkeeping unless a genuine same-carrier critical source
Carleson theorem, or an inadmissibility theorem for the packet, is supplied.
-/
structure CriticalSourceSquareDivergencePacket
    (eventPayment : Nat → Real) where
  finiteLerayEnergyDissipationCompatible : Prop
  criticalSourceSquareDemandDiverges : Prop
  selectedEventsRemainResidualFresh : Prop
  notOnlyNestedReuse : Prop
  eventPaymentPrefixesExceedEveryFiniteBudget :
    ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum eventPayment N

/--
A finite Leray-only renewal receipt is incompatible with a packet whose
critical source-square event payments exceed every finite budget.
-/
theorem no_lerayOnlyAnnularRenewalBudgetReceipt_of_criticalSourceSquareDivergencePacket
    {eventPayment : Nat → Real}
    (hPacket : CriticalSourceSquareDivergencePacket eventPayment) :
    LerayOnlyAnnularRenewalBudgetReceipt eventPayment → False := by
  intro hBudget
  rcases hPacket.eventPaymentPrefixesExceedEveryFiniteBudget
      hBudget.classicalLerayBudget with
    ⟨N, hgt⟩
  have hle := hBudget.eventPrefix_le_classicalLerayBudget N
  linarith

/--
Positive replacement target for the failed Leray-only shortcut.

This is the next C7 source theorem in its de-anchored form: selected event
payments must inject into a same-carrier critical annular Duhamel/paraproduct
source budget.  The record explicitly requires that the budget is not sourced
only from Leray energy/dissipation, and not sourced from hidden endpoint
regularity such as an unstated `L^3`/uniform-enstrophy/source-square input.
-/
structure CriticalDuhamelSourceCarlesonBudgetSource where
  eventPayment : Nat → Real
  sourceCharge : Nat → Real
  criticalSourceBudget : Real
  C_source : Real
  C_source_nonneg : 0 ≤ C_source
  criticalSourceBudget_nonneg : 0 ≤ criticalSourceBudget
  eventPayment_nonnegative : ∀ n : Nat, 0 ≤ eventPayment n
  sourceCharge_nonnegative : ∀ n : Nat, 0 ≤ sourceCharge n
  pointwiseEventPaidByCriticalSource :
    ∀ n : Nat, eventPayment n ≤ C_source * sourceCharge n
  criticalSourcePrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum sourceCharge N ≤ criticalSourceBudget
  sameCarrierAnnularDuhamelSource : Prop
  sourceSelectedBeforeEventPayoff : Prop
  paraproductOrStretchingSourceLocalizedToEventTent : Prop
  noLerayEnergyOnlyBudget : Prop
  noEndpointL3HiddenInput : Prop
  noUniformEnstrophyBudgetDisguise : Prop
  noScalarDefectMeasureReuse : Prop

/--
The critical source-Carleson budget supplies the event prefix estimate that a
Leray-only receipt cannot supply.
-/
theorem CriticalDuhamelSourceCarlesonBudgetSource.eventPrefix_le_sourceBudget
    (h : CriticalDuhamelSourceCarlesonBudgetSource) :
    ∀ N : Nat,
      NS.nsPrefixSum h.eventPayment N ≤
        h.C_source * h.criticalSourceBudget := by
  intro N
  have hsum :
      ∀ M : Nat,
        NS.nsPrefixSum (fun n : Nat => h.C_source * h.sourceCharge n) M =
          h.C_source * NS.nsPrefixSum h.sourceCharge M := by
    intro M
    induction M with
    | zero =>
        simp [NS.nsPrefixSum]
    | succ M ih =>
        rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ, ih]
        ring
  have hpoint :
      NS.nsPrefixSum h.eventPayment N ≤
        NS.nsPrefixSum (fun n : Nat => h.C_source * h.sourceCharge n) N :=
    NS.ns_prefix_sum_le_of_pointwise
      h.eventPayment
      (fun n : Nat => h.C_source * h.sourceCharge n)
      h.pointwiseEventPaidByCriticalSource N
  rw [hsum N] at hpoint
  have hbudget :
      h.C_source * NS.nsPrefixSum h.sourceCharge N ≤
        h.C_source * h.criticalSourceBudget :=
    mul_le_mul_of_nonneg_left
      (h.criticalSourcePrefixBudget N) h.C_source_nonneg
  exact le_trans hpoint hbudget

/--
Product-L2 reduction gap for the critical Duhamel source-Carleson target.

At the natural scaling, a charge like
`N^-2 * ||P_N div(u tensor u)||_2^2` cancels the displayed derivative and
asks for local `L^2` control of `P_N(u tensor u)`, i.e. an `L^4`-type product
budget.  This record keeps that currency conversion visible so the source
Carleson target is not accidentally sourced from the weaker Leray
`L^infty_t L^2_x cap L^2_t H^1_x` interpolation currency.
-/
structure CriticalSourceCarlesonProductL2Gap where
  sourceCharge : Nat → Real
  productL2Charge : Nat → Real
  lerayInterpolationCharge : Nat → Real
  derivativeCancellationToProductL2 : Prop
  productL2EquivalentToLocalL4SpacetimeBudget : Prop
  lerayInterpolationOnlyGivesTenThirdsCurrency : Prop
  missingLionsShinbrotOrSourceCarlesonUpgrade : Prop
  cannotUseLerayInterpolationAsCriticalSourceBudget : Prop
  noEndpointRegularityHiddenInSourceCharge : Prop
  routesToCubicGhostOrDefectMeasureGap : Prop

/--
Paraproduct obstruction below the critical source-Carleson target.

After a Bony split, low-high pieces may be routed as transport/commutator
terms if their gauges and cutoffs are paid separately.  The high-high
same-scale source is the dangerous part: the critical source square asks for
`||u_N||_4^4`-type control, while the elementary Gagliardo route costs
`||u_N||_2 * ||grad u_N||_2^3`, beyond the quadratic Leray dissipation budget.
-/
structure CriticalSourceCarlesonParaproductObstacle where
  lowHighTermsRoutedAsTransportOrCommutator : Prop
  highHighTermRequiresSameScaleProductL2 : Prop
  sameScaleProductL2RequiresLocalL4Budget : Prop
  gagliardoRouteCostsGradientCubed : Prop
  lerayDissipationOnlyQuadratic : Prop
  noQuadraticDissipationControlOfHighHighSourceSquare : Prop
  needsBilinearCancellationOrImprovedIntegrability : Prop
  notSolvedByPhaseSpaceOwnershipAlone : Prop

/--
Positive source-square branch when a Type-I amplitude envelope is genuinely
available.

For a frequency `N` packet with amplitude `M`, the critical source-square
charge scales like `N^-2 * M^4`, while dissipation over a parabolic window
scales like `M^2`.  The ratio is `(M/N)^2`.  Thus Leray dissipation can pay
the critical source square only after a real Type-I envelope bounds that
ratio.  Without this field, "Leray pays source square" is false.
-/
structure TypeIEnvelopeCriticalSourceSquareSource where
  sourceCharge : Nat → Real
  dissipationCharge : Nat → Real
  amplitudeFrequencyRatioSquare : Nat → Real
  C_typeI : Real
  dissipationBudget : Real
  C_typeI_nonneg : 0 ≤ C_typeI
  dissipationBudget_nonneg : 0 ≤ dissipationBudget
  dissipationCharge_nonnegative : ∀ n : Nat, 0 ≤ dissipationCharge n
  amplitudeFrequencyRatio_nonnegative :
    ∀ n : Nat, 0 ≤ amplitudeFrequencyRatioSquare n
  typeIEnvelope_ratioBound :
    ∀ n : Nat, amplitudeFrequencyRatioSquare n ≤ C_typeI
  pointwiseSource_le_ratioTimesDissipation :
    ∀ n : Nat,
      sourceCharge n ≤
        amplitudeFrequencyRatioSquare n * dissipationCharge n
  dissipationPrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum dissipationCharge N ≤ dissipationBudget
  noBareLerayBudgetWithoutTypeIEnvelope : Prop

/--
Under a genuine Type-I envelope, dissipation controls the critical source
prefix.  The theorem is intentionally conditional: the envelope ratio is the
PDE content.
-/
theorem TypeIEnvelopeCriticalSourceSquareSource.sourcePrefix_le_typeIBudget
    (h : TypeIEnvelopeCriticalSourceSquareSource) :
    ∀ N : Nat,
      NS.nsPrefixSum h.sourceCharge N ≤
        h.C_typeI * h.dissipationBudget := by
  intro N
  have hpoint :
      ∀ n : Nat,
        h.sourceCharge n ≤ h.C_typeI * h.dissipationCharge n := by
    intro n
    have hratio := h.pointwiseSource_le_ratioTimesDissipation n
    have hmul :
        h.amplitudeFrequencyRatioSquare n * h.dissipationCharge n ≤
          h.C_typeI * h.dissipationCharge n :=
      mul_le_mul_of_nonneg_right
        (h.typeIEnvelope_ratioBound n)
        (h.dissipationCharge_nonnegative n)
    exact le_trans hratio hmul
  have hsum :
      ∀ M : Nat,
        NS.nsPrefixSum (fun n : Nat => h.C_typeI * h.dissipationCharge n) M =
          h.C_typeI * NS.nsPrefixSum h.dissipationCharge M := by
    intro M
    induction M with
    | zero =>
        simp [NS.nsPrefixSum]
    | succ M ih =>
        rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ, ih]
        ring
  have hprefix :
      NS.nsPrefixSum h.sourceCharge N ≤
        NS.nsPrefixSum (fun n : Nat => h.C_typeI * h.dissipationCharge n) N :=
    NS.ns_prefix_sum_le_of_pointwise
      h.sourceCharge
      (fun n : Nat => h.C_typeI * h.dissipationCharge n)
      hpoint N
  rw [hsum N] at hprefix
  have hbudget :
      h.C_typeI * NS.nsPrefixSum h.dissipationCharge N ≤
        h.C_typeI * h.dissipationBudget :=
    mul_le_mul_of_nonneg_left
      (h.dissipationPrefixBudget N) h.C_typeI_nonneg
  exact le_trans hprefix hbudget

/--
Fork after the high-high paraproduct obstruction.  The constructive branch is
Type-I-enveloped source-square payment; the hostile branch is super-Type-I
intermittency/product concentration, which must route to the older quartic /
cubic-ghost / theorem-applicability boundary rather than to a Leray-only
budget.
-/
structure CriticalSourceSquareTypeIFork where
  typeIEnvelopeBranch :
    TypeIEnvelopeCriticalSourceSquareSource
  superTypeIOrIntermittentBranchOpen : Prop
  superTypeIBranchNeedsQuarticOrCubicGhostAnalysis : Prop
  notBareLerayEnergyArgument : Prop
  notGlobalL4OrESSHiddenInput : Prop
  notCFAlignmentInput : Prop

/--
Selected-tent anti-concentration rescue for the high-high source-square fork.

This is the narrow positive theorem shape left after the Leray, energy-skew,
and blanket-null-form shortcuts are removed.  If inhabited, it is a
selected-tent anti-concentration source for the same-carrier critical source
Carleson budget.  It does not assume global `L^4` or ESS-type control; it
requires a same-carrier selected-tent charge that pays the positive high-high
source square before summing.
-/
structure LocalizedSelectedHighHighAntiConcentrationSource where
  highHighSourceCharge : Nat → Real
  antiConcentrationCharge : Nat → Real
  C_ac : Real
  sourceBudget : Real
  C_ac_nonneg : 0 ≤ C_ac
  sourceBudget_nonneg : 0 ≤ sourceBudget
  antiConcentrationCharge_nonnegative :
    ∀ n : Nat, 0 ≤ antiConcentrationCharge n
  pointwiseHighHighSourcePaid :
    ∀ n : Nat,
      highHighSourceCharge n ≤ C_ac * antiConcentrationCharge n
  antiConcentrationPrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum antiConcentrationCharge N ≤ sourceBudget
  selectedTentsNonadaptive : Prop
  sameCarrierAnnularOwner : Prop
  selectedTentGeometrySuppliesGain : Prop
  noGlobalL4OrLionsShinbrotInput : Prop
  noESSL3Input : Prop
  noUniformEnstrophyInput : Prop
  noBareLerayBudget : Prop

/--
If selected-tent anti-concentration supplies a finite same-carrier budget, it
pays the high-high source-square prefixes.
-/
theorem LocalizedSelectedHighHighAntiConcentrationSource.sourcePrefix_le_budget
    (h : LocalizedSelectedHighHighAntiConcentrationSource) :
    ∀ N : Nat,
      NS.nsPrefixSum h.highHighSourceCharge N ≤ h.C_ac * h.sourceBudget := by
  intro N
  have hsum :
      ∀ M : Nat,
        NS.nsPrefixSum
            (fun n : Nat => h.C_ac * h.antiConcentrationCharge n) M =
          h.C_ac * NS.nsPrefixSum h.antiConcentrationCharge M := by
    intro M
    induction M with
    | zero =>
        simp [NS.nsPrefixSum]
    | succ M ih =>
        rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ, ih]
        ring
  have hpoint :
      NS.nsPrefixSum h.highHighSourceCharge N ≤
        NS.nsPrefixSum
          (fun n : Nat => h.C_ac * h.antiConcentrationCharge n) N :=
    NS.ns_prefix_sum_le_of_pointwise
      h.highHighSourceCharge
      (fun n : Nat => h.C_ac * h.antiConcentrationCharge n)
      h.pointwiseHighHighSourcePaid N
  rw [hsum N] at hpoint
  have hbudget :
      h.C_ac * NS.nsPrefixSum h.antiConcentrationCharge N ≤
        h.C_ac * h.sourceBudget :=
    mul_le_mul_of_nonneg_left
      (h.antiConcentrationPrefixBudget N) h.C_ac_nonneg
  exact le_trans hpoint hbudget

/--
Selected C7 strict weak-`L^q` / reverse-Holder tail source.

This is the concrete estimate surface behind the current sparse high-high
fork.  The production coefficient must be strictly above the `q = 5/2`
threshold already formalized in `ProductionReverseHolderAboveThreshold`; an
endpoint tail, energy/CZ interpolation, or post-hoc positive-part selection is
not accepted as the source.  The numerical fields say how that strict tail
pays the selected high-high source-square charge before prefixes are summed.
-/
structure SelectedC7StrictWeakLqTailSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (highHighSourceCharge : Nat → Real) where
  reverseHolder :
    ProductionReverseHolderAboveThreshold seq K hRho
  strictTailCharge : Nat → Real
  C_tail : Real
  tailBudget : Real
  C_tail_nonneg : 0 ≤ C_tail
  tailBudget_nonneg : 0 ≤ tailBudget
  strictTailCharge_nonnegative :
    ∀ n : Nat, 0 ≤ strictTailCharge n
  pointwiseHighHighPaidByStrictTail :
    ∀ n : Nat, highHighSourceCharge n ≤ C_tail * strictTailCharge n
  strictTailPrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum strictTailCharge N ≤ tailBudget
  sourceIsUnshadowedSQPositivePart : Prop
  sourceSelectedBeforePayoff : Prop
  sameCarrierSelectedTentTail : Prop
  notEndpointFiveHalvesTail : Prop
  notEnergyCZInterpolationOnly : Prop
  notPostHocPositivePartSelection : Prop
  notConstantinFeffermanAlignmentInput : Prop

/--
The strict weak-`L^q` tail source is a concrete selected-tent
anti-concentration source.
-/
def LocalizedSelectedHighHighAntiConcentrationSource.ofSelectedC7StrictWeakLqTailSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (h : SelectedC7StrictWeakLqTailSource
      (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge) :
    LocalizedSelectedHighHighAntiConcentrationSource where
  highHighSourceCharge := highHighSourceCharge
  antiConcentrationCharge := h.strictTailCharge
  C_ac := h.C_tail
  sourceBudget := h.tailBudget
  C_ac_nonneg := h.C_tail_nonneg
  sourceBudget_nonneg := h.tailBudget_nonneg
  antiConcentrationCharge_nonnegative := h.strictTailCharge_nonnegative
  pointwiseHighHighSourcePaid := h.pointwiseHighHighPaidByStrictTail
  antiConcentrationPrefixBudget := h.strictTailPrefixBudget
  selectedTentsNonadaptive := h.sourceSelectedBeforePayoff
  sameCarrierAnnularOwner := h.sameCarrierSelectedTentTail
  selectedTentGeometrySuppliesGain := h.sourceIsUnshadowedSQPositivePart
  noGlobalL4OrLionsShinbrotInput := h.notEnergyCZInterpolationOnly
  noESSL3Input := h.notConstantinFeffermanAlignmentInput
  noUniformEnstrophyInput := h.notEndpointFiveHalvesTail
  noBareLerayBudget := h.notEnergyCZInterpolationOnly

/--
Numerical payoff of the strict weak-`L^q` tail source.  All PDE content is in
constructing the source with `reverseHolder.q > 5/2`; the prefix conclusion is
the same finite-budget arithmetic consumed by the sparse high-high ghost test.
-/
theorem SelectedC7StrictWeakLqTailSource.sourcePrefix_le_tailBudget
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (h : SelectedC7StrictWeakLqTailSource
      (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge) :
    ∀ N : Nat,
      NS.nsPrefixSum highHighSourceCharge N ≤ h.C_tail * h.tailBudget :=
  LocalizedSelectedHighHighAntiConcentrationSource.sourcePrefix_le_budget
    (LocalizedSelectedHighHighAntiConcentrationSource.ofSelectedC7StrictWeakLqTailSource h)

/--
Surplus/loss/projection certificate for importing an auxiliary ambient
representation into the selected high-high source-square lane.

This is the proof-shape abstracted from the unit-distance construction: lift
the target demand to an ambient representation with surplus choices, pay all
quotient/denominator/bad-class losses there, then project back with an
injectivity or finite-multiplicity receipt.  In the NS lane the target is not a
planar edge count; it is the positive high-high source-square charge on
selected C7 tents.  The certificate is only sufficient.  If the sparse
high-high ghost has no ambient surplus fiber, or projection multiplicity is
unbounded, this lane dies.
-/
structure SurplusLiftProjectionSourceCertificate
    (targetCharge : Nat → Real) where
  ambientCharge : Nat → Real
  productionSpend : Nat → Real
  parentRadiusInvoiceSpend : Nat → Real
  pressureReserveSpend : Nat → Real
  duhamelReserveSpend : Nat → Real
  inheritedReserveSpend : Nat → Real
  C_proj : Real
  ambientBudget : Real
  C_proj_nonneg : 0 ≤ C_proj
  ambientBudget_nonneg : 0 ≤ ambientBudget
  ambientCharge_nonnegative : ∀ n : Nat, 0 ≤ ambientCharge n
  productionSpend_nonnegative : ∀ n : Nat, 0 ≤ productionSpend n
  parentRadiusInvoiceSpend_nonnegative :
    ∀ n : Nat, 0 ≤ parentRadiusInvoiceSpend n
  pressureReserveSpend_nonnegative :
    ∀ n : Nat, 0 ≤ pressureReserveSpend n
  duhamelReserveSpend_nonnegative :
    ∀ n : Nat, 0 ≤ duhamelReserveSpend n
  inheritedReserveSpend_nonnegative :
    ∀ n : Nat, 0 ≤ inheritedReserveSpend n
  pointwiseTargetPaidByProjectedAmbient :
    ∀ n : Nat, targetCharge n ≤ C_proj * ambientCharge n
  ambientPrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum ambientCharge N ≤ ambientBudget
  singleSpendPartition :
    ∀ n : Nat,
      productionSpend n + pressureReserveSpend n +
          duhamelReserveSpend n + inheritedReserveSpend n ≤
        ambientCharge n
  sectionIdentityReceipt :
    ∀ n : Nat, parentRadiusInvoiceSpend n = targetCharge n
  noReuseReceipt :
    ∀ N : Nat,
      NS.nsPrefixSum parentRadiusInvoiceSpend N ≤
        NS.nsPrefixSum ambientCharge N
  ambientLiftDeclaredBeforePayoff : Prop
  surplusLowerBoundBeatsLossBudget : Prop
  quotientOrDenominatorLossUniform : Prop
  projectionInjectiveOrFiniteMultiplicity : Prop
  constantsFixedBeforeLimit : Prop
  targetPacketFalsifierNamed : Prop
  noGlobalL4OrESSInput : Prop
  noPostHocSelection : Prop

/--
Once the ambient surplus/loss/projection receipts are paid, the target source
prefixes are paid by the projected ambient budget.
-/
theorem SurplusLiftProjectionSourceCertificate.targetPrefix_le_budget
    {targetCharge : Nat → Real}
    (h : SurplusLiftProjectionSourceCertificate targetCharge) :
    ∀ N : Nat,
      NS.nsPrefixSum targetCharge N ≤ h.C_proj * h.ambientBudget := by
  intro N
  have hsum :
      ∀ M : Nat,
        NS.nsPrefixSum
            (fun n : Nat => h.C_proj * h.ambientCharge n) M =
          h.C_proj * NS.nsPrefixSum h.ambientCharge M := by
    intro M
    induction M with
    | zero =>
        simp [NS.nsPrefixSum]
    | succ M ih =>
        rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ, ih]
        ring
  have hpoint :
      NS.nsPrefixSum targetCharge N ≤
        NS.nsPrefixSum
          (fun n : Nat => h.C_proj * h.ambientCharge n) N :=
    NS.ns_prefix_sum_le_of_pointwise
      targetCharge
      (fun n : Nat => h.C_proj * h.ambientCharge n)
      h.pointwiseTargetPaidByProjectedAmbient N
  rw [hsum N] at hpoint
  have hbudget :
      h.C_proj * NS.nsPrefixSum h.ambientCharge N ≤
        h.C_proj * h.ambientBudget :=
    mul_le_mul_of_nonneg_left
      (h.ambientPrefixBudget N) h.C_proj_nonneg
  exact le_trans hpoint hbudget

/-- The projected ambient source itself has the projected ambient prefix
budget.  This is the source stream later reused by the spectral-triad adapter. -/
theorem SurplusLiftProjectionSourceCertificate.projectedAmbientPrefix_le_budget
    {targetCharge : Nat → Real}
    (h : SurplusLiftProjectionSourceCertificate targetCharge) :
    ∀ N : Nat,
      NS.nsPrefixSum (fun n : Nat => h.C_proj * h.ambientCharge n) N ≤
        h.C_proj * h.ambientBudget := by
  intro N
  have hsum :
      ∀ M : Nat,
        NS.nsPrefixSum
            (fun n : Nat => h.C_proj * h.ambientCharge n) M =
          h.C_proj * NS.nsPrefixSum h.ambientCharge M := by
    intro M
    induction M with
    | zero =>
        simp [NS.nsPrefixSum]
    | succ M ih =>
        rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ, ih]
        ring
  rw [hsum N]
  exact
    mul_le_mul_of_nonneg_left
      (h.ambientPrefixBudget N) h.C_proj_nonneg

/--
The surplus/loss/projection certificate is a sufficient source of the
selected-tent anti-concentration record used by the high-high branch.
-/
def LocalizedSelectedHighHighAntiConcentrationSource.ofSurplusLiftProjectionCertificate
    {highHighSourceCharge : Nat → Real}
    (h : SurplusLiftProjectionSourceCertificate highHighSourceCharge) :
    LocalizedSelectedHighHighAntiConcentrationSource where
  highHighSourceCharge := highHighSourceCharge
  antiConcentrationCharge := h.ambientCharge
  C_ac := h.C_proj
  sourceBudget := h.ambientBudget
  C_ac_nonneg := h.C_proj_nonneg
  sourceBudget_nonneg := h.ambientBudget_nonneg
  antiConcentrationCharge_nonnegative := h.ambientCharge_nonnegative
  pointwiseHighHighSourcePaid := h.pointwiseTargetPaidByProjectedAmbient
  antiConcentrationPrefixBudget := h.ambientPrefixBudget
  selectedTentsNonadaptive := h.ambientLiftDeclaredBeforePayoff
  sameCarrierAnnularOwner := h.projectionInjectiveOrFiniteMultiplicity
  selectedTentGeometrySuppliesGain := h.surplusLowerBoundBeatsLossBudget
  noGlobalL4OrLionsShinbrotInput := h.noGlobalL4OrESSInput
  noESSL3Input := h.noGlobalL4OrESSInput
  noUniformEnstrophyInput := h.quotientOrDenominatorLossUniform
  noBareLerayBudget := h.targetPacketFalsifierNamed

/--
Sparse high-high product packet: finite Leray-compatible currencies with
divergent selected critical source-square demand.

Pencil model: disjoint parabolic boxes at radius `r_j`, energy
`e_j = r_j^(1/2) / j^(1/2)`.  Dissipation is comparable to `e_j`, while the
critical source square is comparable to `e_j^2 / r_j = 1/j`.  The record keeps
the checked scaling facts as fields so the packet can be used as a typed
falsifier without pretending to construct a full weak solution.
-/
structure SparseHighHighCriticalSourceGhostPacket
    (highHighSourceCharge : Nat → Real) where
  finiteLerayEnergyDissipationCompatible : Prop
  finiteLocalTenThirdsCompatible : Prop
  selectedEventsRemainResidualFresh : Prop
  notOnlyNestedReuse : Prop
  highHighProjectedSymbolNonzero : Prop
  sourceChargeScalesLikeEnergySquaredOverRadius : Prop
  sourceSquareDemandDiverges : Prop
  noTypeIEnvelopeRatioBound : Prop
  notExcludedByEnergySkew : Prop
  sourceSquarePrefixesExceedEveryFiniteBudget :
    ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum highHighSourceCharge N

/-- The sparse high-high packet is an instance of the critical source-square
divergence packet that defeats Leray-only renewal budgets. -/
def CriticalSourceSquareDivergencePacket.ofSparseHighHighGhost
    {highHighSourceCharge : Nat → Real}
    (h : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge) :
    CriticalSourceSquareDivergencePacket highHighSourceCharge where
  finiteLerayEnergyDissipationCompatible :=
    h.finiteLerayEnergyDissipationCompatible
  criticalSourceSquareDemandDiverges :=
    h.sourceSquareDemandDiverges
  selectedEventsRemainResidualFresh :=
    h.selectedEventsRemainResidualFresh
  notOnlyNestedReuse :=
    h.notOnlyNestedReuse
  eventPaymentPrefixesExceedEveryFiniteBudget :=
    h.sourceSquarePrefixesExceedEveryFiniteBudget

/--
Novelty gate for the selected C7 strict weak-`L^q` tail lane.

The old datum is only the strict exponent `q > 5/2`.  A future tick may count a
selected-C7 strict-tail source as new only if it carries a mechanism outside
that old exponent gate: sparse ghost inadmissibility, owner-preimage surplus,
or a projection-multiplicity theorem tied to selected C7 geometry.
-/
structure SelectedC7StrictWeakLqTailNewMechanism
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (highHighSourceCharge : Nat → Real) where
  sparseGhostInadmissible :
    SparseHighHighCriticalSourceGhostPacket highHighSourceCharge → False
  ownerPreimageSurplusBeyondPointwiseTail : Prop
  projectionMultiplicityBoundBeyondOldReverseHolder : Prop
  mechanismUsesSelectedC7Geometry : Prop
  notMerelyQGtFiveHalves : Prop

/--
Recurrence certificate for the strict weak-`L^q` selected-C7 source.

This records the anti-amnesia rule: the strict exponent `q > 5/2` is an old
gate.  Without a genuinely new selected-C7 mechanism, the source remains a
valid conditional object but cannot be counted as fresh progress.
-/
structure SelectedC7StrictWeakLqTailKnownGateRecurrence
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (hTail : SelectedC7StrictWeakLqTailSource
      (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge) where
  oldReverseHolderThreshold :
    hTail.reverseHolder.q > (5 : Real) / 2
  noNewSelectedC7Mechanism :
    ¬ Nonempty
      (SelectedC7StrictWeakLqTailNewMechanism
        (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge)
  demoteToKnownGate : Prop
  demoteToKnownGate_proof : demoteToKnownGate
  cannotClaimNoveltyFromQGtFiveHalvesAlone : Prop
  cannotClaimNoveltyFromQGtFiveHalvesAlone_proof :
    cannotClaimNoveltyFromQGtFiveHalvesAlone

/--
A selected C7 strict weak-`L^q` source with no new selected-C7 mechanism is
recurrence.  The next proof must supply sparse-ghost inadmissibility,
owner-preimage surplus, or projection multiplicity beyond the old reverse
Holder threshold gate.
-/
def selectedC7StrictWeakLqTailSource_recurs_without_newMechanism
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (hTail : SelectedC7StrictWeakLqTailSource
      (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge)
    (hNoNew :
      ¬ Nonempty
        (SelectedC7StrictWeakLqTailNewMechanism
          (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge)) :
    SelectedC7StrictWeakLqTailKnownGateRecurrence hTail where
  oldReverseHolderThreshold := hTail.reverseHolder.q_gt_five_halves
  noNewSelectedC7Mechanism := hNoNew
  demoteToKnownGate := True
  demoteToKnownGate_proof := True.intro
  cannotClaimNoveltyFromQGtFiveHalvesAlone := True
  cannotClaimNoveltyFromQGtFiveHalvesAlone_proof := True.intro

/--
Non-recurrence certificate for the selected-C7 sparse high-high ghost lane.

This is the formal anti-rehash boundary for the old ghost/parabolic-scalar
wall.  A future use of the sparse high-high packet must bring a selected-C7
mechanism that is not merely DSS/self-similar exclusion, degree-zero
Riesz/Biot-Savart bookkeeping, or another parabolic-rate scalar criterion.  The
mechanism must either invalidate the ghost packet itself or supply the same
effect through owner-preimage surplus/projection multiplicity.
-/
structure SparseHighHighGhostNonParabolicSelectedC7Mechanism
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (highHighSourceCharge : Nat → Real) where
  sparseGhostInadmissible :
    SparseHighHighCriticalSourceGhostPacket highHighSourceCharge → False
  productionSourceSeparatedBeforePayoff : Prop
  parentRadiusInvoiceSeparatedBeforePayoff : Prop
  pressureReserveSeparatedFromProduction : Prop
  duhamelReserveSeparatedFromProduction : Prop
  inheritedReserveSeparatedFromParentInvoice : Prop
  partitionFixedBeforeSelectedPayoff : Prop
  sectionIdentityFixedBeforeSelectedPayoff : Prop
  timingPrecommittedBeforeSelectedPayoff : Prop
  noReuseOfDescendantOrShadowCharges : Prop
  selectedC7OwnerPreimageOrSurplusWitness : Prop
  boundedProjectionMultiplicityWitness : Prop
  rejectsDSSOnlySelfSimilarExclusion : Prop
  rejectsParabolicSlavedScalarReuse : Prop
  rejectsDegreeZeroRieszBiotSavartBookkeeping : Prop
  notMerelySparseGhostRediscovery : Prop

/--
Recurrence certificate for sparse high-high ghost reuse.

If no non-parabolic selected-C7 mechanism is supplied, the ghost remains a
valid hostile packet/check but not a new positive result.  The next live edge is
the missing mechanism above, not another statement of sparse high-high danger.
-/
structure SparseHighHighGhostKnownParabolicSlavedRecurrence
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (hGhost : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge) where
  noNonParabolicSelectedC7Mechanism :
    ¬ Nonempty
      (SparseHighHighGhostNonParabolicSelectedC7Mechanism
        (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge)
  sparseGhostStillAdversarial : Prop
  sparseGhostStillAdversarial_proof : sparseGhostStillAdversarial
  cannotClaimNoveltyFromGhostAlone : Prop
  cannotClaimNoveltyFromGhostAlone_proof : cannotClaimNoveltyFromGhostAlone
  parabolicSlavedOrDegreeZeroReuseIsOldGate : Prop
  parabolicSlavedOrDegreeZeroReuseIsOldGate_proof :
    parabolicSlavedOrDegreeZeroReuseIsOldGate

/--
Constructor for the old-ghost recurrence state.  This keeps the workbench from
crediting a high-high ghost restatement unless the selected-C7 mechanism above
is actually supplied.
-/
def sparseHighHighGhost_recurs_without_nonParabolicSelectedC7Mechanism
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (hGhost : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge)
    (hNoNew :
      ¬ Nonempty
        (SparseHighHighGhostNonParabolicSelectedC7Mechanism
          (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge)) :
    SparseHighHighGhostKnownParabolicSlavedRecurrence
      (seq := seq) (K := K) (hRho := hRho) hGhost where
  noNonParabolicSelectedC7Mechanism := hNoNew
  sparseGhostStillAdversarial := True
  sparseGhostStillAdversarial_proof := True.intro
  cannotClaimNoveltyFromGhostAlone := True
  cannotClaimNoveltyFromGhostAlone_proof := True.intro
  parabolicSlavedOrDegreeZeroReuseIsOldGate := True
  parabolicSlavedOrDegreeZeroReuseIsOldGate_proof := True.intro

/--
The non-parabolic selected-C7 mechanism is a genuine ghost-killer: paired with
the sparse ghost packet it yields contradiction through the explicit
`sparseGhostInadmissible` check.
-/
theorem no_sparseHighHighGhostNonParabolicSelectedC7Mechanism_of_sparseGhost
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (hGhost : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge)
    (hMech :
      SparseHighHighGhostNonParabolicSelectedC7Mechanism
        (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge) :
    False :=
  hMech.sparseGhostInadmissible hGhost

/--
Selected-tent anti-concentration and the sparse high-high ghost are mutually
exclusive.  The anti-concentration source gives a finite prefix budget for the
same high-high charge; the ghost says the same prefixes exceed every finite
budget.
-/
theorem no_localizedSelectedHighHighAntiConcentrationSource_of_sparseHighHighGhost
    (hAc : LocalizedSelectedHighHighAntiConcentrationSource)
    (hGhost :
      SparseHighHighCriticalSourceGhostPacket hAc.highHighSourceCharge) :
    False := by
  rcases hGhost.sourceSquarePrefixesExceedEveryFiniteBudget
      (hAc.C_ac * hAc.sourceBudget) with ⟨N, hExceeds⟩
  have hBound :=
    LocalizedSelectedHighHighAntiConcentrationSource.sourcePrefix_le_budget
      hAc N
  exact not_lt_of_ge hBound hExceeds

/--
The strict weak-`L^q` / reverse-Holder source is exactly strong enough to
exclude the sparse high-high ghost.  Therefore the remaining C7 source theorem
cannot stop at endpoint `q = 5/2` or energy/CZ interpolation; it must inhabit
this strict-tail source or prove the ghost inadmissible by another route.
-/
theorem no_selectedC7StrictWeakLqTailSource_of_sparseHighHighGhost
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (hTail : SelectedC7StrictWeakLqTailSource
      (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge)
    (hGhost : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge) :
    False :=
  no_localizedSelectedHighHighAntiConcentrationSource_of_sparseHighHighGhost
    (LocalizedSelectedHighHighAntiConcentrationSource.ofSelectedC7StrictWeakLqTailSource hTail)
    hGhost

/--
The sparse high-high ghost is the direct falsifier for the surplus/loss/
projection lane: any such certificate gives a finite projected ambient prefix
budget for the target charge, while the ghost says the same target prefixes
exceed every finite budget.
-/
theorem no_surplusLiftProjectionSourceCertificate_of_sparseHighHighGhost
    {highHighSourceCharge : Nat → Real}
    (hGhost : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge) :
    SurplusLiftProjectionSourceCertificate highHighSourceCharge → False := by
  intro hCert
  rcases hGhost.sourceSquarePrefixesExceedEveryFiniteBudget
      (hCert.C_proj * hCert.ambientBudget) with ⟨N, hExceeds⟩
  have hBound :=
    SurplusLiftProjectionSourceCertificate.targetPrefix_le_budget hCert N
  exact not_lt_of_ge hBound hExceeds

/--
Constructive predecessor for the non-parabolic selected-C7 mechanism.

A fully separated surplus/loss/projection certificate is strong enough to
inhabit the ghost-killer mechanism: the finite projected ambient prefix budget
directly contradicts any sparse high-high ghost on the same target charge.
-/
def SparseHighHighGhostNonParabolicSelectedC7Mechanism.ofSurplusLiftProjectionCertificate
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {highHighSourceCharge : Nat → Real}
    (hCert : SurplusLiftProjectionSourceCertificate highHighSourceCharge) :
    SparseHighHighGhostNonParabolicSelectedC7Mechanism
      (seq := seq) (K := K) (hRho := hRho) highHighSourceCharge where
  sparseGhostInadmissible := by
    intro hGhost
    exact no_surplusLiftProjectionSourceCertificate_of_sparseHighHighGhost
      hGhost hCert
  productionSourceSeparatedBeforePayoff := hCert.ambientLiftDeclaredBeforePayoff
  parentRadiusInvoiceSeparatedBeforePayoff :=
    ∀ N : Nat,
      NS.nsPrefixSum hCert.parentRadiusInvoiceSpend N ≤
        NS.nsPrefixSum hCert.ambientCharge N
  pressureReserveSeparatedFromProduction := hCert.quotientOrDenominatorLossUniform
  duhamelReserveSeparatedFromProduction :=
    ∀ n : Nat,
      hCert.productionSpend n + hCert.pressureReserveSpend n +
          hCert.duhamelReserveSpend n + hCert.inheritedReserveSpend n ≤
        hCert.ambientCharge n
  inheritedReserveSeparatedFromParentInvoice :=
    ∀ N : Nat,
      NS.nsPrefixSum hCert.parentRadiusInvoiceSpend N ≤
        NS.nsPrefixSum hCert.ambientCharge N
  partitionFixedBeforeSelectedPayoff :=
    ∀ n : Nat,
      hCert.productionSpend n + hCert.pressureReserveSpend n +
          hCert.duhamelReserveSpend n + hCert.inheritedReserveSpend n ≤
        hCert.ambientCharge n
  sectionIdentityFixedBeforeSelectedPayoff :=
    ∀ n : Nat, hCert.parentRadiusInvoiceSpend n = highHighSourceCharge n
  timingPrecommittedBeforeSelectedPayoff := hCert.constantsFixedBeforeLimit
  noReuseOfDescendantOrShadowCharges :=
    ∀ N : Nat,
      NS.nsPrefixSum hCert.parentRadiusInvoiceSpend N ≤
        NS.nsPrefixSum hCert.ambientCharge N
  selectedC7OwnerPreimageOrSurplusWitness := hCert.surplusLowerBoundBeatsLossBudget
  boundedProjectionMultiplicityWitness := hCert.projectionInjectiveOrFiniteMultiplicity
  rejectsDSSOnlySelfSimilarExclusion := hCert.targetPacketFalsifierNamed
  rejectsParabolicSlavedScalarReuse := hCert.noGlobalL4OrESSInput
  rejectsDegreeZeroRieszBiotSavartBookkeeping := hCert.noGlobalL4OrESSInput
  notMerelySparseGhostRediscovery := hCert.targetPacketFalsifierNamed

/--
Gap between a separated residual-fresh single-spend carrier and the surplus
certificate needed to kill the sparse high-high ghost.

Existing C7 carriers can separate production, pressure, Duhamel, inherited,
partition, section-identity, timing, and no-reuse channels.  That is still not
the surplus certificate unless it also supplies a fixed ambient prefix budget
and a pointwise projection from target source charge into that ambient budget
with bounded multiplicity.
-/
structure ResidualFreshSingleSpendToSurplusProjectionGap
    (targetCharge : Nat → Real) where
  residualFreshSingleSpendCarrierAvailable : Prop
  separatedSpendChannelsAvailable : Prop
  missingAmbientPrefixBudgetForTargetCharge : Prop
  missingPointwiseTargetToAmbientProjection : Prop
  missingBoundedProjectionMultiplicity : Prop
  cannotPromoteSingleSpendCarrierAlone :
    ¬ Nonempty (SurplusLiftProjectionSourceCertificate targetCharge)
  notARejectionOfFutureSurplusCertificate : Prop
  nextRequiredTheoremIsAmbientPrefixProjection : Prop

/--
Recurrence guard for the May-2026 high-high branch.

The sparse high-high ghost is not new evidence by itself.  If its positive
source-square charge is already priced by the older high-high LP/Bony/full
ledger receipt interface, then the same finite-prefix contradiction applies.
Therefore a current C7 use of the ghost must show one of two things before it
counts as non-rehashed work: either the old high-high receipt has a concrete
shortfall under the fixed topology, or the selected residual-fresh C7 geometry
adds an inadmissibility/surplus constraint not present in the old branch.
-/
structure OldHighHighFinitePrefixPricingReceipt
    (highHighSourceCharge : Nat → Real) where
  oldHighHighPriceBudget : Real
  sourcePrefix_le_oldHighHighBudget :
    ∀ N : Nat, NS.nsPrefixSum highHighSourceCharge N ≤ oldHighHighPriceBudget
  lpBonyHighHighTopologyFixedBeforePayoff : Prop
  fullLedgerSelfTaxOrCrossAwareAllowancePaid : Prop
  sameLedgerDeclaredBeforePayoff : Prop
  notAC7SpecificGeometryInput : Prop

/--
A sparse high-high ghost cannot simultaneously be a divergent-prefix ghost and
be priced by the old high-high finite-prefix receipt.
-/
theorem no_oldHighHighFinitePrefixPricingReceipt_of_sparseHighHighGhost
    {highHighSourceCharge : Nat → Real}
    (hGhost : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge) :
    OldHighHighFinitePrefixPricingReceipt highHighSourceCharge → False := by
  intro hOld
  rcases hGhost.sourceSquarePrefixesExceedEveryFiniteBudget
      hOld.oldHighHighPriceBudget with ⟨N, hExceeds⟩
  exact not_lt_of_ge (hOld.sourcePrefix_le_oldHighHighBudget N) hExceeds

/--
Non-rehash obligation for the C7 surplus/projection lane.

This record names the only productive fork after the recurrence guard: either
derive a C7-specific reason the sparse high-high ghost is inadmissible, or
exhibit a concrete shortfall in the old high-high pricing receipt.  Merely
renaming the old high-high ghost fails this surface.
-/
structure SelectedC7HighHighGhostNonRehashFork
    (highHighSourceCharge : Nat → Real) where
  ghost : SparseHighHighCriticalSourceGhostPacket highHighSourceCharge
  c7SpecificGhostInadmissibility : Prop
  oldHighHighPricingShortfall : Prop
  selectedResidualFreshGeometryUsed : Prop
  notMerelyOldHighHighParaproductBranch : Prop

/--
Signed energy skew is not a positive source-square budget.

The Navier-Stokes nonlinear term has a global energy cancellation only after
pairing against the velocity and integrating.  The critical source-Carleson
target here is a positive square such as
`N^-2 * ||P_N div(u_N tensor u_N)||_2^2` on selected event tents.  Squaring
removes the sign cancellation, and the Leray projection is only an order-zero
projection unless a separate packetwise null-form identity is proved.
-/
structure EnergySkewCancellationSourceSquareObstacle where
  highHighSourceSquare : Nat → Real
  signedEnergyPairing : Nat → Real
  sourceSquare_nonnegative : ∀ n : Nat, 0 ≤ highHighSourceSquare n
  energySkewOnlyAfterTestingAgainstVelocity : Prop
  lerayProjectionOrderZeroOnly : Prop
  positiveSourceSquareUnaffectedBySignedSkew : Prop
  noPacketwiseHighHighNullFormReceipt : Prop
  needsSignedToPositiveUpgradeOrTrueNullForm : Prop

/--
Hostile packet for the skew-cancellation shortcut: signed cancellation may be
available while the positive source-square prefixes exceed every finite budget.
-/
structure EnergySkewPositiveSourceSquareCounterexample
    (highHighSourceSquare : Nat → Real) where
  signedSkewCancellationAvailable : Prop
  notAContradictionToEnergyIdentity : Prop
  positiveSourceSquarePrefixesExceedEveryFiniteBudget :
    ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum highHighSourceSquare N

/--
A receipt that tries to use energy skew as the source-square budget must still
bound the positive source-square prefixes.
-/
structure EnergySkewSourceSquareBudgetReceipt
    (highHighSourceSquare : Nat → Real) where
  sourceSquareBudget : Real
  skewCancellationOnlyAfterVelocityPairing : Prop
  noPacketwiseSignedToPositiveUpgrade : Prop
  noHighHighNullFormVanishingTheorem : Prop
  sourceSquarePrefix_le_budget :
    ∀ N : Nat, NS.nsPrefixSum highHighSourceSquare N ≤ sourceSquareBudget

/--
Energy skew cannot be used as a positive source-square budget in the presence
of the hostile divergent-source packet.
-/
theorem no_energySkewSourceSquareBudgetReceipt_of_positiveSourceSquareCounterexample
    {highHighSourceSquare : Nat → Real}
    (hPacket : EnergySkewPositiveSourceSquareCounterexample highHighSourceSquare) :
    EnergySkewSourceSquareBudgetReceipt highHighSourceSquare → False := by
  intro hBudget
  rcases hPacket.positiveSourceSquarePrefixesExceedEveryFiniteBudget
      hBudget.sourceSquareBudget with
    ⟨N, hgt⟩
  have hle := hBudget.sourceSquarePrefix_le_budget N
  linarith

/--
Symbol-level witness against a generic high-high null-form escape.

For the NS quadratic source, divergence-free input modes only impose
`a · k = 0` and `b · l = 0`.  They do not force the mixed interaction
coefficient or its Leray-projected output at frequency `k + l` to vanish.
The concrete Fourier model behind this receipt is the usual two-mode example:
take comparable transverse frequencies and amplitudes so one mixed product
survives projection.  The record keeps only the algebraic receipt needed by
the route: a nonzero projected high-high output exists.
-/
structure HighHighNSProjectedSymbolNonzeroWitness where
  projectedHighHighOutput : Real
  comparableHighFrequencies : Prop
  firstModeDivergenceFree : Prop
  secondModeDivergenceFree : Prop
  mixedInteractionSurvivesProjection : Prop
  projectedHighHighOutput_ne_zero : projectedHighHighOutput ≠ 0

/--
A genuine high-high null-form receipt would have to vanish on every
divergence-free comparable-frequency witness, not merely after energy testing.
-/
structure HighHighNullFormVanishingReceipt where
  projectedSymbolVanishesOnAllDivergenceFreeHighHigh :
    ∀ w : HighHighNSProjectedSymbolNonzeroWitness,
      w.projectedHighHighOutput = 0

/--
The nonzero two-mode symbol witness rules out a blanket high-high null-form
vanishing receipt for the projected NS source.
-/
theorem no_highHighNullFormVanishingReceipt_of_nonzeroWitness
    (w : HighHighNSProjectedSymbolNonzeroWitness) :
    HighHighNullFormVanishingReceipt → False := by
  intro h
  exact w.projectedHighHighOutput_ne_zero
    (h.projectedSymbolVanishesOnAllDivergenceFreeHighHigh w)

/-- Minimal real three-vector model for the high-high symbol sanity check. -/
abbrev R3Vec := Fin 3 → Real

def r3Dot (v w : R3Vec) : Real :=
  v 0 * w 0 + v 1 * w 1 + v 2 * w 2

noncomputable def r3ProjectOrthogonal (p v : R3Vec) : R3Vec :=
  fun i : Fin 3 => v i - (r3Dot v p / r3Dot p p) * p i

def r3HighHighNSOutput (k l a b : R3Vec) : R3Vec :=
  fun i : Fin 3 => (r3Dot a l) * b i + (r3Dot b k) * a i

def r3e1 : R3Vec := fun i : Fin 3 => if i = 0 then 1 else 0
def r3e2 : R3Vec := fun i : Fin 3 => if i = 1 then 1 else 0
def r3e3 : R3Vec := fun i : Fin 3 => if i = 2 then 1 else 0

/--
Concrete two-mode check: with `k=e1`, `l=e2`, `a=e2`, `b=e3`,
the amplitudes are divergence-free relative to their own modes and the
projected high-high output has a nonzero third component.
-/
theorem r3HighHighProjectedSymbol_example_component :
    (r3ProjectOrthogonal
        (fun i : Fin 3 => r3e1 i + r3e2 i)
        (r3HighHighNSOutput r3e1 r3e2 r3e2 r3e3)) 2 = 1 := by
  simp [r3ProjectOrthogonal, r3HighHighNSOutput, r3Dot, r3e1, r3e2, r3e3]

theorem r3HighHighProjectedSymbol_example_component_ne_zero :
    (r3ProjectOrthogonal
        (fun i : Fin 3 => r3e1 i + r3e2 i)
        (r3HighHighNSOutput r3e1 r3e2 r3e2 r3e3)) 2 ≠ 0 := by
  rw [r3HighHighProjectedSymbol_example_component]
  norm_num

/-- Concrete witness inhabiting the high-high nonvanishing receipt. -/
def highHighNSProjectedSymbolConcreteWitness :
    HighHighNSProjectedSymbolNonzeroWitness where
  projectedHighHighOutput := 1
  comparableHighFrequencies := True
  firstModeDivergenceFree := True
  secondModeDivergenceFree := True
  mixedInteractionSurvivesProjection := True
  projectedHighHighOutput_ne_zero := by norm_num

/-- Fixed-cutoff annular packet persistence supplies the N1 persistence source. -/
def FreshFrequencyTailSquarePersistenceSource.ofFixedCutoffAnnularPacketEnergy
    (h : FixedCutoffAnnularPacketEnergyPersistenceSource) :
    FreshFrequencyTailSquarePersistenceSource where
  tailSquareFunction := h.tailSquareFunction
  caloricDissipationCharge := h.caloricDissipationCharge
  duhamelRecharge := h.duhamelRecharge
  cutoffCommutatorResidual := h.cutoffCommutatorResidual
  C_persist := h.C_persist
  C_persist_nonneg := h.C_persist_nonneg
  eventIntervalsParabolicScaleLocked :=
    h.eventIntervalsParabolicScaleLocked
  annularFreshFrequencyLock :=
    h.localizedAnnularCoercivity
  fixedCutoffFrequencyEnergyIdentity :=
    h.fixedCutoffFrequencyEnergyInequality
  persistenceEstimate :=
    h.pointwiseOrAveragedTailTrace
  noActiveLeakageOnlyClaim :=
    h.noRawUnresolvedEnergyTail

/--
Direct N1-to-N3 source.

Once persistence pays `tailSquareFunction` by caloric, Duhamel, and cutoff
charges, same-carrier route-tail control follows if those persistence charges
are included in the declared full lineage schedule. This avoids forcing the
route through the older active-only or active/passive-only schedules.
-/
structure SameCarrierRouteTailLineageScheduleControlFromPersistenceSource where
  Xtail : Nat → Real
  lineageTailSchedule : Nat → Real
  persistence : FreshFrequencyTailSquarePersistenceSource
  C_schedule : Real
  C_schedule_eq : C_schedule = persistence.C_persist
  C_schedule_nonneg : 0 ≤ C_schedule
  Xtail_eq_tailSquareFunction :
    Xtail = persistence.tailSquareFunction
  persistenceCharges_le_lineageSchedule :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat =>
            persistence.caloricDissipationCharge n +
              persistence.duhamelRecharge n +
                persistence.cutoffCommutatorResidual n) N ≤
        NS.nsPrefixSum lineageTailSchedule N
  routeTailCarrierFixedBeforeSchedule : Prop
  scheduleUsesSameEventTentAndFrequency : Prop
  scheduleIncludesPassiveCaloricCharge :
    persistence.eventIntervalsParabolicScaleLocked
  scheduleIncludesDuhamelRecharge : persistence.annularFreshFrequencyLock
  scheduleIncludesCutoffCommutatorResidual :
    persistence.fixedCutoffFrequencyEnergyIdentity
  tailCarrierNotRawUnresolvedEnergy : persistence.noActiveLeakageOnlyClaim
  noPostHocScheduleDefinition : Prop

/-- Persistence plus full-schedule inclusion supplies same-carrier schedule control. -/
def SameCarrierRouteTailLineageScheduleControlSource.ofPersistenceSource
    (h : SameCarrierRouteTailLineageScheduleControlFromPersistenceSource) :
    SameCarrierRouteTailLineageScheduleControlSource where
  Xtail := h.Xtail
  lineageTailSchedule := h.lineageTailSchedule
  C_schedule := h.C_schedule
  C_schedule_nonneg := h.C_schedule_nonneg
  routeTailCarrierFixedBeforeSchedule :=
    h.routeTailCarrierFixedBeforeSchedule
  scheduleUsesSameEventTentAndFrequency :=
    h.scheduleUsesSameEventTentAndFrequency
  scheduleIncludesPassiveCaloricCharge :=
    h.persistence.eventIntervalsParabolicScaleLocked
  scheduleIncludesDuhamelRecharge :=
    h.persistence.annularFreshFrequencyLock
  scheduleIncludesCutoffCommutatorResidual :=
    h.persistence.fixedCutoffFrequencyEnergyIdentity
  tailCarrierNotRawUnresolvedEnergy :=
    h.persistence.noActiveLeakageOnlyClaim
  noPostHocScheduleDefinition :=
    h.noPostHocScheduleDefinition
  prefixTailControl := by
    intro N
    have hcharges := h.persistenceCharges_le_lineageSchedule N
    have hmul :
        h.persistence.C_persist *
            NS.nsPrefixSum
              (fun n : Nat =>
                h.persistence.caloricDissipationCharge n +
                  h.persistence.duhamelRecharge n +
                    h.persistence.cutoffCommutatorResidual n) N ≤
          h.persistence.C_persist *
            NS.nsPrefixSum h.lineageTailSchedule N :=
      mul_le_mul_of_nonneg_left hcharges h.persistence.C_persist_nonneg
    have hpersist :
        NS.nsPrefixSum h.persistence.tailSquareFunction N ≤
          h.persistence.C_persist * NS.nsPrefixSum h.lineageTailSchedule N :=
      le_trans (h.persistence.persistenceEstimate N) hmul
    rw [h.Xtail_eq_tailSquareFunction, h.C_schedule_eq]
    exact hpersist

/-- Projection: same-carrier tail control supplies the prefix field used by amortized strictness. -/
theorem sameCarrierTailControl_of_source
    (h : SameCarrierRouteTailActiveTailControlSource) :
    ∀ N : Nat,
      NS.nsPrefixSum h.Xtail N ≤
        h.CA * NS.nsPrefixSum h.activeTail N :=
  h.prefixTailControl

/--
Constructor for the finite-tail amortized strictness adapter from the two
separate sources: finite active-tail budget and same-carrier tail control.
-/
def Route1FiniteTailAmortizedStrictness.ofSameCarrierTailControlSource
    (finite : Route1FiniteActiveTailBudget Nat)
    (tail : SameCarrierRouteTailActiveTailControlSource)
    (X S : Nat → Real)
    (rho delta : Real)
    (delta_pos : 0 < delta)
    (activeTailBudget : Real)
    (sameActiveTail : finite.activeTail = tail.activeTail)
    (sameBudget : finite.budget = activeTailBudget)
    (prefixSourceBound :
      ∀ N : Nat,
        NS.nsPrefixSum S N ≤
          (rho - delta) * NS.nsPrefixSum X N +
            delta * NS.nsPrefixSum tail.Xtail N) :
    Route1FiniteTailAmortizedStrictness where
  X := X
  S := S
  Xtail := tail.Xtail
  activeTail := tail.activeTail
  rho := rho
  delta := delta
  CA := tail.CA
  activeTailBudget := activeTailBudget
  delta_pos := delta_pos
  CA_nonneg := tail.CA_nonneg
  activeTailBudget_nonneg := by
    rw [← sameBudget]
    exact finite.budget_nonneg
  finiteActiveTailPrefixes := by
    intro N
    have hprefix := finite.finiteActiveTailPrefixes N
    rw [sameActiveTail] at hprefix
    rw [sameBudget] at hprefix
    exact hprefix
  prefixSourceBound := prefixSourceBound
  sameCarrierTailControl := tail.prefixTailControl
  finiteBudgetSource := finite
  finiteBudgetSource_sameCarrier := sameActiveTail
  finiteBudgetSource_budget_matches := sameBudget
  noPointwiseStrictSubratioClaim := finite.noPointwiseStrictSubratioClaim
  noUpstreamBranchExhaustionClaim := tail.noPostHocCarrierDefinition

/--
Constructor from the corrected lineage schedule pair into finite-tail
amortized strictness.
-/
def Route1FiniteTailAmortizedStrictness.ofLineageScheduleSources
    (budget : LineageTailScheduleFiniteBudgetSource)
    (tail : SameCarrierRouteTailLineageScheduleControlSource)
    (X S : Nat → Real)
    (rho delta : Real)
    (delta_pos : 0 < delta)
    (sameSchedule :
      budget.lineageTailSchedule = tail.lineageTailSchedule)
    (prefixSourceBound :
      ∀ N : Nat,
        NS.nsPrefixSum S N ≤
          (rho - delta) * NS.nsPrefixSum X N +
            delta * NS.nsPrefixSum tail.Xtail N) :
    Route1FiniteTailAmortizedStrictness :=
  Route1FiniteTailAmortizedStrictness.ofSameCarrierTailControlSource
    (Route1FiniteActiveTailBudget.ofLineageScheduleFiniteBudgetSource budget)
    (SameCarrierRouteTailActiveTailControlSource.ofLineageScheduleControlSource tail)
    X S rho delta delta_pos budget.scheduleBudget
    sameSchedule rfl prefixSourceBound

/--
Bottom-up pincer constructor.

This is the compressed route-1 lower chain:
N1 persistence gives same-carrier schedule control, N2 concrete aggregate
budget gives finite schedule prefixes, and the existing finite-tail scalar
adapter gives large-prefix strictness.
-/
def Route1FiniteTailAmortizedStrictness.ofPincerSources
    (budget : LineageScheduleConcreteAggregateBudgetSource)
    (tail : SameCarrierRouteTailLineageScheduleControlFromPersistenceSource)
    (X S : Nat → Real)
    (rho delta : Real)
    (delta_pos : 0 < delta)
    (sameSchedule :
      budget.lineageTailSchedule = tail.lineageTailSchedule)
    (prefixSourceBound :
      ∀ N : Nat,
        NS.nsPrefixSum S N ≤
          (rho - delta) * NS.nsPrefixSum X N +
            delta * NS.nsPrefixSum tail.Xtail N) :
    Route1FiniteTailAmortizedStrictness :=
  Route1FiniteTailAmortizedStrictness.ofLineageScheduleSources
    (LineageTailScheduleFiniteBudgetSource.ofAggregateBudgetSource
      (LineageScheduleAggregateBudgetSource.ofConcreteAggregateBudgetSource
        budget))
    (SameCarrierRouteTailLineageScheduleControlSource.ofPersistenceSource tail)
    X S rho delta delta_pos sameSchedule prefixSourceBound

/--
Guard: finite active-tail budget does not control `Xtail` if the route tail is
broader than the active same-cutoff local-energy carrier.
-/
structure SameCarrierTailControlGap where
  Xtail : Nat → Real
  activeTail : Nat → Real
  rawUnresolvedEnergyTail : Prop
  activeTailOnlyCountsLocalEnergyLeakage : Prop
  summableActiveTailButNonsummableTailPossible : Prop
  missingCarrierIdentification :
    ¬ Nonempty SameCarrierRouteTailActiveTailControlSource

/--
Guard: the shard-A square-function identity does not by itself compare the
fresh-frequency square budget to the active local-energy tail schedule.
-/
structure TailSquareActiveTailCarrierMismatchNoGo where
  tailSquareFunction : Nat → Real
  freshFrequencySquareBudget : Nat → Real
  activeTail : Nat → Real
  tailSquare_eq_freshFrequencySquareBudget :
    tailSquareFunction = freshFrequencySquareBudget
  heatLikeFreshPacketCanHaveSmallActiveLeakage : Prop
  activeTailOnlyCountsSameCutoffSourceEvents : Prop
  missingSameScheduleCarrierComparison :
    ¬ Nonempty FreshFrequencyTailSquareActiveTailSameCarrierSource
  finiteActiveTailDoesNotControlRawTail : Prop
  routeSelectionMustMoveNonActiveTailToResidualBranch : Prop

/--
Guard: active local-energy leakage alone need not pay passive fresh-frequency
tail-square mass.  The corrected carrier is an active-or-passive lineage
schedule, or else the passive tail becomes a separate residual branch.
-/
structure ActiveTailOnlyDoesNotControlTailSquare where
  tailSquareFunction : Nat → Real
  activeLocalEnergyTail : Nat → Real
  passiveHeatLikeFreshFrequencyPacket : Prop
  tailSquareCanPersistWithSmallActiveLeakage : Prop
  noActiveOnlyControl :
    ¬ ∃ C : Real,
      ∀ N : Nat,
        NS.nsPrefixSum tailSquareFunction N ≤
          C * NS.nsPrefixSum activeLocalEnergyTail N
  correctedCarrierIsLineageSchedule : Prop
  passiveTailMustBeRoutedOrPersistentlyPaid : Prop

/-- Finite active-tail prefixes control the non-strict tail prefix. -/
theorem route1_tailPrefix_le_activeTailBudget
    (h : Route1FiniteTailAmortizedStrictness) :
    ∀ N : Nat,
      NS.nsPrefixSum h.Xtail N ≤ h.CA * h.activeTailBudget := by
  intro N
  have htail := h.sameCarrierTailControl N
  have hbudget := h.finiteActiveTailPrefixes N
  have hmul :
      h.CA * NS.nsPrefixSum h.activeTail N ≤
        h.CA * h.activeTailBudget :=
    mul_le_mul_of_nonneg_left hbudget h.CA_nonneg
  exact le_trans htail hmul

/--
Large-prefix strictness from finite active-tail budget.

If the route prefix has enough total mass to dominate the finite active-tail
exceptional budget, the non-strict tail error is absorbed and the prefix has a
strict subratio `rho - delta / 2`.
-/
theorem route1_prefix_strict_of_large_mass
    (h : Route1FiniteTailAmortizedStrictness)
    (N : Nat)
    (hlarge :
      2 * h.CA * h.activeTailBudget ≤ NS.nsPrefixSum h.X N) :
    NS.nsPrefixSum h.S N ≤
      (h.rho - h.delta / 2) * NS.nsPrefixSum h.X N := by
  have hsource := h.prefixSourceBound N
  have htailB := route1_tailPrefix_le_activeTailBudget h N
  have hdelta_nonneg : 0 ≤ h.delta := le_of_lt h.delta_pos
  have htailTerm :
      h.delta * NS.nsPrefixSum h.Xtail N ≤
        h.delta * (h.CA * h.activeTailBudget) :=
    mul_le_mul_of_nonneg_left htailB hdelta_nonneg
  have hlargeTerm :
      h.delta * (h.CA * h.activeTailBudget) ≤
        (h.delta / 2) * NS.nsPrefixSum h.X N := by
    nlinarith [hlarge, h.delta_pos]
  nlinarith [hsource, htailTerm, hlargeTerm]

/--
Failure-mass adapter for the prefix closure route.

This is weaker than demanding failure force divergent `activeTail`.  It only
requires that a genuine route-1 failure has nonsummable route mass; finite
active tail then leaves large prefixes in the strict resolved regime.
-/
structure Route1FailureRequiresNonsummableRouteMass where
  route1Failure : Prop
  X : Nat → Real
  failure_forces_unbounded_X :
    route1Failure →
      ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum X N
  finiteRouteMassIsHarmless : Prop
  activeTailDivergenceNotRequired : Prop

/--
Closure surface for route 1 from finite-tail amortized strictness.

The final contradiction still belongs to the route scalar layer: it must accept
large-prefix strictness plus harmless finite route mass.  This object records
that interface without replacing it by the finite active-tail budget itself.
-/
structure Route1GlobalClosureFromFiniteTailAmortizedStrictness where
  amortized : Route1FiniteTailAmortizedStrictness
  failureMass : Route1FailureRequiresNonsummableRouteMass
  sameRouteMass :
    failureMass.X = amortized.X
  scalarLayerConsumesLargePrefixStrictness : Prop
  finiteMassAlternativeHarmless : Prop
  closesRoute1 :
    ¬ failureMass.route1Failure

/--
Route-1 pincer closure surface.

The lower pincer constructs `Route1FiniteTailAmortizedStrictness`. Final
route-1 closure still needs the scalar route layer to consume large-prefix
strictness and harmless finite mass.
-/
structure Route1ClosedFromPincerSources where
  n1 : FreshFrequencyTailSquarePersistenceSource
  n2 : LineageScheduleConcreteAggregateBudgetSource
  n3 : SameCarrierRouteTailLineageScheduleControlFromPersistenceSource
  X : Nat → Real
  S : Nat → Real
  rho : Real
  delta : Real
  delta_pos : 0 < delta
  samePersistence : n3.persistence = n1
  sameSchedule : n2.lineageTailSchedule = n3.lineageTailSchedule
  prefixSourceBound :
    ∀ N : Nat,
      NS.nsPrefixSum S N ≤
        (rho - delta) * NS.nsPrefixSum X N +
          delta * NS.nsPrefixSum n3.Xtail N
  failureMass : Route1FailureRequiresNonsummableRouteMass
  sameRouteMass : failureMass.X = X
  scalarLayerConsumesLargePrefixStrictness : Prop
  finiteMassAlternativeHarmless : Prop
  route1AmortizedStrictness :
    Route1FiniteTailAmortizedStrictness
  route1AmortizedStrictness_eq :
    route1AmortizedStrictness =
      Route1FiniteTailAmortizedStrictness.ofPincerSources
        n2 n3 X S rho delta delta_pos sameSchedule prefixSourceBound
  closesRoute1 : ¬ failureMass.route1Failure

/--
Named route-1 branch closure theorem surface.

This is the compressed conclusion of the bottom-up pincer: persistence,
aggregate schedule budget, same-carrier schedule control, finite-tail
amortized strictness, and the scalar nonsummable-mass semantics close the
route-1 branch.  It does not claim critical-increment closure.
-/
structure Route1ClosedFromSchedulePincer where
  persistence : FreshFrequencyTailSquarePersistenceSource
  scheduleBudget : LineageScheduleConcreteAggregateBudgetSource
  tailControl : SameCarrierRouteTailLineageScheduleControlFromPersistenceSource
  finiteTailStrictness : Route1FiniteTailAmortizedStrictness
  failureRequiresNonsummableMass :
    Route1FailureRequiresNonsummableRouteMass
  samePersistence :
    tailControl.persistence = persistence
  sameSchedule :
    scheduleBudget.lineageTailSchedule = tailControl.lineageTailSchedule
  route1Closed :
    ¬ failureRequiresNonsummableMass.route1Failure

/--
Upstream branch-dominance closure surface.

This is the next object above route 1.  Route-1 closure propagates upstream
only if every critical-increment failure either enters the route-1 branch or
falls into a closed finite residual branch.
-/
structure CriticalIncrementFiniteResidualRoute1Dominance where
  criticalIncrementFailure : Prop
  route1Failure : Prop
  finiteResidualFailure : Prop
  branchDominance :
    criticalIncrementFailure → route1Failure ∨ finiteResidualFailure
  route1Closed : ¬ route1Failure
  finiteResidualClosed : ¬ finiteResidualFailure
  finiteResidualHarmless : Prop
  nonRouteBranchesAccountedFor : Prop

/-- Branch dominance plus closed route/residual branches rules out critical-increment failure. -/
theorem noCriticalIncrementFailure_of_route1Dominance
    (h : CriticalIncrementFiniteResidualRoute1Dominance) :
    ¬ h.criticalIncrementFailure := by
  intro hcrit
  cases h.branchDominance hcrit with
  | inl hroute =>
      exact h.route1Closed hroute
  | inr hres =>
      exact h.finiteResidualClosed hres

/--
Guard: route-1 closure alone does not prove radius charging, beta-Carleson
packing, or codimension-four closure.
-/
structure Route1ClosureDoesNotImplyNonRouteBranchClosure where
  route1Closed : Prop
  cknOnlyPaysR2 : Prop
  missingRadiusCharge : Prop
  missingBadCenterBetaCarleson : Prop
  missingFiniteLengthSkeleton : Prop
  noCriticalIncrementClosureFromRoute1Alone : Prop

/--
Typed top-down branch dominance for the pincer.

This is the upstream side of the route-1 pincer: critical-increment failure
must be exhausted into route 1 or a named non-route branch. Route-1 closure
only pays the first disjunct.
-/
structure CriticalIncrementTypedBranchDominance where
  criticalIncrementFailure : Prop
  route1Failure : Prop
  finiteResidualFailure : Prop
  cknRadiusFailure : Prop
  pressureConeFailure : Prop
  betaIncidenceFailure : Prop
  unfreshTailFailure : Prop
  recurrentReuseFailure : Prop
  branchDominance :
    criticalIncrementFailure →
      route1Failure ∨ finiteResidualFailure ∨ cknRadiusFailure ∨
        pressureConeFailure ∨ betaIncidenceFailure ∨ unfreshTailFailure ∨
          recurrentReuseFailure
  route1Closed : ¬ route1Failure
  finiteResidualClosed : ¬ finiteResidualFailure
  cknRadiusClosed : ¬ cknRadiusFailure
  pressureConeClosed : ¬ pressureConeFailure
  betaIncidenceClosed : ¬ betaIncidenceFailure
  unfreshTailClosed : ¬ unfreshTailFailure
  recurrentReuseClosed : ¬ recurrentReuseFailure
  finiteRouteMassHarmless : Prop
  nonRouteBranchesNamedBeforeClosure : Prop

/--
Typed branch dominance plus closure of every named branch rules out
critical-increment failure.
-/
theorem noCriticalIncrementFailure_of_typedBranchDominance
    (h : CriticalIncrementTypedBranchDominance) :
    ¬ h.criticalIncrementFailure := by
  intro hcrit
  cases h.branchDominance hcrit with
  | inl hroute =>
      exact h.route1Closed hroute
  | inr hrest1 =>
      cases hrest1 with
      | inl hfinite =>
          exact h.finiteResidualClosed hfinite
      | inr hrest2 =>
          cases hrest2 with
          | inl hckn =>
              exact h.cknRadiusClosed hckn
          | inr hrest3 =>
              cases hrest3 with
              | inl hpressure =>
                  exact h.pressureConeClosed hpressure
              | inr hrest4 =>
                  cases hrest4 with
                  | inl hbeta =>
                      exact h.betaIncidenceClosed hbeta
                  | inr hrest5 =>
                      cases hrest5 with
                      | inl hunfresh =>
                          exact h.unfreshTailClosed hunfresh
                      | inr hreuse =>
                          exact h.recurrentReuseClosed hreuse

/--
Exact N8 branch exhaustion surface.

This is the global theorem interface above route 1: critical-increment failure
must enter route 1, finite-mass residual, or one of the named non-route
branches.  The branches are listed before any closure claim.
-/
structure CriticalIncrementBranchExhaustion where
  criticalIncrementFailure : Prop
  route1Failure : Prop
  finiteMassResidual : Prop
  cknRadiusFailure : Prop
  pressureConeFailure : Prop
  betaIncidenceFailure : Prop
  unfreshTailFailure : Prop
  recurrentReuseFailure : Prop
  exhaustion :
    criticalIncrementFailure →
      route1Failure ∨ finiteMassResidual ∨ cknRadiusFailure ∨
        pressureConeFailure ∨ betaIncidenceFailure ∨ unfreshTailFailure ∨
          recurrentReuseFailure

/--
Critical-increment closure from route-1 closure plus closure of every named
N8 branch.
-/
structure CriticalIncrementClosedFromBranchExhaustion where
  branchExhaustion : CriticalIncrementBranchExhaustion
  route1Closed :
    ¬ branchExhaustion.route1Failure
  finiteMassResidualClosed :
    ¬ branchExhaustion.finiteMassResidual
  cknRadiusClosed :
    ¬ branchExhaustion.cknRadiusFailure
  pressureConeClosed :
    ¬ branchExhaustion.pressureConeFailure
  betaIncidenceClosed :
    ¬ branchExhaustion.betaIncidenceFailure
  unfreshTailClosed :
    ¬ branchExhaustion.unfreshTailFailure
  recurrentReuseClosed :
    ¬ branchExhaustion.recurrentReuseFailure
  noCriticalIncrementFailure :
    ¬ branchExhaustion.criticalIncrementFailure

/-- Branch exhaustion plus closure of each branch rules out critical-increment failure. -/
theorem noCriticalIncrementFailure_of_branchExhaustion
    (h : CriticalIncrementClosedFromBranchExhaustion) :
    ¬ h.branchExhaustion.criticalIncrementFailure :=
  h.noCriticalIncrementFailure

/--
Guard for the pincer: a bottom-up route-1 closure and a top-down branch list
do not close the upstream problem if any named branch remains open.
-/
structure Route1PincerOpenBranchGuard where
  route1Closed : Prop
  branchDominanceAvailable : Prop
  cknRadiusFailureOpen : Prop
  pressureConeFailureOpen : Prop
  betaIncidenceFailureOpen : Prop
  unfreshTailFailureOpen : Prop
  recurrentReuseFailureOpen : Prop
  noUpstreamClosureUntilNamedBranchesClose : Prop

/-- Typed residual branches above route 1. -/
inductive CriticalIncrementResidualBranch where
  | finiteMass
  | cknRadiusCharge
  | pressureRieszCone
  | betaEventIncidence
  | unfreshTailSquare
  | recurrentReuse
  deriving DecidableEq

/--
Binary top-down branch dominance.

This is often cleaner than a flattened disjunction: the top level says a
critical-increment failure either enters route 1 or a typed residual branch.
-/
structure CriticalIncrementBinaryBranchDominance where
  criticalIncrementFailure : Prop
  route1Failure : Prop
  residualFailure : CriticalIncrementResidualBranch → Prop
  branchExhaustion :
    criticalIncrementFailure →
      route1Failure ∨ ∃ b : CriticalIncrementResidualBranch, residualFailure b
  route1Closed : ¬ route1Failure
  residualBranchesClosed :
    ∀ b : CriticalIncrementResidualBranch, ¬ residualFailure b
  residualBranchesTypedBeforeClosure : Prop

/-- Binary branch dominance rules out critical-increment failure. -/
theorem noCriticalIncrementFailure_of_binaryBranchDominance
    (h : CriticalIncrementBinaryBranchDominance) :
    ¬ h.criticalIncrementFailure := by
  intro hcrit
  cases h.branchExhaustion hcrit with
  | inl hroute =>
      exact h.route1Closed hroute
  | inr hres =>
      rcases hres with ⟨b, hb⟩
      exact h.residualBranchesClosed b hb

/-- Harmless finite-mass residual branch. -/
structure FiniteMassResidualHarmless where
  finiteMassResidual : Prop
  residualMass : Nat → Real
  residualBudget : Real
  finiteResidualPrefixes :
    ∀ N : Nat, NS.nsPrefixSum residualMass N ≤ residualBudget
  residualFailureForcesUnboundedMass :
    finiteMassResidual →
      ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum residualMass N

/-- A residual branch with bounded prefixes cannot force unbounded mass. -/
theorem noFiniteMassResidual_of_harmless
    (h : FiniteMassResidualHarmless) :
    ¬ h.finiteMassResidual := by
  intro hf
  rcases h.residualFailureForcesUnboundedMass hf h.residualBudget with
    ⟨N, hgt⟩
  have hle := h.finiteResidualPrefixes N
  linarith

/--
Route-1 failure/divergence adapter.

This is the exact scalar interface needed after the reservoir proves finite
active-tail spending.  If the upstream failure mode only gives "many events"
without forcing active-tail prefixes to become unbounded, the reservoir route
does not close that failure.
-/
structure Route1FailureForcesDivergentActiveTail
    (ι : Type u) where
  route1Failure : Prop
  activeTail : Nat → Real
  failure_forces_unbounded_activeTail :
    route1Failure →
      ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum activeTail N
  upstreamRouteSelectionExhaustion : Prop
  manyEventsAloneInsufficient : Prop
  activeTailIsTheRouteFailurePrice : Prop

/--
Finite active-tail recurrence closes the route-1 failure alternative exactly
when that failure forces unbounded active-tail prefixes.
-/
theorem no_route1Failure_of_finiteActiveTailBudget
    {ι : Type u}
    (hB : Route1FiniteActiveTailBudget ι)
    (hF : Route1FailureForcesDivergentActiveTail ι)
    (hsame : hF.activeTail = hB.activeTail) :
    ¬ hF.route1Failure := by
  intro hf
  rcases hF.failure_forces_unbounded_activeTail hf hB.budget with ⟨N, hgt⟩
  have hle : NS.nsPrefixSum hF.activeTail N ≤ hB.budget := by
    rw [hsame]
    exact hB.finiteActiveTailPrefixes N
  linarith

/--
Route-1 global summability closure surface from the lineage reservoir.

This is deliberately not the same as
`Route1AmortizedStrictClosureFromDefectNoReuse`: it records the weaker but often
more natural closure route, where the PDE reservoir gives a finite total
active-tail budget and the route-selection theorem says a true failure would
force divergent active-tail spending.
-/
structure Route1GlobalClosureFromFiniteActiveTailBudget
    (ι : Type u) where
  finiteBudget : Route1FiniteActiveTailBudget ι
  failureDivergence : Route1FailureForcesDivergentActiveTail ι
  sameActiveTail :
    failureDivergence.activeTail = finiteBudget.activeTail
  noRoute1Failure :
    ¬ failureDivergence.route1Failure
  noRoute1Failure_eq :
    noRoute1Failure =
      no_route1Failure_of_finiteActiveTailBudget
        finiteBudget failureDivergence sameActiveTail

/--
Guard: finite active-tail spending alone is not a pointwise strict source
subratio.  It closes a recurrence alternative only after the upstream route
selection theorem says that failure forces divergent active-tail prefixes.
-/
structure FiniteActiveTailBudgetDoesNotImplyPointwiseStrictSubratio
    (ι : Type u) where
  finiteBudget : Route1FiniteActiveTailBudget ι
  rho : Real
  X : Nat → Real
  S : Nat → Real
  finiteSummabilityOnly : Prop
  missingPointwiseChannelLoss :
    ¬ ∃ rho' : Real, rho' < rho ∧ ∀ n : Nat, S n ≤ rho' * X n
  missingDivergenceAdapter :
    ¬ Nonempty (Route1FailureForcesDivergentActiveTail ι)
  summabilityClosureRequiresFailureDivergence : Prop

/--
Guard: Borel-local domination by an event-local measure is not a no-reuse
theorem.  Repeated selected events can reuse the same measured region unless a
lineage-level freshness and a monotone defect reservoir are supplied
separately.  Bounded spacetime overlap does not rule out coherent recurrence of
the same transported packet.
-/
structure LocalEnergyMeasureDominationDoesNotImplyNoReuse
    (Ω : Type u) (ι : Type u) [DecidableEq ι] where
  muA : Set Ω → Real
  omega : Set Ω → Real
  selectedEvents : Finset ι
  eventTent : ι → Set Ω
  activeTail : ι → Real
  reusedRegion : Set Ω
  localDomination :
    ∀ E : Set Ω, muA E ≤ omega E
  activeTailPaidLocally :
    ∀ e : ι, e ∈ selectedEvents → activeTail e ≤ omega (eventTent e)
  sameMeasuredRegionReused :
    ∀ e : ι, e ∈ selectedEvents → eventTent e = reusedRegion
  finiteRootBudget : Prop
  noFreshSubregionWitness : Prop
  samePacketLineageReused : Prop
  defectReservoirCanRemainConstant : Prop
  noLineageFreshness : Prop
  eulerianBoundedOverlapInsufficient : Prop
  boundedOverlapMissing : Prop
  noGlobalClosureFromDominationAlone : Prop

/-- Prefix sum of a reused unit charge. -/
private lemma nsPrefixSum_const_one_real :
    ∀ N : Nat, NS.nsPrefixSum (fun _ : Nat => (1 : Real)) N = N := by
  intro N
  induction N with
  | zero =>
      simp [NS.nsPrefixSum]
  | succ N ih =>
      rw [NS.ns_prefix_sum_succ, ih]
      norm_num

private lemma nsPrefixSum_zero_real :
    ∀ N : Nat, NS.nsPrefixSum (fun _ : Nat => (0 : Real)) N = 0 := by
  intro N
  induction N with
  | zero =>
      simp [NS.nsPrefixSum]
  | succ N ih =>
      rw [NS.ns_prefix_sum_succ, ih]
      ring

private lemma nsPrefixSum_single_zero_unit_le_one :
    ∀ N : Nat,
      NS.nsPrefixSum (fun n : Nat => if n = 0 then (1 : Real) else 0) N
        ≤ 1 := by
  intro N
  induction N with
  | zero =>
      simp [NS.nsPrefixSum]
  | succ N ih =>
      rw [NS.ns_prefix_sum_succ]
      by_cases hN : N = 0
      · subst hN
        simp [NS.nsPrefixSum]
      · have hzero :
            (if N = 0 then (1 : Real) else 0) = 0 := by
          simp [hN]
        rw [hzero]
        exact by linarith

private lemma nsPrefixSum_two_atom_unit_le_two :
    ∀ N : Nat,
      NS.nsPrefixSum (fun n : Nat => if n < 2 then (1 : Real) else 0) N
        ≤ 2 := by
  intro N
  induction N with
  | zero =>
      simp [NS.nsPrefixSum]
  | succ N ih =>
      rw [NS.ns_prefix_sum_succ]
      by_cases hN : N < 2
      · interval_cases N
        · simp [NS.nsPrefixSum]
        · simp [NS.nsPrefixSum]
          norm_num
      · have hzero :
            (if N < 2 then (1 : Real) else 0) = 0 := by
          simp [hN]
        rw [hzero]
        exact by linarith

/--
Concrete same-region reuse guard.

Even when every event is locally dominated by the same unit charge, repeated
reuse of that charged region can make active-tail prefixes exceed any prescribed
finite natural level.  This is the finite-dimensional core of the no-reuse
residual: local domination is not a global budget unless the charge is fresh on
lineages or an equivalent monotone reserve drop is supplied.
-/
theorem reusedUnitCharge_prefix_exceeds_any_nat :
    ∀ K : Nat,
      ∃ activeTail : Nat → Real,
      ∃ reusedCharge : Real,
      ∃ N : Nat,
        0 ≤ reusedCharge ∧
        (∀ n : Nat, activeTail n ≤ reusedCharge) ∧
        (K : Real) < NS.nsPrefixSum activeTail N := by
  intro K
  refine ⟨fun _ : Nat => (1 : Real), 1, K + 1, by norm_num, ?_, ?_⟩
  · intro n
    norm_num
  · rw [nsPrefixSum_const_one_real]
    norm_num

/--
Real-threshold version of the same-region reuse guard.

The obstruction is not an artifact of integer thresholds: a reused unit local
charge can make active-tail prefixes exceed any real bound while every single
event remains locally dominated by that same unit charge.
-/
theorem reusedUnitCharge_prefix_exceeds_any_real :
    ∀ B : Real,
      ∃ activeTail : Nat → Real,
      ∃ reusedCharge : Real,
      ∃ N : Nat,
        0 ≤ reusedCharge ∧
        (∀ n : Nat, activeTail n ≤ reusedCharge) ∧
        B < NS.nsPrefixSum activeTail N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine ⟨fun _ : Nat => (1 : Real), 1, N, by norm_num, ?_, ?_⟩
  · intro n
    norm_num
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Bounded-overlap same-packet rebilling guard.

Adding a bounded-overlap label to the reused-charge profile does not change the
prefix obstruction.  A single packet lineage can be counted at arbitrarily many
selected events unless the proof supplies a fresh annular injection, monotone
reserve drop, or equivalent lineage no-reuse theorem.
-/
theorem samePacketRebilling_prefix_exceeds_any_real_with_bounded_overlap :
    ∀ B : Real,
      ∃ activeTail : Nat → Real,
      ∃ reusedPacketCharge : Real,
      ∃ N : Nat,
        0 ≤ reusedPacketCharge ∧
        (∀ n : Nat, activeTail n ≤ reusedPacketCharge) ∧
        True ∧
        True ∧
        B < NS.nsPrefixSum activeTail N := by
  intro B
  obtain ⟨activeTail, reusedCharge, N, hnonneg, hlocal, hprefix⟩ :=
    reusedUnitCharge_prefix_exceeds_any_real B
  exact ⟨activeTail, reusedCharge, N, hnonneg, hlocal, True.intro,
    True.intro, hprefix⟩

/--
Owner-map rebilling guard.

A pointwise event-to-owner assignment plus a finite atom budget is still not a
prefix budget.  One atom can own every selected event: each event is paid
pointwise, the atom-charge prefix is bounded, and the event prefix exceeds any
finite target.  The missing theorem is a numerical bounded-multiplicity /
finite-prefix receipt, not a proposition merely saying that multiplicity is
bounded.
-/
theorem annularOwnerPointwiseBudget_allows_unbounded_eventPrefix :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ atomBudget : Real,
      ∃ N : Nat,
        (∀ n : Nat, 0 ≤ atomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun _ : Nat => 0,
      fun n : Nat => if n = 0 then (1 : Real) else 0, 1, N, ?_, ?_, ?_, ?_⟩
  · intro n
    by_cases hn : n = 0 <;> simp [hn]
  · intro n
    simp
  · intro M
    exact nsPrefixSum_single_zero_unit_le_one M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Sum-product phase-space label guard.

A Wigner/wavepacket or phase-space-owner label does not repair the owner
rebilling obstruction unless it supplies the selected-prefix owner-preimage
inequality.  The same one-owner profile satisfies the qualitative labels below
and still has an arbitrarily large selected-event prefix.
-/
theorem phaseSpaceOwnerLabelsWithoutPreimageBudget_allow_unboundedEventPrefix :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ atomBudget : Real,
      ∃ N : Nat,
        (∀ n : Nat, 0 ≤ atomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        True ∧
        True ∧
        True ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      hAtomNonneg, hPointwise, hBudget, hPrefix⟩ :=
    annularOwnerPointwiseBudget_allows_unbounded_eventPrefix B
  exact
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      hAtomNonneg, hPointwise, hBudget, True.intro, True.intro, True.intro,
      hPrefix⟩

/--
Microlocal-label version of the phase-space rebilling guard.

Adding qualitative spatial-marginal, wavefront, symplectic-flow, same-carrier,
and fixed-owner labels still does not produce a selected-prefix budget.  The
missing datum is numerical: a monotone reserve/drop or selected-prefix
owner-preimage inequality.
-/
theorem microlocalLabelsWithoutMonotoneReserve_allow_selectedTreeRebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ atomBudget : Real,
      ∃ N : Nat,
      ∃ spatialMarginalControlled : Prop,
      ∃ wavefrontLedgerControlled : Prop,
      ∃ symplecticFlowLabel : Prop,
      ∃ sameCarrierPacketLabel : Prop,
      ∃ ownerMapFixedBeforePayoffLabel : Prop,
        spatialMarginalControlled ∧
        wavefrontLedgerControlled ∧
        symplecticFlowLabel ∧
        sameCarrierPacketLabel ∧
        ownerMapFixedBeforePayoffLabel ∧
        (∀ n : Nat, 0 ≤ atomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      hAtomNonneg, hPointwise, hBudget, _, _, _, hPrefix⟩ :=
    phaseSpaceOwnerLabelsWithoutPreimageBudget_allow_unboundedEventPrefix B
  exact
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      True, True, True, True, True,
      True.intro, True.intro, True.intro, True.intro, True.intro,
      hAtomNonneg, hPointwise, hBudget, hPrefix⟩

/--
Lamb/helicity/frame label guard.

The Lamb identity, helicity density, Beltrami null channel, local vortex-frame
labels, Biot-Savart constraint labels, and Leray-projection gradient-kill label
are all auxiliary structure unless they produce a positive selected-prefix
payment.  Qualitative orthogonality still allows the same selected-tree
rebilling profile.
-/
theorem lambHelicityFrameLabelsWithoutPositiveReceipt_allow_selectedTreeRebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ atomBudget : Real,
      ∃ N : Nat,
      ∃ lambVectorCarrierTracked : Prop,
      ∃ helicityDensityTracked : Prop,
      ∃ beltramiNullChannelTracked : Prop,
      ∃ localVortexFrameTracked : Prop,
      ∃ biotSavartNonlocalConstraintTracked : Prop,
      ∃ lerayGradientChannelKilled : Prop,
        lambVectorCarrierTracked ∧
        helicityDensityTracked ∧
        beltramiNullChannelTracked ∧
        localVortexFrameTracked ∧
        biotSavartNonlocalConstraintTracked ∧
        lerayGradientChannelKilled ∧
        (∀ n : Nat, 0 ≤ atomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      _spatialMarginalControlled, _wavefrontLedgerControlled,
      _symplecticFlowLabel, _sameCarrierPacketLabel,
      _ownerMapFixedBeforePayoffLabel, _, _, _, _, _,
      hAtomNonneg, hPointwise, hBudget, hPrefix⟩ :=
    microlocalLabelsWithoutMonotoneReserve_allow_selectedTreeRebilling B
  exact
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      True, True, True, True, True, True,
      True.intro, True.intro, True.intro, True.intro, True.intro,
      True.intro, hAtomNonneg, hPointwise, hBudget, hPrefix⟩

/-- Concrete real Fourier three-vector used by the spectral-triad guard. -/
abbrev FourierV3 := Fin 3 → Real

/-- Coordinatewise addition for concrete Fourier three-vectors. -/
def fourierV3Add (a b : FourierV3) : FourierV3 :=
  fun i => a i + b i

/-- Concrete dot product on `FourierV3`. -/
def dot3 (a b : FourierV3) : Real :=
  a 0 * b 0 + a 1 * b 1 + a 2 * b 2

/-- Concrete cross product on `FourierV3`. -/
def cross3 (a b : FourierV3) : FourierV3 :=
  fun i =>
    if i = 0 then
      a 1 * b 2 - a 2 * b 1
    else if i = 1 then
      a 2 * b 0 - a 0 * b 2
    else
      a 0 * b 1 - a 1 * b 0

/-- Coordinate constructor for concrete Fourier three-vectors. -/
def mkFourierV3 (x y z : Real) : FourierV3 :=
  fun i => if i = 0 then x else if i = 1 then y else z

@[simp] theorem mkFourierV3_zero (x y z : Real) :
    mkFourierV3 x y z 0 = x := by
  simp [mkFourierV3]

@[simp] theorem mkFourierV3_one (x y z : Real) :
    mkFourierV3 x y z 1 = y := by
  simp [mkFourierV3]

@[simp] theorem mkFourierV3_two (x y z : Real) :
    mkFourierV3 x y z 2 = z := by
  have h20 : ¬ ((2 : Fin 3) = 0) := by decide
  have h21 : ¬ ((2 : Fin 3) = 1) := by decide
  simp [mkFourierV3, h20, h21]

@[simp] theorem cross3_zero (a b : FourierV3) :
    cross3 a b 0 = a 1 * b 2 - a 2 * b 1 := by
  simp [cross3]

@[simp] theorem cross3_one (a b : FourierV3) :
    cross3 a b 1 = a 2 * b 0 - a 0 * b 2 := by
  simp [cross3]

@[simp] theorem cross3_two (a b : FourierV3) :
    cross3 a b 2 = a 0 * b 1 - a 1 * b 0 := by
  have h20 : ¬ ((2 : Fin 3) = 0) := by decide
  have h21 : ¬ ((2 : Fin 3) = 1) := by decide
  simp [cross3, h20, h21]

/-- Fourier carrier for one closed resonant triad `k = p + q`. -/
structure ResonantTriad where
  k : FourierV3
  p : FourierV3
  q : FourierV3
  h_triad : k = fourierV3Add p q

/-- Velocity coefficients attached to a triad, with incompressibility typed
at each mode. -/
structure TriadState (triad : ResonantTriad) where
  u_k : FourierV3
  u_p : FourierV3
  u_q : FourierV3
  h_div_k : dot3 u_k triad.k = 0
  h_div_p : dot3 u_p triad.p = 0
  h_div_q : dot3 u_q triad.q = 0

/-- Vorticity Fourier coefficient generated by `p × u_p`. -/
def triadVorticityMode {triad : ResonantTriad}
    (state : TriadState triad) : FourierV3 :=
  cross3 triad.p state.u_p

/-- Raw Lamb-triad throughput before any shell aggregation.  This is the
coefficient-level object that scalar LP shell prices do not expose. -/
def rawLambTriadThroughput {triad : ResonantTriad}
    (state : TriadState triad) : Real :=
  dot3 state.u_k (cross3 (triadVorticityMode state) state.u_q)

/-- The zero Fourier vector, used only to witness that the triad type itself
is inhabited and therefore cannot be mistaken for a penalty. -/
def zeroFourierV3 : FourierV3 :=
  fun _ => 0

/-- Trivial resonant triad. -/
def zeroResonantTriad : ResonantTriad where
  k := zeroFourierV3
  p := zeroFourierV3
  q := zeroFourierV3
  h_triad := by
    funext i
    simp [zeroFourierV3, fourierV3Add]

/-- Trivial divergence-free state on the trivial triad. -/
def zeroTriadState : TriadState zeroResonantTriad where
  u_k := zeroFourierV3
  u_p := zeroFourierV3
  u_q := zeroFourierV3
  h_div_k := by simp [dot3, zeroFourierV3, zeroResonantTriad]
  h_div_p := by simp [dot3, zeroFourierV3, zeroResonantTriad]
  h_div_q := by simp [dot3, zeroFourierV3, zeroResonantTriad]

/-- A fixed non-degenerate triad `k = p + q`, with `p = e₁` and `q = e₂`. -/
def positiveThroughputTriad : ResonantTriad where
  k := mkFourierV3 1 1 0
  p := mkFourierV3 1 0 0
  q := mkFourierV3 0 1 0
  h_triad := by
    funext i
    fin_cases i <;> norm_num [mkFourierV3, fourierV3Add]

/-- Divergence-free triad state with adjustable Lamb throughput. -/
def positiveThroughputTriadState (A : Real) :
    TriadState positiveThroughputTriad where
  u_k := mkFourierV3 (-A) A 0
  u_p := mkFourierV3 0 0 1
  u_q := mkFourierV3 0 0 1
  h_div_k := by
    simp [positiveThroughputTriad, dot3]
  h_div_p := by
    norm_num [positiveThroughputTriad, dot3]
  h_div_q := by
    norm_num [positiveThroughputTriad, dot3]

/-- The explicit state has raw Lamb-triad throughput exactly `A`. -/
theorem rawLambTriadThroughput_positiveThroughputTriadState
    (A : Real) :
    rawLambTriadThroughput (positiveThroughputTriadState A) = A := by
  simp [rawLambTriadThroughput, triadVorticityMode, positiveThroughputTriadState,
    positiveThroughputTriad, dot3]

/--
Geometry-only obstruction for the Fourier-triad route.

The resonant relation, divergence-free coefficient frame, and raw Lamb
trilinear form by themselves impose no uniform throughput bound.  Any positive
receipt must therefore import a real source currency: amplitude/energy control,
projection injectivity, owner-preimage, no-rebilling, or a prefix budget.
-/
theorem resonantDivergenceFreeTriadGeometryAlone_allows_arbitraryRawLambThroughput :
    ∀ B : Real,
      ∃ triad : ResonantTriad,
      ∃ state : TriadState triad,
        B < rawLambTriadThroughput state := by
  intro B
  refine ⟨positiveThroughputTriad, positiveThroughputTriadState (B + 1), ?_⟩
  rw [rawLambTriadThroughput_positiveThroughputTriadState]
  linarith

/-- Positive receipt the spectral-triad route must supply.

The fields are intentionally stricter than a shell-level coherence price.  The
triad tensor must be fixed before shell aggregation, the phase/helicity data
must be declared before payoff, and the event-radius payment must be charged
through a prefix-bounded tensor penalty on the same carrier.
-/
structure FourierTriadPositivePenaltyReceipt
    (eventRadiusPayment ownerOfEvent atomCharge : Nat → Real)
    (atomBudget : Real) where
  triad : Nat → ResonantTriad
  state : ∀ n : Nat, TriadState (triad n)
  phasePenalty : Nat → Real
  phase_penalty_nonneg : ∀ n : Nat, 0 ≤ phasePenalty n
  lamb_throughput_controlled_by_phase_penalty :
    ∀ n : Nat, |rawLambTriadThroughput (state n)| ≤ phasePenalty n
  event_payment_le_phase_penalty :
    ∀ n : Nat, eventRadiusPayment n ≤ phasePenalty n
  phase_penalty_prefix_budget :
    ∀ M : Nat, NS.nsPrefixSum phasePenalty M ≤ atomBudget
  tensorGeometryDeclaredBeforeShellAggregation : Prop
  helicalSignsDeclaredBeforePayoff : Prop
  phaseCoordinatesDeclaredBeforePayoff : Prop
  sameCarrierAsSelectedTree : Prop
  ownerMapFixedBeforePayoff : Prop

/-- A positive spectral-triad penalty receipt really bounds the selected event
prefix.  This is the exact consumer missing from scalar shell-coherence labels. -/
theorem FourierTriadPositivePenaltyReceipt.eventPrefix_le_budget
    {eventRadiusPayment ownerOfEvent atomCharge : Nat → Real}
    {atomBudget : Real}
    (R :
      FourierTriadPositivePenaltyReceipt
        eventRadiusPayment ownerOfEvent atomCharge atomBudget)
    (M : Nat) :
    NS.nsPrefixSum eventRadiusPayment M ≤ atomBudget := by
  have hprefix :
      NS.nsPrefixSum eventRadiusPayment M ≤
        NS.nsPrefixSum R.phasePenalty M :=
    NS.ns_prefix_sum_le_of_pointwise
      eventRadiusPayment R.phasePenalty
      R.event_payment_le_phase_penalty M
  exact hprefix.trans (R.phase_penalty_prefix_budget M)

/--
Source-budgeted constructor surface for the spectral-triad route.

This is stronger than a pointwise Lamb tensor label.  It asks for the raw
triad throughput and selected event payments to be charged to the same
prefix-bounded source stream, with the owner/no-rebilling and separated PDE
payment channels declared on the same carrier.
-/
structure SourceBudgetedFourierTriadPenaltyReceipt
    (eventRadiusPayment ownerOfEvent atomCharge : Nat → Real)
    (atomBudget : Real) where
  triad : Nat → ResonantTriad
  state : ∀ n : Nat, TriadState (triad n)
  sourcePenalty : Nat → Real
  sourcePenalty_nonneg : ∀ n : Nat, 0 ≤ sourcePenalty n
  raw_lamb_throughput_controlled_by_source_penalty :
    ∀ n : Nat, |rawLambTriadThroughput (state n)| ≤ sourcePenalty n
  event_payment_le_source_penalty :
    ∀ n : Nat, eventRadiusPayment n ≤ sourcePenalty n
  source_penalty_prefix_budget :
    ∀ M : Nat, NS.nsPrefixSum sourcePenalty M ≤ atomBudget
  tensorGeometryDeclaredBeforeShellAggregation : Prop
  helicalSignsDeclaredBeforePayoff : Prop
  phaseCoordinatesDeclaredBeforePayoff : Prop
  sameCarrierAsSelectedTree : Prop
  ownerMapFixedBeforePayoff : Prop
  sourcePrefixBudgetPaid : Prop
  ownerPreimagePrefixInequalityPaid : Prop
  noRebillingFreshnessPaid : Prop
  ownerRootNumericBoundPaid : Prop
  noOverlapOrDisjointnessPaid : Prop
  sameOwnerOrSourceBindingPaid : Prop
  pressureReserveSeparated : Prop
  duhamelReserveSeparated : Prop
  inheritedReserveSeparated : Prop
  partitionTyped : Prop
  sectionIdentityTyped : Prop

/-- A source-budgeted spectral-triad receipt instantiates the positive receipt. -/
def SourceBudgetedFourierTriadPenaltyReceipt.to_positivePenaltyReceipt
    {eventRadiusPayment ownerOfEvent atomCharge : Nat → Real}
    {atomBudget : Real}
    (R :
      SourceBudgetedFourierTriadPenaltyReceipt
        eventRadiusPayment ownerOfEvent atomCharge atomBudget) :
    FourierTriadPositivePenaltyReceipt
      eventRadiusPayment ownerOfEvent atomCharge atomBudget where
  triad := R.triad
  state := R.state
  phasePenalty := R.sourcePenalty
  phase_penalty_nonneg := R.sourcePenalty_nonneg
  lamb_throughput_controlled_by_phase_penalty :=
    R.raw_lamb_throughput_controlled_by_source_penalty
  event_payment_le_phase_penalty := R.event_payment_le_source_penalty
  phase_penalty_prefix_budget := R.source_penalty_prefix_budget
  tensorGeometryDeclaredBeforeShellAggregation :=
    R.tensorGeometryDeclaredBeforeShellAggregation
  helicalSignsDeclaredBeforePayoff := R.helicalSignsDeclaredBeforePayoff
  phaseCoordinatesDeclaredBeforePayoff := R.phaseCoordinatesDeclaredBeforePayoff
  sameCarrierAsSelectedTree := R.sameCarrierAsSelectedTree
  ownerMapFixedBeforePayoff := R.ownerMapFixedBeforePayoff

/-- Consumer theorem for the source-budgeted route. -/
theorem SourceBudgetedFourierTriadPenaltyReceipt.eventPrefix_le_budget
    {eventRadiusPayment ownerOfEvent atomCharge : Nat → Real}
    {atomBudget : Real}
    (R :
      SourceBudgetedFourierTriadPenaltyReceipt
        eventRadiusPayment ownerOfEvent atomCharge atomBudget)
    (M : Nat) :
    NS.nsPrefixSum eventRadiusPayment M ≤ atomBudget :=
  FourierTriadPositivePenaltyReceipt.eventPrefix_le_budget
    R.to_positivePenaltyReceipt M

/--
Surplus/loss/projection source imported into the spectral-triad receipt.

The certificate pays the selected event stream through the projected ambient
source `C_proj * ambientCharge`.  The only Fourier-specific analytic input left
outside the certificate is the explicit pointwise bound on raw Lamb throughput.
-/
def SourceBudgetedFourierTriadPenaltyReceipt.ofSurplusLiftProjectionCertificate
    {eventRadiusPayment ownerOfEvent atomCharge : Nat → Real}
    (triad : Nat → ResonantTriad)
    (state : ∀ n : Nat, TriadState (triad n))
    (h :
      SurplusLiftProjectionSourceCertificate eventRadiusPayment)
    (hRaw :
      ∀ n : Nat,
        |rawLambTriadThroughput (state n)| ≤
          h.C_proj * h.ambientCharge n) :
    SourceBudgetedFourierTriadPenaltyReceipt
      eventRadiusPayment ownerOfEvent atomCharge
      (h.C_proj * h.ambientBudget) where
  triad := triad
  state := state
  sourcePenalty := fun n : Nat => h.C_proj * h.ambientCharge n
  sourcePenalty_nonneg := by
    intro n
    exact mul_nonneg h.C_proj_nonneg (h.ambientCharge_nonnegative n)
  raw_lamb_throughput_controlled_by_source_penalty := hRaw
  event_payment_le_source_penalty := h.pointwiseTargetPaidByProjectedAmbient
  source_penalty_prefix_budget :=
    h.projectedAmbientPrefix_le_budget
  tensorGeometryDeclaredBeforeShellAggregation :=
    h.ambientLiftDeclaredBeforePayoff
  helicalSignsDeclaredBeforePayoff :=
    h.constantsFixedBeforeLimit
  phaseCoordinatesDeclaredBeforePayoff :=
    h.constantsFixedBeforeLimit
  sameCarrierAsSelectedTree :=
    h.projectionInjectiveOrFiniteMultiplicity
  ownerMapFixedBeforePayoff :=
    h.constantsFixedBeforeLimit
  sourcePrefixBudgetPaid :=
    ∀ M : Nat,
      NS.nsPrefixSum (fun n : Nat => h.C_proj * h.ambientCharge n) M ≤
        h.C_proj * h.ambientBudget
  ownerPreimagePrefixInequalityPaid :=
    h.projectionInjectiveOrFiniteMultiplicity
  noRebillingFreshnessPaid :=
    h.noPostHocSelection
  ownerRootNumericBoundPaid :=
    0 ≤ h.C_proj * h.ambientBudget
  noOverlapOrDisjointnessPaid :=
    h.projectionInjectiveOrFiniteMultiplicity
  sameOwnerOrSourceBindingPaid :=
    h.projectionInjectiveOrFiniteMultiplicity
  pressureReserveSeparated :=
    h.quotientOrDenominatorLossUniform
  duhamelReserveSeparated :=
    ∀ n : Nat,
      h.productionSpend n + h.pressureReserveSpend n +
          h.duhamelReserveSpend n + h.inheritedReserveSpend n ≤
        h.ambientCharge n
  inheritedReserveSeparated :=
    ∀ N : Nat,
      NS.nsPrefixSum h.parentRadiusInvoiceSpend N ≤
        NS.nsPrefixSum h.ambientCharge N
  partitionTyped :=
    ∀ n : Nat,
      h.productionSpend n + h.pressureReserveSpend n +
          h.duhamelReserveSpend n + h.inheritedReserveSpend n ≤
        h.ambientCharge n
  sectionIdentityTyped :=
    ∀ n : Nat, h.parentRadiusInvoiceSpend n = eventRadiusPayment n

/-- Consumer form of the surplus/projection-to-triad adapter. -/
theorem sourceBudgetedTriad_eventPrefix_le_projectedAmbientBudget
    {eventRadiusPayment ownerOfEvent atomCharge : Nat → Real}
    (triad : Nat → ResonantTriad)
    (state : ∀ n : Nat, TriadState (triad n))
    (h :
      SurplusLiftProjectionSourceCertificate eventRadiusPayment)
    (hRaw :
      ∀ n : Nat,
        |rawLambTriadThroughput (state n)| ≤
          h.C_proj * h.ambientCharge n)
    (M : Nat) :
    NS.nsPrefixSum eventRadiusPayment M ≤
      h.C_proj * h.ambientBudget :=
  (SourceBudgetedFourierTriadPenaltyReceipt.ofSurplusLiftProjectionCertificate
    (eventRadiusPayment := eventRadiusPayment)
    (ownerOfEvent := ownerOfEvent)
    (atomCharge := atomCharge)
    triad state h hRaw).eventPrefix_le_budget M

/--
Spectral-triad tensor label guard.

Typing the resonant triad relation, divergence-free Fourier coefficients,
Lamb trilinear form, helicity signature label, phase-coherence label, and a
scalar shell-coherence price still does not supply the positive tensor-penalty
receipt above.  The one-owner selected-tree packet remains possible.
-/
theorem spectralTriadTensorLabelsWithoutPositivePenalty_allow_selectedTreeRebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ atomBudget : Real,
      ∃ N : Nat,
      ∃ triad : ResonantTriad,
      ∃ state : TriadState triad,
      ∃ shellCoherencePrice : Nat → Real,
      ∃ triadPhasePenalty : Nat → Real,
      ∃ resonantTriadManifoldTyped : Prop,
      ∃ divergenceFreeFrameTyped : Prop,
      ∃ lambTrilinearFormTyped : Prop,
      ∃ helicitySignatureTracked : Prop,
      ∃ phaseCoherenceTracked : Prop,
      ∃ shellAggregationAvailable : Prop,
        resonantTriadManifoldTyped ∧
        divergenceFreeFrameTyped ∧
        lambTrilinearFormTyped ∧
        helicitySignatureTracked ∧
        phaseCoherenceTracked ∧
        shellAggregationAvailable ∧
        rawLambTriadThroughput state = 0 ∧
        (∀ n : Nat, 0 ≤ shellCoherencePrice n) ∧
        (∀ n : Nat, 0 ≤ triadPhasePenalty n) ∧
        (∀ n : Nat, triadPhasePenalty n = 0) ∧
        (∀ n : Nat, 0 ≤ atomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      _lambVectorCarrierTracked, _helicityDensityTracked,
      _beltramiNullChannelTracked, _localVortexFrameTracked,
      _biotSavartNonlocalConstraintTracked, _lerayGradientChannelKilled,
      _, _, _, _, _, _, hAtomNonneg, hPointwise, hBudget, hPrefix⟩ :=
    lambHelicityFrameLabelsWithoutPositiveReceipt_allow_selectedTreeRebilling B
  exact
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      zeroResonantTriad, zeroTriadState,
      (fun _ : Nat => 0), (fun _ : Nat => 0),
      True, True, True, True, True, True,
      True.intro, True.intro, True.intro, True.intro, True.intro, True.intro,
      (by simp [rawLambTriadThroughput, triadVorticityMode, cross3, dot3,
        zeroTriadState, zeroFourierV3, zeroResonantTriad]),
      (fun _ : Nat => by norm_num),
      (fun _ : Nat => by norm_num),
      (fun _ : Nat => rfl),
      hAtomNonneg, hPointwise, hBudget, hPrefix⟩

/--
Pointwise source labels are still not a positive receipt.

Even after the resonant triad manifold, divergence-free frame, and Lamb
trilinear form are typed, a pointwise source penalty without a prefix budget
and no-rebilling owner binding allows the selected-event prefix to exceed any
budget.  The missing ingredient is the prefix-bounded same-source payment
receipt, not another geometric label.
-/
theorem sourceBudgetPointwiseLabelsWithoutPrefixNoRebilling_allow_selectedTreeRebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ atomBudget : Real,
      ∃ N : Nat,
      ∃ triad : ResonantTriad,
      ∃ state : TriadState triad,
      ∃ sourcePenalty : Nat → Real,
      ∃ resonantTriadManifoldTyped : Prop,
      ∃ divergenceFreeFrameTyped : Prop,
      ∃ lambTrilinearFormTyped : Prop,
        resonantTriadManifoldTyped ∧
        divergenceFreeFrameTyped ∧
        lambTrilinearFormTyped ∧
        rawLambTriadThroughput state = 0 ∧
        (∀ n : Nat, 0 ≤ sourcePenalty n) ∧
        (∀ n : Nat,
          |rawLambTriadThroughput state| ≤ sourcePenalty n) ∧
        (∀ n : Nat, eventRadiusPayment n ≤ sourcePenalty n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      triad, state, _shellCoherencePrice, _triadPhasePenalty,
      resonantTriadManifoldTyped, divergenceFreeFrameTyped,
      lambTrilinearFormTyped, _helicitySignatureTracked,
      _phaseCoherenceTracked, _shellAggregationAvailable,
      hResonant, hDivergence, hLamb, _hHelicity, _hPhase, _hShell,
      hRaw, _hShellPriceNonneg, _hTriadPenaltyNonneg, _hTriadPenaltyZero,
      hAtomNonneg, hPointwise, hBudget, hPrefix⟩ :=
    spectralTriadTensorLabelsWithoutPositivePenalty_allow_selectedTreeRebilling B
  refine
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      triad, state, (fun n : Nat => atomCharge (ownerOfEvent n)),
      resonantTriadManifoldTyped, divergenceFreeFrameTyped,
      lambTrilinearFormTyped,
      hResonant, hDivergence, hLamb, hRaw,
      (fun n : Nat => hAtomNonneg (ownerOfEvent n)),
      ?_, hPointwise, hPointwise, hBudget, hPrefix⟩
  intro n
  rw [hRaw]
  simpa using hAtomNonneg (ownerOfEvent n)

/-- Unit-distance / Golod-Shafarevich style lifted-carrier projection receipt.

This is the NS-side version of the arithmetic lift discipline: a large lifted
carrier, controlled projection loss, and a prime/congruence-like sink do not
pay the route until the projected triad penalty is tied to the selected events
and remains prefix-bounded after projection.
-/
structure LiftedTriadTowerProjectionReceipt
    (eventRadiusPayment : Nat → Real) (atomBudget : Real) where
  liftedDegree : Nat → Nat
  liftedSurplus : Nat → Real
  projectionLoss : Nat → Real
  projectedTriadPenalty : Nat → Real
  lifted_surplus_nonneg : ∀ n : Nat, 0 ≤ liftedSurplus n
  projection_loss_nonneg : ∀ n : Nat, 0 ≤ projectionLoss n
  projected_penalty_nonneg : ∀ n : Nat, 0 ≤ projectedTriadPenalty n
  projected_penalty_le_lifted_surplus_minus_loss :
    ∀ n : Nat, projectedTriadPenalty n ≤ liftedSurplus n - projectionLoss n
  event_payment_le_projected_triad_penalty :
    ∀ n : Nat, eventRadiusPayment n ≤ projectedTriadPenalty n
  projected_triad_penalty_prefix_budget :
    ∀ M : Nat, NS.nsPrefixSum projectedTriadPenalty M ≤ atomBudget
  towerDegreeGrowsBeforeProjection : Prop
  discriminantOrVolumeLossControlled : Prop
  primeSinkOrCongruenceSurplusDeclared : Prop
  projectionMapFixedBeforePayoff : Prop
  projectionInjectiveOnSelectedEvents : Prop
  noRebillingUnderProjection : Prop
  sameCarrierAsLambTriadTensor : Prop

/-- A lifted tower receipt bounds the selected event prefix only after the
projection-side penalty is paid on the same carrier. -/
theorem LiftedTriadTowerProjectionReceipt.eventPrefix_le_budget
    {eventRadiusPayment : Nat → Real} {atomBudget : Real}
    (R : LiftedTriadTowerProjectionReceipt eventRadiusPayment atomBudget)
    (M : Nat) :
    NS.nsPrefixSum eventRadiusPayment M ≤ atomBudget := by
  have hprefix :
      NS.nsPrefixSum eventRadiusPayment M ≤
        NS.nsPrefixSum R.projectedTriadPenalty M :=
    NS.ns_prefix_sum_le_of_pointwise
      eventRadiusPayment R.projectedTriadPenalty
      R.event_payment_le_projected_triad_penalty M
  exact hprefix.trans (R.projected_triad_penalty_prefix_budget M)

/--
Capacity/spectral-gap constructor boundary selected by the isomorphism pass.

The useful cross-domain pattern is not "capacity" vocabulary by itself.  It is
a same-carrier numerical receipt: local Leray/Biot-Savart/triad inputs plus a
global capacity or spectral-gap certificate must construct the existing
`SurplusLiftProjectionSourceCertificate`.  Once it does, the already-formal
sparse high-high ghost must be inadmissible for the same target stream.
-/
structure SameCarrierCapacityGapTriadSourceConstructor
    (eventRadiusPayment : Nat → Real) where
  localLerayBiotSavartTriadInputs : Prop
  localInputs_proof : localLerayBiotSavartTriadInputs
  capacityOrSpectralGapSameCarrierReceipt : Prop
  capacityReceipt_proof : capacityOrSpectralGapSameCarrierReceipt
  constructs_surplus_source :
    localLerayBiotSavartTriadInputs →
      capacityOrSpectralGapSameCarrierReceipt →
        SurplusLiftProjectionSourceCertificate eventRadiusPayment

/-- Any capacity/gap constructor must kill the sparse high-high ghost on the
same selected target stream. -/
theorem SameCarrierCapacityGapTriadSourceConstructor.excludes_sparseHighHighGhost
    {eventRadiusPayment : Nat → Real}
    (hCtor :
      SameCarrierCapacityGapTriadSourceConstructor eventRadiusPayment) :
    SparseHighHighCriticalSourceGhostPacket eventRadiusPayment → False := by
  intro hGhost
  exact
    no_surplusLiftProjectionSourceCertificate_of_sparseHighHighGhost hGhost
      (hCtor.constructs_surplus_source hCtor.localInputs_proof
        hCtor.capacityReceipt_proof)

/-- Equivalently: in the sparse high-high ghost regime, no local
Leray/Biot-Savart/triad-plus-capacity constructor can inhabit the surplus
source constructor boundary. -/
theorem no_sameCarrierCapacityGapTriadSourceConstructor_of_sparseHighHighGhost
    {eventRadiusPayment : Nat → Real}
    (hGhost : SparseHighHighCriticalSourceGhostPacket eventRadiusPayment) :
    SameCarrierCapacityGapTriadSourceConstructor eventRadiusPayment → False := by
  intro hCtor
  exact hCtor.excludes_sparseHighHighGhost hGhost

/--
Lifted-carrier analogy guard.

High-degree tower labels, controlled-discriminant labels, and prime-sink /
congruence-surplus labels are still only labels unless they project to a
same-carrier selected-triad penalty with no rebilling.  Without that
projection receipt, the old one-owner selected-tree packet remains possible.
-/
theorem liftedTowerLabelsWithoutProjectionPenalty_allow_selectedTreeRebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ atomBudget : Real,
      ∃ N : Nat,
      ∃ liftedDegree : Nat → Nat,
      ∃ liftedSurplus : Nat → Real,
      ∃ projectionLoss : Nat → Real,
      ∃ projectedTriadPenalty : Nat → Real,
      ∃ towerDegreeGrowsBeforeProjection : Prop,
      ∃ discriminantOrVolumeLossControlled : Prop,
      ∃ primeSinkOrCongruenceSurplusDeclared : Prop,
      ∃ projectionMapFixedBeforePayoff : Prop,
      ∃ physicalTriadProjectionTyped : Prop,
        towerDegreeGrowsBeforeProjection ∧
        discriminantOrVolumeLossControlled ∧
        primeSinkOrCongruenceSurplusDeclared ∧
        projectionMapFixedBeforePayoff ∧
        physicalTriadProjectionTyped ∧
        (∀ n : Nat, n ≤ liftedDegree n) ∧
        (∀ n : Nat, 0 ≤ liftedSurplus n) ∧
        (∀ n : Nat, 0 ≤ projectionLoss n) ∧
        (∀ n : Nat, projectedTriadPenalty n = 0) ∧
        (∀ n : Nat, 0 ≤ atomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      _triad, _state, _shellCoherencePrice, triadPhasePenalty,
      _resonantTriadManifoldTyped, _divergenceFreeFrameTyped,
      _lambTrilinearFormTyped, _helicitySignatureTracked,
      _phaseCoherenceTracked, _shellAggregationAvailable,
      _, _, _, _, _, _, _, _, _, hPenaltyZero,
      hAtomNonneg, hPointwise, hBudget, hPrefix⟩ :=
    spectralTriadTensorLabelsWithoutPositivePenalty_allow_selectedTreeRebilling B
  exact
    ⟨eventRadiusPayment, ownerOfEvent, atomCharge, atomBudget, N,
      (fun n : Nat => n), (fun _ : Nat => 0), (fun _ : Nat => 0),
      triadPhasePenalty, True, True, True, True, True,
      True.intro, True.intro, True.intro, True.intro, True.intro,
      (fun _ : Nat => le_rfl),
      (fun _ : Nat => by norm_num),
      (fun _ : Nat => by norm_num),
      hPenaltyZero,
      hAtomNonneg, hPointwise, hBudget, hPrefix⟩

/--
Branching owner-reuse guard.

Even the strongest possible per-lineage uniqueness does not imply a global
owner-preimage budget.  If every selected event lies on its own lineage, a
single owner atom can still be billed once per lineage, so each lineage looks
clean while the selected-tree prefix is unbounded.
-/
theorem perLineageUniqueness_allows_global_owner_rebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ lineageOfEvent : Nat → Nat,
      ∃ atomBudget : Real,
      ∃ N : Nat,
        (∀ i j : Nat,
          lineageOfEvent i = lineageOfEvent j → i = j) ∧
        (∀ n : Nat, ownerOfEvent n = 0) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun _ : Nat => 0,
      fun n : Nat => if n = 0 then (1 : Real) else 0,
      fun n : Nat => n, 1, N, ?_, ?_, ?_, ?_, ?_⟩
  · intro i j hlineage
    exact hlineage
  · intro n
    rfl
  · intro n
    simp
  · intro M
    exact nsPrefixSum_single_zero_unit_le_one M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
One-use invoice extraction still does not imply owner-lineage multiplicity.

This is the bridge-specific laundering guard exposed by TICK668: an invoice
schedule can be one-use/injective while the downstream owner map still assigns
every selected event to the same owner atom.  Therefore
`nonRebilling_fromInvoice` and extraction no-reuse are not substitutes for the
owner-lineage lift receipt.
-/
theorem oneUseInvoiceExtraction_allows_global_owner_rebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ invoiceOfEvent : Nat → Nat,
      ∃ atomBudget : Real,
      ∃ N : Nat,
        (∀ i j : Nat,
          invoiceOfEvent i = invoiceOfEvent j → i = j) ∧
        (∀ n : Nat, ownerOfEvent n = 0) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun _ : Nat => 0,
      fun n : Nat => if n = 0 then (1 : Real) else 0,
      fun n : Nat => n, 1, N, ?_, ?_, ?_, ?_, ?_⟩
  · intro i j hinvoice
    exact hinvoice
  · intro n
    rfl
  · intro n
    simp
  · intro M
    exact nsPrefixSum_single_zero_unit_le_one M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Map-level receipt that an owner map is controlled by invoice fibers.

This is the missing data behind the TICK668 owner-lineage lift: one-use invoice
extraction is useful only after the owner fibers are proved to refine those
invoice fibers.
-/
structure OwnerFibersBoundedByInvoiceFibers
    (ownerOfEvent invoiceOfEvent : Nat → Nat) where
  invoiceFiberAtMostOne :
    ∀ i j : Nat, invoiceOfEvent i = invoiceOfEvent j → i = j
  ownerFiberRefinesInvoiceFiber :
    ∀ i j : Nat, ownerOfEvent i = ownerOfEvent j →
      invoiceOfEvent i = invoiceOfEvent j

/--
If owner fibers refine one-use invoice fibers, each owner fiber is at most one
event.  This is the exact map-level bridge missing from bare invoice
non-rebilling.
-/
theorem OwnerFibersBoundedByInvoiceFibers.ownerFiberAtMostOne
    {ownerOfEvent invoiceOfEvent : Nat → Nat}
    (h : OwnerFibersBoundedByInvoiceFibers ownerOfEvent invoiceOfEvent) :
    ∀ i j : Nat, ownerOfEvent i = ownerOfEvent j → i = j := by
  intro i j howner
  exact h.invoiceFiberAtMostOne i j
    (h.ownerFiberRefinesInvoiceFiber i j howner)

/--
If the owner map itself is injective, it can serve as the invoice-fiber map.

This is the narrow positive escape from the old atom-wall family: not
"non-rebilling" in general, but an actual injectivity theorem for the owner map
used by the scaled transfer.
-/
def OwnerFibersBoundedByInvoiceFibers.ofOwnerMapInjective
    (ownerOfEvent : Nat → Nat)
    (ownerMapInjective :
      ∀ i j : Nat, ownerOfEvent i = ownerOfEvent j → i = j) :
    OwnerFibersBoundedByInvoiceFibers ownerOfEvent ownerOfEvent where
  invoiceFiberAtMostOne := ownerMapInjective
  ownerFiberRefinesInvoiceFiber := by
    intro i j howner
    exact howner

/--
Bounded local fanout still does not imply global owner-preimage packing.

The witness is a one-child-per-parent schedule, so local fanout is as small as
possible.  All selected events nevertheless bill the same owner atom.  This
separates bounded tree/fanout language from the numerical selected-prefix
preimage theorem required by `OwnerPreimagePackingReceipt`.
-/
theorem boundedTreeFanout_pointwiseOwnerBudget_allows_unbounded_ownerPreimagePrefix :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ atomCharge : Nat → Real,
      ∃ parentOfEvent : Nat → Nat,
      ∃ atomBudget : Real,
      ∃ N : Nat,
        (∀ i j : Nat,
          parentOfEvent i = parentOfEvent j → i = j) ∧
        (∀ n : Nat, ownerOfEvent n = 0) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ atomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum atomCharge M ≤ atomBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun _ : Nat => 0,
      fun n : Nat => if n = 0 then (1 : Real) else 0,
      fun n : Nat => n, 1, N, ?_, ?_, ?_, ?_, ?_⟩
  · intro i j hparent
    exact hparent
  · intro n
    rfl
  · intro n
    simp
  · intro M
    exact nsPrefixSum_single_zero_unit_le_one M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Low-high catalyst rebilling guard.

The owner map must charge the full output-scale bilinear/source packet, not a
single reusable low-frequency factor.  Otherwise one catalyst factor can be
credited as the owner of infinitely many fresh high-frequency outputs; each
output is locally paid by a product packet, while the factor-only owner budget
stays finite.
-/
theorem factorOnlyOwner_allows_lowHighCatalyst_rebilling :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ factorOwnerOfEvent : Nat → Nat,
      ∃ factorCharge : Nat → Real,
      ∃ outputPacketOfEvent : Nat → Nat,
      ∃ outputPacketCharge : Nat → Real,
      ∃ factorBudget : Real,
      ∃ N : Nat,
        (∀ n : Nat, factorOwnerOfEvent n = 0) ∧
        (∀ n : Nat, outputPacketOfEvent n = n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ outputPacketCharge (outputPacketOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum factorCharge M ≤ factorBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun _ : Nat => 0,
      fun n : Nat => if n = 0 then (1 : Real) else 0,
      fun n : Nat => n, fun _ : Nat => (1 : Real), 1, N,
      ?_, ?_, ?_, ?_, ?_⟩
  · intro n
    rfl
  · intro n
    rfl
  · intro n
    simp
  · intro M
    exact nsPrefixSum_single_zero_unit_le_one M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Currency-normalization guard for same-carrier packing.

A packing receipt of the form `c * route <= fresh` is not an unscaled owner
payment unless one also has a unit lower bound on `c` or rescales the owner atom
charge and its budget.  This is the arithmetic obstruction to promoting
same-carrier packing directly into an owner-preimage receipt.
-/
theorem scaledPackingPayment_does_not_imply_unscaledOwnerPayment :
    ∃ c route fresh : Real,
      0 < c ∧ c * route ≤ fresh ∧ ¬ route ≤ fresh := by
  refine ⟨(1 : Real) / 2, 2, 1, ?_, ?_, ?_⟩ <;> norm_num

/--
Scaling the atom currency fixes the `c` mismatch but not owner rebilling.

Even with the correctly scaled atom charge and a finite scaled budget, one owner
atom can still be reused by every selected event unless the proof supplies the
global owner-preimage prefix theorem.
-/
theorem scaledAtomCurrency_allows_oneOwnerRebilling_withoutPreimagePrefix :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ scaledAtomCharge : Nat → Real,
      ∃ scaledBudget : Real,
      ∃ N : Nat,
        (∀ n : Nat, 0 ≤ scaledAtomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ scaledAtomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum scaledAtomCharge M ≤ scaledBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun _ : Nat => 0,
      fun n : Nat => if n = 0 then (1 : Real) else 0, 1, N,
      ?_, ?_, ?_, ?_⟩
  · intro n
    by_cases hn : n = 0 <;> simp [hn]
  · intro n
    simp
  · intro M
    exact nsPrefixSum_single_zero_unit_le_one M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Qualitative owner diversity is still not owner-preimage packing.

Even if the owner map is nonconstant and ranges over only two owner atoms, the
same finite atom palette can be billed by infinitely many selected events.  This
kills the weak repair "make the owner map nonconstant" unless it is upgraded to
a quantitative selected-prefix preimage theorem for positive event payments.
-/
theorem finiteOwnerPalette_nonconstantOwner_allows_unbounded_scaledPrefix :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ scaledAtomCharge : Nat → Real,
      ∃ scaledBudget : Real,
      ∃ N : Nat,
        (∀ n : Nat, ownerOfEvent n < 2) ∧
        (∃ i j : Nat, ownerOfEvent i ≠ ownerOfEvent j) ∧
        (∀ n : Nat, 0 ≤ scaledAtomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ scaledAtomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum scaledAtomCharge M ≤ scaledBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun n : Nat => if n = 0 then 0 else 1,
      fun n : Nat => if n < 2 then (1 : Real) else 0, 2, N,
      ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro n
    by_cases hn : n = 0 <;> simp [hn]
  · exact ⟨0, 1, by simp⟩
  · intro n
    by_cases hn : n < 2 <;> simp [hn]
  · intro n
    by_cases hn : n = 0 <;> simp [hn]
  · intro M
    exact nsPrefixSum_two_atom_unit_le_two M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Active-owner cutoffs still do not replace the prefix inequality.

This strengthens the finite-palette counterpacket by adding the same
`ownerOfEvent e < activeOwnerAtomBound N` shape used in
`OwnerPreimagePackingReceipt`.  A fixed active owner cutoff and pointwise scaled
payment still allow selected event prefixes to diverge unless the numerical
preimage-prefix inequality itself is proved.
-/
theorem activeOwnerBound_pointwisePayment_allows_unbounded_scaledPrefix :
    ∀ B : Real,
      ∃ eventRadiusPayment : Nat → Real,
      ∃ ownerOfEvent : Nat → Nat,
      ∃ scaledAtomCharge : Nat → Real,
      ∃ activeOwnerAtomBound : Nat → Nat,
      ∃ scaledBudget : Real,
      ∃ multiplicityBound : Real,
      ∃ N : Nat,
        (∀ {e M : Nat}, e < M → ownerOfEvent e < activeOwnerAtomBound M) ∧
        (∃ i j : Nat, ownerOfEvent i ≠ ownerOfEvent j) ∧
        (0 ≤ multiplicityBound) ∧
        (∀ n : Nat, 0 ≤ scaledAtomCharge n) ∧
        (∀ n : Nat,
          eventRadiusPayment n ≤ scaledAtomCharge (ownerOfEvent n)) ∧
        (∀ M : Nat, NS.nsPrefixSum scaledAtomCharge M ≤ scaledBudget) ∧
        B < NS.nsPrefixSum eventRadiusPayment N := by
  intro B
  obtain ⟨N, hN⟩ := exists_nat_gt B
  refine
    ⟨fun _ : Nat => (1 : Real), fun n : Nat => if n = 0 then 0 else 1,
      fun n : Nat => if n < 2 then (1 : Real) else 0,
      fun _ : Nat => 2, 2, 1, N, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro e M _heM
    by_cases he : e = 0 <;> simp [he]
  · exact ⟨0, 1, by simp⟩
  · norm_num
  · intro n
    by_cases hn : n < 2 <;> simp [hn]
  · intro n
    by_cases hn : n = 0 <;> simp [hn]
  · intro M
    exact nsPrefixSum_two_atom_unit_le_two M
  · rw [nsPrefixSum_const_one_real]
    exact hN

/--
Scale-clock guard for the de-anchored C7 pass.

A finite owner/event budget is a budget statement, not by itself an exclusion
of infinitely many selected scales.  To turn a budget into scale exclusion one
also needs a lower clock payment per selected scale, or a separate theorem that
the summable-payment branch forces regularity/porosity.  The degenerate zero
payment profile is intentionally minimal: it records the logical gap that a
finite prefix budget alone cannot count selected scales.
-/
theorem finiteBudget_withoutScaleClockLowerBound_allows_infiniteSelectedEvents :
    ∃ selected : Nat → Prop,
    ∃ eventPay : Nat → Real,
    ∃ budget : Real,
      (∀ n : Nat, selected n) ∧
      (∀ N : Nat, NS.nsPrefixSum eventPay N ≤ budget) ∧
      (∀ c : Real, 0 < c → ∃ n : Nat, selected n ∧ eventPay n < c) := by
  refine ⟨fun _ : Nat => True, fun _ : Nat => 0, 0, ?_, ?_, ?_⟩
  · intro n
    trivial
  · intro N
    rw [nsPrefixSum_zero_real]
  · intro c hc
    exact ⟨0, trivial, hc⟩

/--
C7 scale-clock dichotomy target.

The owner-preimage/no-rebilling receipt kills the branch where the projected
route-active-tail prefixes exceed every finite budget.  It does not address a
lacunary residual-fresh cascade whose per-scale payments are summable.  This
record names the missing game split: either the active tail supplies a
non-summable scale clock, or the summable branch must itself imply a regular
slab / porosity / epsilon-regularity scale.
-/
structure C7ScaleClockDichotomy
    (routeActiveTail : Nat → Real) where
  selectedScale : Nat → Prop
  infiniteResidualFreshScaleCascade : Prop
  divergentActiveTailBranch : Prop
  summableFreshTailBranch : Prop
  branchPartition :
    infiniteResidualFreshScaleCascade →
      divergentActiveTailBranch ∨ summableFreshTailBranch
  divergentBranchKilledByOwnerPacking : Prop
  summableBranchRoutedToFiniteTailAmortizedStrictness : Prop
  summableBranchForcesRegularSlabOrPorosity : Prop
  finiteOwnerBudgetAloneDoesNotExcludeSummableBranch : Prop
  scaleClockLowerBoundOrRegularityNeeded : Prop
  notRadiusBudgetOnly : Prop
  notClayClaim : Prop

/-- Projection of the named C7 scale-clock dichotomy. -/
theorem C7ScaleClockDichotomy.branch
    {routeActiveTail : Nat → Real}
    (h : C7ScaleClockDichotomy routeActiveTail)
    (hInf : h.infiniteResidualFreshScaleCascade) :
    h.divergentActiveTailBranch ∨ h.summableFreshTailBranch :=
  h.branchPartition hInf

private lemma nsPrefixSum_const_mul_left (c : Real) (a : Nat → Real) :
    ∀ N : Nat,
      NS.nsPrefixSum (fun n : Nat => c * a n) N =
        c * NS.nsPrefixSum a N := by
  intro N
  induction N with
  | zero =>
      simp [NS.nsPrefixSum]
  | succ N ih =>
      rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ, ih]
      ring

/--
TICK666 Hall-cut sharpness witness.

Reusing one positive state price at every selected bad state can satisfy the
pointwise pricing inequality, but it cannot provide a finite-prefix budget.
This is the state-pricing/max-flow form of the same-packet rebilling
obstruction: the missing PDE theorem must produce fresh annular capacity, not
one local capacity relabelled at every depth.
-/
theorem reusedStatePrice_prefix_exceeds_any_real
    (c B : Real) (hc : 0 < c) :
    ∃ activeTail : Nat → Real,
    ∃ freshCharge : Nat → Real,
    ∃ N : Nat,
      (∀ n : Nat, c * activeTail n ≤ freshCharge n) ∧
      (∀ n : Nat, freshCharge n = c) ∧
      B < NS.nsPrefixSum freshCharge N := by
  obtain ⟨N, hN⟩ := exists_nat_gt (B / c)
  have hmul : c * (B / c) < c * (N : Real) :=
    mul_lt_mul_of_pos_left hN hc
  have hcne : c ≠ 0 := ne_of_gt hc
  have hleft : c * (B / c) = B := by
    field_simp [hcne]
  rw [hleft] at hmul
  refine ⟨fun _ : Nat => (1 : Real), fun _ : Nat => c, N, ?_, ?_, ?_⟩
  · intro n
    linarith
  · intro n
    rfl
  · have hcharge :
        NS.nsPrefixSum (fun _ : Nat => c) N =
          c * NS.nsPrefixSum (fun _ : Nat => (1 : Real)) N := by
      simpa using nsPrefixSum_const_mul_left c (fun _ : Nat => (1 : Real)) N
    rw [hcharge, nsPrefixSum_const_one_real]
    exact hmul

/--
Fresh-annular prefix budget consumer.

This is the positive algebraic skeleton that the reuse guards say is missing:
active tails must be paid by a fresh charge on the same carrier, and that fresh
charge must have a prefix budget fixed before payoff.  The structure is only a
consumer of such a theorem; it does not source the fresh-annular injection or
the PDE monotone reserve drop.
-/
structure FreshAnnularChargePrefixBudgetSource where
  activeTail : Nat → Real
  freshCharge : Nat → Real
  c : Real
  rootBudget : Real
  c_pos : 0 < c
  pointwiseFreshPayment :
    ∀ n : Nat, c * activeTail n ≤ freshCharge n
  freshChargePrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum freshCharge N ≤ rootBudget
  assignedBeforePayoff : Prop
  sameCarrierAsRouteTail : Prop
  nonRebillingOnPacketLineages : Prop
  freshAnnularInjectionOrReserveDropSourced : Prop
  noLocalDominationOnlyClaim : Prop

/--
Once the fresh-annular prefix budget is genuinely sourced, active-tail prefixes
are bounded.  This is deliberately one-way: it consumes a no-reuse/fresh-reserve
theorem rather than deriving that theorem from local domination.
-/
theorem activeTailPrefix_le_rootBudget_div_c_of_freshAnnularChargePrefixBudget
    (h : FreshAnnularChargePrefixBudgetSource) :
    ∀ N : Nat, NS.nsPrefixSum h.activeTail N ≤ h.rootBudget / h.c := by
  intro N
  have hpoint :
      NS.nsPrefixSum (fun n : Nat => h.c * h.activeTail n) N ≤
        NS.nsPrefixSum h.freshCharge N :=
    NS.ns_prefix_sum_le_of_pointwise
      (fun n : Nat => h.c * h.activeTail n) h.freshCharge
      h.pointwiseFreshPayment N
  rw [nsPrefixSum_const_mul_left] at hpoint
  have hbudget : h.c * NS.nsPrefixSum h.activeTail N ≤ h.rootBudget := by
    exact le_trans hpoint (h.freshChargePrefixBudget N)
  have hbudget' : NS.nsPrefixSum h.activeTail N * h.c ≤ h.rootBudget := by
    simpa [mul_comm] using hbudget
  exact (le_div_iff₀ h.c_pos).2 hbudget'

private lemma nsPrefixSum_reserve_drop_add
    (reserve recharge : Nat → Real) :
    ∀ N : Nat,
      NS.nsPrefixSum
          (fun n : Nat => reserve n - reserve (n + 1) + recharge n) N =
        reserve 0 - reserve N + NS.nsPrefixSum recharge N := by
  intro N
  induction N with
  | zero =>
      simp [NS.nsPrefixSum]
  | succ N ih =>
      rw [NS.ns_prefix_sum_succ, NS.ns_prefix_sum_succ, ih]
      ring

/--
Predictable reserve-drop source for the fresh-annular prefix consumer.

This is the concrete PDE shape behind the Hall/cut wording.  A fresh charge is
not a reused scalar price; it is the per-step drop of a predeclared reserve,
plus a separately budgeted recharge/error term.  The theorem below is only the
telescoping consumer.  The remaining hard PDE input is proving the pointwise
payment from an actual annular packet identity.
-/
structure FreshAnnularPredictableReserveDropSource where
  activeTail : Nat → Real
  reserve : Nat → Real
  recharge : Nat → Real
  c : Real
  rootBudget : Real
  rechargeBudget : Real
  c_pos : 0 < c
  reserve_nonneg : ∀ n : Nat, 0 ≤ reserve n
  reserve_zero_le_rootBudget : reserve 0 ≤ rootBudget
  rechargePrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum recharge N ≤ rechargeBudget
  pointwiseReservePayment :
    ∀ n : Nat,
      c * activeTail n ≤ reserve n - reserve (n + 1) + recharge n
  reserveFixedBeforePayoff : Prop
  sameCarrierReserveDrop : Prop
  rechargeBookedSeparately : Prop
  noDescendantReserveRebilling : Prop
  noPostHocReserveDefinition : Prop

/--
The predictable reserve-drop source supplies a fresh-annular prefix budget by
telescoping the reserve and charging the separately budgeted recharge.
-/
def FreshAnnularChargePrefixBudgetSource.ofPredictableReserveDropSource
    (h : FreshAnnularPredictableReserveDropSource) :
    FreshAnnularChargePrefixBudgetSource where
  activeTail := h.activeTail
  freshCharge :=
    fun n : Nat => h.reserve n - h.reserve (n + 1) + h.recharge n
  c := h.c
  rootBudget := h.rootBudget + h.rechargeBudget
  c_pos := h.c_pos
  pointwiseFreshPayment := h.pointwiseReservePayment
  freshChargePrefixBudget := by
    intro N
    rw [nsPrefixSum_reserve_drop_add]
    have hN := h.reserve_nonneg N
    have h0 := h.reserve_zero_le_rootBudget
    have hrec := h.rechargePrefixBudget N
    nlinarith
  assignedBeforePayoff := h.reserveFixedBeforePayoff
  sameCarrierAsRouteTail := h.sameCarrierReserveDrop
  nonRebillingOnPacketLineages := h.noDescendantReserveRebilling
  freshAnnularInjectionOrReserveDropSourced :=
    h.sameCarrierReserveDrop ∧ h.rechargeBookedSeparately
  noLocalDominationOnlyClaim :=
    h.noPostHocReserveDefinition

/--
Readable consequence of the predictable reserve-drop source: active-tail
prefixes are bounded by initial reserve plus recharge, divided by the positive
payment coefficient.
-/
theorem activeTailPrefix_le_predictableReserveDropBudget
    (h : FreshAnnularPredictableReserveDropSource) :
    ∀ N : Nat,
      NS.nsPrefixSum h.activeTail N ≤
        (h.rootBudget + h.rechargeBudget) / h.c := by
  intro N
  exact
    activeTailPrefix_le_rootBudget_div_c_of_freshAnnularChargePrefixBudget
      (FreshAnnularChargePrefixBudgetSource.ofPredictableReserveDropSource h)
      N

/--
Event-prefix bridge to the reserve normal form.

The graph basin supplies many event-level prefix budgets.  This record names
the exact extra field needed for such a budget to become a predictable reserve
source: the route active tail must be pointwise paid by the same event charge.
Without that field, the event ledger may be finite while the active tail is an
unrelated unbounded sequence.
-/
structure EventPrefixToPredictableReserveBridgeData where
  activeTail : Nat → Real
  eventCharge : Nat → Real
  c : Real
  eventBudget : Real
  c_pos : 0 < c
  pointwiseEventPayment :
    ∀ n : Nat, c * activeTail n ≤ eventCharge n
  eventChargePrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum eventCharge N ≤ eventBudget
  eventLedgerFixedBeforePayoff : Prop
  sameCarrierEventCharge : Prop
  eventChargeNonRebilling : Prop
  noPostHocEventDefinition : Prop

/--
If the active tail is paid pointwise by a finite event ledger, the event ledger
itself induces a predictable reserve with zero recharge.  The reserve is the
remaining event budget after the prefix already spent.
-/
def FreshAnnularPredictableReserveDropSource.ofEventPrefixBridgeData
    (h : EventPrefixToPredictableReserveBridgeData) :
    FreshAnnularPredictableReserveDropSource where
  activeTail := h.activeTail
  reserve := fun N : Nat => h.eventBudget - NS.nsPrefixSum h.eventCharge N
  recharge := fun _ : Nat => 0
  c := h.c
  rootBudget := h.eventBudget
  rechargeBudget := 0
  c_pos := h.c_pos
  reserve_nonneg := by
    intro N
    have hN := h.eventChargePrefixBudget N
    linarith
  reserve_zero_le_rootBudget := by
    simp [NS.nsPrefixSum]
  rechargePrefixBudget := by
    intro N
    rw [nsPrefixSum_zero_real]
  pointwiseReservePayment := by
    intro n
    change
      h.c * h.activeTail n ≤
        (h.eventBudget - NS.nsPrefixSum h.eventCharge n) -
          (h.eventBudget - NS.nsPrefixSum h.eventCharge (n + 1)) +
            (fun _ : Nat => (0 : Real)) n
    have hdrop :
        (h.eventBudget - NS.nsPrefixSum h.eventCharge n) -
            (h.eventBudget - NS.nsPrefixSum h.eventCharge (n + 1)) +
              (0 : Real) =
          h.eventCharge n := by
      rw [NS.ns_prefix_sum_succ]
      ring
    rw [hdrop]
    exact h.pointwiseEventPayment n
  reserveFixedBeforePayoff := h.eventLedgerFixedBeforePayoff
  sameCarrierReserveDrop := h.sameCarrierEventCharge
  rechargeBookedSeparately := True
  noDescendantReserveRebilling := h.eventChargeNonRebilling
  noPostHocReserveDefinition := h.noPostHocEventDefinition

/--
Specialization of the event-prefix bridge to the graph-basin
fresh-frequency same-tree lock.

The lock already has the finite event weighted-gain prefix budget.  The only
new numerical bridge field is the pointwise comparison from the route active
tail to the same event charge.
-/
def EventPrefixToPredictableReserveBridgeData.ofFreshFrequencySameTreeLock
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (activeTail : Nat → Real) (c : Real) (hc : 0 < c)
    (hPoint :
      ∀ n : Nat,
        c * activeTail n ≤ L.eventWeight n * (L.eventGain n) ^ (2 : Nat))
    (hSameCarrier : Prop) (hNoRebill : Prop) (hNoPostHoc : Prop) :
    EventPrefixToPredictableReserveBridgeData where
  activeTail := activeTail
  eventCharge :=
    fun n : Nat => L.eventWeight n * (L.eventGain n) ^ (2 : Nat)
  c := c
  eventBudget := L.priceBudget
  c_pos := hc
  pointwiseEventPayment := hPoint
  eventChargePrefixBudget := by
    intro N
    simpa [NS.eventWeightedGainPricePrefix]
      using hLock.finiteIndependentEnstrophyDuhamelBudget N
  eventLedgerFixedBeforePayoff := hLock.nonadaptiveBeforeRadiusAccounting
  sameCarrierEventCharge := hSameCarrier
  eventChargeNonRebilling := hNoRebill
  noPostHocEventDefinition := hNoPostHoc

/--
Positive bridge from the graph-basin same-tree lock to the reserve normal form,
conditional on the one missing active-tail/event-charge comparison.
-/
def FreshAnnularPredictableReserveDropSource.ofFreshFrequencySameTreeLock
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (activeTail : Nat → Real) (c : Real) (hc : 0 < c)
    (hPoint :
      ∀ n : Nat,
        c * activeTail n ≤ L.eventWeight n * (L.eventGain n) ^ (2 : Nat))
    (hSameCarrier : Prop) (hNoRebill : Prop) (hNoPostHoc : Prop) :
    FreshAnnularPredictableReserveDropSource :=
  FreshAnnularPredictableReserveDropSource.ofEventPrefixBridgeData
    (EventPrefixToPredictableReserveBridgeData.ofFreshFrequencySameTreeLock
      hLock activeTail c hc hPoint hSameCarrier hNoRebill hNoPostHoc)

/--
The event-ordered bad-center beta-square tail.  This is the first concrete
source candidate for the previously arbitrary `activeTail` in the reserve
bridge: each event is charged by the radius of its selected bad node times the
square beta number of that same node.
-/
def badCenterBetaSquareEventActiveTail
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier) :
    Nat → Real :=
  fun e : Nat =>
    hCarrier.nodeRadius (hEvents.eventToBadNode e) *
      (hBeta.betaNumber (hEvents.eventToBadNode e)) ^ (2 : Nat)

/--
Source theorem for the reserve bridge: once the event ledger is pointwise
identified with bad-center beta-square radius, the same event charge pays the
bad-center active tail with coefficient one.  No prefix, reserve, or endpoint
summation is used here.
-/
theorem badCenterBetaSquareEventActiveTail_paid_by_eventCharge
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hPoint :
      BadCenterEventPointwiseBetaSquareIdentity
        seq K hRho hCarrier hBeta hEvents L) :
    ∀ n : Nat,
      (1 : Real) *
          badCenterBetaSquareEventActiveTail (hBeta := hBeta) hEvents n ≤
        L.eventWeight n * (L.eventGain n) ^ (2 : Nat) := by
  intro n
  dsimp [badCenterBetaSquareEventActiveTail]
  rw [hPoint.eventWeight_eq_nodeRadius, hPoint.eventGain_eq_betaNumber]
  simp

/--
Typed source packet for the pointwise bad-center beta-square event source.

This is intentionally more verbose than the proof above: the pointwise algebra
is easy, but the single-spend surface must keep production, Duhamel, pressure,
inherited/no-reuse, partition, section identity, and timing receipts separated.
-/
structure BadCenterBetaSquareEventActiveTailSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L} where
  sameTreeLockFixedBeforeReservePayoff :
    FreshFrequencyEventSameTreeLock
      seq K hRho hCarrier hBeta hEvents L hScale hInc
  productionPointwiseIdentity :
    BadCenterEventPointwiseBetaSquareIdentity
      seq K hRho hCarrier hBeta hEvents L
  activeTail : Nat → Real
  activeTail_eq_badCenterBetaSquareEventActiveTail :
    activeTail =
      badCenterBetaSquareEventActiveTail (hBeta := hBeta) hEvents
  pointwiseEventPayment :
    ∀ n : Nat,
      (1 : Real) * activeTail n ≤
        L.eventWeight n * (L.eventGain n) ^ (2 : Nat)
  duhamelReservePrefixBudgetSource :
    FreshFrequencyEventSameTreeLock
      seq K hRho hCarrier hBeta hEvents L hScale hInc
  pressureReserveSameCarrierLock :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  inheritedReserveNoReuseLock :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  partitionInvoicePrefixDomination :
    FreshFrequencyPrefixDominationFromSubprimitives
      seq K hRho hCarrier hBeta hEvents L hScale hInc
  sectionIdentityPointwiseReceipt :
    BadCenterEventPointwiseBetaSquareIdentity
      seq K hRho hCarrier hBeta hEvents L
  no_reuseDescendantChargingLock :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L

/--
Construct the typed source packet from the two genuine inputs: the same-tree
event lock and the pointwise event/bad-center beta-square identity.
-/
def BadCenterBetaSquareEventActiveTailSource.ofPointwiseIdentityAndLock
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hPoint :
      BadCenterEventPointwiseBetaSquareIdentity
        seq K hRho hCarrier hBeta hEvents L) :
    BadCenterBetaSquareEventActiveTailSource
      (hBeta := hBeta) (hEvents := hEvents) (L := L)
      (hScale := hScale) (hInc := hInc) where
  sameTreeLockFixedBeforeReservePayoff := hLock
  productionPointwiseIdentity := hPoint
  activeTail :=
    badCenterBetaSquareEventActiveTail (hBeta := hBeta) hEvents
  activeTail_eq_badCenterBetaSquareEventActiveTail := rfl
  pointwiseEventPayment :=
    badCenterBetaSquareEventActiveTail_paid_by_eventCharge hPoint
  duhamelReservePrefixBudgetSource := hLock
  pressureReserveSameCarrierLock := hLock.pressureLock
  inheritedReserveNoReuseLock := hLock.boundedFanoutNoLogReuse
  partitionInvoicePrefixDomination := hLock.prefixDominationFromSubprimitives
  sectionIdentityPointwiseReceipt := hPoint
  no_reuseDescendantChargingLock := hLock.boundedFanoutNoLogReuse

/--
Proof-carrying cofinal selected-tree incidence.

This is the first receipt below the schedule frontier: the event stream must
be exactly the selected bad-node tree, not merely a same-themed event ledger.
-/
structure BadCenterCofinalSelectedTreeIncidenceReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier) where
  eventToBadNode_mem_selected :
    ∀ e : Nat, hEvents.eventToBadNode e ∈ hCarrier.selectedBadNodes
  selectedBadNode_has_event :
    ∀ Q : DyadicParabolicCube,
      Q ∈ hCarrier.selectedBadNodes → ∃ e : Nat, hEvents.eventToBadNode e = Q
  noPostHocEventChoiceFromRadiusSum_proof :
    hEvents.noPostHocEventChoiceFromRadiusSum
  eventOrderingMatchesBadTree_proof :
    hEvents.eventOrderingMatchesBadTree
  eventMultiplicityCountsSelectedNodes_proof :
    hEvents.eventMultiplicityCountsSelectedNodes

/-- Cofinal incidence identifies the event image with the selected bad tree. -/
theorem BadCenterCofinalSelectedTreeIncidenceReceipt.eventImage_eq_selectedBadNodes
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    (h : BadCenterCofinalSelectedTreeIncidenceReceipt hEvents) :
    {Q : DyadicParabolicCube | ∃ e : Nat, hEvents.eventToBadNode e = Q} =
      hCarrier.selectedBadNodes := by
  ext Q
  constructor
  · intro hQ
    rcases hQ with ⟨e, rfl⟩
    exact h.eventToBadNode_mem_selected e
  · intro hQ
    exact h.selectedBadNode_has_event Q hQ

/--
Route active-tail identification receipt.

The reserve source may use an arbitrary route active-tail schedule only after a
separate receipt identifies that schedule with the event-ordered bad-center
beta-square charge.  This prevents defining the route tail after seeing the
event ledger.
-/
structure C7RouteActiveTailEventBetaSquareIdentification
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (routeActiveTail : Nat → Real) where
  cofinalSelectedTreeIncidence :
    BadCenterCofinalSelectedTreeIncidenceReceipt hEvents
  pointwiseBetaSquareIdentity :
    BadCenterEventPointwiseBetaSquareIdentity
      seq K hRho hCarrier hBeta hEvents L
  activeTail_eq_eventBetaSquare :
    routeActiveTail =
      badCenterBetaSquareEventActiveTail (hBeta := hBeta) hEvents
  routeTailFixedBeforeEventPayoff : Prop
  routeTailFixedBeforeEventPayoff_proof :
    routeTailFixedBeforeEventPayoff
  noPostHocRouteTailDefinitionFromEventLedger : Prop
  noPostHocRouteTailDefinitionFromEventLedger_proof :
    noPostHocRouteTailDefinitionFromEventLedger
  noDescendantRebillingInActiveTailIndex : Prop
  noDescendantRebillingInActiveTailIndex_proof :
    noDescendantRebillingInActiveTailIndex

/--
Once the route active tail is identified with the event-ordered bad-center
beta-square tail, the event charge pays that route tail with coefficient one.
-/
theorem c7RouteActiveTail_paid_by_eventCharge_of_eventBetaSquareIdentification
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {routeActiveTail : Nat → Real}
    (h :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail) :
    ∀ n : Nat,
      (1 : Real) * routeActiveTail n ≤
        L.eventWeight n * (L.eventGain n) ^ (2 : Nat) := by
  intro n
  rw [h.activeTail_eq_eventBetaSquare]
  exact
    badCenterBetaSquareEventActiveTail_paid_by_eventCharge
      h.pointwiseBetaSquareIdentity n

/--
The same pointwise source theorem packaged as the event-prefix bridge data.
The bookkeeping fields are filled from the displayed same-tree lock and the
event/bad-center identity; the analytic burden is precisely the pointwise
identity plus the same-tree lock, not reserve algebra.
-/
def EventPrefixToPredictableReserveBridgeData.ofBadCenterBetaSquareEventSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hPoint :
      BadCenterEventPointwiseBetaSquareIdentity
        seq K hRho hCarrier hBeta hEvents L) :
    EventPrefixToPredictableReserveBridgeData :=
  EventPrefixToPredictableReserveBridgeData.ofFreshFrequencySameTreeLock
    hLock
    (badCenterBetaSquareEventActiveTail (hBeta := hBeta) hEvents)
    (1 : Real)
    zero_lt_one
    (badCenterBetaSquareEventActiveTail_paid_by_eventCharge hPoint)
    (And
      hLock.generatedFromSameBadCenterStoppingTree
      (And
        hLock.pressureLock.lerayProjectionAndHeatKernelUseSameCarrier
        hLock.prefixDominationFromSubprimitives.usesPointwiseBetaRadiusIdentity))
    (And
      hLock.boundedFanoutNoLogReuse.noRepeatedDescendantCharging
      hLock.boundedFanoutNoLogReuse.noSameScaleLogarithmicMultiplicityPerEvent)
    hPoint.noAdaptiveReindexingFromBetaSquareSum

/--
Reserve source obtained from the concrete bad-center beta-square event source.
This is the strongest compiled output of TICK668: the reserve normal form is
available for the beta-square event active tail, conditional on the pointwise
event/bad-center identity and the existing same-tree lock.
-/
def FreshAnnularPredictableReserveDropSource.ofBadCenterBetaSquareEventSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hPoint :
      BadCenterEventPointwiseBetaSquareIdentity
        seq K hRho hCarrier hBeta hEvents L) :
    FreshAnnularPredictableReserveDropSource :=
  FreshAnnularPredictableReserveDropSource.ofEventPrefixBridgeData
    (EventPrefixToPredictableReserveBridgeData.ofBadCenterBetaSquareEventSource
      hLock hPoint)

/--
Event-prefix bridge data for an externally supplied C7 route active tail.
The only way the arbitrary tail enters is through the active-tail
identification receipt above.
-/
def EventPrefixToPredictableReserveBridgeData.ofC7RouteActiveTailIdentification
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {routeActiveTail : Nat → Real}
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail) :
    EventPrefixToPredictableReserveBridgeData :=
  EventPrefixToPredictableReserveBridgeData.ofFreshFrequencySameTreeLock
    hLock
    routeActiveTail
    (1 : Real)
    zero_lt_one
    (c7RouteActiveTail_paid_by_eventCharge_of_eventBetaSquareIdentification
      hId)
    (And
      hLock.generatedFromSameBadCenterStoppingTree
      (And
        hEvents.eventOrderingMatchesBadTree
        hId.routeTailFixedBeforeEventPayoff))
    (And
      hLock.boundedFanoutNoLogReuse.noRepeatedDescendantCharging
      hId.noDescendantRebillingInActiveTailIndex)
    (And
      hId.pointwiseBetaSquareIdentity.noAdaptiveReindexingFromBetaSquareSum
      hId.noPostHocRouteTailDefinitionFromEventLedger)

/--
Reserve source for an externally supplied C7 route active tail, conditional on
the proof-carrying identification with the event beta-square tail.
-/
def FreshAnnularPredictableReserveDropSource.ofC7RouteActiveTailIdentification
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {routeActiveTail : Nat → Real}
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail) :
  FreshAnnularPredictableReserveDropSource :=
  FreshAnnularPredictableReserveDropSource.ofEventPrefixBridgeData
    (EventPrefixToPredictableReserveBridgeData.ofC7RouteActiveTailIdentification
      hLock hId)

/--
Separation guard: a finite event prefix budget says nothing about an unrelated
active tail.  The zero event ledger has finite prefixes while the constant
active tail has prefixes exceeding any real bound.
-/
theorem eventPrefixBudget_alone_allows_unbounded_independent_activeTail :
    ∃ eventCharge activeTail : Nat → Real,
    ∃ eventBudget : Real,
      (∀ N : Nat, NS.nsPrefixSum eventCharge N ≤ eventBudget) ∧
      (∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum activeTail N) := by
  refine ⟨fun _ : Nat => (0 : Real), fun _ : Nat => (1 : Real), 0, ?_, ?_⟩
  · intro N
    rw [nsPrefixSum_zero_real]
  · intro B
    obtain ⟨N, hN⟩ := exists_nat_gt B
    refine ⟨N, ?_⟩
    rw [nsPrefixSum_const_one_real]
    exact hN

/--
Consequent hard negative for the reserve normal form: the constant active tail
cannot be carried by any finite predictable reserve-drop source.
-/
theorem constantActiveTail_no_predictableReserveDropSource :
    ¬ ∃ h : FreshAnnularPredictableReserveDropSource,
      h.activeTail = fun _ : Nat => (1 : Real) := by
  rintro ⟨h, htail⟩
  obtain ⟨N, hN⟩ := exists_nat_gt ((h.rootBudget + h.rechargeBudget) / h.c)
  have hbound := activeTailPrefix_le_predictableReserveDropBudget h N
  rw [htail, nsPrefixSum_const_one_real] at hbound
  linarith

/--
Existing lineage-reservoir sources enter the fresh-annular consumer exactly
when their recharge/error term is upgraded from a qualitative summability
claim to a numerical prefix budget.  The payment coefficient becomes
`kappa*c`, since the reserve drop pays `kappa` times the fresh-region charge.
-/
def FreshAnnularPredictableReserveDropSource.ofLineageFreshMonotoneReservoirSource
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    (h : LineageFreshMonotoneReservoirSource Ω ι)
    (errBudget : Real)
    (hReserveNonneg : ∀ n : Nat, 0 ≤ h.reserve n)
    (hErrBudget : ∀ N : Nat, NS.nsPrefixSum h.err N ≤ errBudget) :
    FreshAnnularPredictableReserveDropSource where
  activeTail := fun n : Nat => h.activeTail (h.eventSchedule n)
  reserve := h.reserve
  recharge := h.err
  c := h.kappa * h.c
  rootBudget := h.C0
  rechargeBudget := errBudget
  c_pos := mul_pos h.kappa_pos h.c_pos
  reserve_nonneg := hReserveNonneg
  reserve_zero_le_rootBudget := h.finiteRootReserveBudget
  rechargePrefixBudget := hErrBudget
  pointwiseReservePayment := by
    intro n
    have hsel := h.scheduleUsesSelectedEvents n
    have hpay :=
      h.freshPayment (h.eventSchedule n) hsel
    have hpayk :
        h.kappa * (h.c * h.activeTail (h.eventSchedule n)) ≤
          h.kappa * h.omega (h.freshRegion (h.eventSchedule n)) :=
      mul_le_mul_of_nonneg_left hpay (le_of_lt h.kappa_pos)
    have hdrop := h.reserveDropWithRecharge n
    have hdrop' :
        h.kappa * h.omega (h.freshRegion (h.eventSchedule n)) ≤
          h.reserve n - h.reserve (n + 1) + h.err n := by
      nlinarith
    calc
      (h.kappa * h.c) * h.activeTail (h.eventSchedule n)
          = h.kappa * (h.c * h.activeTail (h.eventSchedule n)) := by
            ring
      _ ≤ h.kappa * h.omega (h.freshRegion (h.eventSchedule n)) := hpayk
      _ ≤ h.reserve n - h.reserve (n + 1) + h.err n := hdrop'
  reserveFixedBeforePayoff :=
    h.omegaFixedBeforeEventSelection ∧ h.noPostHocFreshRegionChoice
  sameCarrierReserveDrop :=
    h.lineageFreshness
  rechargeBookedSeparately :=
    h.rechargeErrorsSummable
  noDescendantReserveRebilling :=
    h.recurrentPacketReuseRejectedOrPaysRecharge
  noPostHocReserveDefinition :=
    h.noPostHocFreshRegionChoice

/--
Numerical upgrade data for the lineage reservoir.

TICK667 isolates the exact extra fields needed after TICK666: a qualitative
lineage reservoir already has the reserve-drop inequality, but the fresh-
annular prefix consumer additionally needs the reserve to be nonnegative at
every prefix endpoint and the recharge/error term to have an explicit prefix
budget.
-/
structure LineageReservoirNumericalUpgradeData
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    (h : LineageFreshMonotoneReservoirSource Ω ι) where
  errBudget : Real
  reserve_nonneg : ∀ n : Nat, 0 ≤ h.reserve n
  errPrefixBudget : ∀ N : Nat, NS.nsPrefixSum h.err N ≤ errBudget

/-- The numerical upgrade data is exactly the two TICK667 fields. -/
theorem lineageReservoirNumericalUpgradeData_iff
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    (h : LineageFreshMonotoneReservoirSource Ω ι) :
    Nonempty (LineageReservoirNumericalUpgradeData h) ↔
      ∃ errBudget : Real,
        (∀ n : Nat, 0 ≤ h.reserve n) ∧
          (∀ N : Nat, NS.nsPrefixSum h.err N ≤ errBudget) := by
  constructor
  · intro hU
    rcases hU with ⟨u⟩
    exact ⟨u.errBudget, u.reserve_nonneg, u.errPrefixBudget⟩
  · rintro ⟨errBudget, hReserve, hErr⟩
    exact ⟨{
      errBudget := errBudget
      reserve_nonneg := hReserve
      errPrefixBudget := hErr
    }⟩

/--
Projection from the exact numerical upgrade packet to the predictable
fresh-annular reserve-drop source.
-/
def FreshAnnularPredictableReserveDropSource.ofLineageNumericalUpgradeData
    {Ω : Type u} {ι : Type u} [DecidableEq ι]
    {h : LineageFreshMonotoneReservoirSource Ω ι}
    (u : LineageReservoirNumericalUpgradeData h) :
    FreshAnnularPredictableReserveDropSource :=
  FreshAnnularPredictableReserveDropSource.ofLineageFreshMonotoneReservoirSource
    h u.errBudget u.reserve_nonneg u.errPrefixBudget

/--
Algebraic counterexample to deriving reserve nonnegativity from the one-sided
drop inequality alone.

The reserve `R_n = -n` has `R_0 <= 0` and satisfies a reserve-drop inequality
with zero active tail and zero recharge, but it is not nonnegative.  Therefore
`finiteRootReserveBudget` plus `reserveDropWithRecharge` is not a substitute
for the explicit field `forall n, 0 <= reserve n`.
-/
theorem reserveDropWithRecharge_allows_negative_reserve :
    ∃ reserve recharge activeTail : Nat → Real,
    ∃ c rootBudget : Real,
      0 < c ∧
      reserve 0 ≤ rootBudget ∧
      (∀ n : Nat,
        c * activeTail n ≤ reserve n - reserve (n + 1) + recharge n) ∧
      ¬ (∀ n : Nat, 0 ≤ reserve n) := by
  refine ⟨fun n : Nat => - (n : Real), fun _ : Nat => 0,
    fun _ : Nat => 0, 1, 0, ?_, ?_, ?_, ?_⟩
  · norm_num
  · norm_num
  · intro n
    norm_num
  · intro hnonneg
    have h1 := hnonneg 1
    norm_num at h1

/--
Algebraic counterexample to replacing a qualitative recharge flag by a
numerical prefix budget.

The constant recharge sequence has a harmless qualitative flag (`True`) but no
finite real prefix bound.  Thus `rechargeErrorsSummable : Prop` cannot be used
as the numerical `errBudget` required by the predictable reserve-drop source.
-/
theorem qualitativeRechargeFlag_allows_unbounded_recharge_prefix :
    ∃ recharge : Nat → Real,
      True ∧ ¬ ∃ rechargeBudget : Real,
        ∀ N : Nat, NS.nsPrefixSum recharge N ≤ rechargeBudget := by
  refine ⟨fun _ : Nat => (1 : Real), True.intro, ?_⟩
  intro hbudget
  rcases hbudget with ⟨B, hB⟩
  obtain ⟨N, hN⟩ := exists_nat_gt B
  have hprefix := hB N
  rw [nsPrefixSum_const_one_real] at hprefix
  linarith

/--
TICK665 adapter seam.

The displayed C7 same-tree fresh-radius invoice contains the right qualitative
guards, but `FreshAnnularChargePrefixBudgetSource` needs quantitative prefix
data.  This object is the missing extraction: enumerate the invoice into an
active-tail schedule and a fresh-charge schedule, with a real root budget.
-/
structure FreshAnnularChargeExtractionFromC7Invoice
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (invoice : C7SameTreeFreshRadiusInvoice seq K hRho) where
  activeTail : Nat → Real
  freshCharge : Nat → Real
  c : Real
  rootBudget : Real
  c_pos : 0 < c
  pointwiseFreshPayment :
    ∀ n : Nat, c * activeTail n ≤ freshCharge n
  freshChargePrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum freshCharge N ≤ rootBudget
  eventScheduleEnumeratesInvoiceBadNodes : Prop
  freshChargeQuantifiesInvoiceRegions : Prop
  invoiceBudgetQuantifiedAsRootPrefixBudget :
    invoice.finiteFreshInvoiceBudget
  assignedBeforePayoff_fromInvoice :
    invoice.invoiceAssignedBeforeSubtreeSelection
  sameCarrier_fromInvoice :
    invoice.invoiceUsesSameNormalizedExcessStoppingTree
  nonRebilling_fromInvoice :
    invoice.oneUseNoDescendantRebilling
  notLocalDominationOnly_fromInvoice :
    invoice.descendantInvoicesDisjointOrBoundedOverlap

/--
If the quantitative extraction from a displayed C7 invoice is supplied, the
generic fresh-annular prefix-budget consumer is available.
-/
def FreshAnnularChargePrefixBudgetSource.ofC7InvoiceExtraction
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {invoice : C7SameTreeFreshRadiusInvoice seq K hRho}
    (h : FreshAnnularChargeExtractionFromC7Invoice invoice) :
    FreshAnnularChargePrefixBudgetSource where
  activeTail := h.activeTail
  freshCharge := h.freshCharge
  c := h.c
  rootBudget := h.rootBudget
  c_pos := h.c_pos
  pointwiseFreshPayment := h.pointwiseFreshPayment
  freshChargePrefixBudget := h.freshChargePrefixBudget
  assignedBeforePayoff := invoice.invoiceAssignedBeforeSubtreeSelection
  sameCarrierAsRouteTail := invoice.invoiceUsesSameNormalizedExcessStoppingTree
  nonRebillingOnPacketLineages := invoice.oneUseNoDescendantRebilling
  freshAnnularInjectionOrReserveDropSourced :=
    And h.freshChargeQuantifiesInvoiceRegions
      invoice.finiteFreshInvoiceBudget
  noLocalDominationOnlyClaim :=
    And invoice.descendantInvoicesDisjointOrBoundedOverlap
      h.eventScheduleEnumeratesInvoiceBadNodes

/--
Boundary: a qualitative same-tree C7 invoice does not by itself produce the
numeric fresh-annular prefix-budget source.  The missing object is the
quantitative extraction above.
-/
structure C7InvoiceNeedsFreshAnnularNumericalExtraction
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (invoice : C7SameTreeFreshRadiusInvoice seq K hRho) where
  numericalExtractionMissing :
    ¬ Nonempty (FreshAnnularChargeExtractionFromC7Invoice invoice)
  qualitativeInvoiceGuardsAvailable : Prop
  propInvoiceFieldsDoNotQuantifyPrefixSums : Prop
  noPromotionFromInvoicePropsAlone : Prop

/--
Constructor for the TICK665 boundary: if the numerical extraction is absent,
the displayed C7 invoice remains a qualitative carrier and cannot be promoted
to the fresh-annular prefix-budget source.
-/
theorem c7Invoice_needs_freshAnnularNumericalExtraction
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (invoice : C7SameTreeFreshRadiusInvoice seq K hRho)
    (hNoExtraction :
      ¬ Nonempty (FreshAnnularChargeExtractionFromC7Invoice invoice)) :
    Nonempty (C7InvoiceNeedsFreshAnnularNumericalExtraction invoice) := by
  refine ⟨{
    numericalExtractionMissing := hNoExtraction
    qualitativeInvoiceGuardsAvailable := True
    propInvoiceFieldsDoNotQuantifyPrefixSums := True
    noPromotionFromInvoicePropsAlone := True
  }⟩

/--
Lower source for the Borel-local measure split.

The four positive pieces are kept named before aggregation into `nuvis`.  The
field `positiveVariationSubadditivity` is the measure-theoretic output of a
fixed signed local-energy identity; sourcing that identity is the remaining PDE
work.
-/
structure LocalEnergySignedMeasurePositiveVariationSource
    (Ω : Type u) where
  muA : Set Ω → Real
  muT : Set Ω → Real
  muQP : Set Ω → Real
  muC : Set Ω → Real
  muI : Set Ω → Real
  fixedEventTentAndCutoff : Prop
  signedLocalEnergyMeasureIdentity : Prop
  activeMeasureIsPositiveVariationOfBoundaryFlux : Prop
  transportMeasureIsPositiveVariationOfSameCutoffFlux : Prop
  pressureQPMeasureIsPositiveVariationOfLocalEnergyTerms : Prop
  commutatorMeasureIsPositiveVariationOfDefectMeasure : Prop
  residualMeasureIsPositiveVariationOfProfileCoherenceResidual : Prop
  positiveVariationSubadditivity :
    ∀ E : Set Ω, muA E ≤ muT E + muQP E + muC E + muI E
  residualMonotone :
    ∀ {E F : Set Ω}, E ⊆ F → muI E ≤ muI F
  sameLocalEnergyCarrier : Prop
  piecesFixedBeforeRouteReceipt : Prop
  noPostHocResidualChoice : Prop
  noFinalBudgetSlackDefinition : Prop
  noScalarOnlyRouteTotalSplit : Prop

/--
The fixed-cutoff signed identity source supplies the named positive-variation
source consumed by the Borel-local split constructor.
-/
def LocalEnergySignedMeasurePositiveVariationSource.ofFixedCutoffSignedIdentity
    {Ω : Type u}
    (h : FixedCutoffLocalEnergySignedMeasureIdentitySource Ω) :
    LocalEnergySignedMeasurePositiveVariationSource Ω where
  muA := h.muA
  muT := h.muT
  muQP := h.muQP
  muC := h.muC
  muI := h.muI
  fixedEventTentAndCutoff := h.fixedEventTentAndCutoff
  signedLocalEnergyMeasureIdentity :=
    h.cutoffChosenBeforeRouteReceipt ∧
      (∀ E : Set Ω,
        h.alphaA E = h.alphaT E + h.alphaQP E + h.alphaC E + h.alphaI E)
  activeMeasureIsPositiveVariationOfBoundaryFlux :=
    h.activePositiveVariationOfAlphaA
  transportMeasureIsPositiveVariationOfSameCutoffFlux :=
    h.transportPositiveVariationOfAlphaT
  pressureQPMeasureIsPositiveVariationOfLocalEnergyTerms :=
    h.pressureQPPositiveVariationOfAlphaQP
  commutatorMeasureIsPositiveVariationOfDefectMeasure :=
    h.commutatorPositiveVariationOfAlphaC
  residualMeasureIsPositiveVariationOfProfileCoherenceResidual :=
    h.residualPositiveVariationOfAlphaI
  positiveVariationSubadditivity := h.positiveVariationDomination
  residualMonotone := h.residualMonotone
  sameLocalEnergyCarrier := h.activeMeasureUsesSameLocalEnergyCarrier
  piecesFixedBeforeRouteReceipt := h.cutoffChosenBeforeRouteReceipt
  noPostHocResidualChoice := h.noPostHocResidualChoice
  noFinalBudgetSlackDefinition := h.noFinalBudgetSlackDefinition
  noScalarOnlyRouteTotalSplit := h.noScalarOnlyRouteTotalSplit

/--
Aggregate the transport, pressure/quadratic, and commutator positive
variations into the visible measure.
-/
def LocalEnergySignedMeasurePositiveVariationSource.nuvis
    {Ω : Type u}
    (h : LocalEnergySignedMeasurePositiveVariationSource Ω) :
    Set Ω → Real :=
  fun E => h.muT E + h.muQP E + h.muC E

/--
The signed-measure positive-variation source supplies the Borel-local active
measure split used by the singular-control theorem.
-/
def LocalEnergyPositiveBoundaryFluxMeasureSplitSource.ofSignedMeasurePositiveVariation
    {Ω : Type u}
    (h : LocalEnergySignedMeasurePositiveVariationSource Ω) :
    LocalEnergyPositiveBoundaryFluxMeasureSplitSource Ω where
  muA := h.muA
  nuvis := h.nuvis
  muI := h.muI
  measureDomination := by
    intro E
    dsimp [LocalEnergySignedMeasurePositiveVariationSource.nuvis]
    exact h.positiveVariationSubadditivity E
  residualMonotone := h.residualMonotone
  fixedEventTentAndCutoff := h.fixedEventTentAndCutoff
  signedLocalEnergyMeasureIdentity := h.signedLocalEnergyMeasureIdentity
  positiveVariationSubadditivityUsed :=
    And h.activeMeasureIsPositiveVariationOfBoundaryFlux
      (And h.transportMeasureIsPositiveVariationOfSameCutoffFlux
        (And h.pressureQPMeasureIsPositiveVariationOfLocalEnergyTerms
          (And h.commutatorMeasureIsPositiveVariationOfDefectMeasure
            h.residualMeasureIsPositiveVariationOfProfileCoherenceResidual)))
  sameLocalEnergyCarrier := h.sameLocalEnergyCarrier
  residualMeasureIndependentlyGenerated :=
    And h.residualMeasureIsPositiveVariationOfProfileCoherenceResidual
      h.noPostHocResidualChoice
  noScalarOnlyRouteTotalSplit := h.noScalarOnlyRouteTotalSplit
  noFinalBudgetSlackDefinition := h.noFinalBudgetSlackDefinition

/--
Singular restriction data for the active source measure relative to the visible
measure.  `singularSupport` is the set carrying the singular active part and
annihilating the visible measure.
-/
structure ActiveSingularRestriction
    {Ω : Type u}
    (h : LocalEnergyPositiveBoundaryFluxMeasureSplitSource Ω) where
  muAperp : Set Ω → Real
  singularSupport : Set Ω
  carriedBySingularSupport :
    ∀ E : Set Ω, muAperp E = h.muA (E ∩ singularSupport)
  visibleZeroOnSingularSupport :
    ∀ E : Set Ω, h.nuvis (E ∩ singularSupport) = 0
  lebesgueSingularPartOfActiveSource : Prop
  singularSupportChosenBeforeRoutePayoff : Prop

/--
The local measure split controls the active singular part by the independently
defined residual measure.  This is the singular-support argument; it uses
Borel-local domination, not ordinary profile extraction.
-/
theorem activeSingular_le_residual_of_measureLocalSplit
    {Ω : Type u}
    (h : LocalEnergyPositiveBoundaryFluxMeasureSplitSource Ω)
    (hsing : ActiveSingularRestriction h) :
    ∀ E : Set Ω, hsing.muAperp E ≤ h.muI E := by
  intro E
  calc
    hsing.muAperp E = h.muA (E ∩ hsing.singularSupport) :=
      hsing.carriedBySingularSupport E
    _ ≤ h.nuvis (E ∩ hsing.singularSupport) +
        h.muI (E ∩ hsing.singularSupport) :=
      h.measureDomination (E ∩ hsing.singularSupport)
    _ = h.muI (E ∩ hsing.singularSupport) := by
      rw [hsing.visibleZeroOnSingularSupport E]
      simp
    _ ≤ h.muI E :=
      h.residualMonotone (Set.inter_subset_left)

/--
Guard: a scalar-only total split does not imply local singular control.  A
countermodel can match whole-space masses while moving the residual mass away
from the singular active atom.
-/
structure ScalarOnlyBoundaryFluxSplitDoesNotControlSingularPart where
  Ω : Type u
  muA : Set Ω → Real
  nuvis : Set Ω → Real
  muI : Set Ω → Real
  muAperp : Set Ω → Real
  wholeSpaceScalarDomination :
    muA Set.univ ≤ nuvis Set.univ + muI Set.univ
  witnessEvent : Set Ω
  singularMassPositive : 0 < muAperp witnessEvent
  residualZeroOnWitness : muI witnessEvent = 0
  noLocalSingularControl :
    ¬ muAperp witnessEvent ≤ muI witnessEvent
  scalarSplitNotBorelLocal : Prop

/--
The routed charge sum produced by the local-energy positive-boundary-flux
split.  This is an accounting object, not a strictness certificate.
-/
def localEnergyRoutedChargeSum
    (transportReceipt : FreshFrequencyTransportLeakageReceipt)
    (h : LocalEnergyPositiveBoundaryFluxSubadditivitySource transportReceipt) :
    Real :=
  transportReceipt.transportLeakageCharge +
    h.commutatorCharge + h.localQuadraticCharge + h.noInvisibleProfileCharge

/--
Bridge from the local-energy routed-charge surface to the existing route-1
critical-tail visibility algebra.

The new PDE content is not the local-energy allocation itself; it is the
strict absorption field
`routedCharges_le_channelLossBudget` together with the independent channel
visibility lower bound.  This keeps tick358/tick359 from being mistaken for a
final route-1 strictness proof.
-/
structure LocalEnergyRoutedChargesStrictAbsorptionBridge
    (transportReceipt : FreshFrequencyTransportLeakageReceipt) where
  split : LocalEnergyPositiveBoundaryFluxSubadditivitySource transportReceipt
  accounting : Route1ChannelAccountingBase
  tailSource_le_routedCharges :
    accounting.S_tail ≤ localEnergyRoutedChargeSum transportReceipt split
  routedCharges_le_channelLossBudget :
    localEnergyRoutedChargeSum transportReceipt split ≤
      accounting.rho * accounting.X_tail -
        accounting.kappa *
          route1ChannelVisibilitySum
            accounting.V_T accounting.V_Q accounting.V_P accounting.V_C +
          accounting.tailError
  criticalTailVisibleFromRoutedChannels :
    accounting.nu * accounting.X_tail ≤
      route1ChannelVisibilitySum
        accounting.V_T accounting.V_Q accounting.V_P accounting.V_C
  sameEventTentAndCutoffAsSplit : Prop
  visibilityChannelsAreIndependentlyDefined : Prop
  routedChargesNotDefinedFromStrictGap : Prop
  noAllocationOnlyStrictnessClaim : Prop
  noFinalCarrierMagnitudeInput : Prop

/--
The strict-absorption bridge supplies a full route-1 channel visibility
producer by paying the unresolved tail source through the routed charges and
then through the independently visible channel-loss budget.
-/
def LocalEnergyRoutedChargesStrictAbsorptionBridge.toChannelVisibilityProducer
    {transportReceipt : FreshFrequencyTransportLeakageReceipt}
    (h : LocalEnergyRoutedChargesStrictAbsorptionBridge transportReceipt) :
    Route1ChannelVisibilityProducer where
  rho := h.accounting.rho
  X := h.accounting.X
  S := h.accounting.S
  X_res := h.accounting.X_res
  X_tail := h.accounting.X_tail
  S_res := h.accounting.S_res
  S_tail := h.accounting.S_tail
  V_T := h.accounting.V_T
  V_Q := h.accounting.V_Q
  V_P := h.accounting.V_P
  V_C := h.accounting.V_C
  deltaRes := h.accounting.deltaRes
  kappa := h.accounting.kappa
  nu := h.accounting.nu
  epsTail := h.accounting.epsTail
  tailError := h.accounting.tailError
  X_nonneg := h.accounting.X_nonneg
  X_res_nonneg := h.accounting.X_res_nonneg
  X_tail_nonneg := h.accounting.X_tail_nonneg
  V_T_nonneg := h.accounting.V_T_nonneg
  V_Q_nonneg := h.accounting.V_Q_nonneg
  V_P_nonneg := h.accounting.V_P_nonneg
  V_C_nonneg := h.accounting.V_C_nonneg
  X_split := h.accounting.X_split
  S_split := h.accounting.S_split
  resolvedStrict := h.accounting.resolvedStrict
  channelLossFromChannelSum :=
    le_trans h.tailSource_le_routedCharges h.routedCharges_le_channelLossBudget
  tailErrorSmall := h.accounting.tailErrorSmall
  criticalTailVisibleFromChannelSum := h.criticalTailVisibleFromRoutedChannels
  deltaRes_pos := h.accounting.deltaRes_pos
  kappa_pos := h.accounting.kappa_pos
  nu_pos := h.accounting.nu_pos

/--
Strict route-1 source subratio from a local-energy split only after strict
absorption and critical-tail visibility are supplied.  The proof is algebraic;
all PDE work is in `LocalEnergyRoutedChargesStrictAbsorptionBridge`.
-/
theorem exists_strict_source_subratio_of_LocalEnergyRoutedChargesStrictAbsorptionBridge
    {transportReceipt : FreshFrequencyTransportLeakageReceipt}
    (h : LocalEnergyRoutedChargesStrictAbsorptionBridge transportReceipt)
    (h_eps :
      h.accounting.epsTail ≤
        (1 / 2 : Real) *
          min h.accounting.deltaRes (h.accounting.kappa * h.accounting.nu)) :
    ∃ rho' : Real,
      rho' < h.accounting.rho ∧ h.accounting.S ≤ rho' * h.accounting.X :=
  exists_strict_source_subratio_of_Route1ChannelVisibilityProducer
    h.toChannelVisibilityProducer h_eps

/--
Allocation-only saturation guard.  Positive boundary-flux accounting can route
the transport leakage to other charges while still saturating the non-strict
tail budget; payment is not strict absorption.
-/
structure LocalEnergyAllocationOnlySaturationNoStrictness where
  rho : Real
  X_tail : Real
  normalizedTransportLeakagePart : Real
  positiveBoundaryFluxCharge : Real
  routedCharges : Real
  X_tail_pos : 0 < X_tail
  normalizedTransport_le_positiveBoundaryFlux :
    normalizedTransportLeakagePart ≤ positiveBoundaryFluxCharge
  positiveBoundaryFlux_le_routedCharges :
    positiveBoundaryFluxCharge ≤ routedCharges
  routedCharges_saturates_nonStrictBudget :
    routedCharges = rho * X_tail
  allocationUsesFixedCutoffFlux : Prop
  noVisibilityLossProvided : Prop

/--
If the routed charges saturate the non-strict tail budget, no positive strict
absorption margin follows from allocation alone.
-/
theorem no_strictAbsorption_of_allocationOnlySaturation
    (h : LocalEnergyAllocationOnlySaturationNoStrictness) :
    ¬ ∃ delta : Real,
      0 < delta ∧ h.routedCharges ≤ (h.rho - delta) * h.X_tail := by
  intro hstrict
  rcases hstrict with ⟨delta, hdelta_pos, hle⟩
  nlinarith [h.routedCharges_saturates_nonStrictBudget, h.X_tail_pos, hle,
    hdelta_pos]

/--
Lower anti-smuggling object for shard C.

The leakage estimate is not accepted as a single endpoint inequality here.
Instead the frequency leakage is split into separately fixed charges, and each
charge is bounded by one visible channel.  The pressure/Duhamel and fanout locks
remain attached so the split cannot be paid by a post-hoc shell ledger.
-/
structure FreshFrequencyLeakageChargeBookkeeping
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  frequencyLeakage : Real
  pressureLeakageCharge : Real
  transportLeakageCharge : Real
  commutatorLeakageCharge : Real
  boundaryLeakageCharge : Real
  pressureTailTerm : Real
  transportVisibility : Real
  commutatorVisibility : Real
  tentBoundaryError : Real
  C_P : Real
  C_T : Real
  C_C : Real
  pressureDuhamelSameCarrier :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  leakage_split_before_channel_bounds :
    frequencyLeakage ≤
      pressureLeakageCharge +
        transportLeakageCharge +
        commutatorLeakageCharge +
        boundaryLeakageCharge
  pressureCharge_bound :
    pressureLeakageCharge ≤ C_P * pressureTailTerm
  transportCharge_bound :
    transportLeakageCharge ≤ C_T * transportVisibility
  commutatorCharge_bound :
    commutatorLeakageCharge ≤ C_C * commutatorVisibility
  boundaryCharge_bound :
    boundaryLeakageCharge ≤ tentBoundaryError
  pressureChargeUsesSameFreshFrequencyCarrier : Prop
  transportChargeUsesRouteFluxVisibility : Prop
  commutatorChargeUsesEndpointDefectMeasure : Prop
  boundaryChargeIsTentTruncationError : Prop
  chargesFixedBeforeAbsorptionFork : Prop
  no_pressure_or_visibility_margin_input : Prop

/-- Charge bookkeeping proves the displayed leakage accounting inequality. -/
theorem leakage_accounted_by_nonQ_terms_of_charge_bookkeeping
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L) :
    h.frequencyLeakage ≤
      h.C_P * h.pressureTailTerm +
        h.C_T * h.transportVisibility +
        h.C_C * h.commutatorVisibility +
        h.tentBoundaryError := by
  nlinarith [h.leakage_split_before_channel_bounds,
    h.pressureCharge_bound, h.transportCharge_bound,
    h.commutatorCharge_bound, h.boundaryCharge_bound]

/--
Receipt-based constructor for shard-C charge bookkeeping.

This chooses the pressure charge from the fresh-frequency event prefix budget,
the transport charge from the route-1 transport visibility channel, the
commutator charge from an endpoint commutator receipt, and the boundary charge
from the explicit tent-boundary truncation receipt.
-/
def FreshFrequencyLeakageChargeBookkeeping.ofReceiptsWithTransport
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {endpointDefect commutatorResidual compactTailLoss
      escapeMass microstructureLeak commutatorFrequencyLeak residualFloor
      tailMass tailOscillation compactnessModulus : Real}
    (pressurePrefixN : ℕ)
    (frequencyLeakage : Real)
    (hPressure :
      FreshFrequencyPressureDuhamelSameCarrierLock
        seq K hRho hCarrier hEvents L)
    (hFanout :
      FreshFrequencyBoundedFanoutNoLogReuse
        seq K hRho hCarrier hBeta hEvents L)
    (hTransport : FreshFrequencyTransportLeakageReceipt)
    (hComm :
      EndpointCommutatorVisibilityReceipt
        endpointDefect commutatorResidual compactTailLoss
        escapeMass microstructureLeak commutatorFrequencyLeak residualFloor
        tailMass tailOscillation compactnessModulus)
    (hBoundary : FreshFrequencyTentBoundaryTruncationReceipt)
    (leakage_split_before_channel_bounds :
      frequencyLeakage ≤
        NS.eventWeightedGainPricePrefix L pressurePrefixN +
          hTransport.transportLeakageCharge +
          endpointDefect +
          hBoundary.boundaryLeakageCharge) :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L where
  frequencyLeakage := frequencyLeakage
  pressureLeakageCharge := NS.eventWeightedGainPricePrefix L pressurePrefixN
  transportLeakageCharge := hTransport.transportLeakageCharge
  commutatorLeakageCharge := endpointDefect
  boundaryLeakageCharge := hBoundary.boundaryLeakageCharge
  pressureTailTerm := L.priceBudget
  transportVisibility := hTransport.transportVisibility
  commutatorVisibility := commutatorResidual + compactTailLoss
  tentBoundaryError := hBoundary.tentBoundaryError
  C_P := (1 : Real)
  C_T := hTransport.C_T
  C_C := (1 : Real)
  pressureDuhamelSameCarrier := hPressure
  boundedFanoutNoLogReuse := hFanout
  leakage_split_before_channel_bounds := by
    simpa using leakage_split_before_channel_bounds
  pressureCharge_bound := by
    simpa using hPressure.pressureDuhamelCostControlledByFreshEventBudget
      pressurePrefixN
  transportCharge_bound := hTransport.transportCharge_bound
  commutatorCharge_bound := by
    simpa using hComm.defect_visibility.endpoint_visible
  boundaryCharge_bound := hBoundary.boundaryCharge_bound
  pressureChargeUsesSameFreshFrequencyCarrier :=
    And hPressure.pressureTailAssignedToFreshFrequencyEvents
      hPressure.lerayProjectionAndHeatKernelUseSameCarrier
  transportChargeUsesRouteFluxVisibility :=
    hTransport.routeFluxVisibilityProducer
  commutatorChargeUsesEndpointDefectMeasure :=
    EndpointCommutatorDefectVisibility
      endpointDefect commutatorResidual compactTailLoss
  boundaryChargeIsTentTruncationError :=
    hBoundary.boundaryChargeIsTentTruncationError
  chargesFixedBeforeAbsorptionFork :=
    And
      (And hPressure.noShellProcessPostHocMatching
        hTransport.transportChargeFixedBeforeAbsorptionFork)
      hBoundary.boundaryChargeFixedBeforeAbsorptionFork
  no_pressure_or_visibility_margin_input :=
    And hFanout.noRepeatedDescendantCharging
      hTransport.noGlobalTransportCancellationSmuggled

/--
Backward-compatible scalar fallback for shard-C charge bookkeeping.

Use `ofReceiptsWithTransport` when a genuine route-flux receipt is available.
This wrapper records the current weaker state explicitly: transport is paid by
the already aggregated `Route1ChannelVisibilityProducer.V_T`.
-/
def FreshFrequencyLeakageChargeBookkeeping.ofReceipts
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {endpointDefect commutatorResidual compactTailLoss
      escapeMass microstructureLeak commutatorFrequencyLeak residualFloor
      tailMass tailOscillation compactnessModulus : Real}
    (pressurePrefixN : ℕ)
    (frequencyLeakage : Real)
    (hPressure :
      FreshFrequencyPressureDuhamelSameCarrierLock
        seq K hRho hCarrier hEvents L)
    (hFanout :
      FreshFrequencyBoundedFanoutNoLogReuse
        seq K hRho hCarrier hBeta hEvents L)
    (hChannels : Route1ChannelVisibilityProducer)
    (hComm :
      EndpointCommutatorVisibilityReceipt
        endpointDefect commutatorResidual compactTailLoss
        escapeMass microstructureLeak commutatorFrequencyLeak residualFloor
        tailMass tailOscillation compactnessModulus)
    (hBoundary : FreshFrequencyTentBoundaryTruncationReceipt)
    (leakage_split_before_channel_bounds :
      frequencyLeakage ≤
        NS.eventWeightedGainPricePrefix L pressurePrefixN +
          hChannels.V_T +
          endpointDefect +
          hBoundary.boundaryLeakageCharge) :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L :=
  FreshFrequencyLeakageChargeBookkeeping.ofReceiptsWithTransport
    pressurePrefixN frequencyLeakage hPressure hFanout
    (FreshFrequencyTransportLeakageReceipt.ofRoute1ChannelVisibility hChannels)
    hComm hBoundary
    (by
      simpa using leakage_split_before_channel_bounds)

/--
Pressure-piece control with nonzero remainders routed outside shard B.

This is the honest companion to `FreshFrequencyPressureEnergyLocalCZReserveControl`.
The pure shard-B theorem is available when the harmonic, child-collar, and
cutoff/CZ pieces are already absent.  Here those pieces remain nonzero and must
be paid by independent pressure receipts or by the shard-C leakage ledger.
-/
structure FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  pressureObligation : Route1PressureReserveNoEscapeObligation
  leakageBookkeeping :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L
  freshPressureEnergy : Real
  localCZPressureEnergy : Real
  pressureRemainderEnergy : Real
  harmonicPressureReserveEnergy : Real
  childCollarPressureEnergy : Real
  cutoffCommutatorPressureError : Real
  C_pressure : Real
  C_CZ : Real
  C_pressure_nonneg : 0 ≤ C_pressure
  C_CZ_nonneg : 0 ≤ C_CZ
  pressureExcessBound_nonneg :
    0 ≤ hRho.cknExcessData.pressureExcessBound
  pressureEnergy_decomposition :
    freshPressureEnergy ≤ localCZPressureEnergy + pressureRemainderEnergy
  pressureRemainder_split :
    pressureRemainderEnergy ≤
      harmonicPressureReserveEnergy + childCollarPressureEnergy +
        cutoffCommutatorPressureError
  localCZ_le_pressureExcess :
    localCZPressureEnergy ≤
      C_CZ * hRho.cknExcessData.pressureExcessBound
  harmonicReserve_le_pressureReserveReceipt :
    harmonicPressureReserveEnergy ≤
      (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt
  childCollar_le_childReceipt :
    childCollarPressureEnergy ≤
      (route1PressureVisibilityReceipts pressureObligation).childChargeReceipt
  cutoffCommutator_le_shardCLeakage :
    cutoffCommutatorPressureError ≤
      leakageBookkeeping.commutatorLeakageCharge +
        leakageBookkeeping.boundaryLeakageCharge
  localQuadraticReceipt_nonneg :
    0 ≤ (route1PressureVisibilityReceipts pressureObligation).localQuadraticReceipt
  coefficient_budget :
    C_CZ ≤ C_pressure
  pressureLocalizedBeforeCZ :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  fixedPressureGauge :
    hRho.cknExcessData.pressureGaugeFixedExcess
  sameScaleRadiusAndFreshCutoff : Prop
  localCalderonZygmundOnFreshRegion : Prop
  pressureObligationUsesSameFreshTent : Prop
  harmonicPressureReserveBookedByPressureReceipt : Prop
  childCollarPressureRoutedToPressureChildReceipt : Prop
  cutoffCommutatorRoutedToShardCLeakage : Prop
  noRemainderAbsorbedIntoShardB : Prop
  noTailBudgetOrStrictnessInput : Prop

/-- Nonlocal pressure remainders are paid outside shard B. -/
theorem pressureRemainder_le_receipts_and_shardCLeakage
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl
        seq K hRho hCarrier hBeta hEvents L) :
    h.pressureRemainderEnergy ≤
      (route1PressureVisibilityReceipts h.pressureObligation).receiptSum +
        h.leakageBookkeeping.commutatorLeakageCharge +
          h.leakageBookkeeping.boundaryLeakageCharge := by
  have hreceipt :
      (route1PressureVisibilityReceipts h.pressureObligation).pressureReserveReceipt +
          (route1PressureVisibilityReceipts h.pressureObligation).childChargeReceipt ≤
        (route1PressureVisibilityReceipts h.pressureObligation).receiptSum := by
    dsimp [Route1PressureVisibilityReceipts.receiptSum]
    nlinarith [h.localQuadraticReceipt_nonneg]
  nlinarith [h.pressureRemainder_split,
    h.harmonicReserve_le_pressureReserveReceipt,
    h.childCollar_le_childReceipt,
    h.cutoffCommutator_le_shardCLeakage, hreceipt]

/--
Local-CZ plus outside-shard booking controls the pressure piece without forcing
harmonic, child-collar, or cutoff/CZ pressure remainders to vanish.
-/
theorem freshPressureEnergy_le_pressureExcessBound_plus_shardCCharges
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl
        seq K hRho hCarrier hBeta hEvents L) :
    h.freshPressureEnergy ≤
      h.C_pressure * hRho.cknExcessData.pressureExcessBound +
        (route1PressureVisibilityReceipts h.pressureObligation).receiptSum +
          h.leakageBookkeeping.commutatorLeakageCharge +
            h.leakageBookkeeping.boundaryLeakageCharge := by
  have hcoeff :
      h.C_CZ * hRho.cknExcessData.pressureExcessBound ≤
        h.C_pressure * hRho.cknExcessData.pressureExcessBound :=
    mul_le_mul_of_nonneg_right h.coefficient_budget
      h.pressureExcessBound_nonneg
  have hlocal :
      h.localCZPressureEnergy ≤
        h.C_pressure * hRho.cknExcessData.pressureExcessBound :=
    le_trans h.localCZ_le_pressureExcess hcoeff
  have hrem :=
    pressureRemainder_le_receipts_and_shardCLeakage h
  nlinarith [h.pressureEnergy_decomposition, hlocal, hrem]

/--
Constructor from the same-gauge local CZ source plus existing shard-C leakage
bookkeeping.  This keeps the remainders visible instead of using zero
equalities to obtain a pure shard-B pressure bound.
-/
def FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl.ofLocalCZSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hCZ : FreshFrequencyLocalCZPressureExcessSource seq K hRho)
    (hLeak :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L)
    (freshPressureEnergy harmonicPressureReserveEnergy
      childCollarPressureEnergy cutoffCommutatorPressureError
      C_pressure : Real)
    (C_pressure_nonneg : 0 ≤ C_pressure)
    (pressureEnergy_decomposition :
      freshPressureEnergy ≤
        hCZ.localCZPressureEnergy +
          (harmonicPressureReserveEnergy + childCollarPressureEnergy +
            cutoffCommutatorPressureError))
    (harmonicReserve_le_pressureReserveReceipt :
      harmonicPressureReserveEnergy ≤
        (route1PressureVisibilityReceipts hCZ.pressureObligation).pressureReserveReceipt)
    (childCollar_le_childReceipt :
      childCollarPressureEnergy ≤
        (route1PressureVisibilityReceipts hCZ.pressureObligation).childChargeReceipt)
    (cutoffCommutator_le_shardCLeakage :
      cutoffCommutatorPressureError ≤
        hLeak.commutatorLeakageCharge + hLeak.boundaryLeakageCharge)
    (localQuadraticReceipt_nonneg :
      0 ≤ (route1PressureVisibilityReceipts hCZ.pressureObligation).localQuadraticReceipt)
    (coefficient_budget : hCZ.C_CZ ≤ C_pressure)
    (pressureLocalizedBeforeCZ :
      hCZ.residualFreshExcess.pressureTailLocalizedToFreshVelocity)
    (childCollarPressureRoutedToPressureChildReceipt : Prop)
    (cutoffCommutatorRoutedToShardCLeakage : Prop) :
    FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl
      seq K hRho hCarrier hBeta hEvents L where
  residualFreshExcess := hCZ.residualFreshExcess
  pressureObligation := hCZ.pressureObligation
  leakageBookkeeping := hLeak
  freshPressureEnergy := freshPressureEnergy
  localCZPressureEnergy := hCZ.localCZPressureEnergy
  pressureRemainderEnergy :=
    harmonicPressureReserveEnergy + childCollarPressureEnergy +
      cutoffCommutatorPressureError
  harmonicPressureReserveEnergy := harmonicPressureReserveEnergy
  childCollarPressureEnergy := childCollarPressureEnergy
  cutoffCommutatorPressureError := cutoffCommutatorPressureError
  C_pressure := C_pressure
  C_CZ := hCZ.C_CZ
  C_pressure_nonneg := C_pressure_nonneg
  C_CZ_nonneg := hCZ.C_CZ_nonneg
  pressureExcessBound_nonneg := by
    rw [← hCZ.pressureExcessBound_eq_cknData]
    exact hCZ.pressureExcessBound_nonneg
  pressureEnergy_decomposition := pressureEnergy_decomposition
  pressureRemainder_split := by
    rfl
  localCZ_le_pressureExcess :=
    localCZPressureEnergy_le_pressureExcessBound_of_localCZSource hCZ
  harmonicReserve_le_pressureReserveReceipt :=
    harmonicReserve_le_pressureReserveReceipt
  childCollar_le_childReceipt := childCollar_le_childReceipt
  cutoffCommutator_le_shardCLeakage := cutoffCommutator_le_shardCLeakage
  localQuadraticReceipt_nonneg := localQuadraticReceipt_nonneg
  coefficient_budget := coefficient_budget
  pressureLocalizedBeforeCZ := pressureLocalizedBeforeCZ
  fixedPressureGauge := hCZ.samePressureGaugeAsCKNData
  sameScaleRadiusAndFreshCutoff := hCZ.sameScaleRadiusAndFreshCutoff
  localCalderonZygmundOnFreshRegion :=
    hCZ.localCZKernelTruncatedToFreshRegion
  pressureObligationUsesSameFreshTent :=
    hCZ.pressureObligationUsesSameFreshTent
  harmonicPressureReserveBookedByPressureReceipt :=
    hCZ.harmonicPressureExcludedFromLocalCZ
  childCollarPressureRoutedToPressureChildReceipt :=
    childCollarPressureRoutedToPressureChildReceipt
  cutoffCommutatorRoutedToShardCLeakage :=
    cutoffCommutatorRoutedToShardCLeakage
  noRemainderAbsorbedIntoShardB :=
    And hCZ.childCollarPressureNotIncludedInRecoveredRiesz
      hCZ.cutoffCommutatorExcludedFromLocalCZ
  noTailBudgetOrStrictnessInput :=
    hCZ.noTailBudgetOrStrictnessInLocalCZ

/--
Lower source bundle for the three pressure-remainder charge inequalities.

The receipt quantities are not allowed to be defined from the remainders they
pay.  Each remainder first maps to a separately fixed source charge; those
source charges are then compared with the pressure receipt or shard-C leakage
channel.
-/
structure FreshFrequencyPressureRemainderChargeSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger)
    (pressureObligation : Route1PressureReserveNoEscapeObligation)
    (leakageBookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L) where
  harmonicPressureReserveEnergy : Real
  childCollarPressureEnergy : Real
  cutoffCommutatorPressureError : Real
  harmonicReserveSourceEnergy : Real
  childCollarSourceCharge : Real
  cutoffCommutatorSourceCharge : Real
  harmonicReserve_le_source :
    harmonicPressureReserveEnergy ≤ harmonicReserveSourceEnergy
  harmonicSource_le_pressureReserveReceipt :
    harmonicReserveSourceEnergy ≤
      (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt
  childCollar_le_source :
    childCollarPressureEnergy ≤ childCollarSourceCharge
  childSource_le_childReceipt :
    childCollarSourceCharge ≤
      (route1PressureVisibilityReceipts pressureObligation).childChargeReceipt
  cutoffCommutator_le_source :
    cutoffCommutatorPressureError ≤ cutoffCommutatorSourceCharge
  cutoffSource_le_shardCLeakage :
    cutoffCommutatorSourceCharge ≤
      leakageBookkeeping.commutatorLeakageCharge +
        leakageBookkeeping.boundaryLeakageCharge
  localQuadraticReceipt_nonneg :
    0 ≤ (route1PressureVisibilityReceipts pressureObligation).localQuadraticReceipt
  harmonicSourceFixedBeforePressureReserveComparison : Prop
  childCollarSourceFixedBeforeChildReceiptComparison : Prop
  cutoffCommutatorSourceFixedBeforeShardCComparison : Prop
  harmonicReserveUsesPressureDecomposition : Prop
  childCollarUsesGeometricCollarCover : Prop
  cutoffCommutatorUsesEndpointDefectAndBoundaryCutoff : Prop
  noReceiptDefinedFromItsRemainder : Prop
  noShardCDoubleCounting : Prop
  noTailBudgetOrStrictnessInput : Prop

/-- The lower source bundle projects the three pressure-remainder charges. -/
theorem pressureRemainderChargeSource_projects
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureObligation : Route1PressureReserveNoEscapeObligation}
    {leakageBookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L}
    (h :
      FreshFrequencyPressureRemainderChargeSource
        seq K hRho hCarrier hBeta hEvents L
        pressureObligation leakageBookkeeping) :
    h.harmonicPressureReserveEnergy ≤
        (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt ∧
      h.childCollarPressureEnergy ≤
        (route1PressureVisibilityReceipts pressureObligation).childChargeReceipt ∧
      h.cutoffCommutatorPressureError ≤
        leakageBookkeeping.commutatorLeakageCharge +
          leakageBookkeeping.boundaryLeakageCharge := by
  exact
    ⟨le_trans h.harmonicReserve_le_source
        h.harmonicSource_le_pressureReserveReceipt,
      le_trans h.childCollar_le_source h.childSource_le_childReceipt,
      le_trans h.cutoffCommutator_le_source
        h.cutoffSource_le_shardCLeakage⟩

/--
Harmonic pressure reserve source below the pressure-remainder charge bundle.

The source charge is tied to the pressure decomposition reserve exposed by
`Route1PressureReserveNoEscapeObligation`, before it is projected as the
route-1 pressure-reserve receipt.  This keeps the harmonic branch from being
defined as whatever the final receipt happens to pay.
-/
structure FreshFrequencyHarmonicPressureReserveSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (pressureObligation : Route1PressureReserveNoEscapeObligation) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  harmonicPressureReserveEnergy : Real
  harmonicReserveSourceEnergy : Real
  harmonicReserve_le_source :
    harmonicPressureReserveEnergy ≤ harmonicReserveSourceEnergy
  source_le_decompositionReserve :
    harmonicReserveSourceEnergy ≤
      pressureObligation.decomposition.pressureReserve
  decompositionReserve_eq_pressureReserveReceipt :
    pressureObligation.decomposition.pressureReserve =
      (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt
  pressureReserveReceipt_nonneg :
    0 ≤ (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt
  pressureLocalizedBeforeHarmonicSplit :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  pressureGaugeFixedBeforeHarmonicProjection :
    hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed
  harmonicSourceFixedBeforePressureReserveReceipt : Prop
  harmonicReserveUsesLocalPressureDecomposition : Prop
  harmonicPartExcludedFromLocalCZRecovery : Prop
  pressureReserveReceiptProjectedAfterDecomposition : Prop
  harmonicSourceNotDefinedFromFinalReceipt : Prop
  noTailBudgetOrStrictnessInput : Prop

/--
Formula-level pressure-decomposition source beneath the harmonic reserve.

The harmonic source is measured as the harmonic component of a local pressure
split before the route-1 pressure reserve is projected as a receipt.
-/
structure FreshFrequencyHarmonicPressureDecompositionSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (pressureObligation : Route1PressureReserveNoEscapeObligation) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  localizedPressureTailEnergy : Real
  localRieszPressureEnergy : Real
  harmonicPressureComponentEnergy : Real
  childCollarPressureEnergy : Real
  cutoffCommutatorPressureEnergy : Real
  harmonicPressureReserveEnergy : Real
  harmonicReserveSourceEnergy : Real
  pressureDecompositionReserveEnergy : Real
  harmonicReserve_le_source :
    harmonicPressureReserveEnergy ≤ harmonicReserveSourceEnergy
  source_le_harmonicComponent :
    harmonicReserveSourceEnergy ≤ harmonicPressureComponentEnergy
  harmonicComponent_le_decompositionReserve :
    harmonicPressureComponentEnergy ≤ pressureDecompositionReserveEnergy
  pressureDecompositionReserve_eq_obligationReserve :
    pressureDecompositionReserveEnergy =
      pressureObligation.decomposition.pressureReserve
  localizedPressureTail_decomposes :
    localizedPressureTailEnergy =
      localRieszPressureEnergy + harmonicPressureComponentEnergy +
        childCollarPressureEnergy + cutoffCommutatorPressureEnergy
  pressureLocalizedBeforeHarmonicSplit :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  pressureGaugeFixedBeforeHarmonicProjection :
    hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed
  localPressureSplitBeforeReserveReceipt : Prop
  harmonicComponentFixedByLocalBoundaryData : Prop
  localRieszComponentExcludedFromHarmonicReserve : Prop
  childCollarComponentExcludedFromHarmonicReserve : Prop
  cutoffCommutatorExcludedFromHarmonicReserve : Prop
  decompositionReserveFixedBeforeReceiptProjection : Prop
  harmonicSourceNotDefinedFromReserveReceipt : Prop
  pressureDecompositionReserveNotDefinedFromHarmonicSource : Prop
  noTailBudgetOrStrictnessInput : Prop

/-- The harmonic pressure-decomposition source pays the decomposition reserve. -/
theorem harmonicReserveSource_le_decompositionReserve_of_decompositionSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {pressureObligation : Route1PressureReserveNoEscapeObligation}
    (h :
      FreshFrequencyHarmonicPressureDecompositionSource
        seq K hRho pressureObligation) :
    h.harmonicReserveSourceEnergy ≤
      pressureObligation.decomposition.pressureReserve := by
  have hreserve :
      h.harmonicReserveSourceEnergy ≤
        h.pressureDecompositionReserveEnergy :=
    le_trans h.source_le_harmonicComponent
      h.harmonicComponent_le_decompositionReserve
  rw [← h.pressureDecompositionReserve_eq_obligationReserve]
  exact hreserve

/--
Promote a formula-level harmonic pressure decomposition into the harmonic
reserve source used by the pressure-remainder bundle.
-/
def FreshFrequencyHarmonicPressureReserveSource.ofDecompositionSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {pressureObligation : Route1PressureReserveNoEscapeObligation}
    (h :
      FreshFrequencyHarmonicPressureDecompositionSource
        seq K hRho pressureObligation) :
    FreshFrequencyHarmonicPressureReserveSource
      seq K hRho pressureObligation where
  residualFreshExcess := h.residualFreshExcess
  harmonicPressureReserveEnergy := h.harmonicPressureReserveEnergy
  harmonicReserveSourceEnergy := h.harmonicReserveSourceEnergy
  harmonicReserve_le_source := h.harmonicReserve_le_source
  source_le_decompositionReserve :=
    harmonicReserveSource_le_decompositionReserve_of_decompositionSource h
  decompositionReserve_eq_pressureReserveReceipt := rfl
  pressureReserveReceipt_nonneg :=
    pressureObligation.decomposition.pressureReserve_nonneg
  pressureLocalizedBeforeHarmonicSplit :=
    h.pressureLocalizedBeforeHarmonicSplit
  pressureGaugeFixedBeforeHarmonicProjection :=
    h.pressureGaugeFixedBeforeHarmonicProjection
  harmonicSourceFixedBeforePressureReserveReceipt :=
    h.harmonicSourceNotDefinedFromReserveReceipt
  harmonicReserveUsesLocalPressureDecomposition :=
    h.localPressureSplitBeforeReserveReceipt
  harmonicPartExcludedFromLocalCZRecovery :=
    h.localRieszComponentExcludedFromHarmonicReserve
  pressureReserveReceiptProjectedAfterDecomposition :=
    h.decompositionReserveFixedBeforeReceiptProjection
  harmonicSourceNotDefinedFromFinalReceipt :=
    h.harmonicSourceNotDefinedFromReserveReceipt
  noTailBudgetOrStrictnessInput := h.noTailBudgetOrStrictnessInput

/-- The harmonic pressure reserve source pays the pressure-reserve receipt. -/
theorem harmonicReserve_le_pressureReserveReceipt_of_harmonicSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {pressureObligation : Route1PressureReserveNoEscapeObligation}
    (h :
      FreshFrequencyHarmonicPressureReserveSource
        seq K hRho pressureObligation) :
    h.harmonicPressureReserveEnergy ≤
      (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt := by
  have hsource :
      h.harmonicReserveSourceEnergy ≤
        (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt := by
    rw [← h.decompositionReserve_eq_pressureReserveReceipt]
    exact h.source_le_decompositionReserve
  exact le_trans h.harmonicReserve_le_source hsource

/--
Child-collar source estimate below the pressure-remainder charge bundle.

The child receipt is not identified with the collar error.  The collar pressure
first maps to a geometric cover charge on the same fresh tent/tree; bounded
fanout and no-reuse are kept in the source object before comparison with the
independently exposed child receipt.
-/
structure FreshFrequencyChildCollarGeometricChargeSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger)
    (pressureObligation : Route1PressureReserveNoEscapeObligation) where
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  childCollarPressureEnergy : Real
  geometricCollarCoverCharge : Real
  childCollarSourceCharge : Real
  childCollar_le_geometricCover :
    childCollarPressureEnergy ≤ geometricCollarCoverCharge
  geometricCover_le_childSource :
    geometricCollarCoverCharge ≤ childCollarSourceCharge
  childSource_le_childReceipt :
    childCollarSourceCharge ≤
      (route1PressureVisibilityReceipts pressureObligation).childChargeReceipt
  childReceiptFixedBeforeCollarCover : Prop
  geometricCoverUsesSameFreshTentTree : Prop
  collarCoverUsesBoundedFanout :
    boundedFanoutNoLogReuse.comparableScaleTentOverlapBounded
  noSameScaleChildReuse :
    boundedFanoutNoLogReuse.noSameScaleLogarithmicMultiplicityPerEvent
  childChargeNotDefinedFromCollarError : Prop
  noTailBudgetOrStrictnessInput : Prop

/-- The geometric collar-cover source pays the child-collar pressure charge. -/
theorem childCollarPressure_le_childReceipt_of_geometricChargeSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureObligation : Route1PressureReserveNoEscapeObligation}
    (h :
      FreshFrequencyChildCollarGeometricChargeSource
        seq K hRho hCarrier hBeta hEvents L pressureObligation) :
    h.childCollarPressureEnergy ≤
      (route1PressureVisibilityReceipts pressureObligation).childChargeReceipt :=
  le_trans h.childCollar_le_geometricCover
    (le_trans h.geometricCover_le_childSource
      h.childSource_le_childReceipt)

/--
Cutoff/CZ pressure commutator source below shard-C leakage.

The pressure cutoff commutator is split before it touches the shard-C ledger:
one part is an endpoint commutator defect and the other is a tent-boundary
cutoff error.  This prevents the source from being defined as the sum of the
two shard-C leakage charges after the fact.
-/
structure FreshFrequencyCutoffCZCommutatorLeakageSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger)
    (leakageBookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L) where
  cutoffCommutatorPressureError : Real
  endpointCommutatorPressureCharge : Real
  boundaryCutoffPressureCharge : Real
  cutoffCommutatorSourceCharge : Real
  cutoffCommutator_split_before_shardC :
    cutoffCommutatorPressureError ≤
      endpointCommutatorPressureCharge + boundaryCutoffPressureCharge
  endpointCharge_le_commutatorLeakage :
    endpointCommutatorPressureCharge ≤
      leakageBookkeeping.commutatorLeakageCharge
  boundaryCharge_le_boundaryLeakage :
    boundaryCutoffPressureCharge ≤
      leakageBookkeeping.boundaryLeakageCharge
  sourceCharge_accounts_split :
    endpointCommutatorPressureCharge + boundaryCutoffPressureCharge ≤
      cutoffCommutatorSourceCharge
  sourceCharge_le_shardCLeakage :
    cutoffCommutatorSourceCharge ≤
      leakageBookkeeping.commutatorLeakageCharge +
        leakageBookkeeping.boundaryLeakageCharge
  endpointPartUsesEndpointCommutatorDefect :
    leakageBookkeeping.commutatorChargeUsesEndpointDefectMeasure
  boundaryPartUsesTentBoundaryTruncation :
    leakageBookkeeping.boundaryChargeIsTentTruncationError
  cutoffCZCommutatorFixedBeforeShardCComparison : Prop
  endpointAndBoundaryPartsDisjointlyBooked : Prop
  pressureGaugeFixedBeforeCutoffCommutator : Prop
  sameFreshTentCutoffAsShardCLeakage : Prop
  noShardCDoubleCounting : Prop
  noSourceDefinedFromFinalLeakageSum : Prop
  noTailBudgetOrStrictnessInput : Prop

/--
The cutoff/CZ commutator source pays the shard-C commutator plus boundary
leakage charges.
-/
theorem cutoffCZCommutatorPressureError_le_shardCLeakage
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {leakageBookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L}
    (h :
      FreshFrequencyCutoffCZCommutatorLeakageSource
        seq K hRho hCarrier hBeta hEvents L leakageBookkeeping) :
    h.cutoffCommutatorPressureError ≤
      leakageBookkeeping.commutatorLeakageCharge +
        leakageBookkeeping.boundaryLeakageCharge := by
  exact le_trans h.cutoffCommutator_split_before_shardC
    (le_trans h.sourceCharge_accounts_split
      h.sourceCharge_le_shardCLeakage)

/--
Direct version using the split endpoint and boundary comparisons.  This is a
useful audit projection: it does not go through the final source charge.
-/
theorem cutoffCZCommutatorPressureError_le_shardCLeakage_direct
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {leakageBookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L}
    (h :
      FreshFrequencyCutoffCZCommutatorLeakageSource
        seq K hRho hCarrier hBeta hEvents L leakageBookkeeping) :
    h.cutoffCommutatorPressureError ≤
      leakageBookkeeping.commutatorLeakageCharge +
        leakageBookkeeping.boundaryLeakageCharge := by
  nlinarith [h.cutoffCommutator_split_before_shardC,
    h.endpointCharge_le_commutatorLeakage,
    h.boundaryCharge_le_boundaryLeakage]

/--
Build the pressure-remainder charge bundle from the two lowered nonlocal
sources already available on the pressure branch.

Only the harmonic reserve remains as an explicit pressure-decomposition source
input.  The child-collar and cutoff/CZ obligations are paid by their named lower
source objects, not reintroduced as raw receipt inequalities.
-/
def FreshFrequencyPressureRemainderChargeSource.ofHarmonicAndLowerSources
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureObligation : Route1PressureReserveNoEscapeObligation}
    {leakageBookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L}
    (hChild :
      FreshFrequencyChildCollarGeometricChargeSource
        seq K hRho hCarrier hBeta hEvents L pressureObligation)
    (hCutoff :
      FreshFrequencyCutoffCZCommutatorLeakageSource
        seq K hRho hCarrier hBeta hEvents L leakageBookkeeping)
    (harmonicPressureReserveEnergy harmonicReserveSourceEnergy : Real)
    (harmonicReserve_le_source :
      harmonicPressureReserveEnergy ≤ harmonicReserveSourceEnergy)
    (harmonicSource_le_pressureReserveReceipt :
      harmonicReserveSourceEnergy ≤
        (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt)
    (localQuadraticReceipt_nonneg :
      0 ≤ (route1PressureVisibilityReceipts pressureObligation).localQuadraticReceipt)
    (harmonicSourceFixedBeforePressureReserveComparison : Prop)
    (harmonicReserveUsesPressureDecomposition : Prop)
    (noReceiptDefinedFromItsRemainder : Prop)
    (noTailBudgetOrStrictnessInput : Prop) :
    FreshFrequencyPressureRemainderChargeSource
      seq K hRho hCarrier hBeta hEvents L
      pressureObligation leakageBookkeeping where
  harmonicPressureReserveEnergy := harmonicPressureReserveEnergy
  childCollarPressureEnergy := hChild.childCollarPressureEnergy
  cutoffCommutatorPressureError := hCutoff.cutoffCommutatorPressureError
  harmonicReserveSourceEnergy := harmonicReserveSourceEnergy
  childCollarSourceCharge := hChild.childCollarSourceCharge
  cutoffCommutatorSourceCharge := hCutoff.cutoffCommutatorSourceCharge
  harmonicReserve_le_source := harmonicReserve_le_source
  harmonicSource_le_pressureReserveReceipt :=
    harmonicSource_le_pressureReserveReceipt
  childCollar_le_source :=
    le_trans hChild.childCollar_le_geometricCover
      hChild.geometricCover_le_childSource
  childSource_le_childReceipt := hChild.childSource_le_childReceipt
  cutoffCommutator_le_source :=
    le_trans hCutoff.cutoffCommutator_split_before_shardC
      hCutoff.sourceCharge_accounts_split
  cutoffSource_le_shardCLeakage := hCutoff.sourceCharge_le_shardCLeakage
  localQuadraticReceipt_nonneg := localQuadraticReceipt_nonneg
  harmonicSourceFixedBeforePressureReserveComparison :=
    harmonicSourceFixedBeforePressureReserveComparison
  childCollarSourceFixedBeforeChildReceiptComparison :=
    hChild.childReceiptFixedBeforeCollarCover
  cutoffCommutatorSourceFixedBeforeShardCComparison :=
    hCutoff.cutoffCZCommutatorFixedBeforeShardCComparison
  harmonicReserveUsesPressureDecomposition :=
    harmonicReserveUsesPressureDecomposition
  childCollarUsesGeometricCollarCover :=
    And hChild.geometricCoverUsesSameFreshTentTree
      hChild.boundedFanoutNoLogReuse.comparableScaleTentOverlapBounded
  cutoffCommutatorUsesEndpointDefectAndBoundaryCutoff :=
    And leakageBookkeeping.commutatorChargeUsesEndpointDefectMeasure
      leakageBookkeeping.boundaryChargeIsTentTruncationError
  noReceiptDefinedFromItsRemainder :=
    And noReceiptDefinedFromItsRemainder
      (And hChild.childChargeNotDefinedFromCollarError
        hCutoff.noSourceDefinedFromFinalLeakageSum)
  noShardCDoubleCounting := hCutoff.noShardCDoubleCounting
  noTailBudgetOrStrictnessInput :=
    And noTailBudgetOrStrictnessInput
      (And hChild.noTailBudgetOrStrictnessInput
        hCutoff.noTailBudgetOrStrictnessInput)

/--
Build the pressure-remainder charge bundle from all three lowered source
objects.  After this point, the bundle no longer asks for any raw pressure
remainder receipt inequality.
-/
def FreshFrequencyPressureRemainderChargeSource.ofLowerSources
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureObligation : Route1PressureReserveNoEscapeObligation}
    {leakageBookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L}
    (hHarmonic :
      FreshFrequencyHarmonicPressureReserveSource
        seq K hRho pressureObligation)
    (hChild :
      FreshFrequencyChildCollarGeometricChargeSource
        seq K hRho hCarrier hBeta hEvents L pressureObligation)
    (hCutoff :
      FreshFrequencyCutoffCZCommutatorLeakageSource
        seq K hRho hCarrier hBeta hEvents L leakageBookkeeping)
    (localQuadraticReceipt_nonneg :
      0 ≤ (route1PressureVisibilityReceipts pressureObligation).localQuadraticReceipt)
    (noReceiptDefinedFromItsRemainder : Prop) :
    FreshFrequencyPressureRemainderChargeSource
      seq K hRho hCarrier hBeta hEvents L
      pressureObligation leakageBookkeeping :=
  FreshFrequencyPressureRemainderChargeSource.ofHarmonicAndLowerSources
    hChild hCutoff hHarmonic.harmonicPressureReserveEnergy
    hHarmonic.harmonicReserveSourceEnergy hHarmonic.harmonicReserve_le_source
    (by
      have hsource :
          hHarmonic.harmonicReserveSourceEnergy ≤
            (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt := by
        rw [← hHarmonic.decompositionReserve_eq_pressureReserveReceipt]
        exact hHarmonic.source_le_decompositionReserve
      exact hsource)
    localQuadraticReceipt_nonneg
    hHarmonic.harmonicSourceFixedBeforePressureReserveReceipt
    hHarmonic.harmonicReserveUsesLocalPressureDecomposition
    noReceiptDefinedFromItsRemainder
    hHarmonic.noTailBudgetOrStrictnessInput

/--
Constructor from local CZ plus the lower pressure-remainder source bundle.
This is the bundle-discriminator route: it keeps all three nonlocal pressure
remainders visible and independently charged.
-/
def FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl.ofLocalCZAndChargeSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hCZ : FreshFrequencyLocalCZPressureExcessSource seq K hRho)
    (hLeak :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L)
    (hCharge :
      FreshFrequencyPressureRemainderChargeSource
        seq K hRho hCarrier hBeta hEvents L
        hCZ.pressureObligation hLeak)
    (freshPressureEnergy C_pressure : Real)
    (C_pressure_nonneg : 0 ≤ C_pressure)
    (pressureEnergy_decomposition :
      freshPressureEnergy ≤
        hCZ.localCZPressureEnergy +
          (hCharge.harmonicPressureReserveEnergy +
            hCharge.childCollarPressureEnergy +
              hCharge.cutoffCommutatorPressureError))
    (coefficient_budget : hCZ.C_CZ ≤ C_pressure)
    (pressureLocalizedBeforeCZ :
      hCZ.residualFreshExcess.pressureTailLocalizedToFreshVelocity) :
    FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl
      seq K hRho hCarrier hBeta hEvents L := by
  rcases pressureRemainderChargeSource_projects hCharge with
    ⟨hharmonic, hchild, hcutoff⟩
  exact
    FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl.ofLocalCZSource
      hCZ hLeak freshPressureEnergy
      hCharge.harmonicPressureReserveEnergy
      hCharge.childCollarPressureEnergy
      hCharge.cutoffCommutatorPressureError
      C_pressure C_pressure_nonneg pressureEnergy_decomposition
      hharmonic hchild hcutoff hCharge.localQuadraticReceipt_nonneg
      coefficient_budget pressureLocalizedBeforeCZ
      hCharge.childCollarUsesGeometricCollarCover
      hCharge.cutoffCommutatorUsesEndpointDefectAndBoundaryCutoff

/--
Direct constructor from local CZ plus lowered child/cutoff sources.

This composes the current pressure-remainder branch into one object with a
single remaining open source estimate: the harmonic pressure reserve.
-/
def FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl.ofLocalCZAndLowerRemainderSources
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hCZ : FreshFrequencyLocalCZPressureExcessSource seq K hRho)
    (hLeak :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L)
    (hChild :
      FreshFrequencyChildCollarGeometricChargeSource
        seq K hRho hCarrier hBeta hEvents L hCZ.pressureObligation)
    (hCutoff :
      FreshFrequencyCutoffCZCommutatorLeakageSource
        seq K hRho hCarrier hBeta hEvents L hLeak)
    (harmonicPressureReserveEnergy harmonicReserveSourceEnergy
      freshPressureEnergy C_pressure : Real)
    (harmonicReserve_le_source :
      harmonicPressureReserveEnergy ≤ harmonicReserveSourceEnergy)
    (harmonicSource_le_pressureReserveReceipt :
      harmonicReserveSourceEnergy ≤
        (route1PressureVisibilityReceipts hCZ.pressureObligation).pressureReserveReceipt)
    (localQuadraticReceipt_nonneg :
      0 ≤ (route1PressureVisibilityReceipts hCZ.pressureObligation).localQuadraticReceipt)
    (C_pressure_nonneg : 0 ≤ C_pressure)
    (pressureEnergy_decomposition :
      freshPressureEnergy ≤
        hCZ.localCZPressureEnergy +
          (harmonicPressureReserveEnergy +
            hChild.childCollarPressureEnergy +
              hCutoff.cutoffCommutatorPressureError))
    (coefficient_budget : hCZ.C_CZ ≤ C_pressure)
    (pressureLocalizedBeforeCZ :
      hCZ.residualFreshExcess.pressureTailLocalizedToFreshVelocity)
    (harmonicSourceFixedBeforePressureReserveComparison : Prop)
    (harmonicReserveUsesPressureDecomposition : Prop)
    (noReceiptDefinedFromItsRemainder : Prop)
    (noTailBudgetOrStrictnessInput : Prop) :
    FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl
      seq K hRho hCarrier hBeta hEvents L :=
  FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl.ofLocalCZAndChargeSource
    hCZ hLeak
    (FreshFrequencyPressureRemainderChargeSource.ofHarmonicAndLowerSources
      hChild hCutoff harmonicPressureReserveEnergy
      harmonicReserveSourceEnergy harmonicReserve_le_source
      harmonicSource_le_pressureReserveReceipt localQuadraticReceipt_nonneg
      harmonicSourceFixedBeforePressureReserveComparison
      harmonicReserveUsesPressureDecomposition
      noReceiptDefinedFromItsRemainder noTailBudgetOrStrictnessInput)
    freshPressureEnergy C_pressure C_pressure_nonneg
    pressureEnergy_decomposition coefficient_budget pressureLocalizedBeforeCZ

namespace FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl

/--
Direct pressure-piece constructor from local CZ plus all three lowered
pressure-remainder source objects.
-/
def ofLocalCZAndAllLowerRemainderSources
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hCZ : FreshFrequencyLocalCZPressureExcessSource seq K hRho)
    (hLeak :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L)
    (hHarmonic :
      FreshFrequencyHarmonicPressureReserveSource
        seq K hRho hCZ.pressureObligation)
    (hChild :
      FreshFrequencyChildCollarGeometricChargeSource
        seq K hRho hCarrier hBeta hEvents L hCZ.pressureObligation)
    (hCutoff :
      FreshFrequencyCutoffCZCommutatorLeakageSource
        seq K hRho hCarrier hBeta hEvents L hLeak)
    (freshPressureEnergy C_pressure : Real)
    (localQuadraticReceipt_nonneg :
      0 ≤ (route1PressureVisibilityReceipts hCZ.pressureObligation).localQuadraticReceipt)
    (C_pressure_nonneg : 0 ≤ C_pressure)
    (pressureEnergy_decomposition :
      freshPressureEnergy ≤
        hCZ.localCZPressureEnergy +
          (hHarmonic.harmonicPressureReserveEnergy +
            hChild.childCollarPressureEnergy +
              hCutoff.cutoffCommutatorPressureError))
    (coefficient_budget : hCZ.C_CZ ≤ C_pressure)
    (pressureLocalizedBeforeCZ :
      hCZ.residualFreshExcess.pressureTailLocalizedToFreshVelocity)
    (noReceiptDefinedFromItsRemainder : Prop) :
    FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl
      seq K hRho hCarrier hBeta hEvents L :=
  FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl.ofLocalCZAndChargeSource
    hCZ hLeak
    (FreshFrequencyPressureRemainderChargeSource.ofLowerSources
      hHarmonic hChild hCutoff localQuadraticReceipt_nonneg
      noReceiptDefinedFromItsRemainder)
    freshPressureEnergy C_pressure C_pressure_nonneg
    pressureEnergy_decomposition coefficient_budget pressureLocalizedBeforeCZ

end FreshFrequencyPressureEnergyShardBPlusShardCRemainderControl

/-- Shard 3: account for the frequency leakage by visible pressure, transport,
commutator, and tent-boundary charges. -/
structure FreshFrequencyLeakageAccounting
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  frequencyLeakage : Real
  pressureTailTerm : Real
  transportVisibility : Real
  commutatorVisibility : Real
  tentBoundaryError : Real
  C_P : Real
  C_T : Real
  C_C : Real
  pressureDuhamelSameCarrier :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  leakage_accounted_by_nonQ_terms :
    frequencyLeakage ≤
      C_P * pressureTailTerm +
        C_T * transportVisibility +
        C_C * commutatorVisibility +
        tentBoundaryError
  frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary : Prop
  no_pressure_or_visibility_margin_input : Prop

/-- Build shard C from lower charge bookkeeping. -/
def FreshFrequencyLeakageAccounting.ofChargeBookkeeping
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L) :
    FreshFrequencyLeakageAccounting
      seq K hRho hCarrier hBeta hEvents L where
  frequencyLeakage := h.frequencyLeakage
  pressureTailTerm := h.pressureTailTerm
  transportVisibility := h.transportVisibility
  commutatorVisibility := h.commutatorVisibility
  tentBoundaryError := h.tentBoundaryError
  C_P := h.C_P
  C_T := h.C_T
  C_C := h.C_C
  pressureDuhamelSameCarrier := h.pressureDuhamelSameCarrier
  boundedFanoutNoLogReuse := h.boundedFanoutNoLogReuse
  leakage_accounted_by_nonQ_terms :=
    leakage_accounted_by_nonQ_terms_of_charge_bookkeeping h
  frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary :=
    And
      h.pressureChargeUsesSameFreshFrequencyCarrier
      (And
        h.transportChargeUsesRouteFluxVisibility
        (And
          h.commutatorChargeUsesEndpointDefectMeasure
          h.boundaryChargeIsTentTruncationError))
  no_pressure_or_visibility_margin_input :=
    And h.chargesFixedBeforeAbsorptionFork h.no_pressure_or_visibility_margin_input

/-- Bundle the deterministic shards into the lower quantitative object. -/
structure FreshFrequencyQuantitativeShardBundle
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  tail :
    FreshFrequencyTailSquareIdentification
      seq K hRho hCarrier hBeta hEvents L
  tent : FreshFrequencyCKNTentPoincareControl
  leakage :
    FreshFrequencyLeakageAccounting
      seq K hRho hCarrier hBeta hEvents L
  tent_tailSquareFunction :
    tent.tailSquareFunction = tail.tailSquareFunction
  leakage_frequencyLeakage :
    leakage.frequencyLeakage = tent.frequencyLeakage
  adapterDoesNotUseStrictSubratio : Prop

/--
Fully lowered A/B/C input bundle.

This is the preferred entry point once the proof supplies the lower shard
objects.  It keeps the old shard records as derived interfaces, so a caller
does not need to pass `FreshFrequencyTailSquareIdentification`,
`FreshFrequencyCKNTentPoincareControl`, or `FreshFrequencyLeakageAccounting`
directly.
-/
structure FreshFrequencyLowerShardBundle
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  tailFixed :
    FreshFrequencyTailSquareFixedCarrierIdentity
      seq K hRho hCarrier hBeta hEvents L
  tailWindowFamily : Prop
  tailSquareFunctionIsFreshFrequencySquareBudget : Prop
  tentPoincare : FreshFrequencyMeanFreeTentPoincareCertificate
  leakageCharges :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L
  tent_tailSquareFunction :
    tentPoincare.tailSquareFunction = tailFixed.tailSquareFunction
  leakage_frequencyLeakage :
    leakageCharges.frequencyLeakage = tentPoincare.frequencyLeakage
  adapterDoesNotUseStrictSubratio : Prop

/-- Assemble the older shard bundle from the fully lowered A/B/C objects. -/
def FreshFrequencyLowerShardBundle.toShardBundle
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyLowerShardBundle
        seq K hRho hCarrier hBeta hEvents L) :
    FreshFrequencyQuantitativeShardBundle
      seq K hRho hCarrier hBeta hEvents L where
  tail :=
    FreshFrequencyTailSquareIdentification.ofFixedCarrierIdentity
      h.tailFixed h.tailWindowFamily
      h.tailSquareFunctionIsFreshFrequencySquareBudget
  tent :=
    FreshFrequencyCKNTentPoincareControl.ofMeanFreeTentPoincareCertificate
      h.tentPoincare
  leakage :=
    FreshFrequencyLeakageAccounting.ofChargeBookkeeping h.leakageCharges
  tent_tailSquareFunction := h.tent_tailSquareFunction
  leakage_frequencyLeakage := h.leakage_frequencyLeakage
  adapterDoesNotUseStrictSubratio :=
    And h.adapterDoesNotUseStrictSubratio
      (And
        h.tailFixed.no_strictness_used_for_tail_identification
        (And
          h.tentPoincare.no_tail_budget_or_strictness_used_to_define_ckn_excess
          h.leakageCharges.no_pressure_or_visibility_margin_input))

/--
Quantitative object below `Adapter`.

This is the anti-laundering repair: it does not accept a completed
`Route1LocalizedCoercivityPoincareDecomposition`.  Instead it stores the
fresh-frequency/event-tent provenance and the three numeric statements that
must be proved from that provenance before route-1 can use the pressure-small
`Q` branch:

1. tail mass is the selected fresh-frequency square function;
2. the square function is controlled by CKN/tent excess plus leakage;
3. the leakage is charged to pressure, transport, commutator, and boundary
   terms.
-/
structure FreshFrequencyToRoute1PoincareQuantitative
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  X_tail : Real
  localQuadraticTentExcess : Real
  pressureTailTerm : Real
  transportVisibility : Real
  commutatorVisibility : Real
  tentBoundaryError : Real
  tailSquareFunction : Real
  frequencyLeakage : Real
  C_Q : Real
  C_P : Real
  C_T : Real
  C_C : Real
  tailSquareFunction_nonneg : 0 ≤ tailSquareFunction
  frequencyLeakage_nonneg : 0 ≤ frequencyLeakage
  eventTentGeometry :
    LerayHeatFreshFrequencyEventTentGeometry
      seq K hRho hCarrier hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  pressureDuhamelSameCarrier :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  tailWindowFamily : Prop
  boundedOverlap : Prop
  frequencyLocalizedMeanFreeTail : Prop
  tail_eq_square_function :
    X_tail = tailSquareFunction
  localQuadraticTentExcess_defined_by_cknIntegral : Prop
  frequencyLocalizedTentPoincare :
    tailSquareFunction ≤ C_Q * localQuadraticTentExcess + frequencyLeakage
  leakage_accounted_by_nonQ_terms :
    frequencyLeakage ≤
      C_P * pressureTailTerm +
        C_T * transportVisibility +
        C_C * commutatorVisibility +
        tentBoundaryError
  tailSquareFunctionIsFreshFrequencySquareBudget : Prop
  localQuadraticTentExcessIsCKNBadWindowExcess : Prop
  frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary : Prop
  meanFreeGalileanNormalizationBeforePoincare : Prop
  no_pressure_or_visibility_margin_input : Prop
  adapterDoesNotUseStrictSubratio : Prop

/-- The quantitative fresh-frequency object produces the route-1 Poincare split. -/
def FreshFrequencyToRoute1PoincareQuantitative.toPoincareDecomposition
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyToRoute1PoincareQuantitative
        seq K hRho hCarrier hBeta hEvents L) :
    Route1LocalizedCoercivityPoincareDecomposition where
  X_tail := h.X_tail
  localQuadraticTentExcess := h.localQuadraticTentExcess
  pressureTailTerm := h.pressureTailTerm
  transportVisibility := h.transportVisibility
  commutatorVisibility := h.commutatorVisibility
  tentBoundaryError := h.tentBoundaryError
  tailSquareFunction := h.tailSquareFunction
  frequencyLeakage := h.frequencyLeakage
  C_Q := h.C_Q
  C_P := h.C_P
  C_T := h.C_T
  C_C := h.C_C
  tailSquareFunction_nonneg := h.tailSquareFunction_nonneg
  frequencyLeakage_nonneg := h.frequencyLeakage_nonneg
  tailWindowFamily := h.tailWindowFamily
  boundedOverlap := h.boundedOverlap
  frequencyLocalizedMeanFreeTail := h.frequencyLocalizedMeanFreeTail
  tail_eq_square_function := h.tail_eq_square_function
  localQuadraticTentExcess_defined_by_cknIntegral :=
    h.localQuadraticTentExcess_defined_by_cknIntegral
  frequencyLocalizedTentPoincare := h.frequencyLocalizedTentPoincare
  leakage_accounted_by_nonQ_terms := h.leakage_accounted_by_nonQ_terms
  no_pressure_or_visibility_margin_input :=
    h.no_pressure_or_visibility_margin_input

/-- Assemble the lower quantitative object from the three named proof shards. -/
def FreshFrequencyToRoute1PoincareQuantitative.ofShardBundle
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyQuantitativeShardBundle
        seq K hRho hCarrier hBeta hEvents L) :
    FreshFrequencyToRoute1PoincareQuantitative
      seq K hRho hCarrier hBeta hEvents L where
  X_tail := h.tail.X_tail
  localQuadraticTentExcess := h.tent.localQuadraticTentExcess
  pressureTailTerm := h.leakage.pressureTailTerm
  transportVisibility := h.leakage.transportVisibility
  commutatorVisibility := h.leakage.commutatorVisibility
  tentBoundaryError := h.leakage.tentBoundaryError
  tailSquareFunction := h.tail.tailSquareFunction
  frequencyLeakage := h.tent.frequencyLeakage
  C_Q := h.tent.C_Q
  C_P := h.leakage.C_P
  C_T := h.leakage.C_T
  C_C := h.leakage.C_C
  tailSquareFunction_nonneg := h.tail.tailSquareFunction_nonneg
  frequencyLeakage_nonneg := h.tent.frequencyLeakage_nonneg
  eventTentGeometry := h.tail.eventTentGeometry
  squareBudgetPaysRadiusBeta := h.tail.squareBudgetPaysRadiusBeta
  pressureDuhamelSameCarrier := h.leakage.pressureDuhamelSameCarrier
  boundedFanoutNoLogReuse := h.leakage.boundedFanoutNoLogReuse
  tailWindowFamily := h.tail.tailWindowFamily
  boundedOverlap := h.tent.boundedOverlap
  frequencyLocalizedMeanFreeTail := h.tent.frequencyLocalizedMeanFreeTail
  tail_eq_square_function := h.tail.tail_eq_square_function
  localQuadraticTentExcess_defined_by_cknIntegral :=
    h.tent.localQuadraticTentExcess_defined_by_cknIntegral
  frequencyLocalizedTentPoincare := by
    rw [← h.tent_tailSquareFunction]
    exact h.tent.frequencyLocalizedTentPoincare
  leakage_accounted_by_nonQ_terms := by
    rw [← h.leakage_frequencyLeakage]
    exact h.leakage.leakage_accounted_by_nonQ_terms
  tailSquareFunctionIsFreshFrequencySquareBudget :=
    h.tail.tailSquareFunctionIsFreshFrequencySquareBudget
  localQuadraticTentExcessIsCKNBadWindowExcess :=
    h.tent.localQuadraticTentExcessIsCKNBadWindowExcess
  frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary :=
    h.leakage.frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary
  meanFreeGalileanNormalizationBeforePoincare :=
    h.tent.meanFreeGalileanNormalizationBeforePoincare
  no_pressure_or_visibility_margin_input :=
    h.leakage.no_pressure_or_visibility_margin_input
  adapterDoesNotUseStrictSubratio :=
    And h.adapterDoesNotUseStrictSubratio
      h.tail.no_strictness_used_for_tail_identification

/-- Assemble the quantitative object directly from the fully lowered A/B/C bundle. -/
def FreshFrequencyToRoute1PoincareQuantitative.ofLowerShardBundle
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyLowerShardBundle
        seq K hRho hCarrier hBeta hEvents L) :
    FreshFrequencyToRoute1PoincareQuantitative
      seq K hRho hCarrier hBeta hEvents L :=
  FreshFrequencyToRoute1PoincareQuantitative.ofShardBundle h.toShardBundle

/--
Fresh-frequency data sufficient to feed the route-1 localized coercivity
decomposition interface.

The lower object remains `Route1LocalizedCoercivityPoincareDecomposition`.
The L3 fields record where its two analytic clauses are expected to come from:
event-tent geometry for the same localized carrier, square-budget payment for
the tent square function, pressure/Duhamel same-carrier booking, and bounded
fanout to prevent logarithmic reuse of packets.
-/
structure Adapter
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  poincare : Route1LocalizedCoercivityPoincareDecomposition
  eventTentGeometry :
    LerayHeatFreshFrequencyEventTentGeometry
      seq K hRho hCarrier hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  pressureDuhamelSameCarrier :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  tailSquareFunctionIsFreshFrequencySquareBudget : Prop
  localQuadraticTentExcessIsCKNBadWindowExcess : Prop
  frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary : Prop
  meanFreeGalileanNormalizationBeforePoincare : Prop
  adapterDoesNotUseStrictSubratio : Prop

/-- Build the route-1 adapter from the lower quantitative fresh-frequency object. -/
def Adapter.ofQuantitative
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyToRoute1PoincareQuantitative
        seq K hRho hCarrier hBeta hEvents L) :
    Adapter seq K hRho hCarrier hBeta hEvents L where
  poincare := h.toPoincareDecomposition
  eventTentGeometry := h.eventTentGeometry
  squareBudgetPaysRadiusBeta := h.squareBudgetPaysRadiusBeta
  pressureDuhamelSameCarrier := h.pressureDuhamelSameCarrier
  boundedFanoutNoLogReuse := h.boundedFanoutNoLogReuse
  tailSquareFunctionIsFreshFrequencySquareBudget :=
    h.tailSquareFunctionIsFreshFrequencySquareBudget
  localQuadraticTentExcessIsCKNBadWindowExcess :=
    h.localQuadraticTentExcessIsCKNBadWindowExcess
  frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary :=
    h.frequencyLeakageSplitMatchesPressureTransportCommutatorBoundary
  meanFreeGalileanNormalizationBeforePoincare :=
    h.meanFreeGalileanNormalizationBeforePoincare
  adapterDoesNotUseStrictSubratio := h.adapterDoesNotUseStrictSubratio

/-- Forget the L3 provenance and expose the route-1 coercivity decomposition. -/
def Adapter.toPoincareDecomposition
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h : Adapter seq K hRho hCarrier hBeta hEvents L) :
    Route1LocalizedCoercivityPoincareDecomposition :=
  h.poincare

/--
The adapter gives exactly the localized coercivity estimate already proved from
the Poincare/leakage decomposition.
-/
theorem route1_localized_coercivity_of_fresh_frequency_adapter
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h : Adapter seq K hRho hCarrier hBeta hEvents L) :
    h.poincare.X_tail ≤
      h.poincare.C_Q * h.poincare.localQuadraticTentExcess +
        h.poincare.C_P * h.poincare.pressureTailTerm +
        h.poincare.C_T * h.poincare.transportVisibility +
        h.poincare.C_C * h.poincare.commutatorVisibility +
        h.poincare.tentBoundaryError :=
  route1_localized_coercivity_of_poincare_decomposition h.poincare

/--
Fresh-frequency adapter plus fork-absorption data, packaged exactly at the
surface needed to produce the route-1 local-quadratic tent-excess certificate.

This is the next proof frontier after the adapter: instantiate the Poincare
decomposition from event tents, then prove the pressure/transport/commutator/
boundary terms are small enough on the selected pressure-small `Q` fork.
-/
structure AdapterToTentExcessCertificateInput
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (adapter : Adapter seq K hRho hCarrier hBeta hEvents L) where
  obligation : Route1PressureReserveNoEscapeObligation
  pressureSmall : Route1PressureTailSmall
  etaQ : Real
  thetaFork : Real
  etaQ_pos : 0 < etaQ
  X_tail_nonneg : 0 ≤ adapter.poincare.X_tail
  C_Q_pos : 0 < adapter.poincare.C_Q
  C_P_nonneg : 0 ≤ adapter.poincare.C_P
  C_T_nonneg : 0 ≤ adapter.poincare.C_T
  C_C_nonneg : 0 ≤ adapter.poincare.C_C
  thetaFork_nonneg : 0 ≤ thetaFork
  pressureSmall_obligation :
    pressureSmall.obligation = obligation
  pressureSmall_tail :
    pressureSmall.X_tail = adapter.poincare.X_tail
  pressureTailSmall_quantitative :
    adapter.poincare.pressureTailTerm ≤
      obligation.decomposition.unresolvedPressureTail
  transportForkSmall :
    adapter.poincare.C_T * adapter.poincare.transportVisibility ≤
      thetaFork * adapter.poincare.X_tail
  commutatorForkSmall :
    adapter.poincare.C_C * adapter.poincare.commutatorVisibility ≤
      thetaFork * adapter.poincare.X_tail
  tentBoundaryErrorsSmall :
    adapter.poincare.tentBoundaryError ≤ thetaFork * adapter.poincare.X_tail
  pressureSmall_absorbs_pressureTerm :
    adapter.poincare.C_P *
        obligation.decomposition.unresolvedPressureTail ≤
      thetaFork * adapter.poincare.X_tail
  thetaFork_absorbable :
    (4 : Real) * thetaFork ≤ 1 / 2
  etaQ_from_coercivity_constants :
    etaQ ≤ 1 / (2 * adapter.poincare.C_Q)
  ckn_bad_window_contrapositive : Prop
  etaQ_uniform_from_ckn_constants : Prop
  etaQ_not_chosen_from_receipt : Prop
  no_strictSubratio_or_margin_input : Prop

/--
Turn fresh-frequency provenance and fork-absorption data into the coercivity
certificate consumed by the pressure-small `Q` route.
-/
def AdapterToTentExcessCertificateInput.toCoercivityCertificate
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {adapter : Adapter seq K hRho hCarrier hBeta hEvents L}
    (h : AdapterToTentExcessCertificateInput adapter) :
    Route1LocalQuadraticTentExcessCoercivityCertificate where
  obligation := h.obligation
  pressureSmall := h.pressureSmall
  etaQ := h.etaQ
  X_tail := adapter.poincare.X_tail
  localQuadraticTentExcess := adapter.poincare.localQuadraticTentExcess
  pressureTailTerm := adapter.poincare.pressureTailTerm
  transportVisibility := adapter.poincare.transportVisibility
  commutatorVisibility := adapter.poincare.commutatorVisibility
  tentBoundaryError := adapter.poincare.tentBoundaryError
  C_Q := adapter.poincare.C_Q
  C_P := adapter.poincare.C_P
  C_T := adapter.poincare.C_T
  C_C := adapter.poincare.C_C
  thetaFork := h.thetaFork
  etaQ_pos := h.etaQ_pos
  X_tail_nonneg := h.X_tail_nonneg
  C_Q_pos := h.C_Q_pos
  C_P_nonneg := h.C_P_nonneg
  C_T_nonneg := h.C_T_nonneg
  C_C_nonneg := h.C_C_nonneg
  thetaFork_nonneg := h.thetaFork_nonneg
  pressureSmall_obligation := h.pressureSmall_obligation
  pressureSmall_tail := h.pressureSmall_tail
  tailWindowFamily := adapter.poincare.tailWindowFamily
  boundedOverlap := adapter.poincare.boundedOverlap
  frequencyLocalizedMeanFreeTail :=
    adapter.poincare.frequencyLocalizedMeanFreeTail
  X_tail_identifies_tent_square_function :=
    adapter.tailSquareFunctionIsFreshFrequencySquareBudget
  localQuadraticTentExcess_defined_by_cknIntegral :=
    And
      adapter.poincare.localQuadraticTentExcess_defined_by_cknIntegral
      adapter.localQuadraticTentExcessIsCKNBadWindowExcess
  pressureTailSmall_quantitative := h.pressureTailSmall_quantitative
  transportForkSmall := h.transportForkSmall
  commutatorForkSmall := h.commutatorForkSmall
  tentBoundaryErrorsSmall := h.tentBoundaryErrorsSmall
  localizedCoercivity :=
    route1_localized_coercivity_of_fresh_frequency_adapter adapter
  pressureSmall_absorbs_pressureTerm := h.pressureSmall_absorbs_pressureTerm
  thetaFork_absorbable := h.thetaFork_absorbable
  etaQ_from_coercivity_constants := h.etaQ_from_coercivity_constants
  ckn_bad_window_contrapositive := h.ckn_bad_window_contrapositive
  etaQ_uniform_from_ckn_constants := h.etaQ_uniform_from_ckn_constants
  etaQ_not_chosen_from_receipt := h.etaQ_not_chosen_from_receipt
  no_strictSubratio_or_margin_input :=
    And h.no_strictSubratio_or_margin_input
      adapter.adapterDoesNotUseStrictSubratio

/--
Final adapter into the route-1 local-quadratic tent-excess certificate, once
the pressure-visibility receipt is identified with the same tent excess.
-/
def AdapterToTentExcessCertificateInput.toTentExcessCertificate
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {adapter : Adapter seq K hRho hCarrier hBeta hEvents L}
    (h : AdapterToTentExcessCertificateInput adapter)
    (hreceipt :
      (route1PressureVisibilityReceipts h.obligation).localQuadraticReceipt =
        adapter.poincare.localQuadraticTentExcess) :
    Route1LocalQuadraticTentExcessCertificate :=
  Route1LocalQuadraticTentExcessCertificate.ofCoercivityCertificate
    h.toCoercivityCertificate hreceipt

/--
End-to-end pressure-small route input generated from the fresh-frequency
coercivity adapter.  The structure keeps the final route accounting separate
from the analytic adapter fields, so a proof cannot use the target strict
subratio while building the local-quadratic receipt.
-/
structure AdapterToRoute1ReducedInput
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (adapter : Adapter seq K hRho hCarrier hBeta hEvents L) where
  certificateInput :
    AdapterToTentExcessCertificateInput adapter
  accounting : Route1ChannelAccountingBase
  cert_tail :
    adapter.poincare.X_tail = accounting.X_tail
  tail_scale_pos : 0 < accounting.X_tail
  etaQ_pays_third :
    accounting.nu / 3 ≤ certificateInput.etaQ
  pressureReceipt_eq_tentExcess :
    (route1PressureVisibilityReceipts
        certificateInput.obligation).localQuadraticReceipt =
      adapter.poincare.localQuadraticTentExcess
  pressureLocalQuadraticFeedsQuadratic :
    (route1PressureVisibilityReceipts
        certificateInput.obligation).localQuadraticReceipt ≤
      accounting.V_Q
  quadraticChannel_no_extra_oracle :
    accounting.V_Q ≤
      (route1PressureVisibilityReceipts
        certificateInput.obligation).localQuadraticReceipt

/--
Convert the fresh-frequency adapter route into the canonical reduced
pressure-small input consumed by `ns_route1_constructive_frontier`.
-/
def AdapterToRoute1ReducedInput.toReducedInput
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {adapter : Adapter seq K hRho hCarrier hBeta hEvents L}
    (h : AdapterToRoute1ReducedInput adapter) :
    Route1PressureSmallQuadraticReducedInput where
  accounting := h.accounting
  pressureVisibility := h.certificateInput.obligation
  tentExcessCertificate :=
    h.certificateInput.toTentExcessCertificate
      h.pressureReceipt_eq_tentExcess
  cert_obligation := rfl
  cert_tail := h.cert_tail
  tail_scale_pos := h.tail_scale_pos
  etaQ_pays_third := h.etaQ_pays_third
  pressureLocalQuadraticFeedsQuadratic :=
    h.pressureLocalQuadraticFeedsQuadratic
  quadraticChannel_no_extra_oracle :=
    h.quadraticChannel_no_extra_oracle

/--
End-to-end strict route1 source subratio from fresh-frequency/localized
coercivity inputs plus route accounting.  This is a corollary: all PDE content
is still in the adapter input and fork-absorption fields.
-/
theorem exists_strict_source_subratio_of_fresh_frequency_adapter
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {adapter : Adapter seq K hRho hCarrier hBeta hEvents L}
    (h : AdapterToRoute1ReducedInput adapter)
    (h_eps :
      h.accounting.epsTail ≤
        (1 / 2 : Real) *
          min h.accounting.deltaRes
            (h.accounting.kappa * (h.accounting.nu / 3))) :
    ∃ rho' : Real,
      rho' < h.accounting.rho ∧ h.accounting.S ≤ rho' * h.accounting.X :=
  exists_strict_source_subratio_of_pressure_small_tent_excess_input
    h.toReducedInput h_eps

/--
Fixed-window source for the leakage-normalizer comparison exposed by the
shard-C scout.

This is deliberately below shard-C charge payment.  It only compares the
pressure/Riesz weighted frequency-leakage stress to the fresh-frequency leakage
scalar under a fixed normalizer; the four channel charges are separate.
-/
structure FixedWindowLeakageNormalizerCompatibilitySource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  leakageBookkeeping :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L
  frequencyLeakageWeightedStress : Real
  frequencyLeakageStressNormalizer : Real
  normalizedFreshFrequencyLeakage : Real
  frequencyLeakageStressNormalizer_nonneg :
    0 ≤ frequencyLeakageStressNormalizer
  normalizedFreshFrequencyLeakage_eq :
    normalizedFreshFrequencyLeakage =
      frequencyLeakageStressNormalizer * leakageBookkeeping.frequencyLeakage
  weightedStress_le_normalizedFreshFrequencyLeakage :
    frequencyLeakageWeightedStress ≤ normalizedFreshFrequencyLeakage
  sameFreshFrequencyCarrierAsShardC : Prop
  sameFixedWindowAsPressureConeStress : Prop
  sameTentCutoffAsLeakageBookkeeping : Prop
  weightedStressIsUnresolvedFrequencyRemainder : Prop
  normalizerFixedBeforeFinalCarrier : Prop
  normalizerNotDefinedFromPressureRieszConeCharge : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
The normalizer source plus a shard-C charge budget pays the leakage share.
This is only scalar bookkeeping; the PDE content is the normalizer comparison
and the four existing shard-C receipt estimates.
-/
theorem frequencyLeakageWeightedStress_le_shardCCharges_of_normalizerCompatibility
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FixedWindowLeakageNormalizerCompatibilitySource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hCharges :
      h.normalizedFreshFrequencyLeakage ≤
        h.leakageBookkeeping.pressureLeakageCharge +
          h.leakageBookkeeping.transportLeakageCharge +
            h.leakageBookkeeping.commutatorLeakageCharge +
              h.leakageBookkeeping.boundaryLeakageCharge) :
    h.frequencyLeakageWeightedStress ≤
      h.leakageBookkeeping.pressureLeakageCharge +
        h.leakageBookkeeping.transportLeakageCharge +
          h.leakageBookkeeping.commutatorLeakageCharge +
            h.leakageBookkeeping.boundaryLeakageCharge :=
  le_trans h.weightedStress_le_normalizedFreshFrequencyLeakage hCharges

/--
Source for paying normalized fresh-frequency leakage by the four shard-C
channels.  This sits between the normalizer compatibility source and the
existing shard-C charge ledger: the normalized leakage is split into pressure,
transport, commutator, and boundary parts before those parts are compared to
the existing charges.
-/
structure FixedWindowNormalizedLeakageShardCChannelSplitSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  leakageBookkeeping :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L
  normalizedFreshFrequencyLeakage : Real
  normalizedPressureLeakagePart : Real
  normalizedTransportLeakagePart : Real
  normalizedCommutatorLeakagePart : Real
  normalizedBoundaryLeakagePart : Real
  normalizedLeakage_split_before_charge_bounds :
    normalizedFreshFrequencyLeakage ≤
      normalizedPressureLeakagePart +
        normalizedTransportLeakagePart +
          normalizedCommutatorLeakagePart +
            normalizedBoundaryLeakagePart
  normalizedPressurePart_le_pressureLeakageCharge :
    normalizedPressureLeakagePart ≤ leakageBookkeeping.pressureLeakageCharge
  normalizedTransportPart_le_transportLeakageCharge :
    normalizedTransportLeakagePart ≤ leakageBookkeeping.transportLeakageCharge
  normalizedCommutatorPart_le_commutatorLeakageCharge :
    normalizedCommutatorLeakagePart ≤ leakageBookkeeping.commutatorLeakageCharge
  normalizedBoundaryPart_le_boundaryLeakageCharge :
    normalizedBoundaryLeakagePart ≤ leakageBookkeeping.boundaryLeakageCharge
  splitUsesSameFreshFrequencyCarrier : Prop
  pressurePartUsesSameDuhamelCarrier : Prop
  transportPartUsesLocalizedRouteFlux : Prop
  commutatorPartUsesEndpointDefectMeasure : Prop
  boundaryPartUsesTentTruncationError : Prop
  channelPartsFixedBeforeFinalCarrier : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Receipt-level source for the transport and boundary legs of the normalized
shard-C channel split.

The point is directional hygiene.  `FreshFrequencyTransportLeakageReceipt` and
`FreshFrequencyTentBoundaryTruncationReceipt` give visibility-side upper
bounds for charges; they do not by themselves prove that normalized leakage
parts are paid by those charges.  This source records the missing lower
comparisons explicitly and ties them to the same receipt objects used by the
bookkeeping constructor.
-/
structure FixedWindowTransportBoundaryReceiptChannelSplitSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  leakageBookkeeping :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L
  transportReceipt : FreshFrequencyTransportLeakageReceipt
  boundaryReceipt : FreshFrequencyTentBoundaryTruncationReceipt
  normalizedFreshFrequencyLeakage : Real
  normalizedPressureLeakagePart : Real
  normalizedTransportLeakagePart : Real
  normalizedCommutatorLeakagePart : Real
  normalizedBoundaryLeakagePart : Real
  normalizedLeakage_split_before_charge_bounds :
    normalizedFreshFrequencyLeakage ≤
      normalizedPressureLeakagePart +
        normalizedTransportLeakagePart +
          normalizedCommutatorLeakagePart +
            normalizedBoundaryLeakagePart
  normalizedPressurePart_le_pressureLeakageCharge :
    normalizedPressureLeakagePart ≤ leakageBookkeeping.pressureLeakageCharge
  normalizedCommutatorPart_le_commutatorLeakageCharge :
    normalizedCommutatorLeakagePart ≤ leakageBookkeeping.commutatorLeakageCharge
  transportReceiptMatchesBookkeeping :
    transportReceipt.transportLeakageCharge =
      leakageBookkeeping.transportLeakageCharge
  boundaryReceiptMatchesBookkeeping :
    boundaryReceipt.boundaryLeakageCharge =
      leakageBookkeeping.boundaryLeakageCharge
  normalizedTransportPart_le_transportReceiptCharge :
    normalizedTransportLeakagePart ≤ transportReceipt.transportLeakageCharge
  normalizedBoundaryPart_le_boundaryReceiptCharge :
    normalizedBoundaryLeakagePart ≤ boundaryReceipt.boundaryLeakageCharge
  splitUsesSameFreshFrequencyCarrier : Prop
  pressurePartUsesSameDuhamelCarrier : Prop
  commutatorPartUsesEndpointDefectMeasure : Prop
  transportReceiptUsesLocalizedRouteFlux : Prop
  boundaryReceiptUsesTentTruncationError : Prop
  receiptChargesFixedBeforeFinalCarrier : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Transport/boundary receipt source instantiates the normalized shard-C channel
split.  The proof uses only the receipt charge identities and the explicit
part-to-receipt inequalities above.
-/
def FixedWindowNormalizedLeakageShardCChannelSplitSource.ofTransportBoundaryReceiptSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FixedWindowTransportBoundaryReceiptChannelSplitSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) :
    FixedWindowNormalizedLeakageShardCChannelSplitSource
      (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
      (hBeta := hBeta) (hEvents := hEvents) (L := L) where
  leakageBookkeeping := h.leakageBookkeeping
  normalizedFreshFrequencyLeakage := h.normalizedFreshFrequencyLeakage
  normalizedPressureLeakagePart := h.normalizedPressureLeakagePart
  normalizedTransportLeakagePart := h.normalizedTransportLeakagePart
  normalizedCommutatorLeakagePart := h.normalizedCommutatorLeakagePart
  normalizedBoundaryLeakagePart := h.normalizedBoundaryLeakagePart
  normalizedLeakage_split_before_charge_bounds :=
    h.normalizedLeakage_split_before_charge_bounds
  normalizedPressurePart_le_pressureLeakageCharge :=
    h.normalizedPressurePart_le_pressureLeakageCharge
  normalizedTransportPart_le_transportLeakageCharge := by
    simpa [h.transportReceiptMatchesBookkeeping] using
      h.normalizedTransportPart_le_transportReceiptCharge
  normalizedCommutatorPart_le_commutatorLeakageCharge :=
    h.normalizedCommutatorPart_le_commutatorLeakageCharge
  normalizedBoundaryPart_le_boundaryLeakageCharge := by
    simpa [h.boundaryReceiptMatchesBookkeeping] using
      h.normalizedBoundaryPart_le_boundaryReceiptCharge
  splitUsesSameFreshFrequencyCarrier := h.splitUsesSameFreshFrequencyCarrier
  pressurePartUsesSameDuhamelCarrier := h.pressurePartUsesSameDuhamelCarrier
  transportPartUsesLocalizedRouteFlux :=
    And h.transportReceiptUsesLocalizedRouteFlux
      h.transportReceipt.routeFluxVisibilityProducer
  commutatorPartUsesEndpointDefectMeasure :=
    h.commutatorPartUsesEndpointDefectMeasure
  boundaryPartUsesTentTruncationError :=
    And h.boundaryReceiptUsesTentTruncationError
      h.boundaryReceipt.boundaryChargeIsTentTruncationError
  channelPartsFixedBeforeFinalCarrier :=
    h.receiptChargesFixedBeforeFinalCarrier
  noFinalCarrierMagnitudeInput := h.noFinalCarrierMagnitudeInput
  noOverflowExcessReceiptSizing := h.noOverflowExcessReceiptSizing

/-- Normalized channel split pays the shard-C charge budget. -/
theorem normalizedFreshFrequencyLeakage_le_shardCCharges_of_channelSplit
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FixedWindowNormalizedLeakageShardCChannelSplitSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) :
    h.normalizedFreshFrequencyLeakage ≤
      h.leakageBookkeeping.pressureLeakageCharge +
        h.leakageBookkeeping.transportLeakageCharge +
          h.leakageBookkeeping.commutatorLeakageCharge +
            h.leakageBookkeeping.boundaryLeakageCharge := by
  nlinarith [h.normalizedLeakage_split_before_charge_bounds,
    h.normalizedPressurePart_le_pressureLeakageCharge,
    h.normalizedTransportPart_le_transportLeakageCharge,
    h.normalizedCommutatorPart_le_commutatorLeakageCharge,
    h.normalizedBoundaryPart_le_boundaryLeakageCharge]

/--
Normalizer compatibility plus normalized channel split pays the weighted
frequency-leakage stress by shard-C charges.
-/
theorem frequencyLeakageWeightedStress_le_shardCCharges_of_normalizerAndChannelSplit
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hNorm :
      FixedWindowLeakageNormalizerCompatibilitySource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hSplit :
      FixedWindowNormalizedLeakageShardCChannelSplitSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hleakage :
      hSplit.leakageBookkeeping = hNorm.leakageBookkeeping)
    (hnormalized :
      hSplit.normalizedFreshFrequencyLeakage =
        hNorm.normalizedFreshFrequencyLeakage) :
    hNorm.frequencyLeakageWeightedStress ≤
      hNorm.leakageBookkeeping.pressureLeakageCharge +
        hNorm.leakageBookkeeping.transportLeakageCharge +
          hNorm.leakageBookkeeping.commutatorLeakageCharge +
            hNorm.leakageBookkeeping.boundaryLeakageCharge := by
  have hChargesSplit :
      hSplit.normalizedFreshFrequencyLeakage ≤
        hSplit.leakageBookkeeping.pressureLeakageCharge +
          hSplit.leakageBookkeeping.transportLeakageCharge +
            hSplit.leakageBookkeeping.commutatorLeakageCharge +
              hSplit.leakageBookkeeping.boundaryLeakageCharge :=
    normalizedFreshFrequencyLeakage_le_shardCCharges_of_channelSplit hSplit
  have hCharges :
      hNorm.normalizedFreshFrequencyLeakage ≤
        hNorm.leakageBookkeeping.pressureLeakageCharge +
          hNorm.leakageBookkeeping.transportLeakageCharge +
            hNorm.leakageBookkeeping.commutatorLeakageCharge +
              hNorm.leakageBookkeeping.boundaryLeakageCharge := by
    rw [← hnormalized, ← hleakage]
    exact hChargesSplit
  exact
    frequencyLeakageWeightedStress_le_shardCCharges_of_normalizerCompatibility
      hNorm hCharges

/--
Guard from the leakage-channel scout: even after normalizer compatibility, a
strictly underfunded shard-C charge sum cannot pay normalized leakage.
-/
structure FixedWindowShardCChannelUnderchargeGap where
  normalizedFreshFrequencyLeakage : Real
  shardCChargeSum : Real
  transportOrBoundaryUndercharged : Prop
  channelPartsFixedBeforeFinalCarrier : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop
  shardCChargeSum_lt_normalizedFreshFrequencyLeakage :
    shardCChargeSum < normalizedFreshFrequencyLeakage

/-- A strict shard-C undercharge gap forbids the normalized charge payment. -/
theorem no_normalizedLeakageShardCPayment_of_underchargeGap
    (h : FixedWindowShardCChannelUnderchargeGap) :
    ¬ h.normalizedFreshFrequencyLeakage ≤ h.shardCChargeSum := by
  intro hle
  exact not_lt_of_ge hle
    h.shardCChargeSum_lt_normalizedFreshFrequencyLeakage

/--
Guard for the direction error in transport/boundary payment: upper bounds on
receipt charges by visibility/error do not prove that normalized leakage parts
are below those charges.  A strict transport+boundary undercharge blocks that
payment regardless of the upper visibility estimates.
-/
structure FixedWindowTransportBoundaryReceiptUpperBoundOnlyGap where
  normalizedTransportLeakagePart : Real
  normalizedBoundaryLeakagePart : Real
  transportLeakageCharge : Real
  boundaryLeakageCharge : Real
  transportVisibility : Real
  tentBoundaryError : Real
  C_T : Real
  transportCharge_bound :
    transportLeakageCharge ≤ C_T * transportVisibility
  boundaryCharge_bound :
    boundaryLeakageCharge ≤ tentBoundaryError
  receiptUpperBoundsOnly : Prop
  sameTransportReceiptObject : Prop
  sameBoundaryReceiptObject : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop
  transportBoundaryCharges_lt_normalizedParts :
    transportLeakageCharge + boundaryLeakageCharge <
      normalizedTransportLeakagePart + normalizedBoundaryLeakagePart

/-- Strict transport/boundary undercharge forbids normalized payment by those receipts. -/
theorem no_transportBoundaryPayment_of_receiptUpperBoundOnlyGap
    (h : FixedWindowTransportBoundaryReceiptUpperBoundOnlyGap) :
    ¬ h.normalizedTransportLeakagePart + h.normalizedBoundaryLeakagePart ≤
      h.transportLeakageCharge + h.boundaryLeakageCharge := by
  intro hle
  exact not_lt_of_ge hle
    h.transportBoundaryCharges_lt_normalizedParts

/--
The same strict undercharge also forbids the two channel payment inequalities
simultaneously.  This is the exact failure shape required by the normalized
channel-split source.
-/
theorem no_transportBoundaryChannelPairPayment_of_receiptUpperBoundOnlyGap
    (h : FixedWindowTransportBoundaryReceiptUpperBoundOnlyGap) :
    ¬ (h.normalizedTransportLeakagePart ≤ h.transportLeakageCharge ∧
      h.normalizedBoundaryLeakagePart ≤ h.boundaryLeakageCharge) := by
  intro hpair
  nlinarith [hpair.1, hpair.2,
    h.transportBoundaryCharges_lt_normalizedParts]

/--
Boundary-specific lower-payment source for the normalized shard-C split.

The tent-boundary receipt controls its charge from above by the truncation
error.  This source records the separate lower comparison needed to pay a
normalized boundary leakage part by that same charge.
-/
structure FixedWindowBoundaryTentTruncationLowerPaymentSource where
  boundaryReceipt : FreshFrequencyTentBoundaryTruncationReceipt
  normalizedBoundaryLeakagePart : Real
  normalizedBoundaryPart_le_boundaryReceiptCharge :
    normalizedBoundaryLeakagePart ≤ boundaryReceipt.boundaryLeakageCharge
  boundaryWindowUsesSameTentFamily : Prop
  boundaryCutoffMatchesLeakageBookkeeping : Prop
  boundaryReceiptFixedBeforeFinalCarrier : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/--
Provenance-specific source for boundary lower payment.

The same tent family and cutoff are not treated as a scalar estimate by
themselves; the lower payment inequality is still an explicit field.  The value
is that any future use of the boundary source must name the provenance under
which the payment was proved.
-/
structure FixedWindowBoundaryTentProvenanceLowerPaymentSource where
  boundaryReceipt : FreshFrequencyTentBoundaryTruncationReceipt
  normalizedBoundaryLeakagePart : Real
  normalizedBoundaryPart_le_boundaryReceiptCharge :
    normalizedBoundaryLeakagePart ≤ boundaryReceipt.boundaryLeakageCharge
  sameTentFamilyAsBoundaryLeakage : Prop
  sameCutoffAsLeakageBookkeeping : Prop
  boundaryWindowUsesSameTentFamily : Prop
  boundaryCutoffMatchesLeakageBookkeeping : Prop
  boundaryReceiptFixedBeforeFinalCarrier : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop

/-- Provenance-specific boundary payment instantiates the generic boundary source. -/
def FixedWindowBoundaryTentTruncationLowerPaymentSource.ofProvenanceSource
    (h : FixedWindowBoundaryTentProvenanceLowerPaymentSource) :
    FixedWindowBoundaryTentTruncationLowerPaymentSource where
  boundaryReceipt := h.boundaryReceipt
  normalizedBoundaryLeakagePart := h.normalizedBoundaryLeakagePart
  normalizedBoundaryPart_le_boundaryReceiptCharge :=
    h.normalizedBoundaryPart_le_boundaryReceiptCharge
  boundaryWindowUsesSameTentFamily :=
    And h.sameTentFamilyAsBoundaryLeakage
      h.boundaryWindowUsesSameTentFamily
  boundaryCutoffMatchesLeakageBookkeeping :=
    And h.sameCutoffAsLeakageBookkeeping
      h.boundaryCutoffMatchesLeakageBookkeeping
  boundaryReceiptFixedBeforeFinalCarrier :=
    h.boundaryReceiptFixedBeforeFinalCarrier
  noFinalCarrierMagnitudeInput := h.noFinalCarrierMagnitudeInput
  noOverflowExcessReceiptSizing := h.noOverflowExcessReceiptSizing

/-- Boundary lower-payment source pays the boundary receipt charge. -/
theorem normalizedBoundaryPart_le_boundaryReceiptCharge_of_tentTruncationLowerPayment
    (h : FixedWindowBoundaryTentTruncationLowerPaymentSource) :
    h.normalizedBoundaryLeakagePart ≤
      h.boundaryReceipt.boundaryLeakageCharge :=
  h.normalizedBoundaryPart_le_boundaryReceiptCharge

/-- Boundary lower-payment source pays the matching shard-C bookkeeping charge. -/
theorem normalizedBoundaryPart_le_bookkeepingBoundaryCharge_of_tentTruncationLowerPayment
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h : FixedWindowBoundaryTentTruncationLowerPaymentSource)
    (bookkeeping :
      FreshFrequencyLeakageChargeBookkeeping
        seq K hRho hCarrier hBeta hEvents L)
    (hmatch :
      h.boundaryReceipt.boundaryLeakageCharge =
        bookkeeping.boundaryLeakageCharge) :
    h.normalizedBoundaryLeakagePart ≤ bookkeeping.boundaryLeakageCharge := by
  simpa [hmatch] using
    normalizedBoundaryPart_le_boundaryReceiptCharge_of_tentTruncationLowerPayment h

/--
Boundary-only version of the undercharge guard.  The receipt inequality
`boundaryLeakageCharge ≤ tentBoundaryError` is an upper-control statement; it
does not pay a normalized boundary part when the charge is strictly smaller.
-/
structure FixedWindowBoundaryTentTruncationUnderchargeGap where
  normalizedBoundaryLeakagePart : Real
  boundaryLeakageCharge : Real
  tentBoundaryError : Real
  boundaryCharge_bound :
    boundaryLeakageCharge ≤ tentBoundaryError
  boundaryReceiptUpperBoundOnly : Prop
  sameBoundaryReceiptObject : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop
  boundaryLeakageCharge_lt_normalizedBoundaryPart :
    boundaryLeakageCharge < normalizedBoundaryLeakagePart

/-- Strict boundary undercharge forbids boundary lower payment. -/
theorem no_boundaryTentTruncationLowerPayment_of_underchargeGap
    (h : FixedWindowBoundaryTentTruncationUnderchargeGap) :
    ¬ h.normalizedBoundaryLeakagePart ≤ h.boundaryLeakageCharge := by
  intro hle
  exact not_lt_of_ge hle
    h.boundaryLeakageCharge_lt_normalizedBoundaryPart

/--
Boundary scout guard: if the tent family or cutoff is mismatched and the
boundary charge is strictly below the normalized boundary part, no matching
provenance source can instantiate the lower-payment source for those values.
-/
structure FixedWindowBoundaryTentProvenanceMismatchUnderchargeGap where
  normalizedBoundaryLeakagePart : Real
  boundaryLeakageCharge : Real
  sameTentFamilyOrCutoffMismatch : Prop
  boundaryReceiptUpperBoundOnly : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop
  boundaryLeakageCharge_lt_normalizedBoundaryPart :
    boundaryLeakageCharge < normalizedBoundaryLeakagePart

/-- Mismatch undercharge forbids a same-value provenance lower-payment source. -/
theorem no_boundaryTentProvenanceLowerPayment_of_mismatchUndercharge
    (h : FixedWindowBoundaryTentProvenanceMismatchUnderchargeGap) :
    ¬ ∃ hSrc : FixedWindowBoundaryTentProvenanceLowerPaymentSource,
      hSrc.normalizedBoundaryLeakagePart =
          h.normalizedBoundaryLeakagePart ∧
        hSrc.boundaryReceipt.boundaryLeakageCharge =
          h.boundaryLeakageCharge := by
  rintro ⟨hSrc, hNorm, hCharge⟩
  have hle :
      h.normalizedBoundaryLeakagePart ≤ h.boundaryLeakageCharge := by
    rw [← hNorm, ← hCharge]
    exact hSrc.normalizedBoundaryPart_le_boundaryReceiptCharge
  exact not_lt_of_ge hle
    h.boundaryLeakageCharge_lt_normalizedBoundaryPart

/--
Guard from the leakage-channel scout: if fixed-window normalized fresh leakage
is strictly smaller than the pressure/Riesz weighted leakage stress, the
normalizer compatibility inequality is unavailable.
-/
structure FixedWindowLeakageNormalizerMismatchGap where
  frequencyLeakageWeightedStress : Real
  normalizedFreshFrequencyLeakage : Real
  sameWindowOrCutoffMismatch : Prop
  constantsFixedBeforeRowScoring : Prop
  noFinalCarrierMagnitudeInput : Prop
  noOverflowExcessReceiptSizing : Prop
  normalizedFreshFrequencyLeakage_lt_weightedStress :
    normalizedFreshFrequencyLeakage < frequencyLeakageWeightedStress

/-- A strict normalizer gap forbids the compatibility inequality. -/
theorem no_leakageNormalizerCompatibility_of_mismatchGap
    (h : FixedWindowLeakageNormalizerMismatchGap) :
    ¬ h.frequencyLeakageWeightedStress ≤
      h.normalizedFreshFrequencyLeakage := by
  intro hle
  exact not_lt_of_ge hle
    h.normalizedFreshFrequencyLeakage_lt_weightedStress

/--
Adapter-side source for routing pre-summed pressure/Riesz cone stress when the
frequency-leakage share is paid by shard-C charges instead of by the pressure
child receipt.

The split is deliberately weaker than a pure pressure-receipt bridge:
resolved mean-free stress goes to the local quadratic receipt, Galilean mean
stress goes to pressure reserve, and only the unresolved frequency leakage is
sent through the fresh-frequency leakage bookkeeping.
-/
structure FixedWindowPreSummedStressMassShardCLeakageSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    (formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade)
    (epsilon corePositiveConeMass sheathOppositeConeMass : Real) where
  profileObligation : NS.NoInvisibleCriticalProfileCompactnessObligation
  pressureObligation : Route1PressureReserveNoEscapeObligation
  leakageBookkeeping :
    FreshFrequencyLeakageChargeBookkeeping
      seq K hRho hCarrier hBeta hEvents L
  overflow : (1 - epsilon) * corePositiveConeMass < sheathOppositeConeMass
  pressureRieszConeCharge : Real
  route1TailVisibility : Real
  overflowExcess : Real
  visibilityChargeConstant : Real
  resolvedMeanFreeWeightedStress : Real
  galileanMeanWeightedStress : Real
  frequencyLeakageWeightedStress : Real
  frequencyLeakageStressNormalizer : Real
  visibilityChargeConstant_pos : 0 < visibilityChargeConstant
  frequencyLeakageStressNormalizer_nonneg :
    0 ≤ frequencyLeakageStressNormalizer
  overflowExcess_eq :
    overflowExcess =
      sheathOppositeConeMass - (1 - epsilon) * corePositiveConeMass
  pressureRieszConeCharge_pays_overflowExcess :
    visibilityChargeConstant * overflowExcess ≤ pressureRieszConeCharge
  pressureRieszConeCharge_le_splitWeightedStress :
    pressureRieszConeCharge ≤
      resolvedMeanFreeWeightedStress +
        galileanMeanWeightedStress +
          frequencyLeakageWeightedStress
  resolvedMeanFreeWeightedStress_le_localQuadraticReceipt :
    resolvedMeanFreeWeightedStress ≤
      (route1PressureVisibilityReceipts pressureObligation).localQuadraticReceipt
  galileanMeanWeightedStress_le_pressureReserveReceipt :
    galileanMeanWeightedStress ≤
      (route1PressureVisibilityReceipts pressureObligation).pressureReserveReceipt
  frequencyLeakageWeightedStress_le_normalizedFreshFrequencyLeakage :
    frequencyLeakageWeightedStress ≤
      frequencyLeakageStressNormalizer * leakageBookkeeping.frequencyLeakage
  normalizedFreshFrequencyLeakage_le_shardCCharges :
    frequencyLeakageStressNormalizer * leakageBookkeeping.frequencyLeakage ≤
      leakageBookkeeping.pressureLeakageCharge +
        leakageBookkeeping.transportLeakageCharge +
          leakageBookkeeping.commutatorLeakageCharge +
            leakageBookkeeping.boundaryLeakageCharge
  childChargeReceipt_nonneg :
    0 ≤ (route1PressureVisibilityReceipts pressureObligation).childChargeReceipt
  receiptAndShardCCharges_le_tailVisibility :
    (route1PressureVisibilityReceipts pressureObligation).receiptSum +
        leakageBookkeeping.pressureLeakageCharge +
          leakageBookkeeping.transportLeakageCharge +
            leakageBookkeeping.commutatorLeakageCharge +
              leakageBookkeeping.boundaryLeakageCharge ≤
      route1TailVisibility
  pressureRieszConeReceipt : Prop
  pressureRieszConeReceipt_holds : pressureRieszConeReceipt
  sameFixedProjectedKernel : Prop
  sameWindowAsPressureAndShardCReceipts : Prop
  pressureRieszConeChargeMeasuresPreSummedStress : Prop
  splitFixedBeforeReceiptComparison : Prop
  resolvedMeanFreePartPaidByLocalQuadraticReceipt : Prop
  galileanMeanPartPaidByPressureReserveReceipt : Prop
  sameFreshFrequencyCarrierAsShardC : Prop
  sameFixedWindowAsPressureConeStress : Prop
  sameTentCutoffAsLeakageBookkeeping : Prop
  weightedStressIsUnresolvedFrequencyRemainder : Prop
  frequencyLeakagePartPaidByShardCBookkeeping : Prop
  leakageStressNormalizerFixedBeforeFinalCarrier : Prop
  shardCChargesFixedBeforeAbsorptionFork : Prop
  noDoubleCountingWithPressureReceiptSplit : Prop
  receiptSharesNotChosenFromFinalCarrier : Prop
  coneChargeFixedBeforeReceiptComparison : Prop
  coneChargeNotDefinedFromFinalCarrier : Prop
  no_strictSubratio_or_margin_input : Prop

/--
Shard-C leakage routing supplies the pressure/Riesz cone source by bounding the
pre-summed cone charge against pressure receipts plus fresh-frequency leakage
charges.
-/
def FixedWindowPressureRieszConeChargeSource.ofShardCLeakageSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    {epsilon corePositiveConeMass sheathOppositeConeMass : Real}
    (h :
      @FixedWindowPreSummedStressMassShardCLeakageSource
        seq K hRho hCarrier hBeta hEvents L pressureL2 radialGrade
        formula epsilon corePositiveConeMass sheathOppositeConeMass) :
    FixedWindowPressureRieszConeChargeSource formula epsilon
      corePositiveConeMass sheathOppositeConeMass where
  obligation := h.profileObligation
  overflow := h.overflow
  pressureRieszConeCharge := h.pressureRieszConeCharge
  route1TailVisibility := h.route1TailVisibility
  overflowExcess := h.overflowExcess
  visibilityChargeConstant := h.visibilityChargeConstant
  visibilityChargeConstant_pos := h.visibilityChargeConstant_pos
  overflowExcess_eq := h.overflowExcess_eq
  pressureRieszConeCharge_pays_overflowExcess :=
    h.pressureRieszConeCharge_pays_overflowExcess
  pressureRieszConeCharge_le_tailVisibility := by
    have hsplit :
        h.resolvedMeanFreeWeightedStress +
            h.galileanMeanWeightedStress +
              h.frequencyLeakageWeightedStress ≤
          (route1PressureVisibilityReceipts h.pressureObligation).receiptSum +
            h.leakageBookkeeping.pressureLeakageCharge +
              h.leakageBookkeeping.transportLeakageCharge +
                h.leakageBookkeeping.commutatorLeakageCharge +
                  h.leakageBookkeeping.boundaryLeakageCharge := by
      dsimp [Route1PressureVisibilityReceipts.receiptSum]
      nlinarith [h.resolvedMeanFreeWeightedStress_le_localQuadraticReceipt,
        h.galileanMeanWeightedStress_le_pressureReserveReceipt,
        h.frequencyLeakageWeightedStress_le_normalizedFreshFrequencyLeakage,
        h.normalizedFreshFrequencyLeakage_le_shardCCharges,
        h.childChargeReceipt_nonneg]
    exact le_trans h.pressureRieszConeCharge_le_splitWeightedStress
      (le_trans hsplit h.receiptAndShardCCharges_le_tailVisibility)
  pressureRieszConeReceipt := h.pressureRieszConeReceipt
  pressureRieszConeReceipt_holds := h.pressureRieszConeReceipt_holds
  sameFixedProjectedKernel := h.sameFixedProjectedKernel
  pressureRieszConeChargeMeasuresPreSummedStress :=
    h.pressureRieszConeChargeMeasuresPreSummedStress
  coreSheathSplitFixedBeforeCharge :=
    And h.coneChargeFixedBeforeReceiptComparison
      h.splitFixedBeforeReceiptComparison
  coneChargeNotDefinedFromFinalCarrier :=
    h.coneChargeNotDefinedFromFinalCarrier
  no_strictSubratio_or_margin_input :=
    And h.no_strictSubratio_or_margin_input
      (And h.leakageBookkeeping.no_pressure_or_visibility_margin_input
        (And h.receiptSharesNotChosenFromFinalCarrier
          (And h.leakageStressNormalizerFixedBeforeFinalCarrier
            h.noDoubleCountingWithPressureReceiptSplit)))

/-- Shard-C leakage source constructs the corrected visible-or-invisible fork. -/
def FixedWindowOverflowVisibleOrInvisibleProfile.ofShardCLeakageSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    {epsilon corePositiveConeMass sheathOppositeConeMass : Real}
    (h :
      @FixedWindowPreSummedStressMassShardCLeakageSource
        seq K hRho hCarrier hBeta hEvents L pressureL2 radialGrade
        formula epsilon corePositiveConeMass sheathOppositeConeMass) :
    FixedWindowOverflowVisibleOrInvisibleProfile formula epsilon
      corePositiveConeMass sheathOppositeConeMass :=
  FixedWindowOverflowVisibleOrInvisibleProfile.ofPressureRieszConeChargeSource
    (FixedWindowPressureRieszConeChargeSource.ofShardCLeakageSource h)

/-- Shard-C leakage source is enough to pay the repaired overflow fork. -/
theorem visibleOverflowCharge_of_shardCLeakageSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {pressureL2 : PressureHessianL2Amplitude}
    {radialGrade : Real}
    {formula : Route1ProjectedRieszAngularFormulaSource pressureL2 radialGrade}
    {epsilon corePositiveConeMass sheathOppositeConeMass : Real}
    (h :
      @FixedWindowPreSummedStressMassShardCLeakageSource
        seq K hRho hCarrier hBeta hEvents L pressureL2 radialGrade
        formula epsilon corePositiveConeMass sheathOppositeConeMass) :
    (FixedWindowOverflowVisibleOrInvisibleProfile.ofShardCLeakageSource
      h).visibleOverflowCharge :=
  visibleOverflowCharge_of_visibleOrInvisibleProfile
    (FixedWindowOverflowVisibleOrInvisibleProfile.ofShardCLeakageSource h)

/--
N8a guard: CKN Dirichlet-scale square charging is not a radius charge.

This records the standard proof-surface countermodel shape: bounded
`sum r_Q^2` prefixes do not control `sum r_Q` prefixes.  A route-1 schedule
closure cannot be used as a substitute for a separate radius/length charge.
-/
structure CKNRadiusSquareChargeDoesNotPayRadius where
  badRadius : Nat → Real
  badRadius_nonneg : ∀ n, 0 ≤ badRadius n
  squareChargeBudget : Real
  squarePrefixesBounded :
    ∀ N : Nat,
      NS.nsPrefixSum (fun n => (badRadius n) ^ 2) N ≤ squareChargeBudget
  radiusPrefixesUnbounded :
    ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum badRadius N
  cknDirichletPaysSquareScale : Prop
  codimFourPackingNeedsRadiusScale : Prop
  noRadiusControlFromSquareCharge : Prop

/--
The CKN/radius branch survives route-1 closure unless a non-energy radius
charge, endpoint regularity input, or reduction back to the route schedule is
proved before closure.
-/
structure CKNRadiusFailureRequiresSeparateCharge where
  cknRadiusFailure : Prop
  route1ScheduleClosed : Prop
  squareChargeNoGo : CKNRadiusSquareChargeDoesNotPayRadius
  endpointL3ChargeAvailable : Prop
  vorticityOrExcessDropChargeAvailable : Prop
  reductionToFreshFrequencyScheduleAvailable : Prop
  mustProveOneNonEnergyChargeBeforeClosing : Prop

/--
N8b guard: final pressure carrier magnitude is not a pre-summed pressure/cone
visibility theorem.  Fixed-window core/sheath cancellation can kill the final
carrier while leaving nonzero pre-summed stress.
-/
structure PressureConeFinalCarrierCancellationNoGo where
  finalProjectedCarrier : Real
  corePreSummedStress : Real
  sheathOppositeStress : Real
  finalCarrierZero : finalProjectedCarrier = 0
  coreStressPositive : 0 < corePreSummedStress
  sheathStressPositive : 0 < sheathOppositeStress
  sameWindowKernelSignIndefinite : Prop
  finalCarrierMagnitudeDoesNotPayPreSummedVisibility : Prop

/--
The pressure/cone branch closes only through pre-summed stress visibility,
singular-integral cancellation/coherence, or a zero-visibility profile
rigidity theorem.  Local route-1 energy accounting alone is not enough.
-/
structure PressureConeFailureRequiresPreSummedOrRigidity where
  pressureConeFailure : Prop
  finalCarrierNoGo : PressureConeFinalCarrierCancellationNoGo
  preSummedQPVisibilityAvailable : Prop
  fixedWindowStressCoherenceAvailable : Prop
  noInvisiblePressureProfileRigidityAvailable : Prop
  pressureBranchNotPaidByFinalCarrier : Prop

/--
N8c guard: an event ledger gives beta/center packing only after a fixed,
nonadaptive incidence theorem with bounded multiplicity and weight
comparability.
-/
structure BetaEventIncidenceRequired where
  betaIncidenceFailure : Prop
  routeEvent : Type
  badCenterNode : Type
  incidence : routeEvent → badCenterNode → Prop
  incidenceFixedBeforeRouteReceipt : Prop
  boundedIncidenceMultiplicity : Prop
  betaWeightComparableToEventPrice : Prop
  noBetaCarlesonFromEventBudgetWithoutIncidence : Prop

/--
N8d guard: N1 pays fresh same-cutoff, same-lineage tail square.  Unfresh or
inherited tail square must be charged by inherited energy, recurrent reuse, or
an explicit residual channel.
-/
structure UnfreshTailSquareRequiresInheritedOrResidualCharge where
  unfreshTailFailure : Prop
  tailSquare : Nat → Real
  freshFrequencyLockFails : Prop
  inheritedEnergyChargeAvailable : Prop
  recurrentReuseChargeAvailable : Prop
  explicitUnfreshResidualAvailable : Prop
  cannotUseFreshPersistenceDirectly : Prop

/--
N8e guard: repeated events on the same packet are controlled only by a
single-use lineage ledger: packet/event/carrier IDs, monotone reserve spending,
and bounded multiplicity.  Otherwise recurrent reuse is a separate residual.
-/
structure RecurrentReuseRequiresSingleUseLineageLedger where
  recurrentReuseFailure : Prop
  packetId : Type
  eventId : Type
  carrierId : Type
  assignedPacket : eventId → packetId
  assignedCarrier : eventId → carrierId
  monotoneReserveDrop : Prop
  rechargeBookedOnce : Prop
  cutoffErrorBookedOnce : Prop
  routedResidualBookedOnce : Prop
  boundedLineageMultiplicity : Prop
  noDoubleCountingAcrossScheduleComponents : Prop

/--
Top-down N8 protocol: after route 1 is closed, each named non-route branch
must either reduce to the route schedule by a concrete theorem or remain an
explicit open branch.
-/
structure NonRouteBranchClosureProtocol where
  route1Closed : Prop
  cknRadius :
    CKNRadiusFailureRequiresSeparateCharge
  pressureCone :
    PressureConeFailureRequiresPreSummedOrRigidity
  betaIncidence :
    BetaEventIncidenceRequired
  unfreshTail :
    UnfreshTailSquareRequiresInheritedOrResidualCharge
  recurrentReuse :
    RecurrentReuseRequiresSingleUseLineageLedger
  closeOnlyAfterEachBranchReducedOrClosed : Prop

/--
N8 compression after route-1 closure.

This is the reduced upstream statement suggested by the pincer: finite mass,
unfresh tails, and recurrent reuse are absorbed only under explicit harmlessness
and provenance/single-use hypotheses.  The remaining carriers are radius,
pressure/cone, and beta/incidence.
-/
structure N8ThreeCarrierCompression where
  criticalIncrementFailure : Prop
  route1Failure : Prop
  finiteMassResidual : Prop
  cknRadiusFailure : Prop
  pressureConeFailure : Prop
  betaIncidenceFailure : Prop
  unfreshTailFailure : Prop
  recurrentReuseFailure : Prop
  route1Closed : ¬ route1Failure
  finiteMassResidualClosed : ¬ finiteMassResidual
  unfreshTailReduces :
    unfreshTailFailure →
      route1Failure ∨ recurrentReuseFailure ∨ finiteMassResidual
  recurrentReuseClosed : ¬ recurrentReuseFailure
  fullN8Exhaustion :
    criticalIncrementFailure →
      route1Failure ∨ finiteMassResidual ∨ cknRadiusFailure ∨
        pressureConeFailure ∨ betaIncidenceFailure ∨ unfreshTailFailure ∨
          recurrentReuseFailure
  compressedN8 :
    criticalIncrementFailure →
      cknRadiusFailure ∨ pressureConeFailure ∨ betaIncidenceFailure

/--
Tri-carrier defect-drop target for the compressed N8 problem.

The carrier is intentionally explicit: radius/excess, beta/incidence, and
pre-summed pressure visibility are combined in a nonnegative defect potential.
The local inequality is a target theorem, not an available consequence of
route-1 closure.
-/
structure TriCarrierCriticalIncrementDrop where
  Cylinder : Type
  root : Cylinder
  defectPotential : Cylinder → Real
  childDefectSum : Cylinder → Real
  criticalIncrement : Cylinder → Real
  routeScheduleCharge : Cylinder → Real
  finiteResidualCharge : Cylinder → Real
  dropUpperBound : Cylinder → Real
  radiusCoeff : Real
  betaCoeff : Real
  pressureCoeff : Real
  rootBudget : Real
  defect_nonneg : ∀ Q : Cylinder, 0 ≤ defectPotential Q
  childDefect_nonneg : ∀ Q : Cylinder, 0 ≤ childDefectSum Q
  routeScheduleCharge_nonneg : ∀ Q : Cylinder, 0 ≤ routeScheduleCharge Q
  finiteResidualCharge_nonneg : ∀ Q : Cylinder, 0 ≤ finiteResidualCharge Q
  rootBound : defectPotential root ≤ rootBudget
  localDrop :
    ∀ Q : Cylinder,
      criticalIncrement Q ≤ dropUpperBound Q
  dropUpperBoundIsTriCarrierFormula : Prop
  radiusCarrierIncluded : Prop
  betaIncidenceCarrierIncluded : Prop
  preSummedPressureVisibilityCarrierIncluded : Prop
  carriersFixedBeforeFailure : Prop
  defectNotDefinedFromCriticalIncrement : Prop
  routeScheduleNotDefinedFromDropSlack : Prop
  pressureVisibilityPreSummedNotFinalCarrier : Prop
  betaIncidenceNonadaptive : Prop
  radiusCarrierNotCKNSquareChargeAlone : Prop

/--
Compression plus a tri-carrier drop closes the compressed critical-increment
branch only after the scalar summability interface consumes the telescoping
drop.  This records the required interface instead of asserting it for free.
-/
structure CriticalIncrementClosedFromTriCarrierDrop where
  compression : N8ThreeCarrierCompression
  triCarrierDrop : TriCarrierCriticalIncrementDrop
  routeScheduleSummable : Prop
  finiteResidualSummable : Prop
  telescopingDropConsumesCriticalIncrement : Prop
  cknRadiusClosedByDrop : ¬ compression.cknRadiusFailure
  pressureConeClosedByDrop : ¬ compression.pressureConeFailure
  betaIncidenceClosedByDrop : ¬ compression.betaIncidenceFailure
  closesCriticalIncrement :
    ¬ compression.criticalIncrementFailure

/--
Guard: the three-carrier compression is a routing result.  It does not prove
the local defect-drop inequality, nor does it remove the need for pressure
visibility and beta-incidence source theorems.
-/
structure TriCarrierDropIsNewLemmaNotClosure where
  compressionAvailable : N8ThreeCarrierCompression
  triCarrierDropUnproved : Prop
  pressureVisibilitySourceUnproved : Prop
  betaIncidenceSourceUnproved : Prop
  radiusDropSourceUnproved : Prop
  noCriticalIncrementClosureFromCompressionAlone : Prop

/--
Fourth-carrier exclusion for the compressed N8 route.

Darwin found the clean failure mode: inherited/reused packet mass can be a
separate lineage-reuse debt unless a numeric single-use theorem routes it to
the schedule, finite residual, radius, pressure, or beta carriers.
-/
structure FourthCarrierExclusionOrResidual where
  lineageReuseDebt : Prop
  routeSchedulePaysReuse : Prop
  finiteResidualPaysReuse : Prop
  radiusCarrierPaysReuse : Prop
  pressureCarrierPaysReuse : Prop
  betaCarrierPaysReuse : Prop
  noUnpaidFourthCarrier :
    lineageReuseDebt →
      routeSchedulePaysReuse ∨ finiteResidualPaysReuse ∨
        radiusCarrierPaysReuse ∨ pressureCarrierPaysReuse ∨
          betaCarrierPaysReuse
  noPostHocReuseClassification : Prop

/--
Supermartingale/telescoping gate for the tri-carrier potential.

Without a positive tree-local drop plus explicit leakage, `D(Q) - sum D(child)`
can be negative on a branching tree, especially for nonlocal pressure and
non-tree-local beta incidence.
-/
structure TriCarrierSupermartingaleGate where
  Cylinder : Type
  defectPotential : Cylinder → Real
  childDefectSum : Cylinder → Real
  leakage : Cylinder → Real
  defect_nonneg : ∀ Q : Cylinder, 0 ≤ defectPotential Q
  leakage_nonneg : ∀ Q : Cylinder, 0 ≤ leakage Q
  childSubadditivityWithLeakage :
    ∀ Q : Cylinder, childDefectSum Q ≤ defectPotential Q + leakage Q
  treeFixedBeforeDrop : Prop
  pressureLeakageAccounted : Prop
  betaIncidenceLeakageAccounted : Prop

/--
Radius-scale lower bound needed to turn the CKN radius branch into a
tri-carrier payment.  Classical square-scale energy alone is explicitly
insufficient.
-/
structure RadiusScaleLowerBoundGate where
  radiusCarrier : Nat → Real
  radius : Nat → Real
  radius_nonneg : ∀ n, 0 ≤ radius n
  radiusCarrier_nonneg : ∀ n, 0 ≤ radiusCarrier n
  epsilon : Real
  epsilon_pos : 0 < epsilon
  radiusBadNodeLowerBound :
    ∀ n, epsilon * radius n ≤ radiusCarrier n
  notCKNSquareChargeAlone : Prop
  selectedBadFamilyFixedBeforeCharge : Prop

/--
Pressure visibility source gate.  The pressure component must be pre-summed
and fixed-window, not final signed-carrier magnitude.
-/
structure PreSummedPressureVisibilityGate where
  pressureVisibility : Nat → Real
  pressureVisibility_nonneg : ∀ n, 0 ≤ pressureVisibility n
  preSummedStressCarrier : Prop
  fixedGaugeAndKernelBeforeReceipt : Prop
  notFinalProjectedCarrierMagnitude : Prop
  sameWindowCancellationAudited : Prop
  lowerSemicontinuityInTreeLimit : Prop
  pressureVisibilityFeedsTriCarrier : Prop

/--
Beta/event incidence cofinality gate.  The beta carrier is available only if
bad-center nodes and route events are linked by a nonadaptive bounded
incidence theorem with weight comparability.
-/
structure BetaIncidenceCofinalityGate where
  routeEvent : Type
  badNode : Type
  incidence : routeEvent → badNode → Prop
  incidenceNonadaptive : Prop
  boundedMultiplicity : Prop
  weightRadiusComparable : Prop
  gainBetaComparable : Prop
  prefixCofinal : Prop
  betaCarrierFeedsTriCarrier : Prop

/--
Source-gated version of the tri-carrier drop target.  This is the next theorem
to prove or kill; it is not supplied by `N8ThreeCarrierCompression`.
-/
structure SourceGatedTriCarrierCriticalIncrementDrop where
  compression : N8ThreeCarrierCompression
  fourthCarrier :
    FourthCarrierExclusionOrResidual
  supermartingale :
    TriCarrierSupermartingaleGate
  radiusLowerBound :
    RadiusScaleLowerBoundGate
  pressureVisibility :
    PreSummedPressureVisibilityGate
  betaIncidence :
    BetaIncidenceCofinalityGate
  drop :
    TriCarrierCriticalIncrementDrop
  allCarriersFixedBeforeFailureClassification : Prop
  noTargetDefinedPotentialOrSlack : Prop

/--
Componentwise local domination for the corrected corona route.

This is the PDE/GMT theorem to source.  The five component bounds must use
fixed carriers, not measures defined after seeing the critical increment.
-/
structure TriCarrierFreshDomination (Ω : Type u) (BadNode : Type v) where
  omegaRadius : Set Ω → Real
  omegaPressure : Set Ω → Real
  omegaBeta : Set Ω → Real
  omegaRouteSchedule : Set Ω → Real
  omegaFiniteResidual : Set Ω → Real
  freshRegion : BadNode → Set Ω
  criticalIncrementMass : BadNode → Real
  radiusComponent : BadNode → Real
  pressureComponent : BadNode → Real
  betaComponent : BadNode → Real
  routeComponent : BadNode → Real
  finiteComponent : BadNode → Real
  radiusCoeff : Real
  pressureCoeff : Real
  betaCoeff : Real
  routeCoeff : Real
  finiteCoeff : Real
  totalCoeff : Real
  criticalIncrement_split :
    ∀ Q : BadNode,
      criticalIncrementMass Q =
        radiusComponent Q + pressureComponent Q + betaComponent Q +
          routeComponent Q + finiteComponent Q
  radiusComponentBound :
    ∀ Q : BadNode,
      radiusComponent Q ≤ radiusCoeff * omegaRadius (freshRegion Q)
  pressureComponentBound :
    ∀ Q : BadNode,
      pressureComponent Q ≤ pressureCoeff * omegaPressure (freshRegion Q)
  betaComponentBound :
    ∀ Q : BadNode,
      betaComponent Q ≤ betaCoeff * omegaBeta (freshRegion Q)
  routeScheduleComponentBound :
    ∀ Q : BadNode,
      routeComponent Q ≤ routeCoeff * omegaRouteSchedule (freshRegion Q)
  finiteResidualComponentBound :
    ∀ Q : BadNode,
      finiteComponent Q ≤ finiteCoeff * omegaFiniteResidual (freshRegion Q)
  localDomination :
    ∀ Q : BadNode,
      criticalIncrementMass Q ≤
        totalCoeff *
          (omegaRadius (freshRegion Q) +
            omegaPressure (freshRegion Q) +
              omegaBeta (freshRegion Q) +
                omegaRouteSchedule (freshRegion Q) +
                  omegaFiniteResidual (freshRegion Q))
  carriersFixedBeforeIncrementAccounting : Prop
  noFinalPressureCarrierMagnitude : Prop
  noPostHocBetaIncidence : Prop
  noRouteSlackResidual : Prop

/--
Corona potential for the corrected tri-carrier route.

The potential is `D(Q) = omega(tent Q)`, not a raw node-value expression.
Fresh regions are the tent portions left after child tents are removed; this is
what makes finite-prefix telescoping available.
-/
structure TriCarrierCoronaPotential (Ω : Type u) (BadNode : Type v)
    [DecidableEq BadNode] where
  omega : Set Ω → Real
  tent : BadNode → Set Ω
  children : BadNode → Finset BadNode
  freshRegion : BadNode → Set Ω
  defectPotential : BadNode → Real
  root : BadNode
  rootBudget : Real
  overlapConst : Real
  criticalIncrementMass : BadNode → Real
  prefixCriticalMass : Finset BadNode → Real
  cDomination : Real
  freshRegion_eq_tentMinusChildren : Prop
  defect_eq_tentMass :
    ∀ Q : BadNode, defectPotential Q = omega (tent Q)
  rootBound :
    omega (tent root) ≤ rootBudget
  boundedFreshOverlap : Prop
  localFreshDomination :
    ∀ Q : BadNode,
      criticalIncrementMass Q ≤ cDomination * omega (freshRegion Q)
  prefixTelescoping :
    ∀ P : Finset BadNode,
      prefixCriticalMass P ≤
        cDomination * overlapConst * omega (tent root)
  omegaFixedBeforeCriticalIncrement : Prop
  freshRegionsNonadaptive : Prop
  noPotentialDefinedFromCriticalIncrement : Prop

/--
The fresh-domination theorem feeds the corona potential only after the composite
carrier is fixed and the fresh-overlap/telescoping facts are supplied.
-/
structure TriCarrierCoronaPotentialFromFreshDomination
    (Ω : Type u) (BadNode : Type v) [DecidableEq BadNode] where
  freshDomination :
    TriCarrierFreshDomination Ω BadNode
  corona :
    TriCarrierCoronaPotential Ω BadNode
  sameCriticalIncrementMass :
    corona.criticalIncrementMass = freshDomination.criticalIncrementMass
  sameFreshRegion :
    corona.freshRegion = freshDomination.freshRegion
  omegaAggregatesFiveCarriers : Prop
  finiteRootCarrierBudget : Prop
  boundedFreshOverlap : Prop
  producesCoronaPotential : Prop

/--
Corrected N8 closure target: compression plus a corona potential closes only
when the critical-increment failure predicate requires nonsummable mass.
-/
structure CriticalIncrementClosedFromTriCarrierCorona
    (Ω : Type u) (BadNode : Type v) [DecidableEq BadNode] where
  compression : N8ThreeCarrierCompression
  corona : TriCarrierCoronaPotential Ω BadNode
  criticalFailureRequiresNonsummableMass :
    compression.criticalIncrementFailure →
      ∀ B : Real, ∃ P : Finset BadNode,
        B < corona.prefixCriticalMass P
  scalarLayerConsumesFiniteCoronaBudget : Prop
  closesCriticalIncrement :
    ¬ compression.criticalIncrementFailure

/--
Guard: the corona potential fixes telescoping, but the local domination bounds
are still the mathematical content.
-/
structure TriCarrierCoronaDoesNotProveFreshDomination where
  coronaPotentialAvailable : Prop
  freshDominationUnproved : Prop
  radiusComponentBoundUnproved : Prop
  pressureComponentBoundUnproved : Prop
  betaComponentBoundUnproved : Prop
  noClosureFromCoronaGeometryAlone : Prop

/-- Radius component source: the radius carrier must pay radius scale, not just
CKN square-scale mass. -/
structure RadiusComponentPaysRadiusScale where
  radiusSource : RadiusScaleLowerBoundGate
  radiusComponentBound : Prop
  fixedBadCylinderFamily : Prop
  noSquareChargeSubstitution : Prop

/-- Pressure component source: visibility must be pre-summed and compatible
with the fixed window/tree limit. -/
structure PressureRieszPreSummedLocalLSCVisibility where
  pressureSource : PreSummedPressureVisibilityGate
  pressureComponentBound : Prop
  fixedWindowAndGauge : Prop
  lowerSemicontinuityForCoronaTree : Prop
  noFinalCarrierMagnitudeShortcut : Prop

/-- Beta component source: route events and bad-center nodes must be linked by
nonadaptive cofinal incidence with bounded multiplicity and comparability. -/
structure BadCenterEventIncidenceCofinalComparable where
  betaSource : BetaIncidenceCofinalityGate
  betaComponentBound : Prop
  eventBadNodeCofinality : Prop
  boundedMultiplicityNumeric : Prop
  weightRadiusAndGainBetaComparable : Prop
  noAdaptiveIncidenceSelection : Prop

/-- No-double-counting source for the five components of the fresh domination
carrier. -/
structure TriCarrierNoDoubleCounting where
  radiusPressureBetaDisjointOrAccountedOverlap : Prop
  routeScheduleNotRebookedAsRadiusPressureBeta : Prop
  finiteResidualNotDefinedFromCriticalIncrementSlack : Prop
  cutoffRechargeResidualBookedOnce : Prop
  allComponentCarriersFixedBeforeSummation : Prop

/-- Nonadaptive corona/fresh-region construction source. -/
structure NonadaptiveCoronaFreshOverlap where
  coronaTreeFixedBeforeFailureClassification : Prop
  freshRegionsFixedBeforeIncrementAccounting : Prop
  boundedFreshOverlapNumeric : Prop
  childSelectionNotPostHoc : Prop
  tentsAndChildrenCompatible : Prop

/--
Source bundle for `TriCarrierFreshDomination`.

This is the exact list of local component theorems needed before the corona
potential can be used to close the compressed N8 branch.
-/
structure TriCarrierFreshDominationSource
    (Ω : Type u) (BadNode : Type v) where
  radiusSource :
    RadiusComponentPaysRadiusScale
  pressureSource :
    PressureRieszPreSummedLocalLSCVisibility
  betaSource :
    BadCenterEventIncidenceCofinalComparable
  noDoubleCounting :
    TriCarrierNoDoubleCounting
  coronaFresh :
    NonadaptiveCoronaFreshOverlap
  freshDomination :
    TriCarrierFreshDomination Ω BadNode
  sourcesProduceLocalDomination : Prop
  noOpaqueFreshDominationAssumption : Prop

/--
Flat multiscale radius reuse countermodel surface.

This is the radius-side no-go: square-scale CKN charging can be finite while
radius prefixes diverge, with beta, pressure, route schedule, and finite
residual carriers absent.
-/
structure FlatMultiscaleRadiusReuseCountermodel where
  radius : Nat → Real
  radius_nonneg : ∀ n, 0 ≤ radius n
  squareChargeBudget : Real
  squarePrefixesBounded :
    ∀ N : Nat, NS.nsPrefixSum (fun n => (radius n) ^ 2) N ≤ squareChargeBudget
  radiusPrefixesUnbounded :
    ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum radius N
  betaCarrierZero : Prop
  pressureVisibilityZero : Prop
  routeScheduleZero : Prop
  finiteResidualZero : Prop
  flatInheritedAcrossScales : Prop
  freshCoronaRegionCanBeEmpty : Prop

/--
Sharpened radius obstruction after the tri-carrier audit.

The broad CKN/radius failure is now represented by flat inherited scale reuse:
radius length is selected across scales without fresh radius reserve drop,
pressure visibility, beta incidence, route schedule, or finite residual payment.
-/
structure FlatRadiusScaleReserveFailure where
  flatReuseCountermodel :
    FlatMultiscaleRadiusReuseCountermodel
  radiusScaleReserveMissing : Prop
  noFreshRadiusDrop : Prop
  noReductionToRouteSchedule : Prop
  noPressureVisibilityPayment : Prop
  noBetaIncidencePayment : Prop

/--
Primitive that would close the sharpened flat-radius branch.

This is a radius-scale reserve, not ordinary CKN square-scale energy.  It
must pay selected flat inherited bad scales by a monotone reserve drop or by
already-routed schedule/pressure/beta charges.
-/
structure FlatRadiusReuseConsumesScaleReserve (BadNode : Type u)
    [DecidableEq BadNode] where
  reserve : BadNode → Real
  selectedChildren : BadNode → Finset BadNode
  radius : BadNode → Real
  routeScheduleCharge : BadNode → Real
  pressureVisibilityCharge : BadNode → Real
  betaIncidenceCharge : BadNode → Real
  flatInheritedCover : BadNode → Prop
  reserve_nonneg : ∀ Q : BadNode, 0 ≤ reserve Q
  radius_nonneg : ∀ Q : BadNode, 0 ≤ radius Q
  radiusCoeff : Real
  radiusCoeff_pos : 0 < radiusCoeff
  flatBadScaleConsumesRadius :
    ∀ Q : BadNode,
      flatInheritedCover Q →
        radiusCoeff * radius Q ≤
          reserve Q -
            (selectedChildren Q).sum reserve +
              routeScheduleCharge Q +
                pressureVisibilityCharge Q +
                  betaIncidenceCharge Q
  finiteRootReserve : Prop
  telescopesToFiniteRadiusPrefixes : Prop
  reserveFixedBeforeBadScaleSelection : Prop
  noReserveDefinedFromRadiusSlack : Prop

/--
Radius audit: the current tri-carrier data does not close radius scale unless
a flat-radius scale reserve is supplied.
-/
structure RadiusComponentAuditSharpensToFlatScaleReserve where
  cknRadiusFailure : Prop
  flatRadiusScaleReserveSource :
    FlatRadiusScaleReserveFailure
  flatRadiusScaleReserveFailure : Prop
  radiusComponentPaysRadiusScaleUnavailable : Prop
  flatReuseCountermodelWitness :
    FlatMultiscaleRadiusReuseCountermodel
  radiusAudit :
    cknRadiusFailure → flatRadiusScaleReserveFailure

/--
Reduced upstream frontier after the radius audit.

Once route 1 and N8 compression are in place, the radius branch sharpens to
flat scale-reserve failure.  Pressure/cone and beta/incidence remain as the
other two reduced branches.
-/
structure CriticalIncrementReducedAfterRadiusAudit where
  compression : N8ThreeCarrierCompression
  flatRadiusScaleReserveFailure : Prop
  radiusAudit :
    compression.cknRadiusFailure → flatRadiusScaleReserveFailure

/-- N8 plus the radius audit reduces critical-increment failure to three sharpened branches. -/
theorem reducedFailure_of_radiusAudit
    (h : CriticalIncrementReducedAfterRadiusAudit) :
    h.compression.criticalIncrementFailure →
      h.flatRadiusScaleReserveFailure ∨
        h.compression.pressureConeFailure ∨
          h.compression.betaIncidenceFailure := by
  intro hcrit
  cases h.compression.compressedN8 hcrit with
  | inl hckn =>
      exact Or.inl (h.radiusAudit hckn)
  | inr hrest =>
      exact Or.inr hrest

/--
Pressure/cone source surface after the radius audit.

This is deliberately pre-summed: final projected pressure carrier magnitude is
not accepted as the source, because same-window cancellation can hide the final
carrier while the underlying stress remains nonzero.
-/
structure PressureConeFailureReducesToPreSummedVisibilityOrRigidity
    (Ω : Type u) (BadNode : Type v) where
  pressureConeFailure : Prop
  omegaPressure : Set Ω → Real
  freshRegion : BadNode → Set Ω
  pressureComponent : BadNode → Real
  pressureVisibility : BadNode → Real
  pressureCoeff : Real
  pressureVisibility_nonneg :
    ∀ Q : BadNode, 0 ≤ pressureVisibility Q
  fixedWindowAndGauge : Prop
  sameWindowCancellationAudited : Prop
  preSummedStressCarrier : Prop
  notFinalProjectedCarrierMagnitude : Prop
  localRieszCZLowerSemicontinuityOnFreshRegions : Prop
  pressureVisibility_le_omegaPressure :
    ∀ Q : BadNode, pressureVisibility Q ≤ omegaPressure (freshRegion Q)
  pressureComponent_le_visibility :
    ∀ Q : BadNode, pressureComponent Q ≤ pressureCoeff * pressureVisibility Q
  zeroVisibilityProfileRigidity : Prop
  zeroVisibility_closes_pressureCone :
    (∀ Q : BadNode, pressureVisibility Q = 0) → ¬ pressureConeFailure
  visibilityFeedsTriCarrier :
    ∀ Q : BadNode,
      pressureComponent Q ≤ pressureCoeff * omegaPressure (freshRegion Q)
  pressureCone_reduces :
    pressureConeFailure → preSummedStressCarrier ∨ zeroVisibilityProfileRigidity
  noFinalCarrierShortcut : Prop
  noPostHocWindowOrGauge : Prop
  noVisibilityDefinedFromCriticalIncrement : Prop

/--
Beta/event incidence source surface after the radius audit.

The event ledger does not become a bad-center beta-Carleson ledger unless this
nonadaptive incidence contract is supplied: weights compare to radii, gains
compare to beta-square, prefixes are cofinal, and multiplicity is bounded.
-/
structure BadCenterBetaEventIncidenceClosure
    (RouteEvent : Type u) (BadNode : Type v) where
  incidence : RouteEvent → BadNode → Prop
  eventWeight : RouteEvent → Real
  eventGain : RouteEvent → Real
  radius : BadNode → Real
  beta : BadNode → Real
  eventLedgerBudget : Real
  betaPrefixMass : Nat → Real
  incidenceNonadaptive : Prop
  boundedMultiplicity : Prop
  weightRadiusComparable : Prop
  gainBetaComparable : Prop
