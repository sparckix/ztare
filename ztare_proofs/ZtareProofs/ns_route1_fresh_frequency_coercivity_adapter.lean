    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc) where
  invoiceAssignedBeforeSubtreeSelection : Prop
  eventDataMatchedToResidualFreshAuditIndex : Prop
  residualBranchLedgerEventsPayNodeRadii : Prop
  pressureCarrierIdentifiedWithResidualFreshRegion : Prop
  pressureLocalizationProvedOnPuncturedInvoiceCarrier : Prop
  inheritedNodesRoutedOffSameLedgerParentInvoice : Prop
  inheritedBranchMarkedNonChargeableForParentRadius :
    hLock.inheritedBadnessDoesNotCreateNewEvent
  descendantInvoicesDisjointOrBoundedOverlap : Prop
  finiteFreshInvoiceBudget : Prop
  invoiceUsesSameNormalizedExcessStoppingTree : Prop
  doesNotFactorThroughCFDirectionAlignment : Prop
  notDegreeZeroRieszBookkeeping : Prop
  notParabolicRateSlavedScalar : Prop
  noPostHocRadiusInvoiceAssignment : Prop
  notBetaFrequencyPaymentRelabel : Prop
  notAbstractRadiusChargeProjectionOnly : Prop
  producesRadiusCharging :
    RadiusChargingBadScaleMeasure seq K hRho

/--
Lower pressure-localization surface surfaced by the TICK654 pressure lane.
This keeps the actual pressure-recovery carrier visible instead of compressing
it into the coarse `FreshFrequencyPressureDuhamelSameCarrierLock` proposition.
-/
structure ResidualFreshPressureTailLocalizedToPuncturedInvoiceCarrier
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L) where
  pressureRecoveryCarrier_eq_residualFreshRegion :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      hGeom.pressureRecoveryCarrier
        (residualFreshAuditEventIndex hElig Q hQ hResidual) =
          hElig.residualFreshExcess.freshRegion Q
  pressureTailLocalizedOnResidualFreshRegion : Prop
  localizedBeforeSubtreeSelection :
    hPressure.assignedBeforeRadiusAccounting
  inheritedOrHarmonicPressureDoesNotCreateParentInvoice : Prop
  notCoarsePressureLockOnly : Prop

/--
TICK655 source theorem for the pressure-carrier localization surface.

The pressure carrier is already locked to the event tent by
`LerayHeatFreshFrequencyEventTentGeometry.pressureCarrier_eq_eventTent`.
The missing content is lower: the residual audit event tent itself must be
identified with the residual fresh region for the same bad node.  This object
keeps that equality separate from coarse pressure-tail localization and from
the event-to-bad-node bookkeeping.
-/
structure ResidualFreshAuditEventTentFreshRegionIdentification
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L) where
  eventTent_eq_residualFreshRegion :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      hGeom.eventTent
        (residualFreshAuditEventIndex hElig Q hQ hResidual) =
          hElig.residualFreshExcess.freshRegion Q
  residualAuditEventStillTargetsBadNode :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      hEvents.eventToBadNode
        (residualFreshAuditEventIndex hElig Q hQ hResidual) = Q
  pressureCarrier_eq_eventTent_available :
    ∀ e : ℕ, hGeom.pressureRecoveryCarrier e = hGeom.eventTent e
  identificationFixedBeforeRadiusAccounting : Prop
  noHarmonicOrInheritedPressureCarrierExpansion : Prop
  notPressureTailLocalizedToFreshVelocityRelabel : Prop
  notCoarseEventAttachmentOnly : Prop

/-- Event-tent/fresh-region identification promotes to the displayed pressure
carrier localization, because the pressure carrier is already the event tent. -/
def ResidualFreshPressureTailLocalizedToPuncturedInvoiceCarrier.ofEventTentFreshRegionIdentification
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (h :
      ResidualFreshAuditEventTentFreshRegionIdentification hElig hGeom)
    (localizedBeforeSubtreeSelection :
      hPressure.assignedBeforeRadiusAccounting)
    (pressureTailLocalizedOnResidualFreshRegion : Prop) :
    ResidualFreshPressureTailLocalizedToPuncturedInvoiceCarrier
      hElig hGeom hPressure where
  pressureRecoveryCarrier_eq_residualFreshRegion := by
    intro Q hQ hResidual
    calc
      hGeom.pressureRecoveryCarrier
          (residualFreshAuditEventIndex hElig Q hQ hResidual) =
          hGeom.eventTent
            (residualFreshAuditEventIndex hElig Q hQ hResidual) :=
        h.pressureCarrier_eq_eventTent_available
          (residualFreshAuditEventIndex hElig Q hQ hResidual)
      _ = hElig.residualFreshExcess.freshRegion Q :=
        h.eventTent_eq_residualFreshRegion Q hQ hResidual
  pressureTailLocalizedOnResidualFreshRegion :=
    pressureTailLocalizedOnResidualFreshRegion
  localizedBeforeSubtreeSelection :=
    localizedBeforeSubtreeSelection
  inheritedOrHarmonicPressureDoesNotCreateParentInvoice :=
    h.noHarmonicOrInheritedPressureCarrierExpansion
  notCoarsePressureLockOnly :=
    h.notPressureTailLocalizedToFreshVelocityRelabel

/-- Any displayed pressure-carrier localization contains the missing
event-tent/fresh-region equality after rewriting by the existing carrier lock. -/
def eventTentFreshRegionIdentification_of_pressureCarrierLocalization
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (h :
      ResidualFreshPressureTailLocalizedToPuncturedInvoiceCarrier
        hElig hGeom hPressure) :
    ResidualFreshAuditEventTentFreshRegionIdentification hElig hGeom where
  eventTent_eq_residualFreshRegion := by
    intro Q hQ hResidual
    calc
      hGeom.eventTent
          (residualFreshAuditEventIndex hElig Q hQ hResidual) =
          hGeom.pressureRecoveryCarrier
            (residualFreshAuditEventIndex hElig Q hQ hResidual) :=
        (hGeom.pressureCarrier_eq_eventTent
          (residualFreshAuditEventIndex hElig Q hQ hResidual)).symm
      _ = hElig.residualFreshExcess.freshRegion Q :=
        h.pressureRecoveryCarrier_eq_residualFreshRegion Q hQ hResidual
  residualAuditEventStillTargetsBadNode :=
    residualFreshAuditEventIndex_matches_badNode hElig
  pressureCarrier_eq_eventTent_available :=
    hGeom.pressureCarrier_eq_eventTent
  identificationFixedBeforeRadiusAccounting :=
    True
  noHarmonicOrInheritedPressureCarrierExpansion :=
    h.inheritedOrHarmonicPressureDoesNotCreateParentInvoice
  notPressureTailLocalizedToFreshVelocityRelabel :=
    h.notCoarsePressureLockOnly
  notCoarseEventAttachmentOnly :=
    h.notCoarsePressureLockOnly

/-- TICK655 contrapositive: absent event-tent/fresh-region identification, the
displayed pressure-carrier localization cannot be constructed from the current
geometry. -/
theorem pressureCarrierLocalization_needs_eventTentFreshRegionIdentification
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (hNoIdentification :
      ¬ Nonempty
        (ResidualFreshAuditEventTentFreshRegionIdentification hElig hGeom)) :
    ¬ Nonempty
      (ResidualFreshPressureTailLocalizedToPuncturedInvoiceCarrier
        hElig hGeom hPressure) := by
  intro hLocalized
  exact hNoIdentification
    ⟨eventTentFreshRegionIdentification_of_pressureCarrierLocalization
      hLocalized.some⟩

