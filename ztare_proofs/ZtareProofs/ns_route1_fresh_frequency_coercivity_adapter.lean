        hElig hGeom hPressure hDuhamel hLock) where
  indexedCarrierAvailable : Prop
  receiptFieldsAreProofsNotLabels : Prop
  sameTreeInvoiceEmbeddingFieldsArePropDeclarations : Prop
  pressureDuhamelInheritedReserveFieldsArePropDeclarations : Prop
  lockTimingFieldsArePropDeclarations : Prop
  sourceAntiRelabelFieldsArePropDeclarations : Prop
  noProjectionWithoutStrengthenedProofCarrier : Prop

/--
Receipt-completion object for the stronger corona-Duhamel production carrier.

The carrier records the right PDE source surface, but many of its fields are
`Prop` declarations.  This object prevents a false compression: the C7 schedule
receipts are still separate proof receipts unless they are explicitly supplied
for the projected audit-indexed carrier.
-/
structure CoronaDuhamelProductionScheduleReceiptCompletion
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (h :
      CoronaDuhamelProductionSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock) where
  projectedCarrier :
    ResidualFreshAuditIndexedSingleSpendCarrier
      hElig hGeom hPressure hDuhamel hLock :=
      ResidualFreshAuditIndexedSingleSpendCarrier.ofCoronaDuhamelProduction h
  scheduleReceipts :
    BadCenterBetaSquareScheduleReceiptsFromIndexedCarrier projectedCarrier
  propDeclarationsBackedByReceipts : Prop

/--
If the proof-carrying receipts above are supplied, the bad-center beta-square
event source becomes the numerical schedule required by the C7
fresh-annular consumer.

This is the Clay-adjacent boundary for the current lane: the beta-square
pointwise algebra and reserve arithmetic are already compiled; the remaining
work is to prove these receipts from the NS geometry rather than name them.
-/
def FreshAnnularNumericalScheduleFromIndexedCarrier.ofBadCenterBetaSquareEventSourceWithReceipts
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock)
    (hPoint :
      BadCenterEventPointwiseBetaSquareIdentity
        seq K hRho hCarrier hBeta hEvents L)
    (hReceipts :
      BadCenterBetaSquareScheduleReceiptsFromIndexedCarrier hIndexed) :
    FreshAnnularNumericalScheduleFromIndexedCarrier hIndexed where
  activeTail :=
    badCenterBetaSquareEventActiveTail (hBeta := hBeta) hEvents
  freshCharge :=
    fun n : Nat => L.eventWeight n * (L.eventGain n) ^ (2 : Nat)
  c := 1
  rootBudget := L.priceBudget
  c_pos := zero_lt_one
  pointwiseFreshPayment :=
    badCenterBetaSquareEventActiveTail_paid_by_eventCharge hPoint
  freshChargePrefixBudget := by
    intro N
    simpa [NS.eventWeightedGainPricePrefix]
      using hLock.finiteIndependentEnstrophyDuhamelBudget N
  eventScheduleEnumeratesInvoiceBadNodes :=
    hIndexed.sameTreeInvoiceEmbedding.eventDataMatchedToResidualFreshAuditIndex
  eventScheduleEnumeratesInvoiceBadNodes_proof :=
    hReceipts.eventScheduleEnumeratesInvoiceBadNodes_proof
  freshChargeQuantifiesInvoiceRegions :=
    hIndexed.sameTreeInvoiceEmbedding.residualBranchLedgerEventsPayNodeRadii
  freshChargeQuantifiesInvoiceRegions_proof :=
    hReceipts.freshChargeQuantifiesInvoiceRegions_proof
  invoiceAssignedBeforeSubtreeSelection_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.invoiceAssignedBeforeSubtreeSelection_proof
  invoiceUsesSameNormalizedExcessStoppingTree_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.invoiceUsesSameNormalizedExcessStoppingTree_proof
  oneUseNoDescendantRebilling_verified :=
    hIndexed.noRepeatedDescendantCharging
  descendantInvoicesDisjointOrBoundedOverlap_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.descendantInvoicesDisjointOrBoundedOverlap_proof
  finiteFreshInvoiceBudget_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.finiteFreshInvoiceBudget_proof
  pressureReserveSeparatedFromParentInvoice_verified :=
    hReceipts.pressureReserveNotParentInvoice_proof
  duhamelReserveSeparatedFromShellLedger_verified :=
    hReceipts.duhamelReserveNotShellProcessLedger_proof
  inheritedReserveSeparatedFromParentInvoice_verified :=
    hReceipts.inheritedDescendantsDoNotMintParentInvoices_proof
  sourceProductionSpendPartitionReceipt :=
    hIndexed.singleSpendPartition
  sourceProductionSpend_nonnegative :=
    hIndexed.productionSpend_nonnegative
  duhamelSectionIdentityReceiptForSchedule :=
    hIndexed.auditIndexFixedBeforeSpendPartition.duhamelSectionIdentity
  scheduleFixedBeforePayoffFromAuditIndex :=
    And
      hIndexed.auditIndexFixedBeforeSpendPartition.auditIndexChosenBeforeParentInvoiceAccounting
      hLock.nonadaptiveBeforeRadiusAccounting
  scheduleFixedBeforePayoffFromAuditIndex_proof :=
    And.intro
      hReceipts.auditIndexChosenBeforeParentInvoiceAccounting_proof
      hReceipts.nonadaptiveBeforeRadiusAccounting_proof
  sameCarrierFreshAnnularInjectionOrReserveDrop :=
    And
      hIndexed.sameTreeInvoiceEmbedding.invoiceUsesSameNormalizedExcessStoppingTree
      hLock.generatedFromSameBadCenterStoppingTree
  sameCarrierFreshAnnularInjectionOrReserveDrop_proof :=
    And.intro
      hReceipts.invoiceUsesSameNormalizedExcessStoppingTree_proof
      hReceipts.generatedFromSameBadCenterStoppingTree_proof
  notFiniteScalarChargeOnly :=
    And hIndexed.notBetaFrequencyPaymentRelabel
      hIndexed.notShellProcessReserveRelabel
  notFiniteScalarChargeOnly_proof :=
    And.intro
      hReceipts.notBetaFrequencyPaymentRelabel_proof
      hReceipts.notShellProcessReserveRelabel_proof

/--
Full schedule adapter for an externally supplied C7 route active tail.

This combines the two frontiers: the route-tail identification receipt supplies
the active tail and pointwise event payment, while the schedule-receipt bundle
supplies the C7 invoice/timing/separation data.  Either half alone is
insufficient.
-/
def FreshAnnularNumericalScheduleFromIndexedCarrier.ofC7RouteActiveTailIdentificationWithReceipts
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {routeActiveTail : Nat → Real}
    (hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock)
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail)
    (hReceipts :
      BadCenterBetaSquareScheduleReceiptsFromIndexedCarrier hIndexed) :
    FreshAnnularNumericalScheduleFromIndexedCarrier hIndexed :=
  let hBase :=
    FreshAnnularNumericalScheduleFromIndexedCarrier.ofBadCenterBetaSquareEventSourceWithReceipts
      hIndexed hId.pointwiseBetaSquareIdentity hReceipts
  {
    activeTail := routeActiveTail
    freshCharge := hBase.freshCharge
    c := hBase.c
    rootBudget := hBase.rootBudget
    c_pos := hBase.c_pos
    pointwiseFreshPayment :=
      c7RouteActiveTail_paid_by_eventCharge_of_eventBetaSquareIdentification
        hId
    freshChargePrefixBudget := hBase.freshChargePrefixBudget
    eventScheduleEnumeratesInvoiceBadNodes :=
      hBase.eventScheduleEnumeratesInvoiceBadNodes
    eventScheduleEnumeratesInvoiceBadNodes_proof :=
      hBase.eventScheduleEnumeratesInvoiceBadNodes_proof
    freshChargeQuantifiesInvoiceRegions :=
      hBase.freshChargeQuantifiesInvoiceRegions
    freshChargeQuantifiesInvoiceRegions_proof :=
      hBase.freshChargeQuantifiesInvoiceRegions_proof
    invoiceAssignedBeforeSubtreeSelection_verified :=
      hBase.invoiceAssignedBeforeSubtreeSelection_verified
    invoiceUsesSameNormalizedExcessStoppingTree_verified :=
      hBase.invoiceUsesSameNormalizedExcessStoppingTree_verified
    oneUseNoDescendantRebilling_verified :=
      hBase.oneUseNoDescendantRebilling_verified
    descendantInvoicesDisjointOrBoundedOverlap_verified :=
      hBase.descendantInvoicesDisjointOrBoundedOverlap_verified
