    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L)
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L)
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc) where
  pressureDuhamelLockAvailable :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  sameTreeLockAvailable :
    FreshFrequencyEventSameTreeLock
      seq K hRho hCarrier hBeta hEvents L hScale hInc
  pressureBudgetControlsOnlyEventPrefix :
    ∀ N : ℕ, NS.eventWeightedGainPricePrefix L N ≤ L.priceBudget
  noRepeatedDescendantChargingVisible : Prop
  auditIndexedSingleSpendCarrierMissing :
    ¬ Nonempty
      (ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock)
  singleSpendDualLedgerBridgeMissing :
    ¬ Nonempty (C7SingleSpendDualLedgerBridge hElig hGeom hPressure hLock)
  duhamelHeatLocalizationNotYetInvoiceCarrier : Prop
  pressureReserveNotYetSeparatedFromParentInvoice : Prop
  parentRadiusInvoiceCanStillBeRebilledByPressureCarrier : Prop
  inheritedReserveCanStillMintParentInvoice : Prop
  pressureDuhamelPrefixIsNotRadiusInvoice : Prop
  requiresSameTreeCarlesonInvoiceEmbedding : Prop
  noPromotionFromPressureDuhamelLockAlone : Prop

/-- Constructor for the TICK663 rebilling boundary. -/
theorem sameTreePressureDuhamelRebilling_boundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
