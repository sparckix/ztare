/--
TICK666 source-boundary refinement.  The indexed carrier is not strengthened
in-place; the remaining mathematical content is the proof-carrying numerical
schedule above.  This prevents a qualitative invoice or scalar spend from
being relabelled as a prefix-budget source.
-/
structure FreshAnnularChargeSeparatedSourceFromIndexedCarrier
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock) where
  extraction :
    FreshAnnularChargeExtractionFromC7Invoice
      (C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding
        hIndexed.sameTreeInvoiceEmbedding)
  extractionUsesAuditIndexedEventSchedule :
    extraction.eventScheduleEnumeratesInvoiceBadNodes
  extractionUsesAuditIndexedFreshRegions :
    extraction.freshChargeQuantifiesInvoiceRegions
  auditIndexFixedBeforeExtraction :
    ResidualFreshAuditIndexFixedBeforeSpendPartition
      hElig hGeom hPressure hDuhamel
  duhamelSectionIdentityUsedByExtraction :
    ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel
  spendPartitionIncludesDuhamelReserve :
    hIndexed.productionSpend + hIndexed.invoiceSpend +
      hIndexed.pressureReserveSpend + hIndexed.duhamelReserveSpend +
        hIndexed.inheritedReserveSpend ≤ hIndexed.totalBudget
  pressureReserveSeparatedFromParentInvoice :
    hIndexed.pressureReserveNotParentInvoice
  duhamelReserveSeparatedFromShellLedger :
    hIndexed.duhamelReserveNotShellProcessLedger
  inheritedReserveSeparatedFromParentInvoice :
    hIndexed.inheritedDescendantsDoNotMintParentInvoices
  noRepeatedDescendantChargeUsedByExtraction :
    hLock.noRepeatedDescendantCharging

/--
If the numerical fresh-annular schedule is supplied on the indexed carrier,
then the separated source demanded by the prefix-budget consumer is available.
The construction consumes the schedule; it does not derive that schedule from
the qualitative invoice fields.
-/
def FreshAnnularChargeSeparatedSourceFromIndexedCarrier.ofNumericalSchedule
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    (hSchedule :
      FreshAnnularNumericalScheduleFromIndexedCarrier hIndexed) :
    FreshAnnularChargeSeparatedSourceFromIndexedCarrier hIndexed where
  extraction := {
    activeTail := hSchedule.activeTail
    freshCharge := hSchedule.freshCharge
    c := hSchedule.c
    rootBudget := hSchedule.rootBudget
    c_pos := hSchedule.c_pos
    pointwiseFreshPayment := hSchedule.pointwiseFreshPayment
    freshChargePrefixBudget := hSchedule.freshChargePrefixBudget
    eventScheduleEnumeratesInvoiceBadNodes :=
      hSchedule.eventScheduleEnumeratesInvoiceBadNodes
    freshChargeQuantifiesInvoiceRegions :=
      hSchedule.freshChargeQuantifiesInvoiceRegions
    invoiceBudgetQuantifiedAsRootPrefixBudget :=
      hSchedule.finiteFreshInvoiceBudget_verified
    assignedBeforePayoff_fromInvoice :=
      hSchedule.invoiceAssignedBeforeSubtreeSelection_verified
    sameCarrier_fromInvoice :=
      hSchedule.invoiceUsesSameNormalizedExcessStoppingTree_verified
    nonRebilling_fromInvoice :=
      hSchedule.oneUseNoDescendantRebilling_verified
    notLocalDominationOnly_fromInvoice :=
      hSchedule.descendantInvoicesDisjointOrBoundedOverlap_verified
  }
  extractionUsesAuditIndexedEventSchedule :=
    hSchedule.eventScheduleEnumeratesInvoiceBadNodes_proof
  extractionUsesAuditIndexedFreshRegions :=
    hSchedule.freshChargeQuantifiesInvoiceRegions_proof
  auditIndexFixedBeforeExtraction :=
    hIndexed.auditIndexFixedBeforeSpendPartition
  duhamelSectionIdentityUsedByExtraction :=
    hSchedule.duhamelSectionIdentityReceiptForSchedule
  spendPartitionIncludesDuhamelReserve :=
    hSchedule.sourceProductionSpendPartitionReceipt
  pressureReserveSeparatedFromParentInvoice :=
    hSchedule.pressureReserveSeparatedFromParentInvoice_verified
  duhamelReserveSeparatedFromShellLedger :=
    hSchedule.duhamelReserveSeparatedFromShellLedger_verified
  inheritedReserveSeparatedFromParentInvoice :=
    hSchedule.inheritedReserveSeparatedFromParentInvoice_verified
  noRepeatedDescendantChargeUsedByExtraction :=
    hIndexed.noRepeatedDescendantCharging

