/--
Endpoint consumer for the same-carrier packing/no-reuse receipt.
-/
theorem activeTailPrefix_le_rootBudget_div_c_of_sameCarrierPackingNoReuseReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId) :
    ∀ N : Nat,
      NS.nsPrefixSum routeActiveTail N ≤
        hPack.rootBudget / hPack.c := by
  intro N
  have hpoint :
      NS.nsPrefixSum
          (fun n : Nat => hPack.c * routeActiveTail n) N ≤
        NS.nsPrefixSum hPack.freshCharge N :=
    NS.ns_prefix_sum_le_of_pointwise
      (fun n : Nat => hPack.c * routeActiveTail n)
      hPack.freshCharge
      hPack.pointwiseSameCarrierPayment N
  rw [nsPrefixSum_const_mul_left] at hpoint
  have hbudget :
      hPack.c * NS.nsPrefixSum routeActiveTail N ≤
        hPack.rootBudget := by
    exact le_trans hpoint (hPack.finitePrefixFreshCarrierBudget N)
  have hbudget' :
      NS.nsPrefixSum routeActiveTail N * hPack.c ≤
        hPack.rootBudget := by
    simpa [mul_comm] using hbudget
  exact (le_div_iff₀ hPack.c_pos).2 hbudget'

/--
C7 same-carrier packing supplies only a finite active-tail budget.

This is the graph/amnesia reattachment to the older finite-tail lane: the C7
packing receipt can feed `Route1FiniteActiveTailBudget`, but it does not by
itself control the route tail `Xtail`.  That second comparison remains the
separate `SameCarrierRouteTailActiveTailControlSource` obligation.
-/
noncomputable def Route1FiniteActiveTailBudget.ofC7SameCarrierPackingNoReuseReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId) :
    Route1FiniteActiveTailBudget Nat where
  activeTail := routeActiveTail
  budget := hPack.rootBudget / hPack.c
  budget_nonneg := by
    have hbudget0 := hPack.finitePrefixFreshCarrierBudget 0
    have hroot_nonneg : 0 ≤ hPack.rootBudget := by
      simpa [NS.nsPrefixSum] using hbudget0
    exact div_nonneg hroot_nonneg (le_of_lt hPack.c_pos)
  finiteActiveTailPrefixes :=
    activeTailPrefix_le_rootBudget_div_c_of_sameCarrierPackingNoReuseReceipt
      hPack
  sourcedByLineageReservoir :=
    hPack.matchedCapacityLivesOnSameResidualFreshCarrier
  rechargeAndCutoffErrorsIncluded :=
    hPack.finitePrefixMatchingSaturatesRouteDemand
  routedResidualsIncluded :=
    hPack.noDescendantCapacityReuse
  noPointwiseStrictSubratioClaim :=
    hPack.capacityNotScalarLedgerOnly

/--
C7 bridge into the older finite-tail amortized strictness adapter.

The constructor deliberately asks for the route-tail comparison as a separate
input.  A C7 packing/no-reuse receipt bounds active-tail prefixes; it does not
license substituting raw route tail mass for active-tail mass.

Use this only when the displayed `routeActiveTail` is already the carrier that
controls `Xtail`.  The more general route-1 pincer is
`Route1FiniteTailAmortizedStrictness.ofPincerSources`, where passive caloric
persistence, Duhamel recharge, cutoff residuals, and routed residuals enter an
active-or-passive lineage schedule.
-/
noncomputable def Route1FiniteTailAmortizedStrictness.ofC7PackingAndSameCarrierTailControl
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (tail : SameCarrierRouteTailActiveTailControlSource)
    (X S : Nat → Real)
    (rho delta : Real)
    (delta_pos : 0 < delta)
    (sameActiveTail : routeActiveTail = tail.activeTail)
    (prefixSourceBound :
      ∀ N : Nat,
        NS.nsPrefixSum S N ≤
          (rho - delta) * NS.nsPrefixSum X N +
            delta * NS.nsPrefixSum tail.Xtail N) :
    Route1FiniteTailAmortizedStrictness :=
  Route1FiniteTailAmortizedStrictness.ofSameCarrierTailControlSource
    (Route1FiniteActiveTailBudget.ofC7SameCarrierPackingNoReuseReceipt hPack)
    tail X S rho delta delta_pos (hPack.rootBudget / hPack.c)
    sameActiveTail rfl prefixSourceBound

/--
C7-specific positive nested-reuse packet.

This is the sharp adversary for the current lane: the same visible positive
packet keeps paying deeper selected route events, so the active-tail prefixes
eventually exceed any finite same-carrier budget.  A true packing/no-reuse
receipt cannot coexist with this packet.
-/
structure C7PositiveNestedReusePacketAgainstSameCarrierPacking
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock)
    {routeActiveTail : Nat → Real}
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail) where
  samePositivePacketPaysNestedSelectedEvents : Prop
  selectedEventsAreNestedDescendants : Prop
  sameCapacityPacketRebilledAcrossDescendants : Prop
  activeTailPrefixesExceedEveryFiniteBudget :
    ∀ B : Real, ∃ N : Nat, B < NS.nsPrefixSum routeActiveTail N
  noFreshAnnularInjectionAvailable : Prop
  noMonotoneReserveDropAvailable : Prop

/--
The positive nested-reuse packet is exactly what the same-carrier no-reuse
receipt must rule out.
-/
theorem no_sameCarrierPackingNoReuseReceipt_of_positiveNestedReusePacket
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPacket :
      C7PositiveNestedReusePacketAgainstSameCarrierPacking hIndexed hId) :
    C7SameCarrierPackingNoReuseReceipt hIndexed hId → False := by
  intro hPack
  rcases hPacket.activeTailPrefixesExceedEveryFiniteBudget
      (hPack.rootBudget / hPack.c) with
    ⟨N, hgt⟩
  have hle :=
    activeTailPrefix_le_rootBudget_div_c_of_sameCarrierPackingNoReuseReceipt
      hPack N
  linarith

/--
C7-specific sparse high-high ghost kill.

This is the non-rehash version of the high-high ghost obstruction: once the
selected C7 route tail is identified with the sparse high-high source-square
stream, any same-carrier packing/no-reuse receipt gives a finite active-tail
prefix budget, contradicting the ghost's divergent-prefix premise.
-/
theorem no_sameCarrierPackingNoReuseReceipt_of_sparseHighHighGhost
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hGhost : SparseHighHighCriticalSourceGhostPacket routeActiveTail) :
    C7SameCarrierPackingNoReuseReceipt hIndexed hId → False := by
  intro hPack
  rcases hGhost.sourceSquarePrefixesExceedEveryFiniteBudget
      (hPack.rootBudget / hPack.c) with
    ⟨N, hgt⟩
  have hle :=
    activeTailPrefix_le_rootBudget_div_c_of_sameCarrierPackingNoReuseReceipt
      hPack N
  exact not_lt_of_ge hle hgt

