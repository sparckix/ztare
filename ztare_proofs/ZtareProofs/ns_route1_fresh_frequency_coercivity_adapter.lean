    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (h : C7RouteActiveTailNonnegativeReceipt hId) :
    ∀ n : Nat, 0 ≤ routeActiveTail n :=
  h.routeActiveTail_nonnegative

/--
Pointwise selected-node radius nonnegativity receipt for the route-tail path.

The carrier now exposes `nodeRadiusPositiveOnSelected` as a pointwise numerical
field.  This receipt records the bridge from selected-node membership to the
event-node radius inequality consumed by route active-tail nonnegativity.
-/
structure C7SelectedEventNodeRadiusNonnegativeReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {routeActiveTail : Nat → Real}
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail) where
  selectedNodeRadius_nonnegative :
    ∀ Q : DyadicParabolicCube,
      Q ∈ hCarrier.selectedBadNodes → 0 ≤ hCarrier.nodeRadius Q
  selectedNodeRadius_nonnegative_eq_carrier :
    selectedNodeRadius_nonnegative = hCarrier.nodeRadiusPositiveOnSelected
  eventToBadNodeSelectionRespected : Prop
  eventToBadNodeSelectionRespected_proof :
    eventToBadNodeSelectionRespected
  propUpgradedToPointwiseSelectedRadius : Prop
  propUpgradedToPointwiseSelectedRadius_proof :
    propUpgradedToPointwiseSelectedRadius
  notOnlyNodeRadiusPositivePropName : Prop
  notOnlyNodeRadiusPositivePropName_proof :
    notOnlyNodeRadiusPositivePropName

/-- Selected-node radius nonnegativity gives event-node radius nonnegativity
through the cofinal selected-tree incidence receipt. -/
theorem C7SelectedEventNodeRadiusNonnegativeReceipt.eventNodeRadius_nonnegative
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (h : C7SelectedEventNodeRadiusNonnegativeReceipt hId) :
    ∀ n : Nat, 0 ≤ hCarrier.nodeRadius (hEvents.eventToBadNode n) := by
  intro n
  exact
    h.selectedNodeRadius_nonnegative (hEvents.eventToBadNode n)
      (hId.cofinalSelectedTreeIncidence.eventToBadNode_mem_selected n)

/-- Build the selected-node radius receipt from the carrier's pointwise radius
field. -/
def C7SelectedEventNodeRadiusNonnegativeReceipt.ofCarrierNodeRadiusPositiveOnSelected
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {routeActiveTail : Nat → Real}
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail) :
    C7SelectedEventNodeRadiusNonnegativeReceipt hId where
  selectedNodeRadius_nonnegative := hCarrier.nodeRadiusPositiveOnSelected
  selectedNodeRadius_nonnegative_eq_carrier := rfl
  eventToBadNodeSelectionRespected := True
  eventToBadNodeSelectionRespected_proof := True.intro
  propUpgradedToPointwiseSelectedRadius := True
  propUpgradedToPointwiseSelectedRadius_proof := True.intro
  notOnlyNodeRadiusPositivePropName := True
