/--
Route-tail nonnegativity from pointwise event-node radius nonnegativity.

The beta factor appears squared, so no separate beta sign proof is needed for
the numerical inequality; the remaining numeric input is that selected event
node radii are nonnegative.
-/
def C7RouteActiveTailNonnegativeReceipt.ofPointwiseEventNodeRadiusNonnegative
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {routeActiveTail : Nat → Real}
    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail)
    (eventNodeRadius_nonnegative :
      ∀ n : Nat, 0 ≤ hCarrier.nodeRadius (hEvents.eventToBadNode n))
    (nodeRadiusNonnegativeOnSelectedEvents : Prop)
    (nodeRadiusNonnegativeOnSelectedEvents_proof :
      nodeRadiusNonnegativeOnSelectedEvents)
    (eventToBadNodeSelectionRespected : Prop)
    (eventToBadNodeSelectionRespected_proof :
      eventToBadNodeSelectionRespected)
    (notOnlyBetaNonnegativeProp : Prop) :
    C7RouteActiveTailNonnegativeReceipt hId where
  routeActiveTail_nonnegative := by
    intro n
    have hroute :=
      congrArg (fun f : Nat → Real => f n)
        hId.activeTail_eq_eventBetaSquare
    change 0 ≤ (fun f : Nat → Real => f n) routeActiveTail
    rw [hroute]
    dsimp [badCenterBetaSquareEventActiveTail]
    exact
      mul_nonneg (eventNodeRadius_nonnegative n)
        (sq_nonneg (hBeta.betaNumber (hEvents.eventToBadNode n)))
  betaSquareNumericalNonnegative := True
  betaSquareNumericalNonnegative_proof := True.intro
  nodeRadiusNonnegativeOnSelectedEvents :=
    nodeRadiusNonnegativeOnSelectedEvents
  nodeRadiusNonnegativeOnSelectedEvents_proof :=
    nodeRadiusNonnegativeOnSelectedEvents_proof
  eventToBadNodeSelectionRespected := eventToBadNodeSelectionRespected
  eventToBadNodeSelectionRespected_proof :=
    eventToBadNodeSelectionRespected_proof
  notOnlyBetaNonnegativeProp := notOnlyBetaNonnegativeProp

