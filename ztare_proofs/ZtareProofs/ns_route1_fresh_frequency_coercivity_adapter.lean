/--
Finite-dimensional concentration warning for the quadratic-reserve escape.

A fixed quadratic reserve does not bound an above-threshold cubic production
quantity under concentration.  The toy spike has amplitude `A = B + 1` on mass
`A^-2`: its quadratic reserve is exactly one, while its cubic production is
`A`, hence larger than any prescribed nonnegative `B`.
-/
theorem quadraticReserve_does_not_bound_cubicPositiveSpike :
    ∀ B : ℝ, 0 ≤ B →
      ∃ amplitude supportMass : ℝ,
        0 < amplitude ∧
        0 < supportMass ∧
        amplitude ^ (2 : Nat) * supportMass = 1 ∧
        B < amplitude ^ (3 : Nat) * supportMass := by
  intro B hB
  let A : ℝ := B + 1
  have hApos : 0 < A := by
    dsimp [A]
    linarith
  have hAne : A ≠ 0 := ne_of_gt hApos
  refine ⟨A, (A ^ (2 : Nat))⁻¹, hApos, ?_, ?_, ?_⟩
  · exact inv_pos.mpr (pow_pos hApos 2)
  · field_simp [hAne]
  · have hcubic : A ^ (3 : Nat) * (A ^ (2 : Nat))⁻¹ = A := by
      field_simp [hAne]
    rw [hcubic]
    dsimp [A]
    linarith

/--
The same concentration model already destroys the endpoint weak-`L^{5/2}`
tail quantity.  To avoid importing real powers, this theorem squares the
endpoint tail expression: `(A^(5/2) m)^2 = A^5 m^2`.  With quadratic reserve
`A^2 m = 1`, the squared endpoint tail equals `A`, so it is unbounded.
-/
theorem quadraticReserve_does_not_bound_fiveHalvesTailSquare :
    ∀ B : ℝ, 0 ≤ B →
      ∃ amplitude supportMass : ℝ,
        0 < amplitude ∧
        0 < supportMass ∧
        amplitude ^ (2 : Nat) * supportMass = 1 ∧
        B < amplitude ^ (5 : Nat) * supportMass ^ (2 : Nat) := by
  intro B hB
  let A : ℝ := B + 1
  have hApos : 0 < A := by
    dsimp [A]
    linarith
  have hAne : A ≠ 0 := ne_of_gt hApos
  refine ⟨A, (A ^ (2 : Nat))⁻¹, hApos, ?_, ?_, ?_⟩
  · exact inv_pos.mpr (pow_pos hApos 2)
  · field_simp [hAne]
  · have htail :
        A ^ (5 : Nat) * ((A ^ (2 : Nat))⁻¹) ^ (2 : Nat) = A := by
      field_simp [hAne]
    rw [htail]
    dsimp [A]
    linarith

/--
Signed-average cancellation does not bound the positive production tail.

This is the finite-dimensional warning for importing anti-twist/CAV data into
the Duhamel positive-part branch.  A spike can have unit positive quadratic
reserve and arbitrarily large cubic positive production, while a small negative
background exactly cancels its signed average.  Thus sign reversal or
conditional-average control is not enough without a local distribution/tail
estimate for the positive part.
-/
theorem signedAverageCancellation_does_not_bound_positiveCubicSpike :
    ∀ B : ℝ, 0 ≤ B →
      ∃ amplitude positiveMass negativeMass : ℝ,
        0 < amplitude ∧
        0 < positiveMass ∧
        0 < negativeMass ∧
        amplitude * positiveMass - negativeMass = 0 ∧
        amplitude ^ (2 : Nat) * positiveMass = 1 ∧
        B < amplitude ^ (3 : Nat) * positiveMass := by
  intro B hB
  let A : ℝ := B + 1
  have hApos : 0 < A := by
    dsimp [A]
    linarith
  have hAne : A ≠ 0 := ne_of_gt hApos
  let m : ℝ := (A ^ (2 : Nat))⁻¹
  have hmpos : 0 < m := by
    dsimp [m]
    exact inv_pos.mpr (pow_pos hApos 2)
  refine ⟨A, m, A * m, hApos, hmpos, mul_pos hApos hmpos, ?_, ?_, ?_⟩
  · ring
  · dsimp [m]
    field_simp [hAne]
  · have hcubic : A ^ (3 : Nat) * m = A := by
      dsimp [m]
      field_simp [hAne]
    rw [hcubic]
    dsimp [A]
    linarith

/--
Signed-average cancellation also does not control the endpoint weak-`L^{5/2}`
tail square of the positive part.  The negative background cancels the signed
average but does not reduce the positive packet's endpoint tail.
-/
theorem signedAverageCancellation_does_not_bound_fiveHalvesTailSquare :
    ∀ B : ℝ, 0 ≤ B →
      ∃ amplitude positiveMass negativeMass : ℝ,
        0 < amplitude ∧
        0 < positiveMass ∧
        0 < negativeMass ∧
        amplitude * positiveMass - negativeMass = 0 ∧
        amplitude ^ (2 : Nat) * positiveMass = 1 ∧
        B < amplitude ^ (5 : Nat) * positiveMass ^ (2 : Nat) := by
  intro B hB
  let A : ℝ := B + 1
  have hApos : 0 < A := by
    dsimp [A]
    linarith
  have hAne : A ≠ 0 := ne_of_gt hApos
  let m : ℝ := (A ^ (2 : Nat))⁻¹
  have hmpos : 0 < m := by
    dsimp [m]
    exact inv_pos.mpr (pow_pos hApos 2)
  refine ⟨A, m, A * m, hApos, hmpos, mul_pos hApos hmpos, ?_, ?_, ?_⟩
  · ring
  · dsimp [m]
    field_simp [hAne]
  · have htail : A ^ (5 : Nat) * m ^ (2 : Nat) = A := by
      dsimp [m]
      field_simp [hAne]
    rw [htail]
    dsimp [A]
    linarith

/--
Boundary for the quadratic-reserve escape.

An unsigned `|source|^2`-style reserve can be fixed before payoff, but it only
books Duhamel reserve cost unless it also supplies the positive-part production
bridge and the same-tree invoice embedding.
