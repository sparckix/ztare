import ZtareProofs.ns_pressure_hessian_l2_bridge
import ZtareProofs.ns_l2_carrier_transport
import ZtareProofs.ns_route1_constructive_frontier
import ZtareProofs.ns_L3_multiscale_YM_rescaled_increments

namespace ZtareProofs

open NSL3MultiscaleYM

/-!
`ns_route1_fresh_frequency_coercivity_adapter` connects the route-1
local-quadratic coercivity fork to the older fresh-frequency/event-tent
primitive stack.

The point is deliberately modest: the adapter exposes the existing L3 objects
that should instantiate the new `tailSquareFunction` and `frequencyLeakage`
fields.  It does not turn pressure-smallness into a quadratic lower bound, and
it does not hide strict subratio input inside the adapter.
-/

namespace Route1FreshFrequencyCoercivity

/--
Lower anti-smuggling object for shard A.

`X_tail = tailSquareFunction` is not an input here.  The two quantities are
fixed separately, then identified through a common event-tent carrier and a
common fresh-frequency square budget.
-/
structure FreshFrequencyTailSquareFixedCarrierIdentity
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  routeTailCarrier : Set (EuclideanSpace ℝ (Fin 4))
  freshFrequencyCarrier : Set (EuclideanSpace ℝ (Fin 4))
  X_tail : Real
  tailSquareFunction : Real
  routeTailMass : Real
  freshFrequencySquareBudget : Real
  tailSquareFunction_nonneg : 0 ≤ tailSquareFunction
  eventTentGeometry :
    LerayHeatFreshFrequencyEventTentGeometry
      seq K hRho hCarrier hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  routeTailMassFixedBeforeSquareBudget : Prop
  freshSquareBudgetFixedBeforeTailMass : Prop
  carriers_equal :
    routeTailCarrier = freshFrequencyCarrier
  X_tail_eq_routeTailMass :
    X_tail = routeTailMass
  tailSquareFunction_eq_freshFrequencySquareBudget :
    tailSquareFunction = freshFrequencySquareBudget
  routeTailMass_eq_freshFrequencySquareBudget_on_same_carrier :
    routeTailMass = freshFrequencySquareBudget
  no_strictness_used_for_tail_identification : Prop

/-- Fixed common-carrier identity proves the route tail/square-function equality. -/
theorem tail_eq_square_function_of_fixed_carrier_identity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyTailSquareFixedCarrierIdentity
        seq K hRho hCarrier hBeta hEvents L) :
    h.X_tail = h.tailSquareFunction := by
  rw [h.X_tail_eq_routeTailMass,
    h.routeTailMass_eq_freshFrequencySquareBudget_on_same_carrier,
    ← h.tailSquareFunction_eq_freshFrequencySquareBudget]

/-- Shard 1: identify the unresolved route tail with a fresh-frequency square
function on the selected event tents. -/
structure FreshFrequencyTailSquareIdentification
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  X_tail : Real
  tailSquareFunction : Real
  tailSquareFunction_nonneg : 0 ≤ tailSquareFunction
  eventTentGeometry :
    LerayHeatFreshFrequencyEventTentGeometry
      seq K hRho hCarrier hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  tailWindowFamily : Prop
  tail_eq_square_function :
    X_tail = tailSquareFunction
  tailSquareFunctionIsFreshFrequencySquareBudget : Prop
  no_strictness_used_for_tail_identification : Prop

/-- Build shard A from the lower fixed-carrier identity. -/
def FreshFrequencyTailSquareIdentification.ofFixedCarrierIdentity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyTailSquareFixedCarrierIdentity
        seq K hRho hCarrier hBeta hEvents L)
    (tailWindowFamily : Prop)
    (tailSquareFunctionIsFreshFrequencySquareBudget : Prop) :
    FreshFrequencyTailSquareIdentification
      seq K hRho hCarrier hBeta hEvents L where
  X_tail := h.X_tail
  tailSquareFunction := h.tailSquareFunction
  tailSquareFunction_nonneg := h.tailSquareFunction_nonneg
  eventTentGeometry := h.eventTentGeometry
  squareBudgetPaysRadiusBeta := h.squareBudgetPaysRadiusBeta
  tailWindowFamily := tailWindowFamily
  tail_eq_square_function :=
    tail_eq_square_function_of_fixed_carrier_identity h
  tailSquareFunctionIsFreshFrequencySquareBudget :=
    tailSquareFunctionIsFreshFrequencySquareBudget
  no_strictness_used_for_tail_identification :=
    h.no_strictness_used_for_tail_identification

/--
Lower anti-smuggling object for shard B.

The Poincare/CKN estimate is split into a resolved mean-free tent square
function plus leakage.  The resolved part is then compared to the CKN local
quadratic tent excess.  This keeps the leakage term out of the CKN excess
definition and prevents the local excess from being chosen after seeing the
route-tail budget.
-/
structure FreshFrequencyMeanFreeTentPoincareCertificate where
  tailSquareFunction : Real
  resolvedMeanFreeTentSquare : Real
  localQuadraticTentExcess : Real
  frequencyLeakage : Real
  C_Q : Real
  frequencyLeakage_nonneg : 0 ≤ frequencyLeakage
  boundedOverlap : Prop
  frequencyLocalizedMeanFreeTail : Prop
  localQuadraticTentExcess_defined_by_cknIntegral : Prop
  localQuadraticTentExcessIsCKNBadWindowExcess : Prop
  meanFreeGalileanNormalizationBeforePoincare : Prop
  resolvedSquareUsesSameTentFamily : Prop
  cknExcessFixedBeforeTailBudget : Prop
  leakageIsUnresolvedFrequencyRemainder : Prop
  squareFunction_split :
    tailSquareFunction ≤ resolvedMeanFreeTentSquare + frequencyLeakage
  resolvedMeanFreeTentSquare_bound :
    resolvedMeanFreeTentSquare ≤ C_Q * localQuadraticTentExcess
  no_tail_budget_or_strictness_used_to_define_ckn_excess : Prop

/-- Mean-free tent Poincare split proves the shard-B estimate. -/
theorem frequencyLocalizedTentPoincare_of_meanFreeTentPoincareCertificate
    (h : FreshFrequencyMeanFreeTentPoincareCertificate) :
    h.tailSquareFunction ≤
      h.C_Q * h.localQuadraticTentExcess + h.frequencyLeakage := by
  nlinarith [h.squareFunction_split, h.resolvedMeanFreeTentSquare_bound]

/--
Build shard-B's lower Poincare certificate from existing event-tent, fanout,
square-budget, and normalized CKN-excess data, leaving only the two numerical
Poincare inequalities as explicit inputs.
-/
def FreshFrequencyMeanFreeTentPoincareCertificate.ofEventTentCKNData
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hFanout :
      FreshFrequencyBoundedFanoutNoLogReuse
        seq K hRho hCarrier hBeta hEvents L)
    (hSquare :
      FreshFrequencySquareBudgetPaysRadiusBeta
        seq K hRho hCarrier hBeta hEvents L)
    (tailSquareFunction resolvedMeanFreeTentSquare
      localQuadraticTentExcess frequencyLeakage C_Q : Real)
    (frequencyLeakage_nonneg : 0 ≤ frequencyLeakage)
    (squareFunction_split :
      tailSquareFunction ≤ resolvedMeanFreeTentSquare + frequencyLeakage)
    (resolvedMeanFreeTentSquare_bound :
      resolvedMeanFreeTentSquare ≤ C_Q * localQuadraticTentExcess)
    (leakageIsUnresolvedFrequencyRemainder : Prop) :
    FreshFrequencyMeanFreeTentPoincareCertificate where
  tailSquareFunction := tailSquareFunction
  resolvedMeanFreeTentSquare := resolvedMeanFreeTentSquare
  localQuadraticTentExcess := localQuadraticTentExcess
  frequencyLeakage := frequencyLeakage
  C_Q := C_Q
  frequencyLeakage_nonneg := frequencyLeakage_nonneg
  boundedOverlap :=
    And hFanout.comparableScaleTentOverlapBounded
      hFanout.noSameScaleLogarithmicMultiplicityPerEvent
  frequencyLocalizedMeanFreeTail :=
    And hGeom.sameFrequencyWindowForPressureAndDuhamel
      hSquare.localizedEnstrophyDuhamelSquarePaysEventPrice
  localQuadraticTentExcess_defined_by_cknIntegral :=
    hRho.rhoFromNormalizedExcess
  localQuadraticTentExcessIsCKNBadWindowExcess :=
    hRho.cknExcessData.galileanInvariantVelocityExcess
  meanFreeGalileanNormalizationBeforePoincare :=
    And hRho.cknExcessData.driftPressureNormalization.galileanDriftRemoved
      hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed
  resolvedSquareUsesSameTentFamily :=
    And hGeom.eventTentUsesCarrierCenterAndRadius
      hGeom.constructedBeforeRadiusAccounting
  cknExcessFixedBeforeTailBudget := hRho.sameCylinderNormalization
  leakageIsUnresolvedFrequencyRemainder := leakageIsUnresolvedFrequencyRemainder
  squareFunction_split := squareFunction_split
  resolvedMeanFreeTentSquare_bound := resolvedMeanFreeTentSquare_bound
  no_tail_budget_or_strictness_used_to_define_ckn_excess :=
    hSquare.doesNotFollowFromNormalizedCKNMassAlone

/--
Lower source for the first numeric shard-B field.

The square-function split is paid by an exact resolved-plus-leakage carrier
identity fixed before the CKN/tent-excess comparison.  This keeps
`squareFunction_split` from being another free inequality at the Poincare
certificate layer.
-/
structure FreshFrequencyMeanFreeTentSquareSplitIdentity
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  eventTentGeometry :
    LerayHeatFreshFrequencyEventTentGeometry seq K hRho hCarrier hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  residualOrInherited :
    BadNodeResidualOrInheritedDichotomy seq K hRho
  inheritedSkeleton :
    InheritedBadTreeCoronaNoNeckSkeleton seq K hRho
  tailSquareFunction : Real
  resolvedMeanFreeTentSquare : Real
  frequencyLeakage : Real
  frequencyLeakage_nonneg : 0 ≤ frequencyLeakage
  resolvedSquareFromFreshRegion : Prop
  leakageFromInheritedOrBoundaryRemainder : Prop
  selectedTentsUseSameFreshRegion :
    residualOrInherited.freshRegion = residualFreshExcess.freshRegion
  inheritedBranchChargedBySkeleton :
    residualOrInherited.inheritedGivesNoLogPileupOrSkeletonCharge
  splitFixedBeforeCknExcessBound : Prop
  noTailBudgetOrStrictnessInSplit : Prop
  tailSquareFunction_eq_resolved_plus_leakage :
    tailSquareFunction = resolvedMeanFreeTentSquare + frequencyLeakage

/-- The exact carrier split pays shard-B's first numeric inequality. -/
theorem squareFunction_split_of_meanFreeTentSquareSplitIdentity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      FreshFrequencyMeanFreeTentSquareSplitIdentity
        seq K hRho hCarrier hBeta hEvents L) :
    h.tailSquareFunction ≤
      h.resolvedMeanFreeTentSquare + h.frequencyLeakage := by
  rw [h.tailSquareFunction_eq_resolved_plus_leakage]

/--
The remaining shard-B estimate after the square split has been paid.

This is the actual mean-free Poincare/CKN comparison station: bound the
resolved fresh-region square by the CKN local quadratic tent excess on the same
event-tent carrier.
-/
structure FreshFrequencyResolvedMeanFreeTentSquareEstimate
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K)
    (hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho)
    (hBeta : BadCenterParabolicBetaData seq K hRho hCarrier)
    (hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier)
    (L : NS.EventRecurrencePriceLedger) where
  cknScaleSplit : CKNExcessRegularityScaleSplitWitness seq K
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  tailSquareFunction : Real
  resolvedMeanFreeTentSquare : Real
  localQuadraticTentExcess : Real
  C_Q : Real
  resolvedMeanFreeTentSquare_bound :
    resolvedMeanFreeTentSquare ≤ C_Q * localQuadraticTentExcess
  cknSplitUsesSameRhoCarrier : Prop
  resolvedSquareUsesResidualFreshRegion :
    residualFreshExcess.freshPoincareGeometry
  meanFreeProjectionUsesGalileanGauge : Prop
  noTailBudgetOrStrictnessInResolvedBound : Prop

/--
Lower source for shard-B's remaining resolved mean-free square estimate.

This splits the estimate into two sub-estimates: fresh Poincare/energy controls
the resolved mean-free square, then the same CKN-excess/local-smallness bridge
controls that fresh energy by the local quadratic tent excess.
-/
structure FreshFrequencyResolvedMeanFreeTentSquareBoundDecomposition
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  cknScaleSplit : CKNExcessRegularityScaleSplitWitness seq K
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  tailSquareFunction : Real
  resolvedMeanFreeTentSquare : Real
  freshEnergy : Real
  localQuadraticTentExcess : Real
  C_energy : Real
  C_ckn : Real
  C_Q : Real
  C_energy_nonneg : 0 ≤ C_energy
  resolvedSquare_le_freshEnergy :
    resolvedMeanFreeTentSquare ≤ C_energy * freshEnergy
  freshEnergy_le_cknExcess :
    freshEnergy ≤ C_ckn * localQuadraticTentExcess
  C_Q_eq : C_Q = C_energy * C_ckn
  cknSplitUsesSameRhoCarrier : Prop
  freshEnergyIsScaleInvariant :
    residualFreshExcess.scaleInvariantFreshEnergy
  resolvedSquareUsesFreshPoincareGeometry :
    residualFreshExcess.freshPoincareGeometry
  pressureLocalizedBeforeCKNComparison :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  localSmallnessBridgeUsesCKNExcess :
    cknScaleSplit.localSmallnessBridge.cknExcess =
      hRho.cknExcessData.toExcess
  meanFreeProjectionUsesGalileanGauge : Prop
  noTailBudgetOrStrictnessInResolvedBound : Prop

/--
Lower source for the fresh-Poincare half of the resolved-bound decomposition.

This pays `resolvedSquare_le_freshEnergy` from a mean-free Poincare inequality
and a fresh-gradient/fresh-energy comparison, keeping the CKN-excess comparison
separate.
-/
structure FreshFrequencyFreshPoincareEnergyEstimate
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  resolvedMeanFreeTentSquare : Real
  meanFreeGradientEnergy : Real
  freshEnergy : Real
  C_poincare : Real
  C_gradient : Real
  C_energy : Real
  C_poincare_nonneg : 0 ≤ C_poincare
  C_gradient_nonneg : 0 ≤ C_gradient
  resolvedSquare_le_gradientEnergy :
    resolvedMeanFreeTentSquare ≤ C_poincare * meanFreeGradientEnergy
  gradientEnergy_le_freshEnergy :
    meanFreeGradientEnergy ≤ C_gradient * freshEnergy
  C_energy_eq : C_energy = C_poincare * C_gradient
  freshPoincareGeometry :
    residualFreshExcess.freshPoincareGeometry
  scaleInvariantFreshEnergy :
    residualFreshExcess.scaleInvariantFreshEnergy
  meanFreeProjectionUsesGalileanGauge : Prop
  noTailBudgetOrStrictnessInFreshPoincare : Prop

/-- Mean-free Poincare plus fresh-energy comparison pays the first sub-estimate. -/
theorem resolvedSquare_le_freshEnergy_of_freshPoincareEnergyEstimate
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyFreshPoincareEnergyEstimate seq K hRho) :
    h.resolvedMeanFreeTentSquare ≤ h.C_energy * h.freshEnergy := by
  have hgrad :
      h.C_poincare * h.meanFreeGradientEnergy ≤
        h.C_poincare * (h.C_gradient * h.freshEnergy) :=
    mul_le_mul_of_nonneg_left h.gradientEnergy_le_freshEnergy
      h.C_poincare_nonneg
  have hcoeff :
      h.C_poincare * (h.C_gradient * h.freshEnergy) =
        h.C_energy * h.freshEnergy := by
    rw [h.C_energy_eq]
    ring
  nlinarith [h.resolvedSquare_le_gradientEnergy, hgrad, hcoeff]

/-- Lower source for the fresh-energy to CKN-excess comparison half. -/
structure FreshFrequencyFreshEnergyCKNExcessComparison
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  cknScaleSplit : CKNExcessRegularityScaleSplitWitness seq K
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  freshEnergy : Real
  localQuadraticTentExcess : Real
  C_ckn : Real
  freshEnergy_le_cknExcess :
    freshEnergy ≤ C_ckn * localQuadraticTentExcess
  cknSplitUsesSameRhoCarrier : Prop
  pressureLocalizedBeforeCKNComparison :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  localSmallnessBridgeUsesCKNExcess :
    cknScaleSplit.localSmallnessBridge.cknExcess =
      hRho.cknExcessData.toExcess
  noTailBudgetOrStrictnessInCKNComparison : Prop

/--
Lower source for the CKN-excess comparison half.

Fresh energy is first controlled by Galilean velocity and pressure excesses;
those excesses are then booked into the local quadratic tent excess.  This is
still a PDE estimate surface, but it removes the ambiguous phrase "CKN
comparison" from the active obligation.
-/
structure FreshFrequencyFreshEnergyCKNExcessComparisonData
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  cknScaleSplit : CKNExcessRegularityScaleSplitWitness seq K
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  freshEnergy : Real
  galileanVelocityExcess : Real
  localizedPressureExcess : Real
  localQuadraticTentExcess : Real
  C_velocity : Real
  C_pressure : Real
  C_ckn : Real
  C_velocity_nonneg : 0 ≤ C_velocity
  C_pressure_nonneg : 0 ≤ C_pressure
  freshEnergy_le_velocity_pressure_excess :
    freshEnergy ≤
      C_velocity * galileanVelocityExcess +
        C_pressure * localizedPressureExcess
  velocityExcess_le_localQuadratic :
    galileanVelocityExcess ≤ localQuadraticTentExcess
  pressureExcess_le_localQuadratic :
    localizedPressureExcess ≤ localQuadraticTentExcess
  C_ckn_eq : C_ckn = C_velocity + C_pressure
  cknSplitUsesSameRhoCarrier : Prop
  velocityExcessUsesGalileanGauge :
    hRho.cknExcessData.galileanInvariantVelocityExcess
  pressureExcessUsesFixedGauge :
    hRho.cknExcessData.pressureGaugeFixedExcess
  pressureLocalizedBeforeCKNComparison :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  localSmallnessBridgeUsesCKNExcess :
    cknScaleSplit.localSmallnessBridge.cknExcess =
      hRho.cknExcessData.toExcess
  noTailBudgetOrStrictnessInCKNComparison : Prop

/--
Velocity/pressure CKN-excess booking pays the fresh-energy comparison.
-/
theorem freshEnergy_le_cknExcess_of_comparisonData
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyFreshEnergyCKNExcessComparisonData seq K hRho) :
    h.freshEnergy ≤ h.C_ckn * h.localQuadraticTentExcess := by
  have hv :
      h.C_velocity * h.galileanVelocityExcess ≤
        h.C_velocity * h.localQuadraticTentExcess :=
    mul_le_mul_of_nonneg_left h.velocityExcess_le_localQuadratic
      h.C_velocity_nonneg
  have hp :
      h.C_pressure * h.localizedPressureExcess ≤
        h.C_pressure * h.localQuadraticTentExcess :=
    mul_le_mul_of_nonneg_left h.pressureExcess_le_localQuadratic
      h.C_pressure_nonneg
  have hcoeff :
      h.C_velocity * h.localQuadraticTentExcess +
          h.C_pressure * h.localQuadraticTentExcess =
        h.C_ckn * h.localQuadraticTentExcess := by
    rw [h.C_ckn_eq]
    ring
  nlinarith [h.freshEnergy_le_velocity_pressure_excess, hv, hp, hcoeff]

/-- Build the CKN-excess comparison from its lower velocity/pressure booking. -/
def FreshFrequencyFreshEnergyCKNExcessComparison.ofComparisonData
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h :
      FreshFrequencyFreshEnergyCKNExcessComparisonData seq K hRho) :
    FreshFrequencyFreshEnergyCKNExcessComparison seq K hRho where
  cknScaleSplit := h.cknScaleSplit
  residualFreshExcess := h.residualFreshExcess
  freshEnergy := h.freshEnergy
  localQuadraticTentExcess := h.localQuadraticTentExcess
  C_ckn := h.C_ckn
  freshEnergy_le_cknExcess :=
    freshEnergy_le_cknExcess_of_comparisonData h
  cknSplitUsesSameRhoCarrier := h.cknSplitUsesSameRhoCarrier
  pressureLocalizedBeforeCKNComparison :=
    h.pressureLocalizedBeforeCKNComparison
  localSmallnessBridgeUsesCKNExcess :=
    h.localSmallnessBridgeUsesCKNExcess
  noTailBudgetOrStrictnessInCKNComparison :=
    h.noTailBudgetOrStrictnessInCKNComparison

/--
Pressure-excess side of the fresh CKN comparison.

This is intentionally only the pressure part: localized pressure excess is
controlled by independently named pressure receipts, and those receipts are
booked into the same local quadratic tent excess used by the fresh CKN split.
-/
structure FreshFrequencyLocalizedPressureExcessControl
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  pressureObligation : Route1PressureReserveNoEscapeObligation
  localizedPressureExcess : Real
  localQuadraticTentExcess : Real
  pressureExcess_le_receiptSum :
    localizedPressureExcess ≤
      (route1PressureVisibilityReceipts pressureObligation).receiptSum
  receiptSum_le_localQuadratic :
    (route1PressureVisibilityReceipts pressureObligation).receiptSum ≤
      localQuadraticTentExcess
  pressureGaugeMatchesCKNExcess :
    hRho.cknExcessData.pressureGaugeFixedExcess
  localQuadraticReceiptMatchesTentExcess :
    (route1PressureVisibilityReceipts pressureObligation).localQuadraticReceipt ≤
      localQuadraticTentExcess
  pressureReserveNotHiddenInTailBudget : Prop
  noStrictSourceBudgetUsedInPressureExcessControl : Prop

/-- Pressure receipts pay the localized pressure-excess control field. -/
theorem pressureExcess_le_localQuadratic_of_pressureControl
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyLocalizedPressureExcessControl seq K hRho) :
    h.localizedPressureExcess ≤ h.localQuadraticTentExcess := by
  exact le_trans h.pressureExcess_le_receiptSum h.receiptSum_le_localQuadratic

/--
Lower pressure control tied to the explicit CKN pressure-excess bound.

This mirrors the velocity side: localized pressure excess first maps to
`pressureExcessBound`, and that bound is paid by the pressure-receipt sum.
-/
structure FreshFrequencyCKNPressureBoundReceiptControl
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  pressureObligation : Route1PressureReserveNoEscapeObligation
  localizedPressureExcess : Real
  localQuadraticTentExcess : Real
  localizedPressureExcess_le_cknDataBound :
    localizedPressureExcess ≤ hRho.cknExcessData.pressureExcessBound
  cknDataBound_le_receiptSum :
    hRho.cknExcessData.pressureExcessBound ≤
      (route1PressureVisibilityReceipts pressureObligation).receiptSum
  receiptSum_le_localQuadratic :
    (route1PressureVisibilityReceipts pressureObligation).receiptSum ≤
      localQuadraticTentExcess
  pressureGaugeMatchesCKNExcess :
    hRho.cknExcessData.pressureGaugeFixedExcess
  localQuadraticReceiptMatchesTentExcess :
    (route1PressureVisibilityReceipts pressureObligation).localQuadraticReceipt ≤
      localQuadraticTentExcess
  pressureBoundUsesSameScaleRadius : Prop
  pressureReserveNotHiddenInTailBudget : Prop
  noStrictSourceBudgetUsedInPressureBoundControl : Prop

/-- CKN pressure-bound receipt control pays localized pressure excess. -/
theorem pressureExcess_le_receiptSum_of_cknPressureBoundControl
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyCKNPressureBoundReceiptControl seq K hRho) :
    h.localizedPressureExcess ≤
      (route1PressureVisibilityReceipts h.pressureObligation).receiptSum := by
  exact le_trans h.localizedPressureExcess_le_cknDataBound
    h.cknDataBound_le_receiptSum

/-- Build pressure-excess control from the explicit CKN pressure bound. -/
def FreshFrequencyLocalizedPressureExcessControl.ofCKNPressureBound
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyCKNPressureBoundReceiptControl seq K hRho) :
    FreshFrequencyLocalizedPressureExcessControl seq K hRho where
  pressureObligation := h.pressureObligation
  localizedPressureExcess := h.localizedPressureExcess
  localQuadraticTentExcess := h.localQuadraticTentExcess
  pressureExcess_le_receiptSum :=
    pressureExcess_le_receiptSum_of_cknPressureBoundControl h
  receiptSum_le_localQuadratic := h.receiptSum_le_localQuadratic
  pressureGaugeMatchesCKNExcess := h.pressureGaugeMatchesCKNExcess
  localQuadraticReceiptMatchesTentExcess :=
    h.localQuadraticReceiptMatchesTentExcess
  pressureReserveNotHiddenInTailBudget :=
    h.pressureReserveNotHiddenInTailBudget
  noStrictSourceBudgetUsedInPressureExcessControl :=
    h.noStrictSourceBudgetUsedInPressureBoundControl

/--
Velocity-excess side of the fresh CKN comparison.

The numeric Galilean velocity excess is tied to the explicit
`GalileanInvariantCKNExcessData.velocityExcessBound`, then booked into the
same local quadratic tent excess.  This keeps the velocity side independent of
the pressure receipts while sharing the CKN scale and gauge data.
-/
structure FreshFrequencyGalileanVelocityExcessControl
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  galileanVelocityExcess : Real
  localQuadraticTentExcess : Real
  velocityExcess_le_cknDataBound :
    galileanVelocityExcess ≤ hRho.cknExcessData.velocityExcessBound
  cknDataBound_le_localQuadratic :
    hRho.cknExcessData.velocityExcessBound ≤ localQuadraticTentExcess
  galileanGaugeMatchesCKNExcess :
    hRho.cknExcessData.galileanInvariantVelocityExcess
  driftPressureGaugeFixed :
    hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed
  velocityBoundUsesSameScaleRadius : Prop
  localQuadraticTentExcessIsCKNBadWindowExcess : Prop
  noPressureReceiptUsedInVelocityControl : Prop
  noStrictSourceBudgetUsedInVelocityControl : Prop

/-- Galilean velocity excess is paid by the local quadratic tent excess. -/
theorem velocityExcess_le_localQuadratic_of_velocityControl
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyGalileanVelocityExcessControl seq K hRho) :
    h.galileanVelocityExcess ≤ h.localQuadraticTentExcess := by
  exact le_trans h.velocityExcess_le_cknDataBound
    h.cknDataBound_le_localQuadratic

/--
Fresh-energy split stated against the explicit CKN-data bounds.

This is now the main analytic station below shard B: fresh energy must be paid
by the Galilean velocity and pressure excess bounds already exposed by
`GalileanInvariantCKNExcessData`.
-/
structure FreshFrequencyFreshEnergyCKNDataBoundSplit
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  freshEnergy : Real
  C_velocity : Real
  C_pressure : Real
  freshEnergy_le_cknDataBounds :
    freshEnergy ≤
      C_velocity * hRho.cknExcessData.velocityExcessBound +
        C_pressure * hRho.cknExcessData.pressureExcessBound
  scaleInvariantFreshEnergy :
    residualFreshExcess.scaleInvariantFreshEnergy
  residualVelocityExcessOutsideChildren :
    residualFreshExcess.residualVelocityExcessOutsideChildren
  pressureLocalizedBeforeSplit :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  velocityPressureExcessUsesSameScaleRadius : Prop
  splitUsesGalileanGauge :
    hRho.cknExcessData.galileanInvariantVelocityExcess
  splitUsesPressureGauge :
    hRho.cknExcessData.pressureGaugeFixedExcess
  noTailBudgetOrStrictnessInFreshEnergySplit : Prop

/--
Auxiliary PDE source for the shard-B fresh-energy split.

This is the Lean-facing station suggested by the coercivity auxiliary search:
first split fresh energy into a Galilean velocity piece and a localized
pressure piece, then bound those two pieces by the explicit CKN-data excess
bounds.  The named provenance fields keep the object tied to a Caccioppoli /
Littlewood-Paley / pressure-decomposition argument rather than a route-budget
shortcut.
-/
structure FreshFrequencyGalileanCKNFreshEnergySplitSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  freshEnergy : Real
  freshVelocityEnergy : Real
  freshPressureEnergy : Real
  C_velocity : Real
  C_pressure : Real
  C_velocity_nonneg : 0 ≤ C_velocity
  C_pressure_nonneg : 0 ≤ C_pressure
  freshEnergy_le_velocityPressurePieces :
    freshEnergy ≤ freshVelocityEnergy + freshPressureEnergy
  freshVelocityEnergy_le_velocityExcessBound :
    freshVelocityEnergy ≤
      C_velocity * hRho.cknExcessData.velocityExcessBound
  freshPressureEnergy_le_pressureExcessBound :
    freshPressureEnergy ≤
      C_pressure * hRho.cknExcessData.pressureExcessBound
  scaleInvariantFreshEnergy :
    residualFreshExcess.scaleInvariantFreshEnergy
  residualVelocityExcessOutsideChildren :
    residualFreshExcess.residualVelocityExcessOutsideChildren
  pressureLocalizedBeforeCaccioppoliSplit :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  freshCutoffSubordinateToResidualRegion : Prop
  childCollarBoundaryTermsBookedOutsideShardB : Prop
  boundedOverlapFreshTentPartition : Prop
  galileanDriftRemovedBeforeFreshCutoff :
    hRho.cknExcessData.driftPressureNormalization.galileanDriftRemoved
  pressureGaugeFixedBeforeFreshCutoff :
    hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed
  cknVelocityExcessUsesGalileanGauge :
    hRho.cknExcessData.galileanInvariantVelocityExcess
  cknPressureExcessUsesFixedGauge :
    hRho.cknExcessData.pressureGaugeFixedExcess
  localPressureDecompositionUsesSameGauge : Prop
  littlewoodPaleyShellOrCaccioppoliTestFunction : Prop
  noTailBudgetOrStrictnessInCaccioppoliSplit : Prop

/--
The auxiliary fresh-energy split proves the current CKN-data-bound station.
All PDE content is in the two piece estimates and the initial fresh-region
split.
-/
theorem freshEnergy_le_cknDataBounds_of_galileanCKNFreshEnergySplitSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h :
      FreshFrequencyGalileanCKNFreshEnergySplitSource seq K hRho) :
    h.freshEnergy ≤
      h.C_velocity * hRho.cknExcessData.velocityExcessBound +
        h.C_pressure * hRho.cknExcessData.pressureExcessBound := by
  nlinarith [h.freshEnergy_le_velocityPressurePieces,
    h.freshVelocityEnergy_le_velocityExcessBound,
    h.freshPressureEnergy_le_pressureExcessBound]

/--
Constructor from the auxiliary Galilean CKN split source to the existing
fresh-energy CKN-data-bound split.
-/
def FreshFrequencyFreshEnergyCKNDataBoundSplit.ofGalileanCKNSplitSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h :
      FreshFrequencyGalileanCKNFreshEnergySplitSource seq K hRho)
    (velocityPressureExcessUsesSameScaleRadius : Prop) :
    FreshFrequencyFreshEnergyCKNDataBoundSplit seq K hRho where
  residualFreshExcess := h.residualFreshExcess
  freshEnergy := h.freshEnergy
  C_velocity := h.C_velocity
  C_pressure := h.C_pressure
  freshEnergy_le_cknDataBounds :=
    freshEnergy_le_cknDataBounds_of_galileanCKNFreshEnergySplitSource h
  scaleInvariantFreshEnergy := h.scaleInvariantFreshEnergy
  residualVelocityExcessOutsideChildren :=
    h.residualVelocityExcessOutsideChildren
  pressureLocalizedBeforeSplit :=
    h.pressureLocalizedBeforeCaccioppoliSplit
  velocityPressureExcessUsesSameScaleRadius :=
    velocityPressureExcessUsesSameScaleRadius
  splitUsesGalileanGauge :=
    h.cknVelocityExcessUsesGalileanGauge
  splitUsesPressureGauge :=
    h.cknPressureExcessUsesFixedGauge
  noTailBudgetOrStrictnessInFreshEnergySplit :=
    h.noTailBudgetOrStrictnessInCaccioppoliSplit

/--
Pressure-piece source below the Galilean CKN fresh-energy split.

Only the local Calderon-Zygmund pressure piece is allowed to pay shard B.  The
harmonic reserve, child-collar pressure, and cutoff/CZ commutator remainder are
explicitly booked outside shard B so that pressure nonlocality is not hidden in
`freshPressureEnergy`.
-/
structure FreshFrequencyPressureEnergyLocalCZReserveControl
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  pressureObligation : Route1PressureReserveNoEscapeObligation
  freshPressureEnergy : Real
  localCZPressureEnergy : Real
  harmonicPressureReserveEnergy : Real
  childCollarPressureEnergy : Real
  cutoffCommutatorPressureError : Real
  C_pressure : Real
  C_CZ : Real
  C_pressure_nonneg : 0 ≤ C_pressure
  C_CZ_nonneg : 0 ≤ C_CZ
  pressureExcessBound_nonneg :
    0 ≤ hRho.cknExcessData.pressureExcessBound
  pressureEnergy_decomposition :
    freshPressureEnergy ≤
      localCZPressureEnergy + harmonicPressureReserveEnergy +
        childCollarPressureEnergy + cutoffCommutatorPressureError
  localCZ_le_pressureExcess :
    localCZPressureEnergy ≤
      C_CZ * hRho.cknExcessData.pressureExcessBound
  harmonicReserve_booked_outsideShardB :
    harmonicPressureReserveEnergy = 0
  childCollar_booked_outsideShardB :
    childCollarPressureEnergy = 0
  cutoffCommutator_booked_outsideShardB :
    cutoffCommutatorPressureError = 0
  coefficient_budget :
    C_CZ ≤ C_pressure
  pressureLocalizedBeforeCZ :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  fixedPressureGauge :
    hRho.cknExcessData.pressureGaugeFixedExcess
  sameScaleRadiusAndFreshCutoff : Prop
  localCalderonZygmundOnFreshRegion : Prop
  pressureObligationUsesSameFreshTent : Prop
  harmonicPressureReserveBookedByPressureReceipt : Prop
  childCollarPressureRoutedToShardCLeakage : Prop
  cutoffCommutatorRoutedToShardCLeakage : Prop
  noTailBudgetOrStrictnessInput : Prop

/--
Local Calderon-Zygmund source for the pressure piece.

This isolates the actual same-gauge pressure estimate below
`FreshFrequencyPressureEnergyLocalCZReserveControl`: the recovered local Riesz
pressure energy is compared to the CKN pressure excess bound, while harmonic
and cutoff commutator pieces remain outside this station.
-/
structure FreshFrequencyLocalCZPressureExcessSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  pressureObligation : Route1PressureReserveNoEscapeObligation
  localCZPressureEnergy : Real
  recoveredRieszPressureEnergy : Real
  localPressureSourceEnergy : Real
  pressureExcessBound : Real
  C_CZ : Real
  C_CZ_nonneg : 0 ≤ C_CZ
  pressureExcessBound_nonneg : 0 ≤ pressureExcessBound
  pressureExcessBound_eq_cknData :
    pressureExcessBound = hRho.cknExcessData.pressureExcessBound
  localCZPressureEnergy_le_recoveredRiesz :
    localCZPressureEnergy ≤ recoveredRieszPressureEnergy
  recoveredRiesz_le_localPressureSource :
    recoveredRieszPressureEnergy ≤ C_CZ * localPressureSourceEnergy
  localPressureSource_le_pressureExcessBound :
    localPressureSourceEnergy ≤ pressureExcessBound
  pressureExcessBoundDefinedBeforeLocalCZRecovery : Prop
  pressureExcessBoundIsCKNPressureGaugeIntegral : Prop
  pressureExcessBoundNotDefinedFromRecoveredRiesz : Prop
  recoveredRieszSourceIsLocalVelocityTensorOnFreshRegion : Prop
  pressureRecoveredByLocalRieszTransform : Prop
  samePressureGaugeAsCKNData :
    hRho.cknExcessData.pressureGaugeFixedExcess
  pressureGaugeFixedBeforeRieszProjection :
    hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed
  sameScaleRadiusAndFreshCutoff : Prop
  localCZKernelTruncatedToFreshRegion : Prop
  harmonicPressureExcludedFromLocalCZ : Prop
  childCollarPressureNotIncludedInRecoveredRiesz : Prop
  cutoffCommutatorExcludedFromLocalCZ : Prop
  pressureObligationUsesSameFreshTent : Prop
  CZConstantUniformIndependentOfTailBudget : Prop
  noPressureExcessBoundChosenAfterRecoveredRiesz : Prop
  noTailBudgetOrStrictnessInLocalCZ : Prop

/--
Formula-level source beneath the local CZ pressure station.

This separates the recovered local Riesz pressure from the source that pays it:
the velocity tensor source is fixed on the fresh region before Riesz recovery,
and the local pressure source is not allowed to be defined from the recovered
pressure energy itself.
-/
structure FreshFrequencyRecoveredRieszLocalPressureSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  localCZPressureEnergy : Real
  recoveredRieszPressureEnergy : Real
  freshVelocityTensorSourceEnergy : Real
  localPressureSourceEnergy : Real
  C_Riesz : Real
  C_Riesz_nonneg : 0 ≤ C_Riesz
  localCZPressureEnergy_le_recoveredRiesz :
    localCZPressureEnergy ≤ recoveredRieszPressureEnergy
  recoveredRiesz_le_velocityTensorSource :
    recoveredRieszPressureEnergy ≤
      C_Riesz * freshVelocityTensorSourceEnergy
  velocityTensorSource_le_localPressureSource :
    freshVelocityTensorSourceEnergy ≤ localPressureSourceEnergy
  pressureRecoveredByDoubleRieszOfVelocityTensor : Prop
  velocityTensorSourceFixedBeforeRieszRecovery : Prop
  localPressureSourceFixedBeforePressureExcessComparison : Prop
  sourceIsLocalVelocityTensorOnFreshRegion : Prop
  samePressureGaugeAsCKNData :
    hRho.cknExcessData.pressureGaugeFixedExcess
  pressureGaugeFixedBeforeRieszProjection :
    hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed
  sameFreshCutoffAsLocalCZ : Prop
  localCZKernelTruncatedToFreshRegion : Prop
  harmonicPressureExcludedFromRecoveredRiesz : Prop
  childCollarPressureNotIncludedInRecoveredRiesz : Prop
  cutoffCommutatorExcludedFromRecoveredRiesz : Prop
  C_RieszUniformIndependentOfTailBudget : Prop
  noSourceDefinedFromRecoveredRiesz : Prop
  noTailBudgetOrStrictnessInput : Prop

/--
Recovered-Riesz source specialized to the pressure-Hessian tail-window carrier.

The older local-CZ source controls a pressure-excess upper budget.  This
source is narrower: it identifies the recovered local double-Riesz pressure
piece with the `pressureL2` tail-window carrier used by the pressure-visible
lower-bound branch.  It does not assert angular non-nullness or pressure
visibility by itself.
-/
structure FreshFrequencyRecoveredRieszTailWindowProjectionSource
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  recoveredRiesz :
    FreshFrequencyRecoveredRieszLocalPressureSource seq K hRho
  pressureL2 : PressureHessianL2Amplitude
  radialGrade : Real
  pressureL2_eq_recoveredRieszTailWindow :
    pressureL2 = recoveredRiesz.recoveredRieszPressureEnergy
  tailWindowProjectionIdentifiesLocalDoubleRiesz : Prop
  pressureWindowFixedBeforeRouteReceipt : Prop
  radialGradeNormalizesRecoveredRieszCarrier : Prop
  tailProjectionNotDefinedFromAngularMoment : Prop
  recoveredRieszSourceNotDefinedFromVisibilityReceipt : Prop
  noTailBudgetOrStrictnessInput : Prop

/--
The recovered-Riesz tail-window source gives the pressure-side source station
for carrier identification.  The angular/Riesz moment match remains a separate
station; this constructor only pays the recovered pressure-Hessian projection
side.
-/
def Route1PressureHessianTailWindowProjectionStation.ofRecoveredRieszTailWindow
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h :
      FreshFrequencyRecoveredRieszTailWindowProjectionSource seq K hRho) :
    Route1PressureHessianTailWindowProjectionStation where
  pressureL2 := h.pressureL2
  radialGrade := h.radialGrade
  pressureRecoveredByHelmholtzLeray :=
    h.recoveredRiesz.pressureRecoveredByDoubleRieszOfVelocityTensor
  pressureL2IsTailWindowProjectionOfRecoveredPressureHessian :=
    h.tailWindowProjectionIdentifiesLocalDoubleRiesz
  radialGradeNormalizesPressureCarrier :=
    h.radialGradeNormalizesRecoveredRieszCarrier
  pressureWindowFixedBeforeRouteReceipt :=
    h.pressureWindowFixedBeforeRouteReceipt
  tailProjectionNotDefinedFromAngularMoment :=
    h.tailProjectionNotDefinedFromAngularMoment
  no_strictSubratio_or_margin_input := h.noTailBudgetOrStrictnessInput

/--
Formula check for the recovered-Riesz tail-window identification.

This is intentionally only an identity for the carrier observable.  The
visibility lower bound still requires the separate angular/Riesz station and
angular dominance data.
-/
theorem recoveredRiesz_tailWindowCarrier_eq
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h :
      FreshFrequencyRecoveredRieszTailWindowProjectionSource seq K hRho) :
    renormalizedPressureHessianL2Carrier h.pressureL2 h.radialGrade =
      h.recoveredRiesz.recoveredRieszPressureEnergy / max h.radialGrade 1 := by
  unfold renormalizedPressureHessianL2Carrier
  rw [h.pressureL2_eq_recoveredRieszTailWindow]

/--
The formula-level Riesz source discharges the raw recovered-pressure source
inequality used by `FreshFrequencyLocalCZPressureExcessSource`.
-/
theorem recoveredRiesz_le_localPressureSource_of_velocityTensorSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyRecoveredRieszLocalPressureSource seq K hRho) :
    h.recoveredRieszPressureEnergy ≤
      h.C_Riesz * h.localPressureSourceEnergy := by
  have hsource :
      h.C_Riesz * h.freshVelocityTensorSourceEnergy ≤
        h.C_Riesz * h.localPressureSourceEnergy :=
    mul_le_mul_of_nonneg_left h.velocityTensorSource_le_localPressureSource
      h.C_Riesz_nonneg
  exact le_trans h.recoveredRiesz_le_velocityTensorSource hsource

/--
Promote the formula-level recovered Riesz source into the local CZ pressure
source consumed by the route-1 pressure reserve controls.
-/
def FreshFrequencyLocalCZPressureExcessSource.ofRecoveredRieszLocalSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (hRiesz :
      FreshFrequencyRecoveredRieszLocalPressureSource seq K hRho)
    (pressureObligation : Route1PressureReserveNoEscapeObligation)
    (pressureExcessBound : Real)
    (pressureExcessBound_nonneg : 0 ≤ pressureExcessBound)
    (pressureExcessBound_eq_cknData :
      pressureExcessBound = hRho.cknExcessData.pressureExcessBound)
    (localPressureSource_le_pressureExcessBound :
      hRiesz.localPressureSourceEnergy ≤ pressureExcessBound)
    (pressureExcessBoundDefinedBeforeLocalCZRecovery : Prop)
    (pressureExcessBoundIsCKNPressureGaugeIntegral : Prop)
    (pressureExcessBoundNotDefinedFromRecoveredRiesz : Prop)
    (pressureObligationUsesSameFreshTent : Prop) :
    FreshFrequencyLocalCZPressureExcessSource seq K hRho where
  residualFreshExcess := hRiesz.residualFreshExcess
  pressureObligation := pressureObligation
  localCZPressureEnergy := hRiesz.localCZPressureEnergy
  recoveredRieszPressureEnergy := hRiesz.recoveredRieszPressureEnergy
  localPressureSourceEnergy := hRiesz.localPressureSourceEnergy
  pressureExcessBound := pressureExcessBound
  C_CZ := hRiesz.C_Riesz
  C_CZ_nonneg := hRiesz.C_Riesz_nonneg
  pressureExcessBound_nonneg := pressureExcessBound_nonneg
  pressureExcessBound_eq_cknData := pressureExcessBound_eq_cknData
  localCZPressureEnergy_le_recoveredRiesz :=
    hRiesz.localCZPressureEnergy_le_recoveredRiesz
  recoveredRiesz_le_localPressureSource :=
    recoveredRiesz_le_localPressureSource_of_velocityTensorSource hRiesz
  localPressureSource_le_pressureExcessBound :=
    localPressureSource_le_pressureExcessBound
  pressureExcessBoundDefinedBeforeLocalCZRecovery :=
    pressureExcessBoundDefinedBeforeLocalCZRecovery
  pressureExcessBoundIsCKNPressureGaugeIntegral :=
    pressureExcessBoundIsCKNPressureGaugeIntegral
  pressureExcessBoundNotDefinedFromRecoveredRiesz :=
    pressureExcessBoundNotDefinedFromRecoveredRiesz
  recoveredRieszSourceIsLocalVelocityTensorOnFreshRegion :=
    hRiesz.sourceIsLocalVelocityTensorOnFreshRegion
  pressureRecoveredByLocalRieszTransform :=
    hRiesz.pressureRecoveredByDoubleRieszOfVelocityTensor
  samePressureGaugeAsCKNData := hRiesz.samePressureGaugeAsCKNData
  pressureGaugeFixedBeforeRieszProjection :=
    hRiesz.pressureGaugeFixedBeforeRieszProjection
  sameScaleRadiusAndFreshCutoff := hRiesz.sameFreshCutoffAsLocalCZ
  localCZKernelTruncatedToFreshRegion :=
    hRiesz.localCZKernelTruncatedToFreshRegion
  harmonicPressureExcludedFromLocalCZ :=
    hRiesz.harmonicPressureExcludedFromRecoveredRiesz
  childCollarPressureNotIncludedInRecoveredRiesz :=
    hRiesz.childCollarPressureNotIncludedInRecoveredRiesz
  cutoffCommutatorExcludedFromLocalCZ :=
    hRiesz.cutoffCommutatorExcludedFromRecoveredRiesz
  pressureObligationUsesSameFreshTent := pressureObligationUsesSameFreshTent
  CZConstantUniformIndependentOfTailBudget :=
    hRiesz.C_RieszUniformIndependentOfTailBudget
  noPressureExcessBoundChosenAfterRecoveredRiesz :=
    hRiesz.noSourceDefinedFromRecoveredRiesz
  noTailBudgetOrStrictnessInLocalCZ :=
    hRiesz.noTailBudgetOrStrictnessInput

/-- Local Riesz/CZ pressure energy pays the pressure-excess bound. -/
theorem localCZPressureEnergy_le_pressureExcessBound_of_localCZSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h : FreshFrequencyLocalCZPressureExcessSource seq K hRho) :
    h.localCZPressureEnergy ≤
      h.C_CZ * hRho.cknExcessData.pressureExcessBound := by
  rw [← h.pressureExcessBound_eq_cknData]
  have hsource :
      h.C_CZ * h.localPressureSourceEnergy ≤
        h.C_CZ * h.pressureExcessBound :=
    mul_le_mul_of_nonneg_left h.localPressureSource_le_pressureExcessBound
      h.C_CZ_nonneg
  have hriesz :
      h.recoveredRieszPressureEnergy ≤
        h.C_CZ * h.pressureExcessBound :=
    le_trans h.recoveredRiesz_le_localPressureSource hsource
  exact le_trans h.localCZPressureEnergy_le_recoveredRiesz
    hriesz

/--
Constructor from the local CZ pressure source to the pressure-piece reserve
control.  Harmonic, child-collar, and cutoff/commutator pressure remainders
remain explicit outside-shard inputs.
-/
def FreshFrequencyPressureEnergyLocalCZReserveControl.ofLocalCZSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (hCZ : FreshFrequencyLocalCZPressureExcessSource seq K hRho)
    (freshPressureEnergy harmonicPressureReserveEnergy
      childCollarPressureEnergy cutoffCommutatorPressureError
      C_pressure : Real)
    (C_pressure_nonneg : 0 ≤ C_pressure)
    (pressureEnergy_decomposition :
      freshPressureEnergy ≤
        hCZ.localCZPressureEnergy + harmonicPressureReserveEnergy +
          childCollarPressureEnergy + cutoffCommutatorPressureError)
    (harmonicReserve_booked_outsideShardB :
      harmonicPressureReserveEnergy = 0)
    (childCollar_booked_outsideShardB :
      childCollarPressureEnergy = 0)
    (cutoffCommutator_booked_outsideShardB :
      cutoffCommutatorPressureError = 0)
    (coefficient_budget : hCZ.C_CZ ≤ C_pressure)
    (pressureLocalizedBeforeCZ :
      hCZ.residualFreshExcess.pressureTailLocalizedToFreshVelocity)
    (childCollarPressureRoutedToShardCLeakage : Prop)
    (cutoffCommutatorRoutedToShardCLeakage : Prop) :
    FreshFrequencyPressureEnergyLocalCZReserveControl seq K hRho where
  residualFreshExcess := hCZ.residualFreshExcess
  pressureObligation := hCZ.pressureObligation
  freshPressureEnergy := freshPressureEnergy
  localCZPressureEnergy := hCZ.localCZPressureEnergy
  harmonicPressureReserveEnergy := harmonicPressureReserveEnergy
  childCollarPressureEnergy := childCollarPressureEnergy
  cutoffCommutatorPressureError := cutoffCommutatorPressureError
  C_pressure := C_pressure
  C_CZ := hCZ.C_CZ
  C_pressure_nonneg := C_pressure_nonneg
  C_CZ_nonneg := hCZ.C_CZ_nonneg
  pressureExcessBound_nonneg := by
    rw [← hCZ.pressureExcessBound_eq_cknData]
    exact hCZ.pressureExcessBound_nonneg
  pressureEnergy_decomposition := pressureEnergy_decomposition
  localCZ_le_pressureExcess :=
    localCZPressureEnergy_le_pressureExcessBound_of_localCZSource hCZ
  harmonicReserve_booked_outsideShardB :=
    harmonicReserve_booked_outsideShardB
  childCollar_booked_outsideShardB :=
    childCollar_booked_outsideShardB
  cutoffCommutator_booked_outsideShardB :=
    cutoffCommutator_booked_outsideShardB
  coefficient_budget := coefficient_budget
  pressureLocalizedBeforeCZ := pressureLocalizedBeforeCZ
  fixedPressureGauge := hCZ.samePressureGaugeAsCKNData
  sameScaleRadiusAndFreshCutoff := hCZ.sameScaleRadiusAndFreshCutoff
  localCalderonZygmundOnFreshRegion :=
    hCZ.localCZKernelTruncatedToFreshRegion
  pressureObligationUsesSameFreshTent :=
    hCZ.pressureObligationUsesSameFreshTent
  harmonicPressureReserveBookedByPressureReceipt :=
    hCZ.harmonicPressureExcludedFromLocalCZ
  childCollarPressureRoutedToShardCLeakage :=
    childCollarPressureRoutedToShardCLeakage
  cutoffCommutatorRoutedToShardCLeakage :=
    cutoffCommutatorRoutedToShardCLeakage
  noTailBudgetOrStrictnessInput :=
    hCZ.noTailBudgetOrStrictnessInLocalCZ

/--
Local-CZ pressure control pays the pressure piece used by the Galilean CKN
fresh-energy split.
-/
theorem freshPressureEnergy_le_pressureExcessBound_of_localCZReserveControl
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (h :
      FreshFrequencyPressureEnergyLocalCZReserveControl seq K hRho) :
    h.freshPressureEnergy ≤
      h.C_pressure * hRho.cknExcessData.pressureExcessBound := by
  have hcoeff :
      h.C_CZ * hRho.cknExcessData.pressureExcessBound ≤
        h.C_pressure * hRho.cknExcessData.pressureExcessBound :=
    mul_le_mul_of_nonneg_right h.coefficient_budget
      h.pressureExcessBound_nonneg
  have hlocal :
      h.localCZPressureEnergy ≤
        h.C_pressure * hRho.cknExcessData.pressureExcessBound :=
    le_trans h.localCZ_le_pressureExcess hcoeff
  nlinarith [h.pressureEnergy_decomposition, hlocal,
    h.harmonicReserve_booked_outsideShardB,
    h.childCollar_booked_outsideShardB,
    h.cutoffCommutator_booked_outsideShardB]

/--
Constructor exposing the pressure-piece half of the Galilean CKN split source.
The velocity piece and the initial fresh-energy split remain separate inputs.
-/
def FreshFrequencyGalileanCKNFreshEnergySplitSource.ofPressureLocalCZReserveControl
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (hPressure :
      FreshFrequencyPressureEnergyLocalCZReserveControl seq K hRho)
    (freshEnergy freshVelocityEnergy C_velocity : Real)
    (C_velocity_nonneg : 0 ≤ C_velocity)
    (freshEnergy_le_velocityPressurePieces :
      freshEnergy ≤
        freshVelocityEnergy + hPressure.freshPressureEnergy)
    (freshVelocityEnergy_le_velocityExcessBound :
      freshVelocityEnergy ≤
        C_velocity * hRho.cknExcessData.velocityExcessBound)
    (scaleInvariantFreshEnergy :
      hPressure.residualFreshExcess.scaleInvariantFreshEnergy)
    (residualVelocityExcessOutsideChildren :
      hPressure.residualFreshExcess.residualVelocityExcessOutsideChildren)
    (freshCutoffSubordinateToResidualRegion : Prop)
    (boundedOverlapFreshTentPartition : Prop)
    (galileanDriftRemovedBeforeFreshCutoff :
      hRho.cknExcessData.driftPressureNormalization.galileanDriftRemoved)
    (pressureGaugeFixedBeforeFreshCutoff :
      hRho.cknExcessData.driftPressureNormalization.pressureGaugeFixed)
    (cknVelocityExcessUsesGalileanGauge :
      hRho.cknExcessData.galileanInvariantVelocityExcess)
    (littlewoodPaleyShellOrCaccioppoliTestFunction : Prop) :
    FreshFrequencyGalileanCKNFreshEnergySplitSource seq K hRho where
  residualFreshExcess := hPressure.residualFreshExcess
  freshEnergy := freshEnergy
  freshVelocityEnergy := freshVelocityEnergy
  freshPressureEnergy := hPressure.freshPressureEnergy
  C_velocity := C_velocity
  C_pressure := hPressure.C_pressure
  C_velocity_nonneg := C_velocity_nonneg
  C_pressure_nonneg := hPressure.C_pressure_nonneg
  freshEnergy_le_velocityPressurePieces :=
    freshEnergy_le_velocityPressurePieces
  freshVelocityEnergy_le_velocityExcessBound :=
    freshVelocityEnergy_le_velocityExcessBound
  freshPressureEnergy_le_pressureExcessBound :=
    freshPressureEnergy_le_pressureExcessBound_of_localCZReserveControl
      hPressure
  scaleInvariantFreshEnergy := scaleInvariantFreshEnergy
  residualVelocityExcessOutsideChildren :=
    residualVelocityExcessOutsideChildren
  pressureLocalizedBeforeCaccioppoliSplit :=
    hPressure.pressureLocalizedBeforeCZ
  freshCutoffSubordinateToResidualRegion :=
    freshCutoffSubordinateToResidualRegion
  childCollarBoundaryTermsBookedOutsideShardB :=
    And hPressure.childCollarPressureRoutedToShardCLeakage
      hPressure.cutoffCommutatorRoutedToShardCLeakage
  boundedOverlapFreshTentPartition := boundedOverlapFreshTentPartition
  galileanDriftRemovedBeforeFreshCutoff :=
    galileanDriftRemovedBeforeFreshCutoff
  pressureGaugeFixedBeforeFreshCutoff :=
    pressureGaugeFixedBeforeFreshCutoff
  cknVelocityExcessUsesGalileanGauge :=
    cknVelocityExcessUsesGalileanGauge
  cknPressureExcessUsesFixedGauge :=
    hPressure.fixedPressureGauge
  localPressureDecompositionUsesSameGauge :=
    hPressure.localCalderonZygmundOnFreshRegion
  littlewoodPaleyShellOrCaccioppoliTestFunction :=
    littlewoodPaleyShellOrCaccioppoliTestFunction
  noTailBudgetOrStrictnessInCaccioppoliSplit :=
    hPressure.noTailBudgetOrStrictnessInput

/--
Identification of the working excess variables with the explicit CKN-data
bounds.  Kept separate from the energy split so definitional matching cannot
be hidden inside the estimate.
-/
structure FreshFrequencyVelocityPressureExcessIdentification
    (seq : LerayHopfSequence) (K : CompactSubCylinder)
    (hRho : RhoFromNormalizedCKNExcess seq K) where
  galileanVelocityExcess : Real
  localizedPressureExcess : Real
  galileanVelocityExcess_eq_cknDataBound :
    galileanVelocityExcess = hRho.cknExcessData.velocityExcessBound
  localizedPressureExcess_eq_cknDataBound :
    localizedPressureExcess = hRho.cknExcessData.pressureExcessBound
  velocityIdentificationUsesGalileanGauge :
    hRho.cknExcessData.galileanInvariantVelocityExcess
  pressureIdentificationUsesFixedGauge :
    hRho.cknExcessData.pressureGaugeFixedExcess
  noEnergyEstimateHiddenInIdentification : Prop

/-- CKN-data split plus identifications pays the working velocity/pressure split. -/
theorem freshEnergy_le_velocity_pressure_of_cknDataBoundSplit
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (hSplit : FreshFrequencyFreshEnergyCKNDataBoundSplit seq K hRho)
    (hId : FreshFrequencyVelocityPressureExcessIdentification seq K hRho)
    (sameVelocity :
      hId.galileanVelocityExcess =
        hRho.cknExcessData.velocityExcessBound)
    (samePressure :
      hId.localizedPressureExcess =
        hRho.cknExcessData.pressureExcessBound) :
    hSplit.freshEnergy ≤
      hSplit.C_velocity * hId.galileanVelocityExcess +
        hSplit.C_pressure * hId.localizedPressureExcess := by
  rw [sameVelocity, samePressure]
  exact hSplit.freshEnergy_le_cknDataBounds

/--
Build the full CKN comparison data from the explicit fresh-energy split plus
the pressure and velocity control stations.
-/
def FreshFrequencyFreshEnergyCKNExcessComparisonData.ofCKNDataBoundSplitAndControls
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    (cknScaleSplit : CKNExcessRegularityScaleSplitWitness seq K)
    (hSplit : FreshFrequencyFreshEnergyCKNDataBoundSplit seq K hRho)
    (hId : FreshFrequencyVelocityPressureExcessIdentification seq K hRho)
    (hPressure :
      FreshFrequencyLocalizedPressureExcessControl seq K hRho)
    (hVelocity :
      FreshFrequencyGalileanVelocityExcessControl seq K hRho)
    (C_ckn : Real)
    (sameVelocity :
      hId.galileanVelocityExcess =
        hVelocity.galileanVelocityExcess)
    (samePressure :
      hId.localizedPressureExcess =
        hPressure.localizedPressureExcess)
    (sameTentExcess :
      hVelocity.localQuadraticTentExcess =
        hPressure.localQuadraticTentExcess)
    (C_velocity_nonneg : 0 ≤ hSplit.C_velocity)
    (C_pressure_nonneg : 0 ≤ hSplit.C_pressure)
    (C_ckn_eq : C_ckn = hSplit.C_velocity + hSplit.C_pressure)
    (cknSplitUsesSameRhoCarrier : Prop)
    (localSmallnessBridgeUsesCKNExcess :
      cknScaleSplit.localSmallnessBridge.cknExcess =
        hRho.cknExcessData.toExcess)
    (noTailBudgetOrStrictnessInCKNComparison : Prop) :
    FreshFrequencyFreshEnergyCKNExcessComparisonData seq K hRho where
  cknScaleSplit := cknScaleSplit
  residualFreshExcess := hSplit.residualFreshExcess
  freshEnergy := hSplit.freshEnergy
  galileanVelocityExcess := hVelocity.galileanVelocityExcess
  localizedPressureExcess := hPressure.localizedPressureExcess
  localQuadraticTentExcess := hPressure.localQuadraticTentExcess
  C_velocity := hSplit.C_velocity
  C_pressure := hSplit.C_pressure
  C_ckn := C_ckn
  C_velocity_nonneg := C_velocity_nonneg
  C_pressure_nonneg := C_pressure_nonneg
  freshEnergy_le_velocity_pressure_excess := by
    rw [← sameVelocity, ← samePressure]
    exact freshEnergy_le_velocity_pressure_of_cknDataBoundSplit
      hSplit hId hId.galileanVelocityExcess_eq_cknDataBound
      hId.localizedPressureExcess_eq_cknDataBound
  velocityExcess_le_localQuadratic := by
    rw [← sameTentExcess]
    exact velocityExcess_le_localQuadratic_of_velocityControl hVelocity
  pressureExcess_le_localQuadratic :=
    pressureExcess_le_localQuadratic_of_pressureControl hPressure
  C_ckn_eq := C_ckn_eq
  cknSplitUsesSameRhoCarrier := cknSplitUsesSameRhoCarrier
  velocityExcessUsesGalileanGauge :=
    hVelocity.galileanGaugeMatchesCKNExcess
  pressureExcessUsesFixedGauge := hPressure.pressureGaugeMatchesCKNExcess
  pressureLocalizedBeforeCKNComparison :=
    hSplit.pressureLocalizedBeforeSplit
  localSmallnessBridgeUsesCKNExcess := localSmallnessBridgeUsesCKNExcess
  noTailBudgetOrStrictnessInCKNComparison :=
    noTailBudgetOrStrictnessInCKNComparison

