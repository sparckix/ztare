        hElig hGeom hPressure hDuhamel hLock) := by
  refine ⟨{
    pressureDuhamelLockAvailable := hLock.pressureLock
    sameTreeLockAvailable := hLock
    pressureBudgetControlsOnlyEventPrefix :=
      hLock.pressureLock.pressureDuhamelCostControlledByFreshEventBudget
    noRepeatedDescendantChargingVisible :=
      hLock.noRepeatedDescendantCharging
    auditIndexedSingleSpendCarrierMissing := hNoAuditIndexed
    singleSpendDualLedgerBridgeMissing := hNoSingleSpend
    duhamelHeatLocalizationNotYetInvoiceCarrier := True
    pressureReserveNotYetSeparatedFromParentInvoice := True
    parentRadiusInvoiceCanStillBeRebilledByPressureCarrier := True
    inheritedReserveCanStillMintParentInvoice := True
    pressureDuhamelPrefixIsNotRadiusInvoice := True
