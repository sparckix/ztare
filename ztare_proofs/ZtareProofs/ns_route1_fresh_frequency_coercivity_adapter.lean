/--
Direct owner-preimage receipt from event-indexed same-carrier packing.

The owner map is the identity, the active owner prefix is the same event
prefix, atom currency is `freshCharge / c`, and projection multiplicity is
one.  Qualitative filtration and phase-space receipts are still explicit
inputs; the numerical prefix certificate is no longer hidden inside the larger
carrier-transfer constructor.
-/
noncomputable def OwnerPreimagePackingReceipt.ofSameCarrierPackingIdentity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack : C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (routeActiveTail_nonnegative : ∀ n : Nat, 0 ≤ routeActiveTail n)
    (scaledFreshCharge_nonnegative :
      ∀ n : Nat, 0 ≤ hPack.freshCharge n / hPack.c)
    (scaledRootBudget_nonnegative : 0 ≤ hPack.rootBudget / hPack.c)
    (ownerMapFixedBeforePayoff : Prop)
    (ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff)
    (noLowFrequencyCatalystOwner : Prop)
    (noLowFrequencyCatalystOwner_proof : noLowFrequencyCatalystOwner)
    (sameAnnularOutputScaleOwner : Prop)
    (sameAnnularOutputScaleOwner_proof : sameAnnularOutputScaleOwner)
    (globalSelectedTreePreimageBound : Prop)
    (globalSelectedTreePreimageBound_proof :
      globalSelectedTreePreimageBound)
    (smoothOrInheritedFactorRoutedOffResidualFreshStream : Prop)
    (smoothOrInheritedFactorRoutedOffResidualFreshStream_proof :
      smoothOrInheritedFactorRoutedOffResidualFreshStream)
    (sameCarrierPhaseSpaceOwnership : Prop)
    (sameCarrierPhaseSpaceOwnership_proof :
      sameCarrierPhaseSpaceOwnership) :
    OwnerPreimagePackingReceipt
      (fun n : Nat => n)
      routeActiveTail
      (fun n : Nat => hPack.freshCharge n / hPack.c)
      (fun N : Nat => N)
      1
      (hPack.rootBudget / hPack.c) where
  eventPay_nonnegative := routeActiveTail_nonnegative
  atomCharge_nonnegative := scaledFreshCharge_nonnegative
  C_nonnegative := by norm_num
  atomBudget_nonnegative := scaledRootBudget_nonnegative
  owner_lt_activeAtomBound := by
    intro e N heN
    exact heN
  pointwiseOwnedAtomPaysEvent := by
    intro e
    have hpay :
        routeActiveTail e * hPack.c ≤ hPack.freshCharge e := by
      simpa [mul_comm] using hPack.pointwiseSameCarrierPayment e
    exact (le_div_iff₀ hPack.c_pos).2 hpay
  ownerPreimagePackingPrefix := by
    intro N
    simpa using
      sameCarrierPacking_scaledRoutePrefix_le_scaledFreshPrefix hPack N
  activeAtomPrefixBudget :=
    sameCarrierPacking_scaledFreshPrefix_le_scaledRootBudget hPack
  ownerIsFullOutputScalePacket := sameAnnularOutputScaleOwner
  ownerIsFullOutputScalePacket_proof := sameAnnularOutputScaleOwner_proof
  ownerNotReusableLowFrequencyCatalyst := noLowFrequencyCatalystOwner
  ownerNotReusableLowFrequencyCatalyst_proof :=
    noLowFrequencyCatalystOwner_proof
  smoothOrInheritedFactorRoutedOffResidualFreshStream :=
    smoothOrInheritedFactorRoutedOffResidualFreshStream
  smoothOrInheritedFactorRoutedOffResidualFreshStream_proof :=
    smoothOrInheritedFactorRoutedOffResidualFreshStream_proof
  ownerChosenBeforePayoff := ownerMapFixedBeforePayoff
  ownerChosenBeforePayoff_proof := ownerMapFixedBeforePayoff_proof
  sameCarrierPhaseSpaceOwnership := sameCarrierPhaseSpaceOwnership
  sameCarrierPhaseSpaceOwnership_proof :=
    sameCarrierPhaseSpaceOwnership_proof
  globalSelectedTreePreimageBound := globalSelectedTreePreimageBound
  globalSelectedTreePreimageBound_proof :=
    globalSelectedTreePreimageBound_proof

/--
Identity-owner carrier transfer from same-carrier packing.

If the same-carrier packing receipt is genuinely event-indexed and the route
tail / scaled fresh charge are nonnegative, the owner map can be the identity:
event `n` owns fresh atom `n`.  This is the constructive reduction exposed by
the recursive owner-preimage audit.
-/
noncomputable def C7ScaledOwnerPreimageCarrierTransfer.ofSameCarrierPackingIdentity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack : C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (routeActiveTail_nonnegative : ∀ n : Nat, 0 ≤ routeActiveTail n)
    (scaledFreshCharge_nonnegative :
      ∀ n : Nat, 0 ≤ hPack.freshCharge n / hPack.c)
    (scaledRootBudget_nonnegative : 0 ≤ hPack.rootBudget / hPack.c)
    (ownerMapFixedBeforePayoff : Prop)
    (ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff)
    (noLowFrequencyCatalystOwner : Prop)
    (noLowFrequencyCatalystOwner_proof : noLowFrequencyCatalystOwner)
    (sameAnnularOutputScaleOwner : Prop)
    (sameAnnularOutputScaleOwner_proof : sameAnnularOutputScaleOwner)
    (selectedPrefixPreimageNotPointwiseOnly : Prop)
    (selectedPrefixPreimageNotPointwiseOnly_proof :
      selectedPrefixPreimageNotPointwiseOnly)
    (globalSelectedTreePreimageBound : Prop)
    (globalSelectedTreePreimageBound_proof :
      globalSelectedTreePreimageBound)
    (smoothOrInheritedFactorRoutedOffResidualFreshStream : Prop)
    (smoothOrInheritedFactorRoutedOffResidualFreshStream_proof :
      smoothOrInheritedFactorRoutedOffResidualFreshStream)
    (sameCarrierPhaseSpaceOwnership : Prop)
    (sameCarrierPhaseSpaceOwnership_proof :
      sameCarrierPhaseSpaceOwnership)
    (transferNotCarrierNameOnly : Prop) :
    C7ScaledOwnerPreimageCarrierTransfer hPack where
  ownerOfEvent := fun n : Nat => n
  activeOwnerAtomBound := fun N : Nat => N
  multiplicityBound := 1
  scaledAtomCharge_nonnegative := scaledFreshCharge_nonnegative
  scaledAtomBudget_nonnegative := scaledRootBudget_nonnegative
  multiplicityBound_nonnegative := by norm_num
  scaledOwnerPreimage :=
    OwnerPreimagePackingReceipt.ofSameCarrierPackingIdentity
      hPack
      routeActiveTail_nonnegative
      scaledFreshCharge_nonnegative
      scaledRootBudget_nonnegative
      ownerMapFixedBeforePayoff
      ownerMapFixedBeforePayoff_proof
      noLowFrequencyCatalystOwner
      noLowFrequencyCatalystOwner_proof
      sameAnnularOutputScaleOwner
      sameAnnularOutputScaleOwner_proof
      globalSelectedTreePreimageBound
      globalSelectedTreePreimageBound_proof
      smoothOrInheritedFactorRoutedOffResidualFreshStream
      smoothOrInheritedFactorRoutedOffResidualFreshStream_proof
      sameCarrierPhaseSpaceOwnership
      sameCarrierPhaseSpaceOwnership_proof
  scaledAtomPrefixBudget :=
    sameCarrierPacking_scaledFreshPrefix_le_scaledRootBudget hPack
  ownerMapFixedBeforePayoff := ownerMapFixedBeforePayoff
  ownerMapFixedBeforePayoff_proof := ownerMapFixedBeforePayoff_proof
  noLowFrequencyCatalystOwner := noLowFrequencyCatalystOwner
  noLowFrequencyCatalystOwner_proof := noLowFrequencyCatalystOwner_proof
  sameAnnularOutputScaleOwner := sameAnnularOutputScaleOwner
  sameAnnularOutputScaleOwner_proof := sameAnnularOutputScaleOwner_proof
  selectedPrefixPreimageNotPointwiseOnly :=
    selectedPrefixPreimageNotPointwiseOnly
  selectedPrefixPreimageNotPointwiseOnly_proof :=
    selectedPrefixPreimageNotPointwiseOnly_proof
  transferNotCarrierNameOnly := transferNotCarrierNameOnly

/--
Identity-owner transfer with scaled nonnegativity derived from route-tail
nonnegativity.

The same-carrier packing inequality and `c > 0` imply
`0 <= freshCharge n / c`; the empty-prefix budget implies
`0 <= rootBudget / c`.  Hence after this wrapper, the only numeric
nonnegativity input still outside the C7 packing receipt is
`routeActiveTail_nonnegative`.
-/
noncomputable def C7ScaledOwnerPreimageCarrierTransfer.ofSameCarrierPackingIdentityRouteNonnegative
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack : C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (routeActiveTail_nonnegative : ∀ n : Nat, 0 ≤ routeActiveTail n)
    (ownerMapFixedBeforePayoff : Prop)
    (ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff)
    (noLowFrequencyCatalystOwner : Prop)
    (noLowFrequencyCatalystOwner_proof : noLowFrequencyCatalystOwner)
    (sameAnnularOutputScaleOwner : Prop)
    (sameAnnularOutputScaleOwner_proof : sameAnnularOutputScaleOwner)
    (selectedPrefixPreimageNotPointwiseOnly : Prop)
    (selectedPrefixPreimageNotPointwiseOnly_proof :
      selectedPrefixPreimageNotPointwiseOnly)
    (globalSelectedTreePreimageBound : Prop)
    (globalSelectedTreePreimageBound_proof :
      globalSelectedTreePreimageBound)
    (smoothOrInheritedFactorRoutedOffResidualFreshStream : Prop)
    (smoothOrInheritedFactorRoutedOffResidualFreshStream_proof :
      smoothOrInheritedFactorRoutedOffResidualFreshStream)
    (sameCarrierPhaseSpaceOwnership : Prop)
    (sameCarrierPhaseSpaceOwnership_proof :
      sameCarrierPhaseSpaceOwnership)
    (transferNotCarrierNameOnly : Prop) :
    C7ScaledOwnerPreimageCarrierTransfer hPack :=
  C7ScaledOwnerPreimageCarrierTransfer.ofSameCarrierPackingIdentity
    hPack
    routeActiveTail_nonnegative
    (by
      intro n
      have hleft_nonnegative :
          0 ≤ hPack.c * routeActiveTail n :=
        mul_nonneg (le_of_lt hPack.c_pos)
          (routeActiveTail_nonnegative n)
      have hfresh_nonnegative : 0 ≤ hPack.freshCharge n :=
        le_trans hleft_nonnegative (hPack.pointwiseSameCarrierPayment n)
      exact div_nonneg hfresh_nonnegative (le_of_lt hPack.c_pos))
    (by
      have hroot_nonnegative : 0 ≤ hPack.rootBudget := by
        have hzero := hPack.finitePrefixFreshCarrierBudget 0
        simpa [NS.nsPrefixSum] using hzero
      exact div_nonneg hroot_nonnegative (le_of_lt hPack.c_pos))
    ownerMapFixedBeforePayoff
    ownerMapFixedBeforePayoff_proof
    noLowFrequencyCatalystOwner
    noLowFrequencyCatalystOwner_proof
    sameAnnularOutputScaleOwner
    sameAnnularOutputScaleOwner_proof
    selectedPrefixPreimageNotPointwiseOnly
    selectedPrefixPreimageNotPointwiseOnly_proof
    globalSelectedTreePreimageBound
    globalSelectedTreePreimageBound_proof
    smoothOrInheritedFactorRoutedOffResidualFreshStream
    smoothOrInheritedFactorRoutedOffResidualFreshStream_proof
    sameCarrierPhaseSpaceOwnership
    sameCarrierPhaseSpaceOwnership_proof
    transferNotCarrierNameOnly

/--
Route active-tail nonnegativity receipt for the C7 identity-owner path.

The imported beta/radius surfaces currently expose positivity mainly as Prop
receipts.  This narrow receipt names the pointwise numerical fact needed by the
identity-owner transfer without overclaiming that it has already been derived
from those Prop fields.
-/
structure C7RouteActiveTailNonnegativeReceipt
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
