    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack :
      C7SameCarrierPackingNoReuseReceipt hIndexed hId)
    (hReceipts :
      BadCenterBetaSquareScheduleReceiptsFromIndexedCarrier hIndexed) :
    FreshAnnularNumericalScheduleFromIndexedCarrier hIndexed where
  activeTail := routeActiveTail
  freshCharge := hPack.freshCharge
  c := hPack.c
  rootBudget := hPack.rootBudget
  c_pos := hPack.c_pos
  pointwiseFreshPayment :=
    hPack.pointwiseSameCarrierPayment
  freshChargePrefixBudget :=
    hPack.finitePrefixFreshCarrierBudget
  eventScheduleEnumeratesInvoiceBadNodes :=
    hIndexed.sameTreeInvoiceEmbedding.eventDataMatchedToResidualFreshAuditIndex
  eventScheduleEnumeratesInvoiceBadNodes_proof :=
    hReceipts.eventScheduleEnumeratesInvoiceBadNodes_proof
  freshChargeQuantifiesInvoiceRegions :=
    hIndexed.sameTreeInvoiceEmbedding.residualBranchLedgerEventsPayNodeRadii
  freshChargeQuantifiesInvoiceRegions_proof :=
    hReceipts.freshChargeQuantifiesInvoiceRegions_proof
  invoiceAssignedBeforeSubtreeSelection_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.invoiceAssignedBeforeSubtreeSelection_proof
  invoiceUsesSameNormalizedExcessStoppingTree_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.invoiceUsesSameNormalizedExcessStoppingTree_proof
  oneUseNoDescendantRebilling_verified :=
    hIndexed.noRepeatedDescendantCharging
  descendantInvoicesDisjointOrBoundedOverlap_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.descendantInvoicesDisjointOrBoundedOverlap_proof
  finiteFreshInvoiceBudget_verified := by
    simpa [C7SameTreeFreshRadiusInvoice.ofSameTreeCarlesonInvoiceEmbedding]
      using hReceipts.finiteFreshInvoiceBudget_proof
  pressureReserveSeparatedFromParentInvoice_verified :=
    hReceipts.pressureReserveNotParentInvoice_proof
  duhamelReserveSeparatedFromShellLedger_verified :=
    hReceipts.duhamelReserveNotShellProcessLedger_proof
  inheritedReserveSeparatedFromParentInvoice_verified :=
    hReceipts.inheritedDescendantsDoNotMintParentInvoices_proof
  sourceProductionSpendPartitionReceipt :=
    hIndexed.singleSpendPartition
  sourceProductionSpend_nonnegative :=
    hIndexed.productionSpend_nonnegative
  duhamelSectionIdentityReceiptForSchedule :=
    hIndexed.auditIndexFixedBeforeSpendPartition.duhamelSectionIdentity
  scheduleFixedBeforePayoffFromAuditIndex :=
    And
      hIndexed.auditIndexFixedBeforeSpendPartition.auditIndexChosenBeforeParentInvoiceAccounting
      hLock.nonadaptiveBeforeRadiusAccounting
  scheduleFixedBeforePayoffFromAuditIndex_proof :=
    And.intro
      hReceipts.auditIndexChosenBeforeParentInvoiceAccounting_proof
      hPack.nonadaptiveSourceSelection.eventStreamNonadaptiveBeforeRadiusAccounting
  sameCarrierFreshAnnularInjectionOrReserveDrop :=
    And hPack.matchedCapacityLivesOnSameResidualFreshCarrier
      hPack.finitePrefixMatchingSaturatesRouteDemand
  sameCarrierFreshAnnularInjectionOrReserveDrop_proof :=
    And.intro hPack.matchedCapacityLivesOnSameResidualFreshCarrier_proof
      hPack.finitePrefixMatchingSaturatesRouteDemand_proof
  notFiniteScalarChargeOnly :=
    And
      (And hPack.noDescendantCapacityReuse
        hPack.noSameCapacityDescendantRebilling)
      hPack.capacityNotScalarLedgerOnly
  notFiniteScalarChargeOnly_proof :=
    And.intro
      (And.intro hPack.noDescendantCapacityReuse_proof
        hPack.noSameCapacityDescendantRebilling_proof)
      hPack.capacityNotScalarLedgerOnly_proof

