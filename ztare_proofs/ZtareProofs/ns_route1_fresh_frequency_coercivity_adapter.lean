/--
Currency-normalization gap between same-carrier packing and owner-preimage
packing.

The packing receipt pays the route tail in `c`-weighted currency.  An owner
preimage receipt over the unscaled `freshCharge` needs either `1 <= c`, or a
separate scaled atom charge with a scaled prefix budget.  Without that
normalization, the bridge silently loses exactly the factor carried by the
packing theorem.
-/
structure C7PackingOwnerPreimageCurrencyNormalizationGap
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack : C7SameCarrierPackingNoReuseReceipt hIndexed hId) where
  packingPaymentIsWeighted :
    ∀ n : Nat, hPack.c * routeActiveTail n ≤ hPack.freshCharge n
  cPositive : 0 < hPack.c
  missingUnitLowerBound : Prop
  missingUnitLowerBound_proof : missingUnitLowerBound
  scaledAtomCharge : Nat → Real
  scaledAtomCharge_eq_fresh_div_c :
    ∀ n : Nat, scaledAtomCharge n = hPack.freshCharge n / hPack.c
  scaledBudget : Real
  scaledBudget_eq_rootBudget_div_c :
    scaledBudget = hPack.rootBudget / hPack.c
  requiresScaledAtomBudgetForOwnerPreimage : Prop
  doNotUseUnscaledFreshChargeAsOwnerAtomWithoutNormalization : Prop

/--
Exact scaled specialization of the owner-preimage upgrade.

This is the current constructive target after currency normalization: owner
atoms are measured in the same carrier currency as the packing receipt, divided
by the positive packing constant `c`, and the budget is scaled by the same
factor.  The remaining hard theorem is still the selected-prefix owner-preimage
packing receipt for these scaled atoms.
-/
structure C7ScaledPackingOwnerPreimageTarget
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack : C7SameCarrierPackingNoReuseReceipt hIndexed hId) where
  scaledAtomCharge : Nat → Real :=
    fun n : Nat => hPack.freshCharge n / hPack.c
  scaledAtomBudget : Real := hPack.rootBudget / hPack.c
  cPositive : 0 < hPack.c := hPack.c_pos
  ownerOfEvent : Nat → Nat
  activeOwnerAtomBound : Nat → Nat
  multiplicityBound : Real
  scaledAtomCharge_nonnegative :
    ∀ n : Nat, 0 ≤ scaledAtomCharge n
  scaledAtomBudget_nonnegative : 0 ≤ scaledAtomBudget
  multiplicityBound_nonnegative : 0 ≤ multiplicityBound
  scaledOwnerPreimage :
    OwnerPreimagePackingReceipt
      ownerOfEvent routeActiveTail scaledAtomCharge activeOwnerAtomBound
      multiplicityBound scaledAtomBudget
  scaledAtomPrefixBudget :
    ∀ N : Nat, NS.nsPrefixSum scaledAtomCharge N ≤ scaledAtomBudget
  ownerMapFixedBeforePayoff : Prop
  ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff
  noLowFrequencyCatalystOwner : Prop
  noLowFrequencyCatalystOwner_proof : noLowFrequencyCatalystOwner
  sameAnnularOutputScaleOwner : Prop
  sameAnnularOutputScaleOwner_proof : sameAnnularOutputScaleOwner
  selectedPrefixPreimageNotPointwiseOnly : Prop
  selectedPrefixPreimageNotPointwiseOnly_proof :
    selectedPrefixPreimageNotPointwiseOnly

