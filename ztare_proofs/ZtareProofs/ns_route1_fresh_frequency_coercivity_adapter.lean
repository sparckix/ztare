/-- The fixed fresh-corona pressure source feeds the pressure component of the
tri-carrier corona measure. -/
theorem pressureVisibilityFeedsTriCarrier_of_fixedFreshCoronaPreSummed
    {Ω : Type u} {BadNode : Type v}
    (h : FixedFreshCoronaPreSummedPressureRieszVisibilitySource Ω BadNode) :
    ∀ Q : BadNode,
      h.pressureComponent Q ≤
        h.pressureCoeff * h.omegaPressure (h.freshRegion Q) := by
  intro Q
  exact
    le_trans (h.pressureComponent_le_visibility Q)
      (mul_le_mul_of_nonneg_left
        (h.pressureVisibility_le_omegaPressure Q)
        h.pressureCoeff_nonneg)

