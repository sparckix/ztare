/--
Typed section-incidence identity for the audit-indexed Duhamel carrier.

This is stronger than a bare proposition that the audit index is a Duhamel
section index: it carries the actual event-section incidence receipt whose
sections must be the selected bad-center sections, and records that the identity
is fixed before radius accounting.
-/
structure ResidualFreshAuditDuhamelSectionIdentity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L) where
  sectionIncidence : NS.EventSectionIncidenceReceipt L
  duhamelSource : NS.EventDynamicRecurrencePricePrecertificateSource L
  eventPrecertificate : NS.EventDynamicRecurrencePricePrecertificate L
  eventPrecertificateIsDuhamelDerived :
    eventPrecertificate =
      NS.event_precertificate_of_duhamel_bernstein_source L duhamelSource
  reciprocalBudgetMatchesSectionIncidence :
    L.reciprocalBudget = sectionIncidence.eventReciprocalBudget
  auditIndexIsDuhamelSectionIndex :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  sectionIncidenceFixedBeforeRadiusAccounting :
    hDuhamel.assignedBeforeRadiusAccounting
  duhamelLowerEnvelopeIsSameEventStream : Prop
  eventSectionsAreSelectedBadCenterSections : Prop
  notOnlyPriorSameEventStreamCoherence : Prop
  notShellOrProcessSection : Prop
  notBareSectionIncidenceWithoutDuhamelPrecertificate : Prop

/--
TICK664 source surface.  The Duhamel lower-envelope receipt is now named as
the same-ledger object consumed by the residual audit event, rather than being
hidden behind section incidence alone.

This is still not a C7 construction.  It exposes only the event-level
Duhamel/Bernstein lower envelope and its Duhamel reserve spend; pressure
reserve, parent invoice, and descendant non-reuse remain separate
single-spend obligations.
-/
structure ResidualFreshSameLedgerDuhamelLowerEnvelopeSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L) where
  sectionIdentity : ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel
  lowerEnvelope : NS.EventDuhamelBernsteinLowerEnvelopeReceipt L
  lowerEnvelopeIsDuhamelSource :
    lowerEnvelope = sectionIdentity.duhamelSource.duhamel_lower_envelope
  auditEventStillTargetsSelectedBadNode :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      hEvents.eventToBadNode
        (residualFreshAuditEventIndex hElig Q hQ hResidual) = Q
  duhamelReserveSpend : ℝ
  duhamelReserveSpend_nonnegative : 0 ≤ duhamelReserveSpend
  duhamelReserveSpendPaidBySameRawRecurrenceLedger : Prop
  integratedReserveBookedBeforeSpendPartition :
    hDuhamel.assignedBeforeRadiusAccounting
  notOnlySectionIncidence : Prop
  notShellOrProcessReserve : Prop
  notParentInvoiceOrPressureReserve : Prop

/-- Constructor from the stronger audit-indexed Duhamel section identity. -/
def ResidualFreshSameLedgerDuhamelLowerEnvelopeSource.ofSectionIdentity
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    (hIdentity : ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel)
    (duhamelReserveSpend : ℝ)
    (hDuhamelSpendNonnegative : 0 ≤ duhamelReserveSpend)
    (hPaidBySameRawRecurrenceLedger : Prop)
    (hNotOnlySectionIncidence : Prop)
    (hNotShellOrProcessReserve : Prop)
    (hNotParentInvoiceOrPressureReserve : Prop) :
    ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel where
  sectionIdentity := hIdentity
  lowerEnvelope := hIdentity.duhamelSource.duhamel_lower_envelope
  lowerEnvelopeIsDuhamelSource := rfl
  auditEventStillTargetsSelectedBadNode := by
    intro Q hQ hResidual
    exact residualFreshAuditEventIndex_matches_badNode hElig Q hQ hResidual
  duhamelReserveSpend := duhamelReserveSpend
  duhamelReserveSpend_nonnegative := hDuhamelSpendNonnegative
  duhamelReserveSpendPaidBySameRawRecurrenceLedger :=
    hPaidBySameRawRecurrenceLedger
  integratedReserveBookedBeforeSpendPartition :=
    hIdentity.sectionIncidenceFixedBeforeRadiusAccounting
  notOnlySectionIncidence := hNotOnlySectionIncidence
  notShellOrProcessReserve := hNotShellOrProcessReserve
  notParentInvoiceOrPressureReserve := hNotParentInvoiceOrPressureReserve

/-- The TICK664 source projects to the raw-plus-recurrence lower envelope at
the residual-fresh audit event. -/
theorem residualFreshAuditEvent_rawRecurrenceLowerEnvelope_of_sameLedgerDuhamel
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    (h : ResidualFreshSameLedgerDuhamelLowerEnvelopeSource hElig hDuhamel)
    (Q : DyadicParabolicCube)
    (hQ : Q ∈ hCarrier.selectedBadNodes)
    (hResidual : hElig.residualOrInherited.residualFreshExcess Q) :
    L.eventWeight (residualFreshAuditEventIndex hElig Q hQ hResidual) *
        (L.eventGain (residualFreshAuditEventIndex hElig Q hQ hResidual)) ^
          (2 : Nat) ≤
      L.rawPrice (residualFreshAuditEventIndex hElig Q hQ hResidual) +
        L.recurrencePrice
          (residualFreshAuditEventIndex hElig Q hQ hResidual) := by
  exact
    NS.raw_recurrence_lower_envelope_of_event_duhamel_bernstein
      L h.lowerEnvelope
      (residualFreshAuditEventIndex hElig Q hQ hResidual)

/--
Timing receipt for the audit-indexed single-spend carrier.

The pressure/Duhamel assignments already expose the fixed-before-radius timing.
What remains mathematical, and is deliberately not hidden in the budget
partition, is the identification of the residual audit event with the Duhamel
section used by the spend partition.
-/
structure ResidualFreshAuditIndexFixedBeforeSpendPartition
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (_hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L)
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L) where
  pressureAssignmentFixedBeforeRadiusAccounting :
    hPressure.assignedBeforeRadiusAccounting
  duhamelAssignmentFixedBeforeRadiusAccounting :
    hDuhamel.assignedBeforeRadiusAccounting
  duhamelSectionIdentity :
    ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel
  auditIndexChosenBeforeParentInvoiceAccounting : Prop
  noPostHocAuditIndexFromSpendOutcome : Prop

/--
Boundary: a fixed event-section incidence receipt is not yet the audit-indexed
Duhamel section identity required by the single-spend carrier.

The missing paid data is the Duhamel-derived event pre-certificate, i.e. the
same-event lower-envelope source that books the heat/Duhamel reserve into the
same raw-plus-recurrence price ledger.  Without that source, section incidence
can still be shell/process accounting rather than the residual audit event
carrier.
-/
structure BareDuhamelSectionIncidenceBoundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L) where
  sectionIncidence : NS.EventSectionIncidenceReceipt L
  sectionIncidenceFixedBeforeRadiusAccounting : Prop
  missingDuhamelPrecertificateSource : Prop
  missingDuhamelLowerEnvelopeSameLedgerCharge : Prop
  missingAuditIndexKernelBinding : Prop
  noDirectAuditDuhamelSectionIdentity :
    ¬ Nonempty (ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel)

/-- Constructor for the bare-section-incidence boundary. -/
theorem bareDuhamelSectionIncidence_boundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (sectionIncidence : NS.EventSectionIncidenceReceipt L)
    (hNoIdentity :
      ¬ Nonempty (ResidualFreshAuditDuhamelSectionIdentity hElig hDuhamel)) :
    Nonempty (BareDuhamelSectionIncidenceBoundary hElig hDuhamel) := by
  refine ⟨{
    sectionIncidence := sectionIncidence
    sectionIncidenceFixedBeforeRadiusAccounting := True
    missingDuhamelPrecertificateSource := True
    missingDuhamelLowerEnvelopeSameLedgerCharge := True
    missingAuditIndexKernelBinding := True
    noDirectAuditDuhamelSectionIdentity := hNoIdentity
  }⟩

/--
TICK655 boundary.  The present Lean surface proves the first leg
`pressureRecoveryCarrier = eventTent`; it does not by itself prove that the
event tent for the residual audit index is the residual fresh region.
-/
structure ResidualFreshPressureCarrierLocalizationBoundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L) where
  pressureCarrierAlreadyEqualsEventTent :
    ∀ e : ℕ, hGeom.pressureRecoveryCarrier e = hGeom.eventTent e
  residualAuditEventStillTargetsBadNode :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      hEvents.eventToBadNode
        (residualFreshAuditEventIndex hElig Q hQ hResidual) = Q
  missingEventTentFreshRegionIdentification :
    ¬ Nonempty
      (ResidualFreshAuditEventTentFreshRegionIdentification hElig hGeom)
  pressureTailLocalizedToFreshVelocityIsOnlyCoarse :
    hElig.residualFreshExcess.pressureTailLocalizedToFreshVelocity
  eventTentAttachmentDoesNotSupplySetEquality : Prop
  harmonicReserveCanStillEscapeFreshRegion : Prop
  inheritedDescendantPressureCanStillBeRelabeled : Prop
  noPromotionFromCarrierLockAlone : Prop

/-- Constructor for the TICK655 pressure-carrier boundary. -/
theorem residualFreshPressureCarrierLocalization_boundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hNoIdentification :
      ¬ Nonempty
        (ResidualFreshAuditEventTentFreshRegionIdentification hElig hGeom)) :
    Nonempty
      (ResidualFreshPressureCarrierLocalizationBoundary hElig hGeom) := by
  refine ⟨{
    pressureCarrierAlreadyEqualsEventTent :=
      hGeom.pressureCarrier_eq_eventTent
    residualAuditEventStillTargetsBadNode :=
      residualFreshAuditEventIndex_matches_badNode hElig
    missingEventTentFreshRegionIdentification :=
      hNoIdentification
    pressureTailLocalizedToFreshVelocityIsOnlyCoarse :=
      hElig.pressureTailLocalizedToFreshVelocity
    eventTentAttachmentDoesNotSupplySetEquality := True
    harmonicReserveCanStillEscapeFreshRegion := True
    inheritedDescendantPressureCanStillBeRelabeled := True
    noPromotionFromCarrierLockAlone := True
  }⟩

/--
TICK655 weaker pressure target.  Literal equality between the pressure carrier
and the residual fresh region is stronger than needed if every dual pressure
test supported in the collar `eventTent \ freshRegion` either vanishes or is
booked away from the parent fresh-radius invoice.
-/
structure ResidualFreshPressureComplementDualTestLocalization
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L) where
  dualTestsUseSamePressureGauge : Prop
  complementDualTestsSupportedInEventTentMinusFreshRegion :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  complementPressurePairingVanishesOrChargedOffParentInvoice :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  harmonicReserveBookedOffParentFreshRadiusInvoice : Prop
  childCollarPressureBookedOffParentFreshRadiusInvoice : Prop
  inheritedPressureBookedOffParentFreshRadiusInvoice : Prop
  noParentRadiusPaymentFromPressureCarrierComplement : Prop
  permitsEventTentStrictlyLargerThanFreshRegion : Prop
  doesNotRequireLiteralCarrierSetEquality : Prop
  notPressureTailLocalizedToFreshVelocityRelabel : Prop

/-- Literal pressure-carrier localization implies the weaker complement
dual-test localization.  The reverse is intentionally not supplied. -/
def ResidualFreshPressureComplementDualTestLocalization.ofPressureCarrierLocalization
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (h :
      ResidualFreshPressureTailLocalizedToPuncturedInvoiceCarrier
        hElig hGeom hPressure) :
    ResidualFreshPressureComplementDualTestLocalization
      hElig hGeom hPressure where
  dualTestsUseSamePressureGauge :=
    hPressure.pressureTailLocalizedToFreshEventTents
  complementDualTestsSupportedInEventTentMinusFreshRegion :=
    fun _ _ _ => True
  complementPressurePairingVanishesOrChargedOffParentInvoice :=
    fun _ _ _ => True
  harmonicReserveBookedOffParentFreshRadiusInvoice :=
    h.inheritedOrHarmonicPressureDoesNotCreateParentInvoice
  childCollarPressureBookedOffParentFreshRadiusInvoice :=
    h.inheritedOrHarmonicPressureDoesNotCreateParentInvoice
  inheritedPressureBookedOffParentFreshRadiusInvoice :=
    h.inheritedOrHarmonicPressureDoesNotCreateParentInvoice
  noParentRadiusPaymentFromPressureCarrierComplement :=
    h.inheritedOrHarmonicPressureDoesNotCreateParentInvoice
  permitsEventTentStrictlyLargerThanFreshRegion :=
    True
  doesNotRequireLiteralCarrierSetEquality :=
    True
  notPressureTailLocalizedToFreshVelocityRelabel :=
    h.notCoarsePressureLockOnly

/-- If even the weaker complement-dual-test pressure route is absent, the
literal carrier-localization route is absent as well. -/
theorem pressureCarrierLocalization_needs_complementDualTestLocalization
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (hNoDual :
      ¬ Nonempty
        (ResidualFreshPressureComplementDualTestLocalization
          hElig hGeom hPressure)) :
    ¬ Nonempty
      (ResidualFreshPressureTailLocalizedToPuncturedInvoiceCarrier
        hElig hGeom hPressure) := by
  intro hLocalized
  exact hNoDual
    ⟨ResidualFreshPressureComplementDualTestLocalization.ofPressureCarrierLocalization
      hLocalized.some⟩

/--
Boundary for the pressure branch after the workbench pass: the actionable
failure surface is complement dual-test escape, not merely missing literal set
equality.
-/
structure ResidualFreshPressureComplementDualTestBoundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L) where
  pressureCarrierAlreadyEqualsEventTent :
    ∀ e : ℕ, hGeom.pressureRecoveryCarrier e = hGeom.eventTent e
  eventTentFreshRegionIdentificationMissing :
    ¬ Nonempty
      (ResidualFreshAuditEventTentFreshRegionIdentification hElig hGeom)
  complementDualTestLocalizationMissing :
    ¬ Nonempty
      (ResidualFreshPressureComplementDualTestLocalization
        hElig hGeom hPressure)
  literalSetEqualityCanBeOverStrongWithoutMinimalCarrier : Prop
  actualDiscriminatorIsCollarPairingOrReserveCharge : Prop
  harmonicOrInheritedPressureEscapeStillOpen : Prop
  noPromotionFromCoarsePressureTailField : Prop

/-- Constructor for the TICK655 complement-dual-test boundary. -/
theorem residualFreshPressureComplementDualTest_boundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hNoIdentification :
      ¬ Nonempty
        (ResidualFreshAuditEventTentFreshRegionIdentification hElig hGeom))
    (hNoDual :
      ¬ Nonempty
        (ResidualFreshPressureComplementDualTestLocalization
          hElig hGeom hPressure)) :
    Nonempty
      (ResidualFreshPressureComplementDualTestBoundary
        hElig hGeom hPressure) := by
  refine ⟨{
    pressureCarrierAlreadyEqualsEventTent :=
      hGeom.pressureCarrier_eq_eventTent
    eventTentFreshRegionIdentificationMissing :=
      hNoIdentification
    complementDualTestLocalizationMissing :=
      hNoDual
    literalSetEqualityCanBeOverStrongWithoutMinimalCarrier := True
    actualDiscriminatorIsCollarPairingOrReserveCharge := True
    harmonicOrInheritedPressureEscapeStillOpen := True
    noPromotionFromCoarsePressureTailField := True
  }⟩

/--
Lower inherited-branch surface surfaced by the TICK654 rebilling lane.  It
rules out the old-descendant-event / parent-invoice relabel that is not blocked
by "no new event" alone.
-/
structure InheritedNodesRoutedOffSameLedgerParentInvoice
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc) where
  inheritedBranchUsesSkeletonOrNoLogCharge :
    hElig.residualOrInherited.inheritedGivesNoLogPileupOrSkeletonCharge
  inheritedBranchDoesNotCreateNewEvent :
    hLock.inheritedBadnessDoesNotCreateNewEvent
  inheritedParentCannotReuseDescendantEventAsRadiusInvoice : Prop
  oldDescendantEventCannotBeRelabeledAsAncestorInvoice : Prop
  invoiceChargeModeForInheritedNodesIsNotSameLedgerEvent : Prop
  noParentRadiusPaymentFromInheritedChildConcentration : Prop

/--
TICK656 pressure-collar input.  The standalone complement-dual-test route is
not paid by fixing the pressure gauge alone: annular exterior packets can leave
quadratic harmonic modes in the collar.  This object is the explicit moment
cancellation or reserve-charge theorem needed before the pressure complement
can be used in a C7 bridge.
-/
structure AnnularHarmonicMomentCancellation
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L) where
  complementTestsUseFixedPressureGauge :
    hPressure.pressureTailLocalizedToFreshEventTents
  constantAndLinearGaugeModesRemoved : Prop
  quadraticHarmonicCollarModesCancelledOrCharged :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  exteriorPressureProjectionSummableOffParentInvoice :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  eventTentCollarIsTestedModuloHarmonicGauge :
    ∀ (_e : ℕ), Prop
  noPostHocDualTestClassTuning : Prop
  notConstantinFeffermanAlignment : Prop
  notDegreeZeroSingularIntegralBookkeeping : Prop
  notParabolicRateSlavedScalar : Prop

/--
TICK657 naturality criterion for the harmonic-moment quotient.  The quotient is
only a genuine pressure-collar theorem if the dual test class is fixed before
the pressure field is seen, has a trace-free quadratic moment rule for every
residual bad node, and preserves the admissible local-energy/De-Giorgi test
class.  Otherwise the finite-codimension projection is only post-hoc test
selection.
-/
structure NaturalHarmonicMomentQuotientCriterion
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L) where
  momentCancellation :
    AnnularHarmonicMomentCancellation hElig hGeom hPressure
  dualTestClassFixedBeforePressure : Prop
  traceFreeQuadraticMomentsVanishOrAreIndependentlyCharged :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  projectionPreservesAdmissibleLocalEnergyTests : Prop
  projectionPreservesCriticalScaling : Prop
  harmonicBoundaryReserveHasIndependentNoLogBudget : Prop
  notDefinedByCancellingTheObservedPressureMode : Prop
  notAParentFreshRadiusInvoiceRebilling : Prop

/--
TICK657 obstruction to naturalizing `AnnularHarmonicMomentCancellation`.  On a
non-radial collar/fresh-region complement the trace-free quadratic harmonic
mode can pair with the complement test's second moment.  Killing that mode by
projecting the tests is legitimate only if the projection was fixed in advance
and keeps the local-energy test class; otherwise the route has merely renamed
the harmonic collar rebilling defect.
-/
structure HarmonicMomentQuotientNaturalityObstruction
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L) where
  pressureCarrierAlreadyEventTent :
    ∀ e : ℕ, hGeom.pressureRecoveryCarrier e = hGeom.eventTent e
  naturalCriterionMissing :
    ¬ Nonempty
      (NaturalHarmonicMomentQuotientCriterion hElig hGeom hPressure)
  admissibleComplementSupportsCanHaveNonscalarSecondMoment :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  traceFreeQuadraticHarmonicModeCanPairNontrivially :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  momentNeutralProjectionIsSignedOrPostHoc : Prop
  positiveDeGiorgiTestClassNotStableUnderQuadraticMomentProjection : Prop
  harmonicBoundaryReserveHasNoIndependentNoLogBudget : Prop
  finiteCodimensionQuotientAloneDoesNotPayRadius : Prop
  fixedGaugeOnlyRemovesConstantAndLinearModes : Prop
  quadraticModeRequiresNaturalCriterionOrSingleSpendReserve : Prop
  notConstantinFeffermanAlignment : Prop
  notDegreeZeroSingularIntegralBookkeeping : Prop
  notParabolicRateSlavedScalar : Prop

/-- Constructor for the TICK657 harmonic-moment naturality obstruction. -/
theorem annularHarmonicMomentCancellation_needs_naturalMomentCriterion
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hNoNatural :
      ¬ Nonempty
        (NaturalHarmonicMomentQuotientCriterion hElig hGeom hPressure)) :
    Nonempty
      (HarmonicMomentQuotientNaturalityObstruction
        hElig hGeom hPressure) := by
  refine ⟨{
    pressureCarrierAlreadyEventTent := hGeom.pressureCarrier_eq_eventTent
    naturalCriterionMissing := hNoNatural
    admissibleComplementSupportsCanHaveNonscalarSecondMoment :=
      fun _ _ _ => True
    traceFreeQuadraticHarmonicModeCanPairNontrivially :=
      fun _ _ _ => True
    momentNeutralProjectionIsSignedOrPostHoc := True
    positiveDeGiorgiTestClassNotStableUnderQuadraticMomentProjection := True
    harmonicBoundaryReserveHasNoIndependentNoLogBudget := True
    finiteCodimensionQuotientAloneDoesNotPayRadius := True
    fixedGaugeOnlyRemovesConstantAndLinearModes := True
    quadraticModeRequiresNaturalCriterionOrSingleSpendReserve := True
    notConstantinFeffermanAlignment := True
    notDegreeZeroSingularIntegralBookkeeping := True
    notParabolicRateSlavedScalar := True
  }⟩

/--
TICK656 adversarial model class: a fresh inner packet plus an older annular
divergence-free packet can generate exterior pressure whose restriction to the
fresh region is harmonic, with a nonzero quadratic collar mode that survives
the same pressure gauge.  Dyadic copies of this packet reproduce the
homogeneity-0 recurrence unless a separate moment-cancellation or invoice
input is supplied.
-/
structure HarmonicCollarRebillingObstruction
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L)
    (hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L) where
  pressureCarrierAlreadyEventTent :
    ∀ e : ℕ, hGeom.pressureRecoveryCarrier e = hGeom.eventTent e
  freshRegionCanBeStrictlySmallerThanEventTent : Prop
  annularExteriorDivergenceFreePacketAvailable : Prop
  exteriorPressureIsHarmonicOnFreshRegion : Prop
  nonzeroQuadraticHarmonicModeSurvivesGauge : Prop
  complementDualTestCanPairWithQuadraticMode :
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes)
      (_hResidual : hElig.residualOrInherited.residualFreshExcess Q),
      Prop
  inheritedOrChildCollarPressureCanRebillParentInvoice : Prop
  dyadicCopiesHaveScaleInvariantPairing : Prop
  noBetaOrRadiusPaymentFromDegreeZeroPressureAlone : Prop
  pressureTailLocalizedToFreshVelocityIsOnlyCoarse :
    hElig.residualFreshExcess.pressureTailLocalizedToFreshVelocity

/--
TICK656 stronger C7 replacement surface.  One carrier is allowed only if the
spending is separated: local production gain, same-tree radius invoice,
pressure-collar reserve, and inherited nonchargeability are distinct ledger
items with no descendant rebilling.
-/
structure C7SingleSpendDualLedgerBridge
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
