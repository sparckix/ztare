  freshPacketDichotomyStillOpen : Prop
  packetGainPaysNonflatBetaStillOpen : Prop
  squareBudgetPaysRadiusBetaStillOpen : Prop
  boundedFanoutNoLogReuseStillOpen : Prop
  pressureSameCarrierAndFlatSkeletonRemainSeparateChecks : Prop
  noEventPerBadNodeTautology : Prop
  noBetaClosureFromFreshLockReductionAlone : Prop

/--
Source split for the fresh-packet theorem below the beta prefix-domination
gate.

This assembles `NonflatNonInheritedBadCenterForcesFreshFrequencyPacket` from
the lower side-condition audit and locks already present in the L3 layer.  The
source audit is still a hard input: it must construct the nonflat/inherited/flat
partition, event-selection rule, and payment/carrier locks before any
beta-radius accounting.
-/
structure BetaNonflatFreshPacketSourceSplit
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  freshPacketAudit :
    FreshComparablePacketSideConditionAudit seq K hRho hCarrier hBeta
  pressureSameCarrier :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  suitableWeakLocalEnergyInput : Prop
  galileanInvariantBadCenterCarrierFixed : Prop
  betaMeasuredOnSameCarrier : Prop
  flatNodesRemovedOrChargedToSkeleton : Prop
  inheritedAncestorPacketsExcluded : Prop
  freshComparablePacket :
    FreshComparablePacketForNonflatNonInheritedNode
      seq K hRho hCarrier hBeta
  freshComparablePacket_eq :
    freshComparablePacket =
      FreshComparablePacketSideConditionAudit.toFreshComparablePacket
        freshPacketAudit
  eventSelectionGeneratedBeforeRadiusAccounting :
    freshPacketAudit.selection.generatedBeforeRadiusAccounting
  eventPriceIndependentOfBetaRadiusSum :
    freshPacketAudit.selection.notDefinedFromBadCenterBetaRadiusSum
  paymentCarrierLockUsesSameNormalizedExcessTree :
    freshPacketAudit.paymentCarrierLocks.sameCarrierAsNormalizedExcessTree
  noEventPerBadNodeNamingTautology : Prop

/-- Assembly of the nonflat fresh-packet theorem from its displayed lower
audit fields. -/
def nonflatFreshPacket_of_betaSourceSplit
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      BetaNonflatFreshPacketSourceSplit
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) :
    NonflatNonInheritedBadCenterForcesFreshFrequencyPacket
      seq K hRho hCarrier hBeta hEvents L where
  suitableWeakLocalEnergyInput := h.suitableWeakLocalEnergyInput
  galileanInvariantBadCenterCarrierFixed :=
    h.galileanInvariantBadCenterCarrierFixed
  betaMeasuredOnSameCarrier := h.betaMeasuredOnSameCarrier
  flatNodesRemovedOrChargedToSkeleton := h.flatNodesRemovedOrChargedToSkeleton
  inheritedAncestorPacketsExcluded := h.inheritedAncestorPacketsExcluded
  pressureTailsBookedOnSameCarrier :=
    And
      h.pressureSameCarrier.pressureTailAssignedToFreshFrequencyEvents
      (And
        h.pressureSameCarrier.duhamelErrorsAssignedToFreshFrequencyEvents
        h.pressureSameCarrier.lerayProjectionAndHeatKernelUseSameCarrier)
  freshPacketAtFrequencyComparableToRadiusInverse :=
    h.freshPacketAudit.selection.freshPacketAtComparableFrequency
  squareBudgetPaysRadiusBeta := h.squareBudgetPaysRadiusBeta
  boundedFanoutNoLogReuse := h.boundedFanoutNoLogReuse
  producesFreshPacketDichotomy :=
    NonflatBadNodeFreshPacketDichotomy.ofFreshComparablePacket
      (FreshComparablePacketSideConditionAudit.toFreshComparablePacket
        h.freshPacketAudit)
  producesGainPayment :=
    FreshPacketGainPaysNonflatBeta.ofFreshPacketSideConditionAuditAndLocks
      h.freshPacketAudit h.pressureSameCarrier h.boundedFanoutNoLogReuse

/--
Guard: after the nonflat source split, the hard theorem is no longer a generic
fresh-packet label.  It is the construction of the side-condition audit itself:
the partition, selection rule, and payment/carrier locks must be sourced before
the event price or beta gain can be trusted.
-/
structure BetaNonflatFreshPacketSourceSplitIsNotClosure where
  nonflatFreshPacketAssemblesFromAuditAndLocks : Prop
  partitionSelectionPaymentAuditStillOpen : Prop
  eventSelectionRuleStillOpen : Prop
  eventPriceIndependenceStillOpen : Prop
  paymentCarrierLocksStillOpen : Prop
  boundedFanoutNoLogReuseStillOpen : Prop
  noFreshEventFromBadnessVocabularyAlone : Prop
  noBetaClosureFromFreshPacketAssemblyAlone : Prop

/--
Coherence receipt tying audit-selected fresh packets to the actual event stream
and price ledger.  Without this, the audit can manufacture a packet indexed by
each bad node while the same-tree route prices a different event stream.
-/
structure FreshPacketAuditSameEventStreamCoherence
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hAudit :
      FreshComparablePacketSideConditionAudit seq K hRho hCarrier hBeta) where
  auditEventIndex :
    (Q : DyadicParabolicCube) →
    Q ∈ hCarrier.selectedBadNodes →
    hAudit.partition.nonflat Q →
    ¬ hAudit.partition.inherited Q →
    ¬ hAudit.partition.flat Q →
    ℕ
  eventIndexFixedBeforeBetaRadiusAccounting : Prop
  eventToBadNode_matches_auditNode :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hNonflat : hAudit.partition.nonflat Q)
      (hNotInherited : ¬ hAudit.partition.inherited Q)
      (hNotFlat : ¬ hAudit.partition.flat Q),
      hEvents.eventToBadNode
        (auditEventIndex Q hQ hNonflat hNotInherited hNotFlat) = Q
  ledgerWeight_matches_auditFreshEvent :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hNonflat : hAudit.partition.nonflat Q)
      (hNotInherited : ¬ hAudit.partition.inherited Q)
      (hNotFlat : ¬ hAudit.partition.flat Q),
      L.eventWeight
        (auditEventIndex Q hQ hNonflat hNotInherited hNotFlat) =
        (hAudit.selection.freshEvent
          Q hQ hNonflat hNotInherited hNotFlat).eventWeight
  ledgerGain_matches_auditFreshEvent :
    ∀ (Q : DyadicParabolicCube)
      (hQ : Q ∈ hCarrier.selectedBadNodes)
      (hNonflat : hAudit.partition.nonflat Q)
      (hNotInherited : ¬ hAudit.partition.inherited Q)
      (hNotFlat : ¬ hAudit.partition.flat Q),
      L.eventGain
        (auditEventIndex Q hQ hNonflat hNotInherited hNotFlat) =
        (hAudit.selection.freshEvent
          Q hQ hNonflat hNotInherited hNotFlat).eventGain
  auditFreshEventBookedInSameLedger : Prop
  boundedMultiplicityOfAuditEventIndex : Prop
  noPostHocEventMatchingAfterBetaRadiusAccounting : Prop
  ledgerPriceIndependentOfTargetBetaRadiusSum :
    hAudit.selection.notDefinedFromBadCenterBetaRadiusSum

/-- Coherent version of the nonflat source split: same theorem assembly, but
with an explicit receipt that the audit packets are the ledger events. -/
structure BetaNonflatFreshPacketCoherentSourceSplit
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  sourceSplit :
    BetaNonflatFreshPacketSourceSplit
      (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
      (hBeta := hBeta) (hEvents := hEvents) (L := L)
  eventStreamCoherence :
    FreshPacketAuditSameEventStreamCoherence
      (hEvents := hEvents) (L := L) sourceSplit.freshPacketAudit
  sameEventStreamBeforePrefixDomination : Prop
  noSeparateBadNodeIndexedEventStream : Prop
  noLedgerPriceBackfilledFromBetaEndpoint : Prop

/-- Projection: the coherent split still supplies the nonflat fresh-packet
theorem, but the coherence receipt stays available to downstream prefix-budget
arguments. -/
def nonflatFreshPacket_of_coherentBetaSourceSplit
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      BetaNonflatFreshPacketCoherentSourceSplit
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) :
    NonflatNonInheritedBadCenterForcesFreshFrequencyPacket
      seq K hRho hCarrier hBeta hEvents L :=
  nonflatFreshPacket_of_betaSourceSplit h.sourceSplit

/--
Guard: event-stream coherence is a source obligation, not a proof by itself.
It prevents event-per-bad-node and post-hoc price matching, but the analytic
packet selection and same-carrier payment still have to be proved.
-/
structure FreshPacketEventStreamCoherenceIsNotSourceProof where
  auditPacketsMustEmbedInLedgerEventStream : Prop
  eventToBadNodeWeightGainCoherenceStillOpen : Prop
  boundedMultiplicityOfAuditEventIndexStillOpen : Prop
  noPostHocEventMatchingStillOpen : Prop
  freshPacketSelectionStillOpen : Prop
  paymentCarrierLocksStillOpen : Prop
  noFreshPacketTheoremFromCoherenceAlone : Prop

/--
Lower source surface for a coherent fresh-packet audit.

This records the route that would have to produce the audit-selected packets:
residual fresh excess supplies the fresh enstrophy region, inherited/flat nodes
are routed to the skeleton branch, pressure/Duhamel uses the same carrier, and
the audit events embed into the already priced `hEvents/L` stream.  The object
still consumes the actual audit and locks; it does not prove event selection
from CKN badness alone.
-/
structure CoherentFreshPacketAuditResidualRoutingSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  residualOrInherited :
    BadNodeResidualOrInheritedDichotomy seq K hRho
  inheritedSkeleton :
    InheritedBadTreeCoronaNoNeckSkeleton seq K hRho
  audit :
    FreshComparablePacketSideConditionAudit seq K hRho hCarrier hBeta
  pressureSameCarrier :
    FreshFrequencyPressureDuhamelSameCarrierLock
      seq K hRho hCarrier hEvents L
  squareBudgetPaysRadiusBeta :
    FreshFrequencySquareBudgetPaysRadiusBeta
      seq K hRho hCarrier hBeta hEvents L
  boundedFanoutNoLogReuse :
    FreshFrequencyBoundedFanoutNoLogReuse
      seq K hRho hCarrier hBeta hEvents L
  eventStreamCoherence :
    FreshPacketAuditSameEventStreamCoherence
      (hEvents := hEvents) (L := L) audit
  suitableWeakLocalEnergyInput : Prop
  galileanInvariantBadCenterCarrierFixed : Prop
  betaMeasuredOnSameCarrier : Prop
  residualFreshRegionMatchesAuditRegion :
    residualOrInherited.freshRegion = residualFreshExcess.freshRegion
  residualBranchCreatesAuditSelection : Prop
  inheritedBranchChargedBySkeleton :
    residualOrInherited.inheritedGivesNoLogPileupOrSkeletonCharge
  flatNodesRemovedOrChargedToSkeleton : Prop
  inheritedAncestorPacketsExcluded : Prop
  pressureTailLocalizedToFreshVelocity :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  pressureTailsBookedOnSameCarrier :
    And
      pressureSameCarrier.pressureTailAssignedToFreshFrequencyEvents
      (And
        pressureSameCarrier.duhamelErrorsAssignedToFreshFrequencyEvents
        pressureSameCarrier.lerayProjectionAndHeatKernelUseSameCarrier)
  eventSelectionGeneratedBeforeRadiusAccounting :
    audit.selection.generatedBeforeRadiusAccounting
  eventPriceIndependentOfBetaRadiusSum :
    audit.selection.notDefinedFromBadCenterBetaRadiusSum
  paymentCarrierLockUsesSameNormalizedExcessTree :
    audit.paymentCarrierLocks.sameCarrierAsNormalizedExcessTree
  noPressureOnlyFreshEventCreation : Prop
  noAuditChosenAfterBetaRadiusAccounting : Prop
  noRouteScheduleBackfilledFromTargetBetaRadius : Prop

/-- Projection from the residual-routing source to the coherent fresh-packet
source split already consumed by the beta prefix-domination chain. -/
def coherentBetaSourceSplit_of_residualRoutingSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      CoherentFreshPacketAuditResidualRoutingSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) :
    BetaNonflatFreshPacketCoherentSourceSplit
      (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
      (hBeta := hBeta) (hEvents := hEvents) (L := L) where
  sourceSplit := {
    freshPacketAudit := h.audit
    pressureSameCarrier := h.pressureSameCarrier
    squareBudgetPaysRadiusBeta := h.squareBudgetPaysRadiusBeta
    boundedFanoutNoLogReuse := h.boundedFanoutNoLogReuse
    suitableWeakLocalEnergyInput := h.suitableWeakLocalEnergyInput
    galileanInvariantBadCenterCarrierFixed :=
      h.galileanInvariantBadCenterCarrierFixed
    betaMeasuredOnSameCarrier := h.betaMeasuredOnSameCarrier
    flatNodesRemovedOrChargedToSkeleton :=
      h.flatNodesRemovedOrChargedToSkeleton
    inheritedAncestorPacketsExcluded := h.inheritedAncestorPacketsExcluded
    freshComparablePacket :=
      FreshComparablePacketSideConditionAudit.toFreshComparablePacket h.audit
    freshComparablePacket_eq := rfl
    eventSelectionGeneratedBeforeRadiusAccounting :=
      h.eventSelectionGeneratedBeforeRadiusAccounting
    eventPriceIndependentOfBetaRadiusSum :=
      h.eventPriceIndependentOfBetaRadiusSum
    paymentCarrierLockUsesSameNormalizedExcessTree :=
      h.paymentCarrierLockUsesSameNormalizedExcessTree
    noEventPerBadNodeNamingTautology :=
      h.noAuditChosenAfterBetaRadiusAccounting
  }
  eventStreamCoherence := h.eventStreamCoherence
  sameEventStreamBeforePrefixDomination :=
    h.eventStreamCoherence.auditFreshEventBookedInSameLedger
  noSeparateBadNodeIndexedEventStream :=
    h.eventStreamCoherence.boundedMultiplicityOfAuditEventIndex
  noLedgerPriceBackfilledFromBetaEndpoint :=
    And
      h.eventStreamCoherence.noPostHocEventMatchingAfterBetaRadiusAccounting
      h.noRouteScheduleBackfilledFromTargetBetaRadius

/--
Guard: the residual-routing source names the correct carriers for coherent
event selection, but it is not yet the PDE theorem.  The remaining source work
is to construct the audit event from residual fresh excess, route inherited and
flat nodes without scale reuse, and rule out pressure-only event creation.
-/
structure CoherentFreshPacketAuditResidualRoutingIsNotClosure where
  residualFreshExcessInputStillRequired : Prop
  residualOrInheritedDichotomyStillRequired : Prop
  inheritedSkeletonStillRequired : Prop
  pressureVisibilityStillSeparate : Prop
  eventStreamCoherenceStillRequired : Prop
  residualBranchCreatesAuditSelectionStillOpen : Prop
  noEventSelectionFromCknBadnessAlone : Prop
  noBetaClosureFromResidualRoutingSurfaceAlone : Prop

/--
Fork surface for the next beta-incidence theorem.

The desired positive branch is a coherent residual-routing source: residual
fresh excess produces an audit-selected packet that is booked in the same
`hEvents/L` stream.  Failure is not hidden in the route schedule; it is routed
to the three reduced N8 carriers: flat radius/scale reserve, pressure/cone
visibility, or beta/event incidence.
-/
structure ResidualFreshExcessSameLedgerEventSelectionFork
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  residualOrInherited :
    BadNodeResidualOrInheritedDichotomy seq K hRho
  inheritedSkeleton :
    InheritedBadTreeCoronaNoNeckSkeleton seq K hRho
  flatRadiusScaleReserveFailure : Prop
  pressureConeVisibilityFailure : Prop
  betaEventIncidenceFailure : Prop
  positiveBranchFixedBeforeBetaRadiusAccounting : Prop
  noPressureOnlyBranchHiddenAsFreshEvent : Prop
  inheritedOrFlatBranchNotChargedToRouteScheduleWithoutReserve : Prop
  fork :
    Nonempty
      (CoherentFreshPacketAuditResidualRoutingSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
      ∨ flatRadiusScaleReserveFailure
      ∨ pressureConeVisibilityFailure
      ∨ betaEventIncidenceFailure

/--
If the three reduced N8 residual branches are ruled out, the fork supplies the
coherent residual-routing source needed by the beta prefix chain.
-/
theorem residualRoutingSourceNonempty_of_eventSelectionFork
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshExcessSameLedgerEventSelectionFork
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hNoFlat : ¬ h.flatRadiusScaleReserveFailure)
    (hNoPressure : ¬ h.pressureConeVisibilityFailure)
    (hNoBeta : ¬ h.betaEventIncidenceFailure) :
    Nonempty
      (CoherentFreshPacketAuditResidualRoutingSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) := by
  rcases h.fork with hSource | hResidual
  · exact hSource
  rcases hResidual with hFlat | hResidual
  · exact False.elim (hNoFlat hFlat)
  rcases hResidual with hPressure | hBetaResidual
  · exact False.elim (hNoPressure hPressure)
  exact False.elim (hNoBeta hBetaResidual)

/--
Choice form for downstream constructors that need the source object itself.
The noncomputable choice is deliberately isolated here; the fork theorem above
is the propositionally meaningful branch statement.
-/
noncomputable def residualRoutingSource_of_eventSelectionFork
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshExcessSameLedgerEventSelectionFork
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hNoFlat : ¬ h.flatRadiusScaleReserveFailure)
    (hNoPressure : ¬ h.pressureConeVisibilityFailure)
    (hNoBeta : ¬ h.betaEventIncidenceFailure) :
    CoherentFreshPacketAuditResidualRoutingSource
      (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
      (hBeta := hBeta) (hEvents := hEvents) (L := L) :=
  Classical.choice
    (residualRoutingSourceNonempty_of_eventSelectionFork
      h hNoFlat hNoPressure hNoBeta)

/--
Guard: the fork is useful only as a reduced obstruction statement.  The hard
mathematics is still the positive branch: residual fresh excess must construct
the fixed, same-ledger audit event without importing beta-radius endpoint data.
-/
structure ResidualFreshExcessSameLedgerEventSelectionForkIsNotClosure where
  positiveBranchStillNeedsPdeSelectionProof : Prop
  flatRadiusScaleReserveFailureStillOpen : Prop
  pressureConeVisibilityFailureStillOpen : Prop
  betaEventIncidenceFailureStillOpen : Prop
  noEventCreatedFromNeedToPayBetaRadius : Prop
  noPressureVisibilitySmuggledIntoResidualFreshExcess : Prop
  noInheritedFlatScaleReuseHiddenInRouteSchedule : Prop
  forkOnlyClosesAfterThreeResidualBranchesClosed : Prop

/--
Small positive-branch source below `CoherentFreshPacketAuditResidualRoutingSource`.

This object certifies only the residual-fresh-excess to same-ledger audit-event
step.  It intentionally omits square-budget, fanout, full pressure/Duhamel
payment, and inherited-skeleton closure fields; those remain obligations of the
stronger coherent routing source.
-/
structure ResidualFreshExcessSameLedgerAuditEventSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  residualOrInherited :
    BadNodeResidualOrInheritedDichotomy seq K hRho
  audit :
    FreshComparablePacketSideConditionAudit seq K hRho hCarrier hBeta
  eventStreamCoherence :
    FreshPacketAuditSameEventStreamCoherence
      (hEvents := hEvents) (L := L) audit
  residualFreshRegionMatchesAuditRegion :
    residualOrInherited.freshRegion = residualFreshExcess.freshRegion
  residualBranchCreatesAuditSelection : Prop
  auditSelectionUsesResidualFreshExcess : Prop
  pressureTailLocalizedToFreshVelocity :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  eventSelectionGeneratedBeforeRadiusAccounting :
    audit.selection.generatedBeforeRadiusAccounting
  eventPriceIndependentOfBetaRadiusSum :
    audit.selection.notDefinedFromBadCenterBetaRadiusSum
  noPressureOnlyFreshEventCreation : Prop
  noAuditChosenAfterBetaRadiusAccounting : Prop

/-- Downward projection from the stronger coherent routing source to the
minimal residual-fresh same-ledger audit-event source. -/
def ResidualFreshExcessSameLedgerAuditEventSource.ofCoherentRoutingSource
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      CoherentFreshPacketAuditResidualRoutingSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) :
    ResidualFreshExcessSameLedgerAuditEventSource
      (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
      (hBeta := hBeta) (hEvents := hEvents) (L := L) where
  residualFreshExcess := h.residualFreshExcess
  residualOrInherited := h.residualOrInherited
  audit := h.audit
  eventStreamCoherence := h.eventStreamCoherence
  residualFreshRegionMatchesAuditRegion :=
    h.residualFreshRegionMatchesAuditRegion
  residualBranchCreatesAuditSelection := h.residualBranchCreatesAuditSelection
  auditSelectionUsesResidualFreshExcess :=
    h.residualBranchCreatesAuditSelection
  pressureTailLocalizedToFreshVelocity :=
    h.pressureTailLocalizedToFreshVelocity
  eventSelectionGeneratedBeforeRadiusAccounting :=
    h.eventSelectionGeneratedBeforeRadiusAccounting
  eventPriceIndependentOfBetaRadiusSum :=
    h.eventPriceIndependentOfBetaRadiusSum
  noPressureOnlyFreshEventCreation := h.noPressureOnlyFreshEventCreation
  noAuditChosenAfterBetaRadiusAccounting :=
    h.noAuditChosenAfterBetaRadiusAccounting

/--
Guard: this small source is deliberately weaker than the full coherent routing
source.  It supplies the event-selection target for the positive branch, not
the square-budget/fanout/pressure payment needed by beta prefix domination.
-/
structure ResidualFreshExcessSameLedgerAuditEventSourceIsNotClosure where
  sameLedgerAuditEventSourceIsSmallerThanFullRouting : Prop
  squareBudgetPaysRadiusBetaStillRequired : Prop
  boundedFanoutNoLogReuseStillRequired : Prop
  pressureSameCarrierPaymentStillRequired : Prop
  inheritedFlatSkeletonClosureStillRequired : Prop
  noFullBetaSourceSplitFromAuditEventSourceAlone : Prop

/--
Per-node data for the positive branch of residual-fresh event selection.

The only new analytic input here is eligibility: every residual-fresh selected
node must land in the nonflat, non-inherited, non-flat side of the already
fixed audit partition.  Once eligibility is supplied, the existing coherence
receipt produces the ledger event index and its matching facts.
-/
structure ResidualFreshExcessAuditEligibilityData
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  residualOrInherited :
    BadNodeResidualOrInheritedDichotomy seq K hRho
  audit :
    FreshComparablePacketSideConditionAudit seq K hRho hCarrier hBeta
  eventStreamCoherence :
    FreshPacketAuditSameEventStreamCoherence
      (hEvents := hEvents) (L := L) audit
  residualFreshRegionMatchesAuditRegion :
    residualOrInherited.freshRegion = residualFreshExcess.freshRegion
  residualFreshNodesAreAuditEligible :
    ∀ (Q : DyadicParabolicCube),
      Q ∈ hCarrier.selectedBadNodes →
      residualOrInherited.residualFreshExcess Q →
        audit.partition.nonflat Q ∧
          ¬ audit.partition.inherited Q ∧ ¬ audit.partition.flat Q
  auditSelectionUsesResidualFreshExcess : Prop
  pressureTailLocalizedToFreshVelocity :
    residualFreshExcess.pressureTailLocalizedToFreshVelocity
  eventSelectionGeneratedBeforeRadiusAccounting :
    audit.selection.generatedBeforeRadiusAccounting
  eventPriceIndependentOfBetaRadiusSum :
    audit.selection.notDefinedFromBadCenterBetaRadiusSum
  noPressureOnlyFreshEventCreation : Prop
  noAuditChosenAfterBetaRadiusAccounting : Prop

/-- Event index assigned by the same-ledger coherence receipt to a residual
fresh selected node once eligibility places it in the audit-selection branch. -/
def residualFreshAuditEventIndex
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (Q : DyadicParabolicCube)
    (hQ : Q ∈ hCarrier.selectedBadNodes)
    (hResidual : h.residualOrInherited.residualFreshExcess Q) : ℕ :=
  let hEligible := h.residualFreshNodesAreAuditEligible Q hQ hResidual
  h.eventStreamCoherence.auditEventIndex
    Q hQ hEligible.1 hEligible.2.1 hEligible.2.2

/-- The residual-fresh audit event index is booked against the same bad node. -/
theorem residualFreshAuditEventIndex_matches_badNode
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (Q : DyadicParabolicCube)
    (hQ : Q ∈ hCarrier.selectedBadNodes)
    (hResidual : h.residualOrInherited.residualFreshExcess Q) :
    hEvents.eventToBadNode
      (residualFreshAuditEventIndex h Q hQ hResidual) = Q := by
  let hEligible := h.residualFreshNodesAreAuditEligible Q hQ hResidual
  change
    hEvents.eventToBadNode
      (h.eventStreamCoherence.auditEventIndex
        Q hQ hEligible.1 hEligible.2.1 hEligible.2.2) = Q
  exact h.eventStreamCoherence.eventToBadNode_matches_auditNode
    Q hQ hEligible.1 hEligible.2.1 hEligible.2.2

/-- The ledger weight of the residual-fresh audit event is the audit fresh-event
weight on the same node. -/
theorem residualFreshAuditEventIndex_weight_matches
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (Q : DyadicParabolicCube)
    (hQ : Q ∈ hCarrier.selectedBadNodes)
    (hResidual : h.residualOrInherited.residualFreshExcess Q) :
    L.eventWeight (residualFreshAuditEventIndex h Q hQ hResidual) =
      (h.audit.selection.freshEvent Q hQ
        (h.residualFreshNodesAreAuditEligible Q hQ hResidual).1
        (h.residualFreshNodesAreAuditEligible Q hQ hResidual).2.1
        (h.residualFreshNodesAreAuditEligible Q hQ hResidual).2.2).eventWeight := by
  let hEligible := h.residualFreshNodesAreAuditEligible Q hQ hResidual
  change
    L.eventWeight
      (h.eventStreamCoherence.auditEventIndex
        Q hQ hEligible.1 hEligible.2.1 hEligible.2.2) =
      (h.audit.selection.freshEvent
        Q hQ hEligible.1 hEligible.2.1 hEligible.2.2).eventWeight
  exact h.eventStreamCoherence.ledgerWeight_matches_auditFreshEvent
    Q hQ hEligible.1 hEligible.2.1 hEligible.2.2

/-- The ledger gain of the residual-fresh audit event is the audit fresh-event
gain on the same node. -/
theorem residualFreshAuditEventIndex_gain_matches
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (Q : DyadicParabolicCube)
    (hQ : Q ∈ hCarrier.selectedBadNodes)
    (hResidual : h.residualOrInherited.residualFreshExcess Q) :
    L.eventGain (residualFreshAuditEventIndex h Q hQ hResidual) =
      (h.audit.selection.freshEvent Q hQ
        (h.residualFreshNodesAreAuditEligible Q hQ hResidual).1
        (h.residualFreshNodesAreAuditEligible Q hQ hResidual).2.1
        (h.residualFreshNodesAreAuditEligible Q hQ hResidual).2.2).eventGain := by
  let hEligible := h.residualFreshNodesAreAuditEligible Q hQ hResidual
  change
    L.eventGain
      (h.eventStreamCoherence.auditEventIndex
        Q hQ hEligible.1 hEligible.2.1 hEligible.2.2) =
      (h.audit.selection.freshEvent
        Q hQ hEligible.1 hEligible.2.1 hEligible.2.2).eventGain
  exact h.eventStreamCoherence.ledgerGain_matches_auditFreshEvent
    Q hQ hEligible.1 hEligible.2.1 hEligible.2.2

/-- Eligibility data supplies the smaller residual-fresh same-ledger audit-event
source consumed by the current beta fork. -/
def sameLedgerAuditEventSource_of_auditEligibilityData
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) :
    ResidualFreshExcessSameLedgerAuditEventSource
      (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
      (hBeta := hBeta) (hEvents := hEvents) (L := L) where
  residualFreshExcess := h.residualFreshExcess
  residualOrInherited := h.residualOrInherited
  audit := h.audit
  eventStreamCoherence := h.eventStreamCoherence
  residualFreshRegionMatchesAuditRegion :=
    h.residualFreshRegionMatchesAuditRegion
  residualBranchCreatesAuditSelection :=
    ∀ (Q : DyadicParabolicCube)
      (_hQ : Q ∈ hCarrier.selectedBadNodes),
      h.residualOrInherited.residualFreshExcess Q →
        h.audit.partition.nonflat Q ∧
          ¬ h.audit.partition.inherited Q ∧ ¬ h.audit.partition.flat Q
  auditSelectionUsesResidualFreshExcess :=
    h.auditSelectionUsesResidualFreshExcess
  pressureTailLocalizedToFreshVelocity :=
    h.pressureTailLocalizedToFreshVelocity
  eventSelectionGeneratedBeforeRadiusAccounting :=
    h.eventSelectionGeneratedBeforeRadiusAccounting
  eventPriceIndependentOfBetaRadiusSum :=
    h.eventPriceIndependentOfBetaRadiusSum
  noPressureOnlyFreshEventCreation := h.noPressureOnlyFreshEventCreation
  noAuditChosenAfterBetaRadiusAccounting :=
    h.noAuditChosenAfterBetaRadiusAccounting

/--
Guard: eligibility data narrows event selection to a per-node branch condition,
but does not prove that residual fresh excess analytically implies eligibility.
-/
structure ResidualFreshExcessAuditEligibilityDataIsNotClosure where
  residualFreshNodesMustBeProvedAuditEligible : Prop
  sameLedgerIndexFactsFollowFromCoherence : Prop
  pressureOnlyNodesStillExcludedSeparately : Prop
  inheritedFlatNodesStillRouteToScaleReserve : Prop
  noEligibilityFromNeedToPayBetaRadius : Prop

/--
TICK660 bridge audit: the new Duhamel-incidence language is genuinely stronger
than the older same-event-stream coherence only if the old audit-eligibility
data is lifted into concrete Duhamel section incidence.  Otherwise the target
is the tick422--427 recurrence under a new label.
-/
structure FreshPacketDuhamelIncidenceLiftFromAuditEligibility
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hFresh :
      IndependentFreshPacketSourceForNonflatBadCenter
        seq K hRho hCarrier hBeta hEvents L)
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) where
  duhamelSource : NS.EventDynamicRecurrencePricePrecertificateSource L
  sectionIncidence : NS.EventSectionIncidenceReceipt L
  reciprocalBudgetMatchesSectionIncidence :
    L.reciprocalBudget = sectionIncidence.eventReciprocalBudget
  auditMatchesFreshSourceSideConditions : Prop
  auditEventIndexIsDuhamelSectionIndex : Prop
  freshSelectionGlobalizesToDuhamelEventStream : Prop
  eventSectionsAreSelectedBadCenterSections : Prop
  effectiveMultiplicityCountsSelectedBadNodes : Prop
  duhamelReserveUsesSameBadCenterCarrier : Prop
  priceBudgetMatchesFiniteNSScaleBudget : Prop
  rawRecurrencePrefixIsSameCarrierScaleDrop : Prop
  prefixBudgetTelescopesOverSelectedBadNodes : Prop
  notOnlyShellOrProcessReserve : Prop

/-- Once the old audit-eligibility data is connected to actual Duhamel section
incidence, it supplies the TICK660 coherence object.  The construction is
conditional: pressure/fanout and the analytic eligibility theorem remain
separate gates. -/
def FreshPacketSelectionToDuhamelIncidenceCoherence.ofAuditEligibilityDuhamelLift
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hFresh :
      IndependentFreshPacketSourceForNonflatBadCenter
        seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    (hLift :
      FreshPacketDuhamelIncidenceLiftFromAuditEligibility
        (hEvents := hEvents) (L := L) hFresh hElig) :
    FreshPacketSelectionToDuhamelIncidenceCoherence
      seq K hRho hCarrier hBeta hEvents L hFresh where
  duhamelSource := hLift.duhamelSource
  sectionIncidence := hLift.sectionIncidence
  reciprocalBudgetMatchesSectionIncidence :=
    hLift.reciprocalBudgetMatchesSectionIncidence
  freshSelectionGlobalizesToEventStream :=
    hLift.freshSelectionGlobalizesToDuhamelEventStream
  eventSectionsAreSelectedBadCenterSections :=
    hLift.eventSectionsAreSelectedBadCenterSections
  eventPricesDeclaredBeforeBadCenterBetaPayoff :=
    hLift.duhamelSource.event_prices_declared_before_payoff
  effectiveMultiplicityCountsSelectedBadNodes :=
    hLift.effectiveMultiplicityCountsSelectedBadNodes
  duhamelReserveUsesSameBadCenterCarrier :=
    hLift.duhamelReserveUsesSameBadCenterCarrier
  priceBudgetMatchesFiniteNSScaleBudget :=
    hLift.priceBudgetMatchesFiniteNSScaleBudget
  rawRecurrencePrefixIsSameCarrierScaleDrop :=
    hLift.rawRecurrencePrefixIsSameCarrierScaleDrop
  prefixBudgetTelescopesOverSelectedBadNodes :=
    hLift.prefixBudgetTelescopesOverSelectedBadNodes
  noPostHocSectionChoiceFromRadiusSum :=
    hFresh.rulesOutPostHocBadNodeEventMatching ∧
      hElig.noAuditChosenAfterBetaRadiusAccounting ∧
        hLift.auditEventIndexIsDuhamelSectionIndex
  notOnlyShellOrProcessReserve := hLift.notOnlyShellOrProcessReserve

/-- TICK660 recurrence guard.  If the Duhamel section-incidence lift is absent,
the coherence target has not escaped the earlier audit-eligibility residual:
the old same-event-stream data still needs an analytic eligibility theorem, and
the Duhamel label contributes no new source by itself. -/
structure FreshPacketDuhamelCoherenceRecurrenceBoundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (hFresh :
      IndependentFreshPacketSourceForNonflatBadCenter
        seq K hRho hCarrier hBeta hEvents L)
    (hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) where
  priorSameEventStreamCoherenceAlreadyPresent :
    FreshPacketAuditSameEventStreamCoherence
      (hEvents := hEvents) (L := L) hElig.audit
  oldEligibilityTheoremStillAnalytic :
    ResidualFreshExcessAuditEligibilityDataIsNotClosure
  duhamelLiftMissing :
    ¬ Nonempty
      (FreshPacketDuhamelIncidenceLiftFromAuditEligibility
        (hEvents := hEvents) (L := L) hFresh hElig)
  noNewSourceFromDuhamelLabelAlone : Prop
  failureRoutesBackToEligibilityOrCarrierFork : Prop

/--
Eligibility-level fork after the GPT-5.5 no-go audit.

The positive branch is conditional eligibility data.  The negative branches
are the same N8 carriers that block sourcing eligibility from residual fresh
excess alone: flat/inherited scale reserve, pressure/cone visibility, and
beta/event incidence.
-/
structure ResidualFreshAuditEligibilityOrN8ResidualFork
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger} where
  residualFreshExcess :
    ResidualFreshExcessForcesFreshEnstrophy seq K hRho
  residualOrInherited :
    BadNodeResidualOrInheritedDichotomy seq K hRho
  flatRadiusScaleReserveFailure : Prop
  pressureConeVisibilityFailure : Prop
  betaEventIncidenceFailure : Prop
  noFourObjectSourceTheorem :
    ¬ Nonempty
      (ResidualFreshExcessSameLedgerAuditEventSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
  fork :
    Nonempty
      (ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
      ∨ flatRadiusScaleReserveFailure
      ∨ pressureConeVisibilityFailure
      ∨ betaEventIncidenceFailure
  noPressureOnlyNodesMarkedEligible : Prop
  noInheritedFlatNodesMarkedEligibleWithoutScaleReserve : Prop
  noEligibilityDefinedFromBetaRadiusEndpoint : Prop

/-- If the three residual branches are closed, the eligibility fork supplies
eligibility data. -/
theorem auditEligibilityDataNonempty_of_eligibilityFork
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    (h :
      ResidualFreshAuditEligibilityOrN8ResidualFork
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hNoFlat : ¬ h.flatRadiusScaleReserveFailure)
    (hNoPressure : ¬ h.pressureConeVisibilityFailure)
    (hNoBeta : ¬ h.betaEventIncidenceFailure) :
    Nonempty
      (ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)) := by
  rcases h.fork with hElig | hResidual
  · exact hElig
  rcases hResidual with hFlat | hResidual
  · exact False.elim (hNoFlat hFlat)
  rcases hResidual with hPressure | hBetaResidual
  · exact False.elim (hNoPressure hPressure)
  exact False.elim (hNoBeta hBetaResidual)

/--
Guard: this fork incorporates the no-go audit.  It does not construct
eligibility; it only states that failure to construct eligibility is one of the
reduced N8 residual carriers.
-/
structure ResidualFreshAuditEligibilityOrN8ResidualForkIsNotClosure where
  eligibilityStillAnalyticTheorem : Prop
  noFourObjectSourceTheoremRecorded : Prop
  flatRadiusScaleReserveBranchStillOpen : Prop
  pressureConeVisibilityBranchStillOpen : Prop
  betaEventIncidenceBranchStillOpen : Prop
  noBetaClosureFromEligibilityForkAlone : Prop

/--
TICK653 missing lift.  The residual-fresh same-ledger audit source and the
fresh-frequency same-tree lock expose the right event stream, but they do not
by themselves display a one-use radius invoice on the same stopping tree.

This structure is the extra theorem that would have to turn event bookkeeping
into the displayed `C7SameTreeFreshRadiusInvoice`.
-/
structure SameLedgerFreshEventCarriesRadiusInvoice
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hSrc :
      ResidualFreshExcessSameLedgerAuditEventSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc) where
  invoice :
    C7SameTreeFreshRadiusInvoice seq K hRho
  invoiceBadNodesAreSelectedBadNodes :
    invoice.badNodes = hCarrier.selectedBadNodes
  invoiceRegionsUseResidualFreshCarrier :
    invoice.invoiceRegion = hSrc.residualFreshExcess.freshRegion
  eventDataMatchesSameLedgerAuditSource : Prop
  eventWeightsPayNodeRadii : Prop
  pressureLocalizationProvedOnPuncturedInvoiceRegions : Prop
  inheritedBranchDoesNotCreateParentInvoice :
    hLock.inheritedBadnessDoesNotCreateNewEvent
  oneUseAccountingIsDisplayedInvoiceField :
    invoice.oneUseNoDescendantRebilling = hLock.noRepeatedDescendantCharging
  notBetaSquareRadiusRelabel : Prop
  notArtifactDependencyRestatement : Prop

/-- Projection from the TICK653 lift to the displayed C7 invoice. -/
def C7SameTreeFreshRadiusInvoice.ofSameLedgerFreshEventInvoice
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hSrc :
      ResidualFreshExcessSameLedgerAuditEventSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    (h :
      SameLedgerFreshEventCarriesRadiusInvoice hSrc hLock) :
    C7SameTreeFreshRadiusInvoice seq K hRho :=
  h.invoice

/--
TICK653 boundary.  The same-ledger residual audit source plus same-tree
fresh-frequency lock still cannot be promoted to a C7 same-tree radius invoice
unless the event-to-radius invoice lift above is supplied.
-/
structure ResidualFreshSameLedgerBridgeBoundary
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hSrc :
      ResidualFreshExcessSameLedgerAuditEventSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc) where
  pressureLocalizationIsStillSourceField :
    hSrc.residualFreshExcess.pressureTailLocalizedToFreshVelocity
  missingEventToRadiusInvoiceLift :
    ¬ Nonempty (SameLedgerFreshEventCarriesRadiusInvoice hSrc hLock)
  sameLedgerEventsOnlyGiveAuditIndex : Prop
  betaFrequencyPaymentNotRadiusInvoice : Prop
  inheritedPressureBranchCanStillRebill : Prop
  noPromotionFromSourceAndLockAlone : Prop

/-- Constructor for the TICK653 sharpened boundary. -/
theorem residualFreshSameLedgerBridge_needs_eventToRadiusInvoiceLift
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    (hSrc :
      ResidualFreshExcessSameLedgerAuditEventSource
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L))
    (hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc)
    (hNoLift :
      ¬ Nonempty (SameLedgerFreshEventCarriesRadiusInvoice hSrc hLock)) :
    Nonempty (ResidualFreshSameLedgerBridgeBoundary hSrc hLock) := by
  refine ⟨{
    pressureLocalizationIsStillSourceField :=
      hSrc.pressureTailLocalizedToFreshVelocity
    missingEventToRadiusInvoiceLift := hNoLift
    sameLedgerEventsOnlyGiveAuditIndex := True
    betaFrequencyPaymentNotRadiusInvoice := True
    inheritedPressureBranchCanStillRebill := True
    noPromotionFromSourceAndLockAlone := True
  }⟩

/--
TICK654 sharpened missing theorem.  The TICK653 lift is still too coarse:
`ResidualFreshExcessSameLedgerAuditEventSource` only records the positive
branch as a proposition, while the per-node event-index theorems live on the
stronger `ResidualFreshExcessAuditEligibilityData`.

This is the lower same-tree Carleson/invoice embedding that would turn
residual-fresh audit eligibility plus the fresh-frequency lock into a displayed
one-use radius invoice.
-/
structure SameTreeCarlesonInvoiceEmbedding
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
