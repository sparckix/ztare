/--
The rebilling packet is exactly fatal for the scaled owner-preimage target.

The proof consumes only the target's own selected-prefix owner-preimage
inequality and active atom budget.  Thus a future construction cannot evade the
packet by adding qualitative owner labels; it must either rule out the packet's
unbounded selected-tree prefix in the C7 geometry or supply the prefix theorem.
-/
theorem no_C7ScaledPackingOwnerPreimageTarget_of_selectedTreeRebillingPacket
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    {hPack : C7SameCarrierPackingNoReuseReceipt hIndexed hId}
    (hPacket : C7ScaledSelectedTreeRebillingPacket hPack)
    (hTarget : C7ScaledPackingOwnerPreimageTarget hPack) :
    False := by
  obtain ⟨N, hN⟩ :=
    hPacket.routeActiveTailPrefix_unbounded
      (hTarget.multiplicityBound * hTarget.scaledAtomBudget)
  have hprefix :
      NS.nsPrefixSum routeActiveTail N ≤
        hTarget.multiplicityBound *
          NS.nsPrefixSum hTarget.scaledAtomCharge
            (hTarget.activeOwnerAtomBound N) :=
    hTarget.scaledOwnerPreimage.ownerPreimagePackingPrefix N
  have hbudget :
      NS.nsPrefixSum hTarget.scaledAtomCharge
          (hTarget.activeOwnerAtomBound N) ≤
        hTarget.scaledAtomBudget :=
    hTarget.scaledOwnerPreimage.activeAtomPrefixBudget N
  have hle :
      NS.nsPrefixSum routeActiveTail N ≤
        hTarget.multiplicityBound * hTarget.scaledAtomBudget :=
    le_trans hprefix
      (mul_le_mul_of_nonneg_left hbudget
        hTarget.multiplicityBound_nonnegative)
  exact (not_lt_of_ge hle) hN

/--
Constructive carrier-transfer receipt for the scaled C7 owner-preimage target.

This is the exact positive mirror of the selected-tree rebilling packet: it
states what must be proved to transfer same-carrier fresh packing into scaled
owner-preimage prefix control.  The receipt is deliberately numerical; the
carrier words are only accepted when backed by an `OwnerPreimagePackingReceipt`
over `freshCharge / c`.
-/
structure C7ScaledOwnerPreimageCarrierTransfer
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
    {hBeta : BadCenterParabolicBetaData seq K hRho hCarrier}
    {hEvents : BadCenterEventNodeIdentification seq K hRho hCarrier}
    {L : NS.EventRecurrencePriceLedger}
    {hScale :
      BadCenterScaleTruncationPresentation seq K hRho hCarrier hBeta}
    {hInc :
      BadCenterEventIncidenceGeometry seq K hRho hCarrier hBeta hEvents L}
    {hElig :
      ResidualFreshExcessAuditEligibilityData
        (seq := seq) (K := K) (hRho := hRho) (hCarrier := hCarrier)
        (hBeta := hBeta) (hEvents := hEvents) (L := L)}
    {hGeom :
      LerayHeatFreshFrequencyEventTentGeometry
        seq K hRho hCarrier hEvents L}
    {hPressure :
      FreshFrequencyPressureTailEventAssignment
        seq K hRho hCarrier hEvents L}
    {hDuhamel :
      FreshFrequencyDuhamelErrorEventAssignment
        seq K hRho hCarrier hEvents L}
    {hLock :
      FreshFrequencyEventSameTreeLock
        seq K hRho hCarrier hBeta hEvents L hScale hInc}
    {hIndexed :
      ResidualFreshAuditIndexedSingleSpendCarrier
        hElig hGeom hPressure hDuhamel hLock}
    {routeActiveTail : Nat → Real}
    {hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail}
    (hPack : C7SameCarrierPackingNoReuseReceipt hIndexed hId) where
  ownerOfEvent : Nat → Nat
  activeOwnerAtomBound : Nat → Nat
  multiplicityBound : Real
  scaledAtomCharge_nonnegative :
    ∀ n : Nat, 0 ≤ hPack.freshCharge n / hPack.c
  scaledAtomBudget_nonnegative : 0 ≤ hPack.rootBudget / hPack.c
  multiplicityBound_nonnegative : 0 ≤ multiplicityBound
  scaledOwnerPreimage :
    OwnerPreimagePackingReceipt
      ownerOfEvent routeActiveTail (fun n : Nat => hPack.freshCharge n / hPack.c)
      activeOwnerAtomBound multiplicityBound (hPack.rootBudget / hPack.c)
  scaledAtomPrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum (fun n : Nat => hPack.freshCharge n / hPack.c) N ≤
        hPack.rootBudget / hPack.c
  ownerMapFixedBeforePayoff : Prop
  ownerMapFixedBeforePayoff_proof : ownerMapFixedBeforePayoff
  noLowFrequencyCatalystOwner : Prop
  noLowFrequencyCatalystOwner_proof : noLowFrequencyCatalystOwner
  sameAnnularOutputScaleOwner : Prop
  sameAnnularOutputScaleOwner_proof : sameAnnularOutputScaleOwner
  selectedPrefixPreimageNotPointwiseOnly : Prop
  selectedPrefixPreimageNotPointwiseOnly_proof :
    selectedPrefixPreimageNotPointwiseOnly
  transferNotCarrierNameOnly : Prop

