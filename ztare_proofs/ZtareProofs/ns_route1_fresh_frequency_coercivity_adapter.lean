This is the conditional theorem: given the 5-branch dichotomy plus the
ESS killer, the CF killer, and the negations of the three named
residuals as Prop-level inputs, no silent flat-defect profile exists.

Honest scope: the three residual negations are HYPOTHESES, not proofs.
This theorem says "if we control the three open residuals, ESS+CF
finishes the rest."  That is the structural reduction sought; the
content is in the residuals.
-/
structure ESSAndCFDichotomyClosesSilentFlatBranch where
  defect : SilentFlatDefectProfile
  dichotomy : SilentFlatProfileFiveBranchDichotomy
  dichotomy_matches_defect : dichotomy.defect = defect
  essKiller : ESSKillsSilentFlatOrdinaryProfile
  essKiller_matches_defect : essKiller.defect = defect
  essHypL3 : essKiller.l3LinfBoundedOnBadSet
  essHypApplies : essKiller.essApplies
  cfKiller : CFKillsSilentFlatOrdinaryProfile
  cfKiller_matches_defect : cfKiller.defect = defect
  cfHypCoh : cfKiller.vorticityDirectionCoherence
  cfHypStretch : cfKiller.signedVorticityStretchingBound
  cfHypBKM : cfKiller.bkmIntegrationApplies
  cfHypLinfReg : cfKiller.vorticityLinfImpliesRegularity
  branchA_implies_essHyp :
    dichotomy.branchA_boundedL3Linf → essKiller.l3LinfBoundedOnBadSet
  branchB_implies_cfHyp :
    dichotomy.branchB_cfCoherent → cfKiller.vorticityDirectionCoherence
  /-- Three residuals are controlled by hypothesis (the open analytic content). -/
  noL3EndpointBlowup : ¬ dichotomy.branchC_l3EndpointBlowup
  noVorticityDecoherence : ¬ dichotomy.branchD_vorticityDecoherence
  noMeasureValuedDefect : ¬ dichotomy.branchE_measureValuedDefect
  threeResidualsAreOpenAnalyticContent : Prop
  notClayClosure : Prop
  conditionalReductionOnly : Prop

/--
The conditional silent-flat closure theorem.

Disjunction elimination on the 5-branch dichotomy: each ordinary branch
is killed by ESS or CF, each residual branch is excluded by hypothesis.
-/
theorem noSilentFlatDefectProfile_of_dichotomy_and_killers
    (b : ESSAndCFDichotomyClosesSilentFlatBranch) :
    ¬ b.defect.silentDefectExists := by
  intro hexists
  have hexists_dichotomy : b.dichotomy.defect.silentDefectExists := by
    rw [b.dichotomy_matches_defect]; exact hexists
  have hcases := b.dichotomy.exhaustiveDisjunction hexists_dichotomy
  rcases hcases with hA | hB | hC | hD | hE
  · -- ESS kills branch A
    have hL3' : b.essKiller.l3LinfBoundedOnBadSet := b.branchA_implies_essHyp hA
    have hregOnBad : b.essKiller.regularityOnBadSet :=
      b.essKiller.ess_l3_implies_regularity hL3' b.essHypApplies
    -- need to reroute through essKiller.defect = defect
    have hnot : ¬ b.essKiller.defect.silentDefectExists :=
      b.essKiller.regularityRefutesDefect hregOnBad
    exact hnot (by rw [b.essKiller_matches_defect]; exact hexists)
  · -- CF kills branch B
    have hCoh' : b.cfKiller.vorticityDirectionCoherence := b.branchB_implies_cfHyp hB
    have hLinf : b.cfKiller.vorticityLinfOnBadSet :=
      b.cfKiller.cf_coherence_implies_vorticityLinf hCoh' b.cfHypStretch b.cfHypBKM
    have hregOnBad : b.cfKiller.regularityOnBadSet :=
      b.cfKiller.vorticityLinf_implies_regularity hLinf b.cfHypLinfReg
    have hnot : ¬ b.cfKiller.defect.silentDefectExists :=
      b.cfKiller.regularityRefutesDefect hregOnBad
    exact hnot (by rw [b.cfKiller_matches_defect]; exact hexists)
  · exact b.noL3EndpointBlowup hC
  · exact b.noVorticityDecoherence hD
  · exact b.noMeasureValuedDefect hE

/--
Guard: the conditional silent-flat closure is NOT Clay closure.

Each of the three residual exclusions (`noL3EndpointBlowup`,
`noVorticityDecoherence`, `noMeasureValuedDefect`) is a Prop hypothesis
encoding an OPEN analytic problem.  ESS and CF are externally cited.
-/
structure ESSAndCFDichotomyIsNotClayClosure where
  threeResidualsAreOpenAnalyticContent : Prop
  l3EndpointBlowupOpenSinceESS : Prop
  vorticityDecoherenceOpenSinceCF1993 : Prop
  measureValuedDefectIsDarkMatterBranch : Prop
  dichotomyItselfIsAnalyticAxiom : Prop
  essKillerIsExternallyCited : Prop
  cfKillerIsExternallyCited : Prop
  noClayClosureFromConditionalReduction : Prop
  reductionIsHonestNamingOfResiduals : Prop

/-!
### Primary attempt — NoSilentFlatDefectProfile as triadic refutation bundle

We do not have a Lean closure of `NoSilentFlatDefectProfile` from
in-charter carriers; classical CKN + local energy + interpolation pay
`r²` not `r` for flat radius reuse.  What we CAN ship as a primary
artifact is the triadic refutation bundle: any silent flat-defect
profile decomposes (per the dichotomy) and is refuted IF the three open
residuals are controlled.  This is exactly the conditional theorem
above, packaged as the canonical primary entry point.

Note: this is the structural primary attempt.  No new PDE content is
claimed.  The genuine PDE closure of `NoSilentFlatDefectProfile` remains
open and reduces to the three named residuals.
-/

/--
`NoSilentFlatDefectProfile`, the single tick441 residual, encoded as a
type whose only inhabitant route is via the ESS/CF dichotomy bundle.
-/
structure NoSilentFlatDefectProfile where
  defect : SilentFlatDefectProfile
  conclusion : ¬ defect.silentDefectExists

/-- Promote the conditional dichotomy bundle to the named primitive. -/
def NoSilentFlatDefectProfile.ofDichotomyAndKillers
    (b : ESSAndCFDichotomyClosesSilentFlatBranch) :
    NoSilentFlatDefectProfile where
  defect := b.defect
  conclusion := noSilentFlatDefectProfile_of_dichotomy_and_killers b

/--
Guard: the primary `NoSilentFlatDefectProfile` is currently INHABITED
only via the conditional dichotomy bundle.  Inhabiting it is not Clay
closure; it forwards the obligation to the three open residuals.
-/
structure NoSilentFlatDefectProfileIsNotClayClosure where
  onlyConstructorIsConditionalDichotomyBundle : Prop
  threeOpenResidualsCarryTheAnalyticContent : Prop
  noUnconditionalConstructorShipped : Prop
  primaryAttemptFailedHonestly : Prop
  backupDichotomyShippedCleanly : Prop
  reductionIsHonestOneTheoremWideBoundary : Prop

/--
TICK668 payment-channel witness.

This is the arithmetic core of the executable `payment_channel_gap`: even after
granting a same-carrier unsigned exchange from local-energy active variation
to Duhamel section unsigned mass, zero production and inherited-reserve
channels do not pay a positive heat-scaled source.
-/
structure LocalEnergyDuhamelPaymentChannelGap where
  heatKernelLowerBound : ℝ
  localEnergyActiveVariation : ℝ
  duhamelSectionUnsignedParentMass : ℝ
  productionSpend : ℝ
  inheritedReserveSpend : ℝ
  heatKernelLowerBound_pos : 0 < heatKernelLowerBound
  localEnergyActiveVariation_pos : 0 < localEnergyActiveVariation
  sameCarrierUnsignedExchange :
    localEnergyActiveVariation ≤ duhamelSectionUnsignedParentMass
  productionSpend_zero : productionSpend = 0
  inheritedReserveSpend_zero : inheritedReserveSpend = 0

/--
Granting same-carrier unsigned exchange is still insufficient for the Duhamel
payment receipt.  The production and inherited-reserve payment channels are
separate PDE obligations.
-/
theorem LocalEnergyDuhamelPaymentChannelGap.no_payment_from_exchange_only
    (h : LocalEnergyDuhamelPaymentChannelGap) :
    ¬ h.heatKernelLowerBound * h.localEnergyActiveVariation ≤
        h.productionSpend + h.inheritedReserveSpend := by
  intro hpay
  have hpos :
      0 < h.heatKernelLowerBound * h.localEnergyActiveVariation :=
    mul_pos h.heatKernelLowerBound_pos h.localEnergyActiveVariation_pos
  rw [h.productionSpend_zero, h.inheritedReserveSpend_zero] at hpay
  linarith

/-- The normalized unit witness used by the TICK668 workbench packet. -/
def LocalEnergyDuhamelPaymentChannelGap.unit :
    LocalEnergyDuhamelPaymentChannelGap where
  heatKernelLowerBound := 1
  localEnergyActiveVariation := 1
  duhamelSectionUnsignedParentMass := 1
  productionSpend := 0
  inheritedReserveSpend := 0
  heatKernelLowerBound_pos := by norm_num
  localEnergyActiveVariation_pos := by norm_num
  sameCarrierUnsignedExchange := by norm_num
  productionSpend_zero := rfl
  inheritedReserveSpend_zero := rfl

end Route1FreshFrequencyCoercivity

end ZtareProofs
