    (Ω : Type u) (BadNode : Type v) where
  omegaPressure : Set Ω → Real
  freshRegion : BadNode → Set Ω
  pressureComponent : BadNode → Real
  pressureVisibility : BadNode → Real
  pressureCoeff : Real
  pressureCoeff_nonneg : 0 ≤ pressureCoeff
