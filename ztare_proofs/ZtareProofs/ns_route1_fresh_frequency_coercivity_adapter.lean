    (hId :
      C7RouteActiveTailEventBetaSquareIdentification
        (hBeta := hBeta) (hEvents := hEvents) (L := L)
        routeActiveTail) where
  routeActiveTail_nonnegative : ∀ n : Nat, 0 ≤ routeActiveTail n
  betaSquareNumericalNonnegative : Prop
  betaSquareNumericalNonnegative_proof : betaSquareNumericalNonnegative
  nodeRadiusNonnegativeOnSelectedEvents : Prop
  nodeRadiusNonnegativeOnSelectedEvents_proof :
    nodeRadiusNonnegativeOnSelectedEvents
  eventToBadNodeSelectionRespected : Prop
  eventToBadNodeSelectionRespected_proof :
    eventToBadNodeSelectionRespected
  notOnlyBetaNonnegativeProp : Prop

/-- Consume the route active-tail nonnegativity receipt. -/
theorem C7RouteActiveTailNonnegativeReceipt.nonnegative
    {seq : LerayHopfSequence} {K : CompactSubCylinder}
    {hRho : RhoFromNormalizedCKNExcess seq K}
    {hCarrier :
      NonadaptiveBadCenterCarrierFromNormalizedExcess seq K hRho}
