/--
Numerical owner-preimage packing receipt.

This is the pure finite-prefix core extracted by the TICK668 recursive pass.
Pointwise event ownership and a finite atom budget are not enough: a single
owner atom can be reused by infinitely many selected events.  The missing
receipt is the global selected-prefix preimage inequality below, tying the
event prefix to the prefix of owner atoms before the downstream budget is
spent.
-/
structure OwnerPreimagePackingReceipt
    (owner : Nat → Nat)
    (eventPay atomCharge : Nat → Real)
    (activeAtomBound : Nat → Nat)
    (C atomBudget : Real) where
  eventPay_nonnegative : ∀ e : Nat, 0 ≤ eventPay e
  atomCharge_nonnegative : ∀ a : Nat, 0 ≤ atomCharge a
  C_nonnegative : 0 ≤ C
  atomBudget_nonnegative : 0 ≤ atomBudget
  owner_lt_activeAtomBound :
    ∀ {e N : Nat}, e < N → owner e < activeAtomBound N
  pointwiseOwnedAtomPaysEvent :
    ∀ e : Nat, eventPay e ≤ atomCharge (owner e)
  ownerPreimagePackingPrefix :
    ∀ N : Nat,
      NS.nsPrefixSum eventPay N ≤
        C * NS.nsPrefixSum atomCharge (activeAtomBound N)
  activeAtomPrefixBudget :
    ∀ N : Nat,
      NS.nsPrefixSum atomCharge (activeAtomBound N) ≤ atomBudget
  ownerIsFullOutputScalePacket : Prop
  ownerIsFullOutputScalePacket_proof : ownerIsFullOutputScalePacket
  ownerNotReusableLowFrequencyCatalyst : Prop
  ownerNotReusableLowFrequencyCatalyst_proof :
    ownerNotReusableLowFrequencyCatalyst
  smoothOrInheritedFactorRoutedOffResidualFreshStream : Prop
  smoothOrInheritedFactorRoutedOffResidualFreshStream_proof :
    smoothOrInheritedFactorRoutedOffResidualFreshStream
  ownerChosenBeforePayoff : Prop
  ownerChosenBeforePayoff_proof : ownerChosenBeforePayoff
  sameCarrierPhaseSpaceOwnership : Prop
  sameCarrierPhaseSpaceOwnership_proof : sameCarrierPhaseSpaceOwnership
  globalSelectedTreePreimageBound : Prop
  globalSelectedTreePreimageBound_proof :
    globalSelectedTreePreimageBound

/--
The numerical payoff of an owner-preimage receipt.

The proof is deliberately small: all mathematical difficulty is isolated in
`ownerPreimagePackingPrefix`.  Classical pointwise ownership plus finite atom
mass does not imply this field, as witnessed by
`annularOwnerPointwiseBudget_allows_unbounded_eventPrefix`.
-/
theorem OwnerPreimagePackingReceipt.eventPrefix_le_ownerBudget
    {owner : Nat → Nat}
    {eventPay atomCharge : Nat → Real}
    {activeAtomBound : Nat → Nat}
    {C atomBudget : Real}
    (h :
      OwnerPreimagePackingReceipt
        owner eventPay atomCharge activeAtomBound C atomBudget) :
    ∀ N : Nat, NS.nsPrefixSum eventPay N ≤ C * atomBudget := by
  intro N
  exact
    le_trans (h.ownerPreimagePackingPrefix N)
      (mul_le_mul_of_nonneg_left (h.activeAtomPrefixBudget N)
        h.C_nonnegative)

/--
Named C7-facing alias for the global selected-tree owner-preimage budget.

The alias is intentionally numerical and substrate-light: the PDE work is to
construct this receipt from the annular corona-Duhamel geometry, not to prove
another consumer projection after the receipt has been assumed.
-/
abbrev SelectedTreeOwnerPreimageCarleson
    (owner : Nat → Nat)
    (eventPay atomCharge : Nat → Real)
    (activeAtomBound : Nat → Nat)
    (C atomBudget : Real) :=
  OwnerPreimagePackingReceipt
    owner eventPay atomCharge activeAtomBound C atomBudget

/--
Projection from the named selected-tree owner-preimage receipt to the event
prefix budget.  This is the exact numerical theorem the C7 source-selection
fork needs before any PDE-specific owner construction can be consumed.
-/
theorem SelectedTreeOwnerPreimageCarleson.eventPrefix_le_ownerBudget
    {owner : Nat → Nat}
    {eventPay atomCharge : Nat → Real}
    {activeAtomBound : Nat → Nat}
    {C atomBudget : Real}
    (h :
      SelectedTreeOwnerPreimageCarleson
        owner eventPay atomCharge activeAtomBound C atomBudget) :
    ∀ N : Nat, NS.nsPrefixSum eventPay N ≤ C * atomBudget :=
  OwnerPreimagePackingReceipt.eventPrefix_le_ownerBudget h

